{
  "$schema": "./node_modules/syncpack/schema.json",
  "source": ["package.json", "packages/*/package.json", "apps/*/package.json"],
  "indent": "  ",
  "semverGroups": [
    {
      "range": "~",
      "dependencies": ["expo", "expo-*", "react-native"],
      "packages": ["**"],
      "label": "Expo SDK 55 Pinning"
    }
  ],
  "versionGroups": [
    {
      "dependencies": ["@repo/*"],
      "packages": ["**"],
      "label": "Internal Workspace Packages"
    }
  ],
  "sortAz": [
    "dependencies",
    "devDependencies",
    "peerDependencies",
    "optionalDependencies"
  ],
  "sortFirst": ["name", "description", "version", "author"]
}
