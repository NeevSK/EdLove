# --- Jina AI Reader (Free Web Ingest) ---
# Optional: Get a free key at https://jina.ai/
JINA_API_KEY=your_jina_api_key_here

# --- Inngest ---
# Get your event key at https://app.inngest.com/
INNGEST_EVENT_KEY=your_inngest_event_key_here
INNGEST_SIGNING_KEY=your_inngest_signing_key_here

# --- GitHub Integration ---
# Personal Access Token with repo/workflow scopes
GITHUB_PERSONAL_ACCESS_TOKEN=your_github_token_here

# --- Supabase Integration ---
SUPABASE_ACCESS_TOKEN=your_supabase_access_token_here
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
SUPABASE_PROJECT_REF=your_project_ref_here

# --- Expo Integration ---
# Personal access token from EAS dashboard
EXPO_TOKEN=your_expo_personal_access_token_here

