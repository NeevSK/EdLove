{
  "name": "@repo/platform-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Unified Engineering Control Plane for Polymath Agents",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "start": "node dist/index.js",
    "lint": "pnpm run lint:biome && pnpm run lint:eslint",
    "lint:biome": "biome check .",
    "lint:eslint": "eslint .",
    "format": "node ../../scripts/scoped-biome.mjs --write",
    "check-cycles": "node ../../scripts/refactor/sovereign-cycle-checker.mjs",
    "check-types": "pnpm exec tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "clean": "rm -rf .turbo node_modules dist"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "@modelcontextprotocol/server-sequential-thinking": "2025.12.18",
    "dotenv": "^17.4.2",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:^",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^25.9.2",
    "eslint": "^10.4.1",
    "mcp-remote": "^0.1.38",
    "typescript": "^6.0.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.8"
  }
}
