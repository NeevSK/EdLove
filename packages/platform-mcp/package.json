{
  "name": "@repo/platform-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Unified Engineering Control Plane for Polymath Agents",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "node ../../scripts/run-and-report.mjs --cmd \"tsc\" --name \"packages_platform-mcp-build\"",
    "watch": "node ../../scripts/run-and-report.mjs --cmd \"tsc -w\" --name \"packages_platform-mcp-watch\"",
    "start": "node ../../scripts/run-and-report.mjs --cmd \"node dist/index.js\" --name \"packages_platform-mcp-start\"",
    "lint": "node ../../scripts/run-and-report.mjs --cmd \"pnpm run lint:biome && pnpm run lint:eslint\" --name \"packages_platform-mcp-lint\"",
    "lint:biome": "node ../../scripts/run-and-report.mjs --cmd \"node ../../scripts/scoped-biome.mjs\" --name \"packages_platform-mcp-lint_biome\"",
    "lint:eslint": "node ../../scripts/run-and-report.mjs --cmd \"eslint .\" --name \"packages_platform-mcp-lint_eslint\"",
    "format": "node ../../scripts/run-and-report.mjs --cmd \"node ../../scripts/scoped-biome.mjs --write\" --name \"packages_platform-mcp-format\"",
    "check-cycles": "node ../../scripts/run-and-report.mjs --cmd \"node ../../scripts/refactor/sovereign-cycle-checker.mjs\" --name \"packages_platform-mcp-check-cycles\"",
    "check-types": "node ../../scripts/run-and-report.mjs --cmd \"pnpm exec tsc --build --noEmit\" --name \"packages_platform-mcp-check-types\"",
    "test": "node ../../scripts/run-and-report.mjs --cmd \"vitest run\" --name \"packages_platform-mcp-test\"",
    "test:watch": "node ../../scripts/run-and-report.mjs --cmd \"vitest\" --name \"packages_platform-mcp-test_watch\"",
    "test:ui": "node ../../scripts/run-and-report.mjs --cmd \"vitest --ui\" --name \"packages_platform-mcp-test_ui\"",
    "clean": "node ../../scripts/run-and-report.mjs --cmd \"rm -rf .turbo node_modules dist\" --name \"packages_platform-mcp-clean\""
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/core": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@modelcontextprotocol/server-sequential-thinking": "2025.12.18",
    "@swmansion/argent": "^0.23.0",
    "agent-device": "^0.20.10",
    "dotenv": "^17.4.2",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:^",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^25.9.6",
    "eslint": "^10.10.0",
    "mcp-remote": "^0.1.49",
    "typescript": "rc",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.0"
  },
  "_originalScripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "start": "node dist/index.js",
    "lint": "pnpm run lint:biome && pnpm run lint:eslint",
    "lint:biome": "node ../../scripts/scoped-biome.mjs",
    "lint:eslint": "eslint .",
    "format": "node ../../scripts/scoped-biome.mjs --write",
    "check-cycles": "node ../../scripts/refactor/sovereign-cycle-checker.mjs",
    "check-types": "pnpm exec tsc --build --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "clean": "rm -rf .turbo node_modules dist"
  }
}
