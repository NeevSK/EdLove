{
  "extends": "../../packages/typescript-config/base.json",
  "compilerOptions": {
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@repo/platform-mcp/*": [
        "./src/*"
      ],
      "@repo/core": [
        "../core/dist/index.d.ts"
      ],
      "@repo/core/*": [
        "../core/dist/*"
      ],
      "@repo/ui": [
        "../ui/dist/index.d.ts"
      ],
      "@repo/ui/*": [
        "../ui/dist/*"
      ]
    },
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
