{
  "name": "@repo/community",
  "version": "1.5.0",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./chat": {
      "types": "./src/chat.ts",
      "import": "./src/chat.ts",
      "default": "./src/chat.ts"
    },
    "./feed": {
      "types": "./src/feed.ts",
      "import": "./src/feed.ts",
      "default": "./src/feed.ts"
    },
    "./groups": {
      "types": "./src/groups.ts",
      "import": "./src/groups.ts",
      "default": "./src/groups.ts"
    },
    "./onboarding": {
      "types": "./src/onboarding.ts",
      "import": "./src/onboarding.ts",
      "default": "./src/onboarding.ts"
    },
    "./api": {
      "types": "./src/api/index.ts",
      "import": "./src/api/index.ts",
      "default": "./src/api/index.ts"
    },
    "./screens/BaseChatScreen": {
      "types": "./src/screens/BaseChatScreen.tsx",
      "import": "./src/screens/BaseChatScreen.tsx",
      "default": "./src/screens/BaseChatScreen.tsx"
    },
    "./screens/InviteCodeEntry": {
      "types": "./src/screens/InviteCodeEntry.tsx",
      "import": "./src/screens/InviteCodeEntry.tsx",
      "default": "./src/screens/InviteCodeEntry.tsx"
    },
    "./*": {
      "types": "./src/*",
      "import": "./src/*",
      "default": "./src/*"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "lint": "node ../../scripts/run-and-report.mjs --cmd \"pnpm run lint:biome && pnpm run lint:eslint\" --name \"packages_community-lint\"",
    "check-types": "node ../../scripts/run-and-report.mjs --cmd \"pnpm exec tsc --build --noEmit\" --name \"packages_community-check-types\"",
    "clean": "node ../../scripts/run-and-report.mjs --cmd \"rm -rf .turbo node_modules dist\" --name \"packages_community-clean\"",
    "lint:biome": "node ../../scripts/run-and-report.mjs --cmd \"node ../../scripts/scoped-biome.mjs\" --name \"packages_community-lint_biome\"",
    "lint:eslint": "node ../../scripts/run-and-report.mjs --cmd \"eslint .\" --name \"packages_community-lint_eslint\"",
    "format": "node ../../scripts/run-and-report.mjs --cmd \"node ../../scripts/scoped-biome.mjs --write\" --name \"packages_community-format\"",
    "check-cycles": "node ../../scripts/run-and-report.mjs --cmd \"node ../../scripts/refactor/sovereign-cycle-checker.mjs\" --name \"packages_community-check-cycles\"",
    "test": "node ../../scripts/run-and-report.mjs --cmd \"vitest run\" --name \"packages_community-test\" --evidence-level G1",
    "test:watch": "node ../../scripts/run-and-report.mjs --cmd \"vitest\" --name \"packages_community-test_watch\" --evidence-level G1",
    "test:ui": "node ../../scripts/run-and-report.mjs --cmd \"vitest --ui\" --name \"packages_community-test_ui\" --evidence-level G1"
  },
  "dependencies": {
    "@repo/core": "workspace:*",
    "@repo/library": "workspace:*",
    "@repo/profile": "workspace:*",
    "@repo/scanner-kit": "workspace:*",
    "@repo/self": "workspace:*",
    "@repo/ui": "workspace:*",
    "@supabase/postgrest-js": "2.119.0",
    "@supabase/supabase-js": "^2.119.0",
    "@tanstack/react-query": "^5.107.1",
    "date-fns": "^4.4.0",
    "expo-clipboard": "~58.0.4",
    "expo-image-picker": "~58.0.10",
    "expo-router": "~58.0.30",
    "react-i18next": "^17.1.12",
    "react-native-reanimated": "4.7.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:^",
    "@repo/typescript-config": "workspace:*",
    "@types/react": "^19.3.0",
    "eslint": "^10.14.0",
    "react-i18next": "^17.1.12",
    "typescript": "7.1.0-beta",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "5.1.0"
  },
  "peerDependencies": {
    "@repo/ui": "1.5.0",
    "@supabase/postgrest-js": "2.119.0",
    "@supabase/supabase-js": "^2.119.0",
    "react": "19.3.1",
    "react-i18next": "^17.1.12",
    "react-native": "0.88.1"
  },
  "_originalScripts": {
    "lint": "pnpm run lint:biome && pnpm run lint:eslint",
    "check-types": "pnpm exec tsc --build --noEmit",
    "clean": "rm -rf .turbo node_modules dist",
    "lint:biome": "node ../../scripts/scoped-biome.mjs",
    "lint:eslint": "eslint .",
    "format": "node ../../scripts/scoped-biome.mjs --write",
    "check-cycles": "node ../../scripts/refactor/sovereign-cycle-checker.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui"
  }
}
