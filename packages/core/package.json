      "types": "./src/hooks/index.ts",
      "import": "./src/hooks/index.ts"
    },
    "./hooks/*": {
      "types": "./src/hooks/*.ts",
      "import": "./src/hooks/*.ts"
    },
    "./store": {
      "types": "./src/store/index.ts",
      "import": "./src/store/index.ts"
    },
    "./store/*": {
      "types": "./src/store/*.ts",
      "import": "./src/store/*.ts"
    },
    "./native/*": {
      "types": "./src/native/*.ts",
      "import": "./src/native/*.ts"
    },
    "./sync/*": {
      "types": "./src/lib/sync/*.ts",
      "import": "./src/lib/sync/*.ts"
    },
    "./lib/*": {
      "types": "./src/lib/*.ts",
      "import": "./src/lib/*.ts"
    },
