      "types": "./src/constants/index.ts",
      "import": "./src/constants/index.ts"
    },
    "./constants/*": {
      "types": "./src/constants/*.ts",
      "import": "./src/constants/*.ts"
    },
    "./grading": {
      "types": "./src/logic/grading/index.ts",
      "import": "./src/logic/grading/index.ts"
    },
    "./events": {
      "types": "./src/logic/events/bus.ts",
      "import": "./src/logic/events/bus.ts"
    },
    "./offline": {
      "types": "./src/offline/resilience.ts",
      "import": "./src/offline/resilience.ts"
    },
    "./storage-wrapper": {
      "types": "./src/lib/storageWrapper.ts",
      "import": "./src/lib/storageWrapper.ts"
    },
    "./lib": {
      "types": "./src/lib/index.ts",
      "import": "./src/lib/index.ts"
    },
    "./logic/workspace/*": {
      "types": "./src/logic/workspace/*.ts",
      "import": "./src/logic/workspace/*.ts"
    },
    "./logic/permissions/*": {
      "types": "./src/logic/permissions/*.ts",
      "import": "./src/logic/permissions/*.ts"
    },
    "./logic/forms/*": {
      "types": "./src/logic/forms/*.ts",
      "import": "./src/logic/forms/*.ts"
    },
    "./forms/form-manager": {
      "types": "./src/logic/forms/form-manager.ts",
      "import": "./src/logic/forms/form-manager.ts"
    },
    "./logic/entities/*": {
      "types": "./src/logic/entities/*.ts",
      "import": "./src/logic/entities/*.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "lint": "pnpm run lint:biome && pnpm run lint:eslint",
    "lint:biome": "biome check .",
    "lint:eslint": "eslint .",
    "format": "biome format --write .",
    "check-cycles": "node ../../scripts/refactor/sovereign-cycle-checker.mjs",
    "check-types": "pnpm exec tsc --noEmit",
    "test:logic": "vitest run src/logic",
    "clean": "rm -rf .turbo node_modules dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui"
  },
  "peerDependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@sentry/react-native": "*",
