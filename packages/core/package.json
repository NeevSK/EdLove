{
  "name": "@repo/core",
  "version": "0.1.0",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "sideEffects": false,
  "engines": {
    "node": ">=20.0.0"
  },
  "exports": {
