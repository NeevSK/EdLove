    "test:g1:account-transition": "node ../../scripts/run-and-report.mjs --cmd \"vitest run src/accounts/__tests__/accountTransition.test.ts -t 'does not change command ownership'\" --name \"packages_core-test_g1_account_transition\" --evidence-level G1",
    "test:g1:account-switch": "node ../../scripts/run-and-report.mjs --cmd \"vitest run src/accounts/__tests__/deviceAccounts.test.ts -t 'quarantines outgoing work'\" --name \"packages_core-test_g1_account_switch\" --evidence-level G1",
    "test:invariants": "node ../../scripts/run-and-report.mjs --cmd \"vitest run src/native/__tests__/guestIdentity.invariants.test.ts\" --name \"packages_core-test_invariants\" --evidence-level G2",
    "test": "node ../../scripts/run-and-report.mjs --cmd \"vitest run\" --name \"packages_core-test\" --evidence-level G1",
    "test:watch": "node ../../scripts/run-and-report.mjs --cmd \"vitest\" --name \"packages_core-test_watch\" --evidence-level G1",
    "test:ui": "node ../../scripts/run-and-report.mjs --cmd \"vitest --ui\" --name \"packages_core-test_ui\" --evidence-level G1"
