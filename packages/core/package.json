{
  "name": "@repo/core",
  "version": "0.0.1",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "sideEffects": false,
  "engines": {
    "node": ">=20.0.0"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./logic": {
      "types": "./src/logic/index.ts",
      "import": "./src/logic/index.ts"
    },
    "./native": {
      "types": "./src/native/index.ts",
      "import": "./src/native/index.ts"
    },
    "./types": {
      "types": "./src/types/index.ts",
      "import": "./src/types/index.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "lint": "pnpm run lint:biome && pnpm run lint:eslint",
    "lint:biome": "biome check .",
    "lint:eslint": "eslint .",
    "format": "biome format --write .",
    "check-cycles": "powershell -File ../../scripts/audit-wrapper.ps1 -Cmd \"pnpm exec node ../../scripts/refactor/check-barrel-imports.mjs\" -Log \"reports/check-cycles.txt\"",
    "check-types": "powershell -File ../../scripts/audit-wrapper.ps1 -Cmd \"pnpm exec tsc --noEmit\" -Log \"reports/check-types.txt\"",
    "test:logic": "vitest run src/logic",
    "clean": "rm -rf .turbo node_modules"
  },
  "peerDependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@sentry/react-native": "*",
    "@supabase/postgrest-js": "2.102.1",
    "@supabase/supabase-js": "2.102.1",
    "expo-constants": "*",
    "expo-secure-store": "~55.0.9",
    "react": "*",
    "react-native": "*",
    "react-native-mmkv": "*",
    "react-native-url-polyfill": "*",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@supabase/supabase-js": "^2.39.0",
    "@tanstack/react-query": "^5.90.20",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.10",
    "@types/react": "19.2.14",
    "@types/react-native": "workspace:*",
    "@types/uuid": "^10.0.0",
    "@vitest/ui": "^4.1.5",
    "eslint": "^9.38.0",
    "jest": "^29.7.0",
    "pino-pretty": "^13.1.3",
    "tailwindcss": "~3.4.17",
    "typescript": "~5.9.2",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^2.1.9",
    "zustand": "^5.0.10"
  },
  "dependencies": {
    "@casl/ability": "^6.8.0",
    "@casl/react": "^5.0.1",
    "@react-native-community/netinfo": "^11.4.1",
    "@sentry/browser": "^10.19.0",
    "@supabase/postgrest-js": "2.102.1",
    "@supabase/supabase-js": "2.102.1",
    "@tanstack/react-query": "^5.90.20",
    "@ts-rest/core": "3.53.0-rc.1",
    "@zenstackhq/schema": "3.5.5",
    "@zenstackhq/zod": "3.5.5",
    "date-fns": "^4.1.0",
    "i18next": "^25.8.11",
    "inngest": "^4.2.4",
    "pino": "^9.14.0",
    "posthog-react-native": "^4.35.1",
    "react-i18next": "^16.5.4",
    "uuid": "^13.0.0",
    "zod": "^3.25.76"
  }
}
