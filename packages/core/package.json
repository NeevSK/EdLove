      "types": "./src/api/hooks/index.ts",
      "import": "./src/api/hooks/index.ts"
    },
    "./api/runtimes/*": {
      "types": "./src/api/runtimes/*.ts",
      "import": "./src/api/runtimes/*.ts"
    },
    "./logic": {
      "types": "./src/logic/index.ts",
      "import": "./src/logic/index.ts"
    },
    "./logic/schemas/*": {
      "types": "./src/logic/schemas/*.ts",
      "import": "./src/logic/schemas/*.ts"
    },
    "./zen": {
      "types": "./src/logic/generated/index.ts",
      "import": "./src/logic/generated/index.ts"
    },
