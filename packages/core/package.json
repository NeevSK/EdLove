    "expo-haptics": "*",
    "expo-location": "*",
    "expo-notifications": "*",
    "jest": "^29.7.0",

    "pino-pretty": "^13.1.3",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^2.1.9",
    "zustand": "^5.0.10",
    "@repo/typescript-config": "workspace:*"
