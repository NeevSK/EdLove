{
  "extends": "../../packages/typescript-config/base.json",
  "compilerOptions": {
    "lib": ["es2020", "dom"],
    "target": "es2020",
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@powersync/react-native": ["src/adapters/powersync/powersync-shim.d.ts"],
      "@powersync/react": ["src/adapters/powersync/powersync-react-shim.d.ts"]
    },
    "types": ["vitest/importMeta", "vitest/globals", "@repo/types-shim"]
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules"]
}
