{
  "extends": "../../packages/typescript-config/base.json",
  "compilerOptions": {
    "lib": ["es2022", "dom"],
    "target": "es2020",
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "composite": true,
    "emitDeclarationOnly": true,
    "outDir": "dist",
    "paths": {
      "@/*": ["./src/*"],
      "@repo/core/*": ["./src/*", "./src/*/index.ts", "./src/*/index.tsx"],
      "@repo/core": ["./src/index.ts"],
      "@repo/verger-core": ["../verger-core/dist/index.d.ts"],
      "@repo/ui": ["../ui/dist/index.d.ts"],
      "@repo/ui/*": ["../ui/dist/*"]
    },
    "types": ["vitest/importMeta", "vitest/globals", "@repo/types-shim"],
    "rootDir": "./src"
  },
  "include": ["src/**/*", "src/**/*.json"],
  "exclude": [
    "node_modules",
    "src/**/__tests__/**/*",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.ts",
    "src/**/*.bench.ts",
    "src/api/academicCycles.ts",
    "src/api/assignments.ts",
    "src/api/attendance-v1.orpc.contract.ts",
    "src/api/auth.ts",
    "src/api/classroomGroups.ts",
    "src/api/classroomNotes.ts",
    "src/api/classroomStudents.ts",
    "src/api/contextualChallenges.ts",
    "src/api/growthSignals.ts",
    "src/api/impactRipples.ts",
    "src/api/lessonMaterials.ts",
    "src/api/media.ts",
    "src/api/naturePaths.ts",
    "src/api/onboarding.ts",
    "src/api/profile.ts",
    "src/api/school.ts",
    "src/api/serverAdapter.ts",
    "src/api/teacher.ts",
    "src/api/teacherInsights.ts",
    "src/api/userGrowthState.ts"
  ]
}
