{
  "extends": "../../packages/typescript-config/base.json",
  "compilerOptions": {
    "lib": ["es2020", "dom"],
    "target": "es2020",
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "composite": true,
    "paths": {
      "@/*": ["./src/*"],
      "@powersync/op-sqlite": ["./src/adapters/powersync/opsqlite.shim.ts"],
      "@powersync/web": ["./src/adapters/powersync/wasqlite.shim.ts"],
      "@powersync/react-native": ["./src/adapters/powersync/powersync-shim.ts"],
      "@powersync/react": ["./src/adapters/powersync/powersync-react-shim.ts"]
    },
    "types": ["vitest/importMeta", "vitest/globals", "@repo/types-shim"],
    "rootDir": "./src"
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules"]
}
