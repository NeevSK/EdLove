{
  "extends": "../../packages/typescript-config/base.json",
  "compilerOptions": {
    "lib": [
      "es2020",
      "dom"
    ],
    "target": "es2020",
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "composite": true,
    "emitDeclarationOnly": true,
    "outDir": "dist",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@powersync/op-sqlite": [
        "./src/adapters/powersync/opsqlite.shim.ts"
      ],
      "@powersync/web": [
        "./src/adapters/powersync/wasqlite.shim.ts"
      ],
      "@powersync/react-native": [
        "./src/adapters/powersync/powersync-shim.ts"
      ],
      "@powersync/react": [
        "./src/adapters/powersync/powersync-react-shim.ts"
      ],
      "@repo/core/*": [
        "./src/*"
      ],
      "@repo/ui": [
        "../ui/dist/index.d.ts"
      ],
      "@repo/ui/*": [
        "../ui/dist/*"
      ]
    },
    "types": [
      "vitest/importMeta",
      "vitest/globals",
      "@repo/types-shim"
    ],
    "rootDir": "./src"
  },
  "include": [
    "src/**/*",
    "src/**/*.json"
  ],
  "exclude": [
    "node_modules"
  ]
}
