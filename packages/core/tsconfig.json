{
  "extends": "../../packages/typescript-config/base.json",
  "compilerOptions": {
    "lib": ["es2022", "dom"],
    "target": "es2020",
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "composite": true,
    "emitDeclarationOnly": true,
    "outDir": "dist",
    "paths": {
      "@/*": ["./src/*"],
      "@repo/core/*": ["./src/*"],
      "@repo/ui": ["../ui/dist/index.d.ts"],
      "@repo/ui/*": ["../ui/dist/*"]
    },
    "types": ["vitest/importMeta", "vitest/globals", "@repo/types-shim"],
    "rootDir": "./src"
  },
  "include": ["src/**/*", "src/**/*.json"],
  "exclude": ["node_modules"]
}
