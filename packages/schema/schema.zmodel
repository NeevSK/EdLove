datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

plugin orm {
  provider = "@zenstackhq/orm"
  output = "./src/generated/orm"
}

plugin policy {
  provider = "@zenstackhq/plugin-policy"
}

/*
 * POA Authorization Mapping
 * --------------------------
 * Capabilities defined in CASL are mapped here to ZenStack policies.
 */

model User {
  id        String   @id @default(uuid())
  email     String?  @unique
  full_name String
  display_name String?
  first_name String?
  last_name String?
  identity_state String?
  username  String?  @unique
  avatar_url String?
  bio       String?
  phone     String?
  index_number String?
  nic_number String?
  public_profile Boolean? @default(true)
  profile_completed Boolean? @default(false)
  is_anonymous Boolean @default(false)
  capacity String?
  citizenship String @default("THIRD_CLASS") // THIRD_CLASS, SECOND_CLASS, FIRST_CLASS; WANDERER is a legacy alias
  pricing_tier String @default("FREE") // FREE, PRO, INSTITUTIONAL
  is_thuthimal Boolean? @default(false)
  thuthimal_gifter String?
  thuthimal_gifted_at DateTime?
  experience_years Int?
  subjects_taught String[]
  qualifications String[]
  tenant_kind String?
  onboarding_completed Boolean? @default(false)
  onboarding_completed_at DateTime?
  school_id String?
  metadata Json?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  last_seen_at DateTime?
  escrowed_recovery_key String?
  deleted_at DateTime?
  deleted_by String?
  deletion_reason String?
  posts     Post[]
  memberships GroupMember[]
  social_links UserSocialLink[]
  
  classrooms Classroom[] @relation("TeacherClassrooms")
  student_attendance AttendanceRecord[] @relation("StudentAttendance")
  student_enrollments ClassroomStudent[] @relation("StudentEnrollments")
  assignment_submissions AssignmentSubmission[] @relation("StudentSubmissions")
  student_grades Grade[] @relation("StudentGrades")
  grades_given Grade[] @relation("GradedBy")
  reactions CommunityReaction[]
  messages  GroupMessage[]
  ai_messages AiMessage[]
  community_comments CommunityComment[] @relation("CommunityCommentAuthor")
  community_comment_upvotes CommunityCommentUpvote[] @relation("CommunityCommentUpvoteUser")
  direct_conversations_user1 DirectConversation[] @relation("DirectConversationUser1")
  direct_conversations_user2 DirectConversation[] @relation("DirectConversationUser2")
  direct_messages DirectMessage[] @relation("DirectMessageAuthor")
  principal_notes PrincipalNote[] @relation("PrincipalNotesAuthored")
  context_teacher_notes PrincipalNote[] @relation("PrincipalNotesContextTeacher")
  blocked_users UserBlock[] @relation("UserBlocksInitiated")
  blocked_by_users UserBlock[] @relation("UserBlocksReceived")
  mood_logs MoodLog[]
  journal_entries FireJournalEntry[]
  thought_records ThoughtRecord[]
  learning_reflections LearningReflection[]
  preferences UserPreferences?
  personal_classrooms PersonalClassroom[]
  notifications Notification[]
  push_tokens PushToken[]

  // Growth & Wellbeing
  gifts_given ThuthimalGift[] @relation("GiftsGiven")
  gifts_received ThuthimalGift[] @relation("GiftsReceived")
  gratitude_gifts_sent GratitudeGift[] @relation("GratitudeGiftsSent")
  gratitude_gifts_received GratitudeGift[] @relation("GratitudeGiftsReceived")
  impact_ripples ImpactRipple[] @relation("RecipientRipples")
  actions_rippled ImpactRipple[] @relation("ActorRipples")
  whispered_moments WhisperedMoment[]
  growth_events GrowthEvent[]
  growth_state UserGrowthState?
  manifesto_endorsements ManifestoEndorsement[]

  // HR & Staff
  staff_leaves StaffLeave[]
  
  // Guardian & Relationship
  student_guardian_links StudentGuardianRelationship[] @relation("StudentGuardians")
  student_guardian_links_as_guardian StudentGuardianRelationship[] @relation("GuardianStudents")
  guardian_identities GuardianIdentity[] @relation("UserGuardianIdentities")
  announcements_authored Announcement[] @relation("AnnouncementAuthor")

  // Accounting & Payments
  invoices Invoice[]

  classroom_notes ClassroomNote[]
  longitudinal_events StudentLongitudinalEvent[] @relation("StudentEvents")
  audit_logs SentinelAuditLog[] @relation("AuditLogs")
  bonds      Bond[]
  entitlement_grants UserEntitlementGrant[]
  created_invite_codes InviteCode[] @relation("InviteCodeCreator")
  classroom_join_requests ClassroomJoinRequest[]
  classroom_legacy_records ClassroomLegacyRecord[] @relation("LegacyTeacherRecords")
  school_join_requests SchoolJoinRequest[]
  school_memberships SchoolMembership[]
  school_registry_claims_requested SchoolRegistryClaim[] @relation("SchoolRegistryClaimRequester")
  school_registry_claims_reviewed SchoolRegistryClaim[] @relation("SchoolRegistryClaimReviewer")

  // Academic lifecycle foundation (separate from legacy classroom semantics)
  cycle_leadership_assignments AcademicCycleLeadershipAssignment[] @relation("CycleLeadershipAssignee")
  grade_class_teacher_assignments GradeClassTeacherAssignment[] @relation("GradeClassTeacher")
  student_grade_class_enrollments StudentGradeClassEnrollment[] @relation("GradeClassStudent")
  student_daily_attendance DailyAttendance[] @relation("DailyAttendanceStudent")
  student_attendance_sessions AttendanceSession[] @relation("AttendanceSessionStudent")
  teacher_attendance_sessions_covered AttendanceSession[] @relation("AttendanceSessionTeacher")
  teacher_daily_attendance TeacherDailyAttendance[] @relation("TeacherDailyAttendanceTeacher")
  teacher_attendance_sessions TeacherAttendanceSession[] @relation("TeacherAttendanceSessionTeacher")
  grade_marks GradeMark[] @relation("StudentGradeMarks")
  energy_balance UserEnergyBalance?
  ad_reward_transactions AdRewardTransaction[]

  // Commercial Tuition & Perspectives
  created_tuition_institutes TuitionInstitute[] @relation("TuitionInstituteCreator")
  tuition_batches TuitionBatch[] @relation("TutorBatches")
  guardian_bonds_as_guardian GuardianBond[] @relation("GuardianBondsAsGuardian")
  guardian_bonds_as_ward GuardianBond[] @relation("GuardianBondsAsWard")

  // Anonymous Supabase users are valid onboarding principals. They use the
  // same authenticated subject policy surface; no guest-only policy exists.
  // Only the user themselves or a platform admin can update profile details in the cloud
  @@allow('all', auth() != null && auth().id == id)
  @@allow('all', auth() != null && auth().bonds?[capacity == 'admin' && entity_type == 'PLATFORM'])
  
  // Everyone can read basic profile info (Discovery)
  @@allow('read', true)
  // Shadow learners (added to a roster before they have an account) are created by a
  // teacher or leader of the same school; nothing else about another user can be written.
  @@allow('create', auth() != null && identity_state == 'shadow' && is_anonymous == true && school_id != null && auth().bonds?[entity_id == this.school_id && (capacity == 'teacher' || capacity == 'principal' || capacity == 'section_head' || capacity == 'grade_head')])

  @@map("users")
}

/**
 * Bond: The atomic unit of ReBAC.
 * Represents a relationship between a User and an Entity (Platform, School, Classroom).
 */
model Bond {
  id          String   @id @default(uuid())
  user_id     String
  entity_id   String   // 'GLOBAL' for platform, or specific School/Classroom ID
  entity_type String   // 'PLATFORM', 'SCHOOL', 'CLASSROOM', 'COMMUNITY'
  capacity    String   // 'admin', 'teacher', 'student', etc.
  status      String   @default("active") // active, archived, revoked
  valid_from  DateTime @default(now())
  valid_until DateTime?
  metadata    Json?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  user        User     @relation(fields: [user_id], references: [id])
  selected_by UserPreferences? @relation("SelectedBond")

  // Access Control: Platform Admins or the user themselves can manage their bonds
  @@allow('all', auth().bonds?[capacity == 'admin' && entity_type == 'PLATFORM'])
  @@allow('read', auth() != null && user_id == auth().id)
  @@allow('create', auth() != null && user_id == auth().id)
  
  @@map("bonds")
}

/**
 * Commercial or institutional access granted to one user in one scope.
 * `users.pricing_tier` remains a compatibility projection for the individual
 * plan only; it is not the authority for school/institution access.
 */
model UserEntitlementGrant {
  id          String   @id @default(uuid())
  user_id     String
  bond_id     String?
  entity_id   String?
  entity_type String?
  scope_type  String   // INDIVIDUAL, BOND, ENTITY, ADD_ON
  tier        String   // FREE, PRO, INSTITUTIONAL
  modules     String[]
  source      String
  status      String   @default("ACTIVE") // ACTIVE, SUSPENDED, REVOKED
  starts_at   DateTime @default(now())
  expires_at  DateTime?
  metadata    Json?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  user        User     @relation(fields: [user_id], references: [id])

  @@allow('read', auth().id == user_id || auth().bonds?[capacity == 'admin' && entity_type == 'PLATFORM'])
  @@allow('all', auth().bonds?[capacity == 'admin' && entity_type == 'PLATFORM'])
  @@index([user_id, scope_type, status])
  @@index([user_id, bond_id, status])
  @@map("user_entitlement_grants")
}

model UserSocialLink {
  id            String   @id @default(uuid())
  user_id       String
  platform      String
  url           String
  is_public     Boolean  @default(true)
  privacy_level String   @default("public")
  order_index   Int      @default(0)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  user          User     @relation(fields: [user_id], references: [id])

  @@allow('read', auth() != null && (is_public == true || user_id == auth().id || auth().bonds?[capacity == 'admin' && entity_type == 'PLATFORM']))
  @@allow('all', auth() != null && (user_id == auth().id || auth().bonds?[capacity == 'admin' && entity_type == 'PLATFORM']))

  @@map("user_social_links")
}

model Classroom {
  id               String   @id @default(uuid())
  school_id        String?
  grade_id         String?
  teacher_id       String?
  section_id       String?
  name             String
  handle           String?
  subject          String?
  description      String?
  color_theme      String?
  is_archived      Boolean  @default(false)
  academic_year    String
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt
  created_by       String?
  deleted_at       DateTime?
  deleted_by       String?
  deletion_reason  String?

  school           School?    @relation(fields: [school_id], references: [id])
  teacher          User?      @relation("TeacherClassrooms", fields: [teacher_id], references: [id])
  students         ClassroomStudent[]
  assignments      Assignment[]
  grades           Grade[]
  settings         ClassroomGradingSettings?
  lessons          Lesson[]
  materials        Material[]
  attendance       AttendanceRecord[]
  inventory        InventoryItem[]
  notes            ClassroomNote[]
  principal_notes  PrincipalNote[] @relation("PrincipalNotesContextClassroom")
  join_requests    ClassroomJoinRequest[]
  legacy_records   ClassroomLegacyRecord[]

  // Permissions
  // Official/Cloud Access: Teachers, School Admins, and Platform Admins
  @@allow('read', auth() != null)
  @@allow('all', auth() != null && (
    auth().id == teacher_id || 
    auth().bonds?[capacity == 'admin' && entity_type == 'PLATFORM'] ||
    auth().bonds?[entity_id == this.school_id && (capacity == 'principal' || capacity == 'section_head')]
  ))

  @@map("classrooms")
}

model PersonalClassroom {
  id         String   @id @default(uuid())
  user_id    String
  name       String
  type       String   // 'teacher_classroom' | 'student_classroom' | 'unrelated_classroom' | 'undefined'
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  // Permissions: Only the owner user or platform admin can manage
  @@allow('all', auth() != null && user_id == auth().id)
  @@allow('all', auth().bonds?[capacity == 'admin' && entity_type == 'PLATFORM'])
  @@allow('read', auth() != null && user_id == auth().id)

  @@map("personal_classrooms")
}

model ClassroomStudent {
  id           String    @id @default(uuid())
  classroom_id String
  student_id   String?
  full_name    String?
  invite_code  String?   @unique
  roll_number  Int?
  enrolled_at  DateTime  @default(now())
  claimed_at   DateTime?
  status       String    @default("active") // active, left, suspended
  joined_at    DateTime  @default(now()) // legacy compatibility timestamp
  notes        String?

  classroom    Classroom @relation(fields: [classroom_id], references: [id])
  student      User?     @relation("StudentEnrollments", fields: [student_id], references: [id])

  @@unique([classroom_id, student_id])
  @@index([student_id, status])
  @@index([classroom_id, status])

  @@allow('read', classroom.teacher_id == auth().id || student_id == auth().id || auth().bonds?[capacity == 'admin' && entity_type == 'PLATFORM'])
  @@allow('all', classroom.teacher_id == auth().id || auth().bonds?[capacity == 'admin' && entity_type == 'PLATFORM'])
  // School leaders may manage rosters of their school's classrooms (as Classroom allows).
  @@allow('all', auth() != null && auth().bonds?[entity_id == this.classroom.school_id && (capacity == 'principal' || capacity == 'section_head')])

  @@map("classroom_students")
}

model Assignment {
  id           String   @id @default(uuid())
  title        String
  description  String?
  classroom_id String
  lesson_id    String?
  due_date     DateTime?
  max_points   Int      @default(100)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  classroom    Classroom @relation(fields: [classroom_id], references: [id])
  grades       Grade[]
  submissions  AssignmentSubmission[]

  // Permissions
  @@allow('read', classroom.teacher_id == auth().id || (auth() != null && classroom.is_archived == false))
  @@allow('all', classroom.teacher_id == auth().id || auth().bonds?[capacity == 'admin' && entity_type == 'PLATFORM'])

  @@map("assignments")
  @@index([classroom_id, due_date])
}

model Grade {
  id            String   @id @default(uuid())
  classroom_id  String
  assignment_id String?
  student_id    String
  graded_by     String
  marks         Float
  grade         String
  gpa           Float
  feedback      String?
  publication_state String @default("draft") // draft, published
  published_at      DateTime?
  published_by      String?
  publication_action String?
  graded_at         DateTime @default(now())
  deleted_at        DateTime?
  idempotency_key   String? @unique
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  classroom     Classroom  @relation(fields: [classroom_id], references: [id])
  assignment    Assignment? @relation(fields: [assignment_id], references: [id])
  student       User       @relation("StudentGrades", fields: [student_id], references: [id])
  grader        User       @relation("GradedBy", fields: [graded_by], references: [id])

  // Permissions
  @@allow('read', auth().id == student_id || auth().id == graded_by || classroom.teacher_id == auth().id || auth().bonds?[capacity == 'admin' && entity_type == 'PLATFORM'])
  @@allow('all', auth().id == graded_by || classroom.teacher_id == auth().id || 
    auth().bonds?[capacity == 'admin' && entity_type == 'PLATFORM'] ||
    auth().bonds?[entity_id == this.classroom.school_id && (capacity == 'principal' || capacity == 'section_head' || capacity == 'grade_head')]
  )

  @@map("student_grades")
  @@index([student_id, created_at])
  @@index([classroom_id, student_id])
  @@index([assignment_id])
}

model ClassroomJoinRequest {
  id           String   @id @default(uuid())
  user_id      String
  classroom_id String
  role         String
  subject_label String?
  status       String   @default("pending")
  message      String?
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  user         User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  classroom    Classroom @relation(fields: [classroom_id], references: [id], onDelete: Cascade)

  @@index([classroom_id, status])
  @@index([user_id, status])
  @@allow('read', user_id == auth().id || classroom.teacher_id == auth().id || auth().bonds?[capacity == 'admin' && entity_type == 'PLATFORM'])
  @@allow('create', user_id == auth().id)
  @@allow('update', user_id == auth().id || classroom.teacher_id == auth().id || auth().bonds?[capacity == 'admin' && entity_type == 'PLATFORM'])
  @@map("classroom_join_requests")
}

model ClassroomLegacyRecord {
  id              String   @id @default(uuid())
  classroom_id    String
  academic_year   String
  teacher_id      String
  student_count   Int      @default(0)
  avg_performance Float?
  top_achievements String[]
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  classroom       Classroom @relation(fields: [classroom_id], references: [id], onDelete: Cascade)
  teacher         User?     @relation("LegacyTeacherRecords", fields: [teacher_id], references: [id])

  @@index([teacher_id, academic_year])
  @@allow('read', classroom.teacher_id == auth().id || auth().bonds?[entity_id == this.classroom.school_id] || auth().bonds?[capacity == 'admin' && entity_type == 'PLATFORM'])
  @@allow('all', classroom.teacher_id == auth().id || auth().bonds?[capacity == 'admin' && entity_type == 'PLATFORM'])
  @@map("classroom_legacy_records")
}

model AssignmentSubmission {
  id              String   @id @default(uuid())
  assignment_id   String
  student_id      String
  content         String?
  photo_url       String?
  submitted_at    DateTime @default(now())
  grade           Int?
  feedback        String?
  graded_at       DateTime?
  idempotency_key String?

  assignment Assignment @relation(fields: [assignment_id], references: [id])
  student    User       @relation("StudentSubmissions", fields: [student_id], references: [id])

  @@unique([assignment_id, student_id])
  @@unique([student_id, idempotency_key])
  @@index([student_id, submitted_at])
  @@index([assignment_id, submitted_at])

  @@allow('read', student_id == auth().id || assignment.classroom.teacher_id == auth().id || auth().bonds?[capacity == 'admin' && entity_type == 'PLATFORM'])
  @@allow('create', student_id == auth().id)
  @@allow('update', assignment.classroom.teacher_id == auth().id || auth().bonds?[capacity == 'admin' && entity_type == 'PLATFORM'])

  @@map("submissions")
}

model Notification {
  id              String   @id @default(uuid())
  user_id         String
  type            String
  title           String
  body            String
  metadata        Json?
  read_at         DateTime?
  created_at      DateTime @default(now())
  is_read         Boolean  @default(false)
  reference_id    String?
  reference_type  String?
  idempotency_key String?  @unique

  user User @relation(fields: [user_id], references: [id])

  @@index([user_id, created_at])
  @@index([user_id, is_read])

  @@allow('read', user_id == auth().id)
  @@allow('create', user_id == auth().id)
  @@allow('update', user_id == auth().id)
  @@allow('delete', user_id == auth().id)

  @@map("notifications")
}

model PushToken {
  id           String   @id @default(uuid())
  user_id      String
  push_token   String
  device_id    String
  platform     String
  last_seen_at DateTime?
  created_at   DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, device_id])
  @@index([user_id, platform])

  // Token material is only manageable by its owning account. Server-side
  // delivery uses the service role and does not depend on client policy.
  @@allow('all', user_id == auth().id)

  @@map("user_push_tokens")
}

model ClassroomGradingSettings {
  classroom_id String @id
  grading_mode String @default("both")
  show_ranks   Boolean @default(true)
  classroom    Classroom @relation(fields: [classroom_id], references: [id])

  // Permissions
  @@allow('read', classroom.teacher_id == auth().id || (auth() != null && classroom.is_archived == false))
  @@allow('all', classroom.teacher_id == auth().id || auth().bonds?[capacity == 'admin' && entity_type == 'PLATFORM'])

  @@map("classroom_grading_settings")
}

model Group {
  id          String   @id @default(uuid())
  name        String
  description String?
  school_id   String
  created_by  String?
  group_type  String?  @default("general") // class, interest, general
  join_policy String?  @default("open")    // open, restricted, closed
  is_public   Boolean? @default(true)
  created_at  DateTime @default(now())
  classroom_id String?
  image_url   String?
  member_count Int?    @default(0)
  handle      String?

  members     GroupMember[]
  posts       Post[]
  messages    GroupMessage[]
  school      School   @relation(fields: [school_id], references: [id])

  // Permissions
  @@allow('read', is_public == true)
  @@allow('read', members?[user_id == auth().id])
  @@allow('all', created_by == auth().id || auth().bonds?[capacity == 'admin' && entity_type == 'PLATFORM'])

  @@map("community_groups")
  @@index([school_id, created_at])
}

model GroupMember {
  id       String @id @default(uuid())
  user_id  String
  group_id String
  role     String @default("member") // owner, moderator, member
  status   String @default("active") // active, pending, rejected
  joined_at DateTime?
  
  user     User   @relation(fields: [user_id], references: [id])
  group    Group  @relation(fields: [group_id], references: [id])

  @@unique([user_id, group_id])
  @@index([group_id, status])

  @@allow('read', group.is_public == true || group.members?[user_id == auth().id])
  @@allow('all', auth() != null && user_id == auth().id)
  @@allow('all', group.created_by == auth().id || auth().bonds?[capacity == 'admin' && entity_type == 'PLATFORM'])

  @@map("community_group_members")
}

model Post {
  id               String   @id @default(uuid())
  group_id         String
  author_id        String
  school_id        String?
  content          String
  post_type        String?  @default("discussion")
  author_role      String?
  media_url        String?
  media_type       String?
  poll_data        Json?
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt
  deleted_at       DateTime?

  group            Group    @relation(fields: [group_id], references: [id])
  author           User     @relation(fields: [author_id], references: [id])
  reactions        CommunityReaction[]
  comments         CommunityComment[]

  // Authors can manage their own posts
  @@allow('all', auth() != null && author_id == auth().id)
  
  // Members of the group can read posts
  @@allow('read', group.is_public == true || group.members?[user_id == auth().id])

  @@map("community_posts")
  @@index([group_id, created_at])
  @@index([author_id, created_at])
}

model GroupMessage {
  id          String   @id @default(uuid())
  group_id    String
  author_id   String
  content     String
  created_at  DateTime @default(now())
  updated_at  DateTime @default(now())
  deleted_at  DateTime?
  idempotency_key String?

  group       Group    @relation(fields: [group_id], references: [id])
  author      User     @relation(fields: [author_id], references: [id])

  @@allow('read', group.members?[user_id == auth().id])
  @@allow('create', group.members?[user_id == auth().id])

  @@map("group_messages")
  @@index([group_id, created_at])
}

model AiMessage {
  id           String    @id @default(uuid())
  thread_id    String
  user_id      String
  role         String // 'user' | 'assistant'
  content      String
  privacy_mode String    @default("saved") // saved | temporary | incognito
  expires_at   DateTime?
  created_at   DateTime  @default(now())

  user         User      @relation(fields: [user_id], references: [id])

  // Owners can manage their own AI message history
  @@allow('read', auth() != null && user_id == auth().id)
  @@allow('create', auth() != null && user_id == auth().id)
  @@allow('update', auth() != null && user_id == auth().id)
  @@allow('delete', auth() != null && user_id == auth().id)

  @@map("ai_messages")
}

model CommunityReaction {
  id          String @id @default(uuid())
  post_id     String
  user_id     String
  emoji       String @default("❤️")
  created_at  DateTime?
  
  post        Post   @relation(fields: [post_id], references: [id])
  user        User   @relation(fields: [user_id], references: [id])

  @@unique([post_id, user_id])
  @@index([user_id, created_at])

  @@allow('read', post.group.is_public || post.group.members?[user_id == auth().id])
  @@allow('all', user_id == auth().id)

  @@map("community_reactions")
}

model CommunityComment {
  id                 String   @id @default(uuid())
  post_id            String
  author_id          String?
  content            String
  is_anonymous       Boolean  @default(false)
  is_official_answer Boolean  @default(false)
  upvote_count       Int      @default(0)
  created_at         DateTime @default(now())
  updated_at         DateTime @default(now()) @updatedAt

  post               Post     @relation(fields: [post_id], references: [id], onDelete: Cascade)
  author             User?    @relation("CommunityCommentAuthor", fields: [author_id], references: [id], onDelete: SetNull)
  upvotes            CommunityCommentUpvote[]

  @@index([post_id, created_at])
  @@index([author_id, created_at])

  @@allow('read', post.group.is_public || post.group.members?[user_id == auth().id])
  @@allow('create', auth() != null)
  @@allow('update', auth() != null && author_id == auth().id)
  @@allow('delete', auth() != null && (author_id == auth().id || post.author_id == auth().id))

  @@map("community_comments")
}

model CommunityCommentUpvote {
  comment_id String
  user_id    String
  created_at DateTime @default(now())

  comment    CommunityComment @relation(fields: [comment_id], references: [id], onDelete: Cascade)
  user       User             @relation("CommunityCommentUpvoteUser", fields: [user_id], references: [id], onDelete: Cascade)

  @@id([comment_id, user_id])
  @@allow('all', auth() != null && user_id == auth().id)

  @@map("community_comment_upvotes")
}

model DirectConversation {
  id         String   @id @default(uuid())
  user1_id   String
  user2_id   String
  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  user1      User     @relation("DirectConversationUser1", fields: [user1_id], references: [id], onDelete: Cascade)
  user2      User     @relation("DirectConversationUser2", fields: [user2_id], references: [id], onDelete: Cascade)
  messages   DirectMessage[]

  @@unique([user1_id, user2_id])
  @@index([user1_id])
  @@index([user2_id])

  @@allow('read', auth() != null && (user1_id == auth().id || user2_id == auth().id))
  @@allow('create', auth() != null && (user1_id == auth().id || user2_id == auth().id))
  @@allow('update', auth() != null && (user1_id == auth().id || user2_id == auth().id))
  @@allow('delete', auth() != null && (user1_id == auth().id || user2_id == auth().id))

  @@map("direct_conversations")
}

model DirectMessage {
  id              String   @id @default(uuid())
  conversation_id String
  author_id       String
  content         String
  created_at      DateTime @default(now())

  conversation    DirectConversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  author          User               @relation("DirectMessageAuthor", fields: [author_id], references: [id], onDelete: Cascade)

  @@index([conversation_id, created_at])

  @@allow('read', auth() != null && (conversation.user1_id == auth().id || conversation.user2_id == auth().id))
  @@allow('create', auth() != null && author_id == auth().id && (conversation.user1_id == auth().id || conversation.user2_id == auth().id))
  @@allow('delete', auth() != null && author_id == auth().id)

  @@map("direct_messages")
}

model PrincipalNote {
  id                   String    @id @default(uuid())
  school_id            String
  author_id            String
  content              String
  note_type            String    @default("note")
  is_pinned            Boolean   @default(false)
  is_done              Boolean   @default(false)
  context_teacher_id   String?
  context_classroom_id String?
  target_date          DateTime?
  created_at           DateTime  @default(now())
  updated_at           DateTime  @default(now()) @updatedAt

  school               School     @relation("SchoolPrincipalNotes", fields: [school_id], references: [id], onDelete: Cascade)
  author               User       @relation("PrincipalNotesAuthored", fields: [author_id], references: [id], onDelete: Cascade)
  context_teacher      User?      @relation("PrincipalNotesContextTeacher", fields: [context_teacher_id], references: [id], onDelete: SetNull)
  context_classroom    Classroom? @relation("PrincipalNotesContextClassroom", fields: [context_classroom_id], references: [id], onDelete: SetNull)

  @@index([school_id, created_at])
  @@index([school_id, target_date])
  @@index([author_id, school_id])

  @@allow('read', auth() != null && author_id == auth().id)
  @@allow('create', auth() != null && author_id == auth().id)
  @@allow('update', auth() != null && author_id == auth().id)
  @@allow('delete', auth() != null && author_id == auth().id)

  @@map("principal_notes")
}

model UserBlock {
  id         String   @id @default(uuid())
  blocker_id String
  blocked_id String
  created_at DateTime @default(now())

  blocker    User     @relation("UserBlocksInitiated", fields: [blocker_id], references: [id], onDelete: Cascade)
  blocked    User     @relation("UserBlocksReceived", fields: [blocked_id], references: [id], onDelete: Cascade)

  @@unique([blocker_id, blocked_id])
  @@index([blocker_id])
  @@index([blocked_id])

  @@allow('read', auth() != null && blocker_id == auth().id)
  @@allow('create', auth() != null && blocker_id == auth().id)
  @@allow('delete', auth() != null && blocker_id == auth().id)

  @@map("user_blocks")
}

model Lesson {
  id           String   @id @default(uuid())
  classroom_id String
  title        String
  content      String?
  order_index  Int      @default(0)
  published_at DateTime?
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  classroom    Classroom @relation(fields: [classroom_id], references: [id])
  materials    Material[]

  // Permissions
  @@allow('read', classroom.teacher_id == auth().id || (auth() != null && classroom.is_archived == false))
  @@allow('all', classroom.teacher_id == auth().id || auth().bonds?[capacity == 'admin' && entity_type == 'PLATFORM'])

  @@map("lessons")
  @@index([classroom_id, order_index])
}

model Material {
  id           String   @id @default(uuid())
  classroom_id String
  lesson_id    String?
  title        String
  type         String   // Maps to ResourceType
  url          String?
  content      String?
  is_pinned    Boolean  @default(false)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  classroom    Classroom @relation(fields: [classroom_id], references: [id])
  lesson       Lesson?   @relation(fields: [lesson_id], references: [id])

  // Permissions
  @@allow('read', classroom.teacher_id == auth().id || (auth() != null && classroom.is_archived == false))
  @@allow('all', classroom.teacher_id == auth().id || auth().bonds?[capacity == 'admin' && entity_type == 'PLATFORM'])

  @@map("lesson_materials")
  @@index([lesson_id])
  @@index([classroom_id, created_at])
}

model AttendanceRecord {
  classroom_id String
  student_id   String
  status       String   // e.g., "present", "absent", "late"
  date         DateTime @default(now())
  idempotency_key String? @default(uuid()) @unique

  classroom    Classroom @relation(fields: [classroom_id], references: [id])
  student      User      @relation("StudentAttendance", fields: [student_id], references: [id])

  // Permissions: Teachers and Admins can manage attendance for their classroom
  @@allow('read', auth() != null && (classroom.teacher_id == auth().id || auth().id == student_id || auth().bonds?[capacity == 'admin' && entity_type == 'PLATFORM'] || auth().bonds?[entity_id == this.classroom.school_id && (capacity == 'principal' || capacity == 'section_head')]))
  @@allow('all', auth() != null && (classroom.teacher_id == auth().id || auth().bonds?[capacity == 'admin' && entity_type == 'PLATFORM'] || auth().bonds?[entity_id == this.classroom.school_id && (capacity == 'principal' || capacity == 'section_head')]))

  @@id([classroom_id, student_id, date])
  @@index([classroom_id, date])
  @@index([student_id, date])
  @@map("attendance")
}

model School {
  id         String   @id @default(uuid())
  name       String
  handle     String?  @unique
  created_at DateTime @default(now())
  created_by String?
  tenant_kind String   @default("customer")
  type       String?
  is_sample  Boolean? @default(false)
  census_id  String?
  custom_branding Json?
  last_census_sync DateTime?
  sync_status String? @default("synced")
  avatar_url String?
  deleted_at DateTime?
  deleted_by String?
  deletion_reason String?
  // IANA zone for plans, quiet hours and notice release (plan-and-bridge).
  timezone   String   @default("Asia/Colombo")
  // Opt-in, aggregate-only usage counts (school_mode_usage_daily).
  usage_signal_opt_in Boolean @default(false)
  // Guardian verification policy: open (default) allows parents immediate visibility; strict requires leader verification.
  guardian_verification_required Boolean @default(false)
  guardian_verification_policy   String  @default("open")

  classrooms Classroom[]
  announcements Announcement[]
  mode_policies SchoolModePolicy[]
  groups     Group[]
  manifestos SanctuaryManifesto[]
  sections   Section[]
  invite_codes InviteCode[]
  school_join_requests SchoolJoinRequest[]
  school_memberships SchoolMembership[]
  inventory_items InventoryItem[]
  edu_school      EduSchool? @relation("SchoolCanonicalRegistry", fields: [census_id], references: [id])
  registry_claims SchoolRegistryClaim[]
  academic_cycles AcademicCycle[]
  academic_cycle_leadership_assignments AcademicCycleLeadershipAssignment[] @relation("SchoolCycleLeadership")
  grade_levels GradeLevel[]
  grade_classes GradeClass[]
  subjects Subject[]
  student_grade_class_enrollments StudentGradeClassEnrollment[] @relation("SchoolGradeClassEnrollments")
  daily_attendance DailyAttendance[] @relation("SchoolDailyAttendance")
  attendance_sessions AttendanceSession[]
  teacher_daily_attendance TeacherDailyAttendance[] @relation("SchoolTeacherDailyAttendance")
  teacher_attendance_sessions TeacherAttendanceSession[]
  grade_marks GradeMark[]
  principal_notes PrincipalNote[] @relation("SchoolPrincipalNotes")

  // HR & Staff
  staff_leaves StaffLeave[]
  calendar_events CalendarEvent[]
  school_invite_codes SchoolInviteCode[] @relation("SchoolInviteCodes")
  web_evidence_caches WebEvidenceCache[] @relation("WebEvidenceCaches")

  // Permissions: Everyone authenticated can read basic info; users can manage their own creations
  @@allow('read', auth() != null)
  @@allow('create', auth() != null)
  @@allow('update,delete', auth().id == created_by || auth().bonds?[entity_id == this.id && (capacity == 'principal' || capacity == 'section_head')] || auth().bonds?[capacity == 'admin' && entity_type == 'PLATFORM'])

  @@map("schools")
}

/**
 * School-scoped invitation token. The claim transaction is implemented by the
 * database RPC because it must atomically create a school bond and consume the
 * invitation. This model is therefore the typed read contract, not a license
 * for clients to mutate invite state directly.
 */
model InviteCode {
  id              String   @id @default(uuid())
  school_id       String
  code            String   @unique
  role            String
  max_uses        Int?
  uses_count      Int?     @default(0)
  invitation_text String?
  metadata        Json?
  idempotency_key String?
  created_by      String?
  created_at      DateTime @default(now())
  is_active       Boolean  @default(true)

  school          School   @relation(fields: [school_id], references: [id], onDelete: Cascade)
  creator         User?    @relation("InviteCodeCreator", fields: [created_by], references: [id])

  @@allow('read', is_active == true)
  @@allow('create', auth().bonds?[entity_id == this.school_id && (capacity == 'principal' || capacity == 'section_head')] || auth().bonds?[capacity == 'admin' && entity_type == 'PLATFORM'])
  @@allow('update,delete', auth().bonds?[entity_id == this.school_id && (capacity == 'principal' || capacity == 'section_head')] || auth().bonds?[capacity == 'admin' && entity_type == 'PLATFORM'])
  @@map("invite_codes")
}

// Institutional enrollment request. Approval may create a bond, but the
// request itself is not an authorization grant.
model SchoolJoinRequest {
  id         String   @id @default(uuid())
  user_id    String?
  school_id  String?
  role       String
  status     String   @default("pending")
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user   User?   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  school School? @relation(fields: [school_id], references: [id], onDelete: Cascade)

  @@index([user_id, status])
  @@index([school_id, status])
  @@allow('read', auth().id == user_id || auth().bonds?[entity_id == this.school_id && (capacity == 'principal' || capacity == 'section_head')] || auth().bonds?[capacity == 'admin' && entity_type == 'PLATFORM'])
  @@allow('create', auth().id == user_id)
  @@allow('update', auth().id == user_id || auth().bonds?[entity_id == this.school_id && (capacity == 'principal' || capacity == 'section_head')] || auth().bonds?[capacity == 'admin' && entity_type == 'PLATFORM'])
  @@map("school_join_requests")
}

// Provenance for linking an application tenant school to a canonical factual
// registry row. The final link is still materialized on School.census_id.
model SchoolRegistryClaim {
  id             String   @id @default(uuid())
  school_id      String
  edu_school_id  String
  requested_by   String
  status         String   @default("pending")
  evidence       Json?
  reviewed_by    String?
  reviewed_at    DateTime?
  claimed_at     DateTime?
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt
  idempotency_key String? @unique

  school       School   @relation(fields: [school_id], references: [id], onDelete: Cascade)
  edu_school   EduSchool @relation(fields: [edu_school_id], references: [id])
  requester    User     @relation("SchoolRegistryClaimRequester", fields: [requested_by], references: [id])
  reviewer     User?    @relation("SchoolRegistryClaimReviewer", fields: [reviewed_by], references: [id])

  @@unique([school_id, edu_school_id])
  @@index([edu_school_id, status])
  @@index([requested_by, status])

  @@allow('read', requested_by == auth().id || auth().bonds?[entity_id == this.school_id && (capacity == 'principal' || capacity == 'section_head')] || auth().bonds?[capacity == 'admin' && entity_type == 'PLATFORM'])
  @@allow('create', requested_by == auth().id)
  @@allow('update', requested_by == auth().id || auth().bonds?[entity_id == this.school_id && (capacity == 'principal' || capacity == 'section_head')] || auth().bonds?[capacity == 'admin' && entity_type == 'PLATFORM'])

  @@map("school_registry_claims")
}

// Institutional residence/role history. This complements bonds: bonds are
// authorization context, while memberships record school affiliation and
// tenure. Membership mutations remain server-controlled.
model SchoolMembership {
  id              String   @id @default(uuid())
  user_id         String
  school_id       String
  role            String
  status          String   @default("active")
  start_date      DateTime?
  end_date        DateTime?
  is_primary      Boolean?
  deleted_at      DateTime?
  created_at      DateTime
  updated_at      DateTime
  deleted_by      String?
  deletion_reason String?
  joined_at       DateTime?
  left_at         DateTime?

  user   User   @relation(fields: [user_id], references: [id])
  school School @relation(fields: [school_id], references: [id])

  @@index([user_id])
  @@index([school_id, status])
  @@unique([user_id, school_id, role, status])
  @@allow('read', auth().id == user_id)
  @@map("school_memberships")
}

model InventoryItem {
  id             String    @id @default(uuid())
  school_id      String
  classroom_id   String?
  name           String
  category       String
  quantity       Int       @default(0)
  unit           String?
  condition      String    @default("good")
  location       String?
  last_audit_at  DateTime?
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt
  local_sync_id  String?
  is_pending_sync Boolean?
  valid_from     DateTime?
  valid_to       DateTime?

  school         School    @relation(fields: [school_id], references: [id], onDelete: Cascade)
  classroom      Classroom? @relation(fields: [classroom_id], references: [id])

  // Inventory is visible to members of the school; changes are restricted to
  // school leadership, teachers, and platform administrators.
  @@allow('read', auth() != null && (auth().bonds?[entity_id == this.school_id] || auth().bonds?[capacity == 'admin' && entity_type == 'PLATFORM']))
  @@allow('all', auth() != null && (auth().bonds?[entity_id == this.school_id && (capacity == 'principal' || capacity == 'teacher')] || auth().bonds?[capacity == 'admin' && entity_type == 'PLATFORM']))

  @@map("inventory_items")
}

model InventoryRequest {
  id          String   @id @default(uuid())
  school_id   String?
  classroom_id String?
  teacher_id   String?
  item_name   String
  quantity    String
  reason      String?
  status      String?  @default("pending")
  priority    String?  @default("normal")
  created_at  DateTime @default(now())

  @@allow('read', auth() != null && (auth().id == teacher_id || auth().bonds?[entity_id == this.school_id] || auth().bonds?[capacity == 'admin' && entity_type == 'PLATFORM']))
  @@allow('create', auth() != null && (auth().id == teacher_id || auth().bonds?[entity_id == this.school_id && (capacity == 'principal' || capacity == 'teacher')] || auth().bonds?[capacity == 'admin' && entity_type == 'PLATFORM']))
  @@allow('update,delete', auth() != null && (auth().bonds?[entity_id == this.school_id && (capacity == 'principal' || capacity == 'section_head')] || auth().bonds?[capacity == 'admin' && entity_type == 'PLATFORM']))

  @@map("inventory_requests")
}

// ============================================================================
// SELF DOMAIN
// ============================================================================

model MoodLog {
  id         String   @id @default(uuid())
  user_id    String
  mood_score Int
  mood       String?
  note       String?
  idempotency_key String? @default(uuid()) @unique
  created_at DateTime @default(now())
  user       User     @relation(fields: [user_id], references: [id])
  @@index([user_id, created_at])

  @@allow('all', auth() != null && (auth().id == user_id || auth().bonds?[capacity == 'admin' && entity_type == 'PLATFORM']))
  @@map("mood_logs")
}

model FireJournalEntry {
  id              String   @id @default(uuid())
  user_id         String
  content_preview String?
  is_burned       Boolean?
  burned_at       DateTime?
  created_at      DateTime @default(now())
  user            User     @relation(fields: [user_id], references: [id])
  @@index([user_id, created_at])

  @@allow('all', auth() != null && (auth().id == user_id || auth().bonds?[capacity == 'admin' && entity_type == 'PLATFORM']))
  @@map("fire_journal")
}

model ThoughtRecord {
  id               String    @id @default(uuid())
  user_id          String
  thought          String
  situation        String?
  emotion          Json?
  trap_ids         Json?
  evidence_for     String?
  evidence_against String?
  reframe          String?
  mood_before      Int?
  mood_after       Int?
  post_outcome     String?
  follow_up        Json?
  idempotency_key  String?   @unique
  created_at       DateTime  @default(now())
  user             User      @relation(fields: [user_id], references: [id])
  @@index([user_id, created_at])

  @@allow('all', auth() != null && (auth().id == user_id || auth().bonds?[capacity == 'admin' && entity_type == 'PLATFORM']))
  @@map("thought_records")
}

model LearningReflection {
  id               String    @id @default(uuid())
  user_id          String
  classroom_id     String?
  assignment_id    String?
  thought          String
  situation        String?
  emotion          Json?
  trap_ids         Json?
  evidence_for     String?
  evidence_against String?
  reframe          String?
  mood_before      Int?
  mood_after       Int?
  post_outcome     String?
  follow_up        Json?
  idempotency_key  String?   @unique
  created_at       DateTime  @default(now())
  user             User      @relation(fields: [user_id], references: [id])

  @@index([user_id, created_at])
  @@index([classroom_id, created_at])

  @@allow('all', auth() != null && (auth().id == user_id || auth().bonds?[capacity == 'admin' && entity_type == 'PLATFORM']))
  @@map("learning_reflections")
}

model DecisionJournal {
  id              String   @id @default(uuid())
  user_id         String
  decision_text   String
  context         String?
  is_reviewed     Boolean  @default(false)
  idempotency_key String?
  created_at      DateTime @default(now())
  @@unique([idempotency_key])
  @@index([user_id, created_at])

  @@allow('all', auth() != null && auth().id == user_id)
  @@map("decision_journals")
}

model UserPreferences {
  id                        String   @id @default(uuid())
  user_id                   String   @unique
  active_bond_id            String?  @unique
  favorite_features         String[]
  hidden_features           String[]
  morning_check_time        String?
  afternoon_check_time      String?
  evening_wind_down_time    String?
  enable_contextual_prompts Boolean  @default(true)
  enable_usage_tracking     Boolean  @default(true)
  notification_settings     Json?
  updated_at                DateTime @updatedAt
  created_at                DateTime @default(now())
  user                      User     @relation(fields: [user_id], references: [id])
  active_bond               Bond?    @relation("SelectedBond", fields: [active_bond_id], references: [id], onDelete: SetNull)

  @@allow('all', auth() != null && (auth().id == user_id || auth().bonds?[capacity == 'admin' && entity_type == 'PLATFORM']))
  @@map("user_preferences")
}

//  ============================================================================
// LIBRARY DOMAIN
// ============================================================================

/**
 * Persisted visualization topology. The legacy client used this table
 * directly; the Sanctuary API is now the authority for reads and writes.
 */
model MappingTopology {
  id                       String   @id @default(uuid())
  owner_id                 String?
  name                     String
  description              String?
  nodes                    Json
  links                    Json
  supported_perspectives   String[]
  context                  Json?
  is_public                Boolean  @default(false)
  share_token              String?  @unique
  share_token_expires_at   DateTime?
  created_at               DateTime @default(now())
  updated_at               DateTime @default(now())

  @@allow('read', auth() != null && (is_public == true || owner_id == auth().id || auth().bonds?[capacity == 'admin' && entity_type == 'PLATFORM']))
  @@allow('all', auth() != null && (owner_id == auth().id || auth().bonds?[capacity == 'admin' && entity_type == 'PLATFORM']))

  @@map("mapping_topologies")
}

model LibraryResource {
  id               String   @id @default(uuid())
  title            String
  description      String?
  type             String
  format           String
  url              String?
  file_path        String?
  subjects         String[]
  topics           String[]
  grades           Int[]
  difficulty       String?
  language         String[]
  visibility       String   @default("public")
  creator_id       String?
  creator_role     String
  school_id        String?
  thumbnail_url    String?
  creator_name     String?
  verified         Boolean  @default(false)
  verified_by      String?
  curriculum_aligned Boolean?
  copyright_notice String?
  is_community     Boolean  @default(false)
  tags             String[]
  embedding        Unsupported("vector")?
  search_vector    Unsupported("tsvector")?
  views            Int      @default(0)
  uses_count       Int      @default(0)
  endorsements     Int      @default(0)
  bookmarks        Int      @default(0)
  is_geographic    Boolean?
  latitude         Float?
  longitude        Float?
  map_x            Float?
  map_y            Float?
  parent_node_id   String?
  island_id        String?
  link_status      String?
  last_checked_at  DateTime?
  fail_count       Int?
  title_si         String?
  title_ta         String?
  title_en         String?
  description_si   String?
  description_ta   String?
  description_en   String?
  license          String?
  is_ministry_official Boolean?
  media            Json?
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt
  
  engagements      ResourceEngagement[]
  collection_nodes CollectionNode[]
  collection_node_events CollectionNodeEvent[]

  @@allow('read', visibility == 'public' || auth().id == creator_id || auth().bonds?[capacity == 'admin' && entity_type == 'PLATFORM'])
  @@allow('all', auth().id == creator_id || auth().bonds?[capacity == 'admin' && entity_type == 'PLATFORM'])
  @@map("nodes")
}

model LibraryCollection {
  id             String   @id @default(uuid())
  name           String
  description    String?
  thumbnail_url  String?
  creator_id     String?
  visibility     String   @default("public")
  subjects       String[]
  topics         String[]
  grades         Int[]
  is_public      Boolean?
  icon_emoji      String?
  metadata       Json?
  verified       Boolean?
  type           String?
  subject        String?
  resource_ids   String[]
  sequence_order Int[]
  is_official    Boolean
  forks          Int
  used_by_count  Int
  endorsements   Int
  estimated_duration String?
  school_id      String?
  original_collection_id String?
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt
  
  collection_nodes CollectionNode[]
  collection_node_events CollectionNodeEvent[]

  @@allow('read', visibility == 'public' || auth().id == creator_id || auth().bonds?[capacity == 'admin' && entity_type == 'PLATFORM'])
  @@allow('all', auth().id == creator_id || auth().bonds?[capacity == 'admin' && entity_type == 'PLATFORM'])
  @@map("collections")
}

// Ordered collection membership is the active source of truth. The array
// projections on LibraryCollection remain active client/cache projections and
// are maintained by database triggers.
model CollectionNode {
  id            String   @id @default(uuid())
  collection_id String?
  node_id       String?
  position      Int      @default(0)
  added_at      DateTime?
  added_by      String?

  collection    LibraryCollection? @relation(fields: [collection_id], references: [id], onDelete: Cascade)
  node          LibraryResource?   @relation(fields: [node_id], references: [id], onDelete: Cascade)

  @@unique([collection_id, node_id])
  @@index([collection_id, position, added_at])
  @@index([node_id])
  @@allow('read', collection.visibility == 'public' || collection.creator_id == auth().id || auth().bonds?[capacity == 'admin' && entity_type == 'PLATFORM'])
  @@allow('all', collection.creator_id == auth().id || auth().bonds?[capacity == 'admin' && entity_type == 'PLATFORM'])
  @@map("collection_nodes")
}

// Append-only temporal audit records emitted by collection_nodes triggers.
model CollectionNodeEvent {
  id            String   @id @default(uuid())
  collection_id String
  node_id       String
  event_type    String
  position      Int?
  occurred_at   DateTime @default(now())
  actor_id      String?

  collection    LibraryCollection @relation(fields: [collection_id], references: [id], onDelete: Cascade)
  node          LibraryResource   @relation(fields: [node_id], references: [id], onDelete: Cascade)

  @@index([collection_id, node_id, occurred_at])
  @@allow('read', collection.visibility == 'public' || collection.creator_id == auth().id || auth().bonds?[capacity == 'admin' && entity_type == 'PLATFORM'])
  @@map("collection_node_events")
}

model ResourceEngagement {
  id              String   @id @default(uuid())
  resource_id     String
  user_id         String
  engagement_type String   // view, use, endorse, bookmark
  classroom_id    String?
  created_at      DateTime @default(now())
  
  resource        LibraryResource @relation(fields: [resource_id], references: [id])

  @@allow('read', auth().id == user_id || auth().bonds?[capacity == 'admin' && entity_type == 'PLATFORM'])
  @@allow('all', auth() != null && (auth().id == user_id || auth().bonds?[capacity == 'admin' && entity_type == 'PLATFORM']))
  @@map("resource_engagements")
}

// ============================================================================
// GROWTH & WELLBEING (BHUMI STACK)
// ============================================================================

model ThuthimalGift {
  id               String   @id @default(uuid())
  gift_token       String   @unique @default(uuid())
  gifter_id        String
  recipient_id     String?
  gifter_name      String
  recipient_role   String
  deleted_at       DateTime?
  gift_message     String?
  claimed          Boolean  @default(false)
  claimed_at       DateTime?
  expires_at       DateTime?
  created_at       DateTime @default(now())

  gifter           User     @relation("GiftsGiven", fields: [gifter_id], references: [id])
  recipient        User?    @relation("GiftsReceived", fields: [recipient_id], references: [id])

  @@allow('all', auth().id == gifter_id || auth().id == recipient_id || auth().bonds?[capacity == 'admin' && entity_type == 'PLATFORM'])
  @@map("thuthimal_gifts")
}

model ImpactRipple {
  id               String   @id @default(uuid())
  recipient_user_id String
  actor_user_id     String?
  entity_id        String?
  ripple_type      String
  warm_message_en  String
  warm_message_si  String?
  delivered        Boolean?
  delivered_at     DateTime?
  created_at       DateTime?

  recipient        User     @relation("RecipientRipples", fields: [recipient_user_id], references: [id])
  actor            User?    @relation("ActorRipples", fields: [actor_user_id], references: [id])

  @@allow('read', auth() != null)
  @@allow('all', auth().id == actor_user_id || auth().id == recipient_user_id || auth().bonds?[capacity == 'admin' && entity_type == 'PLATFORM'])
  @@map("impact_ripples")
}

model WhisperedMoment {
  id            String   @id @default(uuid())
  user_id       String
  moment_key    String
  moment_name_en String
  moment_name_si String?
  awarded_at    DateTime?

  user          User     @relation(fields: [user_id], references: [id])

  @@allow('read', auth().id == user_id || auth().bonds?[capacity == 'admin' && entity_type == 'PLATFORM'])
  @@allow('all', auth().bonds?[capacity == 'admin' && entity_type == 'PLATFORM'])
  @@map("whispered_moments")
}

model GrowthEvent {
  id             String   @id @default(uuid())
  user_id        String
  dimension      String   // presence, flowering, etc.
  event_type     String
  event_metadata Json?
  created_at     DateTime @default(now())

  user           User     @relation(fields: [user_id], references: [id])

  @@allow('read', auth().id == user_id || auth().bonds?[capacity == 'admin' && entity_type == 'PLATFORM'])
  @@allow('create', auth().id == user_id || auth().bonds?[capacity == 'admin' && entity_type == 'PLATFORM'])
  @@map("growth_events")
  @@index([user_id, created_at])
  @@index([user_id, dimension, created_at])
}

model UserGrowthState {
  id                          String   @id @default(uuid())
  user_id                     String   @unique
  bhumi_stage                 String   @default("bijam")
  banyan_stage                String?
  river_stage                 String?
  crystal_tier                String?
  presence_signals             Int      @default(0)
  nourishing_signals           Int      @default(0)
  witnessing_signals           Int      @default(0)
  weaving_signals              Int      @default(0)
  blooming_signals             Int      @default(0)
  peer_mentored_count          Int      @default(0)
  circles_facilitated_count    Int      @default(0)
  lessons_completed_count      Int      @default(0)
  reflections_submitted_count Int      @default(0)
  crystals_found_count         Int      @default(0)
  fractal_moments_count        Int      @default(0)
  last_seen_at                DateTime @default(now())
  onboarding_completed Boolean? @default(false)
  onboarding_completed_at DateTime?
  profile_completed Boolean? @default(false)
  deleted_at DateTime?
  created_at                  DateTime @default(now())
  updated_at                  DateTime @updatedAt

  user                        User     @relation(fields: [user_id], references: [id])

  @@allow('read', auth().id == user_id || auth().bonds?[capacity == 'admin' && entity_type == 'PLATFORM'])
  @@allow('all', auth() != null && (auth().id == user_id || auth().bonds?[capacity == 'admin' && entity_type == 'PLATFORM']))
  @@map("user_growth_state")
}

model SanctuaryManifesto {
  id          String   @id @default(uuid())
  school_id   String
  creator_id  String
  title       String
  content     String
  vibe        String?
  status      String?   // active, proposed
  target_date DateTime?
  metadata    Json?
  created_at  DateTime?
  updated_at  DateTime?
  endorsement_count Int @default(0)

  school      School   @relation(fields: [school_id], references: [id])
  endorsements ManifestoEndorsement[]

  @@allow('read', auth().bonds?[entity_id == this.school_id] || auth().bonds?[capacity == 'admin' && entity_type == 'PLATFORM'])
  @@allow('create,update,delete', auth().bonds?[entity_id == this.school_id && (capacity == 'principal' || capacity == 'section_head')] || auth().bonds?[capacity == 'admin' && entity_type == 'PLATFORM'])
  @@map("sanctuary_manifestos")
}

model ManifestoEndorsement {
  id             String   @id @default(uuid())
  manifesto_id   String
  user_id        String
  commitment_text String?
  created_at     DateTime?

  manifesto      SanctuaryManifesto @relation(fields: [manifesto_id], references: [id])
  user           User               @relation(fields: [user_id], references: [id])

  @@unique([manifesto_id, user_id])
  @@allow('read', auth() != null)
  @@allow('create', auth() != null)
  @@map("manifesto_endorsements")
}

model Section {
  id              String   @id @default(uuid())
  school_id       String
  name            String
  name_si         String?
  name_ta         String?
  grade_range     String?
  section_head_id String?
  deleted_at      DateTime?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt
  
  school     School   @relation(fields: [school_id], references: [id])
  grades     SchoolGrade[]
  grade_levels GradeLevel[]
  cycle_leadership_assignments AcademicCycleLeadershipAssignment[] @relation("SectionLeadership")

  @@allow('read', auth().bonds?[entity_id == this.school_id] || auth().bonds?[capacity == 'admin' && entity_type == 'PLATFORM'])
  @@allow('create,update,delete', auth().bonds?[entity_id == this.school_id && (capacity == 'principal' || capacity == 'section_head' || capacity == 'grade_head')] || auth().bonds?[capacity == 'admin' && entity_type == 'PLATFORM'])

  @@map("sections")
}

model GratitudeGift {
  id                String   @id @default(uuid())
  sender_user_id    String
  recipient_user_id String
  school_id         String?
  message           String?
  gift_type         String
  warm_message_en   String
  warm_message_si   String?
  warm_message_ta   String?
  delivered         Boolean  @default(false)
  delivered_at      DateTime?
  created_at        DateTime @default(now())

  sender    User @relation("GratitudeGiftsSent", fields: [sender_user_id], references: [id])
  recipient User @relation("GratitudeGiftsReceived", fields: [recipient_user_id], references: [id])

  @@index([recipient_user_id, delivered, created_at])
  @@allow('read', auth().id == recipient_user_id || auth().id == sender_user_id || auth().bonds?[capacity == 'admin' && entity_type == 'PLATFORM'])
  @@allow('create', auth().id == sender_user_id && auth().bonds?[capacity in ['admin', 'principal', 'assistant_principal']])
  @@allow('update', auth().id == recipient_user_id || auth().bonds?[capacity == 'admin' && entity_type == 'PLATFORM'])
  @@map("gratitude_gifts")
}

// ============================================================================
// ACADEMIC LIFECYCLE FOUNDATION
// These models are intentionally additive and do not reuse legacy classrooms,
// SchoolGrade/grade_levels, student_grades, or attendance tables.
// ============================================================================

model AcademicCycle {
  id          String   @id @default(uuid())
  school_id   String
  name        String
  starts_at   DateTime
  ends_at     DateTime
  status      String   @default("planned") // planned, active, completed, archived
  created_by  String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  school          School   @relation(fields: [school_id], references: [id])
  terms           Term[]
  leadership      AcademicCycleLeadershipAssignment[]
  grade_classes   GradeClass[]
  teacher_assignments GradeClassTeacherAssignment[]
  enrollments     StudentGradeClassEnrollment[]
  daily_attendance DailyAttendance[]
  attendance_sessions AttendanceSession[]
  teacher_daily_attendance TeacherDailyAttendance[]
  teacher_attendance_sessions TeacherAttendanceSession[]
  grade_marks     GradeMark[]

  @@unique([school_id, name])
  @@index([school_id, status])
  @@map("academic_cycles")
}

model Term {
  id                String   @id @default(uuid())
  academic_cycle_id String
  name              String
  term_kind         String   @default("term") // term, semester
  sequence          Int
  starts_at         DateTime
  ends_at           DateTime
  created_by        String?
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  academic_cycle AcademicCycle @relation(fields: [academic_cycle_id], references: [id])
  grade_class_subjects GradeClassSubject[]
  attendance_sessions AttendanceSession[]
  teacher_attendance_sessions TeacherAttendanceSession[]
  grade_marks GradeMark[]

  @@unique([academic_cycle_id, sequence])
  @@unique([academic_cycle_id, name])
  @@index([academic_cycle_id, starts_at])
  @@map("academic_terms")
}

model AcademicCycleLeadershipAssignment {
  id                String   @id @default(uuid())
  school_id         String
  academic_cycle_id String
  assignee_id       String
  role              String // principal, section_head, grade_head
  section_id        String?
  grade_level_id    String?
  effective_from    DateTime
  effective_to      DateTime?
  status            String   @default("active") // active, completed, ended
  created_by        String?
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  school       School       @relation("SchoolCycleLeadership", fields: [school_id], references: [id])
  academic_cycle AcademicCycle @relation(fields: [academic_cycle_id], references: [id])
  assignee     User         @relation("CycleLeadershipAssignee", fields: [assignee_id], references: [id])
  section      Section?     @relation("SectionLeadership", fields: [section_id], references: [id])
  grade_level  GradeLevel?  @relation(fields: [grade_level_id], references: [id])

  @@index([school_id, academic_cycle_id, role])
  @@index([assignee_id, effective_from])
  @@map("academic_cycle_leadership_assignments")
}

model Subject {
  id          String   @id @default(uuid())
  school_id   String
  code        String
  name        String
  name_si     String?
  name_ta     String?
  is_active   Boolean  @default(true)
  created_by  String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  school School @relation(fields: [school_id], references: [id])
  grade_class_subjects GradeClassSubject[]
  teacher_assignments GradeClassTeacherAssignment[]
  attendance_sessions AttendanceSession[]
  teacher_attendance_sessions TeacherAttendanceSession[]
  grade_marks GradeMark[]

  @@unique([school_id, code])
  @@index([school_id, is_active])
  @@map("academic_subjects")
}

model GradeLevel {
  id           String   @id @default(uuid())
  section_id   String
  school_id    String
  grade_number Int
  label        String?
  created_by   String?
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  section Section @relation(fields: [section_id], references: [id])
  school  School  @relation(fields: [school_id], references: [id])
  grade_classes GradeClass[]
  leadership_assignments AcademicCycleLeadershipAssignment[]

  @@unique([section_id, grade_number])
  @@index([school_id, grade_number])
  @@map("academic_grade_levels")
}

model GradeClass {
  id                String   @id @default(uuid())
  school_id         String
  grade_level_id    String
  academic_cycle_id String
  name              String
  status            String   @default("active") // active, archived
  created_by        String?
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  school School @relation(fields: [school_id], references: [id])
  grade_level GradeLevel @relation(fields: [grade_level_id], references: [id])
  academic_cycle AcademicCycle @relation(fields: [academic_cycle_id], references: [id])
  subjects GradeClassSubject[]
  teacher_assignments GradeClassTeacherAssignment[]
  enrollments StudentGradeClassEnrollment[]
  daily_attendance DailyAttendance[]
  attendance_sessions AttendanceSession[]
  teacher_attendance_sessions TeacherAttendanceSession[]
  grade_marks GradeMark[]

  @@unique([academic_cycle_id, grade_level_id, name])
  @@index([school_id, academic_cycle_id, status])
  @@allow('read', auth() != null && (auth().bonds?[entity_id == this.school_id] || auth().bonds?[capacity == 'admin' && entity_type == 'PLATFORM']))
  @@allow('all', auth() != null && (auth().bonds?[entity_id == this.school_id && (capacity == 'principal' || capacity == 'section_head' || capacity == 'grade_head')] || auth().bonds?[capacity == 'admin' && entity_type == 'PLATFORM']))
  @@map("grade_classes")
}

model GradeClassSubject {
  id              String   @id @default(uuid())
  grade_class_id  String
  term_id         String
  subject_id      String
  status          String   @default("active") // active, archived
  created_by      String?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  grade_class GradeClass @relation(fields: [grade_class_id], references: [id])
  term        Term      @relation(fields: [term_id], references: [id])
  subject     Subject   @relation(fields: [subject_id], references: [id])

  @@unique([grade_class_id, term_id, subject_id])
  @@index([term_id, subject_id])
  @@map("grade_class_subjects")
}

model GradeClassTeacherAssignment {
  id                String   @id @default(uuid())
  grade_class_id    String
  academic_cycle_id String
  teacher_id        String
  subject_id        String?
  role              String
  effective_from    DateTime
  effective_to      DateTime?
  status            String   @default("active") // active, completed, ended
  created_by        String?
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  grade_class GradeClass @relation(fields: [grade_class_id], references: [id])
  academic_cycle AcademicCycle @relation(fields: [academic_cycle_id], references: [id])
  teacher User @relation("GradeClassTeacher", fields: [teacher_id], references: [id])
  subject Subject? @relation(fields: [subject_id], references: [id])

  @@index([grade_class_id, role, effective_from])
  @@index([teacher_id, effective_from])
  // Had no rules (deny-all under the policy client). Teachers read their own
  // assignments; school leaders read and manage their school's.
  @@allow('read', auth() != null && auth().id == teacher_id)
  @@allow('all', auth() != null && (auth().bonds?[entity_id == this.grade_class.school_id && (capacity == 'principal' || capacity == 'section_head' || capacity == 'grade_head')] || auth().bonds?[capacity == 'admin' && entity_type == 'PLATFORM']))
  @@map("grade_class_teacher_assignments")
}

model StudentGradeClassEnrollment {
  id                String   @id @default(uuid())
  school_id         String
  academic_cycle_id String
  grade_class_id    String
  student_id        String
  effective_from    DateTime
  effective_to      DateTime?
  status            String   @default("active") // active, completed, withdrawn
  is_primary        Boolean  @default(true)
  created_by        String?
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  school School @relation("SchoolGradeClassEnrollments", fields: [school_id], references: [id])
  academic_cycle AcademicCycle @relation(fields: [academic_cycle_id], references: [id])
  grade_class GradeClass @relation(fields: [grade_class_id], references: [id])
  student User @relation("GradeClassStudent", fields: [student_id], references: [id])

  @@index([student_id, effective_from])
  @@index([grade_class_id, status])
  @@allow('read', auth() != null && (auth().bonds?[entity_id == this.school_id] || auth().id == student_id || auth().bonds?[capacity == 'admin' && entity_type == 'PLATFORM']))
  @@allow('all', auth() != null && (auth().bonds?[entity_id == this.school_id && (capacity == 'principal' || capacity == 'section_head' || capacity == 'grade_head' || capacity == 'teacher')] || auth().bonds?[capacity == 'admin' && entity_type == 'PLATFORM']))
  @@map("student_grade_class_enrollments")
}

model DailyAttendance {
  id                String   @id @default(uuid())
  school_id         String
  academic_cycle_id String
  grade_class_id    String
  student_id        String
  attendance_date   DateTime @db.Date
  status            String // present, absent, late, excused
  note              String?
  recorded_by       String
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  school School @relation("SchoolDailyAttendance", fields: [school_id], references: [id])
  academic_cycle AcademicCycle @relation(fields: [academic_cycle_id], references: [id])
  grade_class GradeClass @relation(fields: [grade_class_id], references: [id])
  student User @relation("DailyAttendanceStudent", fields: [student_id], references: [id])
  sessions AttendanceSession[]

  @@unique([student_id, grade_class_id, attendance_date])
  @@index([grade_class_id, attendance_date])
  @@allow('read', auth() != null && (auth().id == student_id || auth().bonds?[capacity == 'admin' && entity_type == 'PLATFORM'] || auth().bonds?[entity_id == this.school_id && (capacity == 'principal' || capacity == 'section_head' || capacity == 'grade_head' || capacity == 'teacher')]))
  @@allow('all', auth() != null && (auth().bonds?[capacity == 'admin' && entity_type == 'PLATFORM'] || auth().bonds?[entity_id == this.school_id && (capacity == 'principal' || capacity == 'section_head' || capacity == 'grade_head' || capacity == 'teacher')] || auth().bonds?[capacity == 'admin' && entity_type == 'PLATFORM']))
  @@map("daily_attendance")
}

model AttendanceSession {
  id                   String   @id @default(uuid())
  daily_attendance_id  String
  school_id            String
  academic_cycle_id    String
  grade_class_id       String
  term_id              String?
  student_id           String
  teacher_id           String?
  subject_id           String?
  session_kind         String // lesson, arrival, departure
  session_at           DateTime
  status               String // present, absent, late, excused
  recorded_by          String
  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt

  daily_attendance DailyAttendance @relation(fields: [daily_attendance_id], references: [id])
  school School @relation(fields: [school_id], references: [id])
  academic_cycle AcademicCycle @relation(fields: [academic_cycle_id], references: [id])
  grade_class GradeClass @relation(fields: [grade_class_id], references: [id])
  term Term? @relation(fields: [term_id], references: [id])
  student User @relation("AttendanceSessionStudent", fields: [student_id], references: [id])
  teacher User? @relation("AttendanceSessionTeacher", fields: [teacher_id], references: [id])
  subject Subject? @relation(fields: [subject_id], references: [id])

  @@index([daily_attendance_id, session_at])
  @@index([grade_class_id, session_at])
  @@allow('read', auth() != null && (auth().id == student_id || auth().bonds?[capacity == 'admin' && entity_type == 'PLATFORM'] || auth().bonds?[entity_id == this.school_id && (capacity == 'principal' || capacity == 'section_head' || capacity == 'grade_head' || capacity == 'teacher')]))
  @@allow('all', auth() != null && (auth().bonds?[capacity == 'admin' && entity_type == 'PLATFORM'] || auth().bonds?[entity_id == this.school_id && (capacity == 'principal' || capacity == 'section_head' || capacity == 'grade_head' || capacity == 'teacher')] || auth().bonds?[capacity == 'admin' && entity_type == 'PLATFORM']))
  @@map("attendance_sessions")
}

model TeacherDailyAttendance {
  id                String   @id @default(uuid())
  school_id         String
  academic_cycle_id String
  teacher_id        String
  attendance_date   DateTime @db.Date
  status            String // present, absent, late, excused, on_leave
  note              String?
  recorded_by       String
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  school School @relation("SchoolTeacherDailyAttendance", fields: [school_id], references: [id])
  academic_cycle AcademicCycle @relation(fields: [academic_cycle_id], references: [id])
  teacher User @relation("TeacherDailyAttendanceTeacher", fields: [teacher_id], references: [id])
  sessions TeacherAttendanceSession[]

  @@unique([teacher_id, attendance_date])
  @@index([school_id, attendance_date])
  @@allow('read', auth() != null && (auth().id == teacher_id || auth().bonds?[capacity == 'admin' && entity_type == 'PLATFORM'] || auth().bonds?[entity_id == this.school_id && (capacity == 'principal' || capacity == 'section_head' || capacity == 'admin')]))
  @@allow('all', auth() != null && (auth().bonds?[capacity == 'admin' && entity_type == 'PLATFORM'] || auth().bonds?[entity_id == this.school_id && (capacity == 'principal' || capacity == 'section_head' || capacity == 'admin')] || auth().bonds?[capacity == 'admin' && entity_type == 'PLATFORM']))
  @@map("teacher_daily_attendance")
}

model TeacherAttendanceSession {
  id                         String   @id @default(uuid())
  teacher_daily_attendance_id String
  school_id                  String
  academic_cycle_id          String
  grade_class_id             String?
  term_id                    String?
  teacher_id                 String
  subject_id                 String?
  session_kind               String // lesson, arrival, departure
  session_at                 DateTime
  status                     String // present, absent, late, excused
  recorded_by                String
  created_at                 DateTime @default(now())
  updated_at                 DateTime @updatedAt

  daily_attendance TeacherDailyAttendance @relation(fields: [teacher_daily_attendance_id], references: [id])
  school School @relation(fields: [school_id], references: [id])
  academic_cycle AcademicCycle @relation(fields: [academic_cycle_id], references: [id])
  grade_class GradeClass? @relation(fields: [grade_class_id], references: [id])
  term Term? @relation(fields: [term_id], references: [id])
  teacher User @relation("TeacherAttendanceSessionTeacher", fields: [teacher_id], references: [id])
  subject Subject? @relation(fields: [subject_id], references: [id])

  @@index([teacher_daily_attendance_id, session_at])
  @@index([grade_class_id, session_at])
  @@map("teacher_attendance_sessions")
}

model GradeMark {
  id                String   @id @default(uuid())
  school_id         String
  academic_cycle_id String
  grade_class_id    String
  term_id           String
  subject_id        String
  student_id        String
  assignment_id     String?
  submission_id     String?
  marks_earned      Float
  max_points        Float
  percentage        Float
  gpa               Float
  letter_grade      String
  publication_state String   @default("draft") // draft, published
  graded_by         String
  graded_at         DateTime @default(now())
  published_by      String?
  published_at      DateTime?
  feedback          String?
  idempotency_key   String?  @unique
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  school School @relation(fields: [school_id], references: [id])
  academic_cycle AcademicCycle @relation(fields: [academic_cycle_id], references: [id])
  grade_class GradeClass @relation(fields: [grade_class_id], references: [id])
  term Term @relation(fields: [term_id], references: [id])
  subject Subject @relation(fields: [subject_id], references: [id])
  student User @relation("StudentGradeMarks", fields: [student_id], references: [id])

  @@index([student_id, term_id])
  @@index([grade_class_id, subject_id, term_id])
  @@map("grade_marks")
}

model SchoolGrade {
  id            String   @id @default(uuid())
  section_id    String
  school_id     String
  grade_head_id String?
  number        Int      @map("grade_number")
  deleted_at    DateTime?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
  
  section    Section  @relation(fields: [section_id], references: [id])

  @@allow('read', auth() != null)
  @@allow('all', auth().bonds?[capacity == 'admin' && entity_type == 'PLATFORM'])

  @@map("grade_levels")
}

// ============================================================================
// HR & STAFF DOMAIN
// ============================================================================

model StaffLeave {
  id           String   @id @default(uuid())
  school_id    String
  user_id      String
  leave_type   String
  start_date   DateTime
  end_date     DateTime
  reason       String?
  status       String   @default("pending") // pending, approved, rejected
  reviewed_by  String?
  reviewed_at  DateTime?
  created_at   DateTime @default(now())

  school       School   @relation(fields: [school_id], references: [id])
  user         User     @relation(fields: [user_id], references: [id])

  @@allow('all', auth() != null && (auth().id == user_id || auth().bonds?[capacity == 'admin' && entity_type == 'PLATFORM'] || auth().bonds?[entity_id == this.school_id && capacity == 'principal']))
  @@allow('read', auth() != null && (school_id == auth().school_id || auth().bonds?[entity_id == this.school_id]))
  @@map("staff_leaves")
}

// plan-and-bridge PB0: live table (master_baseline) + notice columns
// (20261017210000). Reads go through sanctuary-api; RLS shows school-wide
// rows only once sent, grade-class rows only to that class's audience.
model Announcement {
  id                     String    @id @default(uuid())
  school_id              String
  author_id              String?
  title                  String    @default("")
  content                String
  is_pinned              Boolean   @default(false)
  created_at             DateTime  @default(now())
  updated_at             DateTime  @default(now())
  audience_scope         String    @default("school")
  grade_class_id         String?
  status                 String    @default("sent")
  send_at                DateTime?
  sent_at                DateTime?
  calendar_event_id      String?
  held_by_mode           String?
  drafted_in_quiet_hours Boolean   @default(false)
  override_reason        String?
  overridden_by          String?
  overridden_at          DateTime?
  schedule_version       Int       @default(0)
  recipient_count        Int?
  failure_code           String?

  school                 School    @relation(fields: [school_id], references: [id], onDelete: Cascade)
  author                 User?     @relation("AnnouncementAuthor", fields: [author_id], references: [id], onDelete: SetNull)

  @@index([send_at])
  @@index([grade_class_id, created_at])
  @@allow('read', auth() != null && (
    author_id == auth().id ||
    auth().bonds?[entity_id == this.school_id && (capacity == 'principal' || capacity == 'admin')] ||
    (status == 'sent' && (
      (audience_scope == 'school' && auth().bonds?[entity_id == this.school_id]) ||
      (grade_class_id != null && auth().bonds?[entity_id == this.grade_class_id])
    ))
  ))
  @@allow('create,update,delete', auth() != null && (
    author_id == auth().id ||
    auth().bonds?[entity_id == this.school_id && (capacity == 'principal' || capacity == 'admin')] ||
    auth().bonds?[capacity == 'admin' && entity_type == 'PLATFORM']
  ))
  @@allow('all', auth() != null && auth().bonds?[capacity == 'admin' && entity_type == 'PLATFORM'])
  @@map("announcements")
}

// Modes engine v0 (school side). Configurable over closed decisions: a missing
// row = PROVISIONAL defaults (packages/core/src/logic/modes/provisionalDefaults.ts).
model SchoolModePolicy {
  id                     String   @id @default(uuid())
  school_id              String
  mode_key               String
  capacities             String[]
  // locked | suggested | off. No default: a row is an explicit school choice.
  lock                   String
  schedule               Json
  trigger                Json     @default("{\"source\":\"schedule\"}")
  effects                Json     @default("{}")
  override_roles         String[]
  override_rate_limit_per_day Int?
  version                Int      @default(1)
  created_by             String?
  updated_by             String?
  created_at             DateTime @default(now())
  updated_at             DateTime @default(now())

  school                 School   @relation(fields: [school_id], references: [id], onDelete: Cascade)

  @@unique([school_id, mode_key])
  @@allow('read', auth() != null && auth().bonds?[entity_id == this.school_id])
  @@allow('all', auth() != null && auth().bonds?[capacity == 'admin' && entity_type == 'PLATFORM'])
  @@map("school_mode_policies")
}

// Opt-in aggregate usage signal: counts only, no content or user ids. Read
// via read_school_mode_usage() (k >= 5 suppression). Server-only.
model SchoolModeUsageDaily {
  school_id String
  day       DateTime @db.Date
  mode_key  String
  event     String
  capacity  String
  count     Int      @default(0)

  @@id([school_id, day, mode_key, event, capacity])
  @@allow('all', auth() != null && auth().bonds?[capacity == 'admin' && entity_type == 'PLATFORM'])
  @@map("school_mode_usage_daily")
}

// Append-only notice log (created, scheduled, rescheduled, override,
// cancelled, released, failed). Server-only; no client policy.
model SchoolNoticeEvent {
  id         String   @id @default(uuid())
  notice_id  String
  school_id  String
  actor_id   String?
  event      String
  detail     Json     @default("{}")
  created_at DateTime @default(now())

  @@index([notice_id, created_at])
  @@allow('all', auth() != null && auth().bonds?[capacity == 'admin' && entity_type == 'PLATFORM'])
  @@map("school_notice_events")
}

model CalendarEvent {
  id           String   @id @default(uuid())
  school_id    String
  title        String
  type         String
  start_date   DateTime
  end_date     DateTime?
  is_public    Boolean  @default(true)
  created_by   String?
  created_at   DateTime @default(now())
  // plan-and-bridge: audience (model A grade class; null = whole school) and
  // how many days before the event its notice should go out.
  grade_class_id   String?
  notice_lead_days Int?
  description      String?

  school       School   @relation(fields: [school_id], references: [id])

  @@index([grade_class_id, start_date])
  // Postgres RLS (20261017210000) is the enforced rule; grade-class rows are
  // limited to class staff, enrolled students and verified guardians.
  @@allow('read', auth() != null && (auth().bonds?[entity_id == this.school_id] || auth().bonds?[capacity == 'admin' && entity_type == 'PLATFORM']))
  @@allow('all', auth().bonds?[capacity == 'admin' && entity_type == 'PLATFORM'])
  @@map("calendar_events")
}

// ============================================================================
// GUARDIAN DOMAIN
// ============================================================================

model StudentGuardianRelationship {
  id                String   @id @default(uuid())
  student_id        String
  guardian_id       String
  relationship_type String
  created_at        DateTime @default(now())
  // pending | verified | revoked. Only a school leader verifies (sanctuary-api).
  verification_status String   @default("pending")
  verified_by         String?
  verified_at         DateTime?

  student           User     @relation("StudentGuardians", fields: [student_id], references: [id])
  guardian          User     @relation("GuardianStudents", fields: [guardian_id], references: [id])

  @@unique([student_id, guardian_id])
  @@allow('read', auth().id == student_id || auth().id == guardian_id || auth().bonds?[capacity == 'admin' && entity_type == 'PLATFORM'])
  // A guardian may request a link, never self-verify it.
  @@allow('create', auth().id == guardian_id && verification_status == 'pending' && verified_by == null)
  @@allow('delete', auth().id == guardian_id)
  @@allow('all', auth().bonds?[capacity == 'admin' && entity_type == 'PLATFORM'])
  @@map("student_guardian_relationships")
}

model GuardianAssessmentPermission {
  id              String   @id @default(uuid())
  relationship_id String
  guardian_id     String
  student_id      String
  permission_key  String   @default("assessment_results")
  access_level    String   @default("read")
  granted_at      DateTime @default(now())
  revoked_at      DateTime?

  @@allow('read', auth().id == guardian_id && revoked_at == null && permission_key == 'assessment_results' && access_level == 'read')
  @@map("guardian_assessment_permissions")
}

model GuardianAssessmentReadAuditEvent {
  id           String   @id @default(uuid())
  guardian_id  String
  student_id   String
  outcome      String
  reason       String
  result_count Int      @default(0)
  occurred_at  DateTime @default(now())

  @@allow('all', auth().bonds?[capacity == 'admin' && entity_type == 'PLATFORM'])
  @@map("guardian_assessment_read_audit_events")
}

model GuardianIdentity {
  id                  String   @id @default(uuid())
  user_id             String
  relationship_type   String   @default("parent")
  contact_info        Json?
  verification_status String   @default("pending")
  custody_info        Json?
  emergency_contact   Json?
  school_id           String?
  tenant_id           String?
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  user                User     @relation("UserGuardianIdentities", fields: [user_id], references: [id], onDelete: Cascade)

  @@allow('read', auth() != null && (user_id == auth().id || auth().bonds?[capacity == 'admin' && entity_type == 'PLATFORM']))
  // Owners create pending identities and may delete them; they cannot edit
  // verification_status (was 'all' for the owner: self-verification).
  @@allow('create', auth() != null && user_id == auth().id && verification_status == 'pending')
  @@allow('delete', auth() != null && user_id == auth().id)
  @@allow('all', auth() != null && auth().bonds?[capacity == 'admin' && entity_type == 'PLATFORM'])
  @@map("guardian_identities")
}

model GuardianNotification {
  id          String   @id @default(uuid())
  guardian_id String
  student_id  String?
  type        String
  title       String
  message     String
  is_read     Boolean  @default(false)
  action_url  String?
  created_at  DateTime @default(now())

  // Was read for any signed-in user.
  @@allow('read', auth() != null && guardian_id == auth().id)
  @@allow('update', auth() != null && guardian_id == auth().id)
  @@allow('all', auth() != null && auth().bonds?[capacity == 'admin' && entity_type == 'PLATFORM'])
  @@map("guardian_notifications")
}

model GuardianNotificationSetting {
  id          String   @id @default(uuid())
  guardian_id String   @unique
  settings    Json
  updated_at  DateTime @updatedAt

  // Was read + write for any signed-in user.
  @@allow('all', auth() != null && guardian_id == auth().id)
  @@map("guardian_notification_settings")
}

model SchoolEvent {
  id            String   @id @default(uuid())
  school_id     String?
  title         String
  description   String?
  date          DateTime
  time          String?
  location      String?
  type          String   @default("general")
  requires_rsvp Boolean  @default(false)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  @@allow('read', auth() != null)
  @@allow('all', auth() != null && auth().bonds?[capacity == 'admin' && entity_type == 'PLATFORM'])
  @@map("school_events")
}

// ============================================================================
// COMMERCIAL TUITION & TRIPARTITE PERSPECTIVES DOMAIN
// ============================================================================

model TuitionInstitute {
  id             String         @id @default(uuid())
  name           String
  address        String?
  city           String?
  is_independent Boolean        @default(false)
  created_by     String?
  created_at     DateTime       @default(now())
  updated_at     DateTime       @updatedAt
  batches        TuitionBatch[]

  creator        User?          @relation("TuitionInstituteCreator", fields: [created_by], references: [id])

  @@allow('read', auth() != null)
  @@allow('all', auth() != null && (created_by == auth().id || auth().bonds?[capacity == 'admin' && entity_type == 'PLATFORM']))
  @@map("tuition_institutes")
}

model TuitionBatch {
  id            String            @id @default(uuid())
  institute_id  String?
  tutor_user_id String
  subject_name  String
  grade_level   String
  medium        String            // sinhala, english, tamil
  format        String            @default("physical") // physical, online, hybrid, paper_class
  schedule      String
  monthly_fee   Float?
  custom_alias  String?
  role          String            @default("lead_tutor") // founder, lead_tutor, assistant_tutor, paper_marker
  is_active     Boolean           @default(true)
  created_at    DateTime          @default(now())
  updated_at    DateTime          @updatedAt

  institute     TuitionInstitute? @relation(fields: [institute_id], references: [id], onDelete: Cascade)
  tutor         User              @relation("TutorBatches", fields: [tutor_user_id], references: [id], onDelete: Cascade)

  @@index([tutor_user_id])
  @@index([institute_id])
  @@index([tutor_user_id, is_active])
  @@allow('all', auth() != null && (tutor_user_id == auth().id || auth().bonds?[capacity == 'admin' && entity_type == 'PLATFORM']))
  @@allow('read', auth() != null)
  @@map("tuition_batches")
}

model GuardianBond {
  id               String   @id @default(uuid())
  guardian_user_id String
  ward_student_id  String
  relationship     String   @default("parent") // parent, mother, father, guardian, relative
  status           String   @default("pending") // pending, verified, revoked (DB default is pending since 20261017210000)
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  guardian         User     @relation("GuardianBondsAsGuardian", fields: [guardian_user_id], references: [id], onDelete: Cascade)
  ward             User     @relation("GuardianBondsAsWard", fields: [ward_student_id], references: [id], onDelete: Cascade)

  @@unique([guardian_user_id, ward_student_id])
  @@index([guardian_user_id])
  @@index([ward_student_id])
  // Was 'all' for the guardian: anyone could self-link to any student as verified.
  // Guardians may only request (pending) or withdraw; verification is server-side,
  // matching the guardian_bonds RLS in 20261017210000_plan_bridge_calm_notices.sql.
  @@allow('read', auth() != null && (guardian_user_id == auth().id || ward_student_id == auth().id))
  @@allow('create', auth() != null && guardian_user_id == auth().id && status == 'pending')
  @@allow('delete', auth() != null && guardian_user_id == auth().id)
  @@allow('all', auth() != null && auth().bonds?[capacity == 'admin' && entity_type == 'PLATFORM'])
  @@map("guardian_bonds")
}

model SchoolInviteCode {
  id         String    @id @default(uuid())
  school_id  String
  code       String    @unique
  capacity   String    // teacher, student, principal, admin
  roles      Json      @default("[]")
  max_uses   Int?      @default(100)
  used_count Int       @default(0)
  is_active  Boolean   @default(true)
  expires_at DateTime?
  created_at DateTime  @default(now())

  school     School    @relation("SchoolInviteCodes", fields: [school_id], references: [id], onDelete: Cascade)

  @@index([code])
  @@allow('read', is_active == true)
  @@allow('all', auth().bonds?[entity_id == this.school_id && (capacity == 'principal' || capacity == 'section_head')] || auth().bonds?[capacity == 'admin' && entity_type == 'PLATFORM'])
  @@map("school_invite_codes")
}

// ============================================================================
// SOVEREIGN AI & PROXY CACHING DOMAIN
// ============================================================================

model WebEvidenceCache {
  query_hash       String   @id
  query_norm       String
  freshness_window String   // day, week, any
  response         Json
  fetched_md       Json
  school_id        String
  privacy_mode     String   // saved, temporary, incognito
  created_at       DateTime @default(now())
  expires_at       DateTime
  last_accessed_at DateTime @default(now())
  access_count     Int      @default(1)

  school           School   @relation("WebEvidenceCaches", fields: [school_id], references: [id], onDelete: Cascade)

  @@index([expires_at])
  @@index([school_id])
  @@index([freshness_window])
  @@allow('all', auth().bonds?[capacity == 'admin' && entity_type == 'PLATFORM'])
  @@map("web_evidence_cache")
}

// ============================================================================
// ACCOUNTING & PAYMENTS DOMAIN
// ============================================================================

model Account {
  id         String   @id @default(uuid())
  name       String
  code       String   @unique
  type       String   // asset, liability, equity, income, expense
  parent_id  String?
  balance    Float    @default(0)
  metadata   Json?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  entries    LedgerEntry[]
  budgets    Budget[]
  parent     Account?  @relation("AccountHierarchy", fields: [parent_id], references: [id])
  children   Account[] @relation("AccountHierarchy")

  @@allow('all', auth().bonds?[capacity == 'admin' && entity_type == 'PLATFORM'])
  @@allow('read', auth() != null)
  @@map("accounts")
}

model LedgerEntry {
  id             String   @id @default(uuid())
  transaction_id String
  account_id     String
  amount         Float
  side           String   // debit, credit
  description    String?
  created_at     DateTime @default(now())

  account        Account              @relation(fields: [account_id], references: [id])
  transaction    FinancialTransaction @relation(fields: [transaction_id], references: [id])

  @@allow('all', auth().bonds?[capacity == 'admin' && entity_type == 'PLATFORM'])
  @@map("ledger_entries")
}

model FinancialTransaction {
  id           String   @id @default(uuid())
  date         DateTime @default(now())
  description  String
  reference_no String?
  metadata     Json?
  created_at   DateTime @default(now())

  entries      LedgerEntry[]

  @@allow('all', auth().bonds?[capacity == 'admin' && entity_type == 'PLATFORM'])
  @@map("financial_transactions")
}

model Budget {
  id           String   @id @default(uuid())
  account_id   String
  amount       Float
  period_start DateTime
  period_end   DateTime
  actual_spent Float    @default(0)
  created_at   DateTime @default(now())

  account      Account  @relation(fields: [account_id], references: [id])

  @@allow('all', auth().bonds?[capacity == 'admin' && entity_type == 'PLATFORM'])
  @@map("budgets")
}

// -----------------------------------------------------------------------------
// PREMIUM & ENTITLEMENTS (Pro)
// -----------------------------------------------------------------------------

model ProGift {
  id             String    @id @default(uuid())
  gifter_id      String
  recipient_id   String?
  gifter_name    String?
  recipient_role String?
  gift_message   String?
  gift_token     String?
  claimed        Boolean   @default(false)
  claimed_at     DateTime?
  expires_at     DateTime?
  created_at     DateTime  @default(now())

  @@allow('all', auth().bonds?[capacity == 'admin' && entity_type == 'PLATFORM'])
  @@map("pro_gifts")
}

model PaymentIntent {
  id            String   @id @default(uuid())
  amount        Float
  currency      String   @default("LKR")
  status        String   @default("pending")
  provider      String   @default("stripe")
  client_secret String?
  metadata      Json?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  @@allow('all', auth().bonds?[capacity == 'admin' && entity_type == 'PLATFORM'])
  @@map("payment_intents")
}

model Invoice {
  id          String   @id @default(uuid())
  customer_id String
  amount      Float
  currency    String   @default("LKR")
  status      String   @default("draft")
  due_date    DateTime
  items       Json     // Array of items
  metadata    Json?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  customer    User     @relation(fields: [customer_id], references: [id])

  @@allow('all', auth().id == customer_id || auth().bonds?[capacity == 'admin' && entity_type == 'PLATFORM'])
  @@map("invoices")
}

model Receipt {
  id             String   @id @default(uuid())
  invoice_id     String?
  amount         Float
  currency       String   @default("LKR")
  paid_at        DateTime @default(now())
  payment_method String
  receipt_url    String?
  created_at     DateTime @default(now())

  @@allow('all', auth().bonds?[capacity == 'admin' && entity_type == 'PLATFORM'])
  @@map("receipts")
}

model ClassroomNote {
  id           String   @id @default(uuid())
  classroom_id String
  author_id    String
  content      String
  note_type    String   @default("general") // general, observation, private
  visibility   String   @default("teacher") // teacher, public, internal
  is_pinned    Boolean  @default(false)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  classroom    Classroom @relation(fields: [classroom_id], references: [id])
  author       User      @relation(fields: [author_id], references: [id])

  @@allow('all', auth().id == author_id || auth().bonds?[capacity == 'admin' && entity_type == 'PLATFORM'])
  @@allow('read', auth().school_id == classroom.school_id && visibility != 'private')
  @@map("classroom_notes")
}

model StudentLongitudinalEvent {
  id             String    @id @default(uuid())
  student_id     String
  school_id      String?
  grade_id       String?
  classroom_id   String?
  entity_type    String    // enrollment, attendance, grade, etc.
  entity_id      String
  operation      String    // insert, update, delete
  snapshot       Json
  metadata       Json?
  source_table   String
  recorded_by    String?
  occurred_at    DateTime  @default(now())
  recorded_at    DateTime  @default(now())
  effective_from DateTime?
  effective_to   DateTime?
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  student     User     @relation("StudentEvents", fields: [student_id], references: [id])
  @@index([student_id, occurred_at])
  @@index([classroom_id, occurred_at])

  @@allow('all', auth().bonds?[capacity == 'admin' && entity_type == 'PLATFORM'])
  @@allow('read', auth().id == student_id || auth().bonds?[capacity == 'teacher'])
  @@map("student_longitudinal_events")
}

model SentinelAuditLog {
  id            String   @id @default(uuid())
  actor_id      String
  action        String
  resource_type String
  resource_id   String?
  details       Json?
  created_at    DateTime @default(now())

  actor         User     @relation("AuditLogs", fields: [actor_id], references: [id])

  @@allow('all', auth().bonds?[capacity == 'admin' && entity_type == 'PLATFORM'])
  @@map("sentinel_audit_logs")
}

model FeatureFlag {
  id          String   @id @default(uuid())
  key         String   @unique
  description String?
  
  // Rules for enabling the flag
  tenant_kinds String[] // e.g. ["SCHOOL", "PERSONAL"]
  citizenships String[] // e.g. ["WANDERER", "SECOND_CLASS", "FIRST_CLASS"]
  pricing_tiers String[] // e.g. ["FREE", "PRO", "INSTITUTIONAL"]
  capacities   String[] // e.g. ["teacher", "principal"]
  
  is_enabled   Boolean  @default(true)
  is_development Boolean @default(false)
  
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@allow('read', true) // Everyone can read flags to know what's available
  @@allow('all', auth().bonds?[capacity == 'admin' && entity_type == 'PLATFORM'] || auth().bonds?[capacity == 'founder'])
  
  @@map("feature_flags")
}

/**
 * Public pricing-tier to feature-module manifest.
 * Commercial grants decide scope and eligibility; this model only describes
 * the read-only module catalog used by entitlement resolution.
 */
model PricingManifest {
  id         String   @id @default(uuid())
  tier       String   @unique
  features   Json
  updated_at DateTime @default(now())

  @@allow('read', true)
  @@map("pricing_manifest")
}

model SchoolRegistry {
  id               String   @id @default(uuid())
  census_id        String   @unique
  name             String
  address          String?
  tel_no           String?
  email            String?
  province         String?
  district         String?
  zone             String?
  division         String?
  medium           String?
  gender           String?
  category         String?
  type             String?
  grade_span       String?
  total_students   Int?
  difficulty_level String?
  properties       Json?
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

    // `school_registry` is a compatibility view and must remain read-only.
    @@allow('read', true)
  
  @@map("school_registry")
  }

// Canonical national school facts registry. This is distinct from SchoolRegistry,
// which maps to the legacy compatibility view `school_registry`.
model EduSchool {
    id                  String   @id
    census_no           String   @unique
    name                String
    gender              String?
    category            String?
    type_code           String?
    province_id         String?
    district_id         String?
    gn_division_id      String?
    postal_unit_id      String?
    zone_id             String?
    division_id         String?
    location            Unsupported("geography")?
    created_at          DateTime?
    updated_at          DateTime?
    status              String?
    religion            String?
    website             String?
    socio_economic_tier String?
    tenant_schools      School[] @relation("SchoolCanonicalRegistry")
    registry_claims     SchoolRegistryClaim[]

    // Canonical registry data is publicly discoverable but not client-writable.
    @@allow('read', true)

    @@index([name])
    @@index([province_id, district_id])
    @@map("edu_schools")
}

/**
 * Negentropy & Rewarded Attention Economy
 * ---------------------------------------
 * Stores virtual energy tokens generated through voluntary ad sponsorship.
 */
model UserEnergyBalance {
    id             String   @id @default(uuid())
    user_id        String   @unique
    balance        Int      @default(0)
    total_earned   Int      @default(0)
    total_spent    Int      @default(0)
    daily_count    Int      @default(0)
    last_reset_at  DateTime @default(now())
    created_at     DateTime @default(now())
    updated_at     DateTime @updatedAt

    user           User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

    // Policies: User can read their balance; modifications must be performed by the system/admin or user themselves for authorized client interactions
    @@allow('read', auth() != null && user_id == auth().id)
    @@allow('all', auth() != null && auth().bonds?[capacity == 'admin' && entity_type == 'PLATFORM'])
    @@allow('update', auth() != null && user_id == auth().id)
    @@allow('create', auth() != null && user_id == auth().id)

    @@map("user_energy_balances")
}

model AdRewardTransaction {
    id              String   @id @default(uuid())
    user_id         String
    provider        String   @default("admob") // "admob", "test", etc.
    transaction_id  String   @unique
    ad_unit_id      String?
    reward_amount   Int      @default(10)
    verified        Boolean  @default(false)
    signature       String?
    metadata        Json?
    created_at      DateTime @default(now())

    user            User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

    @@allow('read', auth() != null && user_id == auth().id)
    @@allow('all', auth() != null && auth().bonds?[capacity == 'admin' && entity_type == 'PLATFORM'])
    @@allow('create', auth() != null && user_id == auth().id)

    @@index([user_id])
    @@map("ad_reward_transactions")
}

