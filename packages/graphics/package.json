{
  "name": "@repo/graphics",
  "version": "0.0.1",
  "description": "Topology & layout brain for Gurudevi visualization perspectives. No rendering - pure layout math.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "lint": "powershell -File ../../scripts/audit-wrapper.ps1 -Cmd \"pnpm exec eslint .\" -Log \"reports/lint.txt\"",
