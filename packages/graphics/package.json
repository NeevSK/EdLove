{
  "name": "@repo/graphics",
  "version": "0.0.2",
  "description": "Topology & layout brain for Gurudevi visualization perspectives. No rendering - pure layout math.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./algorithms": {
      "types": "./src/algorithms/index.ts",
      "import": "./src/algorithms/index.ts",
      "default": "./src/algorithms/index.ts"
    },
    "./layouts": {
      "types": "./src/layouts/index.ts",
      "import": "./src/layouts/index.ts",
      "default": "./src/layouts/index.ts"
    },
    "./charts": {
      "types": "./src/charts/index.ts",
      "import": "./src/charts/index.ts",
      "default": "./src/charts/index.ts"
    },
    "./types": {
      "types": "./src/types/index.ts",
      "import": "./src/types/index.ts",
      "default": "./src/types/index.ts"
    },
    "./*": {
      "types": "./src/*.ts",
      "import": "./src/*.js",
      "default": "./src/*.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "lint": "node ../../scripts/run-and-report.mjs --cmd \"pnpm run lint:biome && pnpm run lint:eslint\" --name \"packages_graphics-lint\"",
    "check-types": "node ../../scripts/run-and-report.mjs --cmd \"pnpm exec tsc --build --noEmit --checkers 4 --builders 4\" --name \"packages_graphics-check-types\"",
    "clean": "node ../../scripts/run-and-report.mjs --cmd \"rm -rf .turbo node_modules dist\" --name \"packages_graphics-clean\"",
    "lint:biome": "node ../../scripts/run-and-report.mjs --cmd \"node ../../scripts/scoped-biome.mjs\" --name \"packages_graphics-lint_biome\"",
    "lint:eslint": "node ../../scripts/run-and-report.mjs --cmd \"eslint .\" --name \"packages_graphics-lint_eslint\"",
    "format": "node ../../scripts/run-and-report.mjs --cmd \"node ../../scripts/scoped-biome.mjs --write\" --name \"packages_graphics-format\"",
    "check-cycles": "node ../../scripts/run-and-report.mjs --cmd \"node ../../scripts/refactor/sovereign-cycle-checker.mjs\" --name \"packages_graphics-check-cycles\"",
    "test": "node ../../scripts/run-and-report.mjs --cmd \"vitest run\" --name \"packages_graphics-test\"",
    "test:watch": "node ../../scripts/run-and-report.mjs --cmd \"vitest\" --name \"packages_graphics-test_watch\"",
    "test:ui": "node ../../scripts/run-and-report.mjs --cmd \"vitest --ui\" --name \"packages_graphics-test_ui\""
  },
  "dependencies": {
    "@intuitui-labs/lk-edu-geo": "workspace:*",
    "@maplibre/maplibre-react-native": "10.4.2",
    "@repo/core": "workspace:*",
    "@repo/ui": "workspace:*",
    "@supabase/supabase-js": "2.102.1",
    "@tanstack/react-query": "^5.101.0",
    "d3-force": "^3.0.0",
    "d3-hierarchy": "^3.1.2",
    "expo-haptics": "*",
    "expo-location": "~56.0.16",
    "react-native-gesture-handler": "3.0.2",
    "react-native-gifted-charts": "^1.4.77",
    "react-native-maps": "^1.27.2",
    "react-native-svg": "15.15.4"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:^",
    "@repo/typescript-config": "workspace:*",
    "@types/d3-force": "^3.0.10",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/react": "^19.2.17",
    "@types/react-native": "0.83.2",
    "eslint": "^10.4.1",
    "react-native-gesture-handler": "3.0.2",
    "typescript": "rc",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.8"
  },
  "peerDependencies": {
    "expo": "~57.0.4",
    "react": "19.2.3",
    "react-native": "~0.86.0",
    "react-native-gesture-handler": "^3.0.2",
    "@tanstack/react-query": "*",
    "@supabase/supabase-js": "*"
  },
  "_originalScripts": {
    "lint": "pnpm run lint:biome && pnpm run lint:eslint",
    "check-types": "pnpm exec tsc --build --noEmit --checkers 4 --builders 4",
    "clean": "rm -rf .turbo node_modules dist",
    "lint:biome": "node ../../scripts/scoped-biome.mjs",
    "lint:eslint": "eslint .",
    "format": "node ../../scripts/scoped-biome.mjs --write",
    "check-cycles": "node ../../scripts/refactor/sovereign-cycle-checker.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui"
  }
}
