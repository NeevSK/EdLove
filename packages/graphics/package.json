{
  "name": "@repo/graphics",
  "version": "0.0.2",
  "description": "Topology & layout brain for Gurudevi visualization perspectives. No rendering - pure layout math.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./algorithms": {
      "types": "./src/algorithms/index.ts",
      "import": "./src/algorithms/index.ts",
      "default": "./src/algorithms/index.ts"
    },
    "./layouts": {
      "types": "./src/layouts/index.ts",
      "import": "./src/layouts/index.ts",
      "default": "./src/layouts/index.ts"
    },
    "./charts": {
      "types": "./src/charts/index.ts",
      "import": "./src/charts/index.ts",
      "default": "./src/charts/index.ts"
    },
    "./types": {
      "types": "./src/types/index.ts",
      "import": "./src/types/index.ts",
      "default": "./src/types/index.ts"
    },
    "./*": {
      "types": "./src/*.ts",
      "import": "./src/*.js",
      "default": "./src/*.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "lint": "node ../../scripts/run-and-report.mjs --cmd \"pnpm run lint:biome && pnpm run lint:eslint\" --name \"packages_graphics-lint\"",
    "check-types": "node ../../scripts/run-and-report.mjs --cmd \"pnpm exec tsc --build --noEmit\" --name \"packages_graphics-check-types\"",
    "clean": "node ../../scripts/run-and-report.mjs --cmd \"rm -rf .turbo node_modules dist\" --name \"packages_graphics-clean\"",
    "lint:biome": "node ../../scripts/run-and-report.mjs --cmd \"node ../../scripts/scoped-biome.mjs\" --name \"packages_graphics-lint_biome\"",
    "lint:eslint": "node ../../scripts/run-and-report.mjs --cmd \"eslint .\" --name \"packages_graphics-lint_eslint\"",
    "format": "node ../../scripts/run-and-report.mjs --cmd \"node ../../scripts/scoped-biome.mjs --write\" --name \"packages_graphics-format\"",
    "check-cycles": "node ../../scripts/run-and-report.mjs --cmd \"node ../../scripts/refactor/sovereign-cycle-checker.mjs\" --name \"packages_graphics-check-cycles\"",
    "test": "node ../../scripts/run-and-report.mjs --cmd \"vitest run\" --name \"packages_graphics-test\" --evidence-level G1",
    "test:watch": "node ../../scripts/run-and-report.mjs --cmd \"vitest\" --name \"packages_graphics-test_watch\" --evidence-level G1",
    "test:ui": "node ../../scripts/run-and-report.mjs --cmd \"vitest --ui\" --name \"packages_graphics-test_ui\" --evidence-level G1"
  },
  "dependencies": {
    "@intuitui-labs/lk-edu-geo": "^1.0.1",
    "@maplibre/maplibre-react-native": "10.4.2",
    "@repo/core": "workspace:*",
    "@repo/ui": "workspace:*",
    "@supabase/supabase-js": "*",
    "@tanstack/react-query": "^5.104.5",
    "d3-force": "^3.0.0",
    "d3-hierarchy": "^3.1.2",
    "expo-haptics": "~58.0.7",
    "expo-location": "~58.0.18",
    "react-native-gifted-charts": "^1.4.81"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:^",
    "@repo/typescript-config": "workspace:*",
    "@types/d3-force": "^3.0.10",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/react": "^19.3.0",
    "eslint": "^10.13.0",
    "react-native-gesture-handler": "3.4.0",
    "typescript": "7.1.0-beta",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "5.0.5"
  },
  "peerDependencies": {
    "@supabase/supabase-js": "*",
    "@tanstack/react-query": "^5.104.5",
    "expo": "~58.0.17",
    "react": "19.3.1",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "3.4.0",
    "react-native-maps": "1.29.11",
    "react-native-svg": "15.16.0"
  },
  "_originalScripts": {
    "lint": "pnpm run lint:biome && pnpm run lint:eslint",
    "check-types": "pnpm exec tsc --build --noEmit",
    "clean": "rm -rf .turbo node_modules dist",
    "lint:biome": "node ../../scripts/scoped-biome.mjs",
    "lint:eslint": "eslint .",
    "format": "node ../../scripts/scoped-biome.mjs --write",
    "check-cycles": "node ../../scripts/refactor/sovereign-cycle-checker.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui"
  }
}
