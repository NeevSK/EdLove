{
  "extends": "../../packages/typescript-config/base.json",
  "compilerOptions": {
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@repo/graphics/*": [
        "./src/*"
      ],
      "@repo/core": [
        "../core/dist/index.d.ts"
      ],
      "@repo/core/*": [
        "../core/dist/*"
      ],
      "@repo/ui": [
        "../ui/dist/index.d.ts"
      ],
      "@repo/ui/*": [
        "../ui/dist/*"
      ],
      "@intuitui-labs/lk-edu-geo": [
        "../lk-edu-geo/dist/index.d.ts"
      ],
      "@intuitui-labs/lk-edu-geo/*": [
        "../lk-edu-geo/dist/*"
      ]
    },
    "outDir": "./dist",
    "jsx": "react-jsx",
    "rootDir": "./src",
    "composite": true,
    "emitDeclarationOnly": true
  },
  "include": [
    "src/**/*"
  ]
}
