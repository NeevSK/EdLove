{
  "$schema": "https://json.schemastore.org/package",
  "name": "@repo/ui",
  "version": "1.0.0",
  "main": "src/index.ts",
  "license": "MIT",
  "sideEffects": false,
  "engines": {
    "node": "24.x"
  },
  "exports": {
    ".": "./src/index.ts",
    "./components/SanctuaryButton": "./src/components/SanctuaryButton.tsx",
    "./components/SanctuaryInput": "./src/components/SanctuaryInput.tsx",
    "./components/QRCodeGenerator": "./src/components/QRCodeGenerator.tsx",
    "./primitives": "./src/primitives.ts",
    "./screens": "./src/screens/index.ts",
    "./screens/AppSettingsScreen": "./src/screens/AppSettingsScreen.tsx",
    "./screens/AppSettingsScreen.web": "./src/screens/AppSettingsScreen.web.tsx",
    "./screens/NotificationsScreen.web": "./src/screens/NotificationsScreen.web.tsx",
    "./native": "./src/components-native/index.ts",
    "./svelte/*": "./src/svelte/*.svelte",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "pnpm exec tsc",
    "typecheck": "powershell -File ../../scripts/audit-wrapper.ps1 -Cmd \"pnpm exec tsc --noEmit\" -Log \"reports/check-types.txt\"",
    "check-types": "pnpm run typecheck",
    "lint": "pnpm run lint:biome && pnpm run lint:eslint",
    "lint:biome": "biome check .",
    "lint:eslint": "eslint .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "@react-native-community/slider": "4.5.6",
    "@repo/core": "workspace:*",
    "apca-w3": "^0.1.9",
    "culori": "^4.0.2",
    "date-fns": "^4.1.0",
    "expo-auth-session": "~55.0.6",
    "expo-clipboard": "^55.0.8",
    "expo-device": "~55.0.9",
    "expo-router": "~55.0.3",
    "expo-sharing": "~55.0.11",
    "expo-web-browser": "~55.0.9",
    "gluestack-ui": "3.0.0",
    "lucide-react-native": "^0.563.0",
    "nativewind": "4.1.23",
    "qrcode": "^1.5.4",
    "react-native-reanimated": "3.16.7",
    "react-native-safe-area-context": "4.15.0",
    "react-native-svg": "15.15.3",
    "tailwindcss": "3.4.17"
  },
  "peerDependencies": {
    "@react-native-async-storage/async-storage": "2.1.2",
    "@react-native-community/netinfo": "*",
    "@react-navigation/native": "*",
    "@shopify/flash-list": "2.0.2",
    "@shopify/react-native-skia": "2.4.18",
    "expo-blur": "~55.0.10",
    "expo-haptics": "~55.0.9",
    "expo-linear-gradient": "~55.0.9",
    "expo-location": "~55.1.4",
    "i18next": "*",
    "react": "19.2.0",
    "react-i18next": "*",
    "react-native": "0.83.2",
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@types/apca-w3": "^0.1.3",
    "@types/culori": "^4.0.1",
    "@types/qrcode": "^1.x",
    "@types/react": "19.2.14",
    "@types/react-native": "0.83.2",
    "eslint": "^9.38.0",
    "i18next": "^25.8.0",
    "react-i18next": "^16.5.4",
    "tailwindcss": "~3.4.17",
    "typescript": "~5.9.2"
  }
}
