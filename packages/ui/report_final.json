 | 'numeric'\n    | 'email-address'\n    | 'phone-pad';\n  autoFocus?: boolean;\n  accessibilityLabel?: string;\n  accessibilityHint?: string;\n}\n\n/**\n * SanctuaryInput\n *\n * A hardened, phase-aware input component.\n * Uses NativeWind for styling and hardened gluestack primitives.\n */\nexport default function SanctuaryInput({\n  label,\n  placeholder,\n  value,\n  onChangeText,\n  error,\n  isInvalid = false,\n  type = 'text',\n  leftIcon,\n  rightIcon,\n  onRightIconPress,\n  helperText,\n  isDisabled = false,\n  multiline = false,\n  numberOfLines = 1,\n  autoFocus = false,\n  keyboardType = 'default',\n  accessibilityLabel,\n  accessibilityHint,\n}: SanctuaryInputProps) {\n  const { id } = useFormControlContext();\n  const hasError = isInvalid || !!error;\n\n  return (\n    <FormControl isInvalid={hasError} isDisabled={isDisabled} className=\"w-full\">\n      {label && (\n        <FormControlLabel className=\"mb-2\">\n          <HStack className=\"justify-between items-center w-full\">\n            <FormControlLabelText className=\"text-phase-text-primary font-medium tracking-wide\">\n              {label}\n            </FormControlLabelText>\n            {helperText && !hasError && (\n              <Text className=\"text-[10px] text-phase-text-secondary uppercase tracking-widest font-bold\">\n                {helperText}\n              </Text>\n            )}\n          </HStack>\n        </FormControlLabel>\n      )}\n\n      <Input\n        isDisabled={isDisabled}\n        isInvalid={hasError}\n        className=\"bg-phase-surface border-phase-surface focus:border-phase-accent h-12 rounded-xl\"\n      >\n        {leftIcon && (\n          <InputSlot className=\"pl-3\">\n            <InputIcon as={leftIcon} className=\"text-phase-text-secondary\" />\n          </InputSlot>\n        )}\n\n        <InputField\n          placeholder={placeholder}\n          placeholderTextColor={Theme.colors.shadowViolet}\n          value={value}\n          onChangeText={onChangeText}\n          autoFocus={autoFocus}\n          secureTextEntry={type === 'password'}\n          keyboardType={keyboardType as any}\n          className=\"text-phase-text-primary px-3 text-base\"\n          multiline={multiline}\n          numberOfLines={numberOfLines}\n          accessibilityLabel={accessibilityLabel || label}\n          accessibilityHint={accessibilityHint}\n          accessibilityLabelledBy={id ? `${id}-label` : undefined}\n          accessibilityDescribedBy={hasError && id ? `${id}-error` : undefined}\n        />\n\n        {rightIcon && (\n          <InputSlot onPress={onRightIconPress} className=\"pr-3\">\n            <InputIcon\n              as={rightIcon}\n              className=\"text-phase-text-secondary active:text-phase-accent\"\n            />\n          </InputSlot>\n        )}\n      </Input>\n\n      {hasError && (\n        <FormControlError className=\"mt-2\">\n          <FormControlErrorIcon as={AlertCircle} className=\"text-phase-danger\" />\n          <FormControlErrorText className=\"text-phase-danger text-sm\">\n            {error || 'Invalid input'}\n          </FormControlErrorText>\n        </FormControlError>\n      )}\n    </FormControl>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\Naween\\projects\\polymath-platform\\packages\\ui\\src\\components\\SanctuaryModal.tsx","messages":[{"ruleId":"@typescript-eslint/no-explicit-any","severity":1,"message":"Unexpected any. Specify a different type.","line":15,"column":43,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":15,"endColumn":46,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[281,284],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[281,284],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"reac