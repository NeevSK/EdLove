ntifier","messageId":"undef","endLine":93,"endColumn":17},{"ruleId":"no-undef","severity":1,"message":"'it' is not defined.","line":96,"column":9,"nodeType":"Identifier","messageId":"undef","endLine":96,"endColumn":11},{"ruleId":"no-undef","severity":1,"message":"'expect' is not defined.","line":103,"column":11,"nodeType":"Identifier","messageId":"undef","endLine":103,"endColumn":17},{"ruleId":"no-undef","severity":1,"message":"'it' is not defined.","line":106,"column":9,"nodeType":"Identifier","messageId":"undef","endLine":106,"endColumn":11},{"ruleId":"no-undef","severity":1,"message":"'expect' is not defined.","line":113,"column":11,"nodeType":"Identifier","messageId":"undef","endLine":113,"endColumn":17},{"ruleId":"no-undef","severity":1,"message":"'describe' is not defined.","line":119,"column":3,"nodeType":"Identifier","messageId":"undef","endLine":119,"endColumn":11},{"ruleId":"no-undef","severity":1,"message":"'it' is not defined.","line":120,"column":5,"nodeType":"Identifier","messageId":"undef","endLine":120,"endColumn":7},{"ruleId":"no-undef","severity":1,"message":"'expect' is not defined.","line":124,"column":7,"nodeType":"Identifier","messageId":"undef","endLine":124,"endColumn":13},{"ruleId":"no-undef","severity":1,"message":"'describe' is not defined.","line":128,"column":3,"nodeType":"Identifier","messageId":"undef","endLine":128,"endColumn":11},{"ruleId":"no-undef","severity":1,"message":"'it' is not defined.","line":129,"column":5,"nodeType":"Identifier","messageId":"undef","endLine":129,"endColumn":7},{"ruleId":"no-undef","severity":1,"message":"'expect' is not defined.","line":132,"column":7,"nodeType":"Identifier","messageId":"undef","endLine":132,"endColumn":13},{"ruleId":"no-undef","severity":1,"message":"'expect' is not defined.","line":133,"column":7,"nodeType":"Identifier","messageId":"undef","endLine":133,"endColumn":13},{"ruleId":"no-undef","severity":1,"message":"'it' is not defined.","line":136,"column":5,"nodeType":"Identifier","messageId":"undef","endLine":136,"endColumn":7},{"ruleId":"no-undef","severity":1,"message":"'expect' is not defined.","line":139,"column":7,"nodeType":"Identifier","messageId":"undef","endLine":139,"endColumn":13}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":34,"fixableErrorCount":0,"fixableWarningCount":0,"source":"const {\n  compositeColorOverBackground,\n  getContrastRatio,\n  getAccessibleTextColor,\n} = require('../colorUtils');\nconst { checkAccessibility } = require('../a11yUtils');\nconst { resolvePhaseTokens } = require('../../theme/Theme');\n\ndescribe('Accessibility Audit - scene and accent contrast', () => {\n  const phases = ['predawn', 'dawn', 'morning', 'afternoon', 'dusk', 'night'];\n  const modes = ['light', 'dark'];\n  const AA_THRESHOLD = 4.5;\n\n  const resolveSceneBackground = (tokens, layerName) => {\n    switch (layerName) {\n      case 'world':\n        return tokens.scene.world.bg;\n      case 'chrome':\n        return compositeColorOverBackground(tokens.scene.chrome.bg, tokens.scene.world.bg);\n      case 'canvas':\n        return tokens.scene.canvas.bg;\n      case 'surface':\n        return compositeColorOverBackground(tokens.scene.surface.bg, tokens.scene.canvas.bg);\n      case 'elevated':\n        return compositeColorOverBackground(tokens.scene.elevated.bg, tokens.scene.canvas.bg);\n      case 'interactive':\n        return compositeColorOverBackground(tokens.scene.interactive.bg, tokens.scene.surface.bg);\n      default:\n        throw new Error(`Unknown scene layer: ${layerName}`);\n    }\n  };\n\n  describe('Accent backgrounds', () => {\n    phases.forEach((phase) => {\n      modes.forEach((mode) => {\n        it(`[${phase}/${mode}] action accent meets AA`, () => {\n          const tokens = resolvePhaseTokens(phase, mode === 'dark');\n          const ratio = getContrastRatio(tokens.text.onAccent, tokens.accent.action);\n\n          expect(ratio).toBeGreaterThanOrEqual(AA_THRESHOLD);\n        });\n\n        it(`[${phase}/${mode}] danger accent meets AA`, () => {\n          const tokens = resolvePhaseTokens(phase, mode === 'dark');\n          const ratio = getContrastRatio(tokens.text.onDanger, tokens.accent.danger);\n\n          expect(ratio).toBeGreaterThanOrEqual(AA_THRESHOLD);\n        });\n      });\n    });\n  });\n\n  describe('Scene layer text pairings', () => {\n    phases.forEach((phase) => {\n      modes.forEach((mode) => {\n        it(`[${phase}/${mode}] text.onWorld meets AA`, () => {\n          const tokens = resolvePhaseTokens(phase, mode === 'dark');\n          const ratio = getContrastRatio(\n            tokens.text.onWorld,\n            resolveSceneBackground(tokens, 'world'),\n          );\n\n          expect(ratio).toBeGreaterThanOrEqual(AA_THRESHOLD);\n        });\n\n        it(`[${phase}/${mode}] text.onChrome meets AA`, () => {\n          const tokens = resolvePhaseTokens(phase, mode === 'dark');\n          const ratio = getContrastRatio(\n            tokens.text.onChrome,\n            resolveSceneBackground(tokens, 'chrome'),\n          );\n\n          expect(ratio).toBeGreaterThanOrEqual(AA_THRESHOLD);\n        });\n\n        it(`[${phase}/${mode}] text.onCanvas meets AA`, () => {\n          const tokens = resolvePhaseTokens(phase, mode === 'dark');\n          const ratio = getContrastRatio(\n            tokens.text.onCanvas,\n            resolveSceneBackground(tokens, 'canvas'),\n          );\n\n          expect(ratio).toBeGreaterThanOrEqual(AA_THRESHOLD);\n        });\n\n        it(`[${phase}/${mode}] text.onSurface meets AA`, () => {\n          const tokens = resolvePhaseTokens(phase, mode === 'dark');\n          const ratio = getContrastRatio(\n            tokens.text.onSurface,\n            resolveSceneBackground(tokens, 'surface'),\n          );\n\n          expect(ratio).toBeGreaterThanOrEqual(AA_THRESHOLD);\n        });\n\n        it(`[${phase}/${mode}] text.onElevated meets AA`, () => {\n          const tokens = resolvePhaseTokens(phase, mode === 'dark');\n          const ratio = getContrastRatio(\n            tokens.text.onElevated,\n            resolveSceneBackground(tokens, 'elevated'),\n          );\n\n          expect(ratio).toBeGreaterThanOrEqual(AA_THRESHOLD);\n        });\n\n        it(`[${phase}/${mode}] text.onInteractive meets AA`, () => {\n          const tokens = resolvePhaseTokens(phase, mode === 'dark');\n          const ratio = getContrastRatio(\n            tokens.text.onInteractive,\n            resolveSceneBackground(tokens, 'interactive'),\n          );\n\n          expect(ratio).toBeGreaterThanOrEqual(AA_THRESHOLD);\n        });\n      });\n    });\n  });\n\n  describe('APCA spot checks', () => {\n    it('scene canvas text meets APCA body recommendation', () => {\n      const tokens = resolvePhaseTokens('morning', false);\n      const { apca } = checkAccessibility(tokens.text.onCanvas, tokens.scene.canvas.bg);\n\n      expect(Math.abs(apca)).toBeGreaterThanOrEqual(60);\n    });\n  });\n\n  describe('Readable text helper', () => {\n    it('selects a dark text color for white-ish backgrounds', () => {\n      const result = getAccessibleTextColor('#FFFFFF');\n\n      expect(result.color).toBe('#2A2318');\n      expect(result.passesAA).toBe(true);\n    });\n\n    it('still returns a candidate for difficult mid-tone backgrounds', () => {\n      const result = getAccessibleTextColor('#888888');\n\n      expect(result.ratio).toBeGreaterThan(1);\n    });\n  });\n});\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\Naween\\projects\\polymath-platform\\packages\\ui\\src\\utils\\a11yUtils.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\Naween\\projects\\polymath-platform\\packages\\ui\\src\\utils\\colorUtils.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount"