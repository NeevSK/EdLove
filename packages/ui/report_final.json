Phase,\n  RealityState,\n  NetworkQuality,\n  DeviceTier,\n} from './types';\nimport {\n  getTemporalPhase,\n  shouldUseDarkTheme,\n  detectDeviceTier,\n  detectNetworkQuality,\n  shouldUseDataSaver,\n  computeEffectiveFidelity,\n} from './utils';\n\n// Storage keys\nconst STORAGE_KEYS = {\n  FIDELITY_LEVEL: '@gurudevi/fidelity_level',\n  LANGUAGE: '@gurudevi/language',\n  IS_VEIL_ACTIVE: '@gurudevi/is_veil_active',\n  ENABLE_LIVING_THEME: '@gurudevi/enable_living_theme',\n};\n\n// Dark mode is reintroduced behind a development guard until the remaining\n// screen-level hardcoded colors are migrated to scene tokens.\nconst ENABLE_EXPERIMENTAL_DARK_MODE = typeof __DEV__ !== 'undefined' ? __DEV__ : false;\n\n// Create the context\nconst EnvironmentContext = createContext<EnvironmentContextValue | undefined>(undefined);\n\n/**\n * Environment Provider Props\n */\ninterface EnvironmentProviderProps {\n  children: ReactNode;\n}\n\n/**\n * Environment Provider Component\n * Wraps the app and provides environment state to all components\n */\nexport function EnvironmentProvider({ children }: EnvironmentProviderProps) {\n  // Get authority and theme from global store\n  const user = useStore((state: any) => state.user);\n  const authority = (user as any)?.authority;\n  const themeMode = useStore((state: any) => state.themeMode);\n  const setStoredThemeMode = useStore((state: any) => state.setThemeMode);\n\n  // Local state for environment-specific settings\n  const [fidelityLevel, setFidelityLevelState] = useState<FidelityLevel>('auto');\n  const [language, setLanguageState] = useState<Language>('en');\n  const [isVeilActive, setIsVeilActive] = useState(false);\n  const [enableLivingTheme, setEnableLivingThemeState] = useState<boolean>(true);\n  const [temporalPhase, setTemporalPhase] = useState<TemporalPhase>(() => getTemporalPhase());\n  const systemColorScheme = useColorScheme();\n  const [reality, setReality] = useState<RealityState>({\n    deviceTier: 'medium',\n    totalMemoryGB: 4,\n    networkQuality: 'good',\n    isDataSaverMode: false,\n    isBatterySaverMode: false,\n  });\n\n  // Compute derived state\n  const isDark =\n    ENABLE_EXPERIMENTAL_DARK_MODE &&\n    (themeMode === 'dark' ||\n      (themeMode === 'system' && systemColorScheme === 'dark') ||\n      (themeMode === 'auto' && shouldUseDarkTheme(temporalPhase)));\n  const effectiveFidelity = computeEffectiveFidelity(fidelityLevel, reality.deviceTier);\n\n  /**\n   * Load persisted settings from AsyncStorage\n   */\n  useEffect(() => {\n    async function loadSettings() {\n      try {\n        const [fidelity, lang, veil, livingTheme] = await Promise.all([\n          AsyncStorage.getItem(STORAGE_KEYS.FIDELITY_LEVEL),\n          AsyncStorage.getItem(STORAGE_KEYS.LANGUAGE),\n          AsyncStorage.getItem(STORAGE_KEYS.IS_VEIL_ACTIVE),\n          AsyncStorage.getItem(STORAGE_KEYS.ENABLE_LIVING_THEME),\n        ]);\n\n        if (fidelity) setFidelityLevelState(fidelity as FidelityLevel);\n        if (lang) {\n          setLanguageState(lang as Language);\n          i18n.changeLanguage(lang);\n        }\n        if (veil) setIsVeilActive(veil === 'true');\n        if (livingTheme !== null) setEnableLivingThemeState(livingTheme === 'true');\n      } catch (error) {\n        console.warn('Failed to load environment settings:', error);\n      }\n    }\n\n    loadSettings();\n  }, []);\n\n  /**\n   * Detect device capabilities and network quality on mount\n   */\n  const refreshReality = useCallback(async () => {\n    try {\n      const [deviceInfo, networkQuality] = await Promise.all([\n        detectDeviceTier(),\n        detectNetworkQuality(),\n      ]);\n\n      setReality((prev) => ({\n        ...prev,\n        deviceTier: deviceInfo.tier,\n        totalMemoryGB: deviceInfo.memoryGB,\n        networkQuality,\n        isDataSaverMode: shouldUseDataSaver(networkQuality),\n      }));\n    } catch (error) {\n      console.warn('Failed to refresh reality:', error);\n    }\n  }, []);\n\n  /**\n   * Initialize reality detection\n   */\n  useEffect(() => {\n    refreshReality();\n  }, [refreshReality]);\n\n  /**\n   * Monitor network changes\n   */\n  useEffect(() => {\n    const unsubscribe = NetInfo.addEventListener((state: any) => {\n      let quality: NetworkQuality = 'offline';\n\n      if (state.isConnected) {\n        const type = state.type;\n        const details = state.details as any;\n\n        if (type === 'cellular') {\n          const gen = details?.cellularGeneration;\n          if (gen === '5g') quality = 'excellent';\n          else if (gen === '4g') quality = 'good';\n          else if (gen === '3g') quality = 'fair';\n          else quality = 'poor';\n        } else if (type === 'wifi') {\n          quality = 'good';\n        } else {\n          quality = 'fair';\n        }\n      }\n\n      setReality((prev) => ({\n        ...prev,\n        networkQuality: quality,\n        isDataSaverMode: shouldUseDataSaver(quality),\n      }));\n\n      // Update global store\n      useStore.getState().setIsOnline(state.isConnected ?? false);\n    });\n\n    return unsubscribe;\n  }, []);\n\n  /**\n   * Update temporal phase every minute when in auto theme mode\n   */\n  useEffect(() => {\n    const updatePhase = () => {\n      const newPhase = getTemporalPhase();\n      if (newPhase !== temporalPhase) {\n        setTemporalPhase(newPhase);\n      }\n    };\n\n    // Check immediately\n    updatePhase();\n\n    // Then check every minute\n    const interval = setInterval(updatePhase, 60000);\n\n    return () => clearInterval(interval);\n  }, [themeMode, temporalPhase]);\n\n  /**\n   * Monitor app state changes to refresh reality\n   */\n  useEffect(() => {\n    const subscription = AppState.addEventListener('change', (nextAppState: AppStateStatus) => {\n      if (nextAppState === 'active') {\n        refreshReality();\n      }\n    });\n\n    return () => subscription.remove();\n  }, [refreshReality]);\n\n  /**\n   * Actions\n   */\n  const setThemeMode = useCallback(\n    (mode: ThemeMode) => {\n      setStoredThemeMode(mode);\n      // Update temporal phase immediately if switching to auto\n      if (mode === 'auto') {\n        setTemporalPhase(getTemporalPhase());\n      }\n    },\n    [setStoredThemeMode],\n  );\n\n  const setFidelityLevel = useCallback(async (level: FidelityLevel) => {\n    setFidelityLevelState(level);\n    try {\n      await AsyncStorage.setItem(STORAGE_KEYS.FIDELITY_LEVEL, level);\n    } catch (error) {\n      console.warn('Failed to save fidelity level:', error);\n    }\n  }, []);\n\n  const setLanguage = useCallback(async (lang: Language) => {\n    setLanguageState(lang);\n    try {\n      await AsyncStorage.setItem(STORAGE_KEYS.LANGUAGE, lang);\n      await i18n.changeLanguage(lang);\n    } catch (error) {\n      console.warn('Failed to save language:', error);\n    }\n  }, []);\n\n  const toggleVeil = useCallback(async () => {\n    const newValue = !isVeilActive;\n    setIsVeilActive(newValue);\n    try {\n      await AsyncStorage.setItem(STORAGE_KEYS.IS_VEIL_ACTIVE, String(newValue));\n    } catch (error) {\n      console.warn('Failed to save veil state:', error);\n    }\n  }, [isVeilActive]);\n\n  const setEnableLivingTheme = useCallback(async (enabled: boolean) => {\n    setEnableLivingThemeState(enabled);\n    try {\n      await AsyncStorage.setItem(STORAGE_KEYS.ENABLE_LIVING_THEME, String(enabled));\n    } catch (error) {\n      console.warn('Failed to save living theme state:', error);\n    }\n  }, []);\n\n  // Construct the context value\n  const value: EnvironmentContextValue = {\n    // State\n    authority,\n    themeMode,\n    temporalPhase,\n    isDark,\n    fidelityLevel,\n    effectiveFidelity,\n\n    language,\n    reality,\n    isVeilActive,\n    enableLivingTheme,\n\n    // Actions\n    setThemeMode,\n    setFidelityLevel,\n    setLanguage,\n    toggleVeil,\n    refreshReality,\n    setEnableLivingTheme,\n  };\n\n  return <EnvironmentContext.Provider value={value}>{children}</EnvironmentContext.Provider>;\n}\n\n/**\n * Hook to access the Environment Context\n * Must be used within an EnvironmentProvider\n */\nexport function useEnvironment(): EnvironmentContextValue {\n  const context = useContext(EnvironmentContext);\n\n  if (context === undefined) {\n    throw new Error(\n      'useEnvironment must be used within an EnvironmentProvider (or SanctuaryProvider)',\n    );\n  }\n\n  return context;\n}\n\n// Export utility functions for convenience\nexport { getTemporalPhase, shouldUseDarkTheme };\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\Naween\\projects\\polymath-platform\\packages\\ui\\src\\context\\ExternalLinkContext.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'StyleSheet' is defined but never used.","line":2,"column":21,"nodeType":"Identifier","messageId":"unusedVar","endLine":2,"endColumn":31,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"StyleSheet"},"fix":{"range":[79,91],"text":""},"desc":"Remove unused variable \"StyleSheet\"."}]}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { useEffect, useMemo, useState } from 'react';\nimport { Pressable, StyleSheet, View } from 'react-native';\nimport { Box, HStack, Text, VStack } from '../gluestack';\nimport { useEnvironment } from './EnvironmentContext';\nimport { useSanctuaryToast } from '../providers/ToastProvider';\nimport SanctuaryButton from '../components/SanctuaryButton';\nimport SanctuaryModal from '../components/SanctuaryModal';\nimport {\n  clearStoredExternalOpenPreference,\n  ExternalLinkTrustLevel,\n  ExternalOpenMethod,\n  registerExternalLinkRuntime,\n} from '../utils/linking';\nimport {\n  ArrowLeftRight,\n  Check,\n  ExternalLink,\n  Globe,\n  ShieldAlert,\n  ShieldCheck,\n} from 'lucide-react-native';\n\ninterface PendingRequest {\n  url: string;\n  options: {\n    title?: string;\n    sourceLabel?: string;\n    sourceBadge?: string;\n    trustLevel?: ExternalLinkTrustLevel;\n  };\n  platform: 'web' | 'native';\n  defaultMethod: ExternalOpenMethod;\n  currentPreference?: ExternalOpenMethod;\n  domain: string;\n  overrideCount: number;\n  resolve: (result: { method: ExternalOpenMethod; persistPreference: boolean } | null) => void;\n}\n\ntype MethodDefinition = {\n  id: ExternalOpenMethod;\n  title: string;\n  description: string;\n};\n\nconst webMethods: MethodDefinition[] = [\n  {\n    id: 'new_tab',\n    title: 'Open in New Tab',\n    description: 'Keeps Gurudevi open and preserves your place in the sanctuary.',\n  },\n  {\n    id: 'same_tab',\n    title: 'Open Here',\n    description: 'Replaces the current tab and follows the link in this browser view.',\n  },\n];\n\nconst nativeMethods: MethodDefinition[] = [\n  {\n    id: 'in_app_browser',\n    title: 'Open in App Browser',\n    description: 'Stays close to Gurudevi and returns smoothly when you are done.',\n  },\n  {\n    id: 'external_browser',\n    title: 'Open in Browser App',\n    description: 'Hands off to your default browser for a fully external experience.',\n  },\n];\n\nfunction getTrustCopy(level: ExternalLinkTrustLevel | undefined) {\n  switch (level) {\n    case 'verified':\n      return {\n        label: 'Verified source',\n        note: 'This destination is known and trusted inside the sanctuary.',\n        icon: ShieldCheck,\n      };\n    case 'broken':\n      return {\n        label: 'Broken or unverified',\n        note: 'This link may fail. If it does, you can try another method or report it.',\n        icon: ShieldAlert,\n      };\n    default:\n      return {\n        label: 'External source',\n        note: 'You are moving beyond Gurudevi to a site we do not fully control.',\n        icon: Globe,\n      };\n  }\n}\n\nexport function ExternalLinkProvider({ children }: { children: React.ReactNode }) {\n  const { reality } = useEnvironment();\n  const { showToast } = useSanctuaryToast();\n  const [pendingRequest, setPendingRequest] = useState<PendingRequest | null>(null);\n  const [selectedMethod, setSelectedMethod] = useState<ExternalOpenMethod>('new_tab');\n  const [rememberChoice, setRememberChoice] = useState(true);\n\n  useEffect(() => {\n    registerExternalLinkRuntime({\n      promptForChoice: (request) => {\n        setSelectedMethod(request.currentPreference ?? request.defaultMethod);\n        setRememberChoice(!request.currentPreference);\n        return new Promise((resolve) => {\n          setPendingRequest({ ...request, resolve });\n        });\n      },\n      isOnline: () => reality.networkQuality !== 'offline',\n      notifyOffline: (message) => showToast({ message, type: 'error' }),\n    });\n\n    return () => registerExternalLinkRuntime(null);\n  }, [reality.networkQuality, showToast]);\n\n  const methods = pendingRequest\n    ? pendingRequest.platform === 'web'\n      ? webMethods\n      : nativeMethods\n    : [];\n  const trustCopy = getTrustCopy(pendingRequest?.options.trustLevel);\n  const TrustIcon = trustCopy.icon;\n\n  const modalSubtitle = useMemo(() => {\n    if (!pendingRequest) return '';\n\n    const source = pendingRequest.options.sourceLabel ?? 'Gurudevi';\n    if (pendingRequest.currentPreference) {\n      return `Your current default from ${source} can be changed here at any time.`;\n    }\n    return `Choose how links from ${source} should open on this ${pendingRequest.platform === 'web' ? 'browser' : 'device'}.`;\n  }, [pendingRequest]);\n\n  const closeRequest = (\n    result: { method: ExternalOpenMethod; persistPreference: boolean } | null,\n  ) => {\n    if (!pendingRequest) return;\n    pendingRequest.resolve(result);\n    setPendingRequest(null);\n  };\n\n  return (\n    <>\n      {children}\n      <SanctuaryModal\n        isOpen={!!pendingRequest}\n        onClose={() => closeRequest(null)}\n        title={pendingRequest?.options.title ?? 'Open external link'}\n        subtitle={modalSubtitle}\n        icon={<ExternalLink size={18} className=\"text-phase-accent\" />}\n        size=\"md\"\n        footer={\n          pendingRequest ? (\n            <VStack className=\"gap-2\">\n              <HStack className=\"gap-2 flex-wrap\">\n                <SanctuaryButton\n                  onPress={() =>\n                    closeRequest({\n                      method: selectedMethod,\n                      persistPreference: rememberChoice,\n                    })\n                  }\n                  fullWidth\n                >\n                  Open Now\n                </SanctuaryButton>\n              </HStack>\n              <HStack className=\"gap-2 flex-wrap\">\n                <SanctuaryButton\n                  variant=\"outline\"\n                  action=\"secondary\"\n                  onPress={() =>\n                    closeRequest({\n                      method: selectedMethod,\n                      persistPreference: true,\n                    })\n                  }\n                  fullWidth\n                >\n                  Set as Default\n                </SanctuaryButton>\n              </HStack>\n              {pendingRequest.currentPreference && (\n                <SanctuaryButton\n                  variant=\"ghost\"\n                  action=\"secondary\"\n                  onPress={() => {\n                    clearStoredExternalOpenPreference();\n                    showToast({\n                      message: 'Link opening preference reset for this platform.',\n                      type: 'info',\n                    });\n                  }}\n                  leftIcon={ArrowLeftRight}\n                >\n                  Reset Saved Preference\n                </SanctuaryButton>\n              )}\n            </VStack>\n          ) : null\n        }\n      >\n        {pendingRequest && (\n          <VStack className=\"gap-4\">\n            <Box className=\"bg-phase-surface border border-white/10 rounded-xl p-4\">\n              <HStack className=\"gap-2 items-center mb-1\">\n                <TrustIcon\n                  size={16}\n                  className={\n                    trustCopy.label === 'Broken or unverified'\n                      ? 'text-phase-danger'\n                      : 'text-phase-accent'\n                  }\n                />\n                <Text className=\"text-phase-text-primary font-bold\">{trustCopy.label}</Text>\n              </HStack>\n              <Text className=\"text-phase-text-secondary text-[13px] leading-5\">\n                {trustCopy.note}\n              </Text>\n              <Text className=\"text-phase-text-secondary text-[12px] opacity-60 mt-2\">\n                Destination: {pendingRequest.domain}\n              </Text>\n              {pendingRequest.options.sourceBadge ? (\n                <Text className=\"text-phase-accent text-[12px] mt-1 font-bold\">\n                  {pendingRequest.options.sourceBadge}\n                </Text>\n              ) : null}\n              {pendingRequest.overrideCount >= 2 && !pendingRequest.currentPreference ? (\n                <Text className=\"text-phase-text-secondary text-[12px] mt-2\">\n                  You often choose a different link method. Saving a default may reduce friction.\n                </Text>\n              ) : null}\n            </Box>\n            <VStack className=\"gap-2\">\n              {methods.map((method) => {\n                const isSelected = selectedMethod === method.id;\n                return (\n                  <Pressable\n                    key={method.id}\n                    accessibilityRole=\"button\"\n                    onPress={() => setSelectedMethod(method.id)}\n                    className={`p-4 border rounded-xl flex-row items-center gap-3 ${isSelected ? 'border-phase-accent bg-phase-accent/10' : 'border-white/10 bg-phase-surface'}`}\n                  >\n                    <View\n                      className={`w-5 h-5 rounded-full border-[1.5px] items-center justify-center ${isSelected ? 'border-phase-accent bg-phase-accent' : 'border-white/20'}`}\n                    >\n                      {isSelected ? <Check size={10} className=\"text-white\" /> : null}\n                    </View>\n                    <VStack className=\"flex-1\">\n                      <Text className=\"text-phase-text-primary font-bold\">{method.title}</Text>\n                      <Text className=\"text-phase-text-secondary text-[13px] leading-5\">\n                        {method.description}\n                      </Text>\n                    </VStack>\n                  </Pressable>\n                );\n              })}\n            </VStack>\n            <Pressable\n              accessibilityRole=\"button\"\n              onPress={() => setRememberChoice((current) => !current)}\n              className=\"flex-row items-center gap-3 border border-white/10 rounded-xl p-4\"\n            >\n              <View\n                className={`w-5 h-5 rounded-md border-[1.5px] items-center justify-center ${rememberChoice ? 'border-phase-accent bg-phase-accent' : 'border-white/20'}`}\n              >\n                {rememberChoice ? <Check size={12} className=\"text-white\" /> : null}\n              </View>\n              <VStack className=\"flex-1\">\n                <Text className=\"text-phase-text-primary font-bold\">\n                  Remember my choice on this{' '}\n                  {pendingRequest.platform === 'web' ? 'browser' : 'device'}\n                </Text>\n                <Text className=\"text-phase-text-secondary text-[12px]\">\n                  You can still choose another method whenever you need to.\n                </Text>\n              </VStack>\n            </Pressable>\n          </VStack>\n        )}\n      </SanctuaryModal>\n    </>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\Naween\\projects\\polymath-platform\\packages\\ui\\src\\context\\FABContext.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'unregisterFAB' is assigned a value but never used.","line":66,"column":24,"nodeType":"Identifier","messageId":"unusedVar","endLine":66,"endColumn":37},{"ruleId":"react-hooks/exhaustive-deps","severity":1,"message":"React Hook React.useEffect has a missing dependency: 'config'. Either include it or remove the dependency array.","line":71,"column":6,"nodeType":"ArrayExpression","endLine":80,"endColumn":4,"suggestions":[{"desc":"Update the dependencies array to be: [registerFAB, config.tabType, config.visible, config.onPress, config.onBreathingReset, config.hasActiveGaps, config]","fix":{"range":[1977,2242],"text":"[registerFAB, config.tabType, config.visible, config.onPress, config.onBreathingReset, config.hasActiveGaps, config]"}}]},{"ruleId":"react-hooks/exhaustive-deps","severity":1,"message":"React Hook React.useEffect has a complex expression in the dependency array. Extract it to a separate variable so it can be statically checked.","line":73,"column":5,"nodeType":"CallExpression","endLine":73,"endColumn":35}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":3,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { createContext, useContext, useState, useCallback, ReactNode } from 'react';\nimport { ActionItem, TabType } from '../types/fab';\nexport type { ActionItem, TabType };\n\ninterface FABState {\n  actions: ActionItem[];\n  tabType: TabType;\n  icon?: ReactNode;\n  visible: boolean;\n  onPress?: () => void;\n  onBreathingReset?: () => void;\n  hasActiveGaps?: boolean;\n  gapPriority?: 'low' | 'medium' | 'high';\n}\n\ninterface FABContextType {\n  state: FABState;\n  registerFAB: (config: Partial<FABState>) => void;\n  unregisterFAB: () => void;\n  setVisibility: (visible: boolean) => void;\n}\n\nconst defaultState: FABState = {\n  actions: [],\n  tabType: 'self',\n  visible: true,\n};\n\nconst FABContext = createContext<FABContextType | undefined>(undefined);\n\nexport const FABProvider: React.FC<{ children: ReactNode }> = ({ children }) => {\n  const [state, setState] = useState<FABState>(defaultState);\n\n  const registerFAB = useCallback((config: Partial<FABState>) => {\n    setState((prev) => ({ ...prev, ...config, visible: config.visible ?? true }));\n  }, []);\n\n  const unregisterFAB = useCallback(() => {\n    setState((prev) => ({ ...prev, actions: [], visible: true }));\n  }, []);\n\n  const setVisibility = useCallback((visible: boolean) => {\n    setState((prev) => ({ ...prev, visible }));\n  }, []);\n\n  return (\n    <FABContext.Provider value={{ state, registerFAB, unregisterFAB, setVisibility }}>\n      {children}\n    </FABContext.Provider>\n  );\n};\n\nexport const useFAB = () => {\n  const context = useContext(FABContext);\n  if (!context) {\n    throw new Error('useFAB must be used within a FABProvider (or SanctuaryProvider)');\n  }\n  return context;\n};\n\n/**\n * Hook to register FAB actions for a screen.\n * Automatically unregisters when the component unmounts.\n */\nexport const useRegisterFAB = (config: Partial<FABState>) => {\n  const { registerFAB, unregisterFAB } = useFAB();\n\n  React.useEffect(() => {\n    registerFAB(config);\n    // return () => unregisterFAB();\n  }, [\n    registerFAB,\n    JSON.stringify(config.actions),\n    config.tabType,\n    config.visible,\n    config.onPress,\n    // config.icon, // REMOVED: This causes infinite loops if the icon is a new JSX element\n    config.onBreathingReset,\n    config.hasActiveGaps,\n  ]);\n};\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\Naween\\projects\\polymath-platform\\packages\\ui\\src\\context\\index.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\Naween\\projects\\polymath-platform\\packages\\ui\\src\\context\\types.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\Naween\\projects\\polymath-platform\\packages\\ui\\src\\context\\utils.ts","messages":[{"ruleId":"@typescript-eslint/no-explicit-any","severity":1,"message":"Unexpected any. Specify a different type.","line":84,"column":40,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":84,"endColumn":43,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[2350,2353],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[2350,2353],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"/**\n * Environment Utilities\n * Helper functions for the Environment Engine\n */\n\nimport { TemporalPhase, DeviceTier, NetworkQuality } from './types';\nimport * as Device from 'expo-device';\nimport NetInfo from '@react-native-community/netinfo';\n\n/**\n * Determines the temporal phase based on current time\n * - Predawn:   4 AM - 6 AM  (dark)\n * - Dawn:      6 AM - 9 AM  (light)\n * - Morning:   9 AM - 12 PM (light)\n * - Afternoon: 12 PM - 5 PM (light)\n * - Dusk:      5 PM - 8 PM  (dark)\n * - Night:     8 PM - 4 AM  (dark, wraps midnight)\n */\nexport function getTemporalPhase(): TemporalPhase {\n  const hour = new Date().getHours();\n  if (hour >= 4 && hour < 6) return 'predawn';\n  if (hour >= 6 && hour < 9) return 'dawn';\n  if (hour >= 9 && hour < 12) return 'morning';\n  if (hour >= 12 && hour < 17) return 'afternoon';\n  if (hour >= 17 && hour < 20) return 'dusk';\n  return 'night';\n}\n\n/**\n * Determines if current temporal phase should use dark theme\n */\nexport function shouldUseDarkTheme(phase: TemporalPhase): boolean {\n  return phase === 'predawn' || phase === 'dusk' || phase === 'night';\n  // dawn, morning, afternoon \\u2192 light world\n}\n\n/**\n * Detects device performance tier based on available memory\n * - Low: < 3GB RAM\n * - Medium: 3-6GB RAM\n * - High: > 6GB RAM\n */\nexport async function detectDeviceTier(): Promise<{ tier: DeviceTier; memoryGB: number }> {\n  try {\n    // Get total memory if available\n    const totalMemory = Device.totalMemory;\n\n    if (!totalMemory) {\n      // If we can't detect, assume medium tier to be safe\n      return { tier: 'medium', memoryGB: 4 };\n    }\n\n    const memoryGB = totalMemory / (1024 * 1024 * 1024);\n\n    let tier: DeviceTier;\n    if (memoryGB < 3) {\n      tier = 'low';\n    } else if (memoryGB < 6) {\n      tier = 'medium';\n    } else {\n      tier = 'high';\n    }\n\n    return { tier, memoryGB };\n  } catch (error) {\n    console.warn('Failed to detect device tier:', error);\n    return { tier: 'medium', memoryGB: 4 };\n  }\n}\n\n/**\n * Detects network quality based on connection info\n */\nexport async function detectNetworkQuality(): Promise<NetworkQuality> {\n  try {\n    const netInfo = await NetInfo.fetch();\n\n    if (!netInfo.isConnected) {\n      return 'offline';\n    }\n\n    // Check connection type and effective type\n    const type = netInfo.type;\n    const details = netInfo.details as any;\n\n    // If we have cellular connection, check the type\n    if (type === 'cellular') {\n      const cellularGeneration = details?.cellularGeneration;\n\n      if (cellularGeneration === '5g') {\n        return 'excellent';\n      } else if (cellularGeneration === '4g') {\n        return 'good';\n      } else if (cellularGeneration === '3g') {\n        return 'fair';\n      } else {\n        return 'poor';\n      }\n    }\n\n    // For WiFi, assume good quality unless we have more info\n    if (type === 'wifi') {\n      return 'good';\n    }\n\n    // Default to fair for other connection types\n    return 'fair';\n  } catch (error) {\n    console.warn('Failed to detect network quality:', error);\n    return 'fair';\n  }\n}\n\n/**\n * Determines if data saver mode should be active based on network quality\n */\nexport function shouldUseDataSaver(quality: NetworkQuality): boolean {\n  return quality === 'poor' || quality === 'fair';\n}\n\n/**\n * Determines effective fidelity level based on settings and reality\n */\nexport function computeEffectiveFidelity(\n  fidelityLevel: 'auto' | 'low' | 'high',\n  deviceTier: DeviceTier,\n): 'low' | 'high' {\n  // If user explicitly chose, respect their choice\n  if (fidelityLevel === 'low') return 'low';\n  if (fidelityLevel === 'high') return 'high';\n\n  // Auto mode: base on device tier\n  return deviceTier === 'low' ? 'low' : 'high';\n}\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\Naween\\projects\\polymath-platform\\packages\\ui\\src\\declarations.d.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\Naween\\projects\\polymath-platform\\packages\\ui\\src\\gluestack-legacy\\index.ts","messages":[{"ruleId":"no-restricted-imports","severity":1,"message":"'../components-legacy/box' import is restricted from being used by a pattern. Usage of legacy components is restricted. Please migrate to the hardened UI foundation.","line":26,"column":1,"nodeType":"ImportDeclaration","messageId":"patternWithCustomMessage","endLine":26,"endColumn":48},{"ruleId":"no-restricted-imports","severity":1,"message":"'../components-legacy/center' import is restricted from being used by a pattern. Usage of legacy components is restricted. Please migrate to the hardened UI foundation.","line":27,"column":1,"nodeType":"ImportDeclaration","messageId":"patternWithCustomMessage","endLine":27,"endColumn":54},{"ruleId":"no-restricted-imports","severity":1,"message":"'../components-le