cale.value }] as any,\n    opacity: opacity.value,\n  }));\n\n  if (!visible) return null;\n\n  return (\n    <Animated.View\n      style={[\n        {\n          position: 'absolute',\n          top: 0,\n          left: 0,\n          right: 0,\n          alignItems: 'center',\n          zIndex: 1000,\n        },\n        animatedStyle,\n      ]}\n    >\n      <Box\n        className=\"bg-ink border-2 border-templeGold rounded-generous p-6 shadow-2xl items-center\"\n        style={{\n          width: width * 0.85,\n          shadowColor: '#FDD925',\n          shadowOffset: { width: 0, height: 0 },\n          shadowOpacity: 0.5,\n          shadowRadius: 15,\n          elevation: 20,\n        }}\n      >\n        <VStack className=\"items-center gap-2\">\n          <Center className=\"p-3 bg-templeGold/20 rounded-full mb-2\">\n            <Trophy color=\"#FDD925\" size={40} />\n          </Center>\n\n          <Text className=\"text-templeGold font-bold text-lg uppercase tracking-wider\">\n            Achievement Unlocked!\n          </Text>\n\n          <Text className=\"text-sacredWhite font-bold text-center text-xl\">{title}</Text>\n\n          <Text className=\"text-starlightGray text-sm text-center\">\n            Your discovery adds to the sanctuary.\n          </Text>\n        </VStack>\n      </Box>\n    </Animated.View>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\Naween\\projects\\polymath-platform\\packages\\ui\\src\\components\\AdaptiveLayout.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'Theme' is defined but never used.","line":3,"column":10,"nodeType":"Identifier","messageId":"unusedVar","endLine":3,"endColumn":15,"suggestions":[{"messageId":"removeUnusedImportDeclaration","data":{"varName":"Theme"},"fix":{"range":[109,149],"text":""},"desc":"Remove unused import declaration."}]}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React from 'react';\nimport { View, StyleSheet, useWindowDimensions, ScrollView } from 'react-native';\nimport { Theme } from '../theme/Theme';\nimport { useThemedColors } from '../hooks/useThemedColors';\n\ninterface AdaptiveLayoutProps {\n  /**\n   * Fallback content for mobile/single-column layouts.\n   */\n  children?: React.ReactNode;\n  /**\n   * Component/Function to render in the left column (sidebar) on tablets.\n   */\n  renderSidebar?: () => React.ReactNode;\n  /**\n   * Component/Function to render in the right column (content) on tablets.\n   */\n  renderContent?: () => React.ReactNode;\n  /**\n   * Fixed width for the sidebar on tablets. Defaults to 320.\n   */\n  sidebarWidth?: number;\n  /**\n   * Breakpoint for tablet layout. Defaults to 768.\n   */\n  breakpoint?: number;\n  /**\n   * Whether the columns should be separately scrollable. Defaults to true.\n   */\n  scrollable?: boolean;\n}\n\n/**\n * AdaptiveLayout Component\n *\n * Automatically switches between 1-column mobile and 2-column tablet layouts.\n */\nexport const AdaptiveLayout = ({\n  children,\n  renderSidebar,\n  renderContent,\n  sidebarWidth = 320,\n  breakpoint = 768,\n  scrollable = true,\n}: AdaptiveLayoutProps) => {\n  const { width } = useWindowDimensions();\n  const colors = useThemedColors();\n  const isTablet = width >= breakpoint;\n\n  if (isTablet && renderSidebar && renderContent) {\n    return (\n      <View style={styles.tabletContainer}>\n        <View\n          style={[styles.sidebarColumn, { width: sidebarWidth, borderRightColor: colors.border }]}\n        >\n          {scrollable ? (\n            <ScrollView showsVerticalScrollIndicator={false}>{renderSidebar()}</ScrollView>\n          ) : (\n            renderSidebar()\n          )}\n        </View>\n        <View style={styles.contentColumn}>\n          {scrollable ? (\n            <ScrollView showsVerticalScrollIndicator={false}>{renderContent()}</ScrollView>\n          ) : (\n            renderContent()\n          )}\n        </View>\n      </View>\n    );\n  }\n\n  return <>{children}</>;\n};\n\nconst styles = StyleSheet.create({\n  tabletContainer: {\n    flex: 1,\n    flexDirection: 'row',\n    backgroundColor: 'transparent',\n  },\n  sidebarColumn: {\n    height: '100%',\n    borderRightWidth: 1,\n  },\n  contentColumn: {\n    flex: 1,\n    height: '100%',\n  },\n});\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\Naween\\projects\\polymath-platform\\packages\\ui\\src\\components\\BreathAnimation.tsx","messages":[{"ruleId":"react-hooks/exhaustive-deps","severity":1,"message":"React Hook useEffect has missing dependencies: 'opacity' and 'translateY'. Either include them or remove the dependency array.","line":40,"column":6,"nodeType":"ArrayExpression","endLine":40,"endColumn":23,"suggestions":[{"desc":"Update the dependencies array to be: [delay, duration, opacity, translateY]","fix":{"range":[1184,1201],"text":"[delay, duration, opacity, translateY]"}}]}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { useEffect } from 'react';\nimport Animated, {\n  useSharedValue,\n  useAnimatedStyle,\n  withDelay,\n  withTiming,\n  Easing,\n} from 'react-native-reanimated';\nimport { View } from 'react-native';\nimport { Runtime } from '@repo/core/native';\n\ninterface BreathAnimationProps {\n  children: React.ReactNode;\n  delay?: number;\n  duration?: number;\n  direction?: 'up' | 'down' | 'none';\n}\n\ninterface AnimatedContentProps {\n  children: React.ReactNode;\n  delay: number;\n  duration: number;\n  direction: 'up' | 'down' | 'none';\n}\n\n/**\n * AnimatedContent - Internal component that owns the Reanimated shared values.\n * Only mounted when the JSI runtime is confirmed ready, preventing Bridgeless crashes.\n */\nconst AnimatedContent = ({ children, delay, duration, direction }: AnimatedContentProps) => {\n  const opacity = useSharedValue(0);\n  const translateY = useSharedValue(direction === 'up' ? 20 : direction === 'down' ? -20 : 0);\n\n  useEffect(() => {\n    opacity.value = withDelay(delay, withTiming(1, { duration, easing: Easing.out(Easing.quad) }));\n    translateY.value = withDelay(\n      delay,\n      withTiming(0, { duration, easing: Easing.out(Easing.quad) }),\n    );\n  }, [delay, duration]);\n\n  const animatedStyle = useAnimatedStyle(() => ({\n    opacity: opacity.value,\n    transform: [{ translateY: translateY.value }],\n  }));\n\n  return <Animated.View style={animatedStyle}>{children}</Animated.View>;\n};\n\n/**\n * BreathAnimation - Implements the \"Breath-like Motion\" from TAIL_FIN.md\n * Provides a staggered, smooth entry for UI elements.\n * Defers JSI-heavy Reanimated hooks into a child component that is only\n * rendered once the runtime is ready, preventing Bridgeless-mode crashes.\n */\nexport const BreathAnimation = ({\n  children,\n  delay = 0,\n  duration = 500,\n  direction = 'up',\n}: BreathAnimationProps) => {\n  const [isReady, setIsReady] = React.useState(Runtime.isReady());\n\n  useEffect(() => {\n    if (!isReady) {\n      return Runtime.onReady(() => setIsReady(true));\n    }\n  }, [isReady]);\n\n  if (!isReady) {\n    return <View>{children}</View>;\n  }\n\n  return (\n    <AnimatedContent delay={delay} duration={duration} direction={direction}>\n      {children}\n    </AnimatedContent>\n  );\n};\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\Naween\\projects\\polymath-platform\\packages\\ui\\src\\components\\BreathingLoader.tsx","messages":[{"ruleId":"react-native-a11y/has-accessibility-hint","severity":1,"message":"has accessibilityLabel prop but no accessibilityHint","line":66,"column":5,"nodeType":"JSXOpeningElement","endLine":71,"endColumn":6}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"/**\n * BREATHING LOADER - Pulsing Circle Animation\n *\n * A simple loader component with a breathing animation:\n * - Pulsing circle that scales from 0.8 to 1.0\n * - 1.5 second infinite loop cycle\n * - Centered in parent container\n * - Customizable size and color\n * - Respects reduced-motion accessibility preference\n *\n * Philosophy: Calm, meditative loading state that doesn't distract\n */\n\nimport React, { FC, useEffect } from 'react';\nimport { StyleSheet, View } from 'react-native';\nimport Animated, {\n  useSharedValue,\n  useAnimatedStyle,\n  withRepeat,\n  withTiming,\n  Easing,\n} from 'react-native-reanimated';\nimport { Theme } from '../theme/Theme';\nimport { useAccessibility } from '../hooks/useAccessibility';\nimport { useTranslation } from 'react-i18next';\n\ninterface BreathingLoaderProps {\n  size?: number;\n  color?: string;\n}\n\nconst DEFAULT_SIZE = 50;\nconst DEFAULT_COLOR = Theme.colors.sanctuarySaffron;\nconst SCALE_MIN = 0.8;\nconst SCALE_MAX = 1.0;\nconst ANIMATION_DURATION = 1500;\n\nconst BreathingLoader: FC<BreathingLoaderProps> = ({\n  size = DEFAULT_SIZE,\n  color = DEFAULT_COLOR,\n}) => {\n  const { isReduceMotionEnabled } = useAccessibility();\n  const { t } = useTranslation();\n  const scale = useSharedValue(SCALE_MIN);\n\n  useEffect(() => {\n    if (isReduceMotionEnabled) {\n      scale.value = SCALE_MAX;\n      return;\n    }\n    scale.value = withRepeat(\n      withTiming(SCALE_MAX, {\n        duration: ANIMATION_DURATION,\n        easing: Easing.inOut(Easing.ease),\n      }),\n      -1,\n      true,\n    );\n  }, [isReduceMotionEnabled, scale]);\n\n  const animatedStyle = useAnimatedStyle(() => ({\n    transform: [{ scale: scale.value }],\n  }));\n\n  return (\n    <View\n      style={styles.container}\n      accessible={true}\n      accessibilityRole=\"progressbar\"\n      accessibilityLabel={t('accessibility.loading')}\n    >\n      <Animated.View\n        style={[\n          styles.circle,\n          {\n            width: size,\n            height: size,\n            borderRadius: size / 2,\n            backgroundColor: color,\n          },\n          animatedStyle,\n        ]}\n      />\n    </View>\n  );\n};\n\nconst styles = StyleSheet.create({\n  container: {\n    justifyContent: 'center',\n    alignItems: 'center',\n  },\n  circle: {},\n});\n\nexport default BreathingLoader;\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\Naween\\projects\\polymath-platform\\packages\\ui\\src\\components\\CapabilityGuard.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\Naween\\projects\\polymath-platform\\packages\\ui\\src\\components\\CitizenGate.tsx","messages":[{"ruleId":"@typescript-eslint/no-explicit-any","severity":1,"message":"Unexpected any. Specify a different type.","line":25,"column":95,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":25,"endColumn":98,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[701,704],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[701,704],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React from 'react';\nimport { VStack } from '../gluestack';\nimport PositiveInvitation from './PositiveInvitation';\nimport SanctuaryButton from './SanctuaryButton';\n\nexport interface CitizenGateProps {\n  context?: 'self' | 'library' | 'classroom' | 'community' | 'profile' | 'general';\n  title?: string;\n  description?: string;\n  actionLabel?: string;\n  onAction: () => void;\n  secondaryLabel?: string;\n  onSecondary?: () => void;\n}\n\nexport default function CitizenGate({\n  context = 'general',\n  title,\n  description,\n  actionLabel,\n  onAction,\n  secondaryLabel,\n  onSecondary,\n}: CitizenGateProps) {\n  const mappedContext = context === 'profile' || context === 'general' ? 'self' : (context as any);\n\n  return (\n    <VStack className=\"gap-4 w-full items-center\">\n      <PositiveInvitation\n        title={title}\n        description={description}\n        type=\"guest\"\n        context={mappedContext}\n        actionLabel={actionLabel}\n        onAction={onAction}\n      />\n      {secondaryLabel && onSecondary && (\n        <SanctuaryButton\n          variant=\"outline\"\n          action=\"secondary\"\n          onPress={onSecondary}\n          className=\"px-8\"\n        >\n          {secondaryLabel}\n        </SanctuaryButton>\n      )}\n    </VStack>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\Naween\\projects\\polymath-platform\\packages\\ui\\src\\components\\CollectionCard.tsx","messages":[{"ruleId":"@typescript-eslint/no-explicit-any","severity":1,"message":"Unexpected any. Specify a different type.","line":31,"column":42,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":31,"endColumn":45,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[1154,1157],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[1154,1157],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":1,"message":"Unexpected any. Specify a different type.","line":48,"column":36,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":48,"endColumn":39,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[1625,1628],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[1625,1628],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"react-native-a11y/has-valid-accessibility-descriptors","severity":1,"message":"Missing a11y props. Expected one of: accessibilityRole OR role OR BOTH accessibilityLabel + accessibilityHint OR BOTH accessibilityActions + onAccessibilityAction","line":95,"column":7,"nodeType":"JSXOpeningElement","endLine":95,"endColumn":89,"fix":{"range":[3003,3003],"text":" accessibilityRole=\"button\""}},{"ruleId":"react-native-a11y/has-valid-accessibility-descriptors","severity":1,"message":"Missing a11y props. Expected one of: accessibilityRole OR role OR BOTH accessibilityLabel + accessibilityHint OR BOTH accessibilityActions + onAccessibilityAction","line":168,"column":15,"nodeType":"JSXOpeningElement","endLine":172,"endColumn":16,"fix":{"range":[5391,5391],"text":" accessibilityRole=\"button\""}}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":4,"fixableErrorCount":0,"fixableWarningCount":2,"source":"/**\n * COLLECTION CARD - Netflix-Style Cover Art Card\n *\n * Displays a ResourceCollection as a visually rich cover-art card with:\n * - Optional thumbnail image background\n * - Gradient overlay for text legibility\n * - Subject tag badge, item count badge, and creator name\n * - \"Verified\" badge when the collection is verified\n * - \"Pull to Desk\" bookmark action\n *\n * Philosophy: Engaging, visual, and curated ΓÇö inspired by streaming services.\n */\n\nimport React from 'react';\nimport { Pressable, ImageBackground } from 'react-native';\nimport { LinearGradient } from 'expo-linear-gradient';\nimport { BadgeCheck, BookOpen, Bookmark } from 'lucide-react-native';\nimport { Box, VStack, HStack, Text } from '../gluestack';\n\n// ============================================================================\n// CONSTANTS\n// ============================================================================\n\nconst CARD_WIDTH = 180;\nconst CARD_HEIGHT = 220;\n\n// ============================================================================\n// TYPES\n// ============================================================================\n\nexport interface CollectionCardProps<T = any> {\n  title: string;\n  creator: string;\n  resourceCount: number;\n  subjectTag: string;\n  thumbnailUrl?: string;\n  verified?: boolean;\n  contextData?: T;\n  onPress?: (contextData: T) => void;\n  onPullToDesk?: (contextData: T) => void;\n  className?: string;\n}\n\n// ============================================================================\n// COMPONENT\n// ============================================================================\n\nexport function CollectionCard<T = any>({\n  title,\n  creator,\n  resourceCount,\n  subjectTag,\n  thumbnailUrl,\n  verified = false,\n  contextData,\n  onPress,\n  onPullToDesk,\n  className,\n}: CollectionCardProps<T>) {\n  const cardContent = (\n    <Box\n      style={{ width: CARD_WIDTH, height: CARD_HEIGHT }}\n      className={`rounded-3xl overflow-hidden bg-phase-surface shadow-md ${className || ''}`}\n    >\n      {thumbnailUrl ? (\n        <ImageBackground source={{ uri: thumbnailUrl }} className=\"flex-1\" resizeMode=\"cover\">\n          <CardOverlay\n            title={title}\n            creator={creator}\n            resourceCount={resourceCount}\n            subjectTag={subjectTag}\n            verified={verified}\n            onPullToDesk={onPullToDesk ? () => onPullToDesk(contextData as T) : undefined}\n          />\n        </ImageBackground>\n      ) : (\n        <VStack className=\"flex-1 items-center justify-center bg-phase-surface\">\n          <BookOpen className=\"text-phase-accent opacity-50\" size={44} />\n          <CardOverlay\n            title={title}\n            creator={creator}\n            resourceCount={resourceCount}\n            subjectTag={subjectTag}\n            verified={verified}\n            onPullToDesk={onPullToDesk ? () => onPullToDesk(contextData as T) : undefined}\n            absolute\n          />\n        </VStack>\n      )}\n    </Box>\n  );\n\n  if (onPress) {\n    return (\n      <Pressable onPress={() => onPress(contextData as T)} className=\"rounded-3xl mr-4\">\n        {cardContent}\n      </Pressable>\n    );\n  }\n  return <Box className=\"rounded-3xl mr-4\">{cardContent}</Box>;\n}\n\n// ============================================================================\n// INTERNAL: OVERLAY\n// ============================================================================\n\ninterface OverlayProps {\n  title: string;\n  creator: string;\n  resourceCount: number;\n  subjectTag: string;\n  verified: boolean;\n  onPullToDesk?: () => void;\n  absolute?: boolean;\n}\n\nfunction CardOverlay({\n  title,\n  creator,\n  resourceCount,\n  subjectTag,\n  verified,\n  onPullToDesk,\n  absolute = false,\n}: OverlayProps) {\n  return (\n    <VStack\n      className={`\n                flex-1 justify-between p-3\n                ${absolute ? 'absolute inset-0' : ''}\n            `}\n    >\n      {/* Top Row */}\n      <HStack className=\"items-center justify-between\">\n        <Box className=\"bg-phase-accent px-2 py-1 rounded-md\">\n          <Text className=\"text-[10px] font-bold text-white tracking-widest uppercase\">\n            {subjectTag}\n          </Text>\n        </Box>\n        {verified && (\n          <HStack className=\"items-center gap-1 bg-black/40 px-2 py-1 rounded-md border border-white/10\">\n            <BadgeCheck className=\"text-phase-success\" size={12} />\n            <Text className=\"text-[10px] font-semibold text-phase-success\">Verified</Text>\n          </HStack>\n        )}\n      </HStack>\n\n      {/* Bottom Gradient with title, creator, count */}\n      <LinearGradient\n        colors={['transparent', 'rgba(0,0,0,0.6)', 'rgba(0,0,0,0.9)']}\n        className=\"absolute left-0 right-0 bottom-0 p-3 pt-8\"\n      >\n        <VStack className=\"gap-1\">\n          <Text className=\"text-sm font-bold text-white leading-5\" numberOfLines={2}>\n            {title}\n          </Text>\n          <Text className=\"text-[11px] text-white/70\" numberOfLines={1}>\n            {creator}\n          </Text>\n\n          <HStack className=\"items-center justify-between mt-1\">\n            <HStack className=\"items-center gap-1 bg-white/10 px-2 py-1 rounded-md border border-white/5\">\n              <BookOpen className=\"text-white/60\" size={11} />\n              <Text className=\"text-[11px] font-semibold text-white/80\">{resourceCount} Items</Text>\n            </HStack>\n\n            {onPullToDesk && (\n              <Pressable\n                onPress={onPullToDesk}\n                className=\"p-2 bg-phase-accent/20 rounded-md border border-phase-accent\"\n                hitSlop={8}\n              >\n                <Bookmark className=\"text-phase-accent\" size={14} />\n              </Pressable>\n            )}\n          </HStack>\n        </VStack>\n      </LinearGradient>\n    </VStack>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\Naween\\projects\\polymath-platform\\packages\\ui\\src\\components\\DailyResonanceCard.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\Naween\\projects\\polymath-platform\\packages\\ui\\src\\components\\DeleteAccountModal.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\Naween\\projects\\polymath-platform\\packages\\ui\\src\\components\\DeviceAccountManager.tsx","messages":[{"ruleId":"@typescript-eslint/no-explicit-any","severity":1,"message":"Unexpected any. Specify a different type.","line":87,"column":21,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":87,"endColumn":24,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[2750,2753],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[2750,2753],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":1,"message":"Unexpected any. Specify a different type.","line":112,"column":24,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":112,"endColumn":27,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[3447,3450],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[3447,3450],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":1,"message":"Unexpected any. Specify a different type.","line":146,"column":42,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":146,"endColumn":45,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[4321,4324],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[4321,4324],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":1,"message":"Unexpected any. Specify a different type.","line":193,"column":21,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":193,"endColumn":24,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[6151,6154],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[6151,6154],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":4,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { useEffect, useState } from 'react';\nimport { Alert, Platform } from 'react-native';\nimport { Box, Button, ButtonText, Heading, HStack, Text, VStack } from '../gluestack';\nimport { useDeviceAccounts, accountPin, type DeviceAccountRecord } from '@repo/core/logic';\nimport AccountPinModal, { type AccountPinModalMode } from './AccountPinModal';\nimport { hapticError, hapticLight, hapticSuccess } from '../utils/haptics';\nimport { useSanctuaryToast } from '../providers/ToastProvider';\nimport { Shield } from 'lucide-react-native';\n\ntype PendingPinAction = { mode: AccountPinModalMode; account: DeviceAccountRecord } | null;\n\nfunction getInitials(name: string | null | undefined, email: string | null | undefined) {\n  const source = name || email || 'A';\n  return (\n    source\n      .split(/\\s+/)\n      .filter(Boolean)\n      .slice(0, 2)\n      .map((part) => part[0]?.toUpperCase() ?? '')\n      .join('') || 'A'\n  );\n}\n\nexport default function DeviceAccountManager({\n  title = 'Shared device accounts',\n  subtitle = 'Switch between accounts stored on this device, protect them with a PIN, and remove them locally when needed.',\n  compact = false,\n}: {\n  title?: string;\n  subtitle?: string;\n  compact?: boolean;\n}) {\n  const {\n    accounts,\n    activeAccountId,\n    busyAccountId,\n    loading,\n    switchAccount,\n    removeAccount,\n    refresh,\n  } = useDeviceAccounts();\n  const { showToast } = useSanctuaryToast();\n  const [pinProtectedIds, setPinProtectedIds] = useState<Record<string, boolean>>({});\n  const [pinAction, setPinAction] = useState<PendingPinAction>(null);\n  const [pinBusy, setPinBusy] = useState(false);\n\n  useEffect(() => {\n    let cancelled = false;\n\n    (async () => {\n      const entries = await Promise.all(\n        accounts.map(\n          async (account) =>\n            [account.accountId, await accountPin.hasPin(account.accountId)] as const,\n        ),\n      );\n\n      if (cancelled) return;\n      setPinProtectedIds(Object.fromEntries(entries));\n    })();\n\n    return () => {\n      cancelled = true;\n    };\n  }, [accounts]);\n\n  const accountLabel = (account: DeviceAccountRecord) =>\n    account.fullName || account.email || 'This account';\n\n  const askForPin = (mode: AccountPinModalMode, account: DeviceAccountRecord) => {\n    hapticLight();\n    setPinAction({ mode, account });\n  };\n\n  const handleSwitch = async (account: DeviceAccountRecord) => {\n    const protectedByPin = !!pinProtectedIds[account.accountId];\n    if (protectedByPin) {\n      askForPin('verify', account);\n      return;\n    }\n\n    setPinBusy(true);\n    try {\n      await switchAccount(account.accountId);\n      hapticSuccess();\n      showToast?.({ message: `Switched to ${accountLabel(account)}`, type: 'success' });\n    } catch (error: any) {\n      hapticError();\n      showToast?.({ message: error?.message ?? 'Could not switch account', type: 'error' });\n    } finally {\n      setPinBusy(false);\n    }\n  };\n\n  const handleRemove = async (account: DeviceAccountRecord) => {\n    const protectedByPin = !!pinProtectedIds[account.accountId];\n    if (protectedByPin) {\n      askForPin('remove', account);\n      return;\n    }\n\n    const proceed = () =>\n      removeAccount(account.accountId)\n        .then(() => {\n          hapticSuccess();\n          showToast?.({\n            message: `Removed ${accountLabel(account)} from this device`,\n            type: 'success',\n          });\n          refresh();\n        })\n        .catch((error: any) => {\n          hapticError();\n          showToast?.({ message: error?.message ?? 'Could not remove account', type: 'error' });\n        });\n\n    if (Platform.OS === 'web') {\n      const confirmed = window.confirm(`Remove ${accountLabel(account)} from this device?`);\n      if (!confirmed) return;\n      setPinBusy(true);\n      try {\n        await proceed();\n      } finally {\n        setPinBusy(false);\n      }\n      return;\n    }\n\n    Alert.alert('Remove account', `Remove ${accountLabel(account)} from this device?`, [\n      { text: 'Cancel', style: 'cancel' },\n      {\n        text: 'Remove',\n        style: 'destructive',\n        onPress: async () => {\n          setPinBusy(true);\n          try {\n            await proceed();\n          } finally {\n            setPinBusy(false);\n          }\n        },\n      },\n    ]);\n  };\n\n  const handlePinSubmit = async (values: any) => {\n    if (!pinAction) return;\n    const { mode, account } = pinAction;\n    setPinBusy(true);\n    try {\n      if (mode === 'verify') {\n        const ok = await accountPin.verifyPin(account.accountId, values.pin);\n        if (!ok) {\n          throw new Error('PIN did not match this account.');\n        }\n        await switchAccount(account.accountId);\n        showToast?.({ message: `Switched to ${accountLabel(account)}`, type: 'success' });\n        return;\n      }\n\n      if (mode === 'create') {\n        await accountPin.setPin(account.accountId, values.pin);\n        setPinProtectedIds((current) => ({ ...current, [account.accountId]: true }));\n        showToast?.({ message: `PIN added for ${accountLabel(account)}`, type: 'success' });\n        return;\n      }\n\n      if (mode === 'update') {\n        const ok = await accountPin.verifyPin(account.accountId, values.currentPin);\n        if (!ok) {\n          throw new Error('Current PIN did not match this account.');\n        }\n        await accountPin.setPin(account.accountId, values.nextPin);\n        setPinProtectedIds((current) => ({ ...current, [account.accountId]: true }));\n        showToast?.({ message: `PIN updated for ${accountLabel(account)}`, type: 'success' });\n        return;\n      }\n\n      if (mode === 'remove') {\n        const ok = await accountPin.verifyPin(account.accountId, values.pin);\n        if (!ok) {\n          throw new Error('PIN did not match this account.');\n        }\n        await accountPin.removePin(account.accountId);\n        setPinProtectedIds((current) => ({ ...current, [account.accountId]: false }));\n        await removeAccount(account.accountId);\n        showToast?.({\n          message: `Removed ${accountLabel(account)} from this device`,\n          type: 'success',\n        });\n        return;\n      }\n    } catch (error: any) {\n      hapticError();\n      showToast?.({ message: error?.message ?? 'Action failed', type: 'error' });\n    } finally {\n      setPinBusy(false);\n      setPinAction(null);\n      refresh();\n    }\n  };\n\n  return (\n    <Box\n      className={`rounded-[28px] border border-phase-border bg-phase-surface ${compact ? 'p-4' : 'p-5'}`}\n    >\n      <VStack className=\"gap-3\">\n        <HStack className=\"items-start justify-between gap-3\">\n          <VStack className=\"flex-1 gap-1\">\n            <Heading className=\"text-lg font-bold text-phase-primary\">{title}</Heading>\n            <Text className=\"text-sm leading-relaxed text-phase-secondary\">{subtitle}</Text>\n          </VStack>\n          <Box className=\"h-11 w-11 items-center justify-center rounded-[14px] bg-phase-world border border-phase-border\">\n            <Shield size={18} className=\"text-phase-primary\" />\n          </Box>\n        </HStack>\n\n        {loading ? (\n          <Text className=\"text-sm text-phase-secondary\">Loading accountsΓÇª</Text>\n        ) : accounts.length === 0 ? (\n          <Box className=\"rounded-[20px] border border-dashed border-phase-border bg-phase-world p-4\">\n            <Text className=\"text-sm text-phase-secondary\">\n              No shared device accounts are stored here yet.\n            </Text>\n          </Box>\n        ) : (\n          <VStack className=\"gap-3\">\n            {accounts.map((account) => {\n              const isActive = account.accountId === activeAccountId;\n              const busy = busyAccountId === account.accountId || pinBusy;\n              return (\n                <Box\n                  key={account.accountId}\n                  className={`rounded-[24px] border p-4 ${isActive ? 'border-phase-primary bg-phase-world' : 'border-phase-border bg-phase-surface'}`}\n                >\n                  <HStack className=\"items-start gap-3\">\n                    <Box className=\"h-12 w-12 items-center justify-center rounded-[16px] bg-phase-accent/10 border border-phase-border\">\n                      <Text className=\"text-sm font-bold text-phase-primary\">\n                        {getInitials(account.fullName, account.email)}\n                      </Text>\n                    </Box>\n                    <VStack className=\"flex-1 gap-1\">\n                      <HStack className=\"items-center gap-2\">\n                        <Text className=\"text-base font-semibold text-phase-primary\">\n                          {account.fullName || account.email || account.accountId}\n                        </Text>\n                        {isActive && (\n                          <Box className=\"rounded-full bg-phase-primary px-2 py-1\">\n                            <Text className=\"text-[10px] font-bold uppercase text-white\">\n                              Active\n                            </Text>\n                          </Box>\n                        )}\n                      </HStack>\n                      <Text className=\"text-sm text-phase-secondary\">\n                        {account.email || 'No email saved'}\n                      </Text>\n                      <Text className=\"text-xs text-phase-secondary\">\n                        {pinProtectedIds[account.accountId]\n                          ? 'PIN protected on this device'\n                          : 'No local PIN yet'}\n                      </Text>\n                    </VStack>\n                  </HStack>\n\n                  <HStack className=\"mt-4 gap-2\">\n                    {!isActive ? (\n                      <Button\n                        className=\"flex-1 rounded-2xl\"\n                        variant=\"outline\"\n                        onPress={() => handleSwitch(account)}\n                        isDisabled={busy}\n                      >\n                        <ButtonText>Switch</ButtonText>\n                      </Button>\n                    ) : (\n                      <Button\n                        className=\"flex-1 rounded-2xl\"\n                        variant=\"outline\"\n                        onPress={() =>\n                          askForPin(\n                            pinProtectedIds[account.accountId] ? 'update' : 'create',\n                            account,\n                          )\n                        }\n                        isDisabled={busy}\n                      >\n                        <ButtonText>\n                          {pinProtectedIds[account.accountId] ? 'Change PIN' : 'Set PIN'}\n                        </ButtonText>\n                      </Button>\n                    )}\n                    <Button\n                      className=\"rounded-2xl\"\n                      variant=\"solid\"\n                      action=\"negative\"\n                      onPress={() => handleRemove(account)}\n                      isDisabled={busy}\n                    >\n                      <ButtonText>Remove</ButtonText>\n                    </Button>\n                  </HStack>\n                </Box>\n              );\n            })}\n          </VStack>\n        )}\n      </VStack>\n\n      <AccountPinModal\n        isOpen={!!pinAction}\n        mode={pinAction?.mode ?? 'verify'}\n        accountLabel={pinAction ? accountLabel(pinAction.account) : null}\n        allowClose={!pinBusy}\n        isLoading={pinBusy}\n        onClose={() => setPinAction(null)}\n        onSubmit={handlePinSubmit}\n      />\n    </Box>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\Naween\\projects\\polymath-platform\\packages\\ui\\src\\components\\EmptyState.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\Naween\\projects\\polymath-platform\\packages\\ui\\src\\components\\EntityModal.tsx","messages":[{"ruleId":"@typescript-eslint/no-explicit-any","severity":1,"message":"Unexpected any. Specify a different type.","line":14,"column":22,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":14,"endColumn":25,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[443,446],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[443,446],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":1,"message":"Unexpected any. Specify a different type.","line":37,"column":49,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":37,"endColumn":52,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[1008,1011],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[1008,1011],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":1,"message":"Unexpected any. Specify a different type.","line":46,"column":47,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":46,"endColumn":50,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[1266,1269],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[1266,1269],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":3,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React from 'react';\nimport { EntityDefinition, EntityMode, EntityInstance } from '@repo/core/logic';\nimport SanctuaryModal from './SanctuaryModal';\nimport { Box, Text, VStack } from '../gluestack';\nimport EntityView from './EntityView';\n\nexport interface EntityModalProps {\n  isOpen: boolean;\n  onClose: () => void;\n  definition: EntityDefinition;\n  mode: EntityMode;\n  instance?: EntityInstance;\n  title?: string;\n  onSuccess?: (data: any) => void;\n}\n\n/**\n * EntityModal\n *\n * A generalized modal for viewing or editing entities.\n * Hardened v3 implementation.\n */\nexport default function EntityModal({\n  isOpen,\n  onClose,\n  definition,\n  mode,\n  instance,\n  title,\n  onSuccess,\n}: EntityModalProps) {\n  const displayTitle =\n    title || `${mode.charAt(0).toUpperCase() + mode.slice(1)} ${definition.type}`;\n\n  const renderContent = () => {\n    // If a specialized component exists for this mode (e.g., a multi-step flow for school creation), use it.\n    const components = definition.components as any;\n    const specializedComponent = components?.[mode];\n\n    if (specializedComponent) {\n      return (\n        <EntityView\n          definition={definition}\n          instance={instance}\n          mode={mode}\n          onAction={(action: string, payload: any) => {\n            if (action === 'complete' || action === 'close') onClose();\n            if (action === 'success' || action === 'complete') onSuccess?.(payload);\n          }}\n        />\n      );\n    }\n\n    // Fallback to standard views/forms\n    if (mode === 'create' || mode === 'edit') {\n      return (\n        <VStack className=\"gap-4\">\n          <Text className=\"text-phase-text-primary font-bold\">\n            {mode === 'create' ? 'Creating' : 'Editing'} {definition.type}\n          </Text>\n          {/* Default FormManager-powered form or generic FormBuilder */}\n          <Box className=\"bg-phase-surface p-5 rounded-comfortable\">\n            <Text className=\"text-phase-text-secondary\">Standard Form for {definition.type}</Text>\n          </Box>\n        </VStack>\n      );\n    }\n\n    return <EntityView definition={definition} instance={instance} mode={mode} />;\n  };\n\n  return (\n    <SanctuaryModal isOpen={isOpen} onClose={onClose} title={displayTitle}>\n      <Box className=\"p-4\">{renderContent()}</Box>\n    </SanctuaryModal>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\Naween\\projects\\polymath-platform\\packages\\ui\\src\\components\\EntityModal.web.tsx","messages":[{"ruleId":"@typescript-eslint/no-explicit-any","severity":1,"message":"Unexpected any. Specify a different type.","line":13,"column":22,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":13,"endColumn":25,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[408,411],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[408,411],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'instance' is defined but never used.","line":27,"column":3,"nodeType":"Identifier","messageId":"unusedVar","endLine":27,"endColumn":11},{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'onSuccess' is defined but never used.","line":29,"column":3,"nodeType":"Identifier","messageId":"unusedVar","endLine":29,"endColumn":12}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":3,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React from 'react';\nimport { EntityDefinition, EntityMode, EntityInstance } from '@repo/core/logic';\nimport SanctuaryModal from './SanctuaryModal.web';\nimport { Box, Text, VStack } from '../gluestack';\n\nexport interface EntityModalProps {\n  isOpen: boolean;\n  onClose: () => void;\n  definition: EntityDefinition;\n  mode: EntityMode;\n  instance?: EntityInstance;\n  title?: string;\n  onSuccess?: (data: any) => void;\n}\n\n/**\n * EntityModal.web\n *\n * Web-optimized entity modal.\n * Hardened v3 implementation.\n */\nexport default function EntityModal({\n  isOpen,\n  onClose,\n  definition,\n  mode,\n  instance,\n  title,\n  onSuccess,\n}: EntityModalProps) {\n  const displayTitle =\n    title || `${mode.charAt(0).toUpperCase() + mode.slice(1)} ${definition.type}`;\n\n  return (\n    <SanctuaryModal isOpen={isOpen} onClose={onClose} title={displayTitle} size=\"md\">\n      <VStack className=\"gap-4\">\n        {mode === 'view' ? (\n          <Box>\n            <Text className=\"text-phase-text-primary\">Web View for {definition.type}</Text>\n            {/* Web-optimized view component */}\n          </Box>\n        ) : (\n          <Box>\n            <Text className=\"text-phase-text-primary\">Web Form for {definition.type}</Text>\n            {/* Web-optimized form component */}\n          </Box>\n        )}\n      </VStack>\n    </SanctuaryModal>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\Naween\\projects\\polymath-platform\\packages\\ui\\src\\components\\EntityView.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\Naween\\projects\\polymath-platform\\packages\\ui\\src\\components\\EnvironmentGuard.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\Naween\\projects\\polymath-platform\\packages\\ui\\src\\components\\ErrorBoundary.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'HStack' is defined but never used.","line":12,"column":3,"nodeType":"Identifier","messageId":"unusedVar","endLine":12,"endColumn":9,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"HStack"},"fix":{"range":[248,258],"text":""},"desc":"Remove unused variable \"HStack\"."}]},{"ruleId":"react-native-a11y/has-valid-accessibility-descriptors","severity":1,"message":"Missing a11y props. Expected one of: accessibilityRole OR role OR BOTH accessibilityLabel + accessibilityHint OR BOTH accessibilityActions + onAccessibilityAction","line":74,"column":11,"nodeType":"JSXOpeningElement","endLine":78,"endColumn":12,"fix":{"range":[2246,2246],"text":" accessibilityRole=\"button\""}}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":1,"source":"import React, { Component, ErrorInfo, ReactNode } from 'react';\nimport { Platform, View, Text as RNText, TouchableOpacity, StyleSheet } from 'react-native';\nimport {\n  Box,\n  VStack,\n  Text,\n  Heading,\n  Center,\n  Button,\n  ButtonText,\n  ButtonIcon,\n  HStack,\n} from '../gluestack';\nimport { AlertTriangle, RefreshCw } from 'lucide-react-native';\n\ninterface Props {\n  children: ReactNode;\n  name: string; // Name for tracking which boundary caught the error\n  fallback?: ReactNode;\n  onError?: (error: Error, errorInfo: ErrorInfo) => void;\n}\n\ninterface State {\n  hasError: boolean;\n  error: Error | null;\n  isRecovering: boolean; // Recursion guard\n}\n\nif (__DEV__ && !Component) {\n  console.error(\n    'CRITICAL: React.Component is undefined in ErrorBoundary initialization. This usually indicates a broken Metro resolution or Circular Dependency.',\n  );\n}\n\nexport default class ErrorBoundary extends Component<Props, State> {\n  public state: State = {\n    hasError: false,\n    error: null,\n    isRecovering: false,\n  };\n\n  public static getDerivedStateFromError(error: Error): State {\n    return { hasError: true, error, isRecovering: false };\n  }\n\n  public componentDidCatch(error: Error, errorInfo: ErrorInfo) {\n    console.error(`Error in ${this.props.name}:`, error, errorInfo);\n\n    // Recursive protection: If we are already recovering and hit another error, something is fundamentally broken\n    if (this.state.isRecovering) {\n      console.error('Critical: Recursive error detected in ErrorBoundary itself.');\n      return;\n    }\n\n    this.setState({ isRecovering: true });\n\n    // Call custom error handler if provided\n    this.props.onError?.(error, errorInfo);\n  }\n\n  private handleReset = () => {\n    this.setState({ hasError: false, error: null, isRecovering: false });\n  };\n\n  private renderSafeFallback() {\n    return (\n      <View style={styles.safeContainer}>\n        <View style={styles.safeCard}>\n          <RNText style={styles.safeTitle}>Sanctuary Disrupted</RNText>\n          <RNText style={styles.safeMessage}>\n            A critical error has occurred. The sanctuary is momentarily unstable.\n            {__DEV__ && this.state.error && `\\n\\n${this.state.error.toString()}`}\n          </RNText>\n          <TouchableOpacity\n            style={styles.safeButton}\n            onPress={this.handleReset}\n            activeOpacity={0.7}\n          >\n            <RNText style={styles.safeButtonText}>Restore Sanctuary</RNText>\n          </TouchableOpacity>\n        </View>\n      </View>\n    );\n  }\n\n  public render() {\n    if (this.state.hasError) {\n      if (this.props.fallback) {\n        return this.props.fallback;\n      }\n\n      // High-risk: Rendering the full design system fallback.\n      // If this fails (double-fault), we fall back to the basic React Native View/Text.\n      try {\n        return (\n          <Box className=\"flex-1 bg-phase-ink\">\n            <Center className=\"flex-1 p-8\">\n              <VStack className=\"gap-8 items-center max-w-[400px]\">\n                <Box className=\"p-8 bg-phase-danger/10 rounded-full\">\n                  {/* These icons are the most likely to cause \"Element type is invalid\" on Web if not aliased */}\n                  {Platform.OS !== 'web' ? (\n                    <AlertTriangle size={64} className=\"text-phase-danger\" />\n                  ) : (\n                    <RNText style={{ fontSize: 64 }}>ΓÜá∩╕Å</RNText>\n                  )}\n                </Box>\n\n                <Heading className=\"text-phase-text-primary text-center text-2xl font-bold\">\n                  Something went wrong\n                </Heading>\n\n                <Text className=\"text-phase-text-secondary text-center text-base\">\n                  We&apos;ve encountered an unexpected issue. The sanctuary is momentarily\n                  disrupted.\n                </Text>\n\n                <Button\n                  onPress={this.handleReset}\n                  className=\"h-14 px-8 bg-phase-danger rounded-xl flex-row items-center gap-2\"\n                >\n                  {Platform.OS !== 'web' && (\n                    <ButtonIcon as={RefreshCw} className=\"text-phase-text-primary\" />\n                  )}\n                  <ButtonText className=\"text-white font-bold text-lg\">Try Again</ButtonText>\n                </Button>\n\n                {__DEV__ && this.state.error && (\n                  <Box className=\"p-4 bg-phase-surface/50 rounded-xl mt-8 w-full border border-phase-surface\">\n                    <Text className=\"text-phase-text-tertiary text-[10px] mb-1\">\n                      Boundary: {this.props.name}\n                    </Text>\n                    <Text className=\"text-phase-danger text-[10px] font-mono\">\n                      {this.state.error.toString()}\n                    </Text>\n                  </Box>\n                )}\n              </VStack>\n            </Center>\n          </Box>\n        );\n      } catch (e) {\n        console.error('Critical: ErrorBoundary double-faulted. Falling back to SafeFallback.', e);\n        return this.renderSafeFallback();\n      }\n    }\n\n    return this.props.children;\n  }\n}\n\nconst styles = StyleSheet.create({\n  safeContainer: {\n    flex: 1,\n    backgroundColor: '#0A0A0A', // Theme.colors.ink\n    alignItems: 'center',\n    justifyContent: 'center',\n    padding: 24,\n  },\n  safeCard: {\n    backgroundColor: '#1A1A1A', // Theme.colors.shroud\n    padding: 32,\n    borderRadius: 16,\n    alignItems: 'center',\n    maxWidth: 400,\n    width: '100%',\n    borderWidth: 1,\n    borderColor: '#FF634733', // EmberRed 20%\n  },\n  safeTitle: {\n    fontSize: 24,\n    fontWeight: '700',\n    color: '#FFFFFF',\n    marginBottom: 16,\n    textAlign: 'center',\n  },\n  safeMessage: {\n    fontSize: 16,\n    color: '#A0A0A0',\n    textAlign: 'center',\n    marginBottom: 32,\n    lineHeight: 24,\n  },\n  safeButton: {\n    backgroundColor: '#FF6347',\n    paddingVertical: 14,\n    paddingHorizontal: 28,\n    borderRadius: 12,\n  },\n  safeButtonText: {\n    color: '#FFFFFF',\n    fontSize: 16,\n    fontWeight: '600',\n  },\n});\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\Naween\\projects\\polymath-platform\\packages\\ui\\src\\components\\ErrorMessage.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\Naween\\projects\\polymath-platform\\packages\\ui\\src\\components\\FeatureDiscoveryModal.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\Naween\\projects\\polymath-platform\\packages\\ui\\src\\components\\FeatureInfoIcon.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\Naween\\projects\\polymath-platform\\packages\\ui\\src\\components\\FounderGlow.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\Naween\\projects\\polymath-platform\\packages\\ui\\src\\components\\GlassCard.tsx","messages":[{"ruleId":"@typescript-eslint/no-explicit-any","severity":1,"message":"Unexpected any. Specify a different type.","line":7,"column":11,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":7,"endColumn":14,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[180,183],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[180,183],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React from 'react';\nimport { LayoutChangeEvent } from 'react-native';\nimport { Box } from '../gluestack';\n\ninterface GlassCardProps {\n  children: React.ReactNode;\n  style?: any;\n  onLayout?: (event: LayoutChangeEvent) => void;\n  className?: string;\n}\n\n/**\n * GlassCard - Implements the \"Glass Protocol\"\n * Hardened v3 implementation using NativeWind primitives.\n */\nexport const GlassCard = ({ children, style, onLayout, className, ...props }: GlassCardProps) => {\n  return (\n    <Box\n      className={`rounded-[32px] p-4 bg-phase-surface border border-white/10 shadow-xl ${className || ''}`}\n      style={style}\n      onLayout={onLayout}\n      {...props}\n    >\n      {children}\n    </Box>\n  );\n};\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\Naween\\projects\\polymath-platform\\packages\\ui\\src\\components\\GlobalHeader.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'Dimensions' is defined but never used.","line":2,"column":10,"nodeType":"Identifier","messageId":"unusedVar","endLine":2,"endColumn":20,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"Dimensions"},"fix":{"range":[50,61],"text":""},"desc":"Remove unused variable \"Dimensions\"."}]},{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'BlurView' is defined but never used.","line":16,"column":10,"nodeType":"Identifier","messageId":"unusedVar","endLine":16,"endColumn":18,"suggestions":[{"messageId":"removeUnusedImportDeclaration","data":{"varName":"BlurView"},"fix":{"range":[408,446],"text":""},"desc":"Remove unused import declaration."}]},{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'TemporalGlass' is defined but never used.","line":20,"column":10,"nodeType":"Identifier","messageId":"unusedVar","endLine":20,"endColumn":23,"suggestions":[{"messageId":"removeUnusedImportDeclaration","data":{"varName":"TemporalGlass"},"fix":{"range":[553,621],"text":""},"desc":"Remove unused import declaration."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":1,"message":"Unexpected any. Specify a different type.","line":66,"column":33,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":66,"endColumn":36,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[1693,1696],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[1693,1696],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":1,"message":"Unexpected any. Specify a different type.","line":67,"column":36,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":67,"endColumn":39,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[1749,1752],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[1749,1752],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'RoleIcon' is assigned a value but never used.","line":122,"column":17,"nodeType":"Identifier","messageId":"unusedVar","endLine":122,"endColumn":25}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":6,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { useState } from 'react';\nimport { Dimensions, TouchableOpacity, Pressable } from 'react-native';\nimport { useNavigation } from '@react-navigation/native';\nimport { useSafeAreaInsets } from 'react-native-safe-area-context';\nimport { useTranslation } from 'react-i18next';\nimport {\n  ChevronLeft,\n  Menu,\n  Search,\n  X,\n  Bell,\n  GraduationCap,\n  Crown,\n  School,\n} from 'lucide-react-native';\nimport { BlurView } from 'expo-blur';\n\nimport { Box, VStack, HStack, Text } from '../gluestack';\nimport { hapticLight } from '../utils/haptics';\nimport { TemporalGlass } from '../components-native/TemporalGlass';\nimport { UserAvatar } from './UserAvatar';\nimport SanctuaryInput from './SanctuaryInput';\nimport NotificationDrawer from './NotificationDrawer';\n\nimport { useStore, usePermissions } from '@repo/core/logic';\nimport { useNotifications } from '@repo/core/logic';\n\nexport interface GlobalHeaderProps {\n  title?: string;\n  subtitle?: string;\n  showBack?: boolean;\n  onBack?: () => void;\n  showMenu?: boolean;\n  showSearch?: boolean;\n  rightAction?: React.ReactNode;\n  userName?: string;\n  searchProps?: {\n    value: string;\n    onChangeText: (text: string) => void;\n    placeholder?: string;\n  };\n  isSelfView?: boolean;\n  avatarUrl?: string;\n}\n\n/**\n * GlobalHeader - Core navigation and brand identity component.\n * Hardened v3 implementation.\n */\nexport default function GlobalHeader({\n  title,\n  subtitle,\n  showBack,\n  onBack,\n  showMenu = false,\n  showSearch = false,\n  rightAction,\n  userName,\n  searchProps,\n  isSelfView = false,\n  avatarUrl,\n}: GlobalHeaderProps) {\n  const { t } = useTranslation();\n  const { can } = usePermissions();\n\n  const user = useStore((state: any) => state.user);\n  const navigation = useNavigation<any>();\n  const insets = useSafeAreaInsets();\n\n  const [showNotifications, setShowNotifications] = useState(false);\n  const {\n    notifications,\n    unreadCount,\n    isLoading: notifLoading,\n    markAsRead,\n    markAllRead,\n  } = useNotifications(user?.id);\n\n  const [isSearchActive, setIsSearchActive] = useState(false);\n  const [internalSearchQuery, setInternalSearchQuery] = useState('');\n\n  const searchQuery = searchProps?.value ?? internalSearchQuery;\n  const setSearchQuery = searchProps?.onChangeText ?? setInternalSearchQuery;\n\n  const displayName = userName || user?.user_metadata?.full_name?.split(' ')[0] || '';\n  const userFullName = userName || user?.user_metadata?.full_name || '';\n\n  const getRoleContext = () => {\n    if (can('manage', 'AdminDashboard')) {\n      return { icon: Crown, emoji: '\\u26A1', label: t('roles.admin') || 'Admin' };\n    }\n    if (can('manage', 'PrincipalDashboard')) {\n      return {\n        icon: Crown,\n        emoji: '\\uD83C\\uDFDB\\uFE0F',\n        label: t('roles.principal') || 'Principal',\n      };\n    }\n    if (can('manage', 'SectionHeadDashboard')) {\n      return {\n        icon: GraduationCap,\n        emoji: '\\uD83C\\uDFD4\\uFE0F',\n        label: t('roles.sectionHead') || 'Section Head',\n      };\n    }\n    if (can('manage', 'GradeHeadDashboard')) {\n      return {\n        icon: GraduationCap,\n        emoji: '\\uD83C\\uDF32',\n        label: t('roles.gradeHead') || 'Grade Head',\n      };\n    }\n    if (can('manage', 'TeacherDashboard')) {\n      return { icon: GraduationCap, emoji: '\\uD83C\\uDF31', label: t('roles.teacher') || 'Teacher' };\n    }\n    if (can('manage', 'StudentDashboard')) {\n      return { icon: School, emoji: '\\uD83D\\uDCDA', label: t('roles.student') || 'Student' };\n    }\n    return { icon: School, emoji: '\\uD83C\\uDF3F', label: t('roles.member') || 'Member' };\n  };\n\n  const { icon: RoleIcon, emoji: RoleEmoji, label: RoleLabel } = getRoleContext();\n\n  const getGreetingDetails = () => {\n    const hour = new Date().getHours();\n    if (hour < 12) return { text: t('goodMorning'), emoji: '\\uD83C\\uDF05' };\n    if (hour < 18) return { text: t('goodAfternoon'), emoji: '\\u2600\\uFE0F' };\n    return { text: t('goodEvening'), emoji: '\\uD83C\\uDFEE' };\n  };\n\n  const { text: greetingText, emoji: GreetingEmoji } = getGreetingDetails();\n\n  const headerHeight = insets.top + (isSearchActive ? 120 : 80);\n  const showFullNameAsPrimary = can('manage', 'StudentDashboard');\n\n  return (\n    <Box className=\"w-full relative\" style={{ height: headerHeight }}>\n      {/* SOLID BACKDROP (REPLACED GLASS) */}\n      <Box\n        className=\"absolute inset-0 bg-phase-canvas border-b border-white/5\"\n        style={{ opacity: 0.95 }}\n      />\n\n      <VStack\n        className=\"flex-1 px-4\"\n        style={{\n          gap: 12,\n          paddingTop: insets.top + 14,\n          paddingBottom: 16,\n        }}\n      >\n        <HStack className=\"items-center justify-between gap-2\">\n          {/* LEFT: Greeting or Title */}\n          <HStack className=\"items-center gap-2\">\n            {showBack ? (\n              <Pressable accessibilityRole=\"button\" onPress={onBack || (() => navigation.goBack())}>\n                <Box className=\"p-2 rounded-xl bg-phase-surface\">\n                  <ChevronLeft size={24} className=\"text-phase-text-primary\" />\n                </Box>\n              </Pressable>\n            ) : (\n              showMenu && (\n                <Pressable\n                  accessibilityRole=\"button\"\n                  onPress={() => navigation.openDrawer && navigation.openDrawer()}\n                >\n                  <Menu className=\"text-phase-text-primary\" size={24} />\n                </Pressable>\n              )\n            )}\n\n            {isSelfView && (\n              <Pressable accessibilityRole=\"button\" onPress={() => navigation.navigate('Profile')}>\n                <Box className=\"mr-2\">\n                  <UserAvatar\n                    avatarUrl={avatarUrl || user?.user_metadata?.avatar_url}\n                    fullName={userFullName}\n                    fallbackEmoji={RoleEmoji}\n                    size={32}\n                    borderRadius={12}\n                  />\n                </Box>\n              </Pressable>\n            )}\n\n            <VStack className=\"gap-0.5\">\n              {(subtitle || (!title && greetingText)) && (\n                <HStack className=\"items-center gap-1\">\n                  <Text className=\"text-[10px] font-bold tracking-widest uppercase text-phase-text-secondary\">\n                    {title ? subtitle : greetingText}\n                  </Text>\n                  {!title && <Text className=\"text-sm -mt-0.5\">{GreetingEmoji}</Text>}\n                </HStack>\n              )}\n              <Text className=\"text-lg font-bold text-phase-text-primary\">\n                {title\n                  ? title\n                  : isSelfView\n                    ? showFullNameAsPrimary\n                      ? userFullName\n                      : RoleLabel\n                    : displayName}\n              </Text>\n            </VStack>\n          </HStack>\n\n          {/* RIGHT: Actions */}\n          <HStack className=\"items-center gap-4\">\n            {showSearch && (\n              <TouchableOpacity\n                accessibilityRole=\"button\"\n                onPress={() => {\n                  hapticLight();\n                  setIsSearchActive(!isSearchActive);\n                }}\n              >\n                <Box\n                  className={`p-2 rounded-full ${isSearchActive ? 'bg-phase-accent/20' : 'bg-transparent'}`}\n                >\n                  {isSearchActive ? (\n                    <X\n                      size={22}\n                      className={isSearchActive ? 'text-phase-accent' : 'text-phase-text-primary'}\n                    />\n                  ) : (\n                    <Search size={22} className=\"text-phase-text-primary\" />\n                  )}\n                </Box>\n              </TouchableOpacity>\n            )}\n\n            {rightAction ? (\n              rightAction\n            ) : (\n              <TouchableOpacity\n                accessibilityRole=\"button\"\n                onPress={() => {\n                  hapticLight();\n                  setShowNotifications(true);\n                }}\n              >\n                <Box className=\"relative\">\n                  <Bell size={24} className=\"text-phase-text-primary\" />\n                  {/* Notification Dot */}\n                  {unreadCount > 0 && (\n                    <Box className=\"absolute top-0 right-0.5 w-2.5 h-2.5 rounded-full border-2 bg-phase-accent border-phase-canvas\" />\n                  )}\n                </Box>\n              </TouchableOpacity>\n            )}\n          </HStack>\n        </HStack>\n\n        {/* EXPANDABLE SEARCH BAR */}\n        {isSearchActive && (\n          <Box className=\"mt-2\">\n            <SanctuaryInput\n              value={searchQuery}\n              onChangeText={setSearchQuery}\n              placeholder={searchProps?.placeholder ?? t('searchPlaceholder')}\n              leftIcon={Search}\n              autoFocus\n            />\n          </Box>\n        )}\n\n        <NotificationDrawer\n          isVisible={showNotifications}\n          onClose={() => setShowNotifications(false)}\n          notifications={notifications}\n          unreadCount={unreadCount}\n          isLoading={notifLoading}\n          onMarkRead={markAsRead}\n          onMarkAllRead={markAllRead}\n        />\n      </VStack>\n    </Box>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\Naween\\projects\\polymath-platform\\packages\\ui\\src\\components\\GuestDataSyncModal.tsx","messages":[{"ruleId":"react-hooks/immutability","severity":1,"message":"Error: Cannot access variable before it is declared\n\n`loadSummary` is accessed before it is declared, which prevents the earlier access from updating when this value changes over time.\n\nC:\\Users\\Naween\\projects\\polymath-platform\\packages\\ui\\src\\components\\GuestDataSyncModal.tsx:42:7\n  40 |   useEffect(() => {\n  41 |     if (isOpen) {\n> 42 |       loadSummary();\n     |       ^^^^^^^^^^^ `loadSummary` accessed before it is declared\n  43 |     }\n  44 |   }, [isOpen]);\n  45 |\n\nC:\\Users\\Naween\\projects\\polymath-platform\\packages\\ui\\src\\components\\GuestDataSyncModal.tsx:46:3\n  44 |   }, [isOpen]);\n  45 |\n> 46 |   const loadSummary = async () => {\n     |   ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n> 47 |     const dataSummary = await GuestDataSync.getGuestDataSummary();\n     | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n> 48 |     setSummary(dataSummary);\n     | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n> 49 |   };\n     | ^^^^^ `loadSummary` is declared here\n  50 |\n  51 |   const handleSync = async () => {\n  52 |     setSyncing(true);","line":42,"column":7,"nodeType":null,"endLine":42,"endColumn":18},{"ruleId":"@typescript-eslint/no-explicit-any","severity":1,"message":"Unexpected any. Specify a different type.","line":72,"column":19,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":72,"endColumn":22,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[1918,1921],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[1918,1921],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { useState, useEffect } from 'react';\nimport { Box, VStack, HStack, Text, Spinner } from '../gluestack';\nimport { GuestDataSync } from '@repo/core/native';\nimport { Check, AlertCircle, AlertTriangle } from 'lucide-react-native';\nimport { useTranslation } from 'react-i18next';\nimport SanctuaryModal from './SanctuaryModal';\nimport SanctuaryButton from './SanctuaryButton';\n\ninterface GuestDataSyncModalProps {\n  isOpen: boolean;\n  onClose: () => void;\n  userId: string;\n  onSyncComplete: () => void;\n}\n\n/**\n * GuestDataSyncModal - Hardened v3 implementation.\n */\nexport default function GuestDataSyncModal({\n  isOpen,\n  onClose,\n  userId,\n  onSyncComplete,\n}: GuestDataSyncModalProps) {\n  const { t } = useTranslation();\n\n  const [syncing, setSyncing] = useState(false);\n  const [progress, setProgress] = useState({ current: 0, total: 0, step: '' });\n  const [completed, setCompleted] = useState(false);\n  const [error, setError] = useState<string | null>(null);\n  const [summary, setSummary] = useState({\n    timetablePeriods: 0,\n    moodLogs: 0,\n    journalEntries: 0,\n    students: 0,\n    total: 0,\n  });\n  const [confirmSkip, setConfirmSkip] = useState(false);\n\n  useEffect(() => {\n    if (isOpen) {\n      loadSummary();\n    }\n  }, [isOpen]);\n\n  const loadSummary = async () => {\n    const dataSummary = await GuestDataSync.getGuestDataSummary();\n    setSummary(dataSummary);\n  };\n\n  const handleSync = async () => {\n    setSyncing(true);\n    setError(null);\n\n    try {\n      const result = await GuestDataSync.syncAllData(userId, (prog) => {\n        setProgress({\n          current: prog.completed,\n          total: prog.total,\n          step: prog.currentStep,\n        });\n      });\n\n      if (result.success) {\n        setCompleted(true);\n        setTimeout(() => {\n          onSyncComplete();\n        }, 2000);\n      } else {\n        setError(result.errors.join(', '));\n      }\n    } catch (err: any) {\n      setError(err.message);\n    } finally {\n      setSyncing(false);\n    }\n  };\n\n  const handleSkip = () => {\n    // If user has data to lose, show a confirmation step first\n    if (summary.total > 0 && !confirmSkip) {\n      setConfirmSkip(true);\n      return;\n    }\n    onClose();\n  };\n\n  const footer = !completed ? (\n    <HStack className=\"gap-4 w-full\">\n      <SanctuaryButton variant=\"ghost\" action=\"secondary\" onPress={handleSkip} isDisabled={syncing}>\n        {t('common.skip') || 'Skip'}\n      </SanctuaryButton>\n      <SanctuaryButton action=\"primary\" onPress={handleSync} isLoading={syncing} className=\"flex-1\">\n        {syncing ? t('sync.syncing') || 'Syncing...' : t('sync.syncButton') || 'Sync Data'}\n      </SanctuaryButton>\n    </HStack>\n  ) : undefined;\n\n  return (\n    <SanctuaryModal\n      isOpen={isOpen}\n      onClose={handleSkip}\n      title={\n        completed\n          ? t('sync.completeTitle') || 'Sync Complete!'\n          : t('sync.title') || 'Sync Your Data'\n      }\n      footer={footer}\n    >\n      <VStack className=\"gap-6\">\n        {/* Confirm-skip warning shown when user tries to skip with unsaved data */}\n        {confirmSkip && !completed && (\n          <VStack className=\"gap-4\">\n            <HStack className=\"gap-2 items-center\">\n              <AlertTriangle size={18} className=\"text-phase-accent\" />\n              <Text className=\"font-bold text-phase-text-primary\">\n                {t('sync.skipWarningTitle') || 'Your data will be lost'}\n              </Text>\n            </HStack>\n            <Text className=\"text-phase-text-secondary text-sm\">\n              {t('sync.skipWarningBody') ||\n                `Skipping will permanently discard ${summary.total} item${summary.total !== 1 ? 's' : ''} from your guest session. This cannot be undone.`}\n            </Text>\n            <HStack className=\"gap-2\">\n              <SanctuaryButton\n                variant=\"ghost\"\n                action=\"secondary\"\n                onPress={() => setConfirmSkip(false)}\n                className=\"flex-1\"\n              >\n                {t('common.back') || 'Back'}\n              </SanctuaryButton>\n              <SanctuaryButton\n                variant=\"solid\"\n                action=\"negative\"\n                onPress={onClose}\n                className=\"flex-1\"\n              >\n                {t('sync.discardButton') || 'Discard data'}\n              </SanctuaryButton>\n            </HStack>\n          </VStack>\n        )}\n\n        {!confirmSkip && !completed && !syncing && (\n          <>\n            <Text className=\"text-phase-text-secondary text-sm\">\n              {t('sync.description') ||\n                'We found data from your guest session. Would you like to sync it to your new account?'}\n            </Text>\n\n            {/* Data Summary */}\n            <Box className=\"bg-phase-surface rounded-xl border border-white/5 p-4\">\n              <VStack className=\"gap-2\">\n                {summary.timetablePeriods > 0 && (\n                  <HStack className=\"justify-between\">\n                    <Text className=\"text-phase-text-secondary text-sm\">Timetable Periods</Text>\n                    <Text className=\"text-phase-text-primary font-bold\">\n                      {summary.timetablePeriods}\n                    </Text>\n                  </HStack>\n                )}\n                {summary.moodLogs > 0 && (\n                  <HStack className=\"justify-between\">\n                    <Text className=\"text-phase-text-secondary text-sm\">Mood Logs</Text>\n                    <Text className=\"text-phase-text-primary font-bold\">{summary.moodLogs}</Text>\n                  </HStack>\n                )}\n                {summary.journalEntries > 0 && (\n                  <HStack className=\"justify-between\">\n                    <Text className=\"text-phase-text-secondary text-sm\">Journal Entries</Text>\n                    <Text className=\"text-phase-text-primary font-bold\">\n                      {summary.journalEntries}\n                    </Text>\n                  </HStack>\n                )}\n                {summary.students > 0 && (\n                  <HStack className=\"justify-between\">\n                    <Text className=\"text-phase-text-secondary text-sm\">Students</Text>\n                    <Text className=\"text-phase-text-primary font-bold\">{summary.students}</Text>\n                  </HStack>\n                )}\n                <Box className=\"h-px bg-white/5 my-1\" />\n                <HStack className=\"justify-between\">\n                  <Text className=\"text-phase-text-primary font-bold text-sm\">Total Items</Text>\n                  <Text className=\"text-phase-accent font-bold\">{summary.total}</Text>\n                </HStack>\n              </VStack>\n            </Box>\n          </>\n        )}\n\n        {syncing && (\n          <VStack className=\"gap-4 items-center\">\n            <Spinner size=\"large\" className=\"text-phase-accent\" />\n            <Text className=\"text-phase-text-primary text-center\">{progress.step}</Text>\n            <Text className=\"text-phase-text-secondary text-xs\">\n              {progress.current} / {progress.total} items synced\n            </Text>\n            <Box className=\"w-full h-2 bg-phase-surface rounded-full overflow-hidden\">\n              <Box\n                className=\"h-full bg-phase-accent\"\n                style={{\n                  width:\n                    progress.total > 0\n                      ? `${Math.round((progress.current / progress.total) * 100)}%`\n                      : '0%',\n                }}\n              />\n            </Box>\n          </VStack>\n        )}\n\n        {completed && (\n          <VStack className=\"gap-4 items-center\">\n            <Box className=\"w-16 h-16 rounded-full bg-phase-accent/20 items-center justify-center\">\n              <Check size={32} className=\"text-phase-accent\" />\n            </Box>\n            <Text className=\"text-phase-text-primary text-center font-bold\">\n              {t('sync.successMessage') || 'All your data has been synced successfully!'}\n            </Text>\n            <Text className=\"text-phase-text-secondary text-xs text-center\">\n              {t('sync.successDescription') || 'You can now access your data from any device.'}\n            </Text>\n          </VStack>\n        )}\n\n        {error && (\n          <Box className=\"p-4 bg-phase-danger/10 rounded-xl border border-phase-danger\">\n            <HStack className=\"gap-2\">\n              <AlertCircle size={20} className=\"text-phase-danger\" />\n              <Text className=\"text-phase-danger text-sm flex-1\">{error}</Text>\n            </HStack>\n          </Box>\n        )}\n      </VStack>\n    </SanctuaryModal>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\Naween\\projects\\polymath-platform\\packages\\ui\\src\\components\\HistoryTimeline.tsx","messages":[{"ruleId":"@typescript-eslint/no-explicit-any","severity":1,"message":"Unexpected any. Specify a different type.","line":21,"column":21,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":21,"endColumn":24,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[759,762],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[759,762],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'index' is defined but never used.","line":38,"column":28,"nodeType":"Identifier","messageId":"unusedVar","endLine":38,"endColumn":33}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { useEffect, useState } from 'react';\nimport { View, Text, StyleSheet, ScrollView, ActivityIndicator } from 'react-native';\nimport { historyAPI, AuditLogEntry } from '@repo/core/logic';\n\ninterface HistoryTimelineProps {\n  tableName: string;\n  recordId: string;\n}\n\nexport const HistoryTimeline: React.FC<HistoryTimelineProps> = ({ tableName, recordId }) => {\n  const [history, setHistory] = useState<AuditLogEntry[]>([]);\n  const [loading, setLoading] = useState(true);\n  const [error, setError] = useState<string | null>(null);\n\n  useEffect(() => {\n    const fetchHistory = async () => {\n      try {\n        setLoading(true);\n        const data = await historyAPI.getForRecord(tableName, recordId);\n        setHistory(data);\n      } catch (err: any) {\n        setError(err.message || 'Failed to load history');\n      } finally {\n        setLoading(false);\n      }\n    };\n\n    fetchHistory();\n  }, [tableName, recordId]);\n\n  if (loading) return <ActivityIndicator size=\"small\" color=\"#666\" />;\n  if (error) return <Text style={styles.error}>{error}</Text>;\n  if (history.length === 0)\n    return <Text style={styles.empty}>No history found for this item.</Text>;\n\n  return (\n    <ScrollView style={styles.container}>\n      {history.map((entry, index) => (\n        <View key={entry.id} style={styles.entry}>\n          <View style={styles.line} />\n          <View style={styles.dot} />\n          <View style={styles.content}>\n            <Text style={styles.action}>\n              {entry.action} by {entry.author?.full_name || 'System'}\n            </Text>\n            <Text style={styles.date}>{new Date(entry.changed_at).toLocaleString()}</Text>\n            {entry.action === 'UPDATE' && <Text style={styles.changes}>Content changed</Text>}\n          </View>\n        </View>\n      ))}\n    </ScrollView>\n  );\n};\n\nconst styles = StyleSheet.create({\n  container: {\n    flex: 1,\n    padding: 16,\n  },\n  entry: {\n    flexDirection: 'row',\n    marginBottom: 20,\n  },\n  line: {\n    position: 'absolute',\n    left: 3,\n    top: 20,\n    bottom: -20,\n    width: 1,\n    backgroundColor: '#DDD',\n  },\n  dot: {\n    width: 8,\n    height: 8,\n    borderRadius: 4,\n    backgroundColor: '#666',\n    marginTop: 6,\n    marginRight: 16,\n  },\n  content: {\n    flex: 1,\n  },\n  action: {\n    fontSize: 14,\n    fontWeight: '600',\n    color: '#333',\n  },\n  date: {\n    fontSize: 12,\n    color: '#999',\n    marginTop: 2,\n  },\n  changes: {\n    fontSize: 13,\n    color: '#666',\n    marginTop: 4,\n    fontStyle: 'italic',\n  },\n  error: {\n    color: '#FF3B30',\n    padding: 16,\n  },\n  empty: {\n    color: '#666',\n    padding: 16,\n    fontStyle: 'italic',\n  },\n});\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\Naween\\projects\\polymath-platform\\packages\\ui\\src\\components\\HorizontalChipRow.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprec