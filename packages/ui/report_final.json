st {\n    viewScale,\n    setScale,\n    viewMode,\n    setViewMode,\n    timelineFocus,\n    setTimelineFocus,\n    isOffline,\n    setOffline,\n  } = useTemporalStore();\n  const [isCalendarVisible, setCalendarVisible] = useState(false);\n\n  return (\n    <Box className=\"bg-white/5 rounded-3xl p-4 mx-4 border border-white/10\">\n      {/* Tactical Switcher */}\n      <HStack className=\"justify-between items-center mb-4\">\n        <HStack className=\"gap-2\">\n          {(['day', 'week', 'month'] as const).map((s) => (\n            <Pressable\n              accessibilityRole=\"button\"\n              key={s}\n              onPress={() => setScale(s)}\n              className={`py-1.5 px-3 rounded-xl ${viewScale === s ? 'bg-white/20' : 'bg-white/5'}`}\n            >\n              <Text\n                className={`text-[10px] font-bold ${viewScale === s ? 'text-white' : 'text-white/40'}`}\n              >\n                {s.toUpperCase()}\n              </Text>\n            </Pressable>\n          ))}\n        </HStack>\n\n        <HStack className=\"gap-3\">\n          {/* View Mode Toggle */}\n          <Pressable\n            accessibilityRole=\"button\"\n            onPress={() => setViewMode(viewMode === 'spotlight' ? 'timeline' : 'spotlight')}\n            className={`w-9 h-9 rounded-full items-center justify-center ${viewMode === 'timeline' ? 'bg-white/20 border border-phase-accent/50' : 'bg-white/5'}`}\n          >\n            {viewMode === 'spotlight' ? (\n              <Zap size={20} color=\"#F6BF8C\" />\n            ) : (\n              <LayoutIcon size={20} color=\"#F6BF8C\" />\n            )}\n          </Pressable>\n\n          <Pressable\n            accessibilityRole=\"button\"\n            onPress={() => setOffline(!isOffline)}\n            className=\"w-9 h-9 rounded-full bg-white/5 items-center justify-center active:bg-white/10\"\n          >\n            {isOffline ? <WifiOff size={20} color=\"#FF6B6B\" /> : <Wifi size={20} color=\"#F6BF8C\" />}\n          </Pressable>\n\n          <Pressable\n            accessibilityRole=\"button\"\n            onPress={() => setCalendarVisible(true)}\n            className=\"w-9 h-9 rounded-full bg-white/5 items-center justify-center active:bg-white/10\"\n          >\n            <Calendar size={20} color=\"#F6BF8C\" />\n          </Pressable>\n\n          <Pressable\n            accessibilityRole=\"button\"\n            className=\"w-9 h-9 rounded-full bg-white/5 items-center justify-center active:bg-white/10\"\n          >\n            <Search size={20} color=\"#F6BF8C\" />\n          </Pressable>\n        </HStack>\n      </HStack>\n\n      {/* Focus Selector (Only in Timeline Mode) */}\n      {viewMode === 'timeline' && (\n        <HStack className=\"gap-2 mb-4 justify-center\">\n          {(['all', 'mood', 'journal'] as const).map((f) => (\n            <Pressable\n              accessibilityRole=\"button\"\n              key={f}\n              onPress={() => setTimelineFocus(f)}\n              className={`py-1 px-3 rounded-full border ${timelineFocus === f ? 'bg-phase-accent/10 border-phase-accent' : 'bg-white/5 border-white/10'}`}\n            >\n              <Text\n                className={`text-[9px] font-extrabold tracking-widest ${timelineFocus === f ? 'text-phase-accent' : 'text-white/30'}`}\n              >\n                {f.toUpperCase()}\n              </Text>\n            </Pressable>\n          ))}\n        </HStack>\n      )}\n\n      {/* Intuitive Flow */}\n      <TemporalScrubber />\n\n      {/* Tactical Calendar Modal */}\n      <Modal visible={isCalendarVisible} transparent animationType=\"fade\">\n        <Box className=\"flex-1 bg-black/80 justify-center items-center\">\n          <Box className=\"w-[90%] bg-[#1A1A1A] rounded-[32px] p-6 border border-white/10\">\n            <Text className=\"text-white text-lg font-bold mb-6 text-center\">\n              Select Temporal Point\n            </Text>\n\n            <Box className=\"h-[300px] bg-white/5 rounded-2xl items-center justify-center mb-6\">\n              <Text className=\"text-white/50\">[Tactical Calendar Utility]</Text>\n            </Box>\n\n            <Pressable\n              accessibilityRole=\"button\"\n              onPress={() => setCalendarVisible(false)}\n              className=\"bg-phase-accent p-4 rounded-2xl items-center active:opacity-90\"\n            >\n              <Text className=\"text-black font-extrabold tracking-widest\">LOCK TEMPORAL VIEW</Text>\n            </Pressable>\n          </Box>\n        </Box>\n      </Modal>\n    </Box>\n  );\n};\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\Naween\\projects\\polymath-platform\\packages\\ui\\src\\components\\TemporalProvider.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\Naween\\projects\\polymath-platform\\packages\\ui\\src\\components\\TemporalProvider.web.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\Naween\\projects\\polymath-platform\\packages\\ui\\src\\components\\TemporalScrubber.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'View' is defined but never used.","line":2,"column":10,"nodeType":"Identifier","messageId":"unusedVar","endLine":2,"endColumn":14,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"View"},"fix":{"range":[36,41],"text":""},"desc":"Remove unused variable \"View\"."}]},{"ruleId":"react-hooks/refs","severity":1,"message":"Error: Cannot access refs during render\n\nReact refs are values that are not needed for rendering. Refs should only be accessed outside of render, such as in event handlers or effects. Accessing a ref value (the `current` property) during render can cause your component not to upda