 = StyleSheet.create({\n  container: {\n    position: 'relative',\n    overflow: 'hidden',\n    borderRadius: 16,\n  },\n  overlay: {\n    ...StyleSheet.absoluteFillObject,\n    backgroundColor: '#D1AC8C', // Sepia/Glass tint\n  },\n  badge: {\n    position: 'absolute',\n    top: 12,\n    right: 12,\n    flexDirection: 'row',\n    alignItems: 'center',\n    paddingVertical: 4,\n    paddingHorizontal: 8,\n    borderRadius: 8,\n    backgroundColor: 'rgba(0, 0, 0, 0.6)',\n    borderWidth: 1,\n    borderColor: 'rgba(209, 172, 140, 0.3)',\n  },\n  badgeText: {\n    fontSize: 10,\n    fontWeight: '800',\n    color: '#D1AC8C',\n    marginLeft: 4,\n    letterSpacing: 0.5,\n  },\n});\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\Naween\\projects\\polymath-platform\\packages\\ui\\src\\components\\UniversalModal.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\Naween\\projects\\polymath-platform\\packages\\ui\\src\\components\\UniversalModal.web.tsx","messages":[{"ruleId":"react-native-a11y/has-accessibility-hint","severity":1,"message":"has accessibilityLabel prop but no accessibilityHint","line":28,"column":9,"nodeType":"JSXOpeningElement","endLine":33,"endColumn":11}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React from 'react';\nimport { View, Pressable } from 'react-native';\n\nexport interface UniversalModalProps {\n  isOpen: boolean;\n  onClose: () => void;\n  children: React.ReactNode;\n  transparent?: boolean;\n  /** Whether to show a backdrop that closes on press */\n  hasBackdrop?: boolean;\n}\n\n/**\n * UniversalModal.web - Web-optimized overlay.\n * Hardened v3 implementation with NativeWind.\n */\nexport const UniversalModal = ({\n  isOpen,\n  onClose,\n  children,\n  hasBackdrop = true,\n}: UniversalModalProps) => {\n  i