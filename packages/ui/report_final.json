InsteadOfExpectError","endLine":138,"endColumn":22,"suggestions":[{"messageId":"replaceTsIgnoreWithTsExpectError","fix":{"range":[4116,4129],"text":"// @ts-expect-error"},"desc":"Replace \"@ts-ignore\" with \"@ts-expect-error\"."}]}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":8,"fixableErrorCount":0,"fixableWarningCount":0,"source":"/**\n * SANCTUARY CARD - Reusable Card Component\n *\n * A versatile card component that follows sanctuary design principles:\n * - Organic corners (never sharp)\n * - Soft shadows when elevated\n * - Lift animation when pressable\n *\n * Philosophy: Simple, reusable foundation for UI cards\n */\n\nimport React, { FC, useState } from 'react';\nimport { Pressable, Platform } from 'react-native';\nimport Animated, { useSharedValue, useAnimatedStyle, withSpring } from 'react-native-reanimated';\nimport { Box, VStack, Text } from '../gluestack';\n\n// ============================================================================\n// TYPES\n// ============================================================================\n\ninterface SanctuaryCardProps {\n  title?: string;\n  children: any;\n  footer?: any;\n  onPress?: () => void;\n  onLongPress?: () => void;\n  href?: string;\n  target?: '_blank' | '_self';\n  elevated?: boolean;\n  style?: any;\n  accessibilityLabel?: string;\n  className?: string;\n}\n\n// ============================================================================\n// CONSTANTS\n// ============================================================================\n\nconst LIFT_SCALE_NORMAL = 1.0;\nconst LIFT_SCALE_PRESSED = 1.02;\n\n// ============================================================================\n// MAIN COMPONENT\n// ============================================================================\n\nconst SanctuaryCard: FC<SanctuaryCardProps> = ({\n  title,\n  children,\n  footer,\n  onPress,\n  onLongPress,\n  href,\n  target = '_self',\n  elevated = false,\n  style,\n  accessibilityLabel,\n  className,\n}) => {\n  // Hover state - only meaningful on web (desktop pointer devices)\n  const [hovered, setHovered] = useState(false);\n\n  // Shared value for lift animation\n  const scale = useSharedValue(LIFT_SCALE_NORMAL);\n\n  // ============================================================================\n  // ANIMATION: LIFT EFFECT (when pressable)\n  // ============================================================================\n\n  const animatedStyle = useAnimatedStyle(() => {\n    return {\n      transform: [{ scale: scale.value }],\n    };\n  });\n\n  const handlePressIn = () => {\n    if (onPress || href) {\n      scale.value = withSpring(LIFT_SCALE_PRESSED, {\n        damping: 15,\n        stiffness: 150,\n      });\n    }\n  };\n\n  const handlePressOut = () => {\n    if (onPress || href) {\n      scale.value = withSpring(LIFT_SCALE_NORMAL, {\n        damping: 15,\n        stiffness: 150,\n      });\n    }\n  };\n\n  // ============================================================================\n  // RENDER: Container Level\n  // ============================================================================\n\n  const content = (\n    <Animated.View\n      style={[onPress || href ? animatedStyle : undefined, style]}\n      className={`\n                bg-phase-surface border border-white/5 rounded-3xl overflow-hidden\n                ${elevated ? 'shadow-xl shadow-black/20' : ''}\n                ${hovered && Platform.OS === 'web' ? 'opacity-90 scale-[1.01]' : ''}\n                ${className || ''}\n            `}\n    >\n      <VStack className=\"p-6\">\n        {/* Title Section */}\n        {title && <Text className=\"text-xl font-bold text-phase-text-primary mb-4\">{title}</Text>}\n\n        {/* Children Content */}\n        <Box className=\"gap-4\">{children}</Box>\n\n        {/* Footer Section */}\n        {footer && (\n          <VStack className=\"mt-4 gap-4\">\n            <Box className=\"h-px bg-white/5 opacity-30\" />\n            {footer}\n          </VStack>\n        )}\n      </VStack>\n    </Animated.View>\n  );\n\n  if (onPress || href) {\n    return (\n      <Pressable\n        onPress={onPress}\n        onLongPress={onLongPress}\n        onPressIn={handlePressIn}\n        onPressOut={handlePressOut}\n        onHoverIn={Platform.OS === 'web' ? () => setHovered(true) : undefined}\n        onHoverOut={Platform.OS === 'web' ? () => setHovered(false) : undefined}\n        accessibilityRole={href ? 'link' : 'button'}\n        accessibilityLabel={accessibilityLabel}\n        // @ts-ignore - RN Pressable web props\n        href={href}\n        // @ts-ignore\n        hrefAttrs={{\n          target: target,\n          rel: target === '_blank' ? 'noopener noreferrer' : undefined,\n        }}\n      >\n        {content}\n      </Pressable>\n    );\n  }\n\n  return content;\n};\n\nexport default SanctuaryCard;\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\Naween\\projects\\polymath-platform\\packages\\ui\\src\\components\\SanctuaryCarousel.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\Naween\\projects\\polymath-platform\\packages\\ui\\src\\components\\SanctuaryChip.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'Box' is defined but never used.","line":3,"column":10,"nodeType":"Identifier","messageId":"unusedVar","endLine":3,"endColumn":13,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"Box"},"fix":{"range":[78,82],"text":""},"desc":"Remove unused variable \"Box\"."}]}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React from 'react';\nimport { Pressable } from 'react-native';\nimport { Box, Text } from '../gluestack';\n\nexport interface SanctuaryChipProps {\n  label: string;\n  selected?: boolean;\n  onPress?: () => void;\n  variant?: 'filter' | 'tag' | 'category';\n  size?: 'sm' | 'md';\n  className?: string;\n}\n\n/**\n * SanctuaryChip - canonical chip/pill component for filters, tags, and categories.\n * Uses the phase token hierarchy so the chip always resolves against the\n * current interactive layer rather than hardcoded glass colors.\n */\nexport const SanctuaryChip: React.FC<SanctuaryChipProps> = ({\n  label,\n  selected = false,\n  onPress,\n  variant = 'filter',\n  size = 'md',\n  className,\n}) => {\n  const isSmall = size === 'sm';\n\n  return (\n    <Pressable\n      onPress={onPress}\n      accessibilityRole=\"button\"\n      accessibilityState={{ selected }}\n      className={`\n                mr-2 border rounded-full\n                ${isSmall ? 'px-3 py-0.5' : 'px-4 py-1'}\n                ${\n                  selected\n                    ? 'bg-phase-accent border-phase-accent'\n                    : 'bg-phase-surface border-white/10'\n                }\n                ${className || ''}\n            `}\n    >\n      <Text\n        className={`\n                    ${isSmall ? 'text-xs' : 'text-sm'}\n                    ${selected ? 'text-white font-bold' : 'text-phase-text-secondary font-medium'}\n                `}\n        numberOfLines={1}\n      >\n        {variant === 'tag' ? `#${label}` : label}\n      </Text>\n    </Pressable>\n  );\n};\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\Naween\\projects\\polymath-platform\\packages\\ui\\src\\components\\SanctuaryFlashList.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'colors' is assigned a value but never used.","line":49,"column":9,"nodeType":"Identifier","messageId":"unusedVar","endLine":49,"endColumn":15},{"ruleId":"@typescript-eslint/no-explicit-any","severity":1,"message":"Unexpected any. Specify a different type.","line":56,"column":47,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":56,"endColumn":50,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[1889,1892],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[1889,1892],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":1,"message":"Unexpected any. Specify a different type.","line":71,"column":21,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":71,"endColumn":24,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[2204,2207],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[2204,2207],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":3,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { useCallback } from 'react';\nimport { RefreshControl, StyleProp, ViewStyle } from 'react-native';\nimport { FlashList, FlashListProps } from '@shopify/flash-list';\nimport { Theme } from '../theme/Theme';\nimport { useThemedColors } from '../hooks/useThemedColors';\nimport EmptyState from './EmptyState';\nimport { BookOpen } from 'lucide-react-native';\n\nexport interface SanctuaryFlashListProps<T> extends Omit<FlashListProps<T>, 'refreshControl'> {\n  /** Estimated size of a single list item (RECOGNIZED BY RECYCLER) */\n  estimatedItemSize: number;\n  /** Whether the list is currently refreshing */\n  refreshing?: boolean;\n  /** Function to call when refreshing */\n  onRefresh?: () => void;\n  /** Optional empty state content */\n  emptyComponent?: React.ReactElement;\n  /** Color of the refresh spinner */\n  refreshColor?: string;\n  /** Style for the content container */\n  contentContainerStyle?: StyleProp<ViewStyle>;\n}\n\n/**\n * SanctuaryFlashList - A high-performance list component optimized for component recycling.\n *\n * Philosophy: Performance is silent but essential for presence.\n * This component wraps @shopify/flash-list with Sanctuary-themed defaults.\n *\n * @example\n * <SanctuaryFlashList\n *   data={resources}\n *   renderItem={({ item }) => <ResourceRow resource={item} />}\n *   estimatedItemSize={Theme.listSizes.resourceRow}\n * />\n */\nexport function SanctuaryFlashList<T>({\n  data,\n  renderItem,\n  estimatedItemSize,\n  refreshing = false,\n  onRefresh,\n  emptyComponent,\n  refreshColor,\n  contentContainerStyle,\n  ListEmptyComponent,\n  ...props\n}: SanctuaryFlashListProps<T>) {\n  const colors = useThemedColors();\n\n  const renderEmpty = useCallback(() => {\n    if (emptyComponent) return emptyComponent;\n\n    if (ListEmptyComponent) {\n      if (React.isValidElement(ListEmptyComponent)) return ListEmptyComponent;\n      const EmptyComp = ListEmptyComponent as any;\n      return <EmptyComp />;\n    }\n\n    return (\n      <EmptyState\n        icon={BookOpen}\n        title=\"Silence in the Sanctuary\"\n        description=\"Your first discovery is waiting to be found here.\"\n      />\n    );\n  }, [emptyComponent, ListEmptyComponent]);\n\n  return (\n    <FlashList\n      {...(props as any)}\n      data={data}\n      renderItem={renderItem}\n      estimatedItemSize={estimatedItemSize}\n      ListEmptyComponent={renderEmpty}\n      contentContainerStyle={[{ paddingBottom: Theme.spacing.xl }, contentContainerStyle]}\n      refreshControl={\n        onRefresh ? (\n          <RefreshControl\n            refreshing={refreshing}\n            onRefresh={onRefresh}\n            tintColor={refreshColor || Theme.colors.sanctuarySaffron}\n            colors={[refreshColor || Theme.colors.sanctuarySaffron]}\n          />\n        ) : undefined\n      }\n    />\n  );\n}\n\nexport default SanctuaryFlashList;\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\Naween\\projects\\polymath-platform\\packages\\ui\\src\\components\\SanctuaryFlashList.web.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'colors' is assigned a value but never used.","line":33,"column":9,"nodeType":"Identifier","messageId":"unusedVar","endLine":33,"endColumn":15},{"ruleId":"@typescript-eslint/no-explicit-any","severity":1,"message":"Unexpected any. Specify a different type.","line":40,"column":47,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":40,"endColumn":50,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[1471,1474],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[1471,1474],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":1,"message":"Unexpected any. Specify a different type.","line":55,"column":21,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":55,"endColumn":24,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[1785,1788],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[1785,1788],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]}],"suppressedMessages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'_estimatedItemSize' is defined but never used.","line":24,"column":22,"nodeType":"Identifier","messageId":"unusedVar","endLine":24,"endColumn":40,"suppressions":[{"kind":"directive","justification":""}]}],"errorCount":0,"fatalErrorCount":0,"warningCount":3,"fixableErrorCount":0,"fixableWarningCount":0,"source":"/**\n * Web fallback for SanctuaryFlashList.\n *\n * @shopify/flash-list is optimised for native recycler views and does not have\n * reliable web support.  On web Metro resolves this .web.tsx file instead of\n * SanctuaryFlashList.tsx, swapping FlashList for React Native's built-in\n * FlatList which works correctly on all platforms.\n *\n * The public API (props) is kept identical so every call site compiles without\n * changes.\n */\nimport React, { useCallback } from 'react';\nimport { FlatList, RefreshControl, StyleProp, ViewStyle } from 'react-native';\nimport { Theme } from '../theme/Theme';\nimport { useThemedColors } from '../hooks/useThemedColors';\nimport EmptyState from './EmptyState';\nimport { BookOpen } from 'lucide-react-native';\nimport type { SanctuaryFlashListProps } from './SanctuaryFlashList';\n\nfunction SanctuaryFlashListWeb<T>({\n  data,\n  renderItem,\n  // eslint-disable-next-line @typescript-eslint/no-unused-vars\n  estimatedItemSize: _estimatedItemSize, // API compatibility only - FlatList doesn't require it\n  refreshing = false,\n  onRefresh,\n  emptyComponent,\n  refreshColor,\n  contentContainerStyle,\n  ListEmptyComponent,\n  ...props\n}: SanctuaryFlashListProps<T>) {\n  const colors = useThemedColors();\n\n  const renderEmpty = useCallback(() => {\n    if (emptyComponent) return emptyComponent;\n\n    if (ListEmptyComponent) {\n      if (React.isValidElement(ListEmptyComponent)) return ListEmptyComponent;\n      const EmptyComp = ListEmptyComponent as any;\n      return <EmptyComp />;\n    }\n\n    return (\n      <EmptyState\n        icon={BookOpen}\n        title=\"Silence in the Sanctuary\"\n        description=\"Your first discovery is waiting to be found here.\"\n      />\n    );\n  }, [emptyComponent, ListEmptyComponent]);\n\n  return (\n    <FlatList\n      {...(props as any)}\n      data={data}\n      renderItem={renderItem}\n      ListEmptyComponent={renderEmpty}\n      contentContainerStyle={[\n        { paddingBottom: Theme.spacing.xl },\n        contentContainerStyle as StyleProp<ViewStyle>,\n      ]}\n      refreshControl={\n        onRefresh ? (\n          <RefreshControl\n            refreshing={refreshing}\n            onRefresh={onRefresh}\n            tintColor={refreshColor || Theme.colors.sanctuarySaffron}\n            colors={[refreshColor || Theme.colors.sanctuarySaffron]}\n          />\n        ) : undefined\n      }\n    />\n  );\n}\n\nexport default SanctuaryFlashListWeb;\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\Naween\\projects\\polymath-platform\\packages\\ui\\src\\components\\SanctuaryGlobalStyles.tsx","messages":[{"ruleId":"react-hooks/rules-of-hooks","severity":1,"message":"React Hook \"useTheme\" is called conditionally. React Hooks must be called in the exact same order in every component render.","line":1035,"column":7,"nodeType":"Identifier","endLine":1035,"endColumn":15},{"ruleId":"react-hooks/rules-of-hooks","severity":1,"message":"React Hook \"React.useRef\" is called conditionally. React Hooks must be called in the exact same order in every component render. Did you accidentally call a React Hook after an early return?","line":1187,"column":29,"nodeType":"MemberExpression","endLine":1187,"endColumn":41},{"ruleId":"react-hooks/rules-of-hooks","severity":1,"message":"React Hook \"React.useInsertionEffect\" is called conditionally. React Hooks must be called in the exact same order in every component render. Did you accidentally call a React Hook after an early return?","line":1188,"column":3,"nodeType":"MemberExpression","endLine":1188,"endColumn":27},{"ruleId":"react-hooks/rules-of-hooks","severity":1,"message":"React Hook \"React.useInsertionEffect\" is called conditionally. React Hooks must be called in the exact same order in every component render. Did you accidentally call a React Hook after an early return?","line":1201,"column":3,"nodeType":"MemberExpression","endLine":1201,"endColumn":27}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":4,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React from 'react';\nimport { Platform } from 'react-native';\nimport { useTheme } from '../hooks/useTheme';\nimport { hexToRgba } from '../utils/colorUtils';\n\n/**\n * SanctuaryGlobalStyles (Web-only)\n *\n * Injects global CSS for the web platform.  Consumes the full adaptive\n * token set from useTheme() \\u2014 including WCAG-computed textOnAccent /\n * textOnReward \\u2014 so that text colors automatically adapt whenever the\n * temporal phase changes the active accent (Saffron \\u2192 Sage \\u2192 Blue \\u2192 Gold).\n */\nconst STATIC_CSS = `\n    /* \\u2500\\u2500 RESET \\u2500\\u2500 */\n    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; outline: none !important; }\n    body {\n      font-family: var(--font-body); \n      color: var(--ink); \n      /* overflow: clip (not hidden) \\u2014 doesn't create a scroll container,\n         so browser scroll restoration and URL-hash navigation work correctly.\n         All actual scrolling is handled by .sanctuary-screen (overflow-y: auto). */\n      overflow: clip; \n      overscroll-behavior-y: none;\n      -webkit-font-smoothing: antialiased;\n      -moz-osx-font-smoothing: grayscale;\n      background:\n        radial-gradient(circle at 18% 18%, var(--action-soft), transparent 32%),\n        radial-gradient(circle at 82% 12%, var(--reward-soft), transparent 28%),\n        var(--world-bg);\n    }\n    button { background: none; border: none; cursor: pointer; font-family: inherit; transition: var(--transition-snap); }\n\n    /* \\u2500\\u2500 APP SHELL (Flexbox Architecture) \\u2500\\u2500 */\n    .vellum-app-shell {\n      display: flex;\n      flex-direction: column;\n      height: 100vh;\n      width: 100vw;\n      position: relative;\n      z-index: 10;\n    }\n\n    .shell-body-core {\n      display: flex;\n      flex-direction: row;\n      flex: 1;\n      overflow: hidden;\n      position: relative;\n    }\n\n    /* \\u2500\\u2500 WORLD BACKGROUND (VELLUM) \\u2500\\u2500 */\n    .world-bg {\n      position: fixed;\n      inset: 0;\n      z-index: -1;\n      background: var(--world-bg);\n    }\n    \n    /* Vellum Grain / Noise Overlay for World */\n    .world-bg::after {\n      content: '';\n      position: absolute;\n      inset: 0;\n      background: radial-gradient(circle at 70% 30%, var(--water-soft), transparent 60%),\n                  radial-gradient(circle at 20% 80%, var(--lotus-soft), transparent 50%);\n      opacity: 0.3;\n      filter: blur(60px);\n      z-index: 1;\n    }\n\n    /* \\u2500\\u2500 TOP BAR \\u2500\\u2500 */\n    .top-bar {\n      height: var(--top-bar-h);\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      padding: 0 24px;\n      flex-shrink: 0;\n      z-index: 1100;\n\n      background: var(--topbar-bg);\n      backdrop-filter: blur(40px) saturate(1.35);\n      -webkit-backdrop-filter: blur(40px) saturate(1.35);\n      border-bottom: 1px solid var(--scene-chrome-border);\n      box-shadow: 0 10px 32px rgba(107,100,128,0.08);\n    }\n\n    .top-bar-left {\n      display: flex;\n      align-items: center;\n      gap: 12px;\n    }\n    .brand-lotus { font-size: 24px; filter: drop-shadow(0 0 10px rgba(90, 154, 186, 0.4)); }\n    .brand-name { \n      font-weight: 800; \n      font-size: 18px; \n      letter-spacing: -0.5px;\n      background: linear-gradient(135deg, var(--ink), var(--water));\n      -webkit-background-clip: text;\n      -webkit-text-fill-color: transparent;\n      font-family: var(--font-display);\n      font-style: italic;\n    }\n\n    /* \\u2500\\u2500 SIDEBAR \\u2500\\u2500 */\n    .sidebar {\n      width: var(--sidebar-w);\n      display: flex;\n      flex-direction: column;\n      padding: 0;\n      flex-shrink: 0;\n      z-index: 1000;\n      transition: width 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);\n      overflow: hidden;\n\n      background: var(--sidebar-bg);\n      /* Reduced blur (16px) vs topbar (28px) \\u2014 avoids stacking two heavy\n         backdrop-filter compositing layers on mid-range Android devices. */\n      backdrop-filter: blur(36px) saturate(1.2);\n      -webkit-backdrop-filter: blur(36px) saturate(1.2);\n      border-right: 1px solid var(--scene-chrome-border);\n    }\n    .sidebar.collapsed { width: 64px; }\n    .sidebar.collapsed .sidebar-item { justify-content: center; padding: 12px 0; gap: 0; width: 100%; }\n    .sidebar.collapsed .sidebar-header { justify-content: center; padding: 0; }\n    .sidebar.collapsed .sidebar-profile-btn { justify-content: center; padding: 0; border-radius: 50%; width: 48px; height: 48px; margin: 12px auto; }\n    .sidebar.collapsed .sidebar-group-label { display: none; }\n    .sidebar.collapsed .sidebar-label { display: none; }\n\n    .sidebar-header {\n      height: var(--top-bar-h);\n      display: flex;\n      align-items: center;\n      padding: 0 16px;\n      border-bottom: 1px solid var(--scene-chrome-border);\n    }\n\n    .sidebar-toggle {\n      width: 40px;\n      height: 40px;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      border-radius: 10px;\n      background: var(--scene-interactive);\n      border: 1px solid var(--scene-interactive-border);\n      color: var(--ink-soft);\n      cursor: pointer;\n      transition: var(--transition-smooth);\n    }\n    .sidebar-toggle:hover {\n      background: var(--scene-elevated);\n      transform: scale(1.1);\n    }\n\n    .sidebar-group-label {\n      font-size: 10px;\n      font-weight: 800;\n      color: var(--ink-ghost);\n      text-transform: uppercase;\n      letter-spacing: 1px;\n    }\n\n    .sidebar-nav {\n      flex: 1;\n      padding: 24px 16px;\n      display: flex;\n      flex-direction: column;\n      gap: 6px;\n    }\n\n    .sidebar-item {\n      display: flex;\n      align-items: center;\n      gap: 16px;\n      padding: 12px;\n      border-radius: 12px;\n      font-size: 14px;\n      color: var(--ink-ghost);\n      transition: var(--transition-smooth);\n      width: 100%;\n      position: relative;\n    }\n    .sidebar-item:hover {\n      color: var(--ink-soft);\n      background: var(--scene-interactive);\n      transform: translateX(8px);\n    }\n    .sidebar-item.active {\n      color: var(--water);\n      background: linear-gradient(135deg, var(--scene-elevated), var(--scene-interactive));\n      box-shadow: 0 10px 24px rgba(107,100,128,0.10);\n    }\n    .sidebar-item::before {\n      content: '';\n      position: absolute;\n      left: 0;\n      top: 30%;\n      height: 40%;\n      width: 3px;\n      background: var(--water);\n      border-radius: 0 4px 4px 0;\n      opacity: 0;\n      transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);\n      transform: scaleY(0.4);\n    }\n    .sidebar-item.active::before {\n      opacity: 1;\n      transform: scaleY(1);\n    }\n    .sidebar.collapsed .sidebar-item::before {\n      left: 2px;\n    }\n\n    .sidebar-footer {\n      padding: 16px;\n      display: flex;\n      flex-direction: column;\n      gap: 8px;\n    }\n    .sidebar-divider {\n      height: 1px;\n      background: rgba(0, 0, 0, 0.05);\n      margin-bottom: 8px;\n    }\n\n    .sidebar-profile-btn {\n      display: flex;\n      align-items: center;\n      gap: 12px;\n      padding: 12px;\n      border-radius: 16px;\n      background: var(--scene-interactive);\n      border: 1px solid var(--scene-interactive-border);\n      cursor: pointer;\n      width: 100%;\n      text-align: left;\n      transition: all 0.2s ease;\n    }\n    .sidebar-profile-btn:hover {\n      transform: translateY(-2px);\n      background: var(--scene-elevated);\n      box-shadow: var(--shadow-sm);\n    }\n\n    .profile-info {\n      display: flex;\n      flex-direction: column;\n      overflow: hidden;\n    }\n    .profile-nm { font-weight: 700; color: var(--ink); font-size: 14px; white-space: nowrap; }\n    .profile-status { font-size: 10px; color: var(--water); font-weight: 800; text-transform: uppercase; }\n\n    .bell-dot {\n      position: absolute;\n      top: -2px;\n      right: -2px;\n      width: 8px;\n      height: 8px;\n      background: var(--lotus);\n      border-radius: 50%;\n      border: 1.5px solid white;\n    }\n\n    /* \\u2500\\u2500 CARDS (THE HEART OF THE DEPTH) \\u2500\\u2500 */\n    .sanctuary-card {\n      position: relative;\n      border-radius: 20px;\n      overflow: hidden;\n      background:\n        linear-gradient(165deg, rgba(var(--surface-rgb), 0.94) 0%, rgba(var(--surface-rgb), 0.84) 100%);\n      backdrop-filter: blur(36px) saturate(1.18);\n      -webkit-backdrop-filter: blur(36px) saturate(1.18);\n      border: 1px solid var(--scene-surface-border);\n      box-shadow: \n        inset 0 1px 0 rgba(252,249,242,0.34),\n        inset 0 -18px 32px rgba(107,100,128,0.03),\n        0 12px 32px rgba(107,100,128,0.08),\n        0 22px 48px rgba(var(--action-rgb), 0.05);\n      transition: var(--transition-smooth);\n      will-change: transform;\n    }\n\n    .sanctuary-card:hover {\n      transform: translateY(-6px);\n      background:\n        linear-gradient(165deg, var(--card-bg-hover) 0%, var(--scene-surface) 100%);\n      box-shadow: \n        inset 0 1px 0 rgba(252,249,242,0.42),\n        0 24px 48px rgba(107,100,128,0.14),\n        0 14px 28px rgba(var(--action-rgb), 0.08);\n    }\n\n    /* Texture Overlay on Cards */\n    .sanctuary-card::after {\n      content: '';\n      position: absolute; inset: 0;\n      /* Refined vellum texture: softened frequency and reduced opacity for organic soul */\n      background-image: url(\"data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E\");\n      opacity: 0.018;\n      pointer-events: none;\n      z-index: 1;\n      mix-blend-mode: overlay;\n    }\n    /* Glass System - Premium Frosted Effects */\n    .sanctuary-glass-hub {\n      backdrop-filter: blur(24px) saturate(1.8);\n      -webkit-backdrop-filter: blur(24px) saturate(1.8);\n      background: rgba(var(--surface-rgb), 0.78);\n      border-bottom: 1px solid var(--scene-surface-border);\n      z-index: 100;\n    }\n\n    .sanctuary-card.active {\n      border-color: var(--action);\n      background: var(--action-soft);\n      box-shadow: 0 4px 16px var(--action-glow);\n    }\n\n    .sanctuary-sidebar-glass {\n      backdrop-filter: blur(12px);\n      -webkit-backdrop-filter: blur(12px);\n      background: rgba(var(--surface-rgb), 0.52);\n    }\n\n    /* Inner Light Gloss for Card Variants */\n    .card-water::before { content: ''; position: absolute; inset: 0; background: radial-gradient(ellipse at 80% 10%, rgba(90, 154, 186, 0.12) 0%, transparent 60%); pointer-events: none; z-index: 0; }\n    .card-lotus::before { content: ''; position: absolute; inset: 0; background: radial-gradient(ellipse at 80% 10%, rgba(192, 88, 120, 0.1) 0%, transparent 60%); pointer-events: none; z-index: 0; }\n    .card-moss::before  { content: ''; position: absolute; inset: 0; background: radial-gradient(ellipse at 80% 10%, rgba(74, 122, 90, 0.1) 0%, transparent 60%); pointer-events: none; z-index: 0; }\n\n    .card-body-inner {\n      position: relative;\n      z-index: 2;\n      padding: 24px;\n    }\n\n    /* \\u2500\\u2500 BUTTONS \\u2500\\u2500 */\n    .premium-button {\n      display: inline-flex;\n      align-items: center;\n      justify-content: center;\n      gap: 8px;\n      padding: 12px 24px;\n      border-radius: 14px;\n      border: none;\n      cursor: pointer;\n      font-family: var(--font-body);\n      font-size: 14px;\n      font-weight: 700;\n      letter-spacing: 0.01em;\n      background: linear-gradient(135deg, var(--action) 0%, color-mix(in srgb, var(--action) 76%, var(--reward) 24%) 100%);\n      color: var(--text-on-action);\n      box-shadow: 0 10px 28px var(--action-glow);\n      transition: all 0.25s cubic-bezier(0.4,0,0.2,1);\n      white-space: nowrap;\n    }\n    .premium-button:hover {\n      transform: translateY(-2px) scale(1.03);\n      box-shadow: 0 8px 24px var(--action-glow);\n      filter: brightness(1.07);\n    }\n    .premium-button:active { transform: scale(0.97); }\n    .premium-button:disabled { opacity: 0.45; cursor: not-allowed; }\n\n    .secondary-button {\n      display: inline-flex;\n      align-items: center;\n      justify-content: center;\n      gap: 8px;\n      padding: 12px 20px;\n      border-radius: 14px;\n      cursor: pointer;\n      font-family: var(--font-body);\n      font-size: 14px;\n      font-weight: 600;\n      background: linear-gradient(180deg, var(--btn-secondary-bg) 0%, var(--scene-surface) 100%);\n      color: var(--ink);\n      border: 1px solid var(--btn-secondary-border);\n      backdrop-filter: blur(36px);\n      -webkit-backdrop-filter: blur(36px);\n      transition: all 0.25s cubic-bezier(0.4,0,0.2,1);\n      white-space: nowrap;\n    }\n    .secondary-button:hover {\n      background: var(--btn-secondary-hover);\n      transform: translateY(-1px);\n      box-shadow: var(--shadow-sm);\n    }\n\n    /* \\u2500\\u2500 INTERACTIVE CARD \\u2500\\u2500 */\n    .sanctuary-card.interactive {\n      cursor: pointer;\n    }\n    .sanctuary-card.interactive:hover {\n      transform: translateY(-6px) scale(1.012);\n    }\n\n    /* \\u2500\\u2500 SIDEBAR LABEL \\u2500\\u2500 */\n    .sidebar-label {\n      font-size: 14px;\n      font-weight: 500;\n      letter-spacing: 0.01em;\n      white-space: nowrap;\n      overflow: hidden;\n      text-overflow: ellipsis;\n    }\n\n    /* \\u2500\\u2500 PROFILE GEM \\u2500\\u2500 */\n    .profile-gem {\n      width: 36px;\n      height: 36px;\n      border-radius: 50%;\n      background: var(--profile-gem-bg);\n      border: 1.5px solid var(--profile-gem-border);\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      flex-shrink: 0;\n      transition: transform 0.2s;\n    }\n    .sidebar-profile-btn:hover .profile-gem { transform: scale(1.1); }\n\n    .main-content-canvas {\n      flex: 1;\n      height: 100%;\n      overflow: hidden; /* Lock parent scroll, let children scroll themselves */\n      display: flex;\n      flex-direction: column;\n      position: relative;\n      z-index: 50;\n    }\n\n    .sanctuary-screen {\n      flex: 1;\n      width: 100%;\n      height: 100%;\n      display: flex;\n      flex-direction: column;\n      padding: 40px 48px 60px 48px;\n      overflow-y: auto !important; /* Screen naturally handles its own scrolling */\n      overflow-x: hidden !important;\n      -webkit-overflow-scrolling: touch;\n      box-sizing: border-box;\n      position: relative;\n      animation: fadeIn 0.6s ease-out;\n    }\n\n    .sanctuary-container {\n      max-width: 1400px;\n      margin: 0 auto;\n      width: 100%;\n    }\n\n    /* \\u2500\\u2500 GREETING & TYPOGRAPHY \\u2500\\u2500 */\n    .greeting {\n      margin-bottom: 48px;\n    }\n    .greeting-main {\n      font-family: var(--font-display);\n      font-size: clamp(28px, 3.5vw, 48px);\n      font-style: italic;\n      color: var(--ink);\n      line-height: 1.1;\n      margin-bottom: 12px;\n      text-shadow: 0 1px 0 rgba(255,255,255,0.8);\n    }\n    .greeting-time {\n      font-size: 11px;\n      font-weight: 700;\n      text-transform: uppercase;\n      letter-spacing: 0.12em;\n      color: var(--action);\n      margin-bottom: 8px;\n      opacity: 0.85;\n    }\n    .greeting-note {\n      font-size: 18px;\n      color: var(--ink-soft);\n      font-weight: 300;\n      letter-spacing: 0.01em;\n    }\n\n    /* \\u2500\\u2500 FILTER TABS (top-tab) \\u2500\\u2500 */\n    .top-tab {\n      display: inline-flex;\n      align-items: center;\n      gap: 6px;\n      padding: 8px 16px;\n      border-radius: 100px;\n      font-size: 13px;\n      font-weight: 600;\n      letter-spacing: 0.01em;\n      color: var(--ink-soft);\n      background: var(--tab-bg);\n      border: 1.5px solid transparent;\n      transition: all 0.18s ease;\n      white-space: nowrap;\n      font-family: var(--font-body);\n    }\n    .top-tab:hover {\n      background: var(--tab-bg-hover);\n      color: var(--ink);\n    }\n    .top-tab.active {\n      background: linear-gradient(135deg, var(--tab-active-bg), var(--action-soft));\n      border-color: var(--action-border);\n      color: var(--action);\n      box-shadow: 0 8px 20px rgba(var(--action-rgb), 0.10);\n    }\n\n    .sanctuary-search-shell {\n      display: flex;\n      align-items: center;\n      gap: 12px;\n      padding: 12px 16px;\n      border-radius: 16px;\n      border: 1px solid var(--scene-interactive-border);\n      background:\n        linear-gradient(180deg, var(--scene-elevated) 0%, var(--scene-interactive) 100%);\n      backdrop-filter: blur(36px) saturate(1.14);\n      -webkit-backdrop-filter: blur(36px) saturate(1.14);\n      box-shadow: inset 0 1px 0 rgba(252,249,242,0.28), 0 10px 24px rgba(107,100,128,0.05);\n    }\n    .sanctuary-search-shell input {\n      flex: 1;\n      border: none;\n      background: transparent;\n      color: var(--ink);\n      font-family: var(--font-body);\n      font-size: 14px;\n      outline: none;\n    }\n    .sanctuary-icon-well {\n      display: inline-flex;\n      align-items: center;\n      justify-content: center;\n      width: 44px;\n      height: 44px;\n      border-radius: 16px;\n      background: linear-gradient(180deg, var(--action-soft), rgba(var(--reward-rgb), 0.08));\n      border: 1px solid rgba(var(--action-rgb), 0.16);\n      color: var(--action);\n      box-shadow: inset 0 1px 0 rgba(252,249,242,0.2);\n    }\n    .sanctuary-icon-well.soft {\n      width: 52px;\n      height: 52px;\n      border-radius: 20px;\n    }\n    .sanctuary-hero-panel {\n      position: relative;\n      overflow: hidden;\n      border-radius: 28px;\n      background:\n        linear-gradient(180deg, rgba(var(--surface-rgb), 0.30) 0%, rgba(42,35,24,0.08) 100%);\n      border: 1px solid var(--scene-surface-border);\n      box-shadow: 0 20px 44px rgba(107,100,128,0.12);\n    }\n    .sanctuary-hero-panel::after {\n      content: '';\n      position: absolute;\n      inset: 0;\n      background:\n        linear-gradient(180deg, transparent 0%, rgba(42,35,24,0.18) 48%, rgba(42,35,24,0.78) 100%);\n      pointer-events: none;\n    }\n    .sanctuary-map-stage {\n      border-radius: 24px;\n      border: 1px solid var(--scene-surface-border);\n      background:\n        radial-gradient(circle at 20% 18%, var(--action-soft), transparent 28%),\n        radial-gradient(circle at 78% 14%, var(--reward-soft), transparent 24%),\n        linear-gradient(180deg, var(--scene-elevated) 0%, var(--scene-surface) 100%);\n      overflow: hidden;\n    }\n    .status-pill {\n      display: inline-flex;\n      align-items: center;\n      gap: 4px;\n      padding: 3px 8px;\n      border-radius: 999px;\n      font-size: 10px;\n      font-weight: 700;\n      letter-spacing: 0.08em;\n      text-transform: uppercase;\n      background: var(--action-soft);\n      color: var(--action);\n      border: 1px solid rgba(var(--action-rgb), 0.18);\n    }\n\n    /* \\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\n       ADAPTIVE COLOUR UTILITY CLASSES\n       These classes automatically adapt when the temporal phase changes\n       the active accent colour (Saffron \\u2192 Sage \\u2192 Blue \\u2192 Gold etc.).\n       Text colours are WCAG-computed so contrast is always \\u2265 4.5 : 1.\n    \\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500 */\n\n    /* Solid accent background \\u2014 text colour auto-adapts */\n    .action-bg {\n      background: var(--action);\n      color: var(--text-on-action);\n    }\n    .action-bg-soft {\n      background: var(--action-soft);\n      color: var(--action);\n    }\n\n    /* Solid reward background \\u2014 text colour auto-adapts */\n    .reward-bg {\n      background: var(--reward);\n      color: var(--text-on-reward);\n    }\n    .reward-bg-soft {\n      background: var(--reward-soft);\n      color: var(--reward);\n    }\n\n    /* Danger background */\n    .danger-bg {\n      background: var(--danger);\n      color: var(--text-on-danger);\n    }\n    .danger-bg-soft {\n      background: var(--danger-soft);\n      color: var(--danger);\n    }\n\n    /* Phase-aware glass chip (small tag / badge) */\n    .glass-chip {\n      display: inline-flex;\n      align-items: center;\n      gap: 5px;\n      padding: 3px 10px;\n      border-radius: 100px;\n      font-size: 11px;\n      font-weight: 700;\n      letter-spacing: 0.06em;\n      text-transform: uppercase;\n      background: var(--action-soft);\n      color: var(--action);\n      border: 1px solid var(--action-border);\n    }\n    .glass-chip.reward {\n      background: var(--reward-soft);\n      color: var(--reward);\n      border-color: rgba(var(--reward-rgb), 0.35);\n    }\n    .glass-chip.danger {\n      background: var(--danger-soft);\n      color: var(--danger);\n      border-color: rgba(255,99,71,0.35);\n    }\n    .glass-chip.neutral {\n      background: var(--tab-bg);\n      color: var(--ink-soft);\n      border-color: var(--border);\n    }\n\n    /* Stat chip \\u2014 metric pill used in dashboards */\n    .stat-chip {\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      gap: 2px;\n      padding: 12px 16px;\n      border-radius: 14px;\n      background: var(--action-soft);\n      border: 1px solid var(--action-border);\n    }\n    .stat-chip .stat-value {\n      font-size: 22px;\n      font-weight: 800;\n      color: var(--action);\n      line-height: 1;\n    }\n    .stat-chip .stat-label {\n      font-size: 10px;\n      font-weight: 600;\n      text-transform: uppercase;\n      letter-spacing: 0.08em;\n      color: var(--ink-ghost);\n    }\n\n    /* Phase-aware focus ring (replaces the hardcoded saffron outline) */\n    *:focus-visible {\n      outline: 2.5px solid var(--action) !important;\n      outline-offset: 3px;\n    }\n\n    /* Phase-aware action button \\u2014 adapts to current phase accent */\n    .action-button {\n      display: inline-flex;\n      align-items: center;\n      gap: 8px;\n      padding: 11px 22px;\n      border-radius: 12px;\n      font-size: 14px;\n      font-weight: 700;\n      letter-spacing: 0.01em;\n      background: var(--action);\n      color: var(--text-on-action);\n      border: none;\n      cursor: pointer;\n      transition: transform 0.15s ease, box-shadow 0.15s ease, opacity 0.15s ease;\n      font-family: var(--font-body);\n    }\n    .action-button:hover {\n      transform: translateY(-1px);\n      box-shadow: 0 6px 20px var(--action-glow);\n    }\n    .action-button:active { transform: scale(0.97); }\n    .action-button:disabled { opacity: 0.45; cursor: not-allowed; }\n\n    /* Outline variant of action button */\n    .action-button.outline {\n      background: var(--action-soft);\n      color: var(--action);\n      border: 1.5px solid var(--action-border);\n    }\n    .action-button.outline:hover {\n      background: var(--action-medium);\n    }\n\n    /* Ghost button \\u2014 subtle, no fill, used for secondary actions (e.g. \"Mark all read\") */\n    .sanctuary-button-ghost {\n      display: inline-flex;\n      align-items: center;\n      gap: 6px;\n      padding: 8px 16px;\n      border-radius: 10px;\n      font-size: 13px;\n      font-weight: 600;\n      color: var(--ink-ghost);\n      background: transparent;\n      border: 1px solid var(--border);\n      cursor: pointer;\n      transition: all 0.18s ease;\n      font-family: var(--font-body);\n    }\n    .sanctuary-button-ghost:hover {\n      background: var(--background-alt);\n      color: var(--ink);\n      border-color: var(--action-border);\n    }\n    .sanctuary-button-ghost:active { transform: scale(0.97); }\n\n    /* \\u2500\\u2500 LAYOUT UTILS \\u2500\\u2500 */\n    .sub-view-container {\n      display: grid;\n      grid-template-columns: minmax(0, 1fr) 340px;\n      gap: 32px;\n      animation: fadeIn 0.6s ease-out;\n    }\n\n    @media (max-width: 1200px) {\n      .sub-view-container {\n        grid-template-columns: 1fr;\n      }\n      .sanctuary-screen {\n        padding: 40px 24px;\n      }\n    }\n\n    @keyframes fadeIn {\n      from { opacity: 0; transform: translateY(10px); }\n      to { opacity: 1; transform: translateY(0); }\n    }\n\n    .content-scroll-area {\n      flex: 1;\n      overflow-y: visible;\n      min-height: min-content;\n    }\n\n    /* \\u2500\\u2500 SCROLLBAR \\u2500\\u2500 */\n    ::-webkit-scrollbar { width: 6px; height: 6px; }\n    ::-webkit-scrollbar-track { background: transparent; }\n    ::-webkit-scrollbar-thumb {\n      background: rgba(160, 150, 130, 0.2);\n      border-radius: 10px;\n    }\n    ::-webkit-scrollbar-thumb:hover { background: rgba(160, 150, 130, 0.4); }\n\n    /* \\u2500\\u2500 COMMUNITY LAYOUT \\u2500\\u2500 */\n    .community-grid {\n      display: grid;\n      grid-template-columns: 200px 1fr 340px;\n      gap: 32px;\n      align-items: start;\n    }\n\n    .community-sidebar {\n      position: sticky;\n      top: 0;\n      display: flex;\n      flex-direction: column;\n      gap: 24px;\n    }\n\n    .community-feed {\n      display: flex;\n      flex-direction: column;\n      gap: 24px;\n      min-width: 0;\n    }\n\n    .community-panel {\n      position: sticky;\n      top: 0;\n      display: flex;\n      flex-direction: column;\n      gap: 32px;\n    }\n\n    @media (max-width: 1200px) {\n      .community-grid {\n        grid-template-columns: 1fr;\n        gap: 24px;\n      }\n      .community-sidebar,\n      .community-panel {\n        display: none;\n      }\n      .community-sub-nav {\n        display: flex !important;\n      }\n    }\n\n    /* \\u2500\\u2500 SUB-NAV (Horizontal Tabs) \\u2500\\u2500 */\n    .community-sub-nav {\n      display: none;\n      gap: 8px;\n      margin-bottom: 24px;\n      padding: 6px;\n      background: linear-gradient(180deg, var(--scene-elevated) 0%, var(--scene-interactive) 100%);\n      backdrop-filter: blur(36px) saturate(1.12);\n      -webkit-backdrop-filter: blur(36px) saturate(1.12);\n      border-radius: 18px;\n      border: 1px solid var(--scene-interactive-border);\n    }\n    .sub-nav-item {\n      flex: 1;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      gap: 10px;\n      padding: 12px;\n      border-radius: 12px;\n      font-size: 14px;\n      font-weight: 600;\n      color: var(--ink-ghost);\n      transition: all 0.25s cubic-bezier(0.175, 0.885, 0.32, 1.275);\n    }\n    .sub-nav-item.active {\n      background: linear-gradient(180deg, var(--scene-elevated) 0%, var(--scene-surface) 100%);\n      color: var(--action);\n      box-shadow: 0 8px 24px rgba(var(--action-rgb), 0.12);\n      transform: scale(1.02);\n    }\n    .sub-nav-item:hover:not(.active) {\n      background: var(--scene-interactive);\n      color: var(--ink-soft);\n    }\n\n    /* \\u2500\\u2500 SUB-NAV-TABS (3rd Level) \\u2500\\u2500 */\n    .sub-nav-tabs-container {\n      display: flex;\n      align-items: center;\n      gap: 12px;\n      margin-bottom: 24px;\n      padding-bottom: 8px;\n      border-bottom: 1px solid rgba(0,0,0,0.05);\n    }\n    .sub-nav-tab {\n      display: flex;\n      align-items: center;\n      gap: 8px;\n      padding: 8px 20px;\n      border-radius: 100px;\n      font-size: 13px;\n      font-weight: 600;\n      color: var(--ink-ghost);\n      background: rgba(0, 0, 0, 0.03);\n      border: 1px solid transparent;\n      transition: all 0.2s ease;\n    }\n    .sub-nav-tab.active {\n      background: var(--water-soft);\n      color: var(--water);\n      border-color: var(--water-glow);\n    }\n    .sub-nav-tab:hover:not(.active) {\n      background: rgba(0, 0, 0, 0.06);\n      color: var(--ink-soft);\n    }\n\n    /* \\u2500\\u2500 RESPONSIVE \\u2014 TABLET (768\\u20131023px) \\u2500\\u2500 */\n    @media (max-width: 1023px) {\n      .sidebar {\n        transform: translateX(-100%);\n        position: fixed;\n        height: 100%;\n        z-index: 1000;\n        width: 280px !important;\n        transition: transform 0.35s cubic-bezier(0.4,0,0.2,1);\n      }\n      .sidebar.open {\n        transform: translateX(0);\n      }\n      .sanctuary-screen {\n        padding: 32px 20px 100px 20px;\n      }\n      .greeting-main { font-size: 36px; }\n      .greeting-note  { font-size: 15px; }\n      .sub-view-container {\n        grid-template-columns: 1fr;\n        gap: 24px;\n      }\n      .community-grid {\n        grid-template-columns: 1fr;\n        gap: 20px;\n      }\n      .community-sidebar,\n      .community-panel {\n        display: none;\n      }\n      .community-sub-nav { display: flex !important; }\n    }\n\n    /* \\u2500\\u2500 RESPONSIVE \\u2014 MOBILE (< 768px) \\u2500\\u2500 */\n    @media (max-width: 767px) {\n      .sanctuary-screen {\n        padding: 20px 14px 88px 14px;\n      }\n      .greeting-main { font-size: 28px; }\n      .greeting-note  { font-size: 13px; }\n      .brand-name     { display: none; }\n      .top-bar        { padding: 0 16px; }\n      .card-body-inner { padding: 16px; }\n      .sub-view-container { gap: 16px; }\n      .premium-button, .secondary-button { padding: 10px 16px; font-size: 13px; }\n    }\n\n    /* \\u2500\\u2500 SIDEBAR OVERLAY (mobile backdrop) \\u2500\\u2500 */\n    .sidebar-overlay {\n      display: none;\n      position: fixed;\n      inset: 0;\n      z-index: 999;\n      background: rgba(42,35,24,0.22);\n      backdrop-filter: blur(2px);\n      -webkit-backdrop-filter: blur(2px);\n      animation: fadeIn 0.2s ease;\n    }\n    .sidebar-overlay.visible { display: block; }\n\n    /* \\u2500\\u2500 MOBILE BOTTOM NAV \\u2500\\u2500 */\n    .mobile-bottom-nav {\n      display: none;\n    }\n    @media (max-width: 1023px) {\n      .mobile-bottom-nav {\n        display: flex;\n        position: fixed;\n        bottom: 0;\n        left: 0;\n        right: 0;\n        height: 72px;\n        z-index: 1100;\n        align-items: center;\n        justify-content: space-around;\n        padding: 0 8px env(safe-area-inset-bottom, 0px) 8px;\n        background: var(--mobile-panel-bg);\n        backdrop-filter: blur(28px) saturate(1.8);\n        -webkit-backdrop-filter: blur(28px) saturate(1.8);\n        border-top: 1px solid rgba(255,255,255,0.2);\n        box-shadow: 0 -4px 24px rgba(107,100,128,0.12);\n      }\n      .mobile-nav-item {\n        flex: 1;\n        display: flex;\n        flex-direction: column;\n        align-items: center;\n        justify-content: center;\n        gap: 4px;\n        padding: 8px 4px;\n        border: none;\n        background: transparent;\n        cursor: pointer;\n        border-radius: 12px;\n        transition: all 0.2s ease;\n      }\n      .mobile-nav-item.active {\n        color: var(--water);\n      }\n      .mobile-nav-item:not(.active) {\n        color: var(--ink-ghost);\n      }\n      .mobile-nav-label {\n        font-size: 10px;\n        font-weight: 700;\n        text-transform: uppercase;\n        letter-spacing: 0.5px;\n        line-height: 1;\n      }\n      .mobile-nav-item.active .mobile-nav-label { color: var(--water); }\n      .mobile-nav-item:not(.active) .mobile-nav-label { color: var(--ink-ghost); }\n    }\n\n    /* \\u2500\\u2500 PWA SAFE AREA \\u2500\\u2500 */\n    @supports (padding: env(safe-area-inset-bottom)) {\n      .sanctuary-screen { padding-bottom: calc(88px + env(safe-area-inset-bottom)); }\n      @media (max-width: 767px) {\n        .sanctuary-screen { padding-bottom: calc(88px + env(safe-area-inset-bottom)); }\n      }\n    }\n`;\n\nexport function SanctuaryGlobalStyles() {\n  if (Platform.OS !== 'web') return null;\n\n  const {\n    accent,\n    text,\n    isDark,\n    gradientNodes,\n    scene,\n    textOnAccent,\n    textOnReward,\n    accentRgb,\n    rewardRgb,\n    surfaceRgb,\n    phase,\n  } = useTheme();\n\n  const dynamicCss = `\n    :root {\n      /* Sanctuary Core Tokens (Dynamic) */\n      --color-background: ${scene.canvas.bg};\n      --color-text-primary: ${text.onCanvas};\n      --color-text-secondary: ${text.secondary};\n      --color-accent: ${accent.action};\n      --color-glass-border: ${scene.surface.border};\n\n      /* Scene hierarchy */\n      --scene-world: ${scene.world.bg};\n      --scene-world-border: ${scene.world.border};\n      --scene-chrome: ${scene.chrome.bg};\n      --scene-chrome-border: ${scene.chrome.border};\n      --scene-canvas: ${scene.canvas.bg};\n      --scene-canvas-border: ${scene.canvas.border};\n      --scene-surface: ${scene.surface.bg};\n      --scene-surface-border: ${scene.surface.border};\n      --scene-elevated: ${scene.elevated.bg};\n      --scene-elevated-border: ${scene.elevated.border};\n      --scene-interactive: ${scene.interactive.bg};\n      --scene-interactive-border: ${scene.interactive.border};\n\n      /* High-Fidelity Design Palette (Vellum/Ink) */\n      --water:       #3a7a9a;\n      --water-glow:  rgba(90,154,186,0.25);\n      --water-soft:  rgba(90,154,186,0.09);\n      --moss:        #4a7a5a;\n      --moss-glow:   rgba(74,122,90,0.25);\n      --moss-soft:   rgba(74,122,90,0.09);\n      --lotus:       #c05878;\n      --lotus-glow:  rgba(192,88,120,0.2);\n      --lotus-soft:  rgba(192,88,120,0.08);\n      --gold:        #a07830;\n      --gold-glow:   rgba(160,120,48,0.2);\n      --ember:       #c04040;\n      --ember-soft:  rgba(192,64,64,0.08);\n      --amber-glow:  #c8803a;\n\n      /* Gurudevi Blue (alias for water) */\n      --gurudevi-blue: #3a7a9a;\n\n      /* Action (Saffron / phase-aware) */\n      --action:             ${accent.action};\n      --action-rgb:         ${accentRgb};\n      --action-soft:        ${hexToRgba(accent.action, 0.09)};\n      --action-medium:      ${hexToRgba(accent.action, 0.18)};\n      --action-glow:        ${hexToRgba(accent.action, 0.28)};\n      --action-border:      ${hexToRgba(accent.action, 0.4)};\n      /* Text that is WCAG-safe on top of --action backgrounds */\n      --text-on-action:     ${textOnAccent};\n      --sanctuary-saffron:  ${accent.action};\n      --sanctuary-saffron-soft: ${hexToRgba(accent.action, 0.09)};\n\n      /* Reward (achievement / celebration \\u2014 phase-aware) */\n      --reward:             ${accent.reward};\n      --reward-rgb:         ${rewardRgb};\n      --reward-soft:        ${hexToRgba(accent.reward, 0.09)};\n      --reward-medium:      ${hexToRgba(accent.reward, 0.18)};\n      --reward-glow:        ${hexToRgba(accent.reward, 0.28)};\n      /* Text that is WCAG-safe on top of --reward backgrounds */\n      --text-on-reward:     ${textOnReward};\n\n      /* Danger */\n      --danger:             #FF6347;\n      --danger-soft:        rgba(255,99,71,0.09);\n      --text-on-danger:     #FCF9F2;\n\n      /* Phase surface gradient nodes (used for ambient tints) */\n      --surface-primary:   ${gradientNodes[0]};\n      --surface-secondary: ${gradientNodes[1]};\n      --surface-tertiary:  ${gradientNodes[2]};\n      --surface-rgb:        ${surfaceRgb};\n\n      /* Full text token set exposed as CSS variables */\n      --text-primary:   ${text.primary};\n      --text-secondary: ${text.secondary};\n      --text-inverse:   ${text.inverse};\n      --text-muted:     ${text.muted};\n      --text-on-world:  ${text.onWorld};\n      --text-on-chrome: ${text.onChrome};\n      --text-on-canvas: ${text.onCanvas};\n      --text-on-surface:${text.onSurface};\n      --text-on-elevated:${text.onElevated};\n      --text-on-interactive:${text.onInteractive};\n      --text-on-danger: ${text.onDanger};\n\n      /* Phase identifier \\u2014 useful for CSS [data-phase=\"morning\"] overrides */\n      --phase: \"${phase}\";\n\n      /* Backgrounds */\n      --background:     ${scene.canvas.bg};\n      --background-alt: ${scene.surface.bg};\n      --surface:        ${scene.surface.bg};\n      --glass-surface:  ${scene.surface.bg};\n      --glass-interact: ${scene.interactive.bg};\n\n      /* World/shell background layers */\n      --world-bg:           linear-gradient(135deg, ${gradientNodes[0]} 0%, ${gradientNodes[1]} 55%, ${gradientNodes[2]} 100%);\n      --topbar-bg:          ${scene.chrome.bg};\n      --sidebar-bg:         ${scene.chrome.bg};\n      --card-bg:            ${scene.surface.bg};\n      --card-bg-hover:      ${scene.elevated.bg};\n      --btn-secondary-bg:   ${scene.interactive.bg};\n      --btn-secondary-border: ${scene.interactive.border};\n      --btn-secondary-hover: ${scene.elevated.bg};\n      --profile-gem-bg:     ${isDark ? 'rgba(255,255,255,0.10)' : 'rgba(58,122,154,0.12)'};\n      --profile-gem-border: ${isDark ? 'rgba(255,255,255,0.15)' : 'rgba(58,122,154,0.20)'};\n      --tab-bg:             ${isDark ? 'rgba(255,255,255,0.06)' : 'rgba(0,0,0,0.04)'};\n      --tab-bg-hover:       ${isDark ? 'rgba(255,255,255,0.10)' : 'rgba(0,0,0,0.07)'};\n      --tab-active-bg:      ${isDark ? 'rgba(58,122,154,0.22)' : 'rgba(58,122,154,0.10)'};\n      --mobile-panel-bg:    ${scene.chrome.bg};\n\n      /* Ink */\n      --ink:         ${text.onCanvas};\n      --ink-soft:    ${text.secondary};\n      --ink-ghost:   #7a7068;\n      --error:       #FF6347;\n\n      /* Borders & Shadows */\n      --border:       ${scene.surface.border};\n      --border-light: rgba(255,255,255,0.7);\n      --shadow-sm:    0 2px 8px rgba(107,100,128,0.07);\n      --shadow-md:    0 8px 24px rgba(107,100,128,0.10);\n      --shadow-lg:    0 16px 48px rgba(107,100,128,0.14);\n\n      /* Typography */\n      --font-display:'IM Fell English', serif;\n      --font-body:   'DM Sans', sans-serif;\n\n      /* Layout */\n      --top-bar-h:   64px;\n      --sidebar-w:   240px;\n      --bp-mobile:   768px;\n      --bp-tablet:   768px;\n      --bp-desktop:  1024px;\n      \n      /* Legacy bridge tokens */\n      --sanctuary-primary: ${gradientNodes[0]};\n      --sanctuary-primary-rgb: ${isDark ? '26, 22, 16' : '245, 237, 214'};\n      --sanctuary-text-primary: ${text.primary};\n      --sanctuary-text-secondary: ${text.secondary};\n\n      /* Motion */\n      --transition-smooth: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);\n      --transition-snap:   all 0.2s cubic-bezier(0.4, 0, 0.2, 1);\n    }\n  `;\n\n  // -- Static CSS: injected once on mount, never re-renders\n  const staticInjectedRef = React.useRef(false);\n  React.useInsertionEffect(() => {\n    if (staticInjectedRef.current) return;\n    staticInjectedRef.current = true;\n    let el = document.getElementById('sanctuary-static-css') as HTMLStyleElement | null;\n    if (!el) {\n      el = document.createElement('style');\n      el.id = 'sanctuary-static-css';\n      el.textContent = STATIC_CSS;\n      document.head.appendChild(el);\n    }\n  }, []);\n\n  // -- Dynamic CSS: only the :root variables block, re-runs on theme change\n  React.useInsertionEffect(() => {\n    let el = document.getElementById('sanctuary-dynamic-css') as HTMLStyleElement | null;