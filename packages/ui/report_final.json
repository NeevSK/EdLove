eId":"react-hooks/refs","severity":1,"message":"Error: Cannot access refs during render\n\nReact refs are values that are not needed for rendering. Refs should only be accessed outside of render, such as in event handlers or effects. Accessing a ref value (the `current` property) during render can cause your component not to update as expected (https://react.dev/reference/react/useRef).\n\nC:\\Users\\Naween\\projects\\polymath-platform\\packages\\ui\\src\\components\\SanctuaryProgressBar.tsx:91:22\n  89 |             {\n  90 |               backgroundColor: isComplete ? '#10B981' : '#F6BF8C', // phase-reward : phase-accent\n> 91 |               width: fillAnim.interpolate({\n     |                      ^^^^^^^^^^^^^^^^^^^^ Passing a ref to a function may read its value during render\n  92 |                 inputRange: [0, 100],\n  93 |                 outputRange: ['0%', '100%'],\n  94 |               }),","line":91,"column":22,"nodeType":null,"endLine":91,"endColumn":42}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":5,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { useEffect, useRef } from 'react';\nimport { View, Text, Animated, StyleSheet, ViewStyle } from 'react-native';\nimport Reanimated, {\n  useSharedValue,\n  useAnimatedStyle,\n  withTiming,\n  withSequence,\n  withRepeat,\n} from 'react-native-reanimated';\nimport { Box, HStack, VStack } from '../gluestack';\n\nexport interface SanctuaryProgressBarProps {\n  percentage: number; // 0ΓÇô100\n  isComplete?: boolean; // true ΓÇö gold/reward state\n  nextHint?: string; // text shown below bar\n  showPercentage?: boolean; // default true\n  compact?: boolean; // 4px bar instead of 8px\n  style?: ViewStyle;\n}\n\nexport function SanctuaryProgressBar({\n  percentage,\n  isComplete = false,\n  nextHint,\n  showPercentage = true,\n  compact = false,\n  style,\n}: SanctuaryProgressBarProps) {\n  // Animated.Value for fill width ΓÇö useNativeDriver must be false (width interpolation)\n  const fillAnim = useRef(new Animated.Value(0)).current;\n\n  useEffect(() => {\n    Animated.timing(fillAnim, {\n      toValue: Math.min(100, Math.max(0, percentage)),\n      duration: 600,\n      useNativeDriver: false,\n    }).start();\n  }, [percentage]);\n\n  // Reanimated glow pulse when complete\n  const glowOpacity = useSharedValue(0);\n  useEffect(() => {\n    if (isComplete) {\n      glowOpacity.value = withSequence(\n        withTiming(1, { duration: 400 }),\n        withRepeat(\n          withSequence(withTiming(0.3, { duration: 800 }), withTiming(1, { duration: 800 })),\n          3,\n          false,\n        ),\n        withTiming(0.6, { duration: 500 }),\n      );\n    } else {\n      glowOpacity.value = withTiming(0, { duration: 300 });\n    }\n  }, [isComplete]);\n\n  const glowAnimStyle = useAnimatedStyle(() => ({\n    opacity: glowOpacity.value,\n  }));\n\n  const barHeight = compact ? 4 : 8;\n\n  return (\n    <VStack className=\"py-2 gap-2\" style={style}>\n      {/* Header row: label + percentage */}\n      {showPercentage && (\n        <HStack className=\"justify-between items-center mb-1\">\n          <Text className=\"text-[11px] font-semibold uppercase tracking-wider text-phase-text-secondary\">\n            Profile Completion\n          </Text>\n          <Text\n            className={`text-[13px] font-bold ${isComplete ? 'text-phase-reward' : 'text-phase-text-primary'}`}\n          >\n            {percentage}%\n          </Text>\n        </HStack>\n      )}\n\n      {/* Track */}\n      <Box\n        className=\"bg-phase-surface/30 rounded-full overflow-hidden\"\n        style={{ height: barHeight }}\n      >\n        {/* Animated fill */}\n        <Animated.View\n          style={[\n            StyleSheet.absoluteFillObject,\n            {\n              backgroundColor: isComplete ? '#10B981' : '#F6BF8C', // phase-reward : phase-accent\n              width: fillAnim.interpolate({\n                inputRange: [0, 100],\n                outputRange: ['0%', '100%'],\n              }),\n              borderRadius: barHeight / 2,\n            },\n          ]}\n        />\n        {/* Reanimated glow overlay on completion */}\n        {isComplete && (\n          <Reanimated.View\n            style={[\n              StyleSheet.absoluteFillObject,\n              { backgroundColor: 'rgba(16, 185, 129, 0.3)', borderRadius: barHeight / 2 },\n              glowAnimStyle,\n            ]}\n          />\n        )}\n      </Box>\n\n      {/* Hint / complete text */}\n      {!isComplete && nextHint ? (\n        <Text className=\"text-[12px] text-phase-text-secondary\" numberOfLines={1}>\n          {nextHint}\n        </Text>\n      ) : isComplete ? (\n        <Text className=\"text-[12px] text-phase-reward\">≡ƒÅà Profile complete!</Text>\n      ) : null}\n    </VStack>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\Naween\\projects\\polymath-platform\\packages\\ui\\src\\components\\SanctuaryStatsCard.tsx","messages":[{"ruleId":"@typescript-eslint/no-explicit-any","severity":1,"message":"Unexpected any. Specify a different type.","line":9,"column":9,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":9,"endColumn":12,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[284,287],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[284,287],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React from 'react';\nimport { Box, VStack, HStack, Text } from '../gluestack';\nimport { Trophy } from 'lucide-react-native';\nimport { SanctuaryProgressBar } from './SanctuaryProgressBar';\n\nexport interface SanctuaryStatsIte