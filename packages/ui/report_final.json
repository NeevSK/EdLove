:"react-native-a11y/has-valid-accessibility-ignores-invert-colors","severity":1,"message":"Found an element which will be inverted. Add the accessibilityIgnoresInvertColors prop","line":208,"column":11,"nodeType":"JSXElement","endLine":220,"endColumn":13}],"suppressedMessages":[{"ruleId":"@typescript-eslint/no-require-imports","severity":2,"message":"A `require()` style import is forbidden.","line":210,"column":21,"nodeType":"CallExpression","messageId":"noRequireImports","endLine":210,"endColumn":67,"suppressions":[{"kind":"directive","justification":""}]}],"errorCount":0,"fatalErrorCount":0,"warningCount":4,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { useState, useMemo } from 'react';\nimport { Dimensions, Image as RNImage } from 'react-native';\nimport { Box, VStack, HStack, Text, Pressable, Center } from '../gluestack';\nimport { hapticLight } from '../utils/haptics';\nimport { UserAvatar } from './UserAvatar';\nimport { useTranslation } from 'react-i18next';\nimport Animated, {\n  useSharedValue,\n  useAnimatedStyle,\n  withSpring,\n  interpolate,\n} from 'react-native-reanimated';\nimport { User, GraduationCap, Briefcase, Crown, ShieldAlert } from 'lucide-react-native';\nimport { QRCodeGenerator, QRBuilder } from '../qr';\nimport { usePermissions } from '@repo/core/logic';\n\nconst SCREEN_WIDTH = Dimensions.get('window').width;\nconst CARD_WIDTH = SCREEN_WIDTH - 48; // Standardized spacing\nconst CARD_HEIGHT = 220;\n\n/**\n * IdentityData ΓÇö Generic interface for person/entity display in the IdentityCard.\n */\nexport interface IdentityData {\n  id: string;\n  full_name: string;\n  username?: string;\n  role: string;\n  avatar_url?: string;\n  school_name?: string;\n  nic_number?: string;\n  index_number?: string;\n}\n\ninterface IdentityCardProps {\n  data: IdentityData;\n  onEdit?: () => void;\n  onViewFullProfile?: () => void;\n  style?: any;\n  /** Optional custom renderer for the back of the card. */\n  renderBackSide?: () => React.ReactNode;\n  /** Whether to allow flipping the card. Defaults to true. */\n  allowFlip?: boolean;\n  /** Optional permissions override. */\n  canOverride?: (action: string, subject: string) => boolean;\n}\n\n/**\n * IdentityCard - Flagship component for identity visualization.\n * Hardened v3 implementation.\n */\nexport default function IdentityCard({\n  data,\n  onEdit,\n  onViewFullProfile,\n  style,\n  renderBackSide,\n  allowFlip = true,\n  canOverride,\n}: IdentityCardProps) {\n  const { t } = useTranslation();\n  const isFlipped = useSharedValue(0);\n  const [flipState, setFlipState] = useState(false);\n\n  const handleFlip = () => {\n    if (!allowFlip) return;\n    hapticLight();\n    setFlipState(!flipState);\n    isFlipped.value = withSpring(flipState ? 0 : 1, {\n      damping: 15,\n      stiffness: 90,\n    });\n\n    if (onEdit) onEdit();\n    if (onViewFullProfile) onViewFullProfile();\n  };\n\n  const frontStyle = useAnimatedStyle(() => {\n    const rotateValue = interpolate(isFlipped.value, [0, 1], [0, 180]);\n    return {\n      transform: [{ rotateY: `${rotateValue}deg` }],\n      opacity: interpolate(isFlipped.value, [0, 0.5, 1], [1, 0, 0]),\n      zIndex: isFlipped.value < 0.5 ? 2 : 1,\n    } as any;\n  });\n\n  const backStyle = useAnimatedStyle(() => {\n    const rotateValue = interpolate(isFlipped.value, [0, 1], [180, 360]);\n    return {\n      transform: [{ rotateY: `${rotateValue}deg` }],\n      opacity: interpolate(isFlipped.value, [0, 0.5, 1], [0, 0, 1]),\n      zIndex: isFlipped.value > 0.5 ? 2 : 1,\n    } as any;\n  });\n\n  const { can: internalCan } = usePermissions();\n  const can = canOverride || internalCan;\n\n  const roleContext = useMemo(() => {\n    if (can('manage', 'PrincipalDashboard')) {\n      return {\n        label: t('roles.principal') || 'Principal ≡ƒÅ¢∩╕Å',\n        icon: Crown,\n        colorClass: 'text-phase-accent',\n        emoji: '≡ƒÅ¢∩╕Å',\n      };\n    }\n    if (can('manage', 'TeacherDashboard')) {\n      return {\n        label: t('roles.teacher') || 'Teacher ≡ƒî▒',\n        icon: Briefcase,\n        colorClass: 'text-phase-accent',\n        emoji: '≡ƒî▒',\n      };\n    }\n    if (can('manage', 'StudentDashboard')) {\n      return {\n        label: t('roles.student') || 'Student ≡ƒôÜ',\n        icon: GraduationCap,\n        colorClass: 'text-phase-accent',\n        emoji: '≡ƒôÜ',\n      };\n    }\n    if (can('manage', 'FounderDashboard')) {\n      return { label: 'Holden ≡ƒ¢í∩╕Å', icon: ShieldAlert, colorClass: 'text-phase-accent', emoji: '≡ƒ¢í∩╕Å' };\n    }\n    return {\n      label: 'Explorer ≡ƒî┐',\n      icon: User,\n      colorClass: 'text-phase-text-secondary',\n      emoji: '≡ƒî┐',\n    };\n  }, [can, t]);\n\n  const defaultBackSide = () => (\n    <Center className=\"h-full\">\n      <Box className=\"p-4 bg-white rounded-xl\">\n        <QRCodeGenerator\n          value={\n            data.id\n              ? QRBuilder.userInvite(data.id, data.role || 'unknown', data.username || undefined)\n              : 'gurudevi-guest'\n          }\n          size={120}\n        />\n      </Box>\n      <Text className=\"mt-4 font-bold text-phase-text-primary uppercase tracking-widest\">\n        INVITE\n      </Text>\n      <Text className=\"text-xs text-phase-text-secondary\">{t('profile.scanToConnect')}</Text>\n    </Center>\n  );\n\n  return (\n    <Pressable\n      onPress={handleFlip}\n      disabled={!allowFlip}\n      accessibilityRole=\"button\"\n      className=\"shadow-xl\"\n    >\n      <Box\n        style={[\n          {\n            width: CARD_WIDTH,\n            height: CARD_HEIGHT,\n          },\n          style,\n        ]}\n      >\n        {/* FRONT SIDE - IDENTITY */}\n        <Animated.View\n          style={frontStyle}\n          className=\"absolute inset-0 overflow-hidden bg-phase-surface border border-phase-surface rounded-[32px] backface-hidden\"\n        >\n          <Box className=\"absolute inset-0 bg-black/5\" />\n          <HStack className=\"items-center h-full p-6 gap-4\">\n            <UserAvatar\n              avatarUrl={data.avatar_url}\n              fullName={data.full_name}\n              fallbackEmoji={roleContext.emoji}\n              size={80}\n            />\n            {/* Details */}\n            <VStack className=\"flex-1 gap-1\">\n              <HStack className=\"items-center gap-1\">\n                <Text className=\"text-[10px] font-bold uppercase text-phase-text-secondary tracking-widest\">\n                  {roleContext.label}\n                </Text>\n                <roleContext.icon size={14} className={roleContext.colorClass} />\n              </HStack>\n              <Text className=\"text-xl font-bold text-phase-text-primary\" numberOfLines={1}>\n                {data.full_name || 'Guest User'}\n              </Text>\n              <Text className=\"text-xs text-phase-text-secondary\" numberOfLines={1}>\n                {data.school_name || t('profile.noSchoolConnected')}\n              </Text>\n              {/* Identification Row */}\n              {(data.nic_number || data.index_number) && (\n                <Box className=\"self-start px-2 py-1 rounded-md bg-phase-accent/10 mt-2\">\n                  <Text className=\"text-[10px] font-bold text-phase-accent\">\n                    {can('manage', 'StudentDashboard') ? 'INDEX:' : 'NIC:'}{' '}\n                    {data.nic_number || data.index_number}\n                  </Text>\n                </Box>\n              )}\n            </VStack>\n          </HStack>\n          <RNImage\n            // eslint-disable-next-line @typescript-eslint/no-require-imports\n            source={require('../../assets/images/lotus_bloom.png')}\n            style={{\n              position: 'absolute',\n              bottom: -20,\n              right: -20,\n              width: 140,\n              height: 140,\n              opacity: 0.1,\n            }}\n            resizeMode=\"contain\"\n          />\n        </Animated.View>\n        {/* BACK SIDE - CUSTOM OR QR CODE */}\n        {allowFlip && (\n          <Animated.View\n            style={backStyle}\n            className=\"absolute inset-0 overflow-hidden bg-phase-canvas border border-phase-surface rounded-[32px] backface-hidden\"\n          >\n            <Box className=\"absolute inset-0 bg-black/10\" />\n            {renderBackSide ? renderBackSide() : defaultBackSide()}\n          </Animated.View>\n        )}\n      </Box>\n    </Pressable>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\Naween\\projects\\polymath-platform\\packages\\ui\\src\\components\\InteractiveRadarChart.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'Text' is defined but never used.","line":2,"column":16,"nodeType":"Identifier","messageId":"unusedVar","endLine":2,"endColumn":20,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"Text"},"fix":{"range":[53,59],"text":""},"desc":"Remove unused variable \"Text\"."}]},{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'Dimensions' is defined but never used.","line":2,"column":34,"nodeType":"Identifier","messageId":"unusedVar","endLine":2,"endColumn":44,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"Dimensions"},"fix":{"range":[71,83],"text":""},"desc":"Remove unused variable \"Dimensions\"."}]},{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'onChange' is defined but never used.","line":27,"column":3,"nodeType":"Identifier","messageId":"unusedVar","endLine":27,"endColumn":11},{"ruleId":"react-hooks/exhaustive-deps","severity":1,"message":"React Hook useMemo has a missing dependency: 'dimensions'. Either include it or remove the dependency array.","line":43,"column":6,"nodeType":"ArrayExpression","endLine":43,"endColumn":62,"suggestions":[{"desc":"Update the dependencies array to be: [dimensions, angleStep, centerX, radius, centerY]","fix":{"range":[1274,1330],"text":"[dimensions, angleStep, centerX, radius, centerY]"}}]}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":4,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { useMemo } from 'react';\nimport { View, Text, StyleSheet, Dimensions } from 'react-native';\nimport Svg, { Polygon, Line, Circle, G, Text as SvgText } from 'react-native-svg';\nimport { Theme } from '../theme/Theme';\n\nexport interface RadarDimension {\n  key: string;\n  label: string;\n  value: number; // 0-100\n}\n\ninterface InteractiveRadarChartProps {\n  dimensions: RadarDimension[];\n  size?: number;\n  editable?: boolean;\n  onChange?: (key: string, newValue: number) => void;\n}\n\n/**\n * A beautiful, interactive Radar Chart for student analysis.\n * Uses the Sanctuary Saffron aesthetic with glassmorphic touches.\n */\nexport const InteractiveRadarChart: React.FC<InteractiveRadarChartProps> = ({\n  dimensions,\n  size = 300,\n  editable = false,\n  onChange,\n}) => {\n  const centerX = size / 2;\n  const centerY = size / 2;\n  const radius = (size / 2) * 0.7; // Leave space for labels\n  const angleStep = (Math.PI * 2) / dimensions.length;\n\n  // Calculate vertex positions for the background polygon (max values)\n  const bgPoints = useMemo(() => {\n    return dimensions.map((_, i) => {\n      const angle = i * angleStep - Math.PI / 2;\n      return {\n        x: centerX + Math.cos(angle) * radius,\n        y: centerY + Math.sin(angle) * radius,\n      };\n    });\n  }, [dimensions.length, centerX, centerY, radius, angleStep]);\n\n  // Calculate vertex positions for the data polygon\n  const dataPoints = useMemo(() => {\n    return dimensions.map((d, i) => {\n      const angle = i * angleStep - Math.PI / 2;\n      const distance = (d.value / 100) * radius;\n      return {\n        x: centerX + Math.cos(angle) * distance,\n        y: centerY + Math.sin(angle) * distance,\n      };\n    });\n  }, [dimensions, centerX, centerY, radius, angleStep]);\n\n  const polygonPointsString = dataPoints.map((p) => `${p.x},${p.y}`).join(' ');\n  const bgPolygonPointsString = bgPoints.map((p) => `${p.x},${p.y}`).join(' ');\n\n  return (\n    <View style={[styles.container, { width: size, height: size }]}>\n      <Svg width={size} height={size}>\n        {/* Background Grid - Circular Levels */}\n        {[20, 40, 60, 80, 100].map((level) => (\n          <Polygon\n            key={`level-${level}`}\n            points={bgPoints\n              .map((p) => {\n                const dist = level / 100;\n                const x = centerX + (p.x - centerX) * dist;\n                const y = centerY + (p.y - centerY) * dist;\n                return `${x},${y}`;\n              })\n              .join(' ')}\n            fill=\"none\"\n            stroke={Theme.colors.border}\n            strokeWidth=\"0.5\"\n            strokeDasharray=\"2,2\"\n          />\n        ))}\n\n        {/* Axis Lines */}\n        {bgPoints.map((p, i) => (\n          <Line\n            key={`axis-${i}`}\n            x1={centerX}\n            y1={centerY}\n            x2={p.x}\n            y2={p.y}\n            stroke={Theme.colors.border}\n            strokeWidth=\"1\"\n            opacity={0.3}\n          />\n        ))}\n\n        {/* Background Full Polygon */}\n        <Polygon points={bgPolygonPointsString} fill={Theme.colors.linen} opacity={0.1} />\n\n        {/* Data Polygon */}\n        <Polygon\n          points={polygonPointsString}\n          fill={Theme.colors.sanctuarySaffron}\n          fillOpacity={0.3}\n          stroke={Theme.colors.sanctuarySaffron}\n          strokeWidth=\"2\"\n        />\n\n        {/* Vertices and Labels */}\n        {dataPoints.map((p, i) => {\n          const dim = dimensions[i];\n          if (!dim) return null;\n\n          // Label positioning\n          const labelDist = radius + 20;\n          const angle = i * angleStep - Math.PI / 2;\n          const labelX = centerX + Math.cos(angle) * labelDist;\n          const labelY = centerY + Math.sin(angle) * labelDist;\n\n          return (\n            <G key={`vertex-group-${i}`}>\n              {/* Label */}\n              <SvgText\n                x={labelX}\n                y={labelY}\n                fill={Theme.colors.textSecondary}\n                fontSize=\"10\"\n                fontWeight=\"600\"\n                textAnchor=\"middle\"\n                alignmentBaseline=\"middle\"\n              >\n                {dim.label}\n              </SvgText>\n\n              {/* Interaction point */}\n              <Circle\n                cx={p.x}\n                cy={p.y}\n                r={editable ? 6 : 4}\n                fill={Theme.colors.sanctuarySaffron}\n                stroke=\"white\"\n                strokeWidth=\"1\"\n              />\n            </G>\n          );\n        })}\n      </Svg>\n\n      {/* Glow Effect Overlay (subtle) */}\n      <View\n        style={[styles.glow, { width: size * 0.6, height: size * 0.6, borderRadius: size * 0.3 }]}\n        pointerEvents=\"none\"\n      />\n    </View>\n  );\n};\n\nconst styles = StyleSheet.create({\n  container: {\n    alignItems: 'center',\n    justifyContent: 'center',\n    backgroundColor: 'rgba(255, 255, 255, 0.03)',\n    borderRadius: 20,\n    overflow: 'visible',\n  },\n  glow: {\n    position: 'absolute',\n    backgroundColor: Theme.colors.sanctuarySaffron,\n    opacity: 0.05,\n    zIndex: -1,\n  },\n});\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\Naween\\projects\\polymath-platform\\packages\\ui\\src\\components\\JourneyHistoryCard.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'ScrollView' is defined but never used.","line":2,"column":21,"nodeType":"Identifier","messageId":"unusedVar","endLine":2,"endColumn":31,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"ScrollView"},"fix":{"range":[58,70],"text":""},"desc":"Remove unused variable \"ScrollView\"."}]}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { useMemo } from 'react';\nimport { Pressable, ScrollView } from 'react-native';\nimport SanctuaryCard from './SanctuaryCard';\nimport { SanctuaryChip } from './SanctuaryChip';\nimport {\n  LucideIcon,\n  History,\n  Calendar,\n  Clock,\n  Sparkles,\n  MessageSquare,\n  Zap,\n  Camera,\n  TrendingUp,\n} from 'lucide-react-native';\nimport { useManualSnapshot, useTemporalHeatmap } from '@repo/core/logic';\nimport { ResonantHeatmap } from './ResonantHeatmap';\nimport { Box, VStack, HStack, Text } from '../gluestack';\n\nexport interface JourneyEvent {\n  id: string;\n  timestamp: string;\n  type: 'mood' | 'journal' | 'growth' | 'impact' | 'system' | 'reward' | 'moment';\n  title: string;\n  description?: string;\n  accentColor?: string;\n}\n\ninterface JourneyHistoryCardProps {\n  events: JourneyEvent[];\n  summary?: string;\n  loading?: boolean;\n  scale?: 'day' | 'week' | 'month' | 'year';\n  className?: string;\n}\n\nconst getEventIcon = (type: string): LucideIcon => {\n  switch (type) {\n    case 'mood':\n      return Sparkles;\n    case 'journal':\n      return MessageSquare;\n    case 'impact':\n      return Zap;\n    case 'growth':\n      return Calendar;\n    case 'reward':\n      return Sparkles;\n    case 'moment':\n      return Clock;\n    default:\n      return History;\n  }\n};\n\nexport const JourneyHistoryCard: React.FC<JourneyHistoryCardProps> = ({\n  events,\n  summary,\n  loading,\n  scale = 'day',\n  className,\n}) => {\n  const { takeSnapshot, isSaving } = useManualSnapshot();\n  const currentYear = useMemo(() => new Date().getFullYear(), []);\n  const { heatmap, isLoading: heatmapLoading } = useTemporalHeatmap(currentYear);\n\n  if (loading) {\n    return (\n      <SanctuaryCard className={className}>\n        <Text className=\"text-phase-text-secondary text-center italic my-10\">\n          Loading temporal history...\n        </Text>\n      </SanctuaryCard>\n    );\n  }\n\n  return (\n    <SanctuaryCard className={className}>\n      <HStack className=\"items-center justify-between mb-4\">\n        <HStack className=\"items-center gap-2\">\n          <History size={18} className=\"text-phase-accent\" />\n          <Text className=\"text-sm font-extrabold text-phase-accent uppercase tracking-widest\">\n            Temporal History\n          </Text>\n        </HStack>\n        <HStack className=\"items-center gap-3\">\n          <Pressable\n            accessibilityRole=\"button\"\n            onPress={() => takeSnapshot(`Snapshot: ${new Date().toLocaleDateString()}`)}\n            disabled={isSaving}\n            className={`p-1.5 rounded-lg bg-phase-accent/10 border border-phase-accent/20 ${isSaving ? 'opacity-30' : ''}`}\n          >\n            <Camera size={16} className=\"text-phase-accent\" />\n          </Pressable>\n          <SanctuaryChip label={scale.toUpperCase()} variant=\"tag\" size=\"sm\" />\n        </HStack>\n      </HStack>\n\n      {summary && <Text className=\"text-xs italic text-phase-text-secondary mb-5\">{summary}</Text>}\n\n      {scale === 'year' ? (\n        <VStack className=\"mt-2.5\">\n          <HStack className=\"items-center gap-1.5 mb-3\">\n            <TrendingUp size={14} className=\"text-phase-accent\" />\n            <Text className=\"text-xs font-bold text-phase-text-secondary uppercase tracking-[0.5px]\">\n              Growth Arc Intensity\n            </Text>\n          </HStack>\n          <ResonantHeatmap data={heatmap} loading={heatmapLoading} />\n          <Text className=\"text-[11px] italic text-phase-text-secondary/50 mt-3\">\n            Tapping a cell zooms into that temporal focus.\n          </Text>\n        </VStack>\n      ) : (\n        <VStack className=\"mt-2\">\n          {events.length === 0 ? (\n            <Text className=\"text-sm text-center text-phase-text-secondary/40 my-5\">\n              The temporal field is quiet here.\n            </Text>\n          ) : (\n            events.map((event, index) => {\n              const Icon = getEventIcon(event.type);\n              const time = new Date(event.timestamp).toLocaleTimeString([], {\n                hour: '2-digit',\n                minute: '2-digit',\n              });\n\n              return (\n                <HStack key={event.id} className=\"mb-5\">\n                  <VStack className=\"w-5 items-center\">\n                    <Box\n                      style={{ backgroundColor: event.accentColor || '#F6BF8C' }}\n                      className=\"w-2 h-2 rounded-full z-[2] mt-1.5\"\n                    />\n                    {index < events.length - 1 && (\n                      <Box className=\"absolute top-3.5 bottom-[-10px] w-px bg-white/10\" />\n                    )}\n                  </VStack>\n                  <VStack className=\"flex-1 ml-3\">\n                    <HStack className=\"items-center justify-between mb-1\">\n                      <HStack className=\"items-center gap-1.5\">\n                        <Icon size={14} color={event.accentColor || '#F6BF8C'} />\n                        <Text className=\"text-sm font-semibold text-white\">{event.title}</Text>\n                      </HStack>\n                      <Text className=\"text-[11px] text-phase-text-secondary/60\">{time}</Text>\n                    </HStack>\n                    {event.description && (\n                      <Text\n                        className=\"text-sm text-phase-text-secondary leading-4.5\"\n                        numberOfLines={2}\n                      >\n                        {event.description}\n                      </Text>\n                    )}\n                  </VStack>\n                </HStack>\n              );\n            })\n          )}\n        </VStack>\n      )}\n    </SanctuaryCard>\n  );\n};\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\Naween\\projects\\polymath-platform\\packages\\ui\\src\\components\\LivingGlow.tsx","messages":[{"ruleId":"react-hooks/exhaustive-deps","severity":1,"message":"React Hook useEffect has a missing dependency: 'opacity'. Either include it or remove the dependency array.","line":53,"column":6,"nodeType":"ArrayExpression","endLine":53,"endColumn":24,"suggestions":[{"desc":"Update the dependencies array to be: [active, duration, opacity]","fix":{"range":[1171,1189],"text":"[active, duration, opacity]"}}]}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { useEffect } from 'react';\nimport { ViewProps } from 'react-native';\nimport Animated, {\n  useAnimatedStyle,\n  withRepeat,\n  withTiming,\n  useSharedValue,\n  withSequence,\n  Easing,\n} from 'react-native-reanimated';\nimport { Box } from '../gluestack';\n\ninterface LivingGlowProps extends ViewProps {\n  children?: React.ReactNode;\n  active?: boolean;\n  duration?: number;\n  glowColor?: string;\n  size?: number;\n  className?: string;\n}\n\n/**\n * LivingGlow - Pulses with \"Restorative Energy\"\n *\n * Philosophy: Focal points in the Sanctuary should not be static.\n * They should have a \"Breath-like\" pulse that signifies life.\n */\nexport function LivingGlow({\n  children,\n  active = true,\n  duration = 2000,\n  glowColor,\n  size,\n  style,\n  className,\n  ...props\n}: LivingGlowProps) {\n  const opacity = useSharedValue(0.4);\n\n  useEffect(() => {\n    if (active) {\n      opacity.value = withRepeat(\n        withSequence(\n          withTiming(0.8, { duration, easing: Easing.inOut(Easing.ease) }),\n          withTiming(0.4, { duration, easing: Easing.inOut(Easing.ease) }),\n        ),\n        -1,\n        true,\n      );\n    } else {\n      opacity.value = 0;\n    }\n  }, [active, duration]);\n\n  const animatedStyle = useAnimatedStyle(() => ({\n    shadowColor: glowColor || (active ? '#FFC107' : 'transparent'), // Fallback to saffron if active\n    shadowOffset: { width: 0, height: 0 },\n    shadowOpacity: opacity.value,\n    shadowRadius: size ? size / 4 : 10,\n    elevation: active ? 5 : 0,\n    ...(size ? { width: size, height: size } : {}),\n  }));\n\n  return (\n    <Animated.View style={[animatedStyle, style]} className={className} {...props}>\n      {children ||\n        (size ? (\n          <Box\n            className=\"rounded-full\"\n            style={{\n              width: size,\n              height: size,\n              backgroundColor: glowColor || '#FFC107',\n            }}\n          />\n        ) : null)}\n    </Animated.View>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\Naween\\projects\\polymath-platform\\packages\\ui\\src\\components\\LoadingOverlay.tsx","messages":[{"ruleId":"react-native-a11y/has-accessibility-hint","severity":1,"message":"has accessibilityLabel prop but no accessibilityHint","line":16,"column":9,"nodeType":"JSXOpeningElement","endLine":16,"endColumn":92}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React from 'react';\nimport { Modal, Spinner, Center } from '../gluestack';\n\ninterface LoadingOverlayProps {\n  visible: boolean;\n  message?: string;\n}\n\n/**\n * LoadingOverlay - Hardened v3 implementation.\n */\nexport const LoadingOverlay: React.FC<LoadingOverlayProps> = ({ visible }) => {\n  return (\n    <Modal isOpen={visible} onClose={() => {}}>\n      <Center className=\"flex-1\">\n        <Spinner accessibilityLabel=\"Loading\" size=\"large\" className=\"text-phase-accent\" />\n      </Center>\n    </Modal>\n  );\n};\n\nexport default LoadingOverlay;\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\Naween\\projects\\polymath-platform\\packages\\ui\\src\\components\\LogoutModal.tsx","messages":[{"ruleId":"react/no-unescaped-entities","severity":1,"message":"`'` can be escaped with `&apos;`, `&lsquo;`, `&#39;`, `&rsquo;`.","line":55,"column":49,"nodeType":"JSXText","messageId":"unescapedEntityAlts","su