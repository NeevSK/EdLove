 never used.","line":329,"column":11,"nodeType":"Identifier","messageId":"unusedVar","endLine":329,"endColumn":16},{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'isDark' is assigned a value but never used.","line":329,"column":18,"nodeType":"Identifier","messageId":"unusedVar","endLine":329,"endColumn":24},{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'themeText' is assigned a value but never used.","line":329,"column":47,"nodeType":"Identifier","messageId":"unusedVar","endLine":329,"endColumn":56}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":13,"fixableErrorCount":0,"fixableWarningCount":0,"source":"/**\n * WelcomeScreen.web.tsx \\u2014 Split-panel landing page (Pattern A)\n *\n * On native, WelcomeScreen is a mobile-style centred card. On web Metro\n * resolves this file instead, rendering a two-column layout:\n *\n *  \\u250C\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u252C\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2510\n *  \\u2502  LEFT PANEL          \\u2502  RIGHT PANEL               \\u2502\n *  \\u2502  Branding + mission  \\u2502  Auth card                 \\u2502\n *  \\u2502  3 stat pills        \\u2502  Language selector         \\u2502\n *  \\u2502  Five Pillars chips  \\u2502  Explore/Login buttons     \\u2502\n *  \\u2514\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2534\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2518\n *\n * Auth logic is identical to the native screen (same handlers, same hooks).\n * AuthScreen renders on top of this layout when the user taps \"I have an account\".\n *\n * Design tokens: Vellum bg \\u00B7 Ink text \\u00B7 Saffron primary \\u00B7 Dalu Green secondary\n * Shadow rule: Shadow Violet only, never grey/black.\n */\n\nimport React, { useState, useMemo } from 'react';\nimport {\n  View,\n  Text,\n  Pressable,\n  StyleSheet,\n  useWindowDimensions,\n  ScrollView,\n  ActivityIndicator,\n} from 'react-native';\nimport { useTranslation } from 'react-i18next';\nimport { Theme } from '../theme/Theme';\nimport { useTheme } from '../hooks/useTheme';\nimport { VStack } from '../gluestack-legacy';\nimport { handleAPIError } from '@repo/core/logic';\nimport { authAPI } from '@repo/core/native';\nimport { hapticLight, hapticSuccess, hapticError } from '../utils/haptics';\nimport { openExternalURL } from '../utils/linking';\nimport { useRouter } from 'expo-router';\n\n// \\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\n// Constants\n// \\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\nconst LANGUAGES = [\n  { code: 'en', label: 'EN' },\n  { code: 'si', label: '\\u0DC3\\u0DD2\\u0D82' },\n  { code: 'ta', label: '\\u0BA4\\u0BAE\\u00BF\\u0BB4\\u0BCD' },\n];\n\nconst STATS = [\n  { value: 'Teacher', label: 'First' },\n  { value: 'Care', label: 'Mission' },\n  { value: 'LK', label: 'Home' },\n];\n\nconst PILLARS = [\n  { name: 'Self', emoji: '\\u2665', color: Theme.colors.sanctuarySaffron },\n  { name: 'Classroom', emoji: '\\uD83C\\uDFEB', color: Theme.colors.sageGreen },\n  { name: 'Community', emoji: '\\uD83E\\uDD1D', color: Theme.colors.shadowViolet },\n  { name: 'Library', emoji: '\\uD83D\\uDCDA', color: Theme.colors.skyBlue },\n  { name: 'Profile', emoji: '\\uD83E\\uDEAA', color: Theme.colors.sanctuarySaffron },\n];\n\n// \\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\n// Constants\n// \\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\n\n// \\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\n// LeftPanel \\u2014 standalone component (must NOT be defined inside render)\n// \\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\ninterface LeftPanelProps {\n  isDark: boolean;\n  isNarrow: boolean;\n}\n\nfunction LeftPanel({ isNarrow }: { isNarrow: boolean }) {\n  const { text, accent, isDark } = useTheme();\n  return (\n    <View style={[styles.leftPanel, isNarrow && styles.leftPanelNarrow]}>\n      {/* Logo */}\n      <View style={styles.logoRow}>\n        <View style={styles.logoCircle}>\n          <Text style={styles.logoGlyph}>≡ƒÜ╖</Text>\n        </View>\n        <Text style={[styles.logoName, { color: text.primary }]}>Gurudevi</Text>\n      </View>\n      {/* Headline */}\n      <Text style={[styles.headline, { color: text.primary }]}>A Sanctuary{'\\n'}for Teachers</Text>\n      {/* Tagline */}\n      <Text\n        style={[styles.tagline, { color: isDark ? Theme.colors.starlightGray : Theme.colors.bark }]}\n      >\n        Mending the teaching-learning{'\\n'}impedance match ΓÇö through care, not surveillance.\n      </Text>\n      {/* Stats */}\n      <View style={styles.statsRow}>\n        {STATS.map((s) => (\n          <View key={s.label} style={[styles.statPill, { borderColor: accent.action + '30' }]}>\n            <Text style={[styles.statValue, { color: accent.action }]}>{s.value}</Text>\n            <Text style={[styles.statLabel, { color: text.secondary }]}>{s.label}</Text>\n          </View>\n        ))}\n      </View>\n      {/* Five Pillars */}\n      <View style={styles.pillarsRow}>\n        {PILLARS.map((p) => (\n          <View\n            key={p.name}\n            style={[\n              styles.pillarChip,\n              { borderColor: p.color + '30', backgroundColor: p.color + '10' },\n            ]}\n          >\n            <Text style={styles.pillarEmoji}>{p.emoji}</Text>\n            <Text style={[styles.pillarName, { color: p.color }]}>{p.name}</Text>\n          </View>\n        ))}\n      </View>\n      {/* Quote */}\n      <View\n        style={[\n          styles.quoteBox,\n          { borderLeftColor: accent.action, backgroundColor: accent.action + '0A' },\n        ]}\n      >\n        <Text style={[styles.quoteText, { color: text.secondary }]}>\n          \"Education is a living ecology,{'\\n'}not a linear process.\"\n        </Text>\n      </View>\n    </View>\n  );\n}\n\n// \\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\n// RightPanel \\u2014 standalone component (must NOT be defined inside render)\n// \\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\ninterface RightPanelProps {\n  isDark: boolean;\n  i18nLanguage: string;\n  acceptedTerms: boolean;\n  isConnecting: boolean;\n  langHover: string | null;\n  btnHover: 'explore' | 'login' | null;\n  onChangeLanguage: (code: string) => void;\n  onStartExploring: () => void;\n  onLogin: () => void;\n  onToggleTerms: () => void;\n  onLangHoverIn: (code: string) => void;\n  onLangHoverOut: () => void;\n  onBtnHoverIn: (btn: 'explore' | 'login') => void;\n  onBtnHoverOut: () => void;\n  footer: string;\n}\n\nfunction RightPanel({\n  i18nLanguage,\n  acceptedTerms,\n  isConnecting,\n  langHover,\n  btnHover,\n  onChangeLanguage,\n  onStartExploring,\n  onLogin,\n  onToggleTerms,\n  onLangHoverIn,\n  onLangHoverOut,\n  onBtnHoverIn,\n  onBtnHoverOut,\n  footer,\n}: Omit<RightPanelProps, 'isDark'>) {\n  const { text, isDark, glass, accent } = useTheme();\n\n  return (\n    <View style={styles.rightPanel}>\n      <View\n        style={[\n          styles.authCard,\n          {\n            backgroundColor: glass.modal.bg,\n            borderColor: glass.modal.border,\n          },\n        ]}\n      >\n        {/* Language selector */}\n        <View style={styles.langRow}>\n          {LANGUAGES.map((lang) => {\n            const isActive = i18nLanguage?.startsWith(lang.code);\n            const isHov = langHover === lang.code;\n            return (\n              <Pressable\n                accessibilityRole=\"button\"\n                key={lang.code}\n                onPress={() => onChangeLanguage(lang.code)}\n                onHoverIn={() => onLangHoverIn(lang.code)}\n                onHoverOut={onLangHoverOut}\n                style={[\n                  styles.langPill,\n                  {\n                    backgroundColor: isActive\n                      ? accent.action\n                      : isHov\n                        ? glass.interact.bg\n                        : 'transparent',\n                  },\n                ]}\n              >\n                <Text\n                  style={[\n                    styles.langText,\n                    {\n                      color: isActive ? Theme.colors.sacredWhite : text.secondary,\n                      fontWeight: isActive ? '700' : '500',\n                    },\n                  ]}\n                >\n                  {lang.label}\n                </Text>\n              </Pressable>\n            );\n          })}\n        </View>\n        {/* Greeting */}\n        <Text style={[styles.cardTitle, { color: text.primary }]}>Welcome to the Sanctuary</Text>\n        <Text style={[styles.cardSubtitle, { color: text.secondary }]}>\n          Choose how you'd like to begin your journey.\n        </Text>\n        {/* Explore button */}\n        <Pressable\n          onPress={onStartExploring}\n          onHoverIn={() => onBtnHoverIn('explore')}\n          onHoverOut={onBtnHoverOut}\n          disabled={isConnecting}\n          accessibilityRole=\"button\"\n          style={[\n            styles.primaryBtn,\n            {\n              backgroundColor: acceptedTerms ? accent.action : Theme.colors.willow,\n              opacity: btnHover === 'explore' ? 0.88 : 1,\n              transform: btnHover === 'explore' ? [{ scale: 1.015 }] : [{ scale: 1 }],\n            },\n          ]}\n        >\n          {isConnecting ? (\n            <ActivityIndicator color={Theme.colors.sacredWhite} size=\"small\" />\n          ) : (\n            <Text style={styles.primaryBtnText}>Explore as Guest</Text>\n          )}\n        </Pressable>\n        {/* Login button */}\n        <Pressable\n          onPress={onLogin}\n          onHoverIn={() => onBtnHoverIn('login')}\n          onHoverOut={onBtnHoverOut}\n          accessibilityRole=\"button\"\n          style={[\n            styles.secondaryBtn,\n            {\n              borderColor: glass.interact.border,\n              backgroundColor: btnHover === 'login' ? glass.interact.bg : 'transparent',\n            },\n          ]}\n        >\n          <Text style={[styles.secondaryBtnText, { color: text.secondary }]}>\n            I have an account\n          </Text>\n        </Pressable>\n        {/* Terms \\u2014 accessible checkbox */}\n        <Pressable\n          onPress={onToggleTerms}\n          accessibilityRole=\"checkbox\"\n          accessibilityState={{ checked: acceptedTerms }}\n          accessibilityLabel=\"Accept Terms and Privacy Pact\"\n          style={styles.termsRow}\n        >\n          <View\n            style={[\n              styles.checkbox,\n              {\n                backgroundColor: acceptedTerms ? accent.action : 'transparent',\n                borderColor: acceptedTerms ? accent.action : text.muted,\n              },\n            ]}\n          >\n            {acceptedTerms && <Text style={styles.checkmark}>Γ£ô</Text>}\n          </View>\n          <Text style={[styles.termsText, { color: text.secondary }]}>\n            I agree to the{' '}\n            <Pressable\n              onPress={(e) => {\n                e.stopPropagation();\n                openExternalURL('https://neevsk.org/privacy', {\n                  title: 'Privacy Pact',\n                  sourceLabel: 'Welcome',\n                  sourceBadge: 'External policy',\n                  trustLevel: 'verified',\n                });\n              }}\n              accessibilityRole=\"link\"\n              accessibilityLabel=\"Read Privacy Pact\"\n            >\n              <Text\n                style={{\n                  color: accent.action,\n                  fontWeight: '600',\n                  textDecorationLine: 'underline',\n                  fontSize: 13,\n                }}\n              >\n                Privacy Pact\n              </Text>\n            </Pressable>\n          </Text>\n        </Pressable>\n        {/* Footer note */}\n        <Text style={[styles.cardFooter, { color: text.muted }]}>{footer}</Text>\n      </View>\n    </View>\n  );\n}\n\ninterface WelcomeScreenProps {\n  onLogin?: () => void;\n  onGuest?: () => void;\n}\n\nexport default function WelcomeScreen({ onLogin, onGuest }: WelcomeScreenProps) {\n  const { t, i18n } = useTranslation();\n  const router = useRouter();\n  const { phase, isDark, gradientNodes, text: themeText } = useTheme();\n  const { width } = useWindowDimensions();\n\n  const [acceptedTerms, setAcceptedTerms] = useState(true);\n  const [isConnecting, setIsConnecting] = useState(false);\n  const [langHover, setLangHover] = useState<string | null>(null);\n  const [btnHover, setBtnHover] = useState<'explore' | 'login' | null>(null);\n\n  const isNarrow = width < 900;\n\n  const bgFrom = gradientNodes[0];\n\n  const changeLanguage = async (code: string) => {\n    hapticLight();\n    await i18n.changeLanguage(code);\n  };\n\n  const handleStartExploring = async () => {\n    if (!acceptedTerms) {\n      hapticError();\n      return;\n    }\n    hapticSuccess();\n    setIsConnecting(true);\n    try {\n      await authAPI.signInAnonymously();\n      if (onGuest) onGuest();\n    } catch (err) {\n      handleAPIError(err);\n      setIsConnecting(false);\n    }\n  };\n\n  const handleLoginPress = () => {\n    if (!acceptedTerms) {\n      hapticError();\n      return;\n    }\n    hapticLight();\n    if (onLogin) onLogin();\n  };\n\n  const footer =\n    t('welcome.footer') ||\n    'Part of the EdLove Constellation \\u00B7 Made with \\uD83D\\uDC96 in Sri Lanka';\n\n  // \\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\n  // Full layout\n  // \\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\n  return (\n    <View style={[styles.root, { backgroundColor: bgFrom }]}>\n      {/* Subtle ambient glow blobs */}\n      <View style={[styles.blob1, { backgroundColor: Theme.colors.sanctuarySaffron + '12' }]} />\n      <View style={[styles.blob2, { backgroundColor: Theme.colors.sageGreen + '0D' }]} />\n      {isNarrow ? (\n        // \\u2500\\u2500 Mobile web: stack vertically \\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\n        <ScrollView\n          contentContainerStyle={styles.narrowContent}\n          showsVerticalScrollIndicator={false}\n        >\n          <LeftPanel isNarrow={isNarrow} />\n          <RightPanel\n            i18nLanguage={i18n.language}\n            acceptedTerms={acceptedTerms}\n            isConnecting={isConnecting}\n            langHover={langHover}\n            btnHover={btnHover}\n            onChangeLanguage={changeLanguage}\n            onStartExploring={handleStartExploring}\n            onLogin={handleLoginPress}\n            onToggleTerms={() => setAcceptedTerms((v) => !v)}\n            onLangHoverIn={setLangHover}\n            onLangHoverOut={() => setLangHover(null)}\n            onBtnHoverIn={setBtnHover}\n            onBtnHoverOut={() => setBtnHover(null)}\n            footer={footer}\n          />\n        </ScrollView>\n      ) : (\n        // ΓöÇΓöÇ Desktop web: two-column layout ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ\n        <View style={styles.twoCol}>\n          <LeftPanel isNarrow={false} />\n          <VStack className=\"flex-1 justify-center items-center\">\n            <RightPanel\n              i18nLanguage={i18n.language}\n              acceptedTerms={acceptedTerms}\n              isConnecting={isConnecting}\n              langHover={langHover}\n              btnHover={btnHover}\n              onChangeLanguage={changeLanguage}\n              onStartExploring={handleStartExploring}\n              onLogin={handleLoginPress}\n              onToggleTerms={() => setAcceptedTerms((v) => !v)}\n              onLangHoverIn={setLangHover}\n              onLangHoverOut={() => setLangHover(null)}\n              onBtnHoverIn={setBtnHover}\n              onBtnHoverOut={() => setBtnHover(null)}\n              footer={footer}\n            />\n          </VStack>\n        </View>\n      )}\n    </View>\n  );\n}\n\n// \\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\n// Styles\n// \\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\nconst styles = StyleSheet.create({\n  root: {\n    flex: 1,\n    overflow: 'hidden',\n  },\n  blob1: {\n    position: 'absolute',\n    width: 600,\n    height: 600,\n    borderRadius: 300,\n    top: -200,\n    left: -100,\n  },\n  blob2: {\n    position: 'absolute',\n    width: 400,\n    height: 400,\n    borderRadius: 200,\n    bottom: -100,\n    right: -50,\n  },\n  twoCol: {\n    flex: 1,\n    flexDirection: 'row',\n    alignItems: 'stretch',\n  },\n  narrowContent: {\n    flexGrow: 1,\n    paddingVertical: 24,\n    paddingHorizontal: 16,\n    gap: 16,\n    alignItems: 'stretch',\n  },\n\n  // \\u2500\\u2500 Left panel \\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\n  leftPanel: {\n    flex: 1,\n    justifyContent: 'center',\n    paddingHorizontal: 56,\n    paddingVertical: 48,\n    gap: 20,\n  },\n  leftPanelNarrow: {\n    paddingHorizontal: 24,\n    paddingVertical: 32,\n    alignItems: 'center',\n  },\n  logoRow: {\n    flexDirection: 'row',\n    alignItems: 'center',\n    gap: 12,\n    marginBottom: 8,\n  },\n  logoCircle: {\n    width: 44,\n    height: 44,\n    borderRadius: 22,\n    backgroundColor: 'rgba(212,132,58,0.15)',\n    alignItems: 'center',\n    justifyContent: 'center',\n  },\n  logoGlyph: {\n    fontSize: 22,\n  },\n  logoName: {\n    fontSize: 22,\n    fontWeight: '800',\n    letterSpacing: -0.5,\n  },\n  headline: {\n    fontSize: 52,\n    fontWeight: '800',\n    letterSpacing: -1.5,\n    lineHeight: 58,\n  },\n  tagline: {\n    fontSize: 17,\n    lineHeight: 26,\n    maxWidth: 400,\n  },\n  statsRow: {\n    flexDirection: 'row',\n    gap: 10,\n    flexWrap: 'wrap',\n  },\n  statPill: {\n    paddingHorizontal: 14,\n    paddingVertical: 8,\n    borderRadius: 50,\n    borderWidth: 1,\n    alignItems: 'center',\n  },\n  statValue: {\n    fontSize: 18,\n    fontWeight: '800',\n    letterSpacing: -0.3,\n  },\n  statLabel: {\n    fontSize: 11,\n    fontWeight: '500',\n    textTransform: 'uppercase',\n    letterSpacing: 0.5,\n  },\n  pillarsRow: {\n    flexDirection: 'row',\n    gap: 8,\n    flexWrap: 'wrap',\n  },\n  pillarChip: {\n    flexDirection: 'row',\n    alignItems: 'center',\n    gap: 5,\n    paddingHorizontal: 12,\n    paddingVertical: 6,\n    borderRadius: 50,\n    borderWidth: 1,\n  },\n  pillarEmoji: {\n    fontSize: 13,\n  },\n  pillarName: {\n    fontSize: 12,\n    fontWeight: '600',\n  },\n  quoteBox: {\n    borderLeftWidth: 3,\n    paddingLeft: 14,\n    paddingVertical: 4,\n    maxWidth: 380,\n  },\n  quoteText: {\n    fontSize: 14,\n    lineHeight: 22,\n    fontStyle: 'italic',\n  },\n\n  // \\u2500\\u2500 Right panel \\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\n  rightPanel: {\n    width: '100%',\n    maxWidth: 420,\n    justifyContent: 'center',\n    alignItems: 'center',\n    paddingHorizontal: 32,\n    paddingVertical: 48,\n  },\n  authCard: {\n    width: '100%',\n    borderRadius: 28,\n    borderWidth: 1,\n    padding: 32,\n    gap: 14,\n    boxShadow: '0 8px 28px rgba(107, 100, 128, 0.16)',\n    elevation: 12,\n  },\n  langRow: {\n    flexDirection: 'row',\n    gap: 4,\n    marginBottom: 6,\n  },\n  langPill: {\n    paddingHorizontal: 14,\n    paddingVertical: 7,\n    borderRadius: 50,\n  },\n  langText: {\n    fontSize: 12,\n    letterSpacing: 0.3,\n  },\n  cardTitle: {\n    fontSize: 22,\n    fontWeight: '800',\n    letterSpacing: -0.4,\n    lineHeight: 28,\n  },\n  cardSubtitle: {\n    fontSize: 14,\n    lineHeight: 20,\n    marginBottom: 4,\n  },\n  primaryBtn: {\n    borderRadius: 50,\n    paddingVertical: 16,\n    alignItems: 'center',\n    justifyContent: 'center',\n    minHeight: 54,\n    boxShadow: '0 4px 14px rgba(107, 100, 128, 0.20)',\n  },\n  primaryBtnText: {\n    fontSize: 16,\n    fontWeight: '700',\n    color: Theme.colors.sacredWhite,\n    letterSpacing: 0.2,\n  },\n  secondaryBtn: {\n    borderRadius: 50,\n    paddingVertical: 14,\n    alignItems: 'center',\n    justifyContent: 'center',\n    borderWidth: 1.5,\n    minHeight: 50,\n  },\n  secondaryBtnText: {\n    fontSize: 15,\n    fontWeight: '500',\n    letterSpacing: 0.1,\n  },\n  termsRow: {\n    flexDirection: 'row',\n    alignItems: 'center',\n    gap: 10,\n    marginTop: 2,\n  },\n  checkbox: {\n    width: 20,\n    height: 20,\n    borderRadius: 6,\n    borderWidth: 2,\n    alignItems: 'center',\n    justifyContent: 'center',\n    flexShrink: 0,\n  },\n  checkmark: {\n    color: '#FFFDF7',\n    fontSize: 12,\n    fontWeight: '700',\n  },\n  termsText: {\n    fontSize: 13,\n    lineHeight: 18,\n    flexShrink: 1,\n  },\n  cardFooter: {\n    fontSize: 11,\n    textAlign: 'center',\n    lineHeight: 16,\n    marginTop: 4,\n  },\n});\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\Naween\\projects\\polymath-platform\\packages\\ui\\src\\screens\\WorkspaceCanvasDemo.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'ResolvedWorkspaceSurface' is defined but never used.","line":5,"column":3,"nodeType":"Identifier","messageId":"unusedVar","endLine":5,"endColumn":27,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"ResolvedWorkspaceSurface"},"fix":{"range":[236,261],"text":""},"desc":"Remove unused variable \"ResolvedWorkspaceSurface\"."}]}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { useMemo, useState } from 'react';\nimport { Pressable, ScrollView, StyleSheet, Text, View } from 'react-native';\nimport { createDefaultWorkspaceLayout, setWorkspaceSurfaceHidden } from '@repo/core/logic';\nimport type {\n  ResolvedWorkspaceSurface,\n  WorkspaceLayout,\n  WorkspaceSurfaceDefinition,\n} from '@repo/core/types';\nimport { WorkspaceCanvas } from '../components/workspace';\nimport { Theme } from '../theme/Theme';\n\ntype DemoRole = 'teacher' | 'principal' | 'founder';\ntype DemoSurfaceId =\n  | 'lesson-flow'\n  | 'student-signals'\n  | 'institution-arc'\n  | 'attendance-watch'\n  | 'guardian-loop'\n  | 'ecosystem-pulse'\n  | 'private-reflection';\ntype DemoCapabilityKey =\n  | 'TeacherLessonFlow'\n  | 'TeacherSignals'\n  | 'InstitutionArc'\n  | 'AttendanceOversight'\n  | 'GuardianRelationship'\n  | 'FounderEcosystemPulse'\n  | 'PrivateReflection';\n\ninterface DemoSurfaceMeta {\n  subtitle: string;\n  summary: string;\n  snapshot: string;\n  temporalLabel: string;\n  temporalTone: 'present' | 'past' | 'future' | 'neutral';\n  metadata: string[];\n  actions: string[];\n  info: string;\n}\n\ntype DemoSurface = WorkspaceSurfaceDefinition<DemoSurfaceId, DemoCapabilityKey>;\n\nconst ROLE_LABELS: Record<DemoRole, string> = {\n  teacher: 'Teacher',\n  principal: 'Principal',\n  founder: 'Founder',\n};\n\nconst SURFACE_LIBRARY: Record<DemoSurfaceId, DemoSurface & DemoSurfaceMeta> = {\n  'lesson-flow': {\n    surfaceId: 'lesson-flow',\n    workspaceId: 'classroom',\n    capabilityKey: 'TeacherLessonFlow',\n    ownerPackage: 'classroom',\n    defaultZone: 'today',\n    defaultOrder: 10,\n    mobileSupport: true,\n    webSupport: true,\n    subtitle: 'Live lesson rhythm',\n    summary:\n      'A compact teaching surface for what is happening now, what needs intervention next, and what can be closed quickly.',\n    snapshot: '3 live groups, 1 assignment blocked, 82% participation in the current cycle.',\n    temporalLabel: 'Present',\n    temporalTone: 'present',\n    metadata: ['Teacher', 'Realtime', 'Actionable'],\n    actions: ['Open session', 'Create note'],\n    info: 'Use when a teacher needs a high-signal present-tense operating view rather than a retrospective report.',\n  },\n  'student-signals': {\n    surfaceId: 'student-signals',\n    workspaceId: 'classroom',\n    capabilityKey: 'TeacherSignals',\n    ownerPackage: 'classroom',\n    defaultZone: 'work',\n    defaultOrder: 20,\n    mobileSupport: true,\n    webSupport: true,\n    subtitle: 'Signals and intervention candidates',\n    summary: 'Highlights learners who changed state recently and surfaces the next best response.',\n    snapshot: '2 students rose into watch status after yesterdays assessments.',\n    temporalLabel: 'Past 24h',\n    temporalTone: 'past',\n    metadata: ['Teacher', 'Insight', 'Review'],\n    actions: ['Review signals', 'Log intervention'],\n    info: 'This card favors temporal transitions and supports read plus lightweight write actions.',\n  },\n  'institution-arc': {\n    surfaceId: 'institution-arc',\n    workspaceId: 'classroom',\n    capabilityKey: 'InstitutionArc',\n    ownerPackage: 'admin',\n    defaultZone: 'institution',\n    defaultOrder: 30,\n    mobileSupport: true,\n    webSupport: true,\n    subtitle: 'Institutional arc',\n    summary:\n      'A school-wide snapshot that blends present health, upcoming risk, and what needs leadership attention.',\n    snapshot:\n      'Attendance stable, invite backlog reduced, and one grade band trending below target.',\n    temporalLabel: 'This week',\n    temporalTone: 'present',\n    metadata: ['Leadership', 'Oversight', 'Cross-holon'],\n    actions: ['Inspect trend', 'Assign follow-up'],\n    info: 'This is the domain-specific language that could later wrap the shared base as an InstitutionalArcCard preset.',\n  },\n  'attendance-watch': {\n    surfaceId: 'attendance-watch',\n    workspaceId: 'classroom',\n    capabilityKey: 'AttendanceOversight',\n    ownerPackage: 'admin',\n    defaultZone: 'outlook',\n    defaultOrder: 40,\n    mobileSupport: true,\n    webSupport: true,\n    subtitle: 'Attendance watch',\n    summary: 'Shows emerging attendance drift before it becomes an official escalation.',\n    snapshot: 'Friday trend predicts a 6% dip if transport disruptions continue.',\n    temporalLabel: 'Forecast',\n    temporalTone: 'future',\n    metadata: ['Leadership', 'Forecast', 'Temporal'],\n    actions: ['Open attendance lane', 'Message coordinator'],\n    info: 'A good example of why the shared card needs temporal state beyond just a title and body.',\n  },\n  'guardian-loop': {\n    surfaceId: 'guardian-loop',\n    workspaceId: 'classroom',\n    capabilityKey: 'GuardianRelationship',\n    ownerPackage: 'guardian',\n    defaultZone: 'work',\n    defaultOrder: 50,\n    mobileSupport: true,\n    webSupport: true,\n    subtitle: 'Guardian communication loop',\n    summary:\n      'Captures summaries ready to share outward without making the workspace itself the persistence owner.',\n    snapshot: '4 guardian-ready summaries drafted, 1 awaiting verification.',\n    temporalLabel: 'Queued',\n    temporalTone: 'neutral',\n    metadata: ['Family', 'Summary', 'Share-ready'],\n    actions: ['Review summary', 'Send update'],\n    info: 'Shows a role crossing seam: teacher and principal may both see it, but through different capabilities.',\n  },\n  'ecosystem-pulse': {\n    surfaceId: 'ecosystem-pulse',\n    workspaceId: 'classroom',\n    capabilityKey: 'FounderEcosystemPulse',\n    ownerPackage: 'admin',\n    defaultZone: 'institution',\n    defaultOrder: 60,\n    mobileSupport: true,\n    webSupport: true,\n    subtitle: 'Ecosystem pulse',\n    summary:\n      'A founder-facing view that emphasizes momentum across institutions rather than one schools local dashboard.',\n    snapshot: '3 institutions expanding, 1 needs staffing support, growth health remains positive.',\n    temporalLabel: 'Quarter arc',\n    temporalTone: 'future',\n    metadata: ['Founder', 'Multi-site', 'Strategic'],\n    actions: ['Open network map', 'Create directive'],\n    info: 'Demonstrates that the same renderer can support non-classroom leadership surfaces without role-specific UI forks.',\n  },\n  'private-reflection': {\n    surfaceId: 'private-reflection',\n    workspaceId: 'classroom',\n    capabilityKey: 'PrivateReflection',\n    ownerPackage: 'core',\n    defaultZone: 'private',\n    defaultOrder: 70,\n    hiddenByDefault: true,\n    mobileSupport: true,\n    webSupport: true,\n    subtitle: 'Private reflection',\n    summary:\n      'A personal note surface that belongs to the user, not the institution, and can stay hidden by default.',\n    snapshot: '2 unfinished reflections from the last 7 days.',\n    temporalLabel: 'Private',\n    temporalTone: 'neutral',\n    metadata: ['Personal', 'Hidden by default'],\n    actions: ['Resume note'],\n    info: 'Included to show hidden-by-default handling and private-zone rendering.',\n  },\n};\n\nconst ROLE_SURFACES: Record<DemoRole, DemoSurfaceId[]> = {\n  teacher: ['lesson-flow', 'student-signals', 'guardian-loop', 'private-reflection'],\n  principal: ['institution-arc', 'attendance-watch', 'guardian-loop', 'private-reflection'],\n  founder: ['ecosystem-pulse', 'institution-arc', 'attendance-watch', 'private-reflection'],\n};\n\nfunction buildRoleSurfaces(role: DemoRole): Array<DemoSurface & DemoSurfaceMeta> {\n  return ROLE_SURFACES[role].map((surfaceId) => SURFACE_LIBRARY[surfaceId]);\n}\n\nexport default function WorkspaceCanvasDemo() {\n  const [role, setRole] = useState<DemoRole>('principal');\n  const [notice, setNotice] = useState('Select a surface to inspect how the shared card behaves.');\n\n  const surfaces = useMemo(() => buildRoleSurfaces(role), [role]);\n  const [layoutByRole, setLayoutByRole] = useState<\n    Record<DemoRole, WorkspaceLayout<DemoSurfaceId>>\n  >(() => ({\n    teacher: createDefaultWorkspaceLayout({\n      workspaceId: 'classroom',\n      userId: 'demo-teacher',\n      surfaces: buildRoleSurfaces('teacher'),\n    }),\n    principal: createDefaultWorkspaceLayout({\n      workspaceId: 'classroom',\n      userId: 'demo-principal',\n      surfaces: buildRoleSurfaces('principal'),\n    }),\n    founder: createDefaultWorkspaceLayout({\n      workspaceId: 'classroom',\n      userId: 'demo-founder',\n      surfaces: buildRoleSurfaces('founder'),\n    }),\n  }));\n\n  const layout = layoutByRole[role];\n\n  const updateRoleLayout = (\n    updater: (current: WorkspaceLayout<DemoSurfaceId>) => WorkspaceLayout<DemoSurfaceId>,\n  ) => {\n    setLayoutByRole((current) => ({\n      ...current,\n      [role]: updater(current[role]),\n    }));\n  };\n\n  const renderActionButton = (label: string, tone: 'primary' | 'secondary' = 'secondary') => (\n    <View\n      key={label}\n      style={[styles.actionChip, tone === 'primary' ? styles.actionChipPrimary : null]}\n    >\n      <Text style={tone === 'primary' ? styles.actionChipTextPrimary : styles.actionChipText}>\n        {label}\n      </Text>\n    </View>\n  );\n\n  return (\n    <ScrollView style={styles.screen} contentContainerStyle={styles.content}>\n      <View style={styles.header}>\n        <Text style={styles.kicker}>SHARED CANVAS DEMO</Text>\n        <Text style={styles.title}>Capability-first workspace canvas</Text>\n        <Text style={styles.subtitle}>\n          One responsive entry point now selects mobile, tablet, or web renderers while still\n          consuming the same shared surfaces and layout state.\n        </Text>\n      </View>\n      <View style={styles.roleRow}>\n        {(['teacher', 'principal', 'founder'] as DemoRole[]).map((candidate) => (\n          <Pressable\n            key={candidate}\n            accessibilityRole=\"button\"\n            onPress={() => {\n              setRole(candidate);\n              setNotice(`Switched to the ${ROLE_LABELS[candidate]} capability mix.`);\n            }}\n            style={[styles.roleChip, role === candidate ? styles.roleChipActive : null]}\n          >\n            <Text style={role === candidate ? styles.roleChipTextActive : styles.roleChipText}>\n              {ROLE_LABELS[candidate]}\n            </Text>\n          </Pressable>\n        ))}\n      </View>\n      <View style={styles.noticePanel}>\n        <Text style={styles.noticeLabel}>Demo note</Text>\n        <Text style={styles.noticeText}>{notice}</Text>\n      </View>\n      <WorkspaceCanvas\n        title={`${ROLE_LABELS[role]} Workspace Canvas`}\n        subtitle=\"Responsive renderer demo with snapshot, temporal state, metadata, info, and action slots.\"\n        surfaces={surfaces}\n        layout={layout}\n        getSurfaceSubtitle={(surface) =>\n          SURFACE_LIBRARY[surface.surfaceId as DemoSurfaceId].subtitle\n        }\n        getSurfaceSummary={(surface) => SURFACE_LIBRARY[surface.surfaceId as DemoSurfaceId].summary}\n        getSurfaceSnapshot={(surface) =>\n          SURFACE_LIBRARY[surface.surfaceId as DemoSurfaceId].snapshot\n        }\n        getSurfaceTemporalLabel={(surface) =>\n          SURFACE_LIBRARY[surface.surfaceId as DemoSurfaceId].temporalLabel\n        }\n        getSurfaceTemporalTone={(surface) =>\n          SURFACE_LIBRARY[surface.surfaceId as DemoSurfaceId].temporalTone\n        }\n        getSurfaceMetadata={(surface) =>\n          SURFACE_LIBRARY[surface.surfaceId as DemoSurfaceId].metadata\n        }\n        renderSurfaceActions={(surface) => (\n          <View style={styles.inlineActions}>\n            {SURFACE_LIBRARY[surface.surfaceId as DemoSurfaceId].actions.map(\n              (action: string, index: number) =>\n                renderActionButton(action, index === 0 ? 'primary' : 'secondary'),\n            )}\n          </View>\n        )}\n        renderSurfaceContent={(surface) => (\n          <View style={styles.surfaceBody}>\n            <Text style={styles.surfaceBodyTitle}>Surface contract</Text>\n            <Text style={styles.surfaceBodyText}>Capability: {surface.capabilityKey}</Text>\n            <Text style={styles.surfaceBodyText}>Package owner: {surface.ownerPackage}</Text>\n            <Text style={styles.surfaceBodyText}>\n              Mobile/Web: {surface.mobileSupport ? 'mobile ' : ''}\n              {surface.webSupport ? 'web' : ''}\n            </Text>\n          </View>\n        )}\n        onSurfacePress={(surface) => {\n          setNotice(`${String(surface.surfaceId)} selected in the ${ROLE_LABELS[role]} canvas.`);\n        }}\n        onPressSurfaceInfo={(surface) => {\n          setNotice(SURFACE_LIBRARY[surface.surfaceId as DemoSurfaceId].info);\n        }}\n        onToggleHidden={(surface) => {\n          updateRoleLayout((current) =>\n            setWorkspaceSurfaceHidden(current, surface.surfaceId, !surface.hidden),\n          );\n          setNotice(\n            `${surface.hidden ? 'Restored' : 'Hidden'} ${String(surface.surfaceId)} in the ${ROLE_LABELS[role]} demo.`,\n          );\n        }}\n      />\n    </ScrollView>\n  );\n}\n\nconst styles = StyleSheet.create({\n  screen: {\n    flex: 1,\n    backgroundColor: Theme.colors.vellum,\n  },\n  content: {\n    padding: Theme.spacing.lg,\n    gap: Theme.spacing.lg,\n  },\n  header: {\n    gap: 8,\n  },\n  kicker: {\n    fontSize: Theme.typography.fontSize.xs,\n    fontWeight: '700',\n    letterSpacing: 1.4,\n    color: Theme.colors.saffronMuted,\n  },\n  title: {\n    fontSize: Theme.typography.fontSize['2xl'],\n    fontWeight: '700',\n    color: Theme.colors.inkTruth,\n  },\n  subtitle: {\n    maxWidth: 760,\n    fontSize: Theme.typography.fontSize.md,\n    lineHeight: 24,\n    color: Theme.colors.bark,\n  },\n  roleRow: {\n    flexDirection: 'row',\n    flexWrap: 'wrap',\n    gap: Theme.spacing.sm,\n  },\n  roleChip: {\n    borderRadius: Theme.corners.full,\n    borderWidth: 1,\n    borderColor: Theme.colors.saffronMuted,\n    paddingHorizontal: 16,\n    paddingVertical: 10,\n    backgroundColor: Theme.colors.silk,\n  },\n  roleChipActive: {\n    backgroundColor: Theme.colors.inkTruth,\n    borderColor: Theme.colors.inkTruth,\n  },\n  roleChipText: {\n    fontSize: Theme.typography.fontSize.sm,\n    fontWeight: '600',\n    color: Theme.colors.inkTruth,\n  },\n  roleChipTextActive: {\n    fontSize: Theme.typography.fontSize.sm,\n    fontWeight: '700',\n    color: Theme.colors.sacredWhite,\n  },\n  noticePanel: {\n    borderRadius: Theme.corners.generous,\n    borderWidth: 1,\n    borderColor: Theme.colors.saffronWhisper,\n    padding: Theme.spacing.md,\n    backgroundColor: Theme.colors.silk,\n    gap: 4,\n  },\n  noticeLabel: {\n    fontSize: Theme.typography.fontSize.xs,\n    fontWeight: '700',\n    letterSpacing: 1,\n    textTransform: 'uppercase',\n    color: Theme.colors.saffronMuted,\n  },\n  noticeText: {\n    fontSize: Theme.typography.fontSize.md,\n    lineHeight: 22,\n    color: Theme.colors.inkTruth,\n  },\n  inlineActions: {\n    flexDirection: 'row',\n    flexWrap: 'wrap',\n    gap: Theme.spacing.xs,\n  },\n  actionChip: {\n    borderRadius: Theme.corners.full,\n    borderWidth: 1,\n    borderColor: Theme.colors.border,\n    paddingHorizontal: 12,\n    paddingVertical: 8,\n    backgroundColor: Theme.colors.silk,\n  },\n  actionChipPrimary: {\n    backgroundColor: Theme.colors.templeGold,\n    borderColor: Theme.colors.templeGold,\n  },\n  actionChipText: {\n    fontSize: Theme.typography.fontSize.xs,\n    fontWeight: '600',\n    color: Theme.colors.inkTruth,\n  },\n  actionChipTextPrimary: {\n    fontSize: Theme.typography.fontSize.xs,\n    fontWeight: '700',\n    color: Theme.colors.inkTruth,\n  },\n  surfaceBody: {\n    gap: 4,\n  },\n  surfaceBodyTitle: {\n    fontSize: Theme.typography.fontSize.sm,\n    fontWeight: '700',\n    color: Theme.colors.inkTruth,\n  },\n  surfaceBodyText: {\n    fontSize: Theme.typography.fontSize.sm,\n    lineHeight: 20,\n    color: Theme.colors.bark,\n  },\n});\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\Naween\\projects\\polymath-platform\\packages\\ui\\src\\screens\\index.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\Naween\\projects\\polymath-platform\\packages\\ui\\src\\theme\\Theme.ts","messages":[{"ruleId":"@typescript-eslint/no-explicit-any","severity":1,"message":"Unexpected any. Specify a different type.","line":327,"column":26,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":327,"endColumn":29,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[10143,10146],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[10143,10146],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":1,"message":"Unexpected any. Specify a different type.","line":327,"column":66,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":327,"endColumn":69,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[10183,10186],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[10183,10186],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"/**\n * GURUDEVI THEME SYSTEM\n * Sanctuary Design Tokens\n *\n * This file contains all design constants used throughout the app.\n * Never use hardcoded colors, spacing, or magic numbers directly in components.\n *\n * Philosophy: Every value has meaning and serves the sanctuary aesthetic.\n */\n\nimport type { TemporalPhase } from '../context/types';\nimport { compositeColorOverBackground, getTextOnBackground } from '../utils/colorUtils';\n\n// ============================================================================\n// COLORS - Sanctuary Palette\n// ============================================================================\n\nexport const colors = {\n  // Primary Actions & Highlights\n  // Gurudevi Gold - The Master Thread (Brand)\n  gurudeviBlue: '#7DD4C0', // Aurora Blue (focused clarity without SaaS harshness)\n  gurudeviViolet: '#B8A9E0', // Aurora Violet (depth / library mood)\n\n  sanctuarySaffron: '#F6BF8C', // Primary actions, warmth (Vibrant Saffron per Design Retina)\n  saffronMuted: '#C4956A', // Secondary usage, morning mist\n  templeGold: '#FDD925', // Elevated moments, achievements\n  amberGlow: '#FFB84D', // Gentle warnings\n\n  // Success & Growth\n  sageGreen: '#8BBF7A', // Success states, gentle growth (daluGreen per Design Retina)\n  mossGreen: '#556B2F', // Subtle success backgrounds\n\n  // Warnings & Attention\n  emberOrange: '#D35400', // Strong warnings/secondary actions\n  emberRed: '#FF6347', // Errors (gentle, not harsh)\n  skyBlue: '#87CEEB', // Sky blue for video resources\n\n  // Backgrounds - The Light World (Vellum & Silk)\n  vellum: '#F5EDD6', // The Ground (Base)\n  silk: '#FAF7ED', // The Surface (Secondary)\n  linen: '#E8E2CF', // The Depth (Tertiary)\n  // Circadian gradient intermediates (dawn warm-white & evening warm-beige)\n  dawnWhite: '#FAF3E0', // Dawn transition \\u2014 between silk and vellum\n  eveningWarm: '#F0E8D0', // Evening transition \\u2014 between vellum and linen\n\n  // Backgrounds - The Dark World (Bioluminescence)\n  ink: '#2A2318', // Midnight Ink (Deep Base)\n  obsidian: '#1A1610', // The Void (Deeper Shadow)\n  shroud: '#3D3528', // Elevated Surfaces (Darker Navy equivalent)\n\n  // Text Colors - Light Mode\n  inkTruth: '#2A2318', // Deep Ink (Primary Text)\n  bark: '#544A3D', // Secondary Text\n  willow: '#72695E', // The Shadow (Muted) \\u2014 Adjusted from #72695E for WCAG AA\n\n  // Text Colors - Dark Mode (higher contrast for accessibility)\n  sacredWhite: '#FCF9F2', // Bone/Sacred White\n  starlightGray: '#C8BFB0', // Starlight (Secondary) - lightened for APCA 60+ contrast\n  mistGray: '#968E80', // Dimmed Text - lightened for better contrast\n  dimGray: '#6A6358', // Disabled Text\n\n  // Specialty Colors\n  shadowViolet: '#6B6480', // The ONLY Shadow Base\n  lotusDeepPink: '#DA70D6', // Lotus flower accent\n  twilightBlue: '#6A5ACD', // Relational ecology accent\n  saffron: '#F6BF8C', // Canonical Saffron\n  saffronWhisper: '#F0D4B0', // Barely there warmth\n\n  // Social Brand Colors\n  whatsapp: '#25D366',\n  linkedin: '#0077B5',\n  instagram: '#E4405F',\n  twitter: '#1DA1F2',\n  portfolio: '#2A2318', // Linktree/Portfolio (Dark base)\n\n  // Functional Colors\n  transparent: 'transparent',\n  white: '#FCF9F2', // REDEFINED: Pure White is forbidden, use Sacred White\n  black: '#1A1610', // REDEFINED: Pure Black is forbidden, use Obsidian\n\n  // Glass System - Glass Protocol (Frosted/Thin/Dense)\n  glass: {\n    dark: {\n      surface: 'rgba(42, 35, 24, 0.72)', // Ink based\n      border: 'rgba(252, 249, 242, 0.12)', // Sacred White based\n      highlight: 'rgba(252, 249, 242, 0.08)',\n    },\n    light: {\n      surface: 'rgba(245, 237, 214, 0.72)', // Vellum based\n      border: 'rgba(42, 35, 24, 0.12)', // Ink based\n      highlight: 'rgba(42, 35, 24, 0.08)',\n    },\n  },\n\n  // Overlays & Shadows - Shadow Law\n  shadowAmbient: 'rgba(107, 100, 128, 0.12)', // Shadow Violet @ 12%\n  shadowDeep: 'rgba(107, 100, 128, 0.24)', // Shadow Violet @ 24%\n  shadowFocus: 'rgba(246, 191, 140, 0.15)', // Saffron glow (#F6BF8C based)\n  shadowSaffron: 'rgba(246, 191, 140, 0.4)', // Stronger Saffron glow\n\n  // Resonance System - Phase Tints\n  resonance: {\n    past: '#968E80', // Muted Sepia-Grey (History)\n    present: '#F6BF8C', // Sanctuary Saffron (Living)\n    future: '#FDD925', // Temple Gold (Potential)\n    ghost: 'rgba(150, 142, 128, 0.4)', // Faded historical resonance\n  },\n\n  // Functional Semantic Aliases\n  text: '#2A2318', // inkTruth\n  textPrimary: '#2A2318',\n  textSecondary: '#544A3D', // bark\n  textTertiary: '#72695E', // willow\n\n  background: '#F5EDD6', // vellum\n  backgroundLight: '#F5EDD6',\n  backgroundDark: '#2A2318', // ink\n\n  border: '#E8E2CF', // linen\n  borderDark: '#3D3528', // shroud\n\n  error: '#FF6347', // emberRed\n  errorText: '#FF6347',\n  errorBackground: '#FFF0EE',\n\n  success: '#8BBF7A', // sageGreen\n  warning: '#FFB84D', // amberGlow\n  glassBorder: 'rgba(252, 249, 242, 0.12)', // Sacred White based (Default)\n} as const;\n\n// Standalone exports for legacy compatibility\nexport const {\n  sanctuarySaffron,\n  saffronMuted,\n  templeGold,\n  amberGlow,\n  sageGreen,\n  mossGreen,\n  emberOrange,\n  emberRed,\n  skyBlue,\n  vellum,\n  silk,\n  linen,\n  dawnWhite,\n  eveningWarm,\n  ink,\n  obsidian,\n  shroud,\n  inkTruth,\n  bark,\n  willow,\n  sacredWhite,\n  starlightGray,\n  mistGray,\n  dimGray,\n} = colors;\n\n// ============================================================================\n// TYPOGRAPHY - Readable & Respectful\n// ============================================================================\n\nexport const typography = {\n  // Font Families (will be set after fonts load)\n  fontFamily: {\n    sinhala: 'Noto Sans Sinhala, -apple-system, sans-serif',\n    tamil: 'Noto Sans Tamil, -apple-system, sans-serif',\n    english: 'DM Sans, System', // Use DM Sans as primary for English\n  },\n\n  // Font Sizes (minimum 14sp per accessibility guidelines)\n  fontSize: {\n    xs: 12, // Captions, timestamps (use sparingly)\n    sm: 14, // Small labels, helper text\n    md: 16, // Button text, input labels\n    lg: 18, // Body text (DEFAULT - never smaller)\n    xl: 22, // Section headings\n    '2xl': 28, // Page headings\n    '3xl': 36, // Large headings\n    '4xl': 48, // Hero text\n    '5xl': 64, // Display text\n  },\n\n  // Line Heights (1.6x for Sinhala/Tamil readability)\n  lineHeight: {\n    tight: 1.2,\n    normal: 1.5,\n    relaxed: 1.6, // DEFAULT for body text\n    loose: 1.8, // For Sinhala/Tamil (more vertical space)\n  },\n\n  // Font Weights\n  fontWeight: {\n    regular: '400',\n    medium: '500',\n    semibold: '600',\n    bold: '700',\n  },\n\n  // Letter Spacing\n  letterSpacing: {\n    tight: -0.5,\n    normal: 0,\n    wide: 0.5,\n  },\n\n  // Heading Styles (Composed from base properties)\n  h1: {\n    fontSize: 28, // fontSize.2xl\n    lineHeight: 44.8, // 1.6x\n    fontWeight: '700', // fontWeight.bold\n    letterSpacing: -0.5,\n  },\n  h2: {\n    fontSize: 22, // fontSize.xl\n    lineHeight: 35.2, // 1.6x\n    fontWeight: '600', // fontWeight.semibold\n    letterSpacing: 0,\n  },\n  h3: {\n    fontSize: 18, // fontSize.lg\n    lineHeight: 28.8, // 1.6x\n    fontWeight: '600', // fontWeight.semibold\n    letterSpacing: 0,\n  },\n} as const;\n\n// ============================================================================\n// SPACING - 8px Base Grid\n// ============================================================================\n\nexport const spacing = {\n  small: 8, // Alias for sm\n  medium: 16, // Alias for md\n  large: 24, // Alias for lg\n  xs: 4, // Tight spacing (icon padding, small gaps)\n  sm: 8, // Small spacing (between related items)\n  md: 9, // Standard spacing (Refined - lean but breathable)\n  lg: 24, // Large spacing (section gaps)\n  xl: 32, // Extra large (page margins, major sections)\n  '2xl': 48, // Huge spacing (page padding)\n  '3xl': 64, // Massive spacing (hero sections)\n};\n\n// ============================================================================\n// CORNER RADIUS - Organic, Never Sharp\n// ============================================================================\n\nexport const corners = {\n  small: 8, // Alias for tight\n  medium: 16, // Alias for comfortable\n  large: 24, // Alias for generous\n  tight: 8, // Small elements (chips, badges)\n  comfortable: 16, // Buttons, inputs (DEFAULT)\n  generous: 24, // Cards, modals\n  full: 9999, // Circular (FAB, avatars) - use large number for full rounding\n};\n\n// ============================================================================\n// SHADOWS - Soft & Sanctuary\n// ============================================================================\n\nconst shadowDefinitions = {\n  none: {\n    shadowColor: 'transparent',\n    shadowOffset: { width: 0, height: 0 },\n    shadowOpacity: 0,\n    shadowRadius: 0,\n    elevation: 0,\n    boxShadow: 'none',\n  },\n\n  sm: {\n    shadowColor: colors.shadowAmbient,\n    shadowOffset: { width: 0, height: 2 },\n    shadowOpacity: 1,\n    shadowRadius: 4,\n    elevation: 2,\n    boxShadow: '0 2px 4px rgba(107, 100, 128, 0.12)',\n  },\n\n  md: {\n    shadowColor: colors.shadowAmbient,\n    shadowOffset: { width: 0, height: 4 },\n    shadowOpacity: 1,\n    shadowRadius: 8,\n    elevation: 4,\n    boxShadow: '0 4px 8px rgba(107, 100, 128, 0.12)',\n  },\n\n  lg: {\n    shadowColor: colors.shadowDeep,\n    shadowOffset: { width: 0, height: 8 },\n    shadowOpacity: 1,\n    shadowRadius: 16,\n    elevation: 8,\n    boxShadow: '0 8px 16px rgba(107, 100, 128, 0.24)',\n  },\n\n  xl: {\n    shadowColor: colors.shadowDeep,\n    shadowOffset: { width: 0, height: 12 },\n    shadowOpacity: 1,\n    shadowRadius: 24,\n    elevation: 12,\n    boxShadow: '0 12px 24px rgba(107, 100, 128, 0.24)',\n  },\n\n  // Glowing effect (for FAB, special elements)\n  glow: {\n    shadowColor: '#F6BF8C',\n    shadowOffset: { width: 0, height: 0 },\n    shadowOpacity: 0.6,\n    shadowRadius: 20,\n    elevation: 10,\n    boxShadow: '0 0 20px rgba(246, 191, 140, 0.6)',\n  },\n};\n\nconst isWeb = typeof window !== 'undefined';\n\nexport const shadows: typeof shadowDefinitions = Object.entries(shadowDefinitions).reduce(\n  (acc, [key, value]) => {\n    const shadowKey = key as keyof typeof shadowDefinitions;\n    // @ts-expect-error - mapping properties dynamically for web/native\n    acc[shadowKey] =\n      isWeb && (value as any).boxShadow ? { boxShadow: (value as any).boxShadow } : value;\n    return acc;\n  },\n  { ...shadowDefinitions },\n);\n\n/**\n * Filter shadow props for web to avoid deprecation warnings.\n * Usage: <View style={{ ...Theme.spacing.md, ...getShadowStyle(Theme.shadows.md) }} /\n */\nexport const getShadowStyle = (\n  shadow: (typeof shadowDefinitions)[keyof typeof shadowDefinitions] | { boxShadow: string },\n) => {\n  if (typeof window !== 'undefined') {\n    // On web, just return boxShadow if it exists\n    if ('boxShadow' in shadow && shadow.boxShadow) {\n      return { boxShadow: shadow.boxShadow };\n    }\n  }\n  return shadow;\n};\n\n// ============================================================================\n// MOTION - Breath-like Timing\n// ============================================================================\n\nexport const motion = {\n  // Duration (in milliseconds)\n  instant: 100, // Rarely used (immediate feedback only)\n  quick: 200, // Fast transitions (hover, focus)\n  standard: 300, // Default animation speed\n  gentle: 500, // Meditative pace\n  breathing: 4000, // Lotus companion breathing cycle\n\n  // Easing (use spring physics for organic feel)\n  easing: {\n    // These are descriptive names - actual implementation uses react-native-reanimated\n    spring: 'spring', // Default - organic, bouncy\n    linear: 'linear', // Avoid - feels robotic\n    easeIn: 'ease-in', // Accelerating\n    easeOut: 'ease-out', // Decelerating (good for exit)\n    easeInOut: 'ease-in-out', // Smooth both ends\n  },\n\n  // Spring Physics (for react-native-reanimated)\n  spring: {\n    gentle: {\n      damping: 15,\n      stiffness: 150,\n    },\n    bouncy: {\n      damping: 10,\n      stiffness: 200,\n    },\n    snappy: {\n      damping: 20,\n      stiffness: 300,\n    },\n  },\n};\n\n// ============================================================================\n// BORDERS\n// ============================================================================\n\nexport const borders = {\n  width: {\n    none: 0,\n    thin: 1,\n    medium: 2,\n    thick: 4,\n  },\n\n  style: {\n    solid: 'solid',\n    dashed: 'dashed',\n    dotted: 'dotted',\n  },\n};\n\n// ============================================================================\n// OPACITY LEVELS\n// ============================================================================\n\nexport const opacity = {\n  transparent: 0,\n  subtle: 0.1,\n  light: 0.3,\n  medium: 0.5,\n  strong: 0.7,\n  heavy: 0.9,\n  opaque: 1,\n};\n\n// ============================================================================\n// LIST DIMENSIONS - For FlashList Optimization\n// ============================================================================\n\nexport const listSizes = {\n  resourceRow: 80,\n  communityCard: 120,\n  chatMessage: 100,\n  classroomRow: 64,\n  groupItem: 72,\n} as const;\n\n// ============================================================================\n// Z-INDEX LAYERS (Stacking Order)\n// ============================================================================\n\nexport const zIndex = {\n  background: 0,\n  content: 1,\n  elevated: 10, // Cards, raised content\n  dropdown: 100, // Dropdowns, popovers\n  sticky: 200, // Sticky headers\n  fab: 300, // Floating action button\n  modal: 400, // Modals, dialogs\n  toast: 500, // Toasts, notifications\n  tooltip: 600, // Tooltips\n};\n\n// ============================================================================\n// DEFAULT EXPORT - Complete Theme Object\n// ============================================================================\n\nexport const Theme = {\n  colors,\n  typography,\n  spacing,\n  corners,\n  shadows,\n  motion,\n  borders,\n  opacity,\n  zIndex,\n  listSizes,\n};\n\nexport default Theme;\n\n// ============================================================================\n// PHASE TOKEN MATRIX \\u2014 The Living Theme System\n// ============================================================================\n// These are the ONLY color values that phase-aware components should use.\n// Consume via useTheme() hook, never reference phases directly in components.\n\nexport interface GlassTokens {\n  surface: { bg: string; opacity: number; blurAmount: number; border: string };\n  modal: { bg: string; opacity: number; blurAmount: number; border: string };\n  interact: { bg: string; opacity: number; blurAmount: number; border: string };\n}\n\nexport interface GlowTokens {\n  soft: { color: string; radius: number; opacity: number };\n  primary: { color: string; radius: number; opacity: number };\n  action: { color: string; radius: number; opacity: number };\n  reward: { color: string; radius: number; opacity: number };\n}\n\nexport interface AccentTokens {\n  action: string; // Primary interactive \\u2014 buttons, links, active chips\n  reward: string; // Achievements, celebrations, milestones\n  danger: string; // Destructive actions\n  muted: string; // Disabled / secondary states\n  templeGold: string; // Brand: Elevated moments\n  sageGreen: string; // Brand: Success & Growth\n}\n\nexport interface TextTokens {\n  primary: string;\n  secondary: string;\n  inverse: string; // Text on accent backgrounds\n  muted: string;\n}\n\nexport interface PhaseTokens {\n  gradientNodes: [string, string, string]; // AnimatedGradientMesh color nodes\n  glass: GlassTokens;\n  glow: GlowTokens;\n  accent: AccentTokens;\n  text: TextTokens;\n}\n\nexport type ThemeProfile = 'sanctuary';\n\nexport interface SceneLayerToken {\n  bg: string;\n  border: string;\n}\n\nexport interface SemanticColorToken {\n  main: string;\n  muted: string;\n  lowOpacity: string;\n}\n\nexport interface SceneTokens {\n  world: SceneLayerToken;\n  chrome: SceneLayerToken;\n  canvas: SceneLayerToken;\n  surface: SceneLayerToken;\n  elevated: SceneLayerToken;\n  interactive: SceneLayerToken;\n  // Semantic Layer\n  primary: SemanticColorToken;\n  secondary: SemanticColorToken;\n  warning: SemanticColorToken;\n  success: SemanticColorToken;\n  danger: SemanticColorToken;\n  info: SemanticColorToken;\n  border: {\n    base: string;\n    subtle: string;\n    strong: string;\n  };\n  text: {\n    primary: string;\n    secondary: string;\n    muted: string;\n    inverse: string;\n  };\n}\n\nexport interface SceneTextTokens {\n  onWorld: string;\n  onChrome: string;\n  onCanvas: string;\n  onSurface: string;\n  onElevated: string;\n  onInteractive: string;\n  onAccent: string;\n  onDanger: string;\n}\n\nexport interface ResolvedThemeTokens extends Omit<PhaseTokens, 'text'> {\n  profile: ThemeProfile;\n  scene: SceneTokens;\n  text: TextTokens & SceneTextTokens;\n  // Structural Metadata (Theme constants)\n  spacing: typeof spacing;\n  typography: typeof typography;\n  corners: typeof corners;\n  shadows: typeof shadows;\n  zIndex: typeof zIndex;\n}\n\nfunction resolveSceneText(bg: string, base: string, fallback: string): string {\n  try {\n    const effectiveBg = bg.startsWith('#') ? bg : compositeColorOverBackground(bg, base);\n\n    return getTextOnBackground(effectiveBg, colors.inkTruth, colors.sacredWhite);\n  } catch {\n    return fallback;\n  }\n}\n\nfunction createSceneTokens(tokens: PhaseTokens): SceneTokens {\n  const isDark = tokens.text.primary === colors.sacredWhite;\n\n  return {\n    world: { bg: tokens.gradientNodes[0], border: 'transparent' },\n    chrome: { bg: tokens.glass.surface.bg, border: tokens.glass.surface.border },\n    canvas: { bg: tokens.gradientNodes[1], border: tokens.glass.surface.border },\n    surface: { bg: tokens.glass.surface.bg, border: tokens.glass.surface.border },\n    elevated: { bg: tokens.glass.modal.bg, border: tokens.glass.modal.border },\n    interactive: { bg: tokens.glass.interact.bg, border: tokens.glass.interact.border },\n\n    // Semantic Mapping\n    primary: {\n      main: tokens.accent.action,\n      muted: isDark ? colors.shroud : colors.linen,\n      lowOpacity: tokens.accent.action + '1A', // 10%\n    },\n    secondary: {\n      main: colors.sageGreen,\n      muted: colors.mossGreen,\n      lowOpacity: colors.sageGreen + '1A',\n    },\n    warning: {\n      main: colors.warning,\n      muted: colors.amberGlow,\n      lowOpacity: colors.warning + '1A',\n    },\n    success: {\n      main: tokens.accent.sageGreen,\n      muted: colors.mossGreen,\n      lowOpacity: tokens.accent.sageGreen + '1A',\n    },\n    danger: {\n      main: tokens.accent.danger,\n      muted: colors.emberOrange,\n      lowOpacity: tokens.accent.danger + '1A',\n    },\n    info: {\n      main: colors.skyBlue,\n      muted: colors.gurudeviBlue,\n      lowOpacity: colors.skyBlue + '1A',\n    },\n    border: {\n      base: isDark ? colors.borderDark : colors.border,\n      subtle: tokens.glass.surface.border,\n      strong: isDark ? colors.obsidian : colors.bark,\n    },\n    text: {\n      primary: tokens.text.primary,\n      secondary: tokens.text.secondary,\n      muted: tokens.text.muted,\n      inverse: tokens.text.inverse || colors.sacredWhite,\n    },\n  };\n}\n\nfunction enrichThemeTokens(\n  tokens: PhaseTokens,\n  profile: ThemeProfile = 'sanctuary',\n): ResolvedThemeTokens {\n  const scene = createSceneTokens(tokens);\n  const sceneText: SceneTextTokens = {\n    onWorld: resolveSceneText(scene.world.bg, scene.world.bg, tokens.text.primary),\n    onChrome: resolveSceneText(scene.chrome.bg, scene.world.bg, tokens.text.primary),\n    onCanvas: resolveSceneText(scene.canvas.bg, scene.world.bg, tokens.text.primary),\n    onSurface: resolveSceneText(scene.surface.bg, scene.canvas.bg, tokens.text.primary),\n    onElevated: resolveSceneText(scene.elevated.bg, scene.canvas.bg, tokens.text.primary),\n    onInteractive: resolveSceneText(scene.interactive.bg, scene.surface.bg, tokens.text.primary),\n    onAccent: getTextOnBackground(tokens.accent.action, colors.inkTruth, colors.sacredWhite),\n    onDanger: getTextOnBackground(tokens.accent.danger, colors.inkTruth, colors.sacredWhite),\n  };\n\n  return