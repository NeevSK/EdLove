ef","endLine":39,"endColumn":11},{"ruleId":"no-undef","severity":1,"message":"'expect' is not defined.","line":40,"column":5,"nodeType":"Identifier","messageId":"undef","endLine":40,"endColumn":11}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":23,"fixableErrorCount":0,"fixableWarningCount":0,"source":"const { resolveClassicTokens, resolvePhaseTokens } = require('../theme/Theme');\n\ndescribe('resolvePhaseTokens', () => {\n  it('returns scene tokens for night/dark', () => {\n    const tokens = resolvePhaseTokens('night', true);\n\n    expect(tokens.scene.world.bg).toBe('#0F131C');\n    expect(tokens.scene.chrome.bg).toBe(tokens.glass.surface.bg);\n    expect(tokens.scene.elevated.bg).toBe(tokens.glass.modal.bg);\n    expect(tokens.text.onWorld).toBe('#FCF9F2');\n    expect(tokens.accent.action).toBe('#FDD925');\n  });\n\n  it('returns scene tokens for morning/light', () => {\n    const tokens = resolvePhaseTokens('morning', false);\n\n    expect(tokens.scene.world.bg).toBe('#F5EDD6');\n    expect(tokens.scene.canvas.bg).toBe('#DCFCE7');\n    expect(tokens.text.onCanvas).toBe('#2A2318');\n    expect(tokens.accent.action).toBe('#8BBF7A');\n    expect(tokens.text.onAccent).toBe(tokens.text.inverse);\n  });\n\n  it('all six phases resolve without throwing in both worlds', () => {\n    const phases = ['predawn', 'dawn', 'morning', 'afternoon', 'dusk', 'night'];\n\n    phases.forEach((phase) => {\n      expect(() => resolvePhaseTokens(phase, false)).not.toThrow();\n      expect(() => resolvePhaseTokens(phase, true)).not.toThrow();\n    });\n  });\n\n  it('classic tokens project into the same scene contract', () => {\n    const lightClassic = resolveClassicTokens(false);\n    const darkClassic = resolveClassicTokens(true);\n\n    expect(lightClassic.scene.canvas.bg).toBe('#FAF7ED');\n    expect(lightClassic.text.onCanvas).toBe('#2A2318');\n    expect(darkClassic.scene.world.bg).toBe('#0F131C');\n    expect(darkClassic.text.onWorld).toBe('#FCF9F2');\n  });\n});\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\Naween\\projects\\polymath-platform\\packages\\ui\\src\\archive\\LotusPetalFAB.complex.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'runOnJS' is defined but never used.","line":27,"column":3,"nodeType":"Identifier","messageId":"unusedVar","endLine":27,"endColumn":10,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"runOnJS"},"fix":{"range":[709,720],"text":""},"desc":"Remove unused variable \"runOnJS\"."}]},{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'FAB_HIT_SLOP' is assigned a value but never used.","line":61,"column":7,"nodeType":"Identifier","messageId":"unusedVar","endLine":61,"endColumn":19},{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'ACTION_BUBBLE_SIZE' is assigned a value but never used.","line":62,"column":7,"nodeType":"Identifier","messageId":"unusedVar","endLine":62,"endColumn":25},{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'SCREEN_WIDTH' is assigned a value but never used.","line":65,"column":7,"nodeType":"Identifier","messageId":"unusedVar","endLine":65,"endColumn":19},{"ruleId":"@typescript-eslint/no-require-imports","severity":1,"message":"A `require()` style import is forbidden.","line":93,"column":21,"nodeType":"CallExpression","messageId":"noRequireImports","endLine":93,"endColumn":67},{"ruleId":"react-hooks/rules-of-hooks","severity":1,"message":"React Hook \"useSharedValue\" is called conditionally. React Hooks must be called in the exact same order in every component render.","line":114,"column":22,"nodeType":"Identifier","endLine":114,"endColumn":36},{"ruleId":"react-hooks/rules-of-hooks","severity":1,"message":"React Hook \"useSharedValue\" is called conditionally. React Hooks must be called in the exact same order in every component render.","line":116,"column":26,"nodeType":"Identifier","endLine":116,"endColumn":40},{"ruleId":"react-hooks/