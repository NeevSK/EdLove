ll overflow-hidden ${className || ''}`,\n    } as any)}\n  >\n    {children}\n  </View>\n);\n\nexport const SliderFilledTrack = ({ className, style, width = '0%' }: any) => (\n  <View\n    {...({\n      style: { ...style, width },\n      className: `h-full bg-phase-accent ${className || ''}`,\n    } as any)}\n  />\n);\n\nexport const SliderThumb = ({ className, style }: any) => (\n  <View\n    {...({\n      style,\n      className: `w-5 h-5 bg-white border border-phase-accent rounded-full shadow-sm absolute ${className || ''}`,\n    } as any)}\n  />\n);\n\nSlider.displayName = 'Slider';\nSliderTrack.displayName = 'SliderTrack';\nSliderFilledTrack.displayName = 'SliderFilledTrack';\nSliderThumb.displayName = 'SliderThumb';\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\Naween\\projects\\polymath-platform\\packages\\ui\\src\\components\\ui\\spinner\\index.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\Naween\\projects\\polymath-platform\\packages\\ui\\src\\components\\ui\\switch\\index.tsx","messages":[{"ruleId":"@typescript-eslint/no-explicit-any","severity":1,"message":"Unexpected any. Specify a different type.","line":11,"column":83,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":11,"endColumn":86,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[343,346],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[343,346],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React from 'react';\nimport { Switch as RNSwitch, Platform } from 'react-native'