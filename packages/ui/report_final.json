e":323,"column":18,"nodeType":"CallExpression","messageId":"restrictedSyntax","endLine":323,"endColumn":72},{"ruleId":"no-restricted-syntax","severity":1,"message":"Avoid inline default text in t('key', 'default'). Define fallback text in locale files and use i18n fallbackLng.","line":324,"column":24,"nodeType":"CallExpression","messageId":"restrictedSyntax","endLine":327,"endColumn":12},{"ruleId":"no-restricted-syntax","severity":1,"message":"Avoid inline default text in t('key', 'default'). Define fallback text in locale files and use i18n fallbackLng.","line":369,"column":18,"nodeType":"CallExpression","messageId":"restrictedSyntax","endLine":369,"endColumn":56},{"ruleId":"no-restricted-syntax","severity":1,"message":"Avoid inline default text in t('key', 'default'). Define fallback text in locale files and use i18n fallbackLng.","line":370,"column":24,"nodeType":"CallExpression","messageId":"restrictedSyntax","endLine":370,"endColumn":85},{"ruleId":"@typescript-eslint/no-explicit-any","severity":1,"message":"Unexpected any. Specify a different type.","line":424,"column":56,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":424,"endColumn":59,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[15617,15620],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[15617,15620],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":1,"message":"Unexpected any. Specify a different type.","line":456,"column":56,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":456,"endColumn":59,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[16715,16718],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[16715,16718],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'accent' is assigned a value but never used.","line":482,"column":11,"nodeType":"Identifier","messageId":"unusedVar","endLine":482,"endColumn":17},{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'scene' is assigned a value but never used.","line":482,"column":19,"nodeType":"Identifier","messageId":"unusedVar","endLine":482,"endColumn":24}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":34,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { useState } from 'react';\nimport { ScrollView, Switch } from 'react-native';\nimport { Box, VStack, HStack, Heading, Text, Button, ButtonText, Pressable } from '../gluestack';\nimport ScreenWrapper from '../components/ScreenWrapper';\nimport { useEnvironment } from '../context';\nimport { useTheme } from '../hooks/useTheme';\nimport { useSanctuaryToast } from '../providers/ToastProvider';\nimport { hapticLight, hapticSuccess } from '../utils/haptics';\nimport { useTranslation } from 'react-i18next';\nimport {\n  Sun,\n  Moon,\n  Smartphone,\n  Sparkles,\n  Eye,\n  EyeOff,\n  Globe,\n  Type,\n  ChevronRight,\n  Check,\n  Info,\n  Zap,\n  Shield,\n} from 'lucide-react-native';\n\nimport { useStore } from '@repo/core/logic';\nimport { DeviceAccountManager } from '../components';\n\ninterface SettingsOptionProps {\n  icon: React.ReactNode;\n  title: string;\n  description: string;\n  onPress: () => void;\n  value?: string;\n  isActive?: boolean;\n  accessibilityLabel?: string;\n  accessibilityHint?: string;\n}\n\n/**\n * Reusable Settings Option Component\n * Accessible and touch-friendly\n */\nfunction SettingsOption({\n  icon,\n  title,\n  description,\n  onPress,\n  value,\n  isActive,\n  accessibilityLabel,\n  accessibilityHint,\n}: SettingsOptionProps) {\n  return (\n    <Pressable\n      onPress={() => {\n        hapticLight();\n        onPress();\n      }}\n      accessible={true}\n      accessibilityRole=\"button\"\n      accessibilityLabel={accessibilityLabel || title}\n      accessibilityHint={accessibilityHint || description}\n      className={`bg-phase-surface border border-phase-border p-4 mb-2 rounded-[20px] min-h-[72px] active:opacity-80 transition-all ${isActive ? 'border-phase-primary' : ''}`}\n    >\n      <HStack className=\"gap-4 items-center\">\n        <Box\n          className={`w-10 h-10 rounded-[12px] items-center justify-center ${isActive ? 'bg-phase-primary' : 'bg-phase-surface'}`}\n        >\n          {icon}\n        </Box>\n        <VStack className=\"flex-1 gap-1\">\n          <Text className=\"text-base font-semibold text-phase-primary\">{title}</Text>\n          <Text className=\"text-sm text-phase-secondary leading-relaxed\">{description}</Text>\n        </VStack>\n        <HStack className=\"gap-2 items-center\">\n          {value && <Text className=\"text-sm text-phase-secondary mr-1\">{value}</Text>}\n          <ChevronRight size={20} className=\"text-phase-muted\" />\n        </HStack>\n      </HStack>\n    </Pressable>\n  );\n}\n\n/**\n * Settings Section Header\n */\nfunction SectionHeader({ title, description }: { title: string; description?: string }) {\n  return (\n    <VStack className=\"gap-1 mb-4 mt-6 px-1\">\n      <Heading size=\"lg\" className=\"text-phase-primary font-bold\">\n        {title}\n      </Heading>\n      {description && (\n        <Text className=\"text-sm text-phase-secondary leading-relaxed\">{description}</Text>\n      )}\n    </VStack>\n  );\n}\n\nexport default function AppSettingsScreen({ navigation }: any) {\n  const { t, i18n } = useTranslation();\n  const { accent, scene, text: themeText } = useTheme();\n\n  const {\n    themeMode,\n    setThemeMode,\n    temporalPhase,\n    fidelityLevel,\n    setFidelityLevel,\n    language,\n    setLanguage,\n    isVeilActive,\n    toggleVeil,\n    reality,\n    enableLivingTheme,\n    setEnableLivingTheme,\n  } = useEnvironment();\n  const { isDemoMode, setDemoMode, user } = useStore();\n  const { showToast } = useSanctuaryToast();\n\n  const [showThemeModal, setShowThemeModal] = useState(false);\n  const [showFidelityModal, setShowFidelityModal] = useState(false);\n  const [showLanguageModal, setShowLanguageModal] = useState(false);\n\n  // Theme mode labels\n  const getThemeLabel = () => {\n    if (themeMode === 'system') return t('settings.theme.system');\n    if (themeMode === 'auto') return t('settings.theme.auto');\n    if (themeMode === 'light') return t('settings.theme.light');\n    return t('settings.theme.dark');\n  };\n\n  // Fidelity labels\n  const getFidelityLabel = () => {\n    if (fidelityLevel === 'auto') return t('settings.fidelity.auto');\n    if (fidelityLevel === 'low') return t('settings.fidelity.low');\n    return t('settings.fidelity.high');\n  };\n\n  // Language labels\n  const getLanguageLabel = () => {\n    if (language === 'en') return 'English';\n    if (language === 'si') return 'α╖âα╖Æα╢éα╖äα╢╜';\n    return 'α«ñα««α«┐α«┤α»ì';\n  };\n\n  // Temporal phase description\n  const getTemporalDescription = () => {\n    const time = new Date().toLocaleTimeString(i18n.language, {\n      hour: 'numeric',\n      minute: '2-digit',\n    });\n    const phases = {\n      predawn: t('settings.temporal.predawn'),\n      dawn: t('settings.temporal.dawn'),\n      morning: t('settings.temporal.morning'),\n      afternoon: t('settings.temporal.afternoon'),\n      dusk: t('settings.temporal.dusk'),\n      night: t('settings.temporal.night'),\n    };\n    return `${phases[temporalPhase as keyof typeof phases]} ΓÇó ${time}`;\n  };\n\n  const handleThemeChange = (mode: 'light' | 'dark' | 'auto') => {\n    setThemeMode(mode);\n    hapticSuccess();\n    setShowThemeModal(false);\n  };\n\n  const handleFidelityChange = async (level: 'auto' | 'low' | 'high') => {\n    await setFidelityLevel(level);\n    hapticSuccess();\n    setShowFidelityModal(false);\n  };\n\n  const handleLanguageChange = async (lang: 'en' | 'si' | 'ta') => {\n    await setLanguage(lang);\n    await i18n.changeLanguage(lang);\n    hapticSuccess();\n    setShowLanguageModal(false);\n  };\n\n  return (\n    <Box className=\"flex-1 bg-phase-world\">\n      <ScrollView\n        style={{ flex: 1 }}\n        showsVerticalScrollIndicator={false}\n        contentContainerStyle={{ padding: 16 }}\n      >\n        {/* Appearance Section */}\n        <SectionHeader\n          title={t('settings.appearance.title')}\n          description={t('settings.appearance.description')}\n        />\n\n        <SettingsOption\n          icon={<Sparkles size={24} className=\"text-phase-secondary\" />}\n          title={t('settings.fidelity.title')}\n          description={\n            fidelityLevel === 'auto'\n              ? t('settings.fidelity.auto_desc')\n              : fidelityLevel === 'low'\n                ? t('settings.fidelity.low_desc')\n                : t('settings.fidelity.high_desc')\n          }\n          value={getFidelityLabel()}\n          onPress={() => setShowFidelityModal(true)}\n          accessibilityLabel={t('settings.fidelity.title')}\n          accessibilityHint={t('settings.fidelity.hint')}\n        />\n\n        {/* Living Theme Toggle */}\n        <Box\n          className={`bg-phase-surface border border-phase-border p-4 mb-2 rounded-[20px] ${enableLivingTheme ? 'border-phase-primary' : ''}`}\n        >\n          <HStack className=\"gap-4 items-center justify-between\">\n            <HStack className=\"gap-4 items-center flex-1\">\n              <Box\n                className={`w-10 h-10 rounded-[12px] items-center justify-center ${enableLivingTheme ? 'bg-phase-primary' : 'bg-phase-surface'}`}\n              >\n                <Sparkles\n                  size={24}\n                  className={enableLivingTheme ? 'text-phase-world' : 'text-phase-muted'}\n                  fill={enableLivingTheme ? 'currentColor' : 'transparent'}\n                />\n              </Box>\n              <VStack className=\"flex-1 gap-1\">\n                <Text className=\"text-base font-semibold text-phase-primary\">\n                  {t('settings.living_theme.title')}\n                </Text>\n                <Text className=\"text-sm text-phase-secondary\">\n                  {enableLivingTheme\n                    ? t('settings.living_theme.on')\n                    : t('settings.living_theme.off')}\n                </Text>\n              </VStack>\n            </HStack>\n            <Switch\n              value={enableLivingTheme}\n              onValueChange={async (val) => {\n                await setEnableLivingTheme(val);\n                hapticLight();\n              }}\n              trackColor={{ false: '#4B5563', true: accent.action }}\n              thumbColor=\"#FFFFFF\"\n              accessible={true}\n              accessibilityRole=\"switch\"\n              accessibilityLabel={t('settings.living_theme.title')}\n              accessibilityState={{ checked: enableLivingTheme }}\n            />\n          </HStack>\n        </Box>\n\n        {/* Language & Localization */}\n        <SectionHeader\n          title={t('settings.language.title')}\n          description={t('settings.language.description')}\n        />\n        <SettingsOption\n          icon={<Globe size={24} className=\"text-phase-secondary\" />}\n          title={t('settings.language.current')}\n          description={t('settings.language.change_desc')}\n          value={getLanguageLabel()}\n          onPress={() => setShowLanguageModal(true)}\n          accessibilityLabel={t('settings.language.current')}\n          accessibilityHint={t('settings.language.hint')}\n        />\n\n        {/* Profile Visibility & Preview */}\n        <SectionHeader\n          title={t('profile.privacy.title', 'Profile & Visibility')}\n          description={t('profile.privacy.description', 'Manage how others see your profile')}\n        />\n        <Box className=\"bg-phase-surface border border-phase-border p-4 mb-2 rounded-[20px]\">\n          <HStack className=\"gap-4 items-center justify-between\">\n            <HStack className=\"gap-4 items-center flex-1\">\n              <Box className=\"w-10 h-10 rounded-[12px] bg-phase-surface items-center justify-center border border-phase-border\">\n                <Shield size={24} className=\"text-phase-secondary\" />\n              </Box>\n              <VStack className=\"flex-1 gap-1\">\n                <Text className=\"text-base font-semibold text-phase-primary\">\n                  {t('profile.privacy.publicProfile', 'Public Social Profile')}\n                </Text>\n                <Text className=\"text-sm text-phase-secondary\">\n                  {user?.public_profile !== false\n                    ? t('profile.privacy.public_on', 'Others can find and view your profile')\n                    : t('profile.privacy.public_off', 'Your profile is hidden from the community')}\n                </Text>\n              </VStack>\n            </HStack>\n            <Switch\n              value={user?.public_profile !== false}\n              onValueChange={async (val) => {\n                hapticLight();\n                showToast({\n                  message: t('settings.profile_visibility_updated', 'Profile visibility updated'),\n                  type: 'success',\n                });\n              }}\n              trackColor={{ false: '#4B5563', true: accent.action }}\n              thumbColor=\"#FFFFFF\"\n            />\n          </HStack>\n        </Box>\n        <SettingsOption\n          icon={<Eye size={24} className=\"text-phase-secondary\" />}\n          title={t('profile.privacy.previewProfile', 'See how others see you')}\n          description={t('profile.privacy.preview_desc', 'View your own public profile card')}\n          onPress={() => {\n            hapticLight();\n            navigation.navigate('Community', {\n              screen: 'UserProfile',\n              params: {\n                userId: user?.id,\n                userName: user?.full_name,\n              },\n            });\n          }}\n        />\n\n        <SectionHeader\n          title={t('profile.account.actions', 'Shared device accounts')}\n          description={t(\n            'profile.account.shared_device_desc',\n            'Switch, protect, and remove accounts stored on this device.',\n          )}\n        />\n        <DeviceAccountManager compact={true} />\n\n        {/* Device Info Section */}\n        <SectionHeader\n          title={t('settings.device.title')}\n          description={t('settings.device.description')}\n        />\n        <Box className=\"bg-phase-surface border border-phase-border p-5 mb-4 rounded-[20px]\">\n          <VStack className=\"gap-4\">\n            <HStack className=\"justify-between items-center\">\n              <Text className=\"text-phase-secondary\">{t('settings.device.tier')}</Text>\n              <Text className=\"text-phase-primary font-semibold\">\n                {reality.deviceTier.charAt(0).toUpperCase() + reality.deviceTier.slice(1)}\n              </Text>\n            </HStack>\n            <HStack className=\"justify-between items-center\">\n              <Text className=\"text-phase-secondary\">{t('settings.device.memory')}</Text>\n              <Text className=\"text-phase-primary font-semibold\">\n                {reality.totalMemoryGB.toFixed(1)} GB\n              </Text>\n            </HStack>\n            <HStack className=\"justify-between items-center\">\n              <Text className=\"text-phase-secondary\">{t('settings.device.network')}</Text>\n              <Text className=\"text-phase-primary font-semibold\">\n                {reality.networkQuality.charAt(0).toUpperCase() + reality.networkQuality.slice(1)}\n              </Text>\n            </HStack>\n            {reality.isDataSaverMode && (\n              <Box className=\"bg-phase-world p-3 rounded-xl border border-phase-border flex-row items-center gap-2\">\n                <Info size={16} className=\"text-phase-primary\" />\n                <Text className=\"text-sm text-phase-primary\">\n                  {t('settings.device.data_saver')}\n                </Text>\n              </Box>\n            )}\n          </VStack>\n        </Box>\n\n        {/* Support Section */}\n        <SectionHeader\n          title={t('settings.support.title', 'Support')}\n          description={t('settings.support.description', 'Help us improve Gurudevi')}\n        />\n        <SettingsOption\n          icon={<Zap size={24} className=\"text-phase-secondary\" />}\n          title=\"Trube Lab\"\n          description=\"Tune living surfaces as solo, duet, or orchestra compositions.\"\n          onPress={() => navigation.navigate('TrubeLab')}\n          accessibilityLabel=\"Open Trube Lab\"\n          accessibilityHint=\"Experiment with living surface compositions and lighting.\"\n        />\n\n        {/* Gentle guidance footer */}\n        <Box className=\"p-5 bg-phase-surface/50 border border-phase-border rounded-[24px] mt-6 mb-12\">\n          <HStack className=\"gap-4 items-start\">\n            <Info size={20} className=\"text-phase-primary\" />\n            <VStack className=\"flex-1 gap-1\">\n              <Text className=\"text-sm font-bold text-phase-primary\">\n                {t('settings.tip.title')}\n              </Text>\n              <Text className=\"text-sm text-phase-secondary leading-relaxed\">\n                {t('settings.tip.message')}\n              </Text>\n            </VStack>\n          </HStack>\n        </Box>\n      </ScrollView>\n\n      {/* Fidelity Selection Modal */}\n      {showFidelityModal && (\n        <SelectionModal\n          title={t('settings.fidelity.select')}\n          options={[\n            {\n              id: 'auto',\n              label: t('settings.fidelity.auto'),\n              description: t('settings.fidelity.auto_full'),\n              icon: <Sparkles size={24} className=\"text-phase-primary\" />,\n              isSelected: fidelityLevel === 'auto',\n            },\n            {\n              id: 'low',\n              label: t('settings.fidelity.low'),\n              description: t('settings.fidelity.low_full'),\n              icon: <Smartphone size={24} className=\"text-phase-secondary\" />,\n              isSelected: fidelityLevel === 'low',\n            },\n            {\n              id: 'high',\n              label: t('settings.fidelity.high'),\n              description: t('settings.fidelity.high_full'),\n              icon: <Sparkles size={24} className=\"text-phase-secondary\" />,\n              isSelected: fidelityLevel === 'high',\n            },\n          ]}\n          onSelect={(id) => handleFidelityChange(id as any)}\n          onClose={() => setShowFidelityModal(false)}\n        />\n      )}\n\n      {/* Language Selection Modal */}\n      {showLanguageModal && (\n        <SelectionModal\n          title={t('settings.language.select')}\n          options={[\n            {\n              id: 'en',\n              label: 'English',\n              description: 'Change the app language to English',\n              icon: <Globe size={24} className=\"text-blue-500\" />,\n              isSelected: language === 'en',\n            },\n            {\n              id: 'si',\n              label: 'α╖âα╖Æα╢éα╖äα╢╜',\n              description: 'α╢║α╖Öα╢»α╖öα╢╕α╖Ü α╢╖α╖Åα╖éα╖Åα╖Ç α╖âα╖Æα╢éα╖äα╢╜α╢º α╖Çα╖Öα╢▒α╖âα╖è α╢Üα╢╗α╢▒α╖èα╢▒',\n              icon: <Globe size={24} className=\"text-amber-500\" />,\n              isSelected: language === 'si',\n            },\n            {\n              id: 'ta',\n              label: 'α«ñα««α«┐α«┤α»ì',\n              description: 'α«¬α«»α«⌐α»ìα«¬α«╛α«ƒα»ìα«ƒα«┐α«⌐α»ì α««α»èα«┤α«┐α«»α»ê α«ñα««α«┐α«┤α»üα«òα»ìα«òα»ü α««α«╛α«▒α»ìα«▒α«╡α»üα««α»ì',\n              icon: <Globe size={24} className=\"text-orange-500\" />,\n              isSelected: language === 'ta',\n            },\n          ]}\n          onSelect={(id) => handleLanguageChange(id as any)}\n          onClose={() => setShowLanguageModal(false)}\n        />\n      )}\n    </Box>\n  );\n}\n\n/**\n * Selection Modal Component\n * Accessible modal for choosing options\n */\ninterface SelectionModalProps {\n  title: string;\n  options: Array<{\n    id: string;\n    label: string;\n    description: string;\n    icon: React.ReactNode;\n    isSelected: boolean;\n  }>;\n  onSelect: (id: string) => void;\n  onClose: () => void;\n}\n\nfunction SelectionModal({ title, options, onSelect, onClose }: SelectionModalProps) {\n  const { accent, scene } = useTheme();\n\n  return (\n    <Box className=\"absolute inset-0 bg-black/50 justify-end z-50\">\n      <Pressable className=\"flex-1\" onPress={onClose} accessible={false} />\n      <Box className=\"bg-phase-world rounded-t-[32px] p-6 pb-12 shadow-2xl\">\n        <Text className=\"text-xl font-bold text-phase-primary mb-4\">{title}</Text>\n        <VStack className=\"gap-2\">\n          {options.map((option) => (\n            <Pressable\n              key={option.id}\n              onPress={() => {\n                hapticLight();\n                onSelect(option.id);\n              }}\n              className={`p-4 rounded-2xl border min-h-[72px] transition-all flex-row items-center gap-4 ${option.isSelected ? 'bg-phase-surface/50 border-phase-primary border-2' : 'bg-phase-surface border-phase-border'}`}\n              accessible={true}\n              accessibilityRole=\"button\"\n              accessibilityLabel={option.label}\n              accessibilityHint={option.description}\n              accessibilityState={{ selected: option.isSelected }}\n            >\n              <Box className=\"w-10 h-10 items-center justify-center\">{option.icon}</Box>\n              <VStack className=\"flex-1 gap-1\">\n                <Text className=\"text-base font-semibold text-phase-primary\">{option.label}</Text>\n                <Text className=\"text-sm text-phase-secondary leading-relaxed\">\n                  {option.description}\n                </Text>\n              </VStack>\n              {option.isSelected && <Check size={24} className=\"text-phase-primary\" />}\n            </Pressable>\n          ))}\n        </VStack>\n        <Button onPress={onClose} className=\"mt-4 bg-phase-surface h-14 rounded-2xl\">\n          <ButtonText className=\"text-phase-primary font-bold\">Close</ButtonText>\n        </Button>\n      </Box>\n    </Box>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\Naween\\projects\\polymath-platform\\packages\\ui\\src\\screens\\AuthScreen.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'useMemo' is defined but never used.","line":1,"column":46,"nodeType":"Identifier","messageId":"unusedVar","endLine":1,"endColumn":53,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"useMemo"},"fix":{"range":[43,52],"text":""},"desc":"Remove unused variable \"useMemo\"."}]},{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'Center' is defined but never used.","line":11,"column":3,"nodeType":"Identifier","messageId":"unusedVar","endLine":11,"endColumn":9,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"Center"},"fix":{"range":[159,169],"text":""},"desc":"Remove unused variable \"Center\"."}]},{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'Pressable' is defined but never used.","line":13,"column":3,"nodeType":"Identifier","messageId":"unusedVar","endLine":13,"endColumn":12,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"Pressable"},"fix":{"range":[179,192],"text":""},"desc":"Remove unused variable \"Pressable\"."}]},{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'Divider' is defined but never used.","line":14,"column":3,"nodeType":"Identifier","messageId":"unusedVar","endLine":14,"endColumn":10,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"Divider"},"fix":{"range":[192,203],"text":""},"desc":"Remove unused variable \"Divider\"."}]},{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'Spinner' is defined but never used.","line":15,"column":3,"nodeType":"Identifier","messageId":"unusedVar","endLine":15,"endColumn":10,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"Spinner"},"fix":{"range":[203,214],"text":""},"desc":"Remove unused variable \"Spinner\"."}]},{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'InputSlot' is defined but never used.","line":16,"column":3,"nodeType":"Identifier","messageId":"unusedVar","endLine":16,"endColumn":12,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"InputSlot"},"fix":{"range":[214,227],"text":""},"desc":"Remove unused variable \"InputSlot\"."}]},{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'InputIcon' is defined but never used.","line":17,"column":3,"nodeType":"Identifier","messageId":"unusedVar","endLine":17,"endColumn":12,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"InputIcon"},"fix":{"range":[227,240],"text":""},"desc":"Remove unused variable \"InputIcon\"."}]},{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'Eye' is defined but never used.","line":25,"column":16,"nodeType":"Identifier","messageId":"unusedVar","endLine":25,"endColumn":19,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"Eye"},"fix":{"range":[620,625],"text":""},"desc":"Remove unused variable \"Eye\"."}]},{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'EyeOff' is defined but never used.","line":25,"column":21,"nodeType":"Identifier","messageId":"unusedVar","endLine":25,"endColumn":27,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"EyeOff"},"fix":{"range":[625,633],"text":""},"desc":"Remove unused variable \"EyeOff\"."}]},{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'Chrome' is defined but never used.","line":25,"column":29,"nodeType":"Identifier","messageId":"unusedVar","endLine":25,"endColumn":35,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"Chrome"},"fix":{"range":[633,641],"text":""},"desc":"Remove unused variable \"Chrome\"."}]},{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'Theme' is defined but never used.","line":28,"column":10,"nodeType":"Identifier","messageId":"unusedVar","endLine":28,"endColumn":15,"suggestions":[{"messageId":"removeUnusedImportDeclaration","data":{"varName":"Theme"},"fix":{"range":[777,817],"text":""},"desc":"Remove unused import declaration."}]},{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'glow' is assigned a value but never used.","line":85,"column":25,"nodeType":"Identifier","messageId":"unusedVar","endLine":85,"endColumn":29},{"ruleId":"@typescript-eslint/no-explicit-any","severity":1,"message":"Unexpected any. Specify a different type.","line":94,"column":50,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":94,"endColumn":53,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[3215,3218],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[3215,3218],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'syncCheckDoneRef' is assigned a value but never used.","line":97,"column":9,"nodeType":"Identifier","messageId":"unusedVar","endLine":97,"endColumn":25},{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'hashParams' is assigned a value but never used.","line":124,"column":11,"nodeType":"Identifier","messageId":"unusedVar","endLine":124,"endColumn":21},{"ruleId":"react-hooks/set-state-in-effect","severity":1,"message":"Error: Calling setState synchronously within an effect can trigger cascading renders\n\nEffects are intended to synchronize state between React and external systems such as manually updating the DOM, state management libraries, or other platform APIs. In general, the body of an effect should do one or both of the following:\n* Update external systems with the latest state from React.\n* Subscribe for updates from some external system, calling setState in a callback function when external state changes.\n\nCalling setState synchronously within an effect body causes cascading renders that can hurt performance, and is not recommended. (https://react.dev/learn/you-might-not-need-an-effect).\n\nC:\\Users\\Naween\\projects\\polymath-platform\\packages\\ui\\src\\screens\\AuthScreen.tsx:137:7\n  135 |     if (errorCode === 'identity_already_exists') {\n  136 |       // Switch to login tab and show a helpful message\n> 137 |       setIsSignUp(false);\n      |       ^^^^^^^^^^^ Avoid calling setState() directly within an effect\n  138 |       setShowEmailAuth(true);\n  139 |       // Decode and surface the message after a short delay so AuthScreen has mounted\n  140 |       setTimeout(() => {","line":137,"column":7,"nodeType":null,"endLine":137,"endColumn":18},{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'_' is defined but never used.","line":152,"column":16,"nodeType":"Identifier","messageId":"unusedVar","endLine":152,"endColumn":17},{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'_' is defined but never used.","line":165,"column":16,"nodeType":"Identifier","messageId":"unusedVar","endLine":165,"endColumn":17},{"ruleId":"@typescript-eslint/no-explicit-any","severity":1,"message":"Unexpected any. Specify a different type.","line":251,"column":44,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":251,"endColumn":47,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[8543,8546],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[8543,8546],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":1,"message":"Unexpected any. Specify a different type.","line":279,"column":61,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":279,"endColumn":64,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[9323,9326],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[9323,9326],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":1,"message":"Unexpected any. Specify a different type.","line":280,"column":44,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":280,"endColumn":47,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[9378,9381],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[9378,9381],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'data' is assigned a value but never used.","line":372,"column":19,"nodeType":"Identifier","messageId":"unusedVar","endLine":372,"endColumn":23},{"ruleId":"@typescript-eslint/no-explicit-any","severity":1,"message":"Unexpected any. Specify a different type.","line":380,"column":25,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":380,"endColumn":28,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[12775,12778],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[12775,12778],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'data' is assigned a value but never used.","line":398,"column":17,"nodeType":"Identifier","messageId":"unusedVar","endLine":398,"endColumn":21},{"ruleId":"@typescript-eslint/no-explicit-any","severity":1,"message":"Unexpected any. Specify a different type.","line":423,"column":21,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":423,"endColumn":24,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[14344,14347],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[14344,14347],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":1,"message":"Unexpected any. Specify a different type.","line":430,"column":28,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":430,"endColumn":31,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[14542,14545],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[14542,14545],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]}],"suppressedMessages":[{"ruleId":"react-hooks/exhaustive-deps","severity":1,"message":"React Hook useEffect has a missing dependency: 'showToast'. Either include it or remove the dependency array.","line":170,"column":6,"nodeType":"ArrayExpression","endLine":170,"endColumn":9,"suggestions":[{"desc":"Update the dependencies array to be: [showToast, t]","fix":{"range":[6077,6080],"text":"[showToast, t]"}}],"suppressions":[{"kind":"directive","justification":""}]}],"errorCount":0,"fatalErrorCount":0,"warningCount":26,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { useState, useRef, useEffect, useMemo } from 'react';\nimport {\n  Box,\n  VStack,\n  Input,\n  InputField,\n  Button,\n  ButtonText,\n  Text,\n  Heading,\n  Center,\n  HStack,\n  Pressable,\n  Divider,\n  Spinner,\n  InputSlot,\n  InputIcon,\n  ButtonSpinner,\n} from '../gluestack';\nimport { useTheme } from '../hooks/useTheme';\nimport { useSanctuaryToast } from '../providers/ToastProvider';\nimport { hapticLight, hapticSuccess, hapticError } from '../utils/haptics';\nimport ScreenWrapper from '../components/ScreenWrapper';\nimport { default as GuestDataSyncModal } from '../components/GuestDataSyncModal';\nimport { Mail, Eye, EyeOff, Chrome } from 'lucide-react-native';\nimport { Platform, type TextInput } from 'react-native';\nimport { useTranslation } from 'react-i18next';\nimport { Theme } from '../theme/Theme';\nimport { BreathAnimation } from '../components/BreathAnimation';\nimport { LivingGlow } from '../components/LivingGlow';\nimport { SanctuaryBackground } from '../components/SanctuaryBackground';\nimport { Role, handleAPIError, validators, validateForm } from '@repo/core/logic';\nimport { supabase, GuestDataSync, identityAPI, authAPI, FlowResolver } from '@repo/core/native';\nimport AsyncStorage from '@react-native-async-storage/async-storage';\nimport * as WebBrowser from 'expo-web-browser';\nimport * as AuthSession from 'expo-auth-session';\n\n// Required for expo-auth-session to complete the auth session on Android\n// (handles the Chrome Custom Tab callback redirect)\nWebBrowser.maybeCompleteAuthSession();\n\n// Google 'G' icon rendered with plain RN ΓÇö no react-native-svg needed\nconst GoogleIcon = ({ size = 20 }: { size?: number }) => (\n  <Box\n    style={{\n      width: size,\n      height: size,\n      borderRadius: size / 2,\n      backgroundColor: '#fff',\n      alignItems: 'center',\n      justifyContent: 'center',\n    }}\n  >\n    <Text\n      style={{\n        fontSize: size * 0.65,\n        fontWeight: '700',\n        color: '#4285F4',\n        lineHeight: size * 0.75,\n      }}\n    >\n      G\n    </Text>\n  </Box>\n);\n\nconst ENTRY_PILLARS = ['Self', 'Classroom', 'Community', 'Library'];\n\ninterface AuthScreenProps {\n  onSuccess?: () => void;\n  onBack?: () => void;\n  /** Start the auth screen in login mode (vs default sign-up) */\n  initialMode?: 'login' | 'signup';\n  /** Injected Scanner component to avoid circular dependencies with @repo/scanner-kit */\n  Scanner?: React.ComponentType<{\n    visible: boolean;\n    onClose: () => void;\n    onScan: (data: string) => Promise<void>;\n    title?: string;\n  }>;\n}\n\nexport default function AuthScreen({ onSuccess, onBack, initialMode, Scanner }: AuthScreenProps) {\n  const { t } = useTranslation();\n  const { accent, text, glow } = useTheme();\n  const { showToast } = useSanctuaryToast();\n  const [email, setEmail] = useState('');\n  const [password, setPassword] = useState('');\n  const [loading, setLoading] = useState(false);\n  const [showEmailAuth, setShowEmailAuth] = useState(initialMode === 'login');\n  const [isSignUp, setIsSignUp] = useState(initialMode !== 'login');\n  const [showScanner, setShowScanner] = useState(false);\n  const [errors, setErrors] = useState<Record<string, string>>({});\n  const [currentUser, setCurrentUser] = useState<any>(null);\n  const [showSyncModal, setShowSyncModal] = useState(false);\n  const [newUserId, setNewUserId] = useState<string>('');\n  const syncCheckDoneRef = useRef(false);\n  const passwordRef = useRef<TextInput>(null);\n\n  // Load current user from public.users via the internal identity (new architecture pattern).\n  // This gives us email + is_anonymous from our own DB, not raw Supabase auth.\n  useEffect(() => {\n    identityAPI.getMyInternalId().then(async (internalId) => {\n      if (!internalId) {\n        setCurrentUser(null);\n        return;\n      }\n      const { data } = await supabase\n        .from('users')\n        .select('id, email, is_anonymous, full_name')\n        .eq('id', internalId)\n        .maybeSingle();\n      if (data) setCurrentUser(data);\n    });\n  }, []);\n\n  // ΓöÇΓöÇΓöÇ Browser callback handling ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ\n  // For web and mobile (via redirected app protocols), we check the URL for tokens\n  // which signifies a successful OAuth return.\n  useEffect(() => {\n    // Only run on web to avoid conflicts with deep linking handlers in Expo go\n    if (Platform.OS !== 'web') return;\n\n    const hashParams = new URL(window.location.href.replace('#', '?')).searchParams;\n    const getUrlParam = (name: string) => {\n      const search = new URLSearchParams(window.location.search);\n      if (search.has(name)) return search.get(name);\n      const hashSearch = new URLSearchParams(window.location.hash.substring(1));\n      return hashSearch.get(name);\n    };\n    const errorCode = getUrlParam('error_code');\n    const errorDesc = getUrlParam('error_description');\n    if (!errorCode) return;\n\n    if (errorCode === 'identity_already_exists') {\n      // Switch to login tab and show a helpful message\n      setIsSignUp(false);\n      setShowEmailAuth(true);\n      // Decode and surface the message after a short delay so AuthScreen has mounted\n      setTimeout(() => {\n        showToast({\n          message:\n            t('auth.identityAlreadyExists') ||\n            'This account already exists. Please sign in instead.',\n          type: 'error',\n        });\n      }, 300);\n      // Clean the error params from the URL without triggering a reload\n      try {\n        const cleanUrl = window.location.origin + window.location.pathname;\n        window.history.replaceState(null, '', cleanUrl);\n      } catch (_) {\n        /* ignore */\n      }\n    } else if (errorCode) {\n      setTimeout(() => {\n        showToast({\n          message: decodeURIComponent(errorDesc ?? errorCode).replace(/\\+/g, ' '),\n          type: 'error',\n        });\n      }, 300);\n      try {\n        const cleanUrl = window.location.origin + window.location.pathname;\n        window.history.replaceState(null, '', cleanUrl);\n      } catch (_) {\n        /* ignore */\n      }\n    }\n    // eslint-disable-next-line react-hooks/exhaustive-deps\n  }, [t]);\n\n  const isRealUser = currentUser && currentUser.email && !currentUser.is_anonymous;\n  const shouldHideGeneralAuth = isRealUser;\n\n  // ΓöÇΓöÇΓöÇ Native redirect URI (used by expo-auth-session) ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ\n  const getRedirectUrl = () => {\n    if (Platform.OS === 'web') {\n      return window.location.origin;\n    }\n    return AuthSession.makeRedirectUri({\n      scheme: 'gurudevi',\n      path: 'auth/callback',\n    });\n  };\n\n  async function handleOAuthSignIn(provider: 'google') {\n    setLoading(true);\n    hapticLight();\n\n    const redirectUrl = getRedirectUrl();\n    const session = await authAPI.getSession().catch(() => null);\n    const isAnon = session?.user?.is_anonymous || !session?.user?.email;\n\n    // ΓöÇΓöÇ Web platform: classic browser-redirect flow ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ\n    if (Platform.OS === 'web') {\n      if (isAnon && session?.user) {\n        const { error } = await supabase.auth.linkIdentity({\n          provider,\n          options: { redirectTo: redirectUrl },\n        });\n        if (error) {\n          if (error.message.includes('already linked')) {\n            showToast({\n              message:\n                t('auth.alreadyLinked') ||\n                'This Google account is already linked to another sanctuary soul. Please login instead.',\n              type: 'error',\n            });\n          } else {\n            handleAPIError(error);\n          }\n          setLoading(false);\n        }\n        return;\n      }\n      const { error } = await supabase.auth.signInWithOAuth({\n        provider,\n        options: {\n          redirectTo: redirectUrl,\n          queryParams: { prompt: 'select_account' },\n        },\n      });\n      if (error) {\n        handleAPIError(error);\n        setLoading(false);\n      }\n      return;\n    }\n\n    // ΓöÇΓöÇ Native platform: use expo-auth-session ΓöÇΓöÇΓöÇ\n    const oauthOptions =\n      isAnon && session?.user\n        ? await supabase.auth.linkIdentity({\n            provider,\n            options: {\n              redirectTo: redirectUrl,\n              skipBrowserRedirect: true,\n              queryParams: { prompt: 'select_account' },\n            },\n          })\n        : await supabase.auth.signInWithOAuth({\n            provider,\n            options: {\n              redirectTo: redirectUrl,\n              skipBrowserRedirect: true,\n              queryParams: { prompt: 'select_account' },\n            },\n          });\n\n    const oauthError = oauthOptions.error;\n    const oauthUrl = (oauthOptions.data as any)?.url as string | null | undefined;\n\n    if (oauthError) {\n      if (oauthError.message.includes('already linked')) {\n        showToast({\n          message:\n            t('auth.alreadyLinked') ||\n            'This Google account is already linked to another sanctuary soul. Please login instead.',\n          type: 'error',\n        });\n      } else {\n        handleAPIError(oauthError);\n      }\n      setLoading(false);\n      return;\n    }\n\n    if (!oauthUrl) {\n      showToast({\n        message: 'Could not reach Google sign-in. Please try again.',\n        type: 'error',\n      });\n      setLoading(false);\n      return;\n    }\n\n    const authResponse = await WebBrowser.openAuthSessionAsync(oauthUrl, redirectUrl);\n\n    if (authResponse.type === 'success' && (authResponse as any).url) {\n      const url = new URL((authResponse as any).url);\n      const params = Object.fromEntries(url.searchParams.entries());\n      const access_token = params.access_token || url.hash.match(/access_token=([^&]+)/)?.[1];\n      const refresh_token = params.refresh_token || url.hash.match(/refresh_token=([^&]+)/)?.[1];\n      if (!access_token || !refresh_token) {\n        setLoading(false);\n        return;\n      }\n\n      const { error: sessErr } = await supabase.auth.setSession({\n        access_token,\n        refresh_token,\n      });\n\n      if (sessErr) {\n        handleAPIError(sessErr);\n      } else {\n        hapticSuccess();\n        const userId = await identityAPI.getMyInternalId();\n        if (userId) {\n          const internalId = userId;\n          const pendingInvite = await AsyncStorage.getItem('pending_invite');\n          if (pendingInvite && internalId) {\n            try {\n              const invite = JSON.parse(pendingInvite);\n              if (invite.school_id) {\n                await supabase\n                  .from('users')\n                  .update({ school_id: invite.school_id, role: (invite.role as Role) || 'teacher' })\n                  .eq('id', internalId);\n                await AsyncStorage.removeItem('pending_invite');\n                showToast({\n                  message: 'Welcome to your new school sanctuary!',\n                  type: 'success',\n                });\n              }\n            } catch (e) {\n              console.error('Failed to apply pending invite', e);\n            }\n          }\n        }\n        const hasGuestData = await GuestDataSync.hasGuestData();\n        if (isAnon && hasGuestData && userId) {\n          setNewUserId(userId);\n          setShowSyncModal(true);\n        } else {\n          if (onSuccess) onSuccess();\n        }\n      }\n    }\n    setLoading(false);\n  }\n\n  async function handleAuth() {\n    const { isValid, errors: valErrors } = validateForm(\n      { email, password },\n      {\n        email: validators.email,\n        password: (val: string) => validators.nonEmpty(val, 'Password'),\n      },\n    );\n\n    if (!isValid) {\n      setErrors(valErrors);\n      return;\n    }\n\n    setLoading(true);\n    try {\n      if (isSignUp) {\n        const currentSession = await authAPI.getSession().catch(() => null);\n        const isAnon = currentSession?.user?.is_anonymous || !currentSession?.user?.email;\n\n        if (isAnon && currentSession?.user) {\n          const existingName =\n            (currentUser?.full_name && String(currentUser.full_name).trim()) || 'Sanctuary User';\n          await authAPI.linkAnonymousToEmail(email, password, existingName, 'teacher' as Role);\n\n          const internalId = await identityAPI.getMyInternalId();\n\n          hapticSuccess();\n          showToast({ message: t('auth.signupSuccess'), type: 'success' });\n\n          // Check for guest data to sync\n          const hasGuestData = await GuestDataSync.hasGuestData();\n          if (hasGuestData && internalId) {\n            setNewUserId(internalId);\n            setShowSyncModal(true);\n          } else {\n            if (onSuccess) onSuccess();\n          }\n        } else {\n          const { data, error } = await supabase.auth.signUp({\n            email,\n            password,\n          });\n          if (error) {\n            if (\n              error.message.includes('already registered') ||\n              error.message.includes('Email already in use') ||\n              (error as any).status === 422\n            ) {\n              showToast({\n                message:\n                  t('auth.alreadyRegistered') ||\n                  'You already have a sanctuary soul! Switching to login...',\n                type: 'success',\n              });\n              setIsSignUp(false);\n              setLoading(false);\n              return;\n            }\n            throw error;\n          }\n          hapticSuccess();\n          showToast({ message: t('auth.checkEmail'), type: 'success' });\n        }\n      } else {\n        const { data, error } = await supabase.auth.signInWithPassword({ email, password });\n        if (error) throw error;\n\n        hapticSuccess();\n        const internalId = await identityAPI.getMyInternalId();\n        if (internalId) {\n          const pendingInvite = await AsyncStorage.getItem('pending_invite');\n          if (pendingInvite) {\n            try {\n              const invite = JSON.parse(pendingInvite);\n              if (invite.school_id) {\n                await supabase\n                  .from('users')\n                  .update({ school_id: invite.school_id, role: (invite.role as Role) || 'teacher' })\n                  .eq('id', internalId);\n                await AsyncStorage.removeItem('pending_invite');\n                showToast({ message: 'Reconnected to your school sanctuary!', type: 'success' });\n              }\n            } catch (e) {\n              console.error('Failed to apply pending invite', e);\n            }\n          }\n        }\n        if (onSuccess) onSuccess();\n      }\n    } catch (error: any) {\n      hapticError();\n      const apiError = handleAPIError(error);\n      showToast({\n        message:\n          typeof apiError === 'string'\n            ? apiError\n            : (apiError as any).message || 'An authentication error occurred',\n        type: 'error',\n      });\n    } finally {\n      setLoading(false);\n    }\n  }\n\n  return (\n    <ScreenWrapper scroll>\n      <Box className=\"flex-1 px-6 py-8\">\n        <SanctuaryBackground />\n        <VStack className=\"w-full max-w-[460px] self-center gap-6\">\n          {onBack && (\n            <Box className=\"self-start\">\n              <Button variant=\"ghost\" onPress={onBack} className=\"pl-0\">\n                <HStack className=\"gap-1 items-center\">\n                  <Text className=\"text-phase-secondary text-lg\">ΓåÉ</Text>\n                  <ButtonText className=\"text-phase-secondary text-sm\">Back</ButtonText>\n                </HStack>\n              </Button>\n            </Box>\n          )}\n\n          <VStack className=\"gap-5 items-center pt-4\">\n            <BreathAnimation delay={100}>\n              <LivingGlow\n                active\n                size={132}\n                style={{ alignItems: 'center', justifyContent: 'center' }}\n              >\n                <VStack className=\"gap-2 items-center\">\n                  <Box\n                    className=\"px-4 py-1 rounded-full border\"\n                    style={{\n                      backgroundColor: `${accent.action}12`,\n                      borderColor: `${accent.action}28`,\n                    }}\n                  >\n                    <Text\n                      className=\"text-[10px] font-bold tracking-[0.5px]\"\n                      style={{ color: accent.action }}\n                    >\n                      ENTER THE SANCTUARY\n                    </Text>\n                  </Box>\n                  <Heading\n                    size=\"3xl\"\n                    className=\"text-center font-bold tracking-[-1.2px]\"\n                    style={{ color: text.primary }}\n                  >\n                    Gurudevi\n                  </Heading>\n                </VStack>\n              </LivingGlow>\n            </BreathAnimation>\n            <BreathAnimation delay={200}>\n              <Text className=\"text-phase-secondary text-center max-w-[320px]\">\n                {t('auth.tagline') || 'Enter the Sanctuary of Learning'}\n              </Text>\n            </BreathAnimation>\n            <HStack className=\"gap-2 flex-wrap justify-center\">\n              {ENTRY_PILLARS.map((pillar) => (\n                <Box\n                  key={pillar}\n                  className=\"px-2 py-1 rounded-full border bg-phase-surface border-phase-border\"\n                >\n                  <Text className=\"text-[10px] text-phase-secondary font-bold\">{pillar}</Text>\n                </Box>\n              ))}\n            </HStack>\n          </VStack>\n\n          <Box\n            className=\"p-0 overflow-hidden border-t-4 bg-phase-surface border-phase-border rounded-3xl\"\n            style={{ borderTopColor: accent.action }}\n          >\n            <VStack className=\"gap-6 p-6\">\n              <Box className=\"p-5 rounded-2xl bg-phase-surface/40 border border-phase-border\">\n                <VStack className=\"gap-2\">\n                  <Text className=\"text-[10px] text-phase-muted font-bold tracking-widest uppercase\">\n                    SANCTUARY ENTRY\n                  </Text>\n                  <Heading size=\"sm\" className=\"text-phase-primary\">\n                    {isSignUp ? 'Begin with a held identity' : 'Return to your learning sanctuary'}\n                  </Heading>\n                  <Text className=\"text-phase-secondary text-sm\">\n                    {isSignUp\n                      ? 'Choose the path that feels easiest now. You can start with Google or move more slowly with email.'\n                      : 'Reconnect with your profile, invitations, and saved learning flow without losing where you were.'}\n                  </Text>\n                </VStack>\n              </Box>\n\n              {!shouldHideGeneralAuth && (\n                <HStack\n                  className=\"p-1 rounded-full items-center self-center border border-phase-border\"\n                  style={{ backgroundColor: `${accent.muted}20` }}\n                >\n                  <Button\n                    variant=\"ghost\"\n                    className=\"px-6 py-2 rounded-full h-auto\"\n                    style={{\n                      backgroundColor: isSignUp ? accent.action : 'transparent',\n                    }}\n                    onPress={() => {\n                      hapticLight();\n                      setIsSignUp(true);\n                      setShowEmailAuth(false);\n                      setErrors({});\n                    }}\n                  >\n                    <ButtonText\n                      className=\"text-sm font-bold\"\n                      style={{ color: isSignUp ? '#000' : text.secondary }}\n                    >\n                      {t('auth.signup') || 'Sign Up'}\n                    </ButtonText>\n                  </Button>\n                  <Button\n                    variant=\"ghost\"\n                    className=\"px-6 py-2 rounded-full h-auto\"\n                    style={{\n                      backgroundColor: !isSignUp ? accent.action : 'transparent',\n                    }}\n                    onPress={() => {\n                      hapticLight();\n                      setIsSignUp(false);\n                      setShowEmailAuth(false);\n                      setErrors({});\n                    }}\n                  >\n                    <ButtonText\n                      className=\"text-sm font-bold\"\n                      style={{ color: !isSignUp ? '#000' : text.secondary }}\n                    >\n                      {t('auth.login') || 'Log In'}\n                    </ButtonText>\n                  </Button>\n                </HStack>\n              )}\n\n              {!showEmailAuth && !shouldHideGeneralAuth && (\n                <BreathAnimation delay={400}>\n                  <VStack className=\"gap-5\">\n                    <VStack className=\"gap-1\">\n                      <Text className=\"text-[10px] text-phase-muted font-bold tracking-widest uppercase\">\n                        CHOOSE YOUR PATH\n                      </Text>\n                      <Text className=\"text-phase-secondary\">\n                        Keep moving with Google, or enter with an email and password.\n                      </Text>\n                    </VStack>\n                    <Button\n                      size=\"lg\"\n                      onPress={() => handleOAuthSignIn('google')}\n                      isDisabled={loading}\n                      className=\"h-16 rounded-2xl w-full\"\n                      style={{ backgroundColor: accent.action }}\n                    >\n                      <HStack className=\"gap-3 items-center\">\n                        <Box className=\"p-2 rounded-full bg-white\">\n                          <GoogleIcon size={24} />\n                        </Box>\n                        <ButtonText className=\"text-lg font-bold\" style={{ color: '#000' }}>\n                          {isSignUp ? 'Sign up with Google' : t('auth.signInWithGoogle')}\n                        </ButtonText>\n                      </HStack>\n                    </Button>\n                    <Button\n                      size=\"lg\"\n                      variant=\"outline\"\n                      onPress={() => {\n                        hapticLight();\n                        setShowEmailAuth(true);\n                      }}\n                      isDisabled={loading}\n                      className=\"h-[54px] rounded-2xl border-phase-border bg-transparent\"\n                    >\n                      <HStack className=\"gap-2 items-center\">\n                        <Mail size={18} color={text.primary} />\n                        <ButtonText className=\"text-phase-primary font-medium\">\n                          {isSignUp\n                            ? t('auth.signUpWithEmail') || 'Sign up with email'\n                            : t('auth.signInWithEmail') || 'Sign in with email'}\n                        </ButtonText>\n                      </HStack>\n                    </Button>\n                  </VStack>\n                </BreathAnimation>\n              )}\n\n              {showEmailAuth && (\n                <BreathAnimation delay={400}>\n                  <Box className=\"p-6 rounded-2xl bg-phase-surface border border-phase-border\">\n                    <VStack className=\"gap-6 w-full\">\n                      <VStack className=\"gap-1\">\n                        <Text className=\"text-[10px] text-phase-muted font-bold tracking-widest uppercase\">\n                          EMAIL PATH\n                        </Text>\n                        <Heading size=\"md\" className=\"text-phase-primary\">\n                          {isSignUp ? t('auth.createAccount') : t('auth.signInEmail')}\n                        </Heading>\n                      </VStack>\n\n                      <VStack className=\"gap-4\">\n                        <Input className=\"rounded-xl border-phase-border bg-phase-surface\">\n                          <InputField\n                            placeholder={t('auth.email')}\n                            value={email}\n                            onChangeText={setEmail}\n                            keyboardType=\"email-address\"\n                            autoComplete=\"email\"\n                            className=\"text-phase-primary\"\n                            placeholderTextColor={text.muted}\n                            returnKeyType=\"next\"\n                            onSubmitEditing={() => passwordRef.current?.focus()}\n                            blurOnSubmit={false}\n                          />\n                        </Input>\n                        <Input className=\"rounded-xl border-phase-border bg-phase-surface\">\n                          <InputField\n                            ref={passwordRef}\n                            placeholder={t('auth.password')}\n                            value={password}\n                            onChangeText={setPassword}\n                            secureTextEntry\n                            autoComplete={isSignUp ? 'new-password' : 'current-password'}\n                            className=\"text-phase-primary\"\n                            placeholderTextColor={text.muted}\n                            returnKeyType=\"go\"\n                            onSubmitEditing={handleAuth}\n                          />\n                        </Input>\n\n                        <Button\n                          size=\"lg\"\n                          onPress={handleAuth}\n                          isDisabled={loading}\n                          className=\"h-[56px] rounded-xl mt-2\"\n                          style={{ backgroundColor: accent.action }}\n                        >\n                          {loading ? (\n                            <ButtonSpinner color=\"#000\" />\n                          ) : (\n                            <ButtonText className=\"font-bold\" style={{ color: '#000' }}>\n                              {isSignUp ? t('auth.signUp') : t('auth.signIn')}\n                            </ButtonText>\n                          )}\n                        </Button>\n\n                        <Button\n                          variant=\"ghost\"\n                          onPress={() => {\n                            setShowEmailAuth(false);\n                            setErrors({});\n                          }}\n                          className=\"self-center\"\n                        >\n                          <ButtonText className=\"text-phase-secondary text-sm\">\n                            {t('auth.useDifferentMethod') || 'Use a different method'}\n                          </ButtonText>\n                        </Button>\n                      </VStack>\n                    </VStack>\n                  </Box>\n                </BreathAnimation>\n              )}\n\n              {!shouldHideGeneralAuth && !showEmailAuth && !isSignUp && (\n                <Box\n                  className=\"px-4 py-3 rounded-xl border\"\n                  style={{\n                    backgroundColor: `${text.secondary}12`,\n                    borderColor: `${text.secondary}28`,\n                  }}\n                >\n                  <Text className=\"text-phase-secondary text-sm\">\n                    You can still continue gently as a guest and create an account later when you\n                    want your sanctuary identity to persist.\n                  </Text>\n                </Box>\n              )}\n\n              {errors._form ? (\n                <Box\n                  className=\"px-4 py-3 rounded-xl border\"\n                  style={{\n                    backgroundColor: `${accent.danger}12`,\n                    borderColor: `${accent.danger}24`,\n                  }}\n                >\n                  <Text className=\"text-sm\" style={{ color: accent.danger }}>\n                    {errors._form as string}\n                  </Text>\n                </Box>\n              ) : null}\n            </VStack>\n          </Box>\n\n          <VStack className=\"gap-2 items-center mt-4\">\n            <Button variant=\"ghost\" className=\"h-auto\">\n              <ButtonText className=\"text-phase-muted text-xs underline\">\n                {t('auth.privacyTerms') || 'Your progress is protected by our sanctuary protocols.'}\n              </ButtonText>\n            </Button>\n          </VStack>\n        </VStack>\n      </Box>\n\n      {Scanner && (\n        <Scanner\n          visible={showScanner}\n          onClose={() => setShowScanner(false)}\n          onScan={async (data) => {\n            hapticSuccess();\n            setShowScanner(false);\n            const userId = await identityAPI.getMyInternalId();\n            if (!userId) {\n              showToast({ message: 'Please sign in first to use QR codes', type: 'error' });\n              return;\n            }\n            const result = await FlowResolver.resolveQR(JSON.parse(data), userId);\n            if (result.outcome === 'error') {\n              showToast({ message: result.message || 'Unrecognized QR', type: 'error' });\n              return;\n            }\n            showToast({ message: result.message, type: 'success' });\n          }}\n          title=\"Scan Invite Code\"\n        />\n      )}\n      <GuestDataSyncModal\n        isOpen={showSyncModal}\n        userId={newUserId}\n        onSyncComplete={() => {\n          setShowSyncModal(false);\n          if (onSuccess) onSuccess();\n        }}\n        onClose={() => {\n          setShowSyncModal(false);\n        }}\n      />\n    </ScreenWrapper>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\Naween\\projects\\polymath-platform\\packages\\ui\\src\\screens\\AuthScreen.web.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'Pressable' is defined but never used.","line":14,"column":3,"nodeType":"Identifier","messageId":"unusedVar","endLine":14,"endColumn":12,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"Pressable"},"fix":{"range":[270,283],"text":""},"desc":"Remove unused variable \"Pressable\"."}]},{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'Center' is defined but never used.","line":15,"column":3,"nodeType":"Identifier","messageId":"unusedVar","endLine":15,"endColumn":9,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"Center"},"fix":{"range":[283,293],"text":""},"desc":"Remove unused variable \"Center\"."}]},{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'accent' is assigned a value but never used.","line":40,"column":18,"nodeType":"Identifier","messageId":"unusedVar","endLine":40,"endColumn":24},{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'text' is assigned a value but never used.","line":40,"column":26,"nodeType":"Identifier","messageId":"unusedVar","endLine":40,"endColumn":30},{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'surfaceToken' is assigned a value but never used.","line":41,"column":9,"nodeType":"Identifier","messageId":"unusedVar","endLine":41,"endColumn":21},{"ruleId":"@typescript-eslint/no-explicit-any","severity":1,"message":"Unexpected any. Specify a different type.","line":83,"column":19,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":83,"endColumn":22,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[2565,2568],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[2565,2568],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":1,"message":"Unexpected any. Specify a different type.","line":89,"column":28,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":89,"endColumn":31,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[2740,2743],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[2740,2743],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":1,"message":"Unexpected any. Specify a different type.","line":129,"column":19,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":129,"endColumn":22,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[3796,3799],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[3796,3799],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":1,"message":"Unexpected any. Specify a different type.","line":135,"column":28,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":135,"endColumn":31,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[3971,3974],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[3971,3974],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":1,"message":"Unexpected any. Specify a different type.","line":147,"column":19,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":147,"endColumn":22,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[4213,4216],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[4213,4216],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":10,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { useState } from 'react';\nimport { useTranslation } from 'react-i18next';\nimport { supabase, validators, validateForm, handleAPIError } from '@repo/core';\nimport {\n  Box,\n  VStack,\n  HStack,\n  Text,\n  Heading,\n  Button,\n  ButtonText,\n  Input,\n  InputField,\n  Pressable,\n  Center,\n  ButtonSpinner,\n} from '../gluestack';\nimport { useTheme } from '../hooks/useTheme';\nimport { useSanctuaryToast } from '../providers/ToastProvider';\nimport { SanctuaryBackground } from '../components/SanctuaryBackground';\nimport { BreathAnimation } from '../components/BreathAnimation';\nimport { LivingGlow } from '../components/LivingGlow';\n\ninterface AuthScreenProps {\n  onContinueAsGuest?: () => void;\n  onSuccess?: () => void;\n  onBack?: () => void;\n  initialMode?: 'login' | 'signup';\n}\n\nconst ENTRY_PILLARS = ['Self', 'Classroom', 'Community', 'Library'];\n\nexport function AuthScreenWeb({\n  onContinueAsGuest,\n  onSuccess,\n  onBack,\n  initialMode,\n}: AuthScreenProps) {\n  const { t } = useTranslation();\n  const { scene, accent, text } = useTheme();\n  const surfaceToken = scene.surface;\n  const { showToast } = useSanctuaryToast();\n\n  const [mode, setMode] = useState<'signup' | 'login'>(\n    initialMode === 'login' ? 'login' : 'signup',\n  );\n  const [showEmailForm, setShowEmailForm] = useState(initialMode === 'login');\n  const [email, setEmail] = useState('');\n  const [password, setPassword] = useState('');\n  const [loading, setLoading] = useState(false);\n  const [errors, setErrors] = useState<Record<string, string>>({});\n\n  const modeCopy =\n    mode === 'signup'\n      ? {\n          eyebrow: 'Create your sanctuary identity',\n          title: 'Begin inside Gurudevi',\n          subtitle:\n            'Keep your first step calm, luminous, and connected to your learning sanctuary.',\n          primary: 'Create Account',\n          google: 'Continue with Google',\n          email: 'Continue with Email',\n        }\n      : {\n          eyebrow: 'Return to your sanctuary',\n          title: 'Welcome back to Gurudevi',\n          subtitle:\n            'Pick up your journey where you left it across self, classroom, community, and library.',\n          primary: 'Log In',\n          google: 'Sign in with Google',\n          email: 'Sign in with Email',\n        };\n\n  const handleGoogleAuth = async () => {\n    setLoading(true);\n    setErrors({});\n    try {\n      const { error } = await supabase.auth.signInWithOAuth({\n        provider: 'google',\n        options: { redirectTo: window.location.origin },\n      });\n      if (error) throw error;\n    } catch (err: any) {\n      const apiError = handleAPIError(err);\n      showToast({\n        message:\n          typeof apiError === 'string'\n            ? apiError\n            : (apiError as any).message || 'Google sign-in failed',\n        type: 'error',\n      });\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  const handleEmailAuth = async () => {\n    setLoading(true);\n    setErrors({});\n\n    const validation = validateForm(\n      { email, password },\n      { email: validators.email, password: (val) => validators.nonEmpty(val, 'Password') },\n    );\n\n    if (!validation.isValid) {\n      setErrors(validation.errors);\n      setLoading(false);\n      return;\n    }\n\n    try {\n      if (mode === 'signup') {\n        const { error } = await supabase.auth.signUp({\n          email,\n          password,\n          options: { emailRedirectTo: window.location.origin },\n        });\n        if (error) throw error;\n        showToast({\n          message: t('auth.checkEmail') || 'Check your email to confirm your account',\n          type: 'success',\n        });\n      } else {\n        const { error } = await supabase.auth.signInWithPassword({ email, password });\n        if (error) throw error;\n        onSuccess?.();\n      }\n    } catch (err: any) {\n      const apiError = handleAPIError(err);\n      showToast({\n        message:\n          typeof apiError === 'string'\n            ? apiError\n            : (apiError as any).message || 'Authentication failed',\n        type: 'error',\n      });\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  const handleGuest = async () => {\n    setLoading(true);\n    try {\n      onContinueAsGuest?.();\n    } catch (err: any) {\n      showToast({\n        message: err.message || 'Guest mode failed',\n        type: 'error',\n      });\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  return (\n    <Box className=\"flex-1 min-h-screen relative overflow-hidden bg-phase-world\">\n      <SanctuaryBackground />\n\n      <Box className=\"flex-1 z-10 w-full max-w-[1180px] mx-auto p-8 lg:p-12\">\n        <Box className=\"grid grid-cols-1 lg:grid-cols-[1.15fr_0.85fr] gap-7 items-stretch min-h-[calc(100vh-120px)]\">\n          {/* Story Section */}\n          <Box className=\"rounded-[40px] border border-phase-border bg-phase-surface/40 overflow-hidden relative\">\n            <VStack className=\"h-full p-8 lg:p-12 justify-between gap-8\">\n              <VStack className=\"gap-8\">\n                <Box className=\"px-4 py-2 rounded-full border border-phase-border bg-phase-surface/60 w-fit\">\n                  <Text className=\"text-[12px] font-bold tracking-[0.08em] uppercase text-phase-secondary\">\n                    Gurudevi Sanctuary\n                  </Text>\n                </Box>\n\n                <VStack className=\"gap-6\">\n                  <LivingGlow active size={132} className=\"items-center justify-center p-0\">\n                    <Box className=\"w-[76px] h-[76px] rounded-[24px] bg-phase-surface items-center justify-center shadow-lg border border-phase-border\">\n                      <Text className=\"text-3xl text-phase-primary\">Γ£ª</Text>\n                    </Box>\n                  </LivingGlow>\n\n                  <VStack className=\"gap-4\">\n                    <Text className=\"text-[12px] font-extrabold tracking-[0.12em] uppercase text-phase-secondary\">\n                      {modeCopy.eyebrow}\n                    </Text>\n                    <Heading className=\"text-5xl lg:text-7xl font-bold tracking-[-0.07em] text-phase-primary leading-[0.95]\">\n                      {modeCopy.title}\n                    </Heading>\n                    <Text className=\"text-lg text-phase-secondary max-w-md leading-relaxed\">\n                      {modeCopy.subtitle}\n                    </Text>\n                  </VStack>\n                </VStack>\n\n                <HStack className=\"gap-2 flex-wrap\">\n                  {ENTRY_PILLARS.map((pillar) => (\n                    <Box\n                      key={pillar}\n                      className=\"px-4 py-2 rounded-full border border-phase-border bg-phase-surface/60\"\n                    >\n                      <Text className=\"text-[12px] font-bold tracking-wider text-phase-secondary\">\n                        {pillar}\n                      </Text>\n                    </Box>\n                  ))}\n                </HStack>\n              </VStack>\n\n              <Box className=\"rounded-3xl border border-phase-border bg-phase-surface/80 p-8\">\n                <VStack className=\"gap-6\">\n                  <VStack className=\"gap-2\">\n                    <Text className=\"text-[11px] font-extrabold tracking-[0.12em] uppercase text-phase-muted\">\n                      Why this step matters\n                    </Text>\n                    <Text className=\"text-phase-primary leading-relaxed text-base\">\n                      Your account keeps learning, invitations, and profile presence gathered into\n                      one living place without changing how you use the app.\n                    </Text>\n                  </VStack>\n                  <Box className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n                    <VStack className=\"p-4 rounded-2xl bg-phase-surface/50 border border-phase-border gap-1\">\n                      <Text className=\"font-bold text-phase-primary\">Gentle entry</Text>\n                      <Text className=\"text-sm text-phase-secondary\">\n                        Start with Google or email.\n                      </Text>\n                    </VStack>\n                    <VStack className=\"p-4 rounded-2xl bg-phase-surface/50 border border-phase-border gap-1\">\n                      <Text className=\"font-bold text-phase-primary\">Guest-safe</Text>\n                      <Text className=\"text-sm text-phase-secondary\">\n                        Browse first when logging in later feels better.\n                      </Text>\n                    </VStack>\n                  </Box>\n                </VStack>\n              </Box>\n            </VStack>\n          </Box>\n\n          {/* Panel Section */}\n          <Box className=\"rounded-[40px] border border-phase-border bg-phase-surface/80 shadow-2xl overflow-hidden relative\">\n            <VStack className=\"h-full p-8 lg:p-12 justify-center gap-8\">\n              {onBack && (\n                <Button variant=\"ghost\" onPress={onBack} className=\"self-start pl-0\">\n                  <HStack className=\"gap-2 items-center\">\n                    <Text className=\"text-phase-secondary text-lg\">ΓåÉ</Text>\n                    <ButtonText className=\"text-phase-secondary\">Back</ButtonText>\n                  </HStack>\n                </Button>\n              )}\n\n              <VStack className=\"gap-6\">\n                <VStack className=\"gap-2\">\n                  <Text className=\"text-[11px] font-extrabold tracking-[0.12em] uppercase text-phase-secondary\">\n                    {mode === 'signup' ? 'Identity' : 'Return'}\n                  </Text>\n\n                  <HStack className=\"p-1 rounded-full bg-phase-surface/50 border border-phase-border w-fit\">\n                    <Button\n                      variant=\"ghost\"\n                      className={`px-6 py-2 rounded-full h-auto ${mode === 'signup' ? 'bg-phase-world' : ''}`}\n                      onPress={() => {\n                        setMode('signup');\n                        setShowEmailForm(false);\n                        setErrors({});\n                      }}\n                    >\n                      <ButtonText\n                        className={`text-sm font-bold ${mode === 'signup' ? 'text-phase-primary' : 'text-phase-secondary'}`}\n                      >\n                        Sign Up\n                      </ButtonText>\n                    </Button>\n                    <Button\n                      variant=\"ghost\"\n                      className={`px-6 py-2 rounded-full h-auto ${mode === 'login' ? 'bg-phase-world' : ''}`}\n                      onPress={() => {\n                        setMode('login');\n                        setShowEmailForm(true);\n                        setErrors({});\n                      }}\n                    >\n                      <ButtonText\n                        className={`text-sm font-bold ${mode === 'login' ? 'text-phase-primary' : 'text-phase-secondary'}`}\n                      >\n                        Log In\n                      </ButtonText>\n                    </Button>\n                  </HStack>\n                </VStack>\n\n                <VStack className=\"gap-3\">\n                  <Heading className=\"text-3xl lg:text-4xl font-bold tracking-tight text-phase-primary\">\n                    {mode === 'signup' ? 'Choose your path in' : 'Reconnect with'} Gurudevi\n                  </Heading>\n                  <Text className=\"text-phase-secondary leading-relaxed\">\n                    {mode === 'signup'\n                      ? 'Create a held, cross-device identity when you are ready.'\n                      : 'Use the path that already belongs to you.'}\n                  </Text>\n                </VStack>\n              </VStack>\n\n              <VStack className=\"gap-4 w-full\">\n                <Button\n                  size=\"lg\"\n                  onPress={handleGoogleAuth}\n                  isDisabled={loading}\n                  className=\"h-[60px] rounded-2xl bg-phase-primary shadow-xl hover:translate-y-[-1px] transition-transform\"\n                >\n                  <HStack className=\"gap-3 items-center\">\n                    <Box className=\"w-7 h-7 rounded-full bg-white items-center justify-center\">\n                      <Text className=\"text-[#4285F4] font-black\">G</Text>\n                    </Box>\n                    <ButtonText className=\"text-phase-world font-bold\">\n                      {modeCopy.google}\n                    </ButtonText>\n                  </HStack>\n                </Button>\n\n                {!showEmailForm && (\n                  <Button\n                    size=\"lg\"\n                    variant=\"outline\"\n                    onPress={() => setShowEmailForm(true)}\n                    className=\"h-[60px] rounded-2xl border-phase-border bg-phase-surface/50\"\n                  >\n                    <ButtonText className=\"text-phase-primary\">{modeCopy.email}</ButtonText>\n                  </Button>\n                )}\n\n                {showEmailForm && (\n                  <BreathAnimation delay={100}>\n                    <VStack className=\"p-6 rounded-3xl bg-phase-surface/50 border border-phase-border gap-6\">\n                      <HStack className=\"justify-between items-baseline\">\n                        <Text className=\"font-bold text-phase-primary\">Email path</Text>\n                        <Text className=\"text-sm text-phase-muted\">\n                          {mode === 'signup' ? 'Create calmly' : 'Enter directly'}\n                        </Text>\n                      </HStack>\n\n                      <VStack className=\"gap-4\">\n                        <VStack className=\"gap-2\">\n                          <Text className=\"text-sm font-semibold text-phase-primary ml-1\">\n                            Email\n                          </Text>\n                          <Input className=\"rounded-2xl border-phase-border bg-phase-surface/80 h-[52px]\">\n                            <InputField\n                              placeholder=\"you@example.com\"\n                              value={email}\n                              onChangeText={setEmail}\n                              className=\"text-phase-primary\"\n                              autoComplete=\"email\"\n                            />\n                          </Input>\n                          {errors.email && (\n                            <Text className=\"text-xs text-phase-error ml-1\">{errors.email}</Text>\n                          )}\n                        </VStack>\n\n                        <VStack className=\"gap-2\">\n                          <Text className=\"text-sm font-semibold text-phase-primary ml-1\">\n                            Password\n                          </Text>\n                          <Input className=\"rounded-2xl border-phase-border bg-phase-surface/80 h-[52px]\">\n                            <InputField\n                              placeholder=\"Your password\"\n                              value={password}\n                              onChangeText={setPassword}\n                              secureTextEntry\n                              className=\"text-phase-primary\"\n                            />\n                          </Input>\n                          {errors.password && (\n                            <Text className=\"text-xs text-phase-error ml-1\">{errors.password}</Text>\n                          )}\n                        </VStack>\n\n                        <Button\n                          size=\"lg\"\n                          onPress={handleEmailAuth}\n                          isDisabled={loading}\n                          className=\"h-[56px] rounded-2xl bg-phase-primary mt-2\"\n                        >\n                          {loading ? (\n                            <ButtonSpinner className=\"text-phase-world\" />\n                          ) : (\n                            <ButtonText className=\"text-phase-world font-bold\">\n                              {modeCopy.primary}\n                            </ButtonText>\n                          )}\n                        </Button>\n\n                        <Button\n                          variant=\"ghost\"\n                          onPress={() => setShowEmailForm(false)}\n                          className=\"self-center\"\n                        >\n                          <ButtonText className=\"text-phase-secondary text-sm underline\">\n                            Back to Google\n                          </ButtonText>\n                        </Button>\n                      </VStack>\n                    </VStack>\n                  </BreathAnimation>\n                )}\n\n                {mode === 'login' && !showEmailForm && (\n                  <Button variant=\"ghost\" onPress={handleGuest} className=\"h-auto py-2\">\n                    <ButtonText className=\"text-phase-secondary font-medium\">\n                      Continue as Guest\n                    </ButtonText>\n                  </Button>\n                )}\n              </VStack>\n\n              {errors._form && (\n                <Box className=\"p-4 rounded-xl border border-phase-error/20 bg-phase-error/5\">\n                  <Text className=\"text-phase-error text-center text-sm\">{errors._form}</Text>\n                </Box>\n              )}\n            </VStack>\n          </Box>\n        </Box>\n      </Box>\n    </Box>\n  );\n}\n\nexport default AuthScreenWeb;\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\Naween\\projects\\polymath-platform\\packages\\ui\\src\\screens\\ErrorMessageDemo.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\Naween\\projects\\polymath-platform\\packages\\ui\\src\\screens\\NotificationsScreen.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\Naween\\projects\\polymath-platform\\packages\\ui\\src\\screens\\NotificationsScreen.web.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\Naween\\projects\\polymath-platform\\packages\\ui\\src\\screens\\OnboardingScreen.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'useEffect' is defined but never used.","line":1,"column":36,"nodeType":"Identifier","messageId":"unusedVar","endLine":1,"endColumn":45,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"useEffect"},"fix":{"range":[33,44],"text":""},"desc":"Remove unused variable \"useEffect\"."}]},{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'Theme' is defined but never used.","line":18,"column":10,"nodeType":"Identifier","messageId":"unusedVar","endLine":18,"endColumn":15,"suggestions":[{"messageId":"removeUnusedImportDeclaration","data":{"varName":"Theme"},"fix":{"range":[385,425],"text":""},"desc":"Remove unused import declaration."}]},{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'isAnonymous' is assigned a value but never used.","line":37,"column":3,"nodeType":"Identifier","messageId":"unusedVar","endLine":37,"endColumn":14},{"ruleId":"@typescript-eslint/no-explicit-any","severity":1,"message":"Unexpected any. Specify a different type.","line":40,"column":36,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":40,"endColumn":39,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[1255,1258],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[1255,1258],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'accent' is assigned a value but never used.","line":42,"column":11,"nodeType":"Identifier","messageId":"unusedVar","endLine":42,"endColumn":17},{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'text' is assigned a value but never used.","line":42,"column":19,"nodeType":"Identifier","messageId":"unusedVar","endLine":42,"endColumn":23},{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'isDark' is assigned a value but never used.","line":42,"column":25,"nodeType":"Identifier","messageId":"unusedVar","endLine":42,"endColumn":31},{"ruleId":"react-hooks/exhaustive-deps","severity":1,"message":"React Hook React.useEffect has a missing dependency: 'onComplete'. Either include it or remove the dependency array. If 'onComplete' changes too often, find the parent component that defines it and wrap that definition in useCallback.","line":164,"column":6,"nodeType":"ArrayExpression","endLine":164,"endColumn":8,"suggestions":[{"desc":"Update the dependencies array to be: [onComplete]","fix":{"range":[5733,5735],"text":"[onComplete]"}}]}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":8,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { useState, useMemo, useEffect } from 'react';\nimport {\n  Box,\n  Pressable,\n  VStack,\n  HStack,\n  Input,\n  InputField,\n  Button,\n  ButtonText,\n  Text,\n  Heading,\n  Center,\n} from '../gluestack';\nimport { useNavigation } from '@react-navigation/native';\nimport { useTranslation } from 'react-i18next';\nimport AsyncStorage from '@react-native-async-storage/async-storage';\nimport { Theme } from '../theme/Theme';\nimport { Role } from '@repo/core/logic';\nimport { supabase, identityAPI, authAPI } from '@repo/core/native';\nimport { hapticLight, hapticSuccess, hapticError } from '../utils/haptics';\nimport ScreenWrapper from '../components/ScreenWrapper';\nimport { useTheme } from '../hooks/useTheme';\nimport { useSanctuaryToast } from '../providers/ToastProvider';\nimport { ProgressIndicator } from '../components/ProgressIndicator';\n\nconst JOURNEY_PILLARS = ['Self', 'Classroom', 'Community', 'Library'];\nconst TOTAL_STEPS = 7;\n\ninterface OnboardingScreenProps {\n  onComplete: (name: string, role: Role, wantsAccount?: boolean) => void;\n  isAnonymous?: boolean;\n}\n\nexport default function OnboardingScreen({\n  onComplete,\n  isAnonymous = false,\n}: OnboardingScreenProps) {\n  const { t } = useTranslation();\n  const navigation = useNavigation<any>();\n  const theme = useTheme();\n  const { accent, text, isDark } = theme;\n  const [currentStep, setCurrentStep] = useState(0); // 0: Name, 1: Role, 2-6: Tour\n  const [name, setName] = useState('');\n  const [role, setRole] = useState<Role>('teacher');\n  const [isCompleting, setIsCompleting] = useState(false);\n  const toast = useSanctuaryToast();\n\n  const StepShell = ({\n    step,\n    title,\n    subtitle,\n    children,\n  }: {\n    step: string;\n    title: string;\n    subtitle: string;\n    children: React.ReactNode;\n  }) => (\n    <VStack className=\"flex-1 px-5 pt-5 pb-6\">\n      <Box\n        className=\"rounded-generous border border-phase-border bg-phase-secondary overflow-hidden elevation-4\"\n        style={{\n          shadowColor: '#6B6480', // shadowViolet\n          shadowOffset: { width: 0, height: 14 },\n          shadowOpacity: 0.1,\n          shadowRadius: 24,\n        }}\n      >\n        <Box className=\"px-6 py-6 bg-phase-surface border-b border-phase-border\">\n          <VStack className=\"gap-4\">\n            <HStack className=\"gap-2 flex-wrap\">\n              {JOURNEY_PILLARS.map((pillar) => (\n                <Box\n                  key={pillar}\n                  className=\"px-3 py-1 rounded-full bg-phase-canvas border border-phase-border\"\n                >\n                  <Text className=\"text-xs text-phase-text-secondary font-bold\">{pillar}</Text>\n                </Box>\n              ))}\n            </HStack>\n            <ProgressIndicator currentStep={currentStep} totalSteps={TOTAL_STEPS} />\n            <VStack className=\"gap-1\">\n              <Text className=\"text-xs text-phase-accent font-bold tracking-widest uppercase\">\n                {step}\n              </Text>\n              <Heading size=\"2xl\" className=\"text-phase-text-primary\">\n                {title}\n              </Heading>\n              <Text className=\"text-phase-text-secondary\">{subtitle}</Text>\n            </VStack>\n          </VStack>\n        </Box>\n        <Box className=\"px-6 py-8\">{children}</Box>\n      </Box>\n    </VStack>\n  );\n\n  // ΓöÇΓöÇ Restore saved progress or pre-fill from existing auth ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ\n  React.useEffect(() => {\n    const initOnboarding = async () => {\n      const internalId = await identityAPI.getMyInternalId();\n\n      // Try to restore mid-flow progress for this user\n      try {\n        const saved = await AsyncStorage.getItem('onboarding_progress');\n        if (saved) {\n          const progress = JSON.parse(saved);\n          if (!internalId || progress.userId === internalId) {\n            if (progress.name) setName(progress.name);\n            if (progress.role) setRole(progress.role as Role);\n            if (typeof progress.step === 'number' && progress.step >= 0 && progress.step < 7) {\n              setCurrentStep(progress.step);\n              return;\n            }\n          }\n        }\n      } catch {\n        /* ignore corrupt storage */\n      }\n\n      // No saved progress ΓÇö pre-fill for verified (non-anonymous) users with a real name\n      if (!internalId) {\n        // This is likely a deep-link where the session wasn't initialized yet.\n        // We trigger an anonymous sign-in here to ensure the wizard has an ID.\n        console.log('≡ƒº¡ OnboardingScreen: No internalId found, initiating anonymous session...');\n        await authAPI.signInAnonymously();\n        // Re-run the initialization once signed in\n        return initOnboarding();\n      }\n      const { data: profile } = await supabase\n        .from('users')\n        .select('full_name, is_anonymous, role, onboarding_completed')\n        .eq('id', internalId)\n        .maybeSingle();\n\n      if (!profile) return;\n\n      // Step 1.1: If already onboarded in DB, just finish locally\n      if (profile.onboarding_completed && profile.role) {\n        console.log('Γ£à Onboarding: Profile already marked as completed in DB, finalizing...');\n        setName(profile.full_name || '');\n        setRole(profile.role as Role);\n        onComplete(profile.full_name || '', profile.role as Role, false);\n        return;\n      }\n\n      const PLACEHOLDER_NAMES = ['Guest User', 'Gurudevi User', 'Sanctuary User'];\n      if (\n        !profile.is_anonymous &&\n        profile.full_name &&\n        !PLACEHOLDER_NAMES.includes(profile.full_name)\n      ) {\n        setName(profile.full_name);\n        if (profile.role) {\n          setRole(profile.role as Role);\n          setCurrentStep(1);\n        } else {\n          setCurrentStep(1);\n        }\n      }\n    };\n    initOnboarding();\n  }, []);\n\n  const tourScreens = useMemo(\n    () => [\n      {\n        emoji: '≡ƒÆá',\n        title: t('onboarding.philosophyTitle'),\n        subtitle: t('onboarding.philosophySubtitle'),\n        content: t('onboarding.philosophyContent'),\n      },\n      {\n        emoji: '≡ƒÅ½',\n        title: t('onboarding.sectionsTitle'),\n        subtitle: t('onboarding.sectionsSubtitle'),\n        content: t('onboarding.sectionsContent'),\n      },\n      {\n        emoji: '≡ƒî▒',\n        title: t('onboarding.ecologyTitle'),\n        subtitle: t('onboarding.ecologySubtitle'),\n        content: t('onboarding.ecologyContent'),\n      },\n      {\n        emoji: '≡ƒöÆ',\n        title: t('onboarding.privacyTitle'),\n        subtitle: t('onboarding.privacySubtitle'),\n        content: t('onboarding.privacyContent'),\n      },\n      {\n        emoji: '≡ƒº¡',\n        title: t('onboarding.navigationTitle'),\n        subtitle: t('onboarding.navigationSubtitle'),\n        content: t('onboarding.navigationContent'),\n      },\n    ],\n    [t],\n  );\n\n  // Steps: 0-Name, 1-Role, 2-6-Tour\n\n  const canProceed = currentStep === 0 ? name.trim().length > 0 : true;\n\n  // Save progress whenever step/name/role/seeds change (so app-close resumes correctly)\n  React.useEffect(() => {\n    if (currentStep === 0 && !name) return; // Nothing to save yet\n    identityAPI.getMyInternalId().then((userId) => {\n      AsyncStorage.setItem(\n        'onboarding_progress',\n        JSON.stringify({\n          userId,\n          step: currentStep,\n          name,\n          role,\n        }),\n      ).catch(() => {\n        /* silent */\n      });\n    });\n  }, [currentStep, name, role]);\n\n  const handleNext = async () => {\n    if (!canProceed) return;\n    hapticLight();\n\n    // If tour completed, finish onboarding\n    if (currentStep === 6) {\n      handleCompleteOnboarding();\n      return;\n    }\n\n    setCurrentStep((prev) => prev + 1);\n  };\n\n  const handleBack = () => {\n    hapticLight();\n    setCurrentStep((prev) => Math.max(0, prev - 1));\n  };\n\n  const handleSkipTour = () => {\n    hapticLight();\n    handleCompleteOnboarding();\n  };\n\n  const handleCompleteOnboarding = async () => {\n    setIsCompleting(true);\n    try {\n      const internalId = await identityAPI.getMyInternalId();\n      if (!internalId)\n        throw new Error('Failed to resolve internal user ID during onboarding completion');\n\n      hapticSuccess();\n\n      // Check if user already exists in public.users to avoid overwriting critical data\n      const { data: existingProfile } = await supabase\n        .from('users')\n        .select('school_id')\n        .eq('id', internalId)\n        .single();\n\n      // 1. Create a default school (Personal Workspace) only if they don't have one\n      let schoolId = existingProfile?.school_id;\n      if (!schoolId) {\n        const schoolName = `${name || 'My'}'s Workspace`;\n\n        // Note: The schools table currently has a broken trigger referencing\n        // \\\"create_personal_workspace_unified()\\\". We wrap this in a try/catch-style\n        // logic to ensure onboarding completes even if workspace creation fails.\n        const { data: schoolData, error: schoolError } = await supabase\n          .from('schools')\n          .insert({\n            name: schoolName,\n            type: 'personal_workspace',\n            created_by: internalId,\n          })\n          .select()\n          .single();\n\n        if (schoolError) {\n          console.warn(\n            'ΓÜá∩╕Å [Onboarding] Workspace creation failed (likely broken DB trigger):',\n            schoolError.message,\n          );\n          // We continue with schoolId = null. The app will render the \\\"Guest Gate\\\"\n          // (Join/Create Workspace) as a fallback, which is a stable state.\n        } else {\n          schoolId = schoolData?.id;\n          console.log('Γ£à [Onboarding] Personal workspace created:', schoolId);\n        }\n      }\n\n      // 2. Update user profile\n      const currentSession = await authAPI.getSession().catch(() => null);\n      const actuallyAnonymous = currentSession?.user?.is_anonymous ?? true;\n\n      const { error: profileError } = await supabase.from('users').upsert({\n        id: internalId,\n        full_name: name || 'Gurudevi User',\n        role: role,\n        school_id: schoolId,\n        onboarding_completed: true,\n        onboarding_completed_at: new Date().toISOString(),\n        is_anonymous: actuallyAnonymous,\n      });\n\n      if (profileError) {\n        console.error('Γ¥î Onboarding: Profile upsert failed:', profileError.message);\n        throw profileError;\n      }\n\n      console.log('Γ£à Onboarding: Profile successfully synced to DB.');\n\n      await AsyncStorage.removeItem('onboarding_progress');\n      onComplete(name, role, false);\n    } catch (error) {\n      console.error('Error completing onboarding:', error);\n      hapticError();\n      setIsCompleting(false);\n      toast.showToast({ message: 'Failed to save profile. Please try again.', type: 'error' });\n    }\n  };\n\n  // --- Renderers ---\n\n  const renderNameStep = () => (\n    <StepShell\n      step=\"STEP 1 ┬╖ ARRIVAL\"\n      title={t('onboarding.nameTitle') || 'Welcome! What should we call you?'}\n      subtitle={t('onboarding.nameSubtitle') || \"Let's start your journey with a name.\"}\n    >\n      <VStack className=\"gap-6\">\n        <Input className=\"rounded-comfortable border-phase-text-tertiary\">\n          <InputField\n            placeholder={t('onboarding.namePlaceholder')}\n            value={name}\n            onChangeText={setName}\n            className=\"text-phase-text-primary\"\n          />\n        </Input>\n        <Text className=\"text-phase-text-secondary text-sm\">\n          This name becomes the gentle way Gurudevi addresses you across your sanctuary surfaces.\n        </Text>\n        <Button\n          size=\"lg\"\n          onPress={handleNext}\n          isDisabled={!canProceed}\n          className=\"bg-phase-accent mt-2\"\n        >\n          <ButtonText className=\"text-phase-text-on-accent font-bold\">\n            {t('onboarding.continue')}\n          </ButtonText>\n        </Button>\n        <Button\n          variant=\"ghost\"\n          onPress={() => {\n            hapticLight();\n            if (navigation.canGoBack()) {\n              navigation.goBack();\n            } else {\n              navigation.reset({\n                index: 0,\n                routes: [{ name: 'Welcome' }],\n              });\n            }\n          }}\n          className=\"mt-1\"\n        >\n          <ButtonText className=\"text-phase-text-tertiary\">\n            {t('onboarding.backToWelcome') || 'Back to Welcome'}\n          </ButtonText>\n        </Button>\n      </VStack>\n    </StepShell>\n  );\n\n  const ROLE_OPTIONS: Array<{ value: Role; emoji: string; descKey: string }> = [\n    { value: 'teacher', emoji: '≡ƒºæΓÇì≡ƒÅ½', descKey: 'onboarding.roleDesc.teacher' },\n    { value: 'student', emoji: '≡ƒÄÆ', descKey: 'onboarding.roleDesc.student' },\n    { value: 'principal', emoji: '≡ƒÅ½', descKey: 'onboarding.roleDesc.principal' },\n  ];\n\n  const renderRoleStep = () => (\n    <VStack className=\"gap-6 mt-8 px-6\">\n      <ProgressIndicator currentStep={1} totalSteps={TOTAL_STEPS} />\n      <Heading size=\"2xl\" className=\"text-phase-accent text-center\">\n        {t('onboarding.roleTitle')}\n      </Heading>\n      <Text className=\"text-md text-phase-text-secondary text-center\">\n        {t('onboarding.roleSubtitle')}\n      </Text>\n      <VStack className=\"gap-4\">\n        {ROLE_OPTIONS.map((r) => {\n          const selected = role === r.value;\n          return (\n            <Pressable\n              key={r.value}\n              onPress={() => {\n                setRole(r.value);\n                hapticLight();\n              }}\n              accessibilityRole=\"radio\"\n              accessibilityState={{ selected }}\n              className={`\n                                border-2 rounded-comfortable p-4 flex-row items-center\n                                ${selected ? 'border-phase-accent bg-phase-accent/10' : 'border-phase-border bg-phase-secondary'}\n                            `}\n            >\n              <Text className=\"text-2xl mr-3\">{r.emoji}</Text>\n              <VStack className=\"flex-1\">\n                <Text\n                  className={`text-md font-bold ${selected ? 'text-phase-accent' : 'text-phase-text-primary'}`}\n                >\n                  {t(`role.${r.value}`)}\n                </Text>\n                <Text className=\"text-sm text-phase-text-secondary\">{t(r.descKey)}</Text>\n              </VStack>\n              {selected && (\n                <Box className=\"w-5.5 h-5.5 rounded-full bg-phase-accent items-center justify-center\">\n                  <Text className=\"text-xs text-phase-text-on-accent\">Γ£ô</Text>\n                </Box>\n              )}\n            </Pressable>\n          );\n        })}\n      </VStack>\n      <HStack className=\"gap-4 mt-6\">\n        <Button variant=\"outline\" onPress={handleBack} className=\"flex-1 border-phase-border\">\n          <ButtonText className=\"text-phase-text-primary\">{t('onboarding.back')}</ButtonText>\n        </Button>\n        <Button onPress={handleNext} className=\"bg-phase-accent flex-[2]\">\n          <ButtonText className=\"text-phase-text-on-accent font-bold\">\n            {t('onboarding.continue')}\n          </ButtonText>\n        </Button>\n      </HStack>\n    </VStack>\n  );\n\n  const renderTourStep = (index: number) => {\n    const tourIdx = index - 2; // steps 2-6 map to tour screens 0-4\n    const screen = tourScreens[tourIdx];\n    if (!screen) return null;\n\n    return (\n      <VStack className=\"gap-6 mt-8 px-6 flex-1\">\n        <ProgressIndicator currentStep={index} totalSteps={TOTAL_STEPS} />\n        <VStack className=\"gap-4 items-center\">\n          <Text className=\"text-6xl text-center leading-[80px]\" accessible={false}>\n            {screen.emoji}\n          </Text>\n          <Heading size=\"2xl\" className=\"text-phase-accent text-center\" accessibilityRole=\"header\">\n            {screen.title}\n          </Heading>\n          <Text className=\"text-phase-text-secondary text-center text-lg font-bold\">\n            {screen.subtitle}\n          </Text>\n          <Box className=\"flex-1 justify-center py-4\">\n            <Text className=\"text-center text-phase-text-primary text-md leading-relaxed\">\n              {screen.content}\n            </Text>\n          </Box>\n        </VStack>\n        <VStack className=\"gap-4 mt-auto pb-6\">\n          <HStack className=\"gap-4\">\n            <Button variant=\"outline\" onPress={handleBack} className=\"flex-1 border-phase-border\">\n              <ButtonText className=\"text-phase-text-primary\">{t('onboarding.back')}</ButtonText>\n            </Button>\n            <Button onPress={handleNext} className=\"bg-phase-accent flex-[2]\">\n              <ButtonText className=\"text-phase-text-on-accent font-bold\">\n                {index === 6 ? t('onboarding.finish') : t('onboarding.next')}\n              </ButtonText>\n            </Button>\n          </HStack>\n          <Button variant=\"ghost\" onPress={handleSkipTour}>\n            <ButtonText className=\"text-phase-text-tertiary\">{t('onboarding.skip')}</ButtonText>\n          </Button>\n        </VStack>\n      </VStack>\n    );\n  };\n\n  return (\n    <ScreenWrapper>\n      <Box className=\"flex-1 bg-phase-world\">\n        {/* Decorative Elements */}\n        <Box className=\"absolute -top-12 -right-10 w-44 h-44 rounded-full bg-phase-accent/10\" />\n        <Box className=\"absolute -left-5 bottom-24 w-40 h-40 rounded-full bg-gurudeviBlue/10\" />\n\n        <VStack className=\"flex-1\">\n          <VStack className=\"px-6 pt-5 pb-2 gap-2\">\n            <HStack className=\"gap-2 flex-wrap\">\n              {JOURNEY_PILLARS.map((pillar) => (\n                <Box\n                  key={pillar}\n                  className=\"px-3 py-1 rounded-full bg-phase-secondary/80 border border-phase-border\"\n                >\n                  <Text className=\"text-xs text-phase-text-secondary font-bold\">{pillar}</Text>\n                </Box>\n              ))}\n            </HStack>\n            <Text className=\"text-xs text-phase-accent font-bold tracking-widest uppercase\">\n              SANCTUARY JOURNEY\n            </Text>\n          </VStack>\n\n          {isCompleting ? (\n            <Center className=\"flex-1\">\n              <Text className=\"text-phase-text-primary\">Finalizing your sanctuary...</Text>\n            </Center>\n          ) : (\n            <>\n              {currentStep === 0 && renderNameStep()}\n              {currentStep === 1 && renderRoleStep()}\n              {currentStep >= 2 && currentStep <= 6 && renderTourStep(currentStep)}\n            </>\n          )}\n        </VStack>\n      </Box>\n    </ScreenWrapper>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\Naween\\projects\\polymath-platform\\packages\\ui\\src\\screens\\OnboardingScreen.web.tsx","messages":[{"ruleId":"@typescript-eslint/no-explicit-any","severity":1,"message":"Unexpected any. Specify a different type.","line":312,"column":21,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":312,"endColumn":24,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[10683,10686],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[10683,10686],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"/**\n * ONBOARDING SCREEN - Web Edition\n *\n * ΓöîΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓö¼ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÉ\n * Γöé  LEFT PANEL (desktop)Γöé  RIGHT PANEL (always)       Γöé\n * Γöé  Branding + pillars  Γöé  Current step content       Γöé\n * Γöé  Step progress trackerΓöé  Input / Role / Tour / Auth Γöé\n * Γöé  Language selector   Γöé  Primary/Back actions       Γöé\n * ΓööΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓö┤ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÿ\n *\n * Flow:\n * 0. Name Entry\n * Narrow (< 900px): single-column scroll with compact header.\n * Same API as native: onComplete(name, role, wantsAccount?) and isAnonymous.\n * Roles: teacher ┬╖ student ┬╖ principal (NOT founder / admin / developer).\n */\n\nimport React, { useState, useMemo, useEffect } from 'react';\nimport { useWindowDimensions } from 'react-native';\nimport { useTranslation } from 'react-i18next';\nimport AsyncStorage from '@react-native-async-storage/async-storage';\nimport { AuthorityTier } from '@repo/core/logic';\nimport { identityAPI, authAPI, supabase } from '@repo/core/native';\n\nimport { hapticLight, hapticSuccess, hapticError } from '../utils/haptics';\n// Using direct i18n calls for language switching on web.\n\n// ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ\n// Constants\n// ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ\nconst LANGUAGES = [\n  { code: 'en', label: 'EN' },\n  { code: 'si', label: 'α╖âα╖Æα╢é' },\n  { code: 'ta', label: 'α«ñα««α«┐α«┤α»ì' },\n];\n\nconst PILLARS = [\n  { name: 'Self', emoji: '≡ƒºÿ' },\n  { name: 'Classroom', emoji: '≡ƒÅ½' },\n  { name: 'Community', emoji: '≡ƒñ¥' },\n  { name: 'Library', emoji: '≡ƒôÜ' },\n  { name: 'Profile', emoji: '≡ƒæñ' },\n];\n\nconst ROLES = [\n  { value: 'teacher', emoji: '≡ƒºæΓÇì≡ƒÅ½', descKey: 'onboarding.roleDesc.teacher' },\n  { value: 'student', emoji: '≡ƒÄô', descKey: 'onboarding.roleDesc.student' },\n  { value: 'principal', emoji: '≡ƒÅ½', descKey: 'onboarding.roleDesc.principal' },\n];\n\nconst TOTAL_STEPS = 7; // 0: Name, 1: Role, 2-6: Tour\n\n// Visible steps for the left-panel progress tracker\nconst TRACKED_STEPS = [\n  { idx: 0, label: 'Name' },\n  { idx: 1, label: 'Role' },\n  { idx: 2, label: 'Tour' },\n] as const;\n\n// ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ\n// Props\n// ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ\ninterface OnboardingScreenProps {\n  onComplete: (name: string, authority: AuthorityTier, wantsAccount?: boolean) => void;\n  isAnonymous?: boolean;\n}\n\n// ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ\n// Main Component\n// ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ\nexport default function OnboardingScreenWeb({\n  onComplete,\n  isAnonymous = false,\n}: OnboardingScreenProps) {\n  const { t, i18n } = useTranslation();\n  const { width } = useWindowDimensions();\n\n  const [currentStep, setCurrentStep] = useState(0);\n  const [name, setName] = useState('');\n  const [authority, setAuthority] = useState<AuthorityTier>('teacher');\n  const [isCompleting, setIsCompleting] = useState(false);\n  const [completionError, setCompletionError] = useState<string | null>(null);\n\n  const isNarrow = width < 900;\n\n  // ΓöÇΓöÇ Restore saved progress or pre-fill from existing auth ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ\n  useEffect(() => {\n    const initOnboarding = async () => {\n      try {\n        const internalId = await identityAPI.getMyInternalId();\n        try {\n          const saved = await AsyncStorage.getItem('onboarding_progress');\n          if (saved) {\n            const progress = JSON.parse(saved);\n            if (progress.userId === internalId || !progress.userId || isAnonymous) {\n              if (progress.name) setName(progress.name);\n              if (progress.role) setAuthority(progress.role as AuthorityTier);\n              if (typeof progress.step === 'number' && progress.step >= 0 && progress.step < 7) {\n                setCurrentStep(progress.step);\n                return;\n              }\n            }\n          }\n        } catch (e) {\n          console.warn('[Onboarding] Failed to restore progress from storage:', e);\n        }\n\n        if (!internalId) {\n          // This is likely a deep-link where the session wasn't initialized yet.\n          // We trigger an anonymous sign-in here to ensure the wizard has an ID.\n          console.log(\n            '≡ƒù¥∩╕Å OnboardingScreen.web: No internalId found, initiating anonymous session...',\n          );\n          await authAPI.signInAnonymously();\n          // Re-run the initialization once signed in\n          return initOnboarding();\n        }\n        const { data: profile } = await supabase\n          .from('users')\n          .select('full_name, is_anonymous, authority:role')\n          .eq('id', internalId)\n          .maybeSingle();\n\n        if (!profile) return;\n\n        const PLACEHOLDER_NAMES = ['Guest User', 'Gurudevi User', 'Sanctuary User'];\n        if (\n          !profile.is_anonymous &&\n          profile.full_name &&\n          !PLACEHOLDER_NAMES.includes(profile.full_name)\n        ) {\n          setName(profile.full_name);\n          if (profile.authority) setAuthority(profile.authority as AuthorityTier);\n          setCurrentStep(1);\n        }\n      } catch (error) {\n        console.error('[Onboarding] Initialization error:', error);\n      }\n    };\n    initOnboarding();\n  }, [isAnonymous]);\n\n  // ΓöÇΓöÇ Tour content ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ\n  const tourScreens = useMemo(\n    () => [\n      {\n        emoji: '≡ƒ¬╖',\n        title: t('onboarding.philosophyTitle'),\n        subtitle: t('onboarding.philosophySubtitle'),\n        content: t('onboarding.philosophyContent'),\n      },\n      {\n        emoji: '≡ƒÅ½',\n        title: t('onboarding.sectionsTitle'),\n        subtitle: t('onboarding.sectionsSubtitle'),\n        content: t('onboarding.sectionsContent'),\n      },\n      {\n        emoji: '≡ƒî▒',\n        title: t('onboarding.ecologyTitle'),\n        subtitle: t('onboarding.ecologySubtitle'),\n        content: t('onboarding.ecologyContent'),\n      },\n      {\n        emoji: '≡ƒöÆ',\n        title: t('onboarding.privacyTitle'),\n        subtitle: t('onboarding.privacySubtitle'),\n        content: t('onboarding.privacyContent'),\n      },\n      {\n        emoji: '≡ƒº¡',\n        title: t('onboarding.navigationTitle'),\n        subtitle: t('onboarding.navigationSubtitle'),\n        content: t('onboarding.navigationContent'),\n      },\n    ],\n    [t],\n  );\n\n  // ΓöÇΓöÇ Navigation helpers ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ\n  const handleNext = () => {\n    if (currentStep === 6) {\n      // Final step (Tour 4)\n      handleCompleteOnboarding();\n    } else {\n      setCurrentStep((prev) => prev + 1);\n      hapticLight();\n    }\n  };\n  const handleBack = () => {\n    hapticLight();\n    setCurrentStep((prev) => Math.max(0, prev - 1));\n  };\n  const handleSkipTour = () => {\n    hapticLight();\n    handleCompleteOnboarding();\n  };\n\n  // Save progress whenever step/name/role/seeds change\n  useEffect(() => {\n    if (currentStep === 0 && !name) return;\n    identityAPI.getMyInternalId().then((userId) => {\n      AsyncStorage.setItem(\n        'onboarding_progress',\n        JSON.stringify({\n          userId,\n          step: currentStep,\n          name,\n          authority,\n        }),\n      ).catch(() => {\n        /* silent */\n      });\n    });\n  }, [currentStep, name, authority]);\n\n  const changeLanguage = async (code: string) => {\n    hapticLight();\n    await i18n.changeLanguage(code);\n  };\n\n  // ΓöÇΓöÇ Complete onboarding ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ\n  const handleCompleteOnboarding = async () => {\n    console.log('≡ƒ¬╖ OnboardingScreen.web: handleCompleteOnboarding started...', {\n      name,\n      authority,\n      isAnonymous,\n    });\n    setIsCompleting(true);\n    try {\n      const internalId = await identityAPI.getMyInternalId();\n      console.log('Γ¡ò┬╖ [Onboarding] Resolved internalId:', internalId);\n\n      if (!internalId) {\n        console.error(\n          '[OnboardingScreen.web] No internal user ID ΓÇö anonymous session may not have been created yet.',\n        );\n        throw new Error('Failed to resolve internal user ID during onboarding completion');\n      }\n\n      // Verify if profile already exists\n      const { data: existingProfile, error: fetchError } = await supabase\n        .from('users')\n        .select('school_id, onboarding_completed')\n        .eq('id', internalId)\n        .maybeSingle();\n\n      if (fetchError) {\n        console.warn('Γ¡ò┬╖ [Onboarding] Error fetching existing profile:', fetchError);\n      }\n\n      console.log('Γ¡ò┬╖ [Onboarding] Existing profile state:', existingProfile);\n\n      let schoolId = existingProfile?.school_id;\n      if (!schoolId) {\n        console.log('≡ƒîÇ [Onboarding] No existing workspace found, attempting creation...');\n        const schoolName = `${name || 'My'}'s Workspace`;\n\n        // Note: The schools table currently has a broken trigger referencing\n        // \"create_personal_workspace_unified()\". We wrap this in a try/catch-style\n        // logic to ensure onboarding completes even if workspace creation fails.\n        const { data: schoolData, error: schoolError } = await supabase\n          .from('schools')\n          .insert({\n            name: schoolName,\n            type: 'personal_workspace',\n            created_by: internalId,\n          })\n          .select()\n          .single();\n\n        if (schoolError) {\n          console.warn(\n            'ΓÜá∩╕Å [Onboarding] Workspace creation failed (likely broken DB trigger):',\n            schoolError.message,\n          );\n          // We continue with schoolId = null. The app will render the \"Guest Gate\"\n          // (Join/Create Workspace) as a fallback, which is a stable state.\n        } else {\n          schoolId = schoolData?.id;\n          console.log('Γ£à [Onboarding] Personal workspace created:', schoolId);\n        }\n      }\n\n      console.log('Γ¡ò┬╖ [Onboarding] Finalizing profile update...');\n      const { error: profileError } = await supabase.from('users').upsert({\n        id: internalId,\n        full_name: name || 'Gurudevi User',\n        role: authority,\n        school_id: schoolId,\n        onboarding_completed: true,\n        onboarding_completed_at: new Date().toISOString(),\n        is_anonymous: isAnonymous,\n      });\n\n      if (profileError) {\n        console.error('Γ¡ò┬╖ [Onboarding] Profile update failed:', profileError);\n        throw profileError;\n      }\n\n      console.log('Γ¡ò┬╖ [Onboarding] Profile updated successfully. Cleaning up storage...');\n      await AsyncStorage.removeItem('onboarding_progress');\n\n      hapticSuccess();\n      console.log('Γ¡ò┬╖ [Onboarding] Calling onComplete callback...');\n\n      // Artificial delay to ensure DB replication / state synchronization\n      await new Promise((resolve) => setTimeout(resolve, 300));\n\n      onComplete(name, authority, false);\n      console.log('Γ¡ò┬╖ [Onboarding] onComplete called successfully.');\n    } catch (error: any) {\n      console.error('Γ¥î Error completing onboarding:', error);\n      hapticError();\n      setIsCompleting(false);\n      setCompletionError(error?.message || 'Failed to save your profile. Please try again.');\n    }\n  };\n\n  const renderError = () => {\n    if (!completionError) return null;\n    return (\n      <div className=\"ob-error-banner\">\n        <span className=\"ob-error-icon\">ΓÜá∩╕Å </span>\n        <span className=\"ob-error-text\">{completionError}</span>\n      </div>\n    );\n  };\n\n  // ΓöÇΓöÇ Step content renderer ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ\n  const renderStep = () => {\n    // Step 0: Name\n    if (currentStep === 0) {\n      return (\n        <div className=\"ob-step\">\n          <div className=\"ob-step-shell\">\n            <div className=\"ob-step-meta\">Step 1 ┬╖ Arrival</div>\n            <div className=\"ob-step-icon\">≡ƒæï≡ƒÅ╗</div>\n          </div>\n          <h2 className=\"ob-step-title\">{t('onboarding.nameTitle')}</h2>\n          <p className=\"ob-step-subtitle\">{t('onboarding.nameSubtitle')}</p>\n          {renderError()}\n          <input\n            className=\"ob-input\"\n            type=\"text\"\n            placeholder={t('onboarding.namePlaceholder')}\n            value={name}\n            onChange={(e) => setName(e.target.value)}\n            onKeyDown={(e) => {\n              if (e.key === 'Enter' && name.trim()) handleNext();\n            }}\n            autoFocus\n            autoComplete=\"given-name\"\n          />\n          <div className=\"ob-actions\">\n            <button className=\"ob-btn-primary\" onClick={handleNext} disabled={!name.trim()}>\n              {t('onboarding.continue')} ΓåÆ\n            </button>\n          </div>\n        </div>\n      );\n    }\n\n    // Step 1: Role\n    if (currentStep === 1) {\n      return (\n        <div className=\"ob-step\">\n          <div className=\"ob-step-shell\">\n            <div className=\"ob-step-meta\">Step 2 ┬╖ Belonging</div>\n            <div className=\"ob-step-icon\">≡ƒÄ»</div>\n          </div>\n          <h2 className=\"ob-step-title\">{t('onboarding.roleTitle')}</h2>\n          <p className=\"ob-step-subtitle\">{t('onboarding.roleSubtitle')}</p>\n          {renderError()}\n          <div className=\"ob-role-grid\">\n            {ROLES.map((r) => (\n              <button\n                key={r.value}\n                className={`ob-role-card ${authority === r.value ? 'selected' : ''}`}\n                onClick={() => {\n                  setAuthority(r.value as AuthorityTier);\n                  hapticLight();\n                }}\n              >\n                <span className=\"ob-role-emoji\">{r.emoji}</span>\n                <span className=\"ob-role-name\">{t(`authority.${r.value}`)}</span>\n                <span className=\"ob-role-desc\">{t(r.descKey)}</span>\n              </button>\n            ))}\n          </div>\n          <div className=\"ob-actions\">\n            <button className=\"ob-btn-secondary\" onClick={handleBack}>\n              ΓåÉ {t('onboarding.back')}\n            </button>\n            <button\n              className=\"ob-btn-primary\"\n              onClick={async () => {\n                if (!isAnonymous && authority) {\n                  // If already signed in (Google), jump straight to finish after picking role\n                  handleCompleteOnboarding();\n                } else {\n                  handleNext();\n                }\n              }}\n              disabled={isCompleting}\n            >\n              {isCompleting\n                ? t('onboarding.saving')\n                : !isAnonymous && authority\n                  ? t('onboarding.complete')\n                  : t('onboarding.continue')}{' '}\n              ΓåÆ\n            </button>\n          </div>\n        </div>\n      );\n    }\n\n    // Steps 2ΓÇô6: Tour slides\n    if (currentStep >= 2 && currentStep <= 6) {\n      const screen = tourScreens[currentStep - 2];\n      if (!screen) return null;\n      return (\n        <div className=\"ob-step\">\n          <div className=\"ob-step-shell\">\n            <div className=\"ob-step-meta\">Sanctuary Tour</div>\n            <div className=\"ob-step-icon\">{screen.emoji}</div>\n          </div>\n          <h2 className=\"ob-step-title\">{screen.title}</h2>\n          <p className=\"ob-step-subtitle\">{screen.subtitle}</p>\n          {renderError()}\n          <div className=\"ob-tour-content\">{screen.content}</div>\n          <div className=\"ob-actions\">\n            <button className=\"ob-btn-secondary\" onClick={handleBack}>\n              ΓåÉ {t('onboarding.back')}\n            </button>\n            <button className=\"ob-btn-primary\" onClick={handleNext} disabled={isCompleting}>\n              {isCompleting\n                ? t('onboarding.saving')\n                : currentStep === 6\n                  ? t('onboarding.complete')\n                  : t('onboarding.next')}{' '}\n              ΓåÆ\n            </button>\n          </div>\n          <button className=\"ob-btn-link\" onClick={handleSkipTour}>\n            {t('onboarding.skip')}\n          </button>\n        </div>\n      );\n    }\n\n    return null;\n  };\n\n  // ΓöÇΓöÇ Layout ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ\n  return (\n    <div className=\"ob-root\">\n      <div className=\"ob-atmosphere ob-atmosphere-one\" />\n      <div className=\"ob-atmosphere ob-atmosphere-two\" />\n      {isNarrow ? (\n        /* ΓöÇΓöÇ Narrow: single-column scroll ΓöÇΓöÇ */\n        <div className=\"ob-narrow\">\n          <div className=\"ob-narrow-header\">\n            <span className=\"ob-brand-name\">≡ƒ¬╖ Gurudevi</span>\n            <div className=\"ob-lang-row\">\n              {LANGUAGES.map((lang) => (\n                <button\n                  key={lang.code}\n                  className={`ob-lang-pill ${i18n.language?.startsWith(lang.code) ? 'active' : ''}`}\n                  onClick={() => changeLanguage(lang.code)}\n                >\n                  {lang.label}\n                </button>\n              ))}\n            </div>\n          </div>\n\n          {/* Progress bar */}\n          <div\n            className=\"ob-progress-track\"\n            role=\"progressbar\"\n            aria-valuenow={currentStep}\n            aria-valuemax={TOTAL_STEPS - 1}\n          >\n            <div\n              className=\"ob-progress-fill\"\n              style={{ width: `${(currentStep / (TOTAL_STEPS - 1)) * 100}%` }}\n            />\n          </div>\n\n          <div className=\"ob-narrow-content\">{renderStep()}</div>\n        </div>\n      ) : (\n        /* ΓöÇΓöÇ Wide: two-column split ΓöÇΓöÇ */\n        <div className=\"ob-split\">\n          {/* Left: Branding + progress tracker */}\n          <div className=\"ob-left\">\n            <div className=\"ob-left-inner\">\n              <div className=\"ob-brand\">\n                <span className=\"ob-brand-icon\">≡ƒ¬╖</span>\n                <span className=\"ob-brand-name\">Gurudevi</span>\n              </div>\n\n              <div>\n                <h1 className=\"ob-left-headline\">\n                  Your Sacred\n                  <br />\n                  Sanctuary\n                </h1>\n                <p className=\"ob-left-tagline\">\n                  A healing ecosystem for educators ΓÇö built in Sri Lanka, breathing worldwide.\n                </p>\n              </div>\n\n              {/* Five Pillars */}\n              <div className=\"ob-pillars\">\n                {PILLARS.map((p) => (\n                  <div key={p.name} className=\"ob-pillar\">\n                    <span>{p.emoji}</span>\n                    <span>{p.name}</span>\n                  </div>\n                ))}\n              </div>\n\n              {/* Step progress tracker */}\n              <div className=\"ob-tracker\">\n                {TRACKED_STEPS.map((s) => (\n                  <div\n                    key={s.idx}\n                    className={`ob-tracker-row ${currentStep > s.idx ? 'done' : ''} ${currentStep === s.idx ? 'current' : ''}`}\n                  >\n                    <div className=\"ob-tracker-dot\" />\n                    <span className=\"ob-tracker-label\">{s.label}</span>\n                  </div>\n                ))}\n              </div>\n\n              {/* Language picker */}\n              <div className=\"ob-lang-row ob-lang-bottom\">\n                {LANGUAGES.map((lang) => (\n                  <button\n                    key={lang.code}\n                    className={`ob-lang-pill ${i18n.language?.startsWith(lang.code) ? 'active' : ''}`}\n                    onClick={() => changeLanguage(lang.code)}\n                  >\n                    {lang.label}\n                  </button>\n                ))}\n              </div>\n            </div>\n          </div>\n\n          {/* Right: Step content */}\n          <div className=\"ob-right\">\n            <div className=\"ob-right-inner\">\n              {/* Step progress dots */}\n              <div\n                className=\"ob-dots\"\n                role=\"progressbar\"\n                aria-valuenow={currentStep}\n                aria-valuemax={TOTAL_STEPS - 1}\n              >\n                {Array.from({ length: TOTAL_STEPS }).map((_, i) => (\n                  <div\n                    key={i}\n                    className={`ob-dot ${i === currentStep ? 'active' : i < currentStep ? 'done' : ''}`}\n                  />\n                ))}\n              </div>\n\n              {renderStep()}\n            </div>\n          </div>\n        </div>\n      )}\n\n      {/* ΓöÇΓöÇ Scoped CSS ΓöÇΓöÇ */}\n      <style>{`\n                .ob-root {\n                    position: fixed;\n                    inset: 0;\n                    background:\n                        radial-gradient(circle at 18% 14%, rgba(125, 212, 192, 0.14), transparent 24%),\n                        radial-gradient(circle at 88% 22%, rgba(184, 169, 224, 0.14), transparent 22%),\n                        linear-gradient(160deg, var(--background, #F5EDD6) 0%, var(--background-alt, #FAF7ED) 60%, rgba(252, 249, 242, 0.96) 100%);\n                    font-family: var(--font-body, 'DM Sans', sans-serif);\n                    overflow: hidden;\n                }\n                .ob-atmosphere {\n                    position: absolute;\n                    border-radius: 999px;\n                    pointer-events: none;\n                    filter: blur(14px);\n                    opacity: 0.55;\n                }\n                .ob-atmosphere-one {\n                    top: -80px;\n                    right: 18%;\n                    width: 220px;\n                    height: 220px;\n                    background: radial-gradient(circle, rgba(212,132,58,0.18), transparent 70%);\n                }\n                .ob-atmosphere-two {\n                    bottom: -70px;\n                    left: 8%;\n                    width: 260px;\n                    height: 260px;\n                    background: radial-gradient(circle, rgba(125,212,192,0.2), transparent 70%);\n                }\n\n                /* ΓöÇΓöÇ NARROW (single-column) ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ */\n                .ob-narrow {\n                    display: flex;\n                    flex-direction: column;\n                    height: 100%;\n                    position: relative;\n                    z-index: 1;\n                }\n                .ob-narrow-header {\n                    display: flex;\n                    justify-content: space-between;\n                    align-items: center;\n                    padding: 14px 20px;\n                    border-bottom: 1px solid var(--border, rgba(42,35,24,0.1));\n                    flex-shrink: 0;\n                }\n                .ob-progress-track {\n                    height: 3px;\n                    background: var(--border, rgba(42,35,24,0.1));\n                    flex-shrink: 0;\n                }\n                .ob-progress-fill {\n                    height: 100%;\n                    background: var(--action, #D4843A);\n                    transition: width 0.4s ease;\n                    border-radius: 0 2px 2px 0;\n                }\n                .ob-narrow-content {\n                    flex: 1;\n                    padding: 28px 20px;\n                    overflow-y: auto;\n                }\n\n                /* ΓöÇΓöÇ SPLIT (two-column) ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ */\n                .ob-split {\n                    display: flex;\n                    height: 100%;\n                    position: relative;\n                    z-index: 1;\n                }\n\n                /* Left Panel */\n                .ob-left {\n                    width: 340px;\n                    flex-shrink: 0;\n                    background: linear-gradient(160deg, rgba(252,249,242,0.72) 0%, rgba(252,249,242,0.5) 100%);\n                    border-right: 1px solid var(--border, rgba(42,35,24,0.08));\n                    overflow-y: auto;\n                    padding: 44px 36px;\n                    backdrop-filter: blur(18px);\n                }\n                .ob-left-inner {\n                    display: flex;\n                    flex-direction: column;\n                    gap: 32px;\n                    min-height: 100%;\n                }\n                .ob-brand {\n                    display: flex;\n                    align-items: center;\n                    gap: 10px;\n                }\n                .ob-brand-icon { font-size: 22px; }\n                .ob-brand-name {\n                    font-size: 18px;\n                    font-weight: 800;\n                    color: var(--ink, #2A2318);\n                    letter-spacing: -0.3px;\n                }\n                .ob-left-headline {\n                    font-size: 40px;\n                    font-weight: 800;\n                    color: var(--ink, #2A2318);\n                    line-height: 1.1;\n                    letter-spacing: -1.5px;\n                    margin: 0 0 12px;\n                }\n                .ob-left-tagline {\n                    font-size: 14px;\n                    line-height: 1.6;\n                    color: var(--ink-ghost, #7A6E5F);\n                    margin: 0;\n                    max-width: 240px;\n                }\n\n                /* Pillars */\n                .ob-pillars {\n                    display: flex;\n                    flex-wrap: wrap;\n                    gap: 8px;\n                }\n                .ob-pillar {\n                    display: flex;\n                    align-items: center;\n                    gap: 6px;\n                    padding: 5px 11px;\n                    border-radius: 50px;\n                    background: rgba(212,132,58,0.08);\n                    border: 1px solid rgba(212,132,58,0.2);\n                    font-size: 12px;\n                    font-weight: 600;\n                    color: var(--action, #D4843A);\n                }\n\n                /* Step tracker */\n                .ob-tracker {\n                    display: flex;\n                    flex-direction: column;\n                    gap: 14px;\n                }\n                .ob-tracker-row {\n                    display: flex;\n                    align-items: center;\n                    gap: 12px;\n                    opacity: 0.35;\n                    transition: opacity 0.3s;\n                }\n                .ob-tracker-row.done { opacity: 0.55; }\n                .ob-tracker-row.current { opacity: 1; }\n                .ob-tracker-dot {\n                    width: 8px;\n                    height: 8px;\n                    border-radius: 50%;\n                    background: var(--border, rgba(42,35,24,0.2));\n                    flex-shrink: 0;\n                    transition: background 0.3s, transform 0.3s;\n                }\n                .ob-tracker-row.done .ob-tracker-dot,\n                .ob-tracker-row.current .ob-tracker-dot {\n                    background: var(--action, #D4843A);\n                }\n                .ob-tracker-row.current .ob-tracker-dot {\n                    transform: scale(1.6);\n                }\n                .ob-tracker-label {\n                    font-size: 13px;\n                    font-weight: 600;\n                    color: var(--ink, #2A2318);\n                }\n                .ob-lang-bottom { margin-top: auto; }\n\n                /* Right Panel */\n                .ob-right {\n                    flex: 1;\n                    display: flex;\n                    align-items: center;\n                    justify-content: center;\n                    overflow-y: auto;\n                    padding: 40px;\n                }\n                .ob-right-inner {\n                    width: 100%;\n                    max-width: 560px;\n                    display: flex;\n                    flex-direction: column;\n                    gap: 28px;\n                    padding: 34px;\n                    border-radius: 32px;\n                    background: linear-gradient(180deg, rgba(252,249,242,0.8), rgba(252,249,242,0.6));\n                    border: 1px solid rgba(42,35,24,0.08);\n                    box-shadow: 0 28px 72px rgba(121, 93, 48, 0.12);\n                    backdrop-filter: blur(18px);\n                }\n\n                /* Progress dots */\n                .ob-dots {\n                    display: flex;\n                    gap: 6px;\n                    align-items: center;\n                }\n                .ob-dot {\n                    width: 6px;\n                    height: 6px;\n                    border-radius: 50%;\n                    background: var(--border, rgba(42,35,24,0.2));\n                    transition: all 0.3s ease;\n                    flex-shrink: 0;\n                }\n                .ob-dot.active { background: var(--action, #D4843A); transform: scale(1.3); }\n                .ob-dot.done { background: var(--success, #7DD4C0); }\n\n                .ob-error-banner {\n                    display: flex;\n                    align-items: center;\n                    gap: 8px;\n                    padding: 10px 14px;\n                    background: rgba(212, 110, 58, 0.1);\n                    border-left: 3px solid #D46E3A;\n                    border-radius: 4px;\n                    margin-bottom: 20px;\n                    animation: slideDown 0.3s ease;\n                }\n                .ob-error-icon { font-size: 16px; }\n                .ob-error-text { font-size: 13px; color: #D46E3A; font-weight: 600; }\n\n                @keyframes slideDown {\n                    from { opacity: 0; transform: translateY(-10px); }\n                    to { opacity: 1; transform: translateY(0); }\n                }\n\n                /* ΓöÇΓöÇ RESPONSIVE BITS ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ */\n                .ob-step {\n                    display: flex;\n                    flex-direction: column;\n                    gap: 20px;\n                }\n                .ob-step-shell {\n                    display: flex;\n                    align-items: center;\n                    justify-content: space-between;\n                    gap: 16px;\n                }\n                .ob-step-meta {\n                    width: fit-content;\n                    padding: 8px 12px;\n                    border-radius: 999px;\n                    background: rgba(212,132,58,0.08);\n                    border: 1px solid rgba(212,132,58,0.18);\n                    color: var(--action, #D4843A);\n                    font-size: 11px;\n                    font-weight: 800;\n                    text-transform: uppercase;\n                    letter-spacing: 0.12em;\n                }\n                .ob-step-icon {\n                    font-size: 40px;\n                    line-height: 1;\n                }\n                .ob-step-title {\n                    font-size: 27px;\n                    font-weight: 800;\n                    color: var(--ink, #2A2318);\n                    margin: 0;\n                    letter-spacing: -0.5px;\n                    line-height: 1.2;\n                }\n                .ob-step-subtitle {\n                    font-size: 15px;\n                    color: var(--ink-ghost, #7A6E5F);\n                    margin: 0;\n                    line-height: 1.5;\n                }\n                .ob-tour-content {\n                    font-size: 15px;\n                    color: var(--ink, #2A2318);\n                    line-height: 1.7;\n                    padding: 22px;\n                    background: linear-gradient(180deg, rgba(252,249,242,0.62), rgba(252,249,242,0.42));\n                    border-radius: 22px;\n                    border: 1px solid var(--border, rgba(42,35,24,0.08));\n                }\n\n                /* Name input */\n                .ob-input {\n                    width: 100%;\n                    padding: 17px 18px;\n                    border-radius: 18px;\n                    border: 1px solid var(--border, rgba(42,35,24,0.15));\n                    background: rgba(255,255,255,0.58);\n                    font-size: 16px;\n                    color: var(--ink, #2A2318);\n                    font-family: var(--font-body, 'DM Sans', sans-serif);\n                    outline: none;\n                    transition: border-color 0.2s, box-shadow 0.2s;\n                    box-sizing: border-box;\n                }\n                .ob-input:focus {\n                    border-color: var(--action, #D4843A);\n                    box-shadow: 0 0 0 3px rgba(212,132,58,0.12);\n                }\n                .ob-input::placeholder { color: var(--ink-ghost, #7A6E5F); }\n\n                /* Role grid */\n                .ob-role-grid {\n                    display: grid;\n                    grid-template-columns: repeat(3, 1fr);\n                    gap: 12px;\n                }\n                @media (max-width: 420px) {\n                    .ob-role-grid { grid-template-columns: 1fr; }\n                }\n                .ob-role-card {\n                    display: flex;\n                    flex-direction: column;\n                    align-items: center;\n                    gap: 8px;\n                    padding: 22px 14px;\n                    border-radius: 22px;\n                    border: 1px solid var(--border, rgba(42,35,24,0.1));\n                    background: linear-gradient(180deg, rgba(252,249,242,0.66), rgba(252,249,242,0.5));\n                    cursor: pointer;\n                    transition: all 0.2s ease;\n                    font-family: var(--font-body, 'DM Sans', sans-serif);\n                    text-align: center;\n                }\n                .ob-role-card:hover {\n                    border-color: rgba(212,132,58,0.5);\n                    background: rgba(212,132,58,0.04);\n                    transform: translateY(-2px);\n                }\n                .ob-role-card.selected {\n                    border-color: var(--action, #D4843A);\n                    background: rgba(212,132,58,0.08);\n                    box-shadow: 0 14px 28px rgba(212,132,58,0.14);\n                }\n                .ob-role-emoji { font-size: 26px; line-height: 1; }\n                .ob-role-name {\n                    font-size: 13px;\n                    font-weight: 700;\n                    color: var(--ink, #2A2318);\n                }\n                .ob-role-desc {\n                    font-size: 10px;\n                    color: var(--ink-ghost, #7A6E5F);\n                    line-height: 1.4;\n                }\n\n                /* Actions row */\n                .ob-actions {\n                    display: flex;\n                    gap: 12px;\n                    margin-top: 4px;\n                    flex-wrap: wrap;\n                }\n\n                /* Buttons */\n                .ob-btn-primary {\n                    flex: 1;\n                    padding: 15px 24px;\n                    min-height: 50px;\n                    border-radius: 16px;\n                    background: linear-gradient(180deg, var(--action, #D4843A), var(--action-2, #C7742B));\n                    color: var(--text-on-action, #FCF9F2);\n                    font-size: 15px;\n                    font-weight: 700;\n                    border: none;\n                    cursor: pointer;\n                    transition: all 0.2s ease;\n                    font-family: var(--font-body, 'DM Sans', sans-serif);\n                    letter-spacing: 0.2px;\n                }\n                .ob-btn-primary:hover:not(:disabled) {\n                    filter: brightness(1.06);\n                    transform: translateY(-1px);\n                    box-shadow: 0 4px 14px rgba(212,132,58,0.28);\n                }\n                .ob-btn-primary:disabled {\n                    opacity: 0.45;\n                    cursor: not-allowed;\n                }\n                .ob-btn-secondary {\n                    padding: 15px 22px;\n                    min-height: 50px;\n                    border-radius: 16px;\n                    background: rgba(255,255,255,0.55);\n                    color: var(--ink, #2A2318);\n                    font-size: 15px;\n                    font-weight: 600;\n                    border: 1.5px solid var(--border, rgba(42,35,24,0.2));\n                    cursor: pointer;\n                    transition: all 0.2s ease;\n                    font-family: var(--font-body, 'DM Sans', sans-serif);\n                    white-space: nowrap;\n                }\n                .ob-btn-secondary:hover {\n                    background: var(--glass-surface, rgba(255,255,255,0.6));\n                    border-color: var(--ink-ghost, #7A6E5F);\n                }\n                .ob-btn-link {\n                    background: none;\n                    border: none;\n                    color: var(--ink-ghost, #7A6E5F);\n                    font-size: 13px;\n                    cursor: pointer;\n                    text-align: center;\n                    font-family: var(--font-body, 'DM Sans', sans-serif);\n                    padding: 4px 0;\n                    text-decoration: none;\n                    transition: color 0.2s;\n                }\n                .ob-btn-link:hover {\n                    color: var(--ink, #2A2318);\n                    text-decoration: underline;\n                }\n\n                /* Language pills */\n                .ob-lang-row {\n                    display: flex;\n                    gap: 4px;\n                }\n                .ob-lang-pill {\n                    padding: 6px 12px;\n                    border-radius: 50px;\n                    background: transparent;\n                    border: 1px solid transparent;\n                    font-size: 12px;\n                    font-weight: 600;\n                    color: var(--ink-ghost, #7A6E5F);\n                    cursor: pointer;\n                    font-family: var(--font-body, 'DM Sans', sans-serif);\n                    transition: all 0.2s;\n                }\n                .ob-lang-pill.active {\n                    background: var(--action, #D4843A);\n                    color: #F5EDD6;\n                }\n                .ob-lang-pill:hover:not(.active) {\n                    background: var(--glass-surface, rgba(255,255,255,0.6));\n                    border-color: var(--border, rgba(42,35,24,0.15));\n                }\n\n                /* Orientation step wrapper */\n                .ob-step-orientation {\n                    gap: 0;\n                }\n                @media (max-width: 900px) {\n                    .ob-root {\n                        overflow: auto;\n                    }\n                    .ob-right-inner {\n                        padding: 24px;\n                        border-radius: 24px;\n                    }\n                }\n                @media (max-width: 640px) {\n                    .ob-role-grid {\n                        grid-template-columns: 1fr;\n                    }\n                    .ob-step-shell {\n                        align-items: flex-start;\n                        flex-direction: column;\n                    }\n                    .ob-narrow-header {\n                        align-items: flex-start;\n                        flex-direction: column;\n                    }\n                }\n            `}</style>\n    </div>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\Naween\\projects\\polymath-platform\\packages\\ui\\src\\screens\\OnboardingWrapper.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\Naween\\projects\\polymath-platform\\packages\\ui\\src\\screens\\WelcomeScreen.tsx","messages":[{"ruleId":"@typescript-eslint/no-require-imports","severity":1,"message":"A `require()` style import is forbidden.","line":29,"column":14,"nodeType":"CallExpression","messageId":"noRequireImports","endLine":29,"endColumn":46},{"ruleId":"react-native-a11y/has-accessibility-hint","severity":1,"message":"has accessibilityLabel prop but no accessibilityHint","line":114,"column":17,"nodeType":"JSXOpeningElement","endLine":121,"endColumn":18},{"ruleId":"react-native-a11y/has-valid-accessibility-ignores-invert-colors","severity":1,"message":"Found an element which will be inverted. Add the accessibilityIgnoresInvertColors prop","line":144,"column":17,"nodeType":"JSXElement","endLine":149,"endColumn":19},{"ruleId":"react-native-a11y/has-accessibility-hint","severity":1,"message":"has accessibilityLabel prop but no accessibilityHint","line":144,"column":17,"nodeType":"JSXOpeningElement","endLine":149,"endColumn":19}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":4,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { useState } from 'react';\nimport {\n  Box,\n  VStack,\n  Text,\n  Heading,\n  Button,\n  ButtonText,\n  HStack,\n  Checkbox,\n  CheckboxIndicator,\n  CheckboxIcon,\n  CheckIcon,\n  Link,\n  LinkText,\n  Pressable,\n  Spinner,\n} from '../gluestack';\nimport { Theme } from '../theme/Theme';\nimport { useTheme } from '../hooks/useTheme';\nimport { useSanctuaryToast } from '../providers/ToastProvider';\nimport { useTranslation } from 'react-i18next';\nimport { Image } from 'react-native';\nimport { hapticLight, hapticSuccess, hapticError } from '../utils/haptics';\nimport ScreenWrapper from '../components/ScreenWrapper';\nimport { handleAPIError, LanguageUtils } from '@repo/core/logic';\nimport { authAPI } from '@repo/core/native';\n\nconst LOGO = require('../../assets/icon.png');\n\nconst LANGUAGES = [\n  { code: 'en', label: 'English' },\n  { code: 'si', label: 'Sinhala' },\n  { code: 'ta', label: 'Tamil' },\n];\n\ninterface WelcomeScreenProps {\n  onLogin?: () => void;\n  onGuest?: () => void;\n}\n\nexport default function WelcomeScreen({ onLogin, onGuest }: WelcomeScreenProps) {\n  const { t, i18n } = useTranslation();\n  const { accent } = useTheme();\n  const [acceptedTerms, setAcceptedTerms] = useState(true);\n  const [isConnecting, setIsConnecting] = useState(false);\n  const { showToast } = useSanctuaryToast();\n\n  const changeLanguage = async (langCode: string) => {\n    hapticLight();\n    await LanguageUtils.setLanguage(langCode as 'en' | 'si' | 'ta');\n  };\n\n  const showTermsToast = () => {\n    showToast({\n      message:\n        t('auth.acceptTermsRequired') ||\n        'Please accept the Terms and Privacy Pact to continue in the sanctuary',\n      type: 'error',\n    });\n  };\n\n  const handleStartExploring = async () => {\n    if (!acceptedTerms) {\n      hapticError();\n      showTermsToast();\n      return;\n    }\n\n    hapticSuccess();\n    setIsConnecting(true);\n    try {\n      await authAPI.signInAnonymously();\n      if (onGuest) onGuest();\n    } catch (error) {\n      handleAPIError(error);\n      setIsConnecting(false);\n    }\n  };\n\n  const handleLogin = () => {\n    if (!acceptedTerms) {\n      hapticError();\n      showTermsToast();\n      return;\n    }\n    hapticLight();\n    // Identity Phase: Navigate to Auth screen\n    if (onLogin) onLogin();\n  };\n\n  return (\n    <ScreenWrapper scroll>\n      <Box className=\"flex-1 bg-phase-surface px-6 pt-10 pb-12 overflow-hidden\">\n        {/* Background decorative blobs */}\n        <Box\n          className=\"absolute -top-14 -left-9 w-[220px] h-[220px] rounded-full\"\n          style={{ backgroundColor: `${accent.action}14` }}\n        />\n        <Box\n          className=\"absolute right-[-44px] top-32 w-[180px] h-[180px] rounded-full\"\n          style={{ backgroundColor: `${Theme.colors.gurudeviBlue}16` }}\n        />\n        <Box\n          className=\"absolute left-7 bottom-[92px] w-[140px] h-[140px] rounded-full\"\n          style={{ backgroundColor: `${Theme.colors.gurudeviViolet}10` }}\n        />\n\n        <Box className=\"items-end mb-6\">\n          <HStack className=\"bg-phase-surface rounded-[20px] p-1 border border-phase-border space-x-0.5\">\n            {LANGUAGES.map((lang) => {\n              const isActive = i18n.language?.startsWith(lang.code);\n              return (\n                <Pressable\n                  key={lang.code}\n                  onPress={() => changeLanguage(lang.code)}\n                  accessibilityRole=\"button\"\n                  accessibilityLabel={t('accessibility.switchLanguage', { lang: lang.label })}\n                  accessibilityState={{ selected: isActive }}\n                  className={`px-2.5 py-1.5 rounded-2xl ${isActive ? 'bg-phase-accent' : 'bg-transparent'}`}\n                >\n                  <Text\n                    className={`text-[10px] font-bold ${isActive ? 'text-white' : 'text-phase-text-secondary'}`}\n                  >\n                    {lang.code.toUpperCase()}\n                  </Text>\n                </Pressable>\n              );\n            })}\n          </HStack>\n        </Box>\n\n        <VStack className=\"w-full max-w-[460px] self-center flex-1 gap-8\">\n          <VStack className=\"gap-6 pt-4\">\n            <Box className=\"self-start px-4 py-1.5 rounded-full bg-phase-accent/10 border border-phase-accent/30\">\n              <Text className=\"text-[10px] font-bold text-phase-accent tracking-[0.6px]\">\n                SANCTUARY FOR TEACHERS\n              </Text>\n            </Box>\n\n            <VStack className=\"gap-4\">\n              <Box className=\"w-[156px] h-[156px] rounded-[40px] self-center bg-phase-surface justify-center items-center border border-phase-border shadow-xl\">\n                <Box className=\"absolute inset-2.5 rounded-[32px] bg-phase-accent/5\" />\n                <Image\n                  source={LOGO}\n                  style={{ width: 96, height: 96, borderRadius: 18 }}\n                  accessible={true}\n                  accessibilityLabel={t('accessibility.appLogo')}\n                />\n              </Box>\n\n              <VStack className=\"gap-2 items-center\">\n                <Heading className=\"text-phase-text-primary text-4xl text-center font-bold tracking-[-1.8px]\">\n                  Gurudevi\n                </Heading>\n                <Text className=\"text-phase-text-secondary text-lg text-center max-w-[320px] leading-relaxed\">\n                  {t('welcome.subtitle')}\n                </Text>\n              </VStack>\n            </VStack>\n\n            <HStack className=\"justify-center gap-2 flex-wrap\">\n              {[\n                { label: 'Self', tone: accent.action },\n                { label: 'Classroom', tone: Theme.colors.gurudeviBlue },\n                { label: 'Community', tone: Theme.colors.gurudeviViolet },\n                { label: 'Library', tone: Theme.colors.sageGreen },\n              ].map((pillar) => (\n                <Box\n                  key={pillar.label}\n                  className=\"px-4 py-1.5 rounded-full border\"\n                  style={{ backgroundColor: `${pillar.tone}12`, borderColor: `${pillar.tone}30` }}\n                >\n                  <Text className=\"text-[10px] font-bold\" style={{ color: pillar.tone }}>\n                    {pillar.label}\n                  </Text>\n                </Box>\n              ))}\n            </HStack>\n          </VStack>\n\n          <Box className=\"bg-phase-surface rounded-[28px] border border-phase-border p-6 shadow-lg\">\n            <VStack className=\"gap-6\">\n              <VStack className=\"gap-1.5 \">\n                <Text className=\"text-[10px] text-phase-text-secondary font-bold tracking-widest uppercase\">\n                  BEGIN QUIETLY\n                </Text>\n                <Text className=\"text-phase-text-secondary text-sm leading-relaxed\">\n                  Enter as a guest to explore the sanctuary, or return to the account that already\n                  holds your path.\n                </Text>\n              </VStack>\n\n              <VStack className=\"gap-4\">\n                <HStack className=\"gap-3 items-center justify-center\">\n                  <Checkbox\n                    value=\"terms\"\n                    isChecked={acceptedTerms}\n                    onChange={(checked: boolean) => {\n                      hapticLight();\n                      setAcceptedTerms(checked);\n                    }}\n                    aria-label=\"Accept Terms\"\n                  >\n                    <CheckboxIndicator>\n                      <CheckboxIcon as={CheckIcon} />\n                    </CheckboxIndicator>\n                  </Checkbox>\n                  <HStack className=\"gap-1 flex-shrink\">\n                    <Text className=\"text-sm text-phase-text-secondary\">\n                      {t('welcome.acceptTerms')}\n                    </Text>\n                    <Link href=\"https://neevsk.org/privacy\" isExternal>\n                      <LinkText className=\"text-sm\">{t('welcome.privacyPactLink')}</LinkText>\n                    </Link>\n                  </HStack>\n                </HStack>\n\n                <VStack className=\"gap-3\">\n                  <Button\n                    onPress={handleStartExploring}\n                    isDisabled={isConnecting || !acceptedTerms}\n                    className={`h-[64px] rounded-2xl shadow-md ${acceptedTerms ? 'bg-phase-accent' : 'bg-phase-text-secondary opacity-50'}`}\n                  >\n                    {isConnecting ? (\n                      <Spinner color=\"white\" />\n                    ) : (\n                      <ButtonText className=\"text-white font-bold text-lg\">\n                        {t('welcome.exploreAsGuest')}\n                      </ButtonText>\n                    )}\n                  </Button>\n\n                  <Button\n                    variant=\"outline\"\n                    onPress={handleLogin}\n                    className=\"h-[54px] rounded-2xl border-phase-border bg-transparent\"\n                  >\n                    <ButtonText className=\"text-phase-text-secondary font-medium\">\n                      {t('welcome.login')}\n                    </ButtonText>\n                  </Button>\n                </VStack>\n              </VStack>\n\n              <Text className=\"text-phase-text-secondary text-[10px] text-center opacity-60\">\n                {t('welcome.footer')}\n              </Text>\n            </VStack>\n          </Box>\n        </VStack>\n      </Box>\n    </ScreenWrapper>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\Naween\\projects\\polymath-platform\\packages\\ui\\src\\screens\\WelcomeScreen.web.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'useMemo' is defined but never used.","line":21,"column":27,"nodeType":"Identifier","messageId":"unusedVar","endLine":21,"endColumn":34,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"useMemo"},"fix":{"range":[1497,1506],"text":""},"desc":"Remove unused variable \"useMemo\"."}]},{"ruleId":"no-restricted-imports","severity":1,"message":"'../gluestack-legacy' import is restricted from being used. Please use the hardened primitives in '../gluestack' instead.","line":34,"column":1,"nodeType":"ImportDeclaration","messageId":"pathWithCustomMessage","endLine":34,"en