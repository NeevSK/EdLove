[{"filePath":"C:\\Users\\Naween\\projects\\polymath-platform\\packages\\ui\\eslint.config.mjs","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\Naween\\projects\\polymath-platform\\packages\\ui\\nativewind-env.d.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\Naween\\projects\\polymath-platform\\packages\\ui\\scripts\\audit-theme.ts","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'colors' is defined but never used.","line":8,"column":10,"nodeType":"Identifier","messageId":"unusedVar","endLine":8,"endColumn":16,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"colors"},"fix":{"range":[175,182],"text":""},"desc":"Remove unused variable \"colors\"."}]},{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'phaseMatrix' is defined but never used.","line":8,"column":18,"nodeType":"Identifier","messageId":"unusedVar","endLine":8,"endColumn":29,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"phaseMatrix"},"fix":{"range":[181,194],"text":""},"desc":"Remove unused variable \"phaseMatrix\"."}]}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"/**\n * Sanctuary Theme Auditor\n *\n * Scans Theme.ts and phaseMatrix for contrast violations using APCA and WCAG 2.1.\n * Run with: npx tsx scripts/audit-theme.ts\n */\n\nimport { colors, phaseMatrix, resolvePhaseTokens } from '../src/theme/Theme';\nimport { checkAccessibility, toHex } from '../src/utils/a11yUtils';\nimport { TemporalPhase } from '../src/context/types';\n\nconst PHASES: TemporalPhase[] = ['predawn', 'dawn', 'morning', 'afternoon', 'dusk', 'night'];\nconst MODES: ('light' | 'dark')[] = ['light', 'dark'];\n\nconsole.log('\\x1b[36m%s\\x1b[0m', '--- GURUDEVI THEME ACCESSIBILITY AUDIT ---');\nconsole.log('Validating Sanctuary tokens against WCAG 2.1 and APCA Standards...\\n');\n\nlet violations = 0;\nlet totalChecks = 0;\n\nfunction report(\n  label: string,\n  fg: string,\n  bg: string,\n  requirement: { wcag?: number; apca?: number },\n) {\n  totalChecks++;\n  const fgHex = toHex(fg);\n  const bgHex = toHex(bg);\n  const { ratio, apca, apcaRating } = checkAccessibility(fgHex, bgHex);\n\n  let failed = false;\n  const details = [];\n\n  if (requirement.wcag && ratio < requirement.wcag) {\n    failed = true;\n    details.push(`WCAG: ${ratio.toFixed(2)}:1 (Min ${requirement.wcag})`);\n  }\n\n  if (requirement.apca && Math.abs(apca) < requirement.apca) {\n    failed = true;\n    details.push(`APCA: ${apca.toFixed(1)} Lc (Min ${requirement.apca} - ${apcaRating})`);\n  }\n\n  if (failed) {\n    violations++;\n    console.log(`\\x1b[31m[FAIL]\\x1b[0m ${label}`);\n    console.log(`       - BG: ${bgHex}, FG: ${fgHex}`);\n    console.log(`       - ${details.join(' | ')}`);\n  }\n}\n\n// 1. Audit Phase Matrix\nPHASES.forEach((phase) => {\n  MODES.forEach((mode) => {\n    const isDark = mode === 'dark';\n    const tokens = resolvePhaseTokens(phase, isDark);\n\n    // Primary Text Contrast\n    report(`${phase}/${mode} Primary Text`, tokens.text.primary, tokens.gradientNodes[0], {\n      wcag: 4.5,\n      apca: 75,\n    });\n\n    // Secondary Text Contrast\n    report(`${phase}/${mode} Secondary Text`, tokens.text.secondary, tokens.gradientNodes[0], {\n      wcag: 3.0,\n      apca: 60,\n    });\n\n    // Accent Action Contrast\n    report(`${phase}/${mode} Accent Action`, tokens.text.inverse, tokens.accent.action, {\n      wcag: 4.5,\n      apca: 60,\n    });\n  });\n});\n\nconsole.log('\\n--- AUDIT SUMMARY ---');\nif (violations === 0) {\n  console.log(`\\x1b[32mSUCCESS: All ${totalChecks} checks passed.\\x1b[0m`);\n  process.exit(0);\n} else {\n  console.log(\n    `\\x1b[31mWARNING: Found ${violations} accessibility violations across ${totalChecks} checks.\\x1b[0m`,\n  );\n  // We don't exit with 1 yet to avoid breaking builds until we fix the colors\n  process.exit(0);\n}\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\Naween\\projects\\polymath-platform\\packages\\ui\\src\\__tests__\\useTheme.test.js","messages":[{"ruleId":"@typescript-eslint/no-require-imports","severity":1,"message":"A `require()` style import is forbidden.","line":1,"column":54,"nodeType":"CallExpression","messageId":"noRequireImports","endLine":1,"endColumn":79},{"ruleId":"no-undef","severity":1,"message":"'require' is not defined.","line":1,"column":54,"nodeType":"Identifier","messageId":"undef","endLine":1,"endColumn":61},{"ruleId":"no-undef","severity":1,"message":"'describe' is not defined.","line":3,"column":1,"nodeType":"Identifier","messageId":"undef","endLine":3,"endColumn":9},{"ruleId":"no-undef","severity":1,"message":"'it' is not defined.","line":4,"column":3,"nodeType":"Identifier","messageId":"undef","endLine":4,"endColumn":5},{"ruleId":"no-undef","severity":1,"message":"'expect' is not defined.","line":7,"column":5,"nodeType":"Identifier","messageId":"undef","endLine":7,"endColumn":11},{"ruleId":"no-undef","severity":1,"message":"'expect' is not defined.","line":8,"column":5,"nodeType":"Identifier","messageId":"undef","endLine":8,"endColumn":11},{"ruleId":"no-undef","severity":1,"message":"'expect' is not defined.","line":9,"column":5,"nodeType":"Identifier","messageId":"undef","endLine":9,"endColumn":11},{"ruleId":"no-undef","severity":1,"message":"'expect' is not defined.","line":10,"column":5,"nodeType":"Identifier","messageId":"undef","endLine":10,"endColumn":11},{"ruleId":"no-undef","severity":1,"message":"'expect' is not defined.","line":11,"column":5,"nodeType":"Identifier","messageId":"undef","endLine":11,"endColumn":11},{"ruleId":"no-undef","severity":1,"message":"'it' is not defined.","line":14,"column":3,"nodeType