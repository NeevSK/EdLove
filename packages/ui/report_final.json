fs during render\n\nReact refs are values that are not needed for rendering. Refs should only be accessed outside of render, such as in event handlers or effects. Accessing a ref value (the `current` property) during render can cause your component not to update as expected (https://react.dev/reference/react/useRef).\n\nC:\\Users\\Naween\\projects\\polymath-platform\\packages\\ui\\src\\components\\TemporalScrubber.tsx:19:15\n  17 |\n  18 |   // Animation value for the scrubber handle\n> 19 |   const pan = React.useRef(new Animated.Value(0)).current;\n     |               ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ Cannot access ref value during render\n  20 |\n  21 |   const panResponder = React.useRef(\n  22 |     PanResponder.create({","line":19,"column":15,"nodeType":null,"endLine":19,"endColumn":58},{"ruleId":"react-hooks/refs","severity":1,"message":"Error: Cannot access refs during render\n\nReact refs are values that are not needed for rendering. Refs should only be accessed outside of render, such as in event handlers or effects. Accessing a ref value (the `current` property) during render can cause your component not to update as expected (https://react.dev/reference/react/useRef).\n\nC:\\Users\\Naween\\projects\\polymath-platform\\packages\\ui\\src\\components\\TemporalScrubber.tsx:22:25\n  20 |\n  21 |   const panResponder = React.useRef(\n> 22 |     PanResponder.create({\n     |                         ^\n> 23 |       onStartShouldSetPanResponder: () => true,\n     | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n> 24 |       onPanResponderMove: Animated.event([null, { dx: pan }], { useNativeDriver: false }),\n     ΓÇª\n     | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n> 43 |       },\n     | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n> 44 |     }),\n     | ^^^^^^ Passing a ref to a function may read its value during render\n  45 |   ).current;\n  46 |\n  47 |   const color = phase === 'past' ? '#968E80' : '#F6BF8C';","line":22,"column":25,"nodeType":null,"endLine":44,"endColumn":6},{"ruleId":"react-hooks/refs","severity":1,"message":"Error: Cannot access refs during render\n\nReact refs are values that are not needed for rendering. Refs should only be accessed outside of render, such as in event handlers or effects. Accessing a ref value (the `current` property) during render can cause your component not to update as expected (https://react.dev/reference/react/useRef).\n\nC:\\Users\\Naween\\projects\\polymath-platform\\packages\\ui\\src\\components\\TemporalScrubber.tsx:56:15\n  54 |       >\n  55 |         <Animated.View\n> 56 |           {...panResponder.panHandlers}\n     |               ^^^^^^^^^^^^^^^^^^^^^^^^ Cannot access ref value during render\n  57 |           className=\"w-8 h-8 rounded-full absolute items-center justify-center shadow-lg\"\n  58 |           style={[\n  59 |             {","line":56,"column":15,"nodeType":null,"endLine":56,"endColumn":39}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":11,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React from 'react';\nimport { View, PanResponder, Animated, Dimensions } from 'react-native';\nimport { useTemporalStore } from '@repo/core/logic';\nimport { Box, Text } from '../gluestack';\n\nconst { width: SCREEN_WIDTH } = Dimensions.get('window');\nconst SCRUBBER_WIDTH = SCREEN_WIDTH * 0.8;\n\n/**\n * TemporalScrubber\n *\n * A premium, gesture-based component for \"sliding\" through the user's journey.\n * Adheres to the \"Breath-like Motion\" and \"Sanctuary Glass\" principles.\n */\nexport const TemporalScrubber: React.FC = () => {\n  const { viewDate, setViewDate, intensity, phase } = useTemporalStore();\n\n  // Animation value for the scrubber handle\n  const pan = React.useRef(new Animated.Value(0)).current;\n\n  const panResponder = React.useRef(\n    PanResponder.create({\n      onStartShouldSetPanResponder: () => true,\n      onPanResponderMove: Animated.event([null, { dx: pan }], { useNativeDriver: false }),\n      onPanResponderRelease: (e, gestureState) => {\n        // Simple logic to change date based on swipe direction\n        const today = new Date();\n        if (gestureState.dx < -50) {\n          // Swipe Left -> Past\n          const currentDate = viewDate ? new Date(viewDate) : today;\n          const pastDate = new Date(currentDate);\n          pastDate.setDate(pastDate.getDate() - 1);\n          setViewDate(pastDate.toISOString().split('T')[0]!);\n        } else if (gestureState.dx > 50) {\n          // Swipe Right -> Reset to Present\n          setViewDate(today.toISOString().split('T')[0]!);\n        }\n\n        Animated.spring(pan, {\n          toValue: 0,\n          useNativeDriver: false,\n        }).start();\n      },\n    }),\n  ).current;\n\n  const color = phase === 'past' ? '#968E80' : '#F6BF8C';\n\n  return (\n    <Box className=\"p-6 items-center justify-center\">\n      <Box\n        className=\"h-1 rounded-full justify-center mb-4\"\n        style={{ width: SCRUBBER_WIDTH, backgroundColor: `${color}22` }}\n      >\n        <Animated.View\n          {...panResponder.panHandlers}\n          className=\"w-8 h-8 rounded-full absolute items-center justify-center shadow-lg\"\n          style={[\n            {\n              left: SCRUBBER_WIDTH / 2 - 16,\n              transform: [{ translateX: pan }],\n              backgroundColor: color,\n              shadowColor: color,\n              opacity: intensity,\n            },\n          ]}\n        >\n          <Box className=\"w-2 h-2 rounded-full bg-white/80\" />\n        </Animated.View>\n      </Box>\n      <Text className=\"text-[10px] font-bold tracking-[2px] opacity-80\" style={{ color }}>\n        {viewDate === new Date().toISOString().split('T')[0] ? 'LIVING PRESENT' : viewDate}\n      </Text>\n    </Box>\n  );\n};\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\Naween\\projects\\polymath-platform\\packages\\ui\\src\\components\\TemporalShield.tsx","messages":[{"