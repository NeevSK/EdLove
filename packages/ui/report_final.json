y":1,"message":"React Hook \"useAnimatedStyle\" is called conditionally. React Hooks must be called in the exact same order in every component render.","line":270,"column":23,"nodeType":"Identifier","endLine":270,"endColumn":39},{"ruleId":"react-hooks/rules-of-hooks","severity":1,"message":"React Hook \"useAnimatedStyle\" is called conditionally. React Hooks must be called in the exact same order in every component render.","line":282,"column":21,"nodeType":"Identifier","endLine":282,"endColumn":37},{"ruleId":"@typescript-eslint/no-explicit-any","severity":1,"message":"Unexpected any. Specify a different type.","line":285,"column":10,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":285,"endColumn":13,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[8586,8589],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[8586,8589],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"react-hooks/rules-of-hooks","severity":1,"message":"React Hook \"useMemo\" is called conditionally. React Hooks must be called in the exact same order in every component render.","line":288,"column":26,"nodeType":"Identifier","endLine":288,"endColumn":33},{"ruleId":"react-hooks/refs","severity":1,"message":"Error: Cannot access refs during render\n\nReact refs are values that are not needed for rendering. Refs should only be accessed outside of render, such as in event handlers or effects. Accessing a ref value (the `current` property) during render can cause your component not to update as expected (https://react.dev/reference/react/useRef).\n\nC:\\Users\\Naween\\projects\\polymath-platform\\packages\\ui\\src\\archive\\LotusPetalFAB.complex.tsx:303:11\n  301 |   return (\n  302 |     <Animated.View\n> 303 |       {...panResponder.panHandlers}\n      |           ^^^^^^^^^^^^^^^^^^^^^^^^ Cannot access ref value during render\n  304 |       style={containerStyle}\n  305 |       accessible={true}\n  306 |       accessibilityRole=\"image\" // The FAB itself is an image/button","line":303,"column":11,"nodeType":null,"endLine":303,"endColumn":35},{"ruleId":"react-native-a11y/has-valid-accessibility-ignores-invert-colors","severity":1,"message":"Found an element which will be inverted. Add the accessibilityIgnoresInvertColors prop","line":318,"column":9,"nodeType":"JSXElement","endLine":318,"endColumn":86},{"ruleId":"react-native-a11y/has-accessibility-hint","severity":1,"message":"has accessibilityLabel prop but no accessibilityHint","line":332,"column":13,"nodeType":"JSXOpeningElement","endLine":342,"endColumn":14}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":41,"fixableErrorCount":0,"fixableWarningCount":0,"source":"/**\n * LOTUS PETAL FAB - Floating Action Button\n *\n * A petal-shaped floating action button with:\n * - Golden Lotus Art image\n * - Breathing animation (4-second cycle)\n * - Context-aware icons per tab\n * - Press animation with haptic feedback\n * - Floating bubble physics for dragging\n *\n * Philosophy: Organic, living UI that breathes with intention\n */\n\nimport React, { FC, useMemo, useEffect, useCallback, useState, useRef } from 'react';\nimport { View, Pressable, StyleSheet, Text, PanResponder, Dimensions, Image } from 'react-native';\nimport Animated, {\n  useAnimatedStyle,\n  withRepeat,\n  withTiming,\n  withSequence,\n  withSpring,\n  interpolate,\n  SharedValue,\n  Extrapolate,\n  useSharedValue,\n  Easing,\n  runOnJS,\n} from 'react-native-reanimated';\nimport * as Haptics from 'expo-haptics';\nimport { Flower2, Plus, MessageCircle, Upload, Edit } from 'lucide-react-native';\nimport { Theme } from '../theme/Theme';\nimport { useAccessibility } from '../hooks/useAccessibility';\n\n// ============================================================================\n// TYPES\n// ============================================================================\n\ntype TabType = 'self' | 'classroom' | 'community' | 'library' | 'profile';\n\nexport interface ActionItem {\n  label: string;\n  onPress: () => void;\n  icon?: React.ComponentType<{ size: number; color: string; strokeWidth: number }>;\n}\n\ninterface LotusPetalFABProps {\n  currentTab?: TabType;\n  onPress?: () => void;\n  icon?: React.ReactNode;\n  actions?: ActionItem[];\n  scrollY?: SharedValue<number>;\n  disabled?: boolean;\n  bottomInset?: number; // New prop for safe area handling\n}\n\n// ============================================================================\n// CONSTANTS\n// ============================================================================\n\nconst FAB_SIZE = 72; // Slightly larger for the art\nconst FAB_HIT_SLOP = 10;\nconst ACTION_BUBBLE_SIZE = 48;\nconst ACTION_BUBBLE_SPACING = 12;\nconst LONG_PRESS_DURATION = 400; // milliseconds\nconst SCREEN_WIDTH = Dimensions.get('window').width;\n\n// Context-aware configuration\ntype IconComponentType = React.ComponentType<{ size: number; color: string; strokeWidth: number }>;\n\nconst fabConfig: Record<TabType, { IconComponent: IconComponentType; label: string }> = {\n  self: {\n    IconComponent: Flower2,\n    label: 'Log mood',\n  },\n  classroom: {\n    IconComponent: Plus,\n    label: 'Create lesson',\n  },\n  community: {\n    IconComponent: MessageCircle,\n    label: 'Post announcement',\n  },\n  library: {\n    IconComponent: Upload,\n    label: 'Upload resource',\n  },\n  profile: {\n    IconComponent: Edit,\n    label: 'Edit profile',\n  },\n};\n\nconst LOTUS_IMAGE = require('../../assets/images/lotus_bloom.png');\n\n// ============================================================================\n// MAIN COMPONENT\n// ============================================================================\n\nconst LotusPetalFAB: FC<LotusPetalFABProps> = ({\n  currentTab = 'self',\n  onPress,\n  icon,\n  actions,\n  scrollY,\n  disabled = true,\n  bottomInset = Theme.spacing.lg, // Default value if not provided\n}) => {\n  const { isReduceMotionEnabled, announce } = useAccessibility();\n\n  // TEMPORARY: Return null if disabled to completely hide the FAB\n  if (disabled) return null;\n\n  // Shared value for press animation\n  const pressScale = useSharedValue(1);\n  // Shared value for breathing animation\n  const breathingScale = useSharedValue(0.95);\n  // Position for dragging\n  const translateX = useSharedValue(0);\n  const translateY = useSharedValue(0);\n  // Base position accumulator\n  const baseX = useRef(0);\n  const baseY = useRef(0);\n  // State for showing action menu\n  const [showActions, setShowActions] = useState(false);\n  const actionMenuScale = useSharedValue(0);\n  // Track long press\n  const longPressTimer = useRef<ReturnType<typeof setTimeout> | null>(null);\n  const [isDragging, setIsDragging] = useState(false);\n\n  // Memoize current configuration to avoid unnecessary recalculations\n  const config = useMemo(() => fabConfig[currentTab], [currentTab]);\n  const IconComponent = config.IconComponent;\n\n  // Safe haptic feedback wrapper\n  const triggerHaptic = useCallback(async () => {\n    try {\n      await Haptics.impactAsync(Haptics.ImpactFeedbackStyle.Light);\n    } catch (error) {\n      console.warn('Haptic feedback not available');\n    }\n  }, []);\n\n  // Pan responder for drag functionality\n  const panResponder = useRef(\n    PanResponder.create({\n      onStartShouldSetPanResponder: () => true,\n      onMoveShouldSetPanResponder: (_, gestureState) => {\n        return isDragging || Math.abs(gestureState.dx) > 5 || Math.abs(gestureState.dy) > 5;\n      },\n      onPanResponderGrant: () => {\n        longPressTimer.current = setTimeout(() => {\n          setIsDragging(true);\n          triggerHaptic();\n          // Slight lift effect\n          pressScale.value = withSpring(1.1);\n        }, LONG_PRESS_DURATION);\n      },\n      onPanResponderMove: (_, gestureState) => {\n        if (isDragging) {\n          translateX.value = baseX.current + gestureState.dx;\n          translateY.value = baseY.current + gestureState.dy;\n        }\n      },\n      onPanResponderRelease: (_, gestureState) => {\n        if (longPressTimer.current) {\n          clearTimeout(longPressTimer.current);\n          longPressTimer.current = null;\n        }\n\n        if (isDragging) {\n          baseX.current += gestureState.dx;\n          baseY.current += gestureState.dy;\n          setIsDragging(false);\n          // Spring back slightly on release (bubble effect)\n          pressScale.value = withSpring(1.0);\n\n          // Optional: Snap back if near edge? For now, free floating.\n        } else {\n          const moved = Math.abs(gestureState.dx) > 5 || Math.abs(gestureState.dy) > 5;\n          if (!moved) {\n            handlePress();\n          }\n        }\n      },\n    }),\n  ).current;\n\n  // ============================================================================\n  // ANIMATION INITIALIZATION\n  // ============================================================================\n\n  useEffect(() => {\n    if (!disabled && !isReduceMotionEnabled) {\n      breathingScale.value = 0.95;\n      breathingScale.value = withRepeat(\n        withTiming(1.02, {\n          duration: 3000,\n          easing: Easing.inOut(Easing.ease),\n        }),\n        -1,\n        true,\n      );\n    } else {\n      breathingScale.value = withTiming(1.0, { duration: 200 });\n    }\n  }, [disabled, isReduceMotionEnabled]);\n\n  // ============================================================================\n  // ANIMATION STYLES\n  // ============================================================================\n\n  const breathingStyle = useAnimatedStyle(() => {\n    return {\n      transform: [{ scale: breathingScale.value }],\n    };\n  });\n\n  const pressStyle = useAnimatedStyle(() => {\n    return {\n      transform: [{ scale: pressScale.value }],\n    };\n  });\n\n  const handlePress = useCallback(() => {\n    if (disabled) return;\n\n    if (actions && actions.length > 0) {\n      triggerHaptic();\n      setShowActions(!showActions);\n      actionMenuScale.value = withSpring(showActions ? 0 : 1, {\n        damping: 15,\n        stiffness: 150,\n      });\n      announce(showActions ? 'Actions menu closed' : 'Actions menu opened');\n      return;\n    }\n\n    if (onPress) {\n      triggerHaptic();\n      pressScale.value = withSequence(\n        withTiming(0.85, { duration: 100 }),\n        withSpring(1.0, { damping: 12, stiffness: 200 }),\n      );\n      onPress();\n    }\n  }, [disabled, onPress, actions, showActions, triggerHaptic]);\n\n  const actionMenuStyle = useAnimatedStyle(() => {\n    return {\n      transform: [{ scale: actionMenuScale.value }, { translateY: -10 }], // Pop up slightly\n      opacity: actionMenuScale.value,\n    } as any;\n  });\n\n  useEffect(() => {\n    actionMenuScale.value = withSpring(showActions ? 1 : 0, {\n      damping: 15,\n      stiffness: 150,\n    });\n  }, [showActions]);\n\n  useEffect(() => {\n    return () => {\n      if (longPressTimer.current) {\n        clearTimeout(longPressTimer.current);\n      }\n    };\n  }, []);\n\n  const scrollStyle = useAnimatedStyle(() => {\n    if (!scrollY) return {};\n    return {\n      transform: [\n        {\n          translateY: interpolate(scrollY.value, [0, 100], [0, 100], Extrapolate.CLAMP),\n        },\n      ],\n      opacity: interpolate(scrollY.value, [0, 50, 100], [1, 0.5, 0], Extrapolate.CLAMP),\n    };\n  });\n\n  const dragStyle = useAnimatedStyle(() => {\n    return {\n      transform: [{ translateX: translateX.value }, { translateY: translateY.value }],\n    } as any;\n  });\n\n  const containerStyle = useMemo(\n    () => [\n      styles.container,\n      { bottom: bottomInset }, // Override bottom with prop\n      breathingStyle,\n      pressStyle,\n      scrollStyle,\n      dragStyle,\n      disabled && styles.disabled,\n    ],\n    [bottomInset, breathingStyle, pressStyle, scrollStyle, dragStyle, disabled],\n  );\n\n  return (\n    <Animated.View\n      {...panResponder.panHandlers}\n      style={containerStyle}\n      accessible={true}\n      accessibilityRole=\"image\" // The FAB itself is an image/button\n      accessibilityLabel={config.label}\n      accessibilityHint={actions && actions.length > 0 ? 'Double tap to view actions' : undefined}\n      accessibilityState={{ disabled, expanded: showActions }}\n      accessibilityActions={[{ name: 'activate', label: 'Activate' }]}\n      onAccessibilityAction={handlePress}\n    >\n      <View style={styles.contentContainer}>\n        {/* Glow Behind */}\n        <View style={styles.glow} />\n\n        {/* Lotus Image */}\n        <Image source={LOTUS_IMAGE} style={styles.lotusImage} resizeMode=\"contain\" />\n\n        {/* Optional Icon Overlay */}\n        {icon && (\n          <View style={styles.iconOverlay}>\n            <>{icon}</>\n          </View>\n        )}\n      </View>\n\n      {/* Action Menu */}\n      {actions && actions.length > 0 && (\n        <Animated.View style={[styles.actionMenu, actionMenuStyle]}>\n          {actions.map((action, index) => (\n            <Pressable\n              key={index}\n              style={styles.actionBubble}\n              onPress={() => {\n                triggerHaptic();\n                action.onPress();\n              }}\n              accessible={true}\n              accessibilityRole=\"button\"\n              accessibilityLabel={action.label}\n            >\n              <View style={styles.actionBubbleContent}>\n                {action.icon && (\n                  <action.icon size={18} color={Theme.colors.lotusDeepPink} strokeWidth={2} />\n                )}\n                <Text style={styles.actionLabel}>{action.label}</Text>\n              </View>\n            </Pressable>\n          ))}\n        </Animated.View>\n      )}\n    </Animated.View>\n  );\n};\n\n// ============================================================================\n// STYLES\n// ============================================================================\n\nconst styles = StyleSheet.create({\n  container: {\n    position: 'absolute',\n    // bottom set dynamically\n    right: Theme.spacing.lg,\n    zIndex: Theme.zIndex.fab,\n    alignItems: 'center',\n    justifyContent: 'center',\n  },\n  contentContainer: {\n    width: FAB_SIZE,\n    height: FAB_SIZE,\n    alignItems: 'center',\n    justifyContent: 'center',\n  },\n  lotusImage: {\n    width: '100%',\n    height: '100%',\n    zIndex: 2,\n    backgroundColor: 'transparent',\n  },\n  iconOverlay: {\n    position: 'absolute',\n    zIndex: 3,\n    alignItems: 'center',\n    justifyContent: 'center',\n  },\n  glow: {\n    position: 'absolute',\n    width: FAB_SIZE * 0.8,\n    height: FAB_SIZE * 0.8,\n    borderRadius: FAB_SIZE,\n    backgroundColor: Theme.colors.sanctuarySaffron,\n    opacity: 0.4,\n    shadowColor: Theme.colors.sanctuarySaffron,\n    shadowOffset: { width: 0, height: 0 },\n    shadowOpacity: 0.8,\n    shadowRadius: 20,\n    elevation: 10,\n    zIndex: 1,\n  },\n  disabled: {\n    opacity: 0.5,\n  },\n  actionMenu: {\n    position: 'absolute',\n    bottom: FAB_SIZE + ACTION_BUBBLE_SPACING,\n    right: 0,\n    alignItems: 'flex-end',\n  },\n  actionBubble: {\n    backgroundColor: Theme.colors.ink,\n    borderRadius: 24,\n    marginBottom: ACTION_BUBBLE_SPACING,\n    paddingHorizontal: 16,\n    paddingVertical: 10,\n    ...Theme.shadows.md,\n    minWidth: 100,\n    borderColor: 'rgba(255,255,255,0.1)',\n    borderWidth: 1,\n  },\n  actionBubbleContent: {\n    flexDirection: 'row',\n    alignItems: 'center',\n    justifyContent: 'flex-end',\n    gap: 8,\n  },\n  actionLabel: {\n    color: Theme.colors.sacredWhite,\n    fontSize: 14,\n    fontWeight: '600',\n  },\n});\n\nexport default LotusPetalFAB;\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\Naween\\projects\\polymath-platform\\packages\\ui\\src\\button.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\Naween\\projects\\polymath-platform\\packages\\ui\\src\\card.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\Naween\\projects\\polymath-platform\\packages\\ui\\src\\code.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\Naween\\projects\\polymath-platform\\packages\\ui\\src\\components-legacy\\box\\index.tsx","messages":[{"ruleId":"@typescript-eslint/no-explicit-any","severity":1,"message":"Unexpected any. Specify a different type.","line":18,"column":35,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":18,"endColumn":38,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[407,410],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[407,410],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React from 'react';\nimport { View, type ViewProps } from 'react-native';\nimport { cssInterop } from 'nativewind';\n\nconst StyledView = View;\n\ncssInterop(StyledView, {\n  className: {\n    target: 'style',\n  },\n});\n\nexport interface IBoxProps extends ViewProps {\n  className?: string;\n}\n\nconst Box = React.forwardRef<View, IBoxProps>(({ className, ...props }, ref) => {\n  const 