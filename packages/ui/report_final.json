],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\Naween\\projects\\polymath-platform\\packages\\ui\\src\\qr\\QRShareButton.tsx","messages":[{"ruleId":"@typescript-eslint/ban-ts-comment","severity":1,"message":"Use \"@ts-expect-error\" instead of \"@ts-ignore\", as \"@ts-ignore\" will do nothing if the following line is error-free.","line":24,"column":5,"nodeType":"Line","messageId":"tsIgnoreInsteadOfExpectError","endLine":24,"endColumn":67,"suggestions":[{"messageId":"replaceTsIgnoreWithTsExpectError","fix":{"range":[955,1017],"text":"// @ts-expect-error ΓÇö optional peer dependency; may not be installed"},"desc":"Replace \"@ts-ignore\" with \"@ts-expect-error\"."}]},{"ruleId":"react-native-a11y/has-accessibility-hint","severity":1,"message":"has accessibilityLabel prop but no accessibilityHint","line":104,"column":9,"nodeType":"JSXOpeningElement","endLine":108,"endColumn":10},{"ruleId":"react-native-a11y/has-accessibility-hint","severity":1,"message":"has accessibilityLabel prop but no accessibilityHint","line":112,"column":9,"nodeType":"JSXOpeningElement","endLine":116,"endColumn":10}],"suppressedMessages":[{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":22,"column":40,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":22,"endColumn":43,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[933,936],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[933,936],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}],"suppressions":[{"kind":"directive","justification":""}]}],"errorCount":0,"fatalErrorCount":0,"warningCount":3,"fixableErrorCount":0,"fixableWarningCount":0,"source":"/**\n * QRShareButton ΓÇö QR code display + share controls\n *\n * Wraps QRCodeGenerator and adds:\n *   - \"Share Image\" ΓåÆ captures QR as PNG via react-native-view-shot ΓåÆ expo-sharing\n *   - \"Copy Link\"   ΓåÆ copies the QR URL to clipboard via expo-clipboard\n *\n * Optional `shortUrl` prop: if provided, the copied/shared URL is the short URL\n * rather than the full gurudevi://qr?... scheme URL.\n *\n * Used in: InviteManager, SchoolCreationScreen (success), IdentityCard.\n */\n\nimport React, { useRef } from 'react';\nimport { View, TouchableOpacity, Text, StyleSheet } from 'react-native';\nimport QRCodeGenerator from '../components/QRCodeGenerator';\n\n// Lazy-loaded to avoid hard native deps crashing in environments where\n// they may not be linked (e.g. storybook, web preview).\n// react-native-view-shot is an optional peer dependency.\n// eslint-disable-next-line @typescript-eslint/no-explicit-any\nconst loadViewShot = async (): Promise<any> => {\n  try {\n    // @ts-ignore ΓÇö optional peer dependency; may not be installed\n    return await import('react-native-view-shot');\n  } catch {\n    return null;\n  }\n};\nconst loadSharing = () => import('expo-sharing');\nconst loadClipboard = () => import('expo-clipboard');\n\ninterface QRShareButtonProps {\n  /** Canonical gurudevi://qr?... URI produced by QRBuilder */\n  value: string;\n  /** Human-readable label shown below the QR code */\n  label?: string;\n  /** QR code size in pixels */\n  size?: number;\n  /** If provided, this URL is copied/shared instead of the scheme URI */\n  shortUrl?: string;\n  /** Background color for the QR + share block */\n  backgroundColor?: string;\n  /** Text color for buttons */\n  accentColor?: string;\n}\n\nexport default function QRShareButton({\n  value,\n  label,\n  size = 200,\n  shortUrl,\n  backgroundColor = '#1a1a2e',\n  accentColor = '#f5a623',\n}: QRShareButtonProps) {\n  const viewRef = useRef<View>(null);\n\n  const shareUrl = shortUrl ?? value;\n\n  // ΓöÇΓöÇ Share as image ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ\n\n  const handleShareImage = async () => {\n    try {\n      const viewShot = await loadViewShot();\n      if (!viewShot) {\n        console.warn('QRShareButton: react-native-view-shot not available');\n        return;\n      }\n      const Sharing = await loadSharing();\n      if (!viewRef.current) return;\n\n      const uri = await viewShot.captureRef(viewRef, { format: 'png', quality: 1 });\n      if (await Sharing.isAvailableAsync()) {\n        await Sharing.shareAsync(uri, {\n          mimeType: 'image/png',\n          dialogTitle: label ? `Share ${label} QR Code` : 'Share QR Code',\n        });\n      }\n    } catch (err) {\n      console.warn('QRShareButton: share image failed', err);\n    }\n  };\n\n  // ΓöÇΓöÇ Copy link ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ\n\n  const handleCopyLink = async () => {\n    try {\n      const Clipboard = await loadClipboard();\n      await Clipboard.setStringAsync(shareUrl);\n    } catch (err) {\n      console.warn('QRShareButton: copy link failed', err);\n    }\n  };\n\n  return (\n    <View style={[styles.container, { backgroundColor }]}>\n      {/* QR code ΓÇö captured by ViewShot */}\n      <View ref={viewRef} collapsable={false} style={[styles.qrWrapper, { backgroundColor }]}>\n        <QRCodeGenerator value={value} size={size} label={label} />\n      </View>\n\n      {/* Action buttons */}\n      <View style={styles.buttonRow}>\n        <TouchableOpacity\n          onPress={handleShareImage}\n          style={[styles.button, { borderColor: accentColor }]}\n          accessibilityLabel=\"Share QR code as image\"\n        >\n          <Text style={[styles.buttonText, { color: accentColor }]}>≡ƒôñ Share Image</Text>\n        </TouchableOpacity>\n\n        <TouchableOpacity\n          onPress={handleCopyLink}\n          style={[styles.button, { borderColor: accentColor }]}\n          accessibilityLabel=\"Copy QR link to clipboard\"\n        >\n          <Text style={[styles.buttonText, { color: accentColor }]}>≡ƒöù Copy Link</Text>\n        </TouchableOpacity>\n      </View>\n    </View>\n  );\n}\n\nconst styles = StyleSheet.create({\n  container: {\n    alignItems: 'center',\n    gap: 16,\n    padding: 16,\n    borderRadius: 16,\n  },\n  qrWrapper: {\n    padding: 12,\n    borderRadius: 12,\n  },\n  buttonRow: {\n    flexDirection: 'row',\n    gap: 12,\n    width: '100%',\n  },\n  button: {\n    flex: 1,\n    borderWidth: 1,\n    borderRadius: 10,\n    paddingVertical: 10,\n    alignItems: 'center',\n  },\n  buttonText: {\n    fontSize: 13,\n    fontWeight: '600',\n  },\n});\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\Naween\\projects\\polymath-platform\\packages\\ui\\src\\qr\\index.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\Naween\\projects\\polymath-platform\\packages\\ui\\src\\screens\\AppSettingsScreen.bridge.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'React' is defined but never used.","line":1,"column":8,"nodeType":"Identifier","messageId":"unusedVar","endLine":1,"endColumn":13,"suggestions":[{"messageId":"removeUnusedImportDeclaration","data":{"varName":"React"},"fix":{"range":[0,27],"text":""},"desc":"Remove unused import declaration."}]}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React from 'react';\nimport AppSettingsScreenNative from './AppSettingsScreen';\n\n// On native, we use the existing AppSet