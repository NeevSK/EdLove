5 |       >","line":272,"column":13,"nodeType":null,"endLine":272,"endColumn":37},{"ruleId":"react-native-a11y/has-accessibility-hint","severity":1,"message":"has accessibilityLabel prop but no accessibilityHint","line":335,"column":17,"nodeType":"JSXOpeningElement","endLine":345,"endColumn":18}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":18,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { FC, useMemo, useEffect, useCallback, useState, useRef } from 'react';\nimport { View, Pressable, PanResponder, Dimensions, Platform } from 'react-native';\nimport Animated, {\n  useAnimatedStyle,\n  withRepeat,\n  withTiming,\n  withSequence,\n  withSpring,\n  SharedValue,\n  useSharedValue,\n  Easing,\n} from 'react-native-reanimated';\nimport { hapticLight } from '../utils/haptics';\nimport { useAccessibility } from '../hooks/useAccessibility';\nimport { Wind } from 'lucide-react-native';\nimport { Box, VStack, HStack, Text } from '../gluestack';\nimport { UniversalModal } from './UniversalModal';\nimport { useBottomTabPadding } from './ScreenWrapper';\nimport { useFAB } from '../context/FABContext';\n\n// ============================================================================\n// TYPES\n// ============================================================================\n\nimport { TabType, ActionItem } from '../types/fab';\n\ninterface LotusPetalFABProps {\n  currentTab?: TabType;\n  onPress?: () => void;\n  icon?: React.ReactNode;\n  actions?: ActionItem[];\n  scrollY?: SharedValue<number>;\n  disabled?: boolean;\n  bottomInset?: number;\n  hasActiveGaps?: boolean;\n  gapPriority?: 'low' | 'medium' | 'high';\n  onBreathingReset?: () => void;\n  useGlobal?: boolean;\n  className?: string;\n}\n\n// ============================================================================\n// CONSTANTS\n// ============================================================================\n\nconst FAB_SIZE = 56;\nconst ACTION_DRAWER_HEIGHT = Dimensions.get('window').height * 0.4;\nconst FAB_EDGE_MARGIN = 24; // Equivalent to Theme.spacing.lg\nconst FAB_DRAG_THRESHOLD = 8;\nconst FAB_WEB_STORAGE_KEY = 'gurudevi_lotus_fab_position_v1';\n\nconst fabConfig: Record<TabType, { emoji: string; label: string }> = {\n  self: { emoji: '≡ƒ¬╖', label: 'Reflection' },\n  classroom: { emoji: 'Γ₧ò', label: 'Add' },\n  community: { emoji: '≡ƒÆ¼', label: 'Community' },\n  library: { emoji: '≡ƒôÜ', label: 'Library' },\n  profile: { emoji: '≡ƒæñ', label: 'Profile' },\n  section: { emoji: '≡ƒÅó', label: 'Section' },\n  grade: { emoji: '≡ƒÅ½', label: 'Grade' },\n  principal: { emoji: '≡ƒææ', label: 'Management' },\n  founder: { emoji: '≡ƒÅ¢∩╕Å', label: 'Founder' },\n};\n\n// ============================================================================\n// MAIN COMPONENT\n// ============================================================================\n\nexport const LotusPetalFAB: FC<LotusPetalFABProps> = ({\n  currentTab: propTab,\n  onPress: propPress,\n  icon: customIcon,\n  actions: propActions,\n  scrollY,\n  disabled = false,\n  bottomInset = 24,\n  hasActiveGaps: propGaps,\n  gapPriority: propPriority,\n  onBreathingReset: propReset,\n  useGlobal = true,\n  className,\n}) => {\n  const { state: globalState } = useFAB();\n  const { isReduceMotionEnabled } = useAccessibility();\n  const bottomTabPadding = useBottomTabPadding();\n\n  // Reconcile props with global state\n  const currentTab = propTab || globalState.tabType;\n  const actions = propActions || globalState.actions;\n  const hasActiveGaps = propGaps ?? globalState.hasActiveGaps;\n  const onPress = propPress || globalState.onPress;\n  const onBreathingReset = propReset || globalState.onBreathingReset;\n  const isVisible = useGlobal ? globalState.visible : true;\n  const icon = customIcon || globalState.icon;\n\n  const config = useMemo(() => fabConfig[currentTab] || fabConfig.self, [currentTab]);\n\n  // Reanimated Shared Values\n  const pressScale = useSharedValue(1);\n  const breathingScale = useSharedValue(1);\n  const pulseOpacity = useSharedValue(0.4);\n\n  // Position Shared Values for Draggability\n  const positionX = useSharedValue(0);\n  const positionY = useSharedValue(0);\n  const dragStartX = useRef(0);\n  const dragStartY = useRef(0);\n\n  const [isDrawerVisible, setIsDrawerVisible] = useState(false);\n\n  const clampFabToViewport = useCallback(\n    (x: number, y: number) => {\n      const windowDims = Dimensions.get('window');\n      const maxX = Math.max(FAB_EDGE_MARGIN, windowDims.width - FAB_SIZE - FAB_EDGE_MARGIN);\n      const maxY = Math.max(\n        FAB_EDGE_MARGIN,\n        windowDims.height - FAB_SIZE - FAB_EDGE_MARGIN - (bottomInset + bottomTabPadding),\n      );\n      return {\n        x: Math.max(FAB_EDGE_MARGIN, Math.min(maxX, x)),\n        y: Math.max(FAB_EDGE_MARGIN, Math.min(maxY, y)),\n      };\n    },\n    [bottomInset, bottomTabPadding],\n  );\n\n  const persistWebPosition = useCallback((x: number, y: number) => {\n    if (Platform.OS !== 'web') return;\n    try {\n      if (typeof window === 'undefined' || !window.localStorage) return;\n      window.localStorage.setItem(FAB_WEB_STORAGE_KEY, JSON.stringify({ x, y }));\n    } catch {\n      // Ignore storage failures\n    }\n  }, []);\n\n  const setDefaultPosition = useCallback(() => {\n    const windowDims = Dimensions.get('window');\n    const preferredX = windowDims.width - FAB_SIZE - FAB_EDGE_MARGIN;\n    const preferredY =\n      windowDims.height - FAB_SIZE - FAB_EDGE_MARGIN - (bottomInset + bottomTabPadding);\n    const next = clampFabToViewport(preferredX, preferredY);\n    positionX.value = next.x;\n    positionY.value = next.y;\n  }, [bottomInset, bottomTabPadding, clampFabToViewport, positionX, positionY]);\n\n  useEffect(() => {\n    let initialized = false;\n    if (Platform.OS === 'web') {\n      try {\n        if (typeof window !== 'undefined' && window.localStorage) {\n          const raw = window.localStorage.getItem(FAB_WEB_STORAGE_KEY);\n          if (raw) {\n            const parsed = JSON.parse(raw);\n            if (typeof parsed?.x === 'number' && typeof parsed?.y === 'number') {\n              const next = clampFabToViewport(parsed.x, parsed.y);\n              positionX.value = next.x;\n              positionY.value = next.y;\n              initialized = true;\n            }\n          }\n        }\n      } catch {\n        // Ignore and use default position\n      }\n    }\n\n    if (!initialized) {\n      setDefaultPosition();\n    }\n  }, [clampFabToViewport, positionX, positionY, setDefaultPosition]);\n\n  useEffect(() => {\n    const sub = Dimensions.addEventListener('change', () => {\n      const next = clampFabToViewport(positionX.value, positionY.value);\n      positionX.value = next.x;\n      positionY.value = next.y;\n      persistWebPosition(next.x, next.y);\n    });\n    return () => sub.remove();\n  }, [clampFabToViewport, persistWebPosition, positionX, positionY]);\n\n  // PanResponder for draggability\n  const panResponder = useRef(\n    PanResponder.create({\n      onStartShouldSetPanResponder: () => true,\n      onMoveShouldSetPanResponder: (_, gesture) => {\n        return (\n          Math.abs(gesture.dx) > FAB_DRAG_THRESHOLD || Math.abs(gesture.dy) > FAB_DRAG_THRESHOLD\n        );\n      },\n      onPanResponderGrant: () => {\n        dragStartX.current = positionX.value;\n        dragStartY.current = positionY.value;\n        pressScale.value = withSpring(1.1);\n        hapticLight();\n      },\n      onPanResponderMove: (_, gesture) => {\n        const next = clampFabToViewport(\n          dragStartX.current + gesture.dx,\n          dragStartY.current + gesture.dy,\n        );\n        positionX.value = next.x;\n        positionY.value = next.y;\n      },\n      onPanResponderRelease: (_, gesture) => {\n        pressScale.value = withSpring(1);\n\n        // Tap\n        if (\n          Math.abs(gesture.dx) < FAB_DRAG_THRESHOLD &&\n          Math.abs(gesture.dy) < FAB_DRAG_THRESHOLD\n        ) {\n          handlePress();\n          return;\n        }\n\n        const next = clampFabToViewport(positionX.value, positionY.value);\n        positionX.value = withSpring(next.x, { damping: 15 });\n        positionY.value = withSpring(next.y, { damping: 15 });\n        persistWebPosition(next.x, next.y);\n      },\n    }),\n  ).current;\n\n  // Breathing Animation\n  useEffect(() => {\n    if (!disabled && !isReduceMotionEnabled) {\n      breathingScale.value = withRepeat(\n        withTiming(1.1, { duration: 4000, easing: Easing.inOut(Easing.ease) }),\n        -1,\n        true,\n      );\n      pulseOpacity.value = withRepeat(\n        withTiming(0.7, { duration: 4000, easing: Easing.inOut(Easing.ease) }),\n        -1,\n        true,\n      );\n    }\n  }, [disabled, isReduceMotionEnabled]);\n\n  const containerStyle = useAnimatedStyle(() => ({\n    left: positionX.value,\n    top: positionY.value,\n    transform: [{ scale: pressScale.value }],\n  }));\n\n  const breathingStyle = useAnimatedStyle(() => ({\n    transform: [{ scale: breathingScale.value }],\n    opacity: pulseOpacity.value,\n  }));\n\n  const handlePress = useCallback(() => {\n    if (disabled) return;\n    hapticLight();\n\n    if (actions && actions.length > 0) {\n      setIsDrawerVisible(true);\n      return;\n    }\n\n    if (onPress) {\n      pressScale.value = withSequence(withTiming(0.9, { duration: 100 }), withSpring(1));\n      onPress();\n    }\n  }, [disabled, onPress, actions]);\n\n  if (!isVisible) return null;\n\n  return (\n    <Box className=\"absolute inset-0 z-[1000] pointer-events-none\">\n      <Animated.View\n        {...panResponder.panHandlers}\n        style={[containerStyle]}\n        className=\"absolute w-14 h-14 items-center justify-center pointer-events-auto\"\n      >\n        {/* Breathing Glow */}\n        <Animated.View\n          style={breathingStyle}\n          className={`\n                        absolute w-[72px] h-[72px] rounded-full\n                        ${hasActiveGaps ? 'bg-phase-error opacity-60' : 'bg-phase-accent opacity-40'}\n                    `}\n        />\n\n        {/* Main FAB Circle */}\n        <Box\n          className={`\n                        w-14 h-14 rounded-full items-center justify-center bg-phase-accent\n                        shadow-xl shadow-black/30 border-2 border-white/10\n                        ${className || ''}\n                    `}\n        >\n          {hasActiveGaps ? (\n            <Text className=\"text-2xl\">Γ¥ù</Text>\n          ) : icon ? (\n            icon\n          ) : (\n            <Text className=\"text-2xl\">{config.emoji}</Text>\n          )}\n        </Box>\n      </Animated.View>\n\n      {/* Action Drawer */}\n      <UniversalModal isOpen={isDrawerVisible} onClose={() => setIsDrawerVisible(false)}>\n        <Pressable\n          accessibilityRole=\"button\"\n          className=\"flex-1 bg-black/50 justify-end\"\n          onPress={() => setIsDrawerVisible(false)}\n        >\n          <Box className=\"bg-phase-surface rounded-t-[32px] p-8 min-h-[40vh] w-full mt-auto\">\n            <Box className=\"w-10 h-1 bg-phase-text-secondary/30 rounded-full self-center mb-6\" />\n\n            <VStack className=\"gap-4\">\n              <Text className=\"text-xl font-bold text-phase-text-primary mb-2\">\n                {config.label} Actions\n              </Text>\n\n              {onBreathingReset && (\n                <Pressable\n                  accessibilityRole=\"button\"\n                  onPress={() => {\n                    setIsDrawerVisible(false);\n                    onBreathingReset();\n                  }}\n                  className=\"p-4 rounded-xl bg-phase-success/10 active:bg-phase-success/20\"\n                >\n                  <HStack className=\"items-center gap-3\">\n                    <Wind size={20} color=\"#10B981\" strokeWidth={2} />\n                    <Text className=\"text-phase-text-primary font-semibold\">Breathing Reset</Text>\n                  </HStack>\n                </Pressable>\n              )}\n\n              {actions?.map((action, idx) => (\n                <Pressable\n                  key={idx}\n                  onPress={() => {\n                    setIsDrawerVisible(false);\n                    action.onPress();\n                  }}\n                  accessible={true}\n                  accessibilityRole=\"button\"\n                  accessibilityLabel={action.label}\n                  className=\"p-4 rounded-xl hover:bg-white/5 active:bg-white/10\"\n                >\n                  <HStack className=\"items-center gap-3\">\n                    {action.icon && <action.icon size={20} color=\"#F6BF8C\" strokeWidth={2} />}\n                    <Text className=\"text-phase-text-primary\">{action.label}</Text>\n                  </HStack>\n                </Pressable>\n              ))}\n            </VStack>\n          </Box>\n        </Pressable>\n      </UniversalModal>\n    </Box>\n  );\n};\n\nexport default LotusPetalFAB;\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\Naween\\projects\\polymath-platform\\packages\\ui\\src\\components\\NetworkStatusBanner.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\Naween\\projects\\polymath-platform\\packages\\ui\\src\\components\\NotificationDrawer.tsx","messages":[{"ruleId":"react/no-unescaped-entities","severity":1,"message":"`'` can be escaped with `&apos;`, `&lsquo;`, `&#39;`, `&rsquo;`.","line":153,"column":24,"nodeType":"JSXText","messageId":"unescapedEntityAlts","suggestions":[{"messageId":"replaceWithAlt","data":{"alt":"&apos;"},"fix":{"range":[4899,4961],"text":"\n                    You&apos;re all caught up Γ£¿\n                  "},"desc":"Replace with `&apos;`."},{"messageId":"replaceWithAlt","data":{"alt":"&lsquo;"},"fix":{"range":[4899,4961],"text":"\n                    You&lsquo;re all caught up Γ£¿\n                  "},"desc":"Replace with `&lsquo;`."},{"messageId":"replaceWithAlt","data":{"alt":"&#39;"},"fix":{"range":[4899,4961],"text":"\n                    You&#39;re all caught up Γ£¿\n                  "},"desc":"Replace with `&#39;`."},{"messageId":"replaceWithAlt","data":{"alt":"&rsquo;"},"fix":{"range":[4899,4961],"text":"\n                    You&rsquo;re all caught up Γ£¿\n                  "},"desc":"Replace with `&rsquo;`."}]}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React from 'react';\nimport { Dimensions, ScrollView } from 'react-native';\nimport { Box, VStack, HStack, Text, Heading, Portal, Pressable, Spinner } from '../gluestack';\nimport { X, Bell, Info, CheckCircle, Users, BookOpen, Check } from 'lucide-react-native';\nimport Animated, { SlideInLeft, SlideOutLeft, Easing } from 'react-native-reanimated';\nimport { hapticLight } from '../utils/haptics';\nimport { useSafeAreaInsets } from 'react-native-safe-area-context';\n\nconst { width } = Dimensions.get('window');\nconst DRAWER_WIDTH = width * 0.65;\n\ninterface NotificationDrawerProps {\n  isVisible: boolean;\n  onClose: () => void;\n  notifications?: Array<{\n    id: string;\n    type: string;\n    title: string;\n    body: string | null;\n    is_read: boolean;\n    created_at: string;\n  }>;\n  unreadCount?: number;\n  isLoading?: boolean;\n  onMarkRead?: (id: string) => void;\n  onMarkAllRead?: () => void;\n}\n\nfunction notificationIcon(type: string) {\n  switch (type) {\n    case 'new_submission':\n      return BookOpen;\n    case 'submission_graded':\n      return CheckCircle;\n    case 'new_post':\n      return Users;\n    case 'group_joined':\n      return Users;\n    case 'school_circular':\n      return Bell;\n    case 'system':\n      return Info;\n    default:\n      return Info;\n  }\n}\n\nfunction relativeTime(dateStr: string): string {\n  const ts = new Date(dateStr).getTime();\n  if (isNaN(ts)) return '';\n  const diff = Date.now() - ts;\n  const mins = Math.floor(diff / 60000);\n  if (mins < 1) return 'just now';\n  if (mins < 60) return `${mins}m ago`;\n  const hours = Math.floor(mins / 60);\n  if (hours < 24) return `${hours}h ago`;\n  return `${Math.floor(hours / 24)}d ago`;\n}\n\nexport default function NotificationDrawer({\n  isVisible,\n  onClose,\n  notifications = [],\n  unreadCount = 0,\n  isLoading = false,\n  onMarkRead,\n  onMarkAllRead,\n}: NotificationDrawerProps) {\n  const insets = useSafeAreaInsets();\n\n  if (!isVisible) return null;\n\n  return (\n    <Portal>\n      <Box className=\"flex-1 bg-black/40\">\n        <Pressable\n          accessibilityRole=\"button\"\n          className=\"absolute inset-0\"\n          onPress={() => {\n            hapticLight();\n            onClose();\n          }}\n        />\n\n        <Animated.View\n          entering={SlideInLeft.duration(800).easing(Easing.out(Easing.exp))}\n          exiting={SlideOutLeft.duration(500)}\n          style={{\n            position: 'absolute',\n            top: 0,\n            left: 0,\n            bottom: 0,\n            width: DRAWER_WIDTH,\n            paddingTop: insets.top,\n            paddingBottom: insets.bottom,\n          }}\n          className=\"bg-phase-canvas border-r border-phase-surface shadow-2xl\"\n        >\n          <VStack className=\"flex-1 p-6 gap-4\">\n            {/* Header */}\n            <HStack className=\"justify-between items-center h-[60px]\">\n              <HStack className=\"items-center gap-2\">\n                <Bell size={24} color=\"#F6BF8C\" />\n                <Heading size=\"lg\" className=\"text-phase-text-primary\">\n                  Notifications\n                </Heading>\n                {unreadCount > 0 && (\n                  <Box className=\"bg-phase-accent rounded-full min-w-[20px] h-5 items-center justify-center px-1\">\n                    <Text className=\"text-white text-[11px] font-bold\">\n                      {unreadCount > 99 ? '99+' : unreadCount}\n                    </Text>\n                  </Box>\n                )}\n              </HStack>\n              <HStack className=\"items-center gap-2\">\n                {unreadCount > 0 && onMarkAllRead && (\n                  <Pressable\n                    accessibilityRole=\"button\"\n                    onPress={() => {\n                      hapticLight();\n                      onMarkAllRead();\n                    }}\n                    hitSlop={10}\n                  >\n                    <Check size={18} color=\"#F6BF8C\" />\n                  </Pressable>\n                )}\n                <Pressable\n                  accessibilityRole=\"button\"\n                  onPress={() => {\n                    hapticLight();\n                    onClose();\n                  }}\n                  hitSlop={10}\n                >\n                  <X size={28} className=\"text-phase-text-secondary\" />\n                </Pressable>\n              </HStack>\n            </HStack>\n\n            <ScrollView\n              showsVerticalScrollIndicator={false}\n              contentContainerStyle={{ paddingBottom: 40 }}\n            >\n              {isLoading ? (\n                <Box className=\"items-center py-10\">\n                  <Spinner className=\"text-phase-accent\" />\n                </Box>\n              ) : notifications.length === 0 ? (\n                <VStack className=\"items-center py-10 gap-2\">\n                  <Bell size={40} color=\"#666\" style={{ opacity: 0.3 }} />\n                  <Text className=\"text-center text-phase-text-secondary text-sm\">\n                    You're all caught up Γ£¿\n                  </Text>\n                </VStack>\n              ) : (\n                <VStack className=\"mt-4 gap-2\">\n                  {notifications.map((n) => {\n                    const Icon = notificationIcon(n.type);\n                    return (\n                      <Pressable\n                        accessibilityRole=\"button\"\n                        key={n.id}\n                        onPress={() => {\n                          hapticLight();\n                          if (!n.is_read && onMarkRead) onMarkRead(n.id);\n                        }}\n                      >\n                        <Box\n                          className={`p-4 rounded-xl border ${\n                            n.is_read\n                              ? 'bg-phase-surface border-phase-surface'\n                              : 'bg-phase-accent/10 border-phase-accent/30'\n                          }`}\n                        >\n                          <HStack className=\"items-start gap-2\">\n                            <Box className=\"p-2 rounded-full bg-phase-surface\">\n                              <Icon size={16} color={n.is_read ? '#666' : '#F6BF8C'} />\n                            </Box>\n                            <VStack className=\"flex-1 gap-1\">\n                              <Text\n                                className={`text-phase-text-primary text-sm ${n.is_read ? 'font-normal' : 'font-bold'}`}\n                              >\n                                {n.title}\n                              </Text>\n                              {n.body ? (\n                                <Text\n                                  className=\"text-phase-text-secondary text-xs\"\n                                  numberOfLines={2}\n                                >\n                                  {n.body}\n                                </Text>\n                              ) : null}\n                              <Text className=\"text-phase-text-secondary text-[10px]\">\n                                {relativeTime(n.created_at)}\n                              </Text>\n                            </VStack>\n                          </HStack>\n                        </Box>\n                      </Pressable>\n                    );\n                  })}\n                </VStack>\n              )}\n            </ScrollView>\n\n            <Text className=\"text-phase-text-secondary text-center text-xs italic mb-4\">\n              Your sanctuary stays updated.\n            </Text>\n          </VStack>\n        </Animated.View>\n      </Box>\n    </Portal>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\Naween\\projects\\polymath-platform\\packages\\ui\\src\\components\\PositiveInvitation.tsx","messages":[{"ruleId":"@typescript-eslint/no-explicit-any","severity":1,"message":"Unexpected any. Specify a different type.","line":11,"column":10,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":11,"endColumn":13,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[388,391],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[388,391],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React from 'react';\nimport { Box, VStack, Heading, Text, Center } from '../gluestack';\nimport { Plus, Sparkles, LogIn } from 'lucide-react-native';\nimport { useTranslation } from 'react-i18next';\nimport SanctuaryButton from './SanctuaryButton';\nimport { hapticLight } from '../utils/haptics';\n\ninterface PositiveInvitationProps {\n  title?: string;\n  description?: string;\n  icon?: any;\n  actionLabel?: string;\n  onAction?: () => void;\n  type?: 'empty' | 'guest';\n  context?: 'self' | 'library' | 'classroom' | 'community';\n}\n\nconst PositiveInvitation: React.FC<PositiveInvitationProps> = ({\n  title,\n  description,\n  icon: iconProp,\n  actionLabel,\n  onAction,\n  type = 'empty',\n  context = 'self',\n}) => {\n  const { t } = useTranslation();\n\n  const getMessages = () => {\n    if (type === 'guest') {\n      return {\n        title: t('invitation.guestTitle'),\n        desc: t('invitation.guestDesc'),\n        action: t('invitation.guestAction'),\n        icon: LogIn,\n      };\n    }\n\n    switch (context) {\n      case 'library':\n        return {\n          title: t('invitation.libraryEmptyTitle'),\n          desc: t('invitation.libraryEmptyDesc'),\n          action: t('invitation.libraryEmptyAction'),\n          icon: Plus,\n        };\n      case 'classroom':\n        return {\n          title: t('invitation.classroomEmptyTitle'),\n          desc: t('invitation.classroomEmptyDesc'),\n          action: t('invitation.classroomEmptyAction'),\n          icon: Plus,\n        };\n      case 'community':\n        return {\n          title: t('invitation.communityEmptyTitle'),\n          desc: t('invitation.communityEmptyDesc'),\n          action: t('invitation.communityEmptyAction'),\n          icon: Plus,\n        };\n      default:\n        return {\n          title: t('invitation.emptyTitle'),\n          desc: t('invitation.emptyDesc'),\n          action: t('invitation.emptyAction'),\n          icon: Sparkles,\n        };\n    }\n  };\n\n  const messages = getMessages();\n\n  // Safety check for Icon component to prevent \"Component is not a constructor\" crash\n  const Icon = iconProp || messages.icon || Sparkles;\n  const isValidComponent =\n    typeof Icon === 'function' || (typeof Icon === 'object' && Icon !== null);\n\n  return (\n    <Center className=\"flex-1 p-8 min-h-[250px]\">\n      <VStack className=\"items-center max-w-[300px] gap-6\">\n        <Box className=\"w-16 h-16 rounded-full bg-phase-accent/10 justify-center items-center\">\n          {isValidComponent ? (\n            <Icon size={32} className=\"text-phase-accent\" />\n          ) : (\n            <Sparkles size={32} className=\"text-phase-accent\" />\n          )}\n        </Box>\n\n        <VStack className=\"items-center gap-1\">\n          <Heading className=\"text-lg text-center text-phase-text-primary\">\n            {title || messages.title}\n          </Heading>\n          <Text className=\"text-sm text-center text-phase-text-secondary leading-relaxed\">\n            {description || messages.desc}\n          </Text>\n        </VStack>\n\n        {onAction && (\n          <SanctuaryButton\n            action=\"primary\"\n            onPress={() => {\n              hapticLight();\n              onAction();\n            }}\n            className=\"px-8\"\n          >\n            {actionLabel || messages.action}\n          </SanctuaryButton>\n        )}\n      </VStack>\n    </Center>\n  );\n};\n\nexport default PositiveInvitation;\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\Naween\\projects\\polymath-platform\\packages\\ui\\src\\components\\ProgressIndicator.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\Naween\\projects\\polymath-platform\\packages\\ui\\src\\components\\QRCodeGenerator.tsx","messages":[{"ruleId":"react-hooks/rules-of-hooks","severity":1,"message":"React Hook \"useMemo\" is called conditionally. React Hooks must be called in the exact same order in every component render.","line":55,"column":18,"nodeType":"Identifier","endLine":55,"endColumn":25}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"// QRCodeGenerator \\u2014 part of @repo/scanner-kit\n//\n// WHY SVG?\n// QR codes are resolution-independent by nature. Using react-native-svg to render\n// the matrix as <Rect> elements means the code looks crisp at any screen density.\n//\n// AESTHETICS:\n// This version supports \"Branded\" QR codes:\n// 1. Dots instead of squares (Circle modules)\n// 2. Styled Finder Patterns (Rounded \"Eyes\")\n// 3. Central Logo (Lotus emoji) enabled by High Error Correction\n// 4. \"Scan Me\" branding frame\n\nimport React, { useMemo } from 'react';\nimport Svg, { Rect, Circle, G, Text as SvgText } from 'react-native-svg';\nimport { View, Text, StyleSheet } from 'react-native';\nimport QRCode from 'qrcode';\n\nexport interface QRCodeGeneratorProps {\n  value: string;\n  size?: number;\n  /** Foreground (module) color */\n  color?: string;\n  backgroundColor?: string;\n  label?: string;\n  /** Error correction level \\u2014 H = 30% recovery (default), M = 15%, L = 7% */\n  errorCorrectionLevel?: 'L' | 'M' | 'Q' | 'H';\n  /** Border radius for the container */\n  borderRadius?: number;\n  /** Padding inside the container */\n  padding?: number;\n  /** Show the central lotus emoji */\n  showLotus?: boolean;\n  /** Show the \"SCAN ME\" frame */\n  showFrame?: boolean;\n  /** Custom text for the frame label (defaults to \"SCAN ME\") */\n  frameText?: string;\n}\n\nexport default function QRCodeGenerator({\n  value,\n  size = 180, // Slightly larger base size for aesthetic codes\n  color = '#000000',\n  backgroundColor = '#FFFFFF',\n  label,\n  errorCorrectionLevel = 'H',\n  borderRadius = 20,\n  padding = 24,\n  showLotus = true,\n  showFrame = true,\n  frameText = 'SCAN ME',\n}: QRCodeGeneratorProps) {\n  if (!value) return null;\n\n  const matrix = useMemo(() => {\n    try {\n      const qr = QRCode.create(value, { errorCorrectionLevel });\n      return qr.modules;\n    } catch (e) {\n      console.error('QR Generation Error', e);\n      return null;\n    }\n  }, [value, errorCorrectionLevel]);\n\n  if (!matrix || matrix.size === 0) {\n    return (\n      <View style={[styles.container, { justifyContent: 'center', alignItems: 'center' }]}>\n        <Text>Invalid QR data</Text>\n      </View>\n    );\n  }\n\n  const sizeCells = matrix.size;\n  const cellSize = size / sizeCells;\n\n  // Area to clear for the central logo (in module coordinates)\n  // For 'H' error correction, we can safely clear a ~20-25% center area.\n  const centerClearance = Math.floor(sizeCells * 0.25);\n  const centerStart = Math.floor((sizeCells - centerClearance) / 2);\n  const centerEnd = centerStart + centerClearance;\n\n  const renderModule = (cell: number, row: number, col: number) => {\n    if (!cell) return null;\n\n    // 1. Check if it's a Finder Pattern (the 3 eyes)\n    // Top-left, Top-right, Bottom-left 7x7 areas\n    const isEye =\n      (row < 7 && col < 7) ||\n      (row < 7 && col >= sizeCells - 7) ||\n      (row >= sizeCells - 7 && col < 7);\n\n    // 2. Check if it's in the center logo area\n    const isCenter =\n      showLotus && row >= centerStart && row < centerEnd && col >= centerStart && col < centerEnd;\n\n    if (isCenter) return null;\n\n    if (isEye) {\n      // We'll render eyes separately outside the module loop for better styling\n      // or just skip them here for data loop\n      return null;\n    }\n\n    // 3. Render data modules as Dots (Circles)\n    return (\n      <Circle\n        key={`dot-${row}-${col}`}\n        cx={col * cellSize + cellSize / 2}\n        cy={row * cellSize + cellSize / 2}\n        r={cellSize / 2.3} // Slightly smaller than half for a \"dotted\" look\n        fill={color}\n      />\n    );\n  };\n\n  const renderEye = (x: number, y: number) => {\n    const eyeSize = 7 * cellSize;\n    const innerSize = 3 * cellSize;\n    const innerOffset = 2 * cellSize;\n\n    return (\n      <G x={x} y={y}>\n        {/* Outer Ring */}\n        <Rect\n          x={cellSize * 0.5}\n          y={cellSize * 0.5}\n          width={eyeSize - cellSize}\n          height={eyeSize - cellSize}\n          rx={cellSize * 1.5}\n          fill=\"none\"\n          stroke={color}\n          strokeWidth={cellSize}\n        />\n        {/* Inner Dot */}\n        <Rect\n          x={innerOffset + cellSize * 0.5}\n          y={innerOffset + cellSize * 0.5}\n          width={innerSize - cellSize}\n          height={innerSize - cellSize}\n          rx={cellSize * 0.75}\n          fill={color}\n        />\n      </G>\n    );\n  };\n\n  return (\n    <View style={styles.outerContainer}>\n      {showFrame && (\n        <View style={[styles.frameLabel, { backgroundColor: color }]}>\n          <Text style={styles.frameLabelText}>{frameText.toUpperCase()}</Text>\n        </View>\n      )}\n\n      <View\n        style={[\n          styles.qrWrapper,\n          {\n            borderRadius,\n            padding,\n            backgroundColor,\n            borderColor: showFrame ? color : 'transparent',\n          },\n        ]}\n      >\n        <Svg width={size} height={size} viewBox={`0 0 ${size} ${size}`}>\n          {/* Background fill */}\n          <Rect x=\"0\" y=\"0\" width={size} height={size} fill={backgroundColor} />\n\n          {/* Render Eyes first */}\n          {renderEye(0, 0)}\n          {renderEye((sizeCells - 7) * cellSize, 0)}\n          {renderEye(0, (sizeCells - 7) * cellSize)}\n\n          {/* QR data modules */}\n          {[...matrix.data].map((cell, index) => {\n            const row = Math.floor(index / sizeCells);\n            const col = index % sizeCells;\n            return renderModule(cell, row, col);\n          })}\n\n          {/* Central Lotus Emoji */}\n          {showLotus && (\n            <SvgText\n              x={size / 2}\n              y={size / 2 + cellSize * 1.5} // Adjust for vertical alignment\n              fontSize={cellSize * (centerClearance - 1.5)}\n              textAnchor=\"middle\"\n            >\n              {'\\uD83E\\uDEB7'}\n            </SvgText>\n          )}\n        </Svg>\n      </View>\n\n      {label && <Text style={[styles.label, { color }]}>{label}</Text>}\n    </View>\n  );\n}\n\nconst styles = StyleSheet.create({\n  outerContainer: {\n    alignItems: 'center',\n    justifyContent: 'center',\n  },\n  qrWrapper: {\n    alignItems: 'center',\n    justifyContent: 'center',\n    borderWidth: 2,\n  },\n  container: {\n    alignItems: 'center',\n    justifyContent: 'center',\n  },\n  label: {\n    marginTop: 12,\n    fontSize: 14,\n    fontWeight: '600',\n    textAlign: 'center',\n    letterSpacing: 0.5,\n  },\n  frameLabel: {\n    paddingHorizontal: 16,\n    paddingVertical: 4,\n    borderTopLeftRadius: 10,\n    borderTopRightRadius: 10,\n    marginBottom: -2, // Slight overlap\n    zIndex: 1,\n  },\n  frameLabelText: {\n    color: 'white',\n    fontSize: 10,\n    fontWeight: 'bold',\n    letterSpacing: 2,\n  },\n});\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\Naween\\projects\\polymath-platform\\packages\\ui\\src\\components\\ResonantHeatmap.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\Naween\\projects\\polymath-platform\\packages\\ui\\src\\components\\SanctuaryBackground.tsx","messages":[{"ruleId":"react-hooks/refs","severity":1,"message":"Error: Cannot access refs during render\n\nReact refs are values that are not needed for rendering. Refs should only be accessed outside of render, such as in event handlers or effects. Accessing a ref value (the `current` property) during render can cause your component not to update as expected (https://react.dev/reference/react/useRef).\n\nC:\\Users\\Naween\\projects\\polymath-platform\\packages\\ui\\src\\components\\SanctuaryBackground.tsx:21:20\n  19 |\n  20 |   // Two gradient layers for crossfade transition\n> 21 |   const fadeAnim = useRef(new Animated.Value(0)).current;\n     |                    ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ Cannot access ref value during render\n  22 |   const prevNodes = useRef<[string, string, string]>(gradientNodes);\n  23 |   const currentNodes = useRef<[string, string, string]>(gradientNodes);\n  24 |","line":21,"column":20,"nodeType":null,"endLine":21,"endColumn":57},{"ruleId":"react-hooks/refs","severity":1,"message":"Error: Cannot access refs during render\n\nReact refs are values that are not needed for rendering. Refs should only be accessed outside of render, such as in event handlers or effects. Accessing a ref value (the `current` property) during render can cause your component not to update as expected (https://react.dev/reference/react/useRef).\n\nC:\\Users\\Naween\\projects\\polymath-platform\\packages\\ui\\src\\components\\SanctuaryBackground.tsx:21:20\n  19 |\n  20 |   // Two gradient layers for crossfade transition\n> 21 |   const fadeAnim = useRef(new Animated.Value(0)).current;\n     |                    ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ Cannot access ref value during render\n  22 |   const prevNodes = useRef<[string, string, string]>(gradientNodes);\n  23 |   const currentNodes = useRef<[string, string, string]>(gradientNodes);\n  24 |","line":21,"column":20,"nodeType":null,"endLine":21,"endColumn":57},{"ruleId":"react-hooks/refs","severity":1,"message":"Error: Cannot access refs during render\n\nReact refs are values that are not needed for rendering. Refs should only be accessed outside of render, such as in event handlers or effects. Accessing a ref value (the `current` property) during render can cause your component not to update as expected (https://react.dev/reference/react/useRef).\n\nC:\\Users\\Naween\\projects\\polymath-platform\\packages\\ui\\src\\components\\SanctuaryBackground.tsx:21:20\n  19 |\n  20 |   // Two gradient layers for crossfade transition\n> 21 |   const fadeAnim = useRef(new Animated.Value(0)).current;\n     |                    ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ Cannot access ref value during render\n  22 |   const prevNodes = useRef<[string, string, string]>(gradientNodes);\n  23 |   const currentNodes = useRef<[string, string, string]>(gradientNodes);\n  24 |","line":21,"column":20,"nodeType":null,"endLine":21,"endColumn":57},{"ruleId":"react-hooks/exhaustive-deps","severity":1,"message":"React Hook useEffect has missing dependencies: 'animationsEnabled', 'fadeAnim', and 'gradientNodes'. Either include them or remove the dependency array.","line":49,"column":6,"nodeType":"ArrayExpression","endLine":49,"endColumn":21,"suggestions":[{"desc":"Update the dependencies array to be: [phase, isDark, animationsEnabled, gradientNodes, fadeAnim]","fix":{"range":[1698,1713],"text":"[phase, isDark, animationsEnabled, gradientNodes, fadeAnim]"}}]},{"ruleId":"react-hooks/refs","severity":1,"message":"Error: Cannot access refs during render\n\nReact refs are values that are not needed for rendering. Refs should only be accessed outside of render, such as in event handlers or effects. Accessing a ref value (the `current` property) during render can cause your component not to update as expected (https://react.dev/reference/react/useRef).\n\nC:\\Users\\Naween\\projects\\polymath-platform\\packages\\ui\\src\\components\\SanctuaryBackground.tsx:55:17\n  53 |       {/* Layer 0: Previous phase (fades out) */}\n  54 |       <LinearGradient\n> 55 |         colors={prevNodes.current}\n     |                 ^^^^^^^^^^^^^^^^^ Cannot access ref value during render\n  56 |         start={{ x: 0.1, y: 0 }}\n  57 |         end={{ x: 0.9, y: 1 }}\n  58 |         style={StyleSheet.absoluteFillObject}","line":55,"column":17,"nodeType":null,"endLine":55,"endColumn":34},{"ruleId":"react-hooks/refs","severity":1,"message":"Error: Cannot access refs during render\n\nReact refs are values that are not needed for rendering. Refs should only be accessed outside of render, such as in event handlers or effects. Accessing a ref value (the `current` property) during render can cause your component not to update as expected (https://react.dev/reference/react/useRef).\n\nC:\\Users\\Naween\\projects\\polymath-platform\\packages\\ui\\src\\components\\SanctuaryBackground.tsx:66:19\n  64 |       >\n  65 |         <LinearGradient\n> 66 |           colors={currentNodes.current}\n     |                   ^^^^^^^^^^^^^^^^^^^^ Cannot access ref value during render\n  67 |           start={{ x: 0.2, y: 0 }}\n  68 |           end={{ x: 0.8, y: 1 }}\n  69 |           style={StyleSheet.absoluteFillObject}","line":66,"column":19,"nodeType":null,"endLine":66,"endColumn":39}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":6,"fixableErrorCount":0,"fixableWarningCount":0,"source":"/**\n * SanctuaryBackground\n *\n * The living backdrop of the app. Rendered ONCE at TabNavigator level,\n * behind all tab screens (which are transparent over it).\n *\n * High/Mid: Animated gradient mesh - 2 LinearGradient layers crossfading.\n * Low/Battery: Static LinearGradient snapshot - same palette, zero animation cost.\n *\n * Phase transitions: 2s crossfade between palettes.\n */\nimport React, { useEffect, useRef } from 'react';\nimport { StyleSheet, View, Animated } from 'react-native';\nimport { LinearGradient } from 'expo-linear-gradient';\nimport { useTheme } from '../hooks/useTheme';\n\nexport function SanctuaryBackground() {\n  const { gradientNodes, animationsEnabled, phase, isDark } = useTheme();\n\n  // Two gradient layers for crossfade transition\n  const fadeAnim = useRef(new Animated.Value(0)).current;\n  const prevNodes = useRef<[string, string, string]>(gradientNodes);\n  const currentNodes = useRef<[string, string, string]>(gradientNodes);\n\n  useEffect(() => {\n    if (!animationsEnabled) {\n      // Static - just update immediately\n      prevNodes.current = gradientNodes;\n      currentNodes.current = gradientNodes;\n      fadeAnim.setValue(1);\n      return;\n    }\n\n    // Crossfade: prev layer stays, new layer fades in over 2s\n    prevNodes.current = currentNodes.current;\n    currentNodes.current = gradientNodes;\n\n    fadeAnim.setValue(0);\n    const animation = Animated.timing(fadeAnim, {\n      toValue: 1,\n      duration: 2000,\n      useNativeDriver: true,\n    });\n    animation.start();\n\n    return () => animation.stop();\n    // Note: isDark theme-mode toggles DO trigger a crossfade here to ensure immediate reactive update\n    // of the background gradient nodes.\n  }, [phase, isDark]); // Re-run when phase OR theme mode changes.\n\n  return (\n    <View style={StyleSheet.absoluteFillObject} pointerEvents=\"none\">\n      {/* Layer 0: Previous phase (fades out) */}\n      <LinearGradient\n        colors={prevNodes.current}\n        start={{ x: 0.1, y: 0 }}\n        end={{ x: 0.9, y: 1 }}\n        style={StyleSheet.absoluteFillObject}\n      />\n      {/* Layer 1: Current phase (fades in) */}\n      <Animated.View\n        style={[StyleSheet.absoluteFillObject, { opacity: fadeAnim }]}\n        pointerEvents=\"none\"\n      >\n        <LinearGradient\n          colors={currentNodes.current}\n          start={{ x: 0.2, y: 0 }}\n          end={{ x: 0.8, y: 1 }}\n          style={StyleSheet.absoluteFillObject}\n        />\n      </Animated.View>\n    </View>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\Naween\\projects\\polymath-platform\\packages\\ui\\src\\components\\SanctuaryButton.tsx","messages":[{"ruleId":"@typescript-eslint/no-explicit-any","severity":1,"message":"Unexpected any. Specify a different type.","line":15,"column":11,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":15,"endColumn":14,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[485,488],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[485,488],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React from 'react';\nimport { Button, ButtonText, ButtonSpinner, ButtonIcon } from './ui/button';\n\ninterface SanctuaryButtonProps {\n  onPress: () => void;\n  children: React.ReactNode;\n  variant?: 'solid' | 'outline' | 'ghost' | 'link';\n  isLoading?: boolean;\n  isDisabled?: boolean;\n  leftIcon?: React.ElementType;\n  rightIcon?: React.ElementType;\n  size?: 'xs' | 'sm' | 'md' | 'lg';\n  fullWidth?: boolean;\n  action?: 'primary' | 'secondary' | 'negative' | 'positive';\n  style?: any;\n  accessibilityLabel?: string;\n  accessibilityHint?: string;\n  className?: string;\n}\n\nexport default function SanctuaryButton({\n  onPress,\n  children,\n  variant = 'solid',\n  isLoading = false,\n  isDisabled = false,\n  leftIcon,\n  rightIcon,\n  size = 'md',\n  fullWidth = false,\n  action = 'primary',\n  style,\n  accessibilityLabel,\n  accessibilityHint,\n  className = '',\n}: SanctuaryButtonProps) {\n  // Semantic Mapping using Phase Tokens\n  const getBgClass = () => {\n    if (variant === 'outline' || variant === 'ghost' || variant === 'link') return 'bg-transparent';\n    switch (action) {\n      case 'primary':\n        return 'bg-phase-accent';\n      case 'secondary':\n        return 'bg-phase-interactive';\n      case 'negative':\n        return 'bg-phase-danger';\n      case 'positive':\n        return 'bg-phase-reward';\n      default:\n        return 'bg-phase-accent';\n    }\n  };\n\n  const getTextClass = () => {\n    if (variant === 'solid') {\n      switch (action) {\n        case 'primary':\n          return 'text-phase-text-on-accent';\n        case 'secondary':\n          return 'text-phase-text-primary';\n        case 'negative':\n          return 'text-white';\n        case 'positive':\n          return 'text-phase-text-on-accent';\n        default:\n          return 'text-phase-text-on-accent';\n      }\n    }\n    switch (action) {\n      case 'primary':\n        return 'text-phase-accent';\n      case 'secondary':\n        return 'text-phase-text-primary';\n      case 'negative':\n        return 'text-phase-danger';\n      case 'positive':\n        return 'text-phase-reward';\n      default:\n        return 'text-phase-accent';\n    }\n  };\n\n  const getBorderClass = () => {\n    if (variant !== 'outline') return 'border-transparent';\n    switch (action) {\n      case 'primary':\n        return 'border-phase-accent';\n      case 'secondary':\n        return 'border-phase-surface';\n      case 'negative':\n        return 'border-phase-danger';\n      case 'positive':\n        return 'border-phase-reward';\n      default:\n        return 'border-phase-accent';\n    }\n  };\n\n  const sizeClasses = {\n    xs: 'h-8 px-2',\n    sm: 'h-9 px-3',\n    md: 'h-11 px-6',\n    lg: 'h-14 px-8',\n  };\n\n  return (\n    <Button\n      className={`\n                ${fullWidth ? 'w-full' : 'w-auto'}\n                ${getBgClass()}\n                ${getBorderClass()}\n                ${variant === 'outline' ? 'border' : 'border-0'}\n                ${sizeClasses[size]}\n                ${isDisabled || isLoading ? 'opacity-40' : 'opacity-100'}\n                active:opacity-80\n                ${className}\n            `}\n      isDisabled={isDisabled || isLoading}\n      onPress={onPress}\n      style={style}\n      accessibilityLabel={\n        accessibilityLabel || (typeof children === 'string' ? children : undefined)\n      }\n      accessibilityHint={accessibilityHint}\n      accessibilityState={{\n        busy: isLoading,\n        disabled: isDisabled || isLoading,\n      }}\n    >\n      {isLoading ? (\n        <ButtonSpinner className={`mr-2 ${getTextClass()}`} />\n      ) : leftIcon ? (\n        <ButtonIcon as={leftIcon} className={`mr-2 ${getTextClass()}`} />\n      ) : null}\n\n      <ButtonText className={`font-semibold ${getTextClass()}`}>{children}</ButtonText>\n\n      {!isLoading && rightIcon && (\n        <ButtonIcon as={rightIcon} className={`ml-2 ${getTextClass()}`} />\n      )}\n    </Button>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\Naween\\projects\\polymath-platform\\packages\\ui\\src\\components\\SanctuaryCard.tsx","messages":[{"ruleI