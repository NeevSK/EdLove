rCount":0,"fixableWarningCount":0,"source":"import { Alert, Platform } from 'react-native';\nimport { useStore } from '@repo/core/logic';\nimport { api } from '@repo/core/logic';\nimport { useTranslation } from 'react-i18next';\nimport { hapticSuccess, hapticWarning } from '../utils/haptics';\n\n/**\n * Hook to handle the \"Bridge to Reality\" flow when exiting Demo Mode.\n * If the user has performed any simulated writes, it prompts them to save.\n */\nexport function useDemoBridge() {\n  const { t } = useTranslation();\n  const { demoLogs, clearDemoLogs, setDemoMode } = useStore() as any;\n\n  const exitDemoWithBridge = async () => {\n    if (demoLogs.length === 0) {\n      setDemoMode(false);\n      return;\n    }\n\n    // Get the name of the first item created for a personalized message\n    const firstLog = demoLogs.find(\n      (log: any) => log.method.startsWith('create') || log.method.startsWith('add'),\n    );\n    const firstItemName =\n      (firstLog?.payload as any)?.name || (firstLog?.payload as any)?.title || 'item';\n\n    hapticWarning();\n\n    if (Platform.OS === 'web') {\n      // Two-action demo bridge - window.confirm is acceptable for this destructive choice on web\n      const save = window.confirm(\n        t('demoMode.bridgeMessage', { count: demoLogs.length, firstName: firstItemName }),\n      );\n      if (save) {\n        const { setBridging } = useStore.getState() as any;\n        try {\n          setBridging(true);\n          await processDemoLogs(demoLogs);\n          hapticSuccess();\n        } finally {\n          setBridging(false);\n          clearDemoLogs();\n          setDemoMode(false);\n        }\n      } else {\n        clearDemoLogs();\n        setDemoMode(false);\n      }\n      return;\n    }\n\n    Alert.alert(\n      t('demoMode.bridgeTitle'),\n      t('demoMode.bridgeMessage', { count: demoLogs.length, firstName: firstItemName }),\n      [\n        {\n          text: t('demoMode.bridgeDiscard'),\n          style: 'destructive',\n          onPress: () => {\n            clearDemoLogs();\n            setDemoMode(false);\n          },\n        },\n        {\n          text: t('demoMode.bridgeSave'),\n          onPress: async () => {\n            const { setBridging } = useStore.getState() as any;\n            try {\n              // Enable bridging mode to bypass API interception\n              setBridging(true);\n\n              // Bridge the data to reality\n              await processDemoLogs(demoLogs);\n\n              hapticSuccess();\n            } finally {\n              setBridging(false);\n              clearDemoLogs();\n              setDemoMode(false);\n            }\n          },\n        },\n      ],\n    );\n  };\n\n  /**\n   * Processes the shadow logs and executes real API calls.\n   */\n  const processDemoLogs = async (logs: any[]) => {\n    console.log(`[DemoBridge] Processing ${logs.length} logs for reality...`);\n\n    for (const log of logs) {\n      try {\n        const apiModule = (api as any)[log.module];\n        if (apiModule && typeof apiModule[log.method] === 'function') {\n          // Execute the REAL API call (no proxy interception because we'll be in production mode or we force it)\n          // Note: Since isDemoMode is still true during this loop,\n          // we need to make sure the proxy doesn't intercept these \"bridging\" calls.\n          // A simple way is to pass a special flag in args or rely on the fact that\n          // we'll toggle demoMode AFTER this loop correctly.\n          // Actually, the Proxy checks useStore.getState().isDemoMode.\n          // We can temporarily set a \"isBridging\" flag or just toggle demoMode first.\n\n          console.log(`[DemoBridge] Realizing: ${log.module}.${log.method}`);\n          await apiModule[log.method](log.payload);\n        }\n      } catch (err) {\n        console.error(`[DemoBridge] Failed to realize ${log.module}.${log.method}:`, err);\n      }\n    }\n  };\n\n  return { exitDemoWithBridge };\n}\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\Naween\\projects\\polymath-platform\\packages\\ui\\src\\hooks\\useResponsive.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\Naween\\projects\\polymath-platform\\packages\\ui\\src\\hooks\\useTheme.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\Naween\\projects\\polymath-platform\\packages\\ui\\src\\hooks\\useThemedColors.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\Naween\\projects\\polymath-platform\\packages\\ui\\src\\index.ts","messages":[{"ruleId":"@typescript-eslint/no-explicit-any","severity":1,"message":"Unexpected any. Specify a different type.","line":47,"column":89,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":47,"endColumn":92,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[1691,1694],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[1691,1694],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React from 'react';\n\n// 1. Fundamental Styling & Canonical Primitives\nexport * from './theme/Theme';\nexport * from './components/ui/box';\nexport * from './components/ui/center';\nexport * from './components/ui/hstack';\nexport * from './components/ui/vstack';\nexport {\n  View,\n  ScrollView,\n  Flat