 // Update local store - using direct setState to ensure reactivity\n    setUser(updatedUser as any);\n\n    // Force recompute\n    recomputeFlags(updatedUser as any);\n  };\n\n  return (\n    <ScrollView>\n      <Box className=\"p-4 bg-backgroundLight50 rounded-xl border border-borderLight100\">\n        <Text className=\"text-xl font-bold mb-2 text-textLight900\">Feature Overrides</Text>\n        <Text className=\"text-xs text-textLight500 mb-6\">\n          Toggle features for the current session. These overrides are stored in your local user\n          state.\n        </Text>\n\n        <VStack space=\"lg\">\n          {Object.entries(flags).map(([key, value]) => (\n            <HStack\n              key={key}\n              className=\"justify-between items-center bg-white p-3 rounded-md shadow-sm\"\n            >\n              <VStack className=\"flex-1\">\n                <Text className=\"text-sm font-bold text-textLight800\">{key}</Text>\n                <Text className=\"text-xs text-textLight500\">{value ? 'Active' : 'Disabled'}</Text>\n              </VStack>\n              <Switch\n                value={value as boolean}\n                onValueChange={(val: boolean) => toggleFlag(key as keyof FeatureFlags, val)}\n              />\n            </HStack>\n          ))}\n        </VStack>\n      </Box>\n    </ScrollView>\n  );\n};\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\Naween\\projects\\polymath-platform\\packages\\ui\\src\\components\\index.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\Naween\\projects\\polymath-platform\\packages\\ui\\src\\components\\ui\\actionsheet\\index.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'FadeIn' is defined but never used.","line":3,"column":47,"nodeType":"Identifier","messageId":"unusedVar","endLine":3,"endColumn":53,"sugg