{
  "extends": "../../packages/typescript-config/base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "composite": true,
    "emitDeclarationOnly": true,
    "paths": {
      "@/*": ["./src/*", "./src/*/index.ts", "./src/*/index.tsx"],
      "@repo/ui/*": ["./src/*", "./src/*/index.ts", "./src/*/index.tsx"],
      "@repo/ui": ["./src/index.ts"],
      "@repo/core": ["../core/dist/index.d.ts"],
      "@repo/core/*": ["../core/dist/*"]
    },
    "types": ["@repo/types-shim", "vitest/globals", "node", "react-test-renderer"]
  },
  "include": ["src/**/*", "nativewind-env.d.ts"],
  // *.web files are reference only (tooling/reference-only.mjs), except those shared code imports (tooling/live-web-files.json).
  "files": ["src/components/FeatureStateBoundary.web.tsx", "src/components/GatewayFooter.web.tsx", "src/components/GatewayHeader.web.tsx", "src/components/GatewayScreenShell.web.tsx", "src/components/WebScreenHeader.web.tsx", "src/icons.web.ts", "src/screens/AppSettingsScreen.web.tsx"],
  "exclude": ["node_modules", "dist", "**/*.web.ts", "**/*.web.tsx"]
}
