{
  "extends": "../../packages/typescript-config/base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "composite": true,
    "emitDeclarationOnly": true,
    "paths": {
      "@/*": ["./src/*", "./src/*/index.ts", "./src/*/index.tsx"],
      "@repo/ui/*": ["./src/*", "./src/*/index.ts", "./src/*/index.tsx"],
      "@repo/ui": ["./src/index.ts"],
      "@repo/core": ["../core/dist/index.d.ts"],
      "@repo/core/*": ["../core/dist/*"]
    },
    "types": ["@repo/types-shim", "vitest/globals", "node", "react-test-renderer"]
  },
  "include": ["src/**/*", "nativewind-env.d.ts"],
  "exclude": ["node_modules", "dist"]
}
