---
# Trübe-Art Native — clangd configuration
# Uses compile_commands.json generated by CMake for the Android NDK toolchain.
# This eliminates MSVC STL header conflicts (_Deduce_key, char_type, crtdbg.h).

CompileFlags:
  # Point to the compile_commands.json generated by gen-compile-commands.ps1
  CompilationDatabase: .

  # Strip any MSVC-isms that may leak in from RN build system
  Remove:
    - "/EH*"
    - "/W*"
    - "/wd*"
    - "/MD"
    - "/MT"
    - "/MTd"
    - "/MDd"
    - "/GR*"
    - "/Zi"
    - "/Od"
    - "/O2"
    - "/RTC*"
    - "/nologo"

  # Force clang to interpret as C++17 regardless of compile_commands fallback
  Add:
    - "-std=c++17"
    - "-Wno-unknown-warning-option"
    - "-Wno-unused-command-line-argument"
    # Include the local webgpu.h IDE stub until compile_commands.json is generated.
    # This stub provides all WGPUXxx types so TrubeCore.hpp parses cleanly.
    # The REAL webgpu.h (from Dawn/react-native-wgpu) supersedes this at build time.
    - "-I../native/include"
    # Resolve uint32_t / uint64_t / bool (provided by NDK sysroot at build time)
    - "-include"
    - "stdint.h"

Diagnostics:
  # Suppress false positives from incomplete NDK sysroot in IDE mode
  Suppress:
    - pp_file_not_found_angled_include_not_fatal
    - unused-includes
  ClangTidy:
    Add:
      - performance-*
      - readability-*
    Remove:
      - readability-magic-numbers
      - readability-braces-around-statements
