{
  "$schema": "https://json.schemastore.org/package",
  "name": "@repo/trube-art",
  "version": "0.1.1",
  "description": "Living light surfaces for React Native and Skia.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "dist",
    "artifacts",
    "README.md",
    "package.json"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./*": {
      "types": "./src/*.ts",
      "import": "./src/*.js",
      "default": "./src/*.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node ../../scripts/run-and-report.mjs --cmd \"pnpm exec tsc -p tsconfig.json && pnpm exec node --experimental-specifier-resolution=node ./scripts/generate-approval-artifacts.mjs\" --name \"packages_trube-art-build\"",
    "check-types": "node ../../scripts/run-and-report.mjs --cmd \"pnpm exec tsc --build --noEmit --checkers 4 --builders 4\" --name \"packages_trube-art-check-types\"",
    "clean": "node ../../scripts/run-and-report.mjs --cmd \"rm -rf .turbo node_modules dist\" --name \"packages_trube-art-clean\"",
    "export:artifacts": "node ../../scripts/run-and-report.mjs --cmd \"pnpm exec node --experimental-specifier-resolution=node ./scripts/generate-approval-artifacts.mjs\" --name \"packages_trube-art-export_artifacts\"",
    "lint": "node ../../scripts/run-and-report.mjs --cmd \"pnpm run lint:biome && pnpm run lint:eslint\" --name \"packages_trube-art-lint\"",
    "prepack": "node ../../scripts/run-and-report.mjs --cmd \"pnpm run clean && pnpm run build\" --name \"packages_trube-art-prepack\"",
    "lint:biome": "node ../../scripts/run-and-report.mjs --cmd \"node ../../scripts/scoped-biome.mjs\" --name \"packages_trube-art-lint_biome\"",
    "lint:eslint": "node ../../scripts/run-and-report.mjs --cmd \"eslint .\" --name \"packages_trube-art-lint_eslint\"",
    "format": "node ../../scripts/run-and-report.mjs --cmd \"node ../../scripts/scoped-biome.mjs --write\" --name \"packages_trube-art-format\"",
    "check-cycles": "node ../../scripts/run-and-report.mjs --cmd \"node ../../scripts/refactor/sovereign-cycle-checker.mjs\" --name \"packages_trube-art-check-cycles\"",
    "test": "node ../../scripts/run-and-report.mjs --cmd \"vitest run\" --name \"packages_trube-art-test\"",
    "test:watch": "node ../../scripts/run-and-report.mjs --cmd \"vitest\" --name \"packages_trube-art-test_watch\"",
    "test:ui": "node ../../scripts/run-and-report.mjs --cmd \"vitest --ui\" --name \"packages_trube-art-test_ui\""
  },
  "keywords": [
    "react-native",
    "skia",
    "shader",
    "visual-art",
    "generative-art",
    "design-system"
  ],
  "peerDependencies": {
    "@shopify/react-native-skia": "2.6.2",
    "react": "*",
    "react-native": "*",
    "react-native-nitro-modules": ">= 0.20.0",
    "react-native-reanimated": ">= 4.0.0-alpha",
    "react-native-wgpu": ">= 0.1.0"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:^",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^25.9.2",
    "@types/react": "^19.2.17",
    "@webgpu/types": "^0.1.70",
    "eslint": "^10.4.1",
    "react-native-nitro-modules": "0.33.9",
    "react-native-reanimated": "^4.4.1",
    "react-native-wgpu": "~0.5.15",
    "rimraf": "^6.1.3",
    "typegpu": "~0.11.8",
    "typescript": "rc",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.8"
  },
  "_originalScripts": {
    "build": "pnpm exec tsc -p tsconfig.json && pnpm exec node --experimental-specifier-resolution=node ./scripts/generate-approval-artifacts.mjs",
    "check-types": "pnpm exec tsc --build --noEmit --checkers 4 --builders 4",
    "clean": "rm -rf .turbo node_modules dist",
    "export:artifacts": "pnpm exec node --experimental-specifier-resolution=node ./scripts/generate-approval-artifacts.mjs",
    "lint": "pnpm run lint:biome && pnpm run lint:eslint",
    "prepack": "pnpm run clean && pnpm run build",
    "lint:biome": "node ../../scripts/scoped-biome.mjs",
    "lint:eslint": "eslint .",
    "format": "node ../../scripts/scoped-biome.mjs --write",
    "check-cycles": "node ../../scripts/refactor/sovereign-cycle-checker.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui"
  }
}
