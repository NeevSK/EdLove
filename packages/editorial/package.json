{
  "name": "@repo/editorial",
  "version": "0.1.0",
  "description": "Provider-neutral editorial publishing contracts and distribution ledger",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./*": {
      "types": "./src/*.ts",
      "import": "./src/*.ts",
      "default": "./src/*.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "check-types": "tsc --build --noEmit",
    "test": "vitest run",
    "lint:biome": "biome check src",
    "lint:eslint": "eslint src"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@biomejs/biome": "^2.5.11",
    "eslint": "^10.9.1",
    "typescript": "7.0.2",
    "vitest": "^4.1.11"
  }
}
