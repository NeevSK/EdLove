{
  "name": "@repo/editorial",
  "version": "0.1.0",
  "description": "Provider-neutral editorial publishing contracts and distribution ledger",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./*": {
      "types": "./src/*.ts",
      "import": "./src/*.ts",
      "default": "./src/*.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "check-types": "tsc --build --noEmit",
    "test": "node ../../scripts/run-and-report.mjs --cmd \"vitest run\" --name \"packages_editorial-test\" --evidence-level G0",
    "lint:biome": "biome check src",
    "lint:eslint": "eslint src"
  },
  "dependencies": {
    "@intuitui-labs/editorial": "^0.1.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@repo/typescript-config": "workspace:*",
    "eslint": "^10.13.0",
    "typescript": "7.1.0-beta",
    "vitest": "5.0.5"
  }
}
