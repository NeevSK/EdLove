    "@repo/typescript-config": "workspace:*",
    "@types/react": "~19.1.10",
    "eslint": "^9.38.0",
    "react-i18next": "^16.5.4",
    "typescript": "~5.9.2"
  },
  "peerDependencies": {
    "@repo/ui": "*",
