{
  "name": "@repo/profile",
  "version": "1.5.0",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./*": {
      "types": "./src/*.ts",
      "import": "./src/*.js",
      "default": "./src/*.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "lint": "node ../../scripts/run-and-report.mjs --cmd \"pnpm run lint:biome && pnpm run lint:eslint\" --name \"packages_profile-lint\"",
    "lint:biome": "node ../../scripts/run-and-report.mjs --cmd \"node ../../scripts/scoped-biome.mjs\" --name \"packages_profile-lint_biome\"",
    "lint:eslint": "node ../../scripts/run-and-report.mjs --cmd \"eslint .\" --name \"packages_profile-lint_eslint\"",
    "format": "node ../../scripts/run-and-report.mjs --cmd \"node ../../scripts/scoped-biome.mjs --write\" --name \"packages_profile-format\"",
    "check-cycles": "node ../../scripts/run-and-report.mjs --cmd \"node ../../scripts/refactor/sovereign-cycle-checker.mjs\" --name \"packages_profile-check-cycles\"",
    "check-types": "node ../../scripts/run-and-report.mjs --cmd \"pnpm exec tsc --build --noEmit\" --name \"packages_profile-check-types\"",
    "test": "node ../../scripts/run-and-report.mjs --cmd \"vitest run\" --name \"packages_profile-test\" --evidence-level G1",
    "test:watch": "node ../../scripts/run-and-report.mjs --cmd \"vitest\" --name \"packages_profile-test_watch\" --evidence-level G1",
    "test:ui": "node ../../scripts/run-and-report.mjs --cmd \"vitest --ui\" --name \"packages_profile-test_ui\" --evidence-level G1",
    "clean": "node ../../scripts/run-and-report.mjs --cmd \"rm -rf .turbo node_modules dist\" --name \"packages_profile-clean\""
  },
  "dependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@repo/core": "workspace:*",
    "@repo/database": "workspace:*",
    "@repo/people": "workspace:*",
    "@repo/scanner-kit": "workspace:*",
    "@repo/ui": "workspace:*",
    "@tanstack/react-query": "^5.106.1",
    "expo-clipboard": "~58.0.4",
    "expo-file-system": "~58.0.13",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-router": "~58.0.30",
    "react-i18next": "^17.1.12",
    "react-native-reanimated": "4.7.1"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:^",
    "@repo/typescript-config": "workspace:*",
    "@types/react": "^19.3.0",
    "@vitest/ui": "^5.1.0",
    "eslint": "^10.14.0",
    "i18next": "^26.7.1",
    "typescript": "7.1.0-beta",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "5.1.0"
  },
  "peerDependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@repo/ui": "1.5.0",
    "react": "19.3.1",
    "react-i18next": "^17.1.12",
    "react-native": "0.88.1"
  },
  "_originalScripts": {
    "lint": "pnpm run lint:biome && pnpm run lint:eslint",
    "lint:biome": "node ../../scripts/scoped-biome.mjs",
    "lint:eslint": "eslint .",
    "format": "node ../../scripts/scoped-biome.mjs --write",
    "check-cycles": "node ../../scripts/refactor/sovereign-cycle-checker.mjs",
    "check-types": "pnpm exec tsc --build --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "clean": "rm -rf .turbo node_modules dist"
  }
}
