{
  "name": "@repo/profile",
  "version": "1.5.0",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./own": {
      "types": "./src/own.ts",
      "import": "./src/own.ts",
      "default": "./src/own.ts"
    },
    "./public": {
      "types": "./src/public.ts",
      "import": "./src/public.ts",
      "default": "./src/public.ts"
    },
    "./settings": {
      "types": "./src/settings.ts",
      "import": "./src/settings.ts",
      "default": "./src/settings.ts"
    },
    "./history": {
      "types": "./src/history.ts",
      "import": "./src/history.ts",
      "default": "./src/history.ts"
    },
    "./api": {
      "types": "./src/api/index.ts",
      "import": "./src/api/index.ts",
      "default": "./src/api/index.ts"
    },
    "./screens/FullProfileScreen": {
      "import": "./src/screens/FullProfileScreen.tsx",
      "browser": "./src/screens/FullProfileScreen.web.tsx",
      "react-native": "./src/screens/FullProfileScreen.tsx",
      "default": "./src/screens/FullProfileScreen.tsx"
    },
    "./screens/FullProfileScreen.web": {
      "types": "./src/screens/FullProfileScreen.web.tsx",
      "import": "./src/screens/FullProfileScreen.web.tsx",
      "default": "./src/screens/FullProfileScreen.web.tsx"
    },
    "./screens/ProfileScreen": {
      "import": "./src/screens/ProfileScreen.tsx",
      "browser": "./src/screens/ProfileScreen.web.tsx",
      "react-native": "./src/screens/ProfileScreen.tsx",
      "default": "./src/screens/ProfileScreen.tsx"
    },
    "./screens/ProfileScreen.web": {
      "types": "./src/screens/ProfileScreen.web.tsx",
      "import": "./src/screens/ProfileScreen.web.tsx",
      "default": "./src/screens/ProfileScreen.web.tsx"
    },
    "./screens/PublicProfileScreen.web": {
      "types": "./src/screens/PublicProfileScreen.web.tsx",
      "import": "./src/screens/PublicProfileScreen.web.tsx",
      "default": "./src/screens/PublicProfileScreen.web.tsx"
    },
    "./screens/MuteHubScreen": {
      "types": "./src/screens/MuteHubScreen.tsx",
      "import": "./src/screens/MuteHubScreen.tsx",
      "default": "./src/screens/MuteHubScreen.tsx"
    },
    "./screens/ThuthimalClaimScreen": {
      "types": "./src/screens/ThuthimalClaimScreen.tsx",
      "import": "./src/screens/ThuthimalClaimScreen.tsx",
      "default": "./src/screens/ThuthimalClaimScreen.tsx"
    },
    "./*": {
      "types": "./src/*.ts",
      "import": "./src/*.js",
      "default": "./src/*.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "lint": "node ../../scripts/run-and-report.mjs --cmd \"pnpm run lint:biome && pnpm run lint:eslint\" --name \"packages_profile-lint\"",
    "lint:biome": "node ../../scripts/run-and-report.mjs --cmd \"node ../../scripts/scoped-biome.mjs\" --name \"packages_profile-lint_biome\"",
    "lint:eslint": "node ../../scripts/run-and-report.mjs --cmd \"eslint .\" --name \"packages_profile-lint_eslint\"",
    "format": "node ../../scripts/run-and-report.mjs --cmd \"node ../../scripts/scoped-biome.mjs --write\" --name \"packages_profile-format\"",
    "check-cycles": "node ../../scripts/run-and-report.mjs --cmd \"node ../../scripts/refactor/sovereign-cycle-checker.mjs\" --name \"packages_profile-check-cycles\"",
    "check-types": "node ../../scripts/run-and-report.mjs --cmd \"pnpm exec tsc --build --noEmit\" --name \"packages_profile-check-types\"",
    "test": "node ../../scripts/run-and-report.mjs --cmd \"vitest run\" --name \"packages_profile-test\"",
    "test:watch": "node ../../scripts/run-and-report.mjs --cmd \"vitest\" --name \"packages_profile-test_watch\"",
    "test:ui": "node ../../scripts/run-and-report.mjs --cmd \"vitest --ui\" --name \"packages_profile-test_ui\"",
    "clean": "node ../../scripts/run-and-report.mjs --cmd \"rm -rf .turbo node_modules dist\" --name \"packages_profile-clean\""
  },
  "dependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@repo/core": "workspace:*",
    "@repo/database": "workspace:*",
    "@repo/people": "workspace:*",
    "@repo/scanner-kit": "workspace:*",
    "@repo/ui": "workspace:*",
    "@tanstack/react-query": "^5.102.8",
    "expo-clipboard": "~57.0.1",
    "expo-file-system": "~57.0.6",
    "expo-image-manipulator": "~57.0.14",
    "expo-image-picker": "~57.0.14",
    "expo-router": "~57.0.17",
    "react-i18next": "^17.0.12",
    "react-native-reanimated": "^4.6.0"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:^",
    "@repo/typescript-config": "workspace:*",
    "@types/react": "^19.2.18",
    "@vitest/ui": "^5.0.0",
    "eslint": "^10.9.1",
    "i18next": "^26.4.0",
    "typescript": "rc",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.0"
  },
  "peerDependencies": {
    "@react-native-async-storage/async-storage": "*",
    "@repo/ui": "*",
    "react": "*",
    "react-i18next": "*",
    "react-native": "*"
  },
  "_originalScripts": {
    "lint": "pnpm run lint:biome && pnpm run lint:eslint",
    "lint:biome": "node ../../scripts/scoped-biome.mjs",
    "lint:eslint": "eslint .",
    "format": "node ../../scripts/scoped-biome.mjs --write",
    "check-cycles": "node ../../scripts/refactor/sovereign-cycle-checker.mjs",
    "check-types": "pnpm exec tsc --build --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "clean": "rm -rf .turbo node_modules dist"
  }
}
