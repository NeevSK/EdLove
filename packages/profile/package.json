{
  "name": "@repo/profile",
  "version": "1.0.0",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./components": "./src/components/index.ts",
    "./hooks": "./src/hooks/index.ts",
    "./screens": "./src/screens/index.ts",
    "./types": "./src/types/index.ts",
    "./api": "./src/api/index.ts",
    "./navigation": "./src/navigation/index.ts",
    "./screens/ProfileScreen.web": "./src/screens/ProfileScreen.web.tsx",
    "./screens/FullProfileScreen.web": "./src/screens/FullProfileScreen.web.tsx",
    "./screens/PublicProfileScreen.web": "./src/screens/PublicProfileScreen.web.tsx",
    "./package.json": "./package.json"
  },
  "scripts": {
    "lint": "pnpm run lint:biome && pnpm run lint:eslint",
    "lint:biome": "biome check .",
    "lint:eslint": "eslint .",
    "format": "biome format --write .",
    "check-cycles": "node ../../scripts/refactor/sovereign-cycle-checker.mjs",
    "check-types": "pnpm exec tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "clean": "rm -rf .turbo node_modules dist"
  },
  "dependencies": {
    "@repo/database": "workspace:*",
    "@repo/scanner-kit": "workspace:*",
    "@eslint/eslintrc": "^3.3.5",
    "@repo/core": "workspace:*",
    "@repo/ui": "workspace:*",
    "@repo/people": "workspace:*",
    "expo-clipboard": "~55.0.13",
    "expo-file-system": "~55.0.17",
    "expo-image-manipulator": "~55.0.15",
    "expo-image-picker": "~55.0.19",
    "@tanstack/react-query": "^5.90.20",
    "lucide-react-native": "^0.563.0",
    "react-i18next": "^16.5.4",
    "react-native-reanimated": "^4.2.1",
    "@react-native-async-storage/async-storage": "2.2.0"
  },
  "devDependencies": {
    "i18next": "^25.8.11",
    "@repo/eslint-config": "workspace:^",
    "@repo/typescript-config": "workspace:*",
    "@types/react": "^19.2.14",
    "@types/react-native": "workspace:*",
    "@vitest/ui": "^4.1.5",
    "eslint": "^9.38.0",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^2.1.9"
  },
  "peerDependencies": {
    "@repo/ui": "*",
    "lucide-react-native": "*",
    "react": "*",
    "react-i18next": "*",
    "react-native": "*",
    "@react-navigation/native": "*",
    "@react-native-async-storage/async-storage": "*"
  }
}
