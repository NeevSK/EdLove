entity User {
  id: String,
  school_id?: String,
  active_entity_id?: String,
  active_entity_type?: String,
  capacity?: String,
  grade_id?: String,
  section_id?: String,
  classroom_ids?: Set<String>,
  child_student_ids?: Set<String>
};

entity School {
  id: String
};

entity Classroom {
  id: String,
  school_id?: String,
  teacher_id?: String,
  grade_id?: String,
  section_id?: String
};

entity PersonalClassroom {
  id: String,
  user_id?: String,
  name?: String,
  type?: String
};

entity AttendanceRecord {
  id: String,
