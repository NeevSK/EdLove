};

entity AssignmentSubmission {
  id: String,
  school_id?: String,
  assignment_id?: String,
  student_id?: String,
  classroom_id?: String
};

type SecurityContext = {
  device_trust?: String,
  network_zone?: String
};

action "read", "create", "update", "delete", "use_ai" appliesTo {
    principal: [User],
  resource: [
    User, Student, GratitudeGift, School, Classroom, AttendanceRecord, DailyAttendance, AttendanceSession, Grade, GradeMark, Assignment, Lesson, Material,
    StaffLeave, MoodLog, FireJournal, InventoryItem, InventoryRequest, Group, Post, Ledger, Accounting, Payments, MappingTopology,
    Guardian, SentinelAuditLog, JoyMoments, GratitudeEntries, EnergyForecasts,
    UserRewards, WhisperedMoment,
    PersonalClassroom, AIAssistant, ClassroomNote, Library, Wellbeing, Staff, DailyContent, DecisionJournal,
    Manifesto, ManifestoEndorsement, AssignmentSubmission, Calendar, Notification, PrincipalNote, Announcement,
    UserBlock, DirectConversation, DirectMessage
  ],
  context: SecurityContext
};
