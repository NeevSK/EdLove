{
  "name": "@repo/policies",
  "version": "1.0.0",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "audit:cedar": "node ./scripts/audit-cedar.mjs",
    "test": "node ../../scripts/run-and-report.mjs --cmd \"vitest run\" --name \"packages_policies-test\" --evidence-level G2"
  },
  "dependencies": {
    "@cedar-policy/cedar-wasm": "4.14.0"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^26.6.6",
    "typescript": "7.1.0-beta",
    "vitest": "5.1.0"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./authorizationRegistry": {
      "types": "./src/authorizationRegistry.ts",
      "import": "./src/authorizationRegistry.ts",
      "default": "./src/authorizationRegistry.ts"
    },
    "./*": {
      "types": "./src/*.ts",
      "import": "./src/*.js",
      "default": "./src/*.js"
    },
    "./package.json": "./package.json"
  },
  "_originalScripts": {
    "test": "vitest run"
  }
}
