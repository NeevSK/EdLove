{
  "name": "@repo/policies",
  "version": "1.0.0",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "test": "node ../../scripts/run-and-report.mjs --cmd \"vitest run\" --name \"packages_policies-test\""
  },
  "dependencies": {
    "@cedar-policy/cedar-wasm": "^4.11.0"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^25.9.2",
    "typescript": "rc",
    "vitest": "^5.0.0"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./*": {
      "types": "./src/*.ts",
      "import": "./src/*.js",
      "default": "./src/*.js"
    },
    "./package.json": "./package.json"
  },
  "_originalScripts": {
    "test": "vitest run"
  }
