{
  "name": "@repo/scanner-kit",
  "version": "0.0.0",
  "private": true,
  "sideEffects": false,
  "engines": {
    "node": ">=20.0.0"
  },
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "check-types": "pnpm exec tsc --noEmit",
    "lint": "pnpm run lint:biome && pnpm run lint:eslint",
    "lint:biome": "biome check .",
    "lint:eslint": "eslint .",
    "format": "biome format --write .",
    "check-cycles": "node ../../scripts/refactor/sovereign-cycle-checker.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "clean": "rm -rf .turbo node_modules dist"
  },
  "dependencies": {
    "@repo/core": "workspace:*",
    "@repo/ui": "workspace:*",
    "react-i18next": "^16.5.4"
  },
  "peerDependencies": {
    "@react-native-async-storage/async-storage": "2.1.2",
    "@react-native-ml-kit/barcode-scanning": "*",
    "@react-native-ml-kit/text-recognition": "*",
    "buffer": "*",
    "expo-camera": "~55.0.10",
    "expo-clipboard": "^55.0.8",
    "expo-file-system": "~55.0.11",
    "expo-image-manipulator": "~55.0.11",
    "expo-image-picker": "~55.0.13",
    "expo-sharing": "~55.0.11",
    "jpeg-js": "*",
    "jsqr": "*",
    "qrcode": "*",
    "react": "19.2.0",
    "react-native": "0.83.2",
    "react-native-svg": "15.15.3"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:^",
    "@repo/typescript-config": "workspace:*",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.14",
    "@types/react-native": "0.83.2",
    "eslint": "^9.38.0",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9",
    "vite-tsconfig-paths": "^6.1.1"
  }
}
