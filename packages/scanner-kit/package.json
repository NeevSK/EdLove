{
  "name": "@repo/scanner-kit",
  "version": "0.0.0",
  "private": true,
  "sideEffects": false,
  "engines": {
    "node": ">=20.0.0"
  },
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "check-types": "powershell -File ../../scripts/audit-wrapper.ps1 -Cmd \"pnpm exec tsc --noEmit\" -Log \"reports/check-types.txt\"",
    "lint": "powershell -File ../../scripts/audit-wrapper.ps1 -Cmd \"pnpm exec eslint .\" -Log \"reports/lint.txt\""
  },
  "dependencies": {
    "@repo/core": "workspace:*",
    "@repo/ui": "workspace:*"
  },
  "peerDependencies": {
    "@react-native-ml-kit/text-recognition": "*",
    "buffer": "*",
    "expo-camera": "~55.0.10",
    "expo-file-system": "~55.0.11",
    "expo-image-manipulator": "~55.0.11",
    "expo-image-picker": "~55.0.13",
    "jpeg-js": "*",
    "jsqr": "*",
    "@react-native-ml-kit/barcode-scanning": "*",
    "qrcode": "*",
    "react": "*",
    "react-native": "*",
    "react-native-svg": "15.15.3"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/react": "~19.1.10",
    "eslint": "^9.38.0",
    "@repo/eslint-config": "workspace:*",
    "tailwindcss": "~3.4.17",
    "typescript": "~5.9.2"
  }
}
