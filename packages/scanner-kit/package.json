{
  "name": "@repo/scanner-kit",
  "version": "1.5.0",
  "private": true,
  "sideEffects": false,
  "engines": {
    "node": ">=20.0.0"
  },
  "exports": {
    ".": "./src/index.ts",
    "./qr/*": "./src/qr/*.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "check-types": "node ../../scripts/run-and-report.mjs --cmd \"pnpm exec tsc --build --noEmit\" --name \"packages_scanner-kit-check-types\"",
    "lint": "node ../../scripts/run-and-report.mjs --cmd \"pnpm run lint:biome && pnpm run lint:eslint\" --name \"packages_scanner-kit-lint\"",
    "lint:biome": "node ../../scripts/run-and-report.mjs --cmd \"node ../../scripts/scoped-biome.mjs\" --name \"packages_scanner-kit-lint_biome\"",
    "lint:eslint": "node ../../scripts/run-and-report.mjs --cmd \"eslint .\" --name \"packages_scanner-kit-lint_eslint\"",
    "format": "node ../../scripts/run-and-report.mjs --cmd \"node ../../scripts/scoped-biome.mjs --write\" --name \"packages_scanner-kit-format\"",
    "check-cycles": "node ../../scripts/run-and-report.mjs --cmd \"node ../../scripts/refactor/sovereign-cycle-checker.mjs\" --name \"packages_scanner-kit-check-cycles\"",
    "test": "node ../../scripts/run-and-report.mjs --cmd \"vitest run\" --name \"packages_scanner-kit-test\" --evidence-level G1",
    "test:watch": "node ../../scripts/run-and-report.mjs --cmd \"vitest\" --name \"packages_scanner-kit-test_watch\" --evidence-level G1",
    "test:ui": "node ../../scripts/run-and-report.mjs --cmd \"vitest --ui\" --name \"packages_scanner-kit-test_ui\" --evidence-level G1",
    "clean": "node ../../scripts/run-and-report.mjs --cmd \"rm -rf .turbo node_modules dist\" --name \"packages_scanner-kit-clean\""
  },
  "dependencies": {
    "@repo/core": "workspace:*",
    "@repo/ui": "workspace:*",
    "expo-keep-awake": "~58.0.3",
    "expo-router": "~58.0.22",
    "react-i18next": "^17.0.18"
  },
  "peerDependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "buffer": "*",
    "expo-brightness": ">=58.0.2",
    "expo-camera": "~58.0.10",
    "expo-clipboard": "~58.0.3",
    "expo-file-system": "~58.0.9",
    "expo-image-manipulator": "~58.0.14",
    "expo-image-picker": "~58.0.10",
    "expo-media-library": "~58.0.10",
    "expo-sharing": "~58.0.19",
    "jpeg-js": "*",
    "jsqr": "*",
    "qrcode": "*",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-svg": "15.16.0"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:^",
    "@repo/typescript-config": "workspace:*",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "eslint": "^10.12.0",
    "tailwindcss": "4.3.0",
    "typescript": "7.0.2",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "5.0.5"
  },
  "_originalScripts": {
    "check-types": "pnpm exec tsc --build --noEmit",
    "lint": "pnpm run lint:biome && pnpm run lint:eslint",
    "lint:biome": "node ../../scripts/scoped-biome.mjs",
    "lint:eslint": "eslint .",
    "format": "node ../../scripts/scoped-biome.mjs --write",
    "check-cycles": "node ../../scripts/refactor/sovereign-cycle-checker.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "clean": "rm -rf .turbo node_modules dist"
  }
}
