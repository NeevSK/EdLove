{
  "name": "@repo/scanner-kit",
  "version": "0.0.1",
  "private": true,
  "sideEffects": false,
  "engines": {
    "node": ">=20.0.0"
  },
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "check-types": "node ../../scripts/run-and-report.mjs --cmd \"pnpm exec tsc --build --noEmit --checkers 4 --builders 4\" --name \"packages_scanner-kit-check-types\"",
    "lint": "node ../../scripts/run-and-report.mjs --cmd \"pnpm run lint:biome && pnpm run lint:eslint\" --name \"packages_scanner-kit-lint\"",
    "lint:biome": "node ../../scripts/run-and-report.mjs --cmd \"node ../../scripts/scoped-biome.mjs\" --name \"packages_scanner-kit-lint_biome\"",
    "lint:eslint": "node ../../scripts/run-and-report.mjs --cmd \"eslint .\" --name \"packages_scanner-kit-lint_eslint\"",
    "format": "node ../../scripts/run-and-report.mjs --cmd \"node ../../scripts/scoped-biome.mjs --write\" --name \"packages_scanner-kit-format\"",
    "check-cycles": "node ../../scripts/run-and-report.mjs --cmd \"node ../../scripts/refactor/sovereign-cycle-checker.mjs\" --name \"packages_scanner-kit-check-cycles\"",
    "test": "node ../../scripts/run-and-report.mjs --cmd \"vitest run\" --name \"packages_scanner-kit-test\"",
    "test:watch": "node ../../scripts/run-and-report.mjs --cmd \"vitest\" --name \"packages_scanner-kit-test_watch\"",
    "test:ui": "node ../../scripts/run-and-report.mjs --cmd \"vitest --ui\" --name \"packages_scanner-kit-test_ui\"",
    "clean": "node ../../scripts/run-and-report.mjs --cmd \"rm -rf .turbo node_modules dist\" --name \"packages_scanner-kit-clean\""
  },
  "dependencies": {
    "@repo/core": "workspace:*",
    "@repo/ui": "workspace:*",
    "expo-brightness": "~57.0.1",
    "expo-keep-awake": "~57.0.1",
    "expo-media-library": "~57.0.3",
    "expo-router": "~57.0.9",
    "react-i18next": "^17.0.8"
  },
  "peerDependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-ml-kit/barcode-scanning": "*",
    "@react-native-ml-kit/text-recognition": "*",
    "buffer": "*",
    "expo-camera": "~56.0.7",
    "expo-clipboard": "~56.0.4",
    "expo-file-system": "~56.0.7",
    "expo-image-manipulator": "~56.0.17",
    "expo-image-picker": "~56.0.16",
    "expo-sharing": "~56.0.16",
    "jpeg-js": "*",
    "jsqr": "*",
    "qrcode": "*",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-svg": "15.15.4"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:^",
    "@repo/typescript-config": "workspace:*",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-native": "0.83.2",
    "eslint": "^10.4.1",
    "tailwindcss": "^4.3.0",
    "typescript": "rc",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.8"
  },
  "_originalScripts": {
    "check-types": "pnpm exec tsc --build --noEmit --checkers 4 --builders 4",
    "lint": "pnpm run lint:biome && pnpm run lint:eslint",
    "lint:biome": "node ../../scripts/scoped-biome.mjs",
    "lint:eslint": "eslint .",
    "format": "node ../../scripts/scoped-biome.mjs --write",
    "check-cycles": "node ../../scripts/refactor/sovereign-cycle-checker.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "clean": "rm -rf .turbo node_modules dist"
  }
}
