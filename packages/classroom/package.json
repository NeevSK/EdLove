{
  "name": "@repo/classroom",
  "version": "0.0.1",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./components": "./src/components/index.ts",
    "./hooks": "./src/hooks/index.ts",
    "./screens": "./src/screens/index.ts",
    "./types": "./src/types/index.ts",
    "./core": "./src/entrypoints/core.ts",
    "./teacher": "./src/entrypoints/teacher.ts",
    "./student": "./src/entrypoints/student.ts",
    "./screens/*": "./src/screens/*",
    "./components/*": "./src/components/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "check-types": "pnpm exec tsc --noEmit",
    "lint": "pnpm run lint:biome && pnpm run lint:eslint",
    "clean": "rm -rf .turbo node_modules dist",
    "lint:biome": "biome check .",
    "lint:eslint": "eslint .",
    "format": "biome format --write .",
    "check-cycles": "node ../../scripts/refactor/sovereign-cycle-checker.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui"
  },
  "dependencies": {
    "@repo/admin": "workspace:*",
    "@repo/ai": "workspace:*",
    "@repo/analytics": "workspace:*",
    "@repo/community": "workspace:*",
    "@repo/core": "workspace:*",
    "@repo/graphics": "workspace:*",
    "@repo/library": "workspace:*",
    "@repo/profile": "workspace:*",
    "@repo/people": "workspace:*",
    "@repo/self": "workspace:*",
    "@repo/scanner-kit": "workspace:*",
    "@repo/ui": "workspace:*",
    "@tanstack/react-query": "^5.90.20",
    "date-fns": "^4.1.0",
    "expo-clipboard": "~55.0.13",
    "expo-image-picker": "~55.0.19",
    "lucide-react-native": "^0.563.0",
    "react-i18next": "^16.5.4",
    "react-native-reanimated": "^4.2.1"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:^",
    "@repo/typescript-config": "workspace:*",
    "@types/react": "^19.2.14",
    "@types/react-native": "workspace:*",
    "eslint": "^9.38.0",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9",
    "vite-tsconfig-paths": "^6.1.1"
  },
  "peerDependencies": {
    "@react-navigation/native": "*",
    "lucide-react-native": "*",
    "react": "*",
    "react-i18next": "*",
    "react-native": "*"
  }
}
