{
  "name": "@repo/classroom",
  "version": "0.0.2",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./*": {
      "types": "./src/*.ts",
      "import": "./src/*.js",
      "default": "./src/*.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "check-types": "pnpm exec tsc --noEmit",
    "lint": "pnpm run lint:biome && pnpm run lint:eslint",
    "clean": "rm -rf .turbo node_modules dist",
    "lint:biome": "biome check .",
    "lint:eslint": "eslint .",
    "format": "biome format --write .",
    "check-cycles": "node ../../scripts/refactor/sovereign-cycle-checker.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui"
  },
  "dependencies": {
    "@repo/admin": "workspace:*",
    "@repo/ai": "workspace:*",
    "@repo/analytics": "workspace:*",
    "@repo/community": "workspace:*",
    "@repo/core": "workspace:*",
    "@repo/graphics": "workspace:*",
    "@repo/library": "workspace:*",
    "@repo/profile": "workspace:*",
    "@repo/people": "workspace:*",
    "@repo/self": "workspace:*",
    "@repo/scanner-kit": "workspace:*",
    "@repo/ui": "workspace:*",
    "@tanstack/react-query": "^5.90.20",
    "date-fns": "^4.1.0",
    "expo-clipboard": "~56.0.0",
    "expo-image-picker": "~56.0.0",
    "lucide-react-native": "^0.563.0",
    "react-i18next": "^16.5.4",
    "react-native-reanimated": "4.3.1"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:^",
    "@repo/typescript-config": "workspace:*",
    "@types/react": "^19.2.14",
    "@types/react-native": "workspace:*",
    "eslint": "^9.38.0",
    "tailwindcss": "^4.1.18",
    "typescript": "^6.0.3",
    "vitest": "^2.1.9",
    "vite-tsconfig-paths": "^6.1.1"
  },
  "peerDependencies": {
    "@react-navigation/native": "*",
    "lucide-react-native": "*",
    "react": "*",
    "react-i18next": "*",
    "react-native": "*"
  }
}
