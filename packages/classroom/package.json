{
  "name": "@repo/classroom",
  "version": "0.0.2",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./overview": {
      "types": "./src/entrypoints/overview.ts",
      "import": "./src/entrypoints/overview.ts",
      "default": "./src/entrypoints/overview.ts"
    },
    "./teacher": {
      "types": "./src/entrypoints/teacher.ts",
      "import": "./src/entrypoints/teacher.ts",
      "default": "./src/entrypoints/teacher.ts"
    },
    "./student": {
      "types": "./src/entrypoints/student.ts",
      "import": "./src/entrypoints/student.ts",
      "default": "./src/entrypoints/student.ts"
    },
    "./attendance": {
      "types": "./src/entrypoints/attendance.ts",
      "import": "./src/entrypoints/attendance.ts",
      "default": "./src/entrypoints/attendance.ts"
    },
    "./gradebook": {
      "types": "./src/entrypoints/gradebook.ts",
      "import": "./src/entrypoints/gradebook.ts",
      "default": "./src/entrypoints/gradebook.ts"
    },
    "./content": {
      "types": "./src/entrypoints/content.ts",
      "import": "./src/entrypoints/content.ts",
      "default": "./src/entrypoints/content.ts"
    },
    "./api": {
      "types": "./src/entrypoints/api.ts",
      "import": "./src/entrypoints/api.ts",
      "default": "./src/entrypoints/api.ts"
    },
    "./*": {
      "types": "./src/*.ts",
      "import": "./src/*.js",
      "default": "./src/*.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "check-types": "node ../../scripts/run-and-report.mjs --cmd \"pnpm exec tsc --build --noEmit\" --name \"packages_classroom-check-types\"",
    "lint": "node ../../scripts/run-and-report.mjs --cmd \"pnpm run lint:biome && pnpm run lint:eslint\" --name \"packages_classroom-lint\"",
    "clean": "node ../../scripts/run-and-report.mjs --cmd \"rm -rf .turbo node_modules dist\" --name \"packages_classroom-clean\"",
    "lint:biome": "node ../../scripts/run-and-report.mjs --cmd \"node ../../scripts/scoped-biome.mjs\" --name \"packages_classroom-lint_biome\"",
    "lint:eslint": "node ../../scripts/run-and-report.mjs --cmd \"eslint .\" --name \"packages_classroom-lint_eslint\"",
    "format": "node ../../scripts/run-and-report.mjs --cmd \"node ../../scripts/scoped-biome.mjs --write\" --name \"packages_classroom-format\"",
    "check-cycles": "node ../../scripts/run-and-report.mjs --cmd \"node ../../scripts/refactor/sovereign-cycle-checker.mjs\" --name \"packages_classroom-check-cycles\"",
    "test": "node ../../scripts/run-and-report.mjs --cmd \"vitest run\" --name \"packages_classroom-test\"",
    "test:watch": "node ../../scripts/run-and-report.mjs --cmd \"vitest\" --name \"packages_classroom-test_watch\"",
    "test:ui": "node ../../scripts/run-and-report.mjs --cmd \"vitest --ui\" --name \"packages_classroom-test_ui\""
  },
  "dependencies": {
    "@repo/admin": "workspace:*",
    "@repo/ai": "workspace:*",
    "@repo/analytics": "workspace:*",
    "@repo/community": "workspace:*",
    "@repo/core": "workspace:*",
    "@repo/graphics": "workspace:*",
    "@repo/library": "workspace:*",
    "@repo/people": "workspace:*",
    "@repo/profile": "workspace:*",
    "@repo/scanner-kit": "workspace:*",
    "@repo/self": "workspace:*",
    "@repo/ui": "workspace:*",
    "@tanstack/react-query": "^5.101.0",
    "@shopify/react-native-skia": "2.6.5",
    "date-fns": "^4.4.0",
    "expo-observe": "~57.0.17",
    "expo-clipboard": "~57.0.1",
    "expo-image-picker": "~57.0.9",
    "expo-router": "~57.0.12",
    "react-i18next": "^17.0.8",
    "react-native-reanimated": "4.5.0"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:^",
    "@repo/typescript-config": "workspace:*",
    "@types/react": "^19.2.17",
    "@types/react-native": "workspace:*",
    "eslint": "^10.4.1",
    "tailwindcss": "^4.3.0",
    "typescript": "rc",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.8"
  },
  "peerDependencies": {
    "react": "*",
    "react-i18next": "*",
    "react-native": "*"
  },
  "_originalScripts": {
    "check-types": "pnpm exec tsc --build --noEmit",
    "lint": "pnpm run lint:biome && pnpm run lint:eslint",
    "clean": "rm -rf .turbo node_modules dist",
    "lint:biome": "node ../../scripts/scoped-biome.mjs",
    "lint:eslint": "eslint .",
    "format": "node ../../scripts/scoped-biome.mjs --write",
    "check-cycles": "node ../../scripts/refactor/sovereign-cycle-checker.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui"
  }
}
