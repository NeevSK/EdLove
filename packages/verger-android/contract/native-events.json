{
  "about": "What the native module sends to JavaScript, held as one contract both sides test against: Kotlin builds each payload from its inputs and must produce exactly `payload`; TypeScript maps each `payload` and must produce exactly `event` (with `at` = 0).",
  "network": [
    {
      "case": "Wi-Fi, validated, unmetered",
      "inputs": { "present": true, "wifi": true, "cellular": false, "ethernet": false, "validated": true, "metered": false, "kbps": 30000, "dataSaverStatus": "disabled" },
      "payload": { "transport": "wifi", "validated": true, "metered": false, "downKbps": 16384, "dataSaver": "disabled" },
      "event": { "type": "network", "at": 0, "transport": "wifi", "validated": true, "metered": false, "downKbps": 16384, "dataSaver": "disabled" }
    },
    {
      "case": "cellular, metered, Data Saver on",
      "inputs": { "present": true, "wifi": false, "cellular": true, "ethernet": false, "validated": true, "metered": true, "kbps": 1500, "dataSaverStatus": "enabled" },
      "payload": { "transport": "cellular", "validated": true, "metered": true, "downKbps": 1024, "dataSaver": "enabled" },
      "event": { "type": "network", "at": 0, "transport": "cellular", "validated": true, "metered": true, "downKbps": 1024, "dataSaver": "enabled" }
    },
    {
      "case": "cellular, this app allowlisted under Data Saver",
      "inputs": { "present": true, "wifi": false, "cellular": true, "ethernet": false, "validated": true, "metered": true, "kbps": 5000, "dataSaverStatus": "allowlisted" },
      "payload": { "transport": "cellular", "validated": true, "metered": true, "downKbps": 4096, "dataSaver": "allowlisted" },
      "event": { "type": "network", "at": 0, "transport": "cellular", "validated": true, "metered": true, "downKbps": 4096, "dataSaver": "allowlisted" }
    },
    {
      "case": "Wi-Fi behind a captive portal: not validated, bandwidth unknown",
      "inputs": { "present": true, "wifi": true, "cellular": false, "ethernet": false, "validated": false, "metered": false, "kbps": 0, "dataSaverStatus": "disabled" },
      "payload": { "transport": "wifi", "validated": false, "metered": false, "downKbps": null, "dataSaver": "disabled" },
      "event": { "type": "network", "at": 0, "transport": "wifi", "validated": false, "metered": false, "downKbps": null, "dataSaver": "disabled" }
    },
    {
      "case": "no network",
      "inputs": { "present": false, "wifi": false, "cellular": false, "ethernet": false, "validated": null, "metered": null, "kbps": 0, "dataSaverStatus": "disabled" },
      "payload": { "transport": "none", "validated": null, "metered": null, "downKbps": null, "dataSaver": "disabled" },
      "event": { "type": "network", "at": 0, "transport": "none", "validated": null, "metered": null, "downKbps": null, "dataSaver": "disabled" }
    }
  ]
}
