  },
  "dependencies": {
    "@repo/verger-core": "workspace:*"
  },
  "peerDependencies": {
    "expo": "~58.0.17"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "typescript": "7.1.0-beta",
    "vitest": "5.0.5"
  }
}
