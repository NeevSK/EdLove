{
  "name": "@repo/types-shim",
  "version": "0.0.1",
  "description": "A dummy shim to satisfy legacy @types/react-native peer dependencies",
  "private": true,
  "types": "index.d.ts",
  "scripts": {
    "lint": "pnpm run lint:biome && pnpm run lint:eslint",
    "lint:biome": "biome check .",
    "lint:eslint": "eslint .",
    "format": "biome format --write .",
    "check-cycles": "node ../../scripts/refactor/sovereign-cycle-checker.mjs",
    "check-types": "pnpm exec tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "clean": "rm -rf .turbo node_modules dist"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:^",
    "@repo/typescript-config": "workspace:*",
    "vitest": "^2.1.9",
    "vite-tsconfig-paths": "^6.1.1",
    "typescript": "^5.9.3",
    "eslint": "^9.38.0"
  }
}
