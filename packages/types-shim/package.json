{
  "name": "@repo/types-shim",
  "version": "0.0.2",
  "description": "A dummy shim to satisfy legacy @types/react-native peer dependencies",
  "private": true,
  "types": "index.d.ts",
  "scripts": {
    "lint": "node ../../scripts/run-and-report.mjs --cmd \"pnpm run lint:biome && pnpm run lint:eslint\" --name \"packages_types-shim-lint\"",
    "lint:biome": "node ../../scripts/run-and-report.mjs --cmd \"node ../../scripts/scoped-biome.mjs\" --name \"packages_types-shim-lint_biome\"",
    "lint:eslint": "node ../../scripts/run-and-report.mjs --cmd \"eslint .\" --name \"packages_types-shim-lint_eslint\"",
    "format": "node ../../scripts/run-and-report.mjs --cmd \"node ../../scripts/scoped-biome.mjs --write\" --name \"packages_types-shim-format\"",
    "check-cycles": "node ../../scripts/run-and-report.mjs --cmd \"node ../../scripts/refactor/sovereign-cycle-checker.mjs\" --name \"packages_types-shim-check-cycles\"",
    "check-types": "node ../../scripts/run-and-report.mjs --cmd \"pnpm exec tsc --build --noEmit\" --name \"packages_types-shim-check-types\"",
    "test": "node ../../scripts/run-and-report.mjs --cmd \"vitest run\" --name \"packages_types-shim-test\" --evidence-level G1",
    "test:watch": "node ../../scripts/run-and-report.mjs --cmd \"vitest\" --name \"packages_types-shim-test_watch\" --evidence-level G1",
    "test:ui": "node ../../scripts/run-and-report.mjs --cmd \"vitest --ui\" --name \"packages_types-shim-test_ui\" --evidence-level G1",
    "clean": "node ../../scripts/run-and-report.mjs --cmd \"rm -rf .turbo node_modules dist\" --name \"packages_types-shim-clean\""
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:^",
    "@repo/typescript-config": "workspace:*",
    "eslint": "^10.12.0",
    "typescript": "7.0.2",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "5.0.5"
  },
  "_originalScripts": {
    "lint": "pnpm run lint:biome && pnpm run lint:eslint",
    "lint:biome": "node ../../scripts/scoped-biome.mjs",
    "lint:eslint": "eslint .",
    "format": "node ../../scripts/scoped-biome.mjs --write",
    "check-cycles": "node ../../scripts/refactor/sovereign-cycle-checker.mjs",
    "check-types": "pnpm exec tsc --build --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "clean": "rm -rf .turbo node_modules dist"
  }
}
