{
  "compilerOptions": {
    "types": [
      "node"
    ],
    "noEmit": true,
    "skipLibCheck": true,
    "paths": {
      "@repo/core": [
        "../core/dist/index.d.ts"
      ],
      "@repo/core/*": [
        "../core/dist/*"
      ],
      "@repo/ui": [
        "../ui/dist/index.d.ts"
      ],
      "@repo/ui/*": [
        "../ui/dist/*"
      ]
    }
  },
  "include": [
    "index.d.ts"
  ]
}
