{
  "name": "@repo/ai",
  "version": "1.5.0",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./assistant": {
      "types": "./src/assistant.ts",
      "import": "./src/assistant.ts",
      "default": "./src/assistant.ts"
    },
    "./analytics": {
      "types": "./src/analytics.ts",
      "import": "./src/analytics.ts",
      "default": "./src/analytics.ts"
    },
    "./api": {
      "types": "./src/api.ts",
      "import": "./src/api.ts",
      "default": "./src/api.ts"
    },
    "./screens/AIAssistantScreen": {
      "import": "./src/screens/AIAssistantScreen.tsx",
      "browser": "./src/screens/AIAssistantScreen.web.tsx",
      "react-native": "./src/screens/AIAssistantScreen.tsx",
      "default": "./src/screens/AIAssistantScreen.tsx"
    },
    "./screens/AIAssistantScreen.web": {
      "types": "./src/screens/AIAssistantScreen.web.tsx",
      "import": "./src/screens/AIAssistantScreen.web.tsx",
      "default": "./src/screens/AIAssistantScreen.web.tsx"
    },
    "./*": {
      "types": "./src/*.ts",
      "import": "./src/*.js",
      "default": "./src/*.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "lint": "node ../../scripts/run-and-report.mjs --cmd \"pnpm run lint:biome && pnpm run lint:eslint\" --name \"packages_ai-lint\"",
    "typecheck": "node ../../scripts/run-and-report.mjs --cmd \"pnpm exec tsc --build --noEmit\" --name \"packages_ai-typecheck\"",
    "check-types": "node ../../scripts/run-and-report.mjs --cmd \"pnpm exec tsc --build --noEmit\" --name \"packages_ai-check-types\"",
    "clean": "node ../../scripts/run-and-report.mjs --cmd \"rm -rf .turbo node_modules dist\" --name \"packages_ai-clean\"",
    "lint:biome": "node ../../scripts/run-and-report.mjs --cmd \"node ../../scripts/scoped-biome.mjs\" --name \"packages_ai-lint_biome\"",
    "lint:eslint": "node ../../scripts/run-and-report.mjs --cmd \"eslint .\" --name \"packages_ai-lint_eslint\"",
    "format": "node ../../scripts/run-and-report.mjs --cmd \"node ../../scripts/scoped-biome.mjs --write\" --name \"packages_ai-format\"",
    "check-cycles": "node ../../scripts/run-and-report.mjs --cmd \"node ../../scripts/refactor/sovereign-cycle-checker.mjs\" --name \"packages_ai-check-cycles\"",
    "test": "node ../../scripts/run-and-report.mjs --cmd \"vitest run\" --name \"packages_ai-test\"",
    "test:watch": "node ../../scripts/run-and-report.mjs --cmd \"vitest\" --name \"packages_ai-test_watch\"",
    "test:ui": "node ../../scripts/run-and-report.mjs --cmd \"vitest --ui\" --name \"packages_ai-test_ui\""
  },
  "dependencies": {
    "@repo/core": "workspace:*",
    "@repo/ui": "workspace:*",
    "@tanstack/ai": "^0.43.1",
    "@tanstack/ai-client": "^0.23.3",
    "@tanstack/ai-react": "^0.19.3",
    "@tanstack/react-query": "^5.102.8",
    "expo-router": "~57.0.17",
    "react-i18next": "^17.0.12",
    "react-native-reanimated": "4.3.1"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:^",
    "@repo/typescript-config": "workspace:*",
    "@types/react": "^19.2.18",
    "eslint": "^10.9.1",
    "typescript": "rc",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.0"
  },
  "peerDependencies": {
    "@repo/ui": "*",
    "react": "*",
    "react-i18next": "*",
    "react-native": "*",
    "react-native-reanimated": "*"
  },
  "_originalScripts": {
    "lint": "pnpm run lint:biome && pnpm run lint:eslint",
    "typecheck": "pnpm exec tsc --build --noEmit",
    "check-types": "pnpm exec tsc --build --noEmit",
    "clean": "rm -rf .turbo node_modules dist",
    "lint:biome": "node ../../scripts/scoped-biome.mjs",
    "lint:eslint": "eslint .",
    "format": "node ../../scripts/scoped-biome.mjs --write",
    "check-cycles": "node ../../scripts/refactor/sovereign-cycle-checker.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui"
  }
}
