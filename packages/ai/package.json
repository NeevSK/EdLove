{
  "name": "@repo/ai",
  "version": "1.0.0",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./screens/AIAssistantScreen": {
      "import": "./src/screens/AIAssistantScreen.tsx",
      "browser": "./src/screens/AIAssistantScreen.web.tsx",
      "react-native": "./src/screens/AIAssistantScreen.tsx",
      "default": "./src/screens/AIAssistantScreen.tsx"
    },
    "./screens/AIAssistantScreen.web": {
      "types": "./src/screens/AIAssistantScreen.web.tsx",
      "import": "./src/screens/AIAssistantScreen.web.tsx",
      "default": "./src/screens/AIAssistantScreen.web.tsx"
    },
    "./*": {
      "types": "./src/*.ts",
      "import": "./src/*.js",
      "default": "./src/*.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "lint": "pnpm run lint:biome && pnpm run lint:eslint",
    "typecheck": "pnpm exec tsc --noEmit",
    "check-types": "pnpm exec tsc --noEmit",
    "clean": "rm -rf .turbo node_modules dist",
    "lint:biome": "biome check .",
    "lint:eslint": "eslint .",
    "format": "biome format --write .",
    "check-cycles": "node ../../scripts/refactor/sovereign-cycle-checker.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui"
  },
  "dependencies": {
    "@repo/core": "workspace:*",
    "@repo/ui": "workspace:*",
    "@tanstack/react-query": "^5.90.20",
    "react-i18next": "^16.5.4",
    "react-native-reanimated": "4.3.1",
    "lucide-react-native": "^0.563.0"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@repo/eslint-config": "workspace:^",
    "@types/react": "^19.2.14",
    "typescript": "^6.0.3",
    "eslint": "^9.38.0",
    "vitest": "^2.1.9",
    "vite-tsconfig-paths": "^6.1.1"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*",
    "react-i18next": "*",
    "react-native-reanimated": "*",
    "@repo/ui": "*",
    "lucide-react-native": "*"
  }
}
