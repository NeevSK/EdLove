{
  "name": "@repo/ai",
  "version": "0.0.1",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./api": "./src/api/index.ts",
    "./hooks": "./src/hooks/index.ts",
    "./screens": "./src/screens/index.ts",
    "./screens/AIAssistantScreen.web": "./src/screens/AIAssistantScreen.web.tsx",
    "./package.json": "./package.json"
  },
  "scripts": {
    "lint": "powershell -File ../../scripts/audit-wrapper.ps1 -Cmd \"pnpm exec eslint .\" -Log \"reports/lint.txt\"",
    "typecheck": "powershell -File ../../scripts/audit-wrapper.ps1 -Cmd \"pnpm exec tsc --noEmit\" -Log \"reports/check-types.txt\"",
    "check-types": "pnpm run typecheck",
    "clean": "rm -rf .turbo node_modules dist"
  },
  "dependencies": {
    "@repo/core": "workspace:*",
    "@repo/ui": "workspace:*",
    "@tanstack/react-query": "^5.90.20",
    "react-i18next": "^16.5.4",
    "react-native-reanimated": "^4.2.1",
    "lucide-react-native": "^0.563.0"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@repo/eslint-config": "workspace:^",
    "@types/react": "^19.2.14",
    "typescript": "^5.9.3",
    "eslint": "^9.38.0"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*",
    "react-i18next": "*",
    "react-native-reanimated": "*",
    "@repo/ui": "*",
    "lucide-react-native": "*"
  }
}
