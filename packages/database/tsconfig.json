{
  "compilerOptions": {
    "target": "ESNext",
    "module": "CommonJS",
    "lib": ["ESNext"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "protocol/*": ["./protocol/*"]
    }
  },
  "include": ["src/**/*", "protocol/**/*"]
}
