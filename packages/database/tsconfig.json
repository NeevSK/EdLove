{
  "extends": "../../packages/typescript-config/base.json",
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ESNext"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "paths": {
      "zenstack/*": ["./zenstack/*"]
    },
    "rootDir": "./src"
  },
  "include": ["src/**/*", "zenstack/**/*"]
}
