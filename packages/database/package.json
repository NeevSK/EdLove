{
  "name": "@repo/database",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./*": {
      "types": "./src/*.ts",
      "import": "./src/*.js",
      "default": "./src/*.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "lint": "pnpm run lint:biome && pnpm run lint:eslint",
    "check-types": "pnpm exec tsc --noEmit",
    "generate": "pnpm exec zen generate --schema zenstack/schema.zmodel --output ../core/src/logic/generated",
    "db:push": "pnpm exec zen db push --schema zenstack/schema.zmodel",
    "db:studio": "pnpm exec zen studio --schema zenstack/schema.zmodel",
    "db:migrate": "pnpm exec zen migrate dev --schema zenstack/schema.zmodel",
    "lint:biome": "biome check .",
    "lint:eslint": "eslint .",
    "format": "node ../../scripts/scoped-biome.mjs --write",
    "check-cycles": "node ../../scripts/refactor/sovereign-cycle-checker.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "clean": "rm -rf .turbo node_modules dist"
  },
  "dependencies": {
    "@repo/schema": "workspace:*",
    "@zenstackhq/orm": "3.6.4",
    "@zenstackhq/schema": "3.6.4",
    "kysely": "0.28.16",
    "pg": "^8.21.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:^",
    "@repo/typescript-config": "workspace:*",
    "@types/pg": "^8.20.0",
    "@zenstackhq/cli": "3.6.4",
    "@zenstackhq/language": "3.6.4",
    "@zenstackhq/plugin-policy": "3.6.4",
    "@zenstackhq/sdk": "3.6.4",
    "@zenstackhq/zod": "3.6.4",
    "eslint": "^10.4.1",
    "typescript": "^6.0.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.8"
  }
}
