{
  "name": "@repo/database",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./*": {
      "types": "./src/*.ts",
      "import": "./src/*.js",
      "default": "./src/*.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "lint": "node ../../scripts/run-and-report.mjs --cmd \"pnpm run lint:biome && pnpm run lint:eslint\" --name \"packages_database-lint\"",
    "check-types": "node ../../scripts/run-and-report.mjs --cmd \"pnpm exec tsc --build --noEmit\" --name \"packages_database-check-types\"",
    "lint:biome": "node ../../scripts/run-and-report.mjs --cmd \"node ../../scripts/scoped-biome.mjs\" --name \"packages_database-lint_biome\"",
    "lint:eslint": "node ../../scripts/run-and-report.mjs --cmd \"eslint .\" --name \"packages_database-lint_eslint\"",
    "format": "node ../../scripts/run-and-report.mjs --cmd \"node ../../scripts/scoped-biome.mjs --write\" --name \"packages_database-format\"",
    "check-cycles": "node ../../scripts/run-and-report.mjs --cmd \"node ../../scripts/refactor/sovereign-cycle-checker.mjs\" --name \"packages_database-check-cycles\"",
    "test": "node ../../scripts/run-and-report.mjs --cmd \"vitest run\" --name \"packages_database-test\" --evidence-level G1",
    "test:watch": "node ../../scripts/run-and-report.mjs --cmd \"vitest\" --name \"packages_database-test_watch\" --evidence-level G1",
    "test:ui": "node ../../scripts/run-and-report.mjs --cmd \"vitest --ui\" --name \"packages_database-test_ui\" --evidence-level G1",
    "clean": "node ../../scripts/run-and-report.mjs --cmd \"rm -rf .turbo node_modules dist\" --name \"packages_database-clean\""
  },
  "dependencies": {
    "@repo/schema": "workspace:*",
    "@zenstackhq/orm": "3.9.7",
    "@zenstackhq/schema": "3.9.7",
    "kysely": "0.28.16",
    "pg": "^8.23.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:^",
    "@repo/typescript-config": "workspace:*",
    "@types/pg": "^8.23.1",
    "@zenstackhq/cli": "3.9.7",
    "@zenstackhq/language": "3.9.7",
    "@zenstackhq/plugin-policy": "3.9.7",
    "@zenstackhq/sdk": "3.9.7",
    "@zenstackhq/zod": "3.9.7",
    "eslint": "^10.12.0",
    "typescript": "7.0.2",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "5.0.5"
  },
  "_originalScripts": {
    "lint": "pnpm run lint:biome && pnpm run lint:eslint",
    "check-types": "pnpm exec tsc --build --noEmit",
    "lint:biome": "node ../../scripts/scoped-biome.mjs",
    "lint:eslint": "eslint .",
    "format": "node ../../scripts/scoped-biome.mjs --write",
    "check-cycles": "node ../../scripts/refactor/sovereign-cycle-checker.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "clean": "rm -rf .turbo node_modules dist"
  }
}
