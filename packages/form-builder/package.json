{
  "name": "@repo/form-builder",
  "version": "1.0.1",
  "private": true,
  "main": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./*": {
      "types": "./src/*.ts",
      "import": "./src/*.js",
      "default": "./src/*.js"
    },
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "scripts": {
    "lint": "pnpm run lint:biome && pnpm run lint:eslint",
    "check-types": "pnpm exec tsc --noEmit",
    "lint:biome": "biome check .",
    "lint:eslint": "eslint .",
    "format": "node ../../scripts/scoped-biome.mjs --write",
    "check-cycles": "node ../../scripts/refactor/sovereign-cycle-checker.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "clean": "rm -rf .turbo node_modules dist"
  },
  "dependencies": {
    "@intuitui-labs/form-builder-engine": "workspace:*",
    "@repo/ui": "workspace:*",
    "@tanstack/react-form": "^0.20.0",
    "expo-router": "~56.2.10",
    "lucide-react": "^1.17.0",
    "lucide-react-native": "^1.17.0",
    "react-i18next": "^17.0.8"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:^",
    "@repo/typescript-config": "workspace:*",
    "@types/react": "^19.2.17",
    "@types/react-dom": "19.2.1",
    "eslint": "^10.4.1",
    "typescript": "^6.0.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.8"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*",
    "react-i18next": "*"
  }
}
