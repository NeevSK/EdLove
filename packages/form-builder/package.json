{
  "name": "@repo/form-builder",
  "version": "1.0.1",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./engine": "./src/engine/index.ts",
    "./components": "./src/components/index.ts",
    "./apps": "./src/apps/index.ts",
    "./screens": "./src/screens/index.ts",
    "./climate-sensing-web": "./src/screens/ClimateSensingScreen.web.tsx",
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "scripts": {
    "lint": "pnpm run lint:biome && pnpm run lint:eslint",
    "check-types": "pnpm exec tsc --noEmit",
    "lint:biome": "biome check .",
    "lint:eslint": "eslint .",
    "format": "biome format --write .",
    "check-cycles": "node ../../scripts/refactor/sovereign-cycle-checker.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "clean": "rm -rf .turbo node_modules dist"
  },
  "dependencies": {
    "@repo/ui": "workspace:*",
    "@repo/core": "workspace:*",
    "@repo/scanner-kit": "workspace:*",
    "react-i18next": "^16.5.4",
    "lucide-react": "^0.474.0",
    "lucide-react-native": "^0.563.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "19.2.1",
    "@repo/eslint-config": "workspace:^",
    "@repo/typescript-config": "workspace:*",
    "vitest": "^2.1.9",
    "vite-tsconfig-paths": "^6.1.1",
    "typescript": "^5.9.3",
    "eslint": "^9.38.0"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*",
    "react-i18next": "*"
  }
}
