{
  "extends": "../../packages/typescript-config/base.json",
  "compilerOptions": {
    "outDir": "dist",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "composite": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@repo/form-builder/*": [
        "./src/*",
        "./src/*/index.ts",
        "./src/*/index.tsx"
      ],
      "@repo/form-builder": [
        "./src/index.ts"
      ],
      "@repo/core": [
        "../core/dist/index.d.ts"
      ],
      "@repo/core/*": [
        "../core/dist/*"
      ],
      "@repo/ui": [
        "../ui/dist/index.d.ts"
      ],
      "@repo/ui/*": [
        "../ui/dist/*"
      ]
    },
    "rootDir": "./src"
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
