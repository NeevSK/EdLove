{
  "name": "@repo/admin",
  "version": "0.0.2",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./screens/FounderDashboard": {
      "types": "./src/screens/FounderDashboard.tsx",
      "import": "./src/screens/FounderDashboard.tsx",
      "default": "./src/screens/FounderDashboard.tsx"
    },
    "./screens/FounderDashboard.web": {
      "types": "./src/screens/FounderDashboard.web.tsx",
      "import": "./src/screens/FounderDashboard.web.tsx",
      "default": "./src/screens/FounderDashboard.web.tsx"
    },
    "./screens/FounderSchoolDashboard": {
      "types": "./src/screens/FounderSchoolDashboard.tsx",
      "import": "./src/screens/FounderSchoolDashboard.tsx",
      "default": "./src/screens/FounderSchoolDashboard.tsx"
    },
    "./screens/GuardianCommunicationBridgeScreen": {
      "types": "./src/screens/guardian/GuardianCommunicationBridgeScreen.tsx",
      "import": "./src/screens/guardian/GuardianCommunicationBridgeScreen.tsx",
      "default": "./src/screens/guardian/GuardianCommunicationBridgeScreen.tsx"
    },
    "./screens/GuardianDashboard": {
      "types": "./src/screens/GuardianDashboard.tsx",
      "import": "./src/screens/GuardianDashboard.tsx",
      "default": "./src/screens/GuardianDashboard.tsx"
    },
    "./screens/GuardianEventsScreen": {
      "types": "./src/screens/guardian/GuardianEventsScreen.tsx",
      "import": "./src/screens/guardian/GuardianEventsScreen.tsx",
      "default": "./src/screens/guardian/GuardianEventsScreen.tsx"
    },
    "./screens/GuardianNotificationsScreen": {
      "types": "./src/screens/guardian/GuardianNotificationsScreen.tsx",
      "import": "./src/screens/guardian/GuardianNotificationsScreen.tsx",
      "default": "./src/screens/guardian/GuardianNotificationsScreen.tsx"
    },
    "./screens/GuardianStudentDetailScreen": {
      "types": "./src/screens/guardian/GuardianStudentDetailScreen.tsx",
      "import": "./src/screens/guardian/GuardianStudentDetailScreen.tsx",
      "default": "./src/screens/guardian/GuardianStudentDetailScreen.tsx"
    },
    "./screens/GuardianStudentsScreen": {
      "types": "./src/screens/guardian/GuardianStudentsScreen.tsx",
      "import": "./src/screens/guardian/GuardianStudentsScreen.tsx",
      "default": "./src/screens/guardian/GuardianStudentsScreen.tsx"
    },
    "./screens/PrincipalDashboard": {
      "types": "./src/screens/PrincipalDashboard.tsx",
      "import": "./src/screens/PrincipalDashboard.tsx",
      "default": "./src/screens/PrincipalDashboard.tsx"
    },
    "./screens/PrincipalDashboard.web": {
      "types": "./src/screens/PrincipalDashboard.web.tsx",
      "import": "./src/screens/PrincipalDashboard.web.tsx",
      "default": "./src/screens/PrincipalDashboard.web.tsx"
    },
    "./screens/SchoolCreationScreen": {
      "types": "./src/screens/SchoolCreationScreen.tsx",
      "import": "./src/screens/SchoolCreationScreen.tsx",
      "default": "./src/screens/SchoolCreationScreen.tsx"
    },
    "./screens/AdminDashboard.web": {
      "types": "./src/screens/AdminDashboard.tsx",
      "import": "./src/screens/AdminDashboard.tsx",
      "default": "./src/screens/AdminDashboard.tsx"
    },
    "./*": {
      "types": "./src/*.ts",
      "import": "./src/*.js",
      "default": "./src/*.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "lint": "node ../../scripts/run-and-report.mjs --cmd \"pnpm run lint:biome && pnpm run lint:eslint\" --name \"packages_admin-lint\"",
    "check-types": "node ../../scripts/run-and-report.mjs --cmd \"pnpm exec tsc --build --noEmit\" --name \"packages_admin-check-types\"",
    "lint:biome": "node ../../scripts/run-and-report.mjs --cmd \"node ../../scripts/scoped-biome.mjs\" --name \"packages_admin-lint_biome\"",
    "lint:eslint": "node ../../scripts/run-and-report.mjs --cmd \"eslint .\" --name \"packages_admin-lint_eslint\"",
    "format": "node ../../scripts/run-and-report.mjs --cmd \"node ../../scripts/scoped-biome.mjs --write\" --name \"packages_admin-format\"",
    "check-cycles": "node ../../scripts/run-and-report.mjs --cmd \"node ../../scripts/refactor/sovereign-cycle-checker.mjs\" --name \"packages_admin-check-cycles\"",
    "test": "node ../../scripts/run-and-report.mjs --cmd \"vitest run\" --name \"packages_admin-test\"",
    "test:watch": "node ../../scripts/run-and-report.mjs --cmd \"vitest\" --name \"packages_admin-test_watch\"",
    "test:ui": "node ../../scripts/run-and-report.mjs --cmd \"vitest --ui\" --name \"packages_admin-test_ui\"",
    "clean": "node ../../scripts/run-and-report.mjs --cmd \"rm -rf .turbo node_modules dist\" --name \"packages_admin-clean\""
  },
  "dependencies": {
    "@repo/ai": "workspace:*",
    "@repo/analytics": "workspace:*",
    "@repo/community": "workspace:*",
    "@repo/core": "workspace:*",
    "@repo/graphics": "workspace:*",
    "@repo/library": "workspace:*",
    "@repo/people": "workspace:*",
    "@repo/profile": "workspace:*",
    "@repo/scanner-kit": "workspace:*",
    "@repo/self": "workspace:*",
    "@repo/ui": "workspace:*",
    "@tanstack/react-query": "^5.101.0",
    "date-fns": "^4.4.0",
    "expo-clipboard": "~57.0.1",
    "expo-router": "~57.0.9",
    "lucide-react-native": "^1.17.0",
    "react-i18next": "^17.0.8",
    "react-native-reanimated": "4.3.1"
  },
  "devDependencies": {
    "@jest/globals": "^30.4.1",
    "@repo/eslint-config": "workspace:^",
    "@repo/typescript-config": "workspace:*",
    "@types/react": "^19.2.17",
    "@types/react-native": "workspace:*",
    "eslint": "^10.4.1",
    "typescript": "rc",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.8"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "_originalScripts": {
    "lint": "pnpm run lint:biome && pnpm run lint:eslint",
    "check-types": "pnpm exec tsc --build --noEmit",
    "lint:biome": "node ../../scripts/scoped-biome.mjs",
    "lint:eslint": "eslint .",
    "format": "node ../../scripts/scoped-biome.mjs --write",
    "check-cycles": "node ../../scripts/refactor/sovereign-cycle-checker.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "clean": "rm -rf .turbo node_modules dist"
  }
}
