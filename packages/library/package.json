    "eslint": "^10.4.1",
    "react-i18next": "^17.0.8",
    "tailwindcss": "4.3.0",
    "typescript": "rc",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.0"
  },
  "peerDependencies": {
    "@repo/ui": "*",
    "@supabase/postgrest-js": "2.102.1",
    "@supabase/supabase-js": "2.102.1",
    "expo-audio": "~57.0.3",
    "expo-blur": ">=57.0.0",
    "expo-file-system": "~57.0.2",
    "expo-linear-gradient": ">=57.0.0",
