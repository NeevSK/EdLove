{
  "name": "@repo/library",
  "version": "1.5.0",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./api": {
      "types": "./src/api/index.ts",
      "import": "./src/api/index.ts",
      "default": "./src/api/index.ts"
    },
    "./browse": {
      "types": "./src/entrypoints/browse.ts",
      "import": "./src/entrypoints/browse.ts",
      "default": "./src/entrypoints/browse.ts"
    },
    "./readers": {
      "types": "./src/entrypoints/readers.ts",
      "import": "./src/entrypoints/readers.ts",
      "default": "./src/entrypoints/readers.ts"
    },
    "./collections": {
      "types": "./src/entrypoints/collections.ts",
      "import": "./src/entrypoints/collections.ts",
      "default": "./src/entrypoints/collections.ts"
    },
    "./curation": {
      "types": "./src/entrypoints/curation.ts",
      "import": "./src/entrypoints/curation.ts",
      "default": "./src/entrypoints/curation.ts"
    },
    "./map": {
      "types": "./src/entrypoints/map.ts",
      "import": "./src/entrypoints/map.ts",
      "default": "./src/entrypoints/map.ts"
    },
    "./content/body": {
      "types": "./src/content/body/index.ts",
      "import": "./src/content/body/index.ts",
      "default": "./src/content/body/index.ts"
    },
    "./content": {
      "types": "./src/content/index.ts",
      "import": "./src/content/index.ts",
      "default": "./src/content/index.ts"
    },
    "./h5p": {
      "types": "./src/h5p/index.ts",
      "import": "./src/h5p/index.ts",
      "default": "./src/h5p/index.ts"
    },
    "./tools": {
      "types": "./src/entrypoints/tools.ts",
      "import": "./src/entrypoints/tools.ts",
      "default": "./src/entrypoints/tools.ts"
    },
    "./screens/PDFViewerScreen": {
      "import": "./src/screens/PDFViewerScreen.tsx",
      "browser": "./src/screens/PDFViewerScreen.web.tsx",
      "react-native": "./src/screens/PDFViewerScreen.tsx",
      "default": "./src/screens/PDFViewerScreen.tsx"
    },
    "./screens/PDFViewerScreen.web": {
      "types": "./src/screens/PDFViewerScreen.web.tsx",
      "import": "./src/screens/PDFViewerScreen.web.tsx",
      "default": "./src/screens/PDFViewerScreen.web.tsx"
    },
    "./screens/VideoPlayerScreen": {
      "import": "./src/screens/VideoPlayerScreen.tsx",
      "browser": "./src/screens/VideoPlayerScreen.web.tsx",
      "react-native": "./src/screens/VideoPlayerScreen.tsx",
      "default": "./src/screens/VideoPlayerScreen.tsx"
    },
    "./screens/VideoPlayerScreen.web": {
      "types": "./src/screens/VideoPlayerScreen.web.tsx",
      "import": "./src/screens/VideoPlayerScreen.web.tsx",
      "default": "./src/screens/VideoPlayerScreen.web.tsx"
    },
    "./screens/DocumentViewerScreen": {
      "types": "./src/screens/DocumentViewerScreen.tsx",
      "import": "./src/screens/DocumentViewerScreen.tsx",
      "default": "./src/screens/DocumentViewerScreen.tsx"
    },
    "./*": {
      "types": "./src/*.ts",
      "import": "./src/*.js",
      "default": "./src/*.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "lint": "node ../../scripts/run-and-report.mjs --cmd \"pnpm run lint:biome && pnpm run lint:eslint\" --name \"packages_library-lint\"",
    "check-types": "node ../../scripts/run-and-report.mjs --cmd \"pnpm exec tsc --build --noEmit\" --name \"packages_library-check-types\"",
    "clean": "node ../../scripts/run-and-report.mjs --cmd \"rm -rf .turbo node_modules dist\" --name \"packages_library-clean\"",
    "lint:biome": "node ../../scripts/run-and-report.mjs --cmd \"node ../../scripts/scoped-biome.mjs\" --name \"packages_library-lint_biome\"",
    "lint:eslint": "node ../../scripts/run-and-report.mjs --cmd \"eslint .\" --name \"packages_library-lint_eslint\"",
    "format": "node ../../scripts/run-and-report.mjs --cmd \"node ../../scripts/scoped-biome.mjs --write\" --name \"packages_library-format\"",
    "check-cycles": "node ../../scripts/run-and-report.mjs --cmd \"node ../../scripts/refactor/sovereign-cycle-checker.mjs\" --name \"packages_library-check-cycles\"",
    "test": "node ../../scripts/run-and-report.mjs --cmd \"vitest run\" --name \"packages_library-test\" --evidence-level G1",
    "test:watch": "node ../../scripts/run-and-report.mjs --cmd \"vitest\" --name \"packages_library-test_watch\" --evidence-level G1",
    "test:ui": "node ../../scripts/run-and-report.mjs --cmd \"vitest --ui\" --name \"packages_library-test_ui\" --evidence-level G1"
  },
  "dependencies": {
    "@maplibre/maplibre-react-native": "11.5.1",
    "@repo/core": "workspace:*",
    "@repo/graphics": "workspace:*",
    "@repo/ui": "workspace:*",
    "@tanstack/react-query": "^5.107.1",
    "@zip.js/zip.js": "^2.24.0",
    "d3": "^7.9.2",
    "expo-image-manipulator": "~58.0.16",
    "expo-router": "~58.0.30",
    "fflate": "^0.8.3",
    "nativewind": "5.0.0-rc.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.5.438",
    "react-i18next": "^17.1.12",
    "react-native-gifted-charts": "^1.4.81",
    "react-native-maps": "1.29.11",
    "remark-directive": "4.0.0",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "remark-stringify": "11.0.0",
    "sheetjs": "^2.0.0",
    "tesseract.js": "^7.0.0",
    "unified": "11.0.5",
    "uuid": "^14.0.3",
    "xlsx": "^0.18.5",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:^",
    "@repo/typescript-config": "workspace:*",
    "@types/d3": "^7.4.3",
    "@types/mdast": "4.0.4",
    "@types/react": "^19.3.0",
    "eslint": "^10.14.0",
    "react-i18next": "^17.1.12",
    "tailwindcss": "4.3.4",
    "typescript": "7.1.0-beta",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "5.1.0"
  },
  "peerDependencies": {
    "@repo/ui": "1.5.0",
    "expo-audio": "~58.0.11",
    "expo-blur": "~58.0.5",
    "expo-file-system": "~58.0.13",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.16",
    "expo-sharing": "~58.0.22",
    "expo-sqlite": "~58.0.15",
    "expo-video": "~58.0.13",
    "react": "19.3.1",
    "react-i18next": "^17.1.12",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "3.5.0",
    "react-native-linear-gradient": "2.8.3",
    "react-native-reanimated": "4.7.1",
    "react-native-svg": "15.16.1"
  },
  "_originalScripts": {
    "lint": "pnpm run lint:biome && pnpm run lint:eslint",
    "check-types": "pnpm exec tsc --build --noEmit",
    "clean": "rm -rf .turbo node_modules dist",
    "lint:biome": "node ../../scripts/scoped-biome.mjs",
    "lint:eslint": "eslint .",
    "format": "node ../../scripts/scoped-biome.mjs --write",
    "check-cycles": "node ../../scripts/refactor/sovereign-cycle-checker.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui"
  }
}
