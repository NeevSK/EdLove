{
  "name": "@repo/library",
  "version": "1.0.0",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./api": {
      "types": "./src/api/index.ts",
      "import": "./src/api/index.ts",
      "default": "./src/api/index.ts"
    },
    "./screens/LibraryScreen": {
      "import": "./src/screens/LibraryScreen.tsx",
      "browser": "./src/screens/LibraryScreen.web.tsx",
      "react-native": "./src/screens/LibraryScreen.tsx",
      "default": "./src/screens/LibraryScreen.tsx"
    },
    "./screens/LibraryScreen.web": {
      "types": "./src/screens/LibraryScreen.web.tsx",
      "import": "./src/screens/LibraryScreen.web.tsx",
      "default": "./src/screens/LibraryScreen.web.tsx"
    },
    "./screens/PDFViewerScreen": {
      "import": "./src/screens/PDFViewerScreen.tsx",
      "browser": "./src/screens/PDFViewerScreen.web.tsx",
      "react-native": "./src/screens/PDFViewerScreen.tsx",
      "default": "./src/screens/PDFViewerScreen.tsx"
    },
    "./screens/PDFViewerScreen.web": {
      "types": "./src/screens/PDFViewerScreen.web.tsx",
      "import": "./src/screens/PDFViewerScreen.web.tsx",
      "default": "./src/screens/PDFViewerScreen.web.tsx"
    },
    "./screens/VideoPlayerScreen": {
      "import": "./src/screens/VideoPlayerScreen.tsx",
      "browser": "./src/screens/VideoPlayerScreen.web.tsx",
      "react-native": "./src/screens/VideoPlayerScreen.tsx",
      "default": "./src/screens/VideoPlayerScreen.tsx"
    },
    "./screens/VideoPlayerScreen.web": {
      "types": "./src/screens/VideoPlayerScreen.web.tsx",
      "import": "./src/screens/VideoPlayerScreen.web.tsx",
      "default": "./src/screens/VideoPlayerScreen.web.tsx"
    },
    "./screens/MapScreen": {
      "import": "./src/screens/MapScreen.tsx",
      "browser": "./src/screens/MapScreen.web.tsx",
      "react-native": "./src/screens/MapScreen.tsx",
      "default": "./src/screens/MapScreen.tsx"
    },
    "./screens/MapScreen.web": {
      "types": "./src/screens/MapScreen.web.tsx",
      "import": "./src/screens/MapScreen.web.tsx",
      "default": "./src/screens/MapScreen.web.tsx"
    },
    "./screens/CuratorReviewScreen": {
      "types": "./src/screens/CuratorReviewScreen.tsx",
      "import": "./src/screens/CuratorReviewScreen.tsx",
      "default": "./src/screens/CuratorReviewScreen.tsx"
    },
    "./screens/CollectionDetailScreen": {
      "import": "./src/screens/CollectionDetailScreen.tsx",
      "browser": "./src/screens/CollectionDetailScreen.web.tsx",
      "react-native": "./src/screens/CollectionDetailScreen.tsx",
      "default": "./src/screens/CollectionDetailScreen.tsx"
    },
    "./screens/CollectionDetailScreen.web": {
      "types": "./src/screens/CollectionDetailScreen.web.tsx",
      "import": "./src/screens/CollectionDetailScreen.web.tsx",
      "default": "./src/screens/CollectionDetailScreen.web.tsx"
    },
    "./screens/DocumentViewerScreen": {
      "types": "./src/screens/DocumentViewerScreen.tsx",
      "import": "./src/screens/DocumentViewerScreen.tsx",
      "default": "./src/screens/DocumentViewerScreen.tsx"
    },
    "./screens/ResourceHubScreen": {
      "types": "./src/screens/ResourceHubScreen.tsx",
      "import": "./src/screens/ResourceHubScreen.tsx",
      "default": "./src/screens/ResourceHubScreen.tsx"
    },
    "./*": {
      "types": "./src/*.ts",
      "import": "./src/*.js",
      "default": "./src/*.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "lint": "node ../../scripts/run-and-report.mjs --cmd \"pnpm run lint:biome && pnpm run lint:eslint\" --name \"packages_library-lint\"",
    "check-types": "node ../../scripts/run-and-report.mjs --cmd \"pnpm exec tsc --build --noEmit --checkers 4 --builders 4\" --name \"packages_library-check-types\"",
    "clean": "node ../../scripts/run-and-report.mjs --cmd \"rm -rf .turbo node_modules dist\" --name \"packages_library-clean\"",
    "lint:biome": "node ../../scripts/run-and-report.mjs --cmd \"node ../../scripts/scoped-biome.mjs\" --name \"packages_library-lint_biome\"",
    "lint:eslint": "node ../../scripts/run-and-report.mjs --cmd \"eslint .\" --name \"packages_library-lint_eslint\"",
    "format": "node ../../scripts/run-and-report.mjs --cmd \"node ../../scripts/scoped-biome.mjs --write\" --name \"packages_library-format\"",
    "check-cycles": "node ../../scripts/run-and-report.mjs --cmd \"node ../../scripts/refactor/sovereign-cycle-checker.mjs\" --name \"packages_library-check-cycles\"",
    "test": "node ../../scripts/run-and-report.mjs --cmd \"vitest run\" --name \"packages_library-test\"",
    "test:watch": "node ../../scripts/run-and-report.mjs --cmd \"vitest\" --name \"packages_library-test_watch\"",
    "test:ui": "node ../../scripts/run-and-report.mjs --cmd \"vitest --ui\" --name \"packages_library-test_ui\""
  },
  "dependencies": {
    "@maplibre/maplibre-react-native": "10.4.2",
    "@repo/core": "workspace:*",
    "@repo/graphics": "workspace:*",
    "@repo/ui": "workspace:*",
    "@supabase/postgrest-js": "2.102.1",
    "@supabase/supabase-js": "2.102.1",
    "@tanstack/react-query": "^5.101.0",
    "d3": "^7.9.0",
    "expo-blur": "~57.0.3",
    "expo-linear-gradient": "~57.0.4",
    "expo-router": "~57.0.4",
    "lucide-react-native": "^1.17.0",
    "nativewind": "4.1.23",
    "react-i18next": "^17.0.8",
    "react-native-gesture-handler": "3.0.2",
    "react-native-gifted-charts": "^1.4.77",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-maps": "^1.27.2",
    "react-native-svg": "15.15.4"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:^",
    "@repo/typescript-config": "workspace:*",
    "@types/d3": "^7.4.3",
    "@types/react": "^19.2.17",
    "@types/react-native": "0.83.2",
    "eslint": "^10.4.1",
    "react-i18next": "^17.0.8",
    "tailwindcss": "3.4.17",
    "typescript": "rc",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.8"
  },
  "peerDependencies": {
    "@repo/ui": "*",
    "expo-audio": "*",
    "expo-file-system": "*",
    "expo-linking": "*",
    "expo-sharing": "*",
    "expo-sqlite": "*",
    "expo-video": "*",
    "lucide-react-native": "*",
    "react": "19.2.3",
    "react-i18next": "*",
    "react-native": "~0.86.0",
    "react-native-gesture-handler": "^3.0.2",
    "react-native-reanimated": "^4.5.0",
    "@supabase/supabase-js": "2.102.1",
    "@supabase/postgrest-js": "2.102.1"
  },
  "_originalScripts": {
    "lint": "pnpm run lint:biome && pnpm run lint:eslint",
    "check-types": "pnpm exec tsc --build --noEmit --checkers 4 --builders 4",
    "clean": "rm -rf .turbo node_modules dist",
    "lint:biome": "node ../../scripts/scoped-biome.mjs",
    "lint:eslint": "eslint .",
    "format": "node ../../scripts/scoped-biome.mjs --write",
    "check-cycles": "node ../../scripts/refactor/sovereign-cycle-checker.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui"
  }
}
