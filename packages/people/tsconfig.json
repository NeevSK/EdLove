{
  "extends": "../../packages/typescript-config/base.json",
  "compilerOptions": {
    "composite": true,
    "emitDeclarationOnly": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "types": [
      "@repo/types-shim"
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@repo/people/*": [
        "./src/*",
        "./src/*/index.ts",
        "./src/*/index.tsx"
      ],
      "@repo/people": [
        "./src/index.ts"
      ],
      "@repo/core": [
        "../core/dist/index.d.ts"
      ],
      "@repo/core/*": [
        "../core/dist/*"
      ],
      "@repo/ui": [
        "../ui/dist/index.d.ts"
      ],
      "@repo/ui/*": [
        "../ui/dist/*"
      ]
    }
  },
  "include": [
    "src/**/*"
  ]
}
