{
  "name": "@rn-terrain/core",
  "version": "0.0.1",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "check-types": "node ../../scripts/run-and-report.mjs --cmd \"pnpm exec tsc --build --noEmit --checkers 4 --builders 4\" --name \"packages_rn-terrain-core-check-types\"",
    "clean": "node ../../scripts/run-and-report.mjs --cmd \"rm -rf .turbo node_modules dist\" --name \"packages_rn-terrain-core-clean\""
  },
  "dependencies": {
    "@supabase/supabase-js": "2.102.1",
    "dotenv": "^17.4.2",
    "semver": "^7.8.3",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:^",
    "@repo/typescript-config": "workspace:*",
    "@types/semver": "^7.7.1",
    "typescript": "rc"
  },
  "_originalScripts": {
    "check-types": "pnpm exec tsc --build --noEmit --checkers 4 --builders 4",
    "clean": "rm -rf .turbo node_modules dist"
  }
}
