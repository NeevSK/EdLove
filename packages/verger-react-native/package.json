{
  "name": "@repo/verger-react-native",
  "version": "0.1.0",
  "private": true,
  "description": "Verger's React Native shell: VergerRoot runs and binds verger, feeds app state, touches, reduced motion and long tasks, and applies the global reduced-motion lever.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@repo/verger-core": "workspace:*",
    "@repo/verger-react": "workspace:*"
  },
  "peerDependencies": {
    "react": "19.3.1",
    "react-native": "0.88.0",
    "react-native-reanimated": "4.7.1"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/react": "^19.3.0",
    "typescript": "7.1.0-beta"
  }
}
