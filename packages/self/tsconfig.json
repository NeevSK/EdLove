{
  "extends": "../../packages/typescript-config/base.json",
  "compilerOptions": {
    "composite": true,
    "emitDeclarationOnly": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "paths": {
      "@/*": ["./src/*"],
      "@repo/self/*": ["./src/*"],
      "@repo/core": ["../core/dist/index.d.ts"],
      "@repo/core/*": ["../core/dist/*"],
      "@repo/ui": ["../ui/dist/index.d.ts"],
      "@repo/ui/*": ["../ui/dist/*"],
      "@repo/people": ["../people/dist/index.d.ts"],
      "@repo/people/*": ["../people/dist/*"],
      "@repo/profile": ["../profile/dist/index.d.ts"],
      "@repo/profile/*": ["../profile/dist/*"],
      "@repo/scanner-kit": ["../scanner-kit/dist/index.d.ts"],
      "@repo/scanner-kit/*": ["../scanner-kit/dist/*"]
    }
  },
  "include": ["src/**/*"]
}
