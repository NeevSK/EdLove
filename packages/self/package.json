{
  "name": "@repo/self",
  "version": "1.0.0",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./api": "./src/api/index.ts",
    "./components": "./src/components/index.ts",
    "./components/*": "./src/components/*.tsx",
    "./hooks": "./src/hooks/index.ts",
    "./hooks/*": "./src/hooks/*.ts",
    "./screens": "./src/screens/index.ts",
    "./screens/*": "./src/screens/*.tsx",
    "./types": "./src/types/index.ts",
    "./types/*": "./src/types/*.ts",
    "./screens/SelfScreen.web": "./src/screens/SelfScreen.web.tsx",
    "./screens/PrivacyLedgerScreen": "./src/screens/PrivacyLedgerScreen.tsx",
    "./package.json": "./package.json"
  },
  "scripts": {
    "lint": "pnpm run lint:biome && pnpm run lint:eslint",
    "typecheck": "pnpm exec tsc --noEmit",
    "check-types": "pnpm exec tsc --noEmit",
    "clean": "rm -rf .turbo node_modules dist",
    "lint:biome": "biome check .",
    "lint:eslint": "eslint .",
    "format": "biome format --write .",
    "check-cycles": "node ../../scripts/refactor/sovereign-cycle-checker.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui"
  },
  "dependencies": {
    "@repo/core": "workspace:*",
    "@repo/ui": "workspace:*",
    "@repo/profile": "workspace:*",
    "@tanstack/react-query": "^5.90.20",
    "lucide-react-native": "^0.563.0",
    "react-native-reanimated": "^4.2.1",
    "expo-haptics": "*",
    "date-fns": "^4.1.0",
    "@supabase/supabase-js": "2.102.1",
    "@supabase/postgrest-js": "2.102.1"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "react-i18next": "^16.5.4",
    "eslint": "^9.38.0",
    "@repo/eslint-config": "workspace:^",
    "@types/react": "^19.2.14",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9",
    "vite-tsconfig-paths": "^6.1.1"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*",
    "react-i18next": "*",
    "@repo/ui": "*",
    "lucide-react-native": "*",
    "@supabase/supabase-js": "2.102.1",
    "@supabase/postgrest-js": "2.102.1"
  }
}
