{
  "name": "@repo/self",
  "version": "1.0.0",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./wellbeing": { "types": "./src/wellbeing.ts", "import": "./src/wellbeing.ts", "default": "./src/wellbeing.ts" },
    "./wisdom": { "types": "./src/wisdom.ts", "import": "./src/wisdom.ts", "default": "./src/wisdom.ts" },
    "./progress": { "types": "./src/progress.ts", "import": "./src/progress.ts", "default": "./src/progress.ts" },
    "./privacy": { "types": "./src/privacy.ts", "import": "./src/privacy.ts", "default": "./src/privacy.ts" },
    "./api": {
      "types": "./src/api/index.ts",
      "import": "./src/api/index.ts",
      "default": "./src/api/index.ts"
    },
    "./screens/SelfScreen": {
      "import": "./src/screens/SelfScreen.tsx",
      "browser": "./src/screens/SelfScreen.web.tsx",
      "react-native": "./src/screens/SelfScreen.tsx",
      "default": "./src/screens/SelfScreen.tsx"
    },
    "./screens/SelfScreen.web": {
      "types": "./src/screens/SelfScreen.web.tsx",
      "import": "./src/screens/SelfScreen.web.tsx",
      "default": "./src/screens/SelfScreen.web.tsx"
    },
    "./screens/PrivacyLedgerScreen": {
      "types": "./src/screens/PrivacyLedgerScreen.tsx",
      "import": "./src/screens/PrivacyLedgerScreen.tsx",
      "default": "./src/screens/PrivacyLedgerScreen.tsx"
    },
    "./components/*": {
      "types": "./src/components/*.tsx",
      "import": "./src/components/*.tsx",
      "default": "./src/components/*.tsx"
    },
    "./*": {
      "types": "./src/*.ts",
      "import": "./src/*.js",
      "default": "./src/*.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "lint": "node ../../scripts/run-and-report.mjs --cmd \"pnpm run lint:biome && pnpm run lint:eslint\" --name \"packages_self-lint\"",
    "typecheck": "node ../../scripts/run-and-report.mjs --cmd \"pnpm exec tsc --build --noEmit\" --name \"packages_self-typecheck\"",
    "check-types": "node ../../scripts/run-and-report.mjs --cmd \"pnpm exec tsc --build --noEmit\" --name \"packages_self-check-types\"",
    "clean": "node ../../scripts/run-and-report.mjs --cmd \"rm -rf .turbo node_modules dist\" --name \"packages_self-clean\"",
    "lint:biome": "node ../../scripts/run-and-report.mjs --cmd \"node ../../scripts/scoped-biome.mjs\" --name \"packages_self-lint_biome\"",
    "lint:eslint": "node ../../scripts/run-and-report.mjs --cmd \"eslint .\" --name \"packages_self-lint_eslint\"",
    "format": "node ../../scripts/run-and-report.mjs --cmd \"node ../../scripts/scoped-biome.mjs --write\" --name \"packages_self-format\"",
    "check-cycles": "node ../../scripts/run-and-report.mjs --cmd \"node ../../scripts/refactor/sovereign-cycle-checker.mjs\" --name \"packages_self-check-cycles\"",
    "test": "node ../../scripts/run-and-report.mjs --cmd \"vitest run\" --name \"packages_self-test\"",
    "test:watch": "node ../../scripts/run-and-report.mjs --cmd \"vitest\" --name \"packages_self-test_watch\"",
    "test:ui": "node ../../scripts/run-and-report.mjs --cmd \"vitest --ui\" --name \"packages_self-test_ui\""
  },
  "dependencies": {
    "@repo/core": "workspace:*",
    "@repo/profile": "workspace:*",
    "@repo/ui": "workspace:*",
    "@supabase/postgrest-js": "2.102.1",
    "@supabase/supabase-js": "2.102.1",
    "@tanstack/react-query": "^5.101.0",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "expo-haptics": "~57.0.1",
    "expo-router": "~57.0.12",
    "react-native-reanimated": "^4.4.1"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:^",
    "@repo/typescript-config": "workspace:*",
    "@types/react": "^19.2.17",
    "eslint": "^10.4.1",
    "react-i18next": "^17.0.8",
    "typescript": "rc",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.8"
  },
  "peerDependencies": {
    "@repo/ui": "*",
    "@supabase/postgrest-js": "2.102.1",
    "@supabase/supabase-js": "2.102.1",
    "react": "*",
    "react-i18next": "*",
    "react-native": "*"
  },
  "_originalScripts": {
    "lint": "pnpm run lint:biome && pnpm run lint:eslint",
    "typecheck": "pnpm exec tsc --build --noEmit",
    "check-types": "pnpm exec tsc --build --noEmit",
    "clean": "rm -rf .turbo node_modules dist",
    "lint:biome": "node ../../scripts/scoped-biome.mjs",
    "lint:eslint": "eslint .",
    "format": "node ../../scripts/scoped-biome.mjs --write",
    "check-cycles": "node ../../scripts/refactor/sovereign-cycle-checker.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui"
  }
}
