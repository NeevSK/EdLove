{
  "name": "@repo/self",
  "version": "1.5.0",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./wellbeing": {
      "types": "./src/wellbeing.ts",
      "import": "./src/wellbeing.ts",
      "default": "./src/wellbeing.ts"
    },
    "./wisdom": {
      "types": "./src/wisdom.ts",
      "import": "./src/wisdom.ts",
      "default": "./src/wisdom.ts"
    },
    "./progress": {
      "types": "./src/progress.ts",
      "import": "./src/progress.ts",
      "default": "./src/progress.ts"
    },
    "./privacy": {
      "types": "./src/privacy.ts",
      "import": "./src/privacy.ts",
      "default": "./src/privacy.ts"
    },
    "./features/catalog": {
      "types": "./src/features/featureManifest.ts",
      "import": "./src/features/featureManifest.ts",
      "default": "./src/features/featureManifest.ts"
    },
    "./features/*": {
      "types": "./src/features/*.ts",
      "import": "./src/features/*.ts",
      "default": "./src/features/*.ts"
    },
    "./api": {
      "types": "./src/api/index.ts",
      "import": "./src/api/index.ts",
      "default": "./src/api/index.ts"
    },
    "./types": {
      "types": "./src/types/index.ts",
      "import": "./src/types/index.ts",
      "default": "./src/types/index.ts"
    },
    "./screens/SelfScreen": {
      "import": "./src/screens/SelfScreen.tsx",
      "browser": "./src/screens/SelfScreen.web.tsx",
      "react-native": "./src/screens/SelfScreen.tsx",
      "default": "./src/screens/SelfScreen.tsx"
    },
    "./screens/SelfScreen.web": {
      "types": "./src/screens/SelfScreen.web.tsx",
      "import": "./src/screens/SelfScreen.web.tsx",
      "default": "./src/screens/SelfScreen.web.tsx"
    },
    "./screens/PrivacyLedgerScreen": {
      "types": "./src/screens/PrivacyLedgerScreen.tsx",
      "import": "./src/screens/PrivacyLedgerScreen.tsx",
      "default": "./src/screens/PrivacyLedgerScreen.tsx"
    },
    "./components/*": {
      "types": "./src/components/*.tsx",
      "import": "./src/components/*.tsx",
      "default": "./src/components/*.tsx"
    },
    "./*": {
      "types": "./src/*.ts",
      "import": "./src/*.js",
      "default": "./src/*.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "lint": "node ../../scripts/run-and-report.mjs --cmd \"pnpm run lint:biome && pnpm run lint:eslint\" --name \"packages_self-lint\"",
    "typecheck": "node ../../scripts/run-and-report.mjs --cmd \"pnpm exec tsc --build --noEmit\" --name \"packages_self-typecheck\"",
    "check-types": "node ../../scripts/run-and-report.mjs --cmd \"pnpm exec tsc --build --noEmit\" --name \"packages_self-check-types\"",
    "clean": "node ../../scripts/run-and-report.mjs --cmd \"rm -rf .turbo node_modules dist\" --name \"packages_self-clean\"",
    "lint:biome": "node ../../scripts/run-and-report.mjs --cmd \"node ../../scripts/scoped-biome.mjs\" --name \"packages_self-lint_biome\"",
    "lint:eslint": "node ../../scripts/run-and-report.mjs --cmd \"eslint .\" --name \"packages_self-lint_eslint\"",
    "format": "node ../../scripts/run-and-report.mjs --cmd \"node ../../scripts/scoped-biome.mjs --write\" --name \"packages_self-format\"",
    "check-cycles": "node ../../scripts/run-and-report.mjs --cmd \"node ../../scripts/refactor/sovereign-cycle-checker.mjs\" --name \"packages_self-check-cycles\"",
    "test": "node ../../scripts/run-and-report.mjs --cmd \"vitest run\" --name \"packages_self-test\" --evidence-level G1",
    "test:watch": "node ../../scripts/run-and-report.mjs --cmd \"vitest\" --name \"packages_self-test_watch\" --evidence-level G1",
    "test:ui": "node ../../scripts/run-and-report.mjs --cmd \"vitest --ui\" --name \"packages_self-test_ui\" --evidence-level G1"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@repo/core": "workspace:*",
    "@repo/profile": "workspace:*",
    "@repo/ui": "workspace:*",
    "@tanstack/react-query": "^5.104.5",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.4",
    "expo-audio": "~58.0.10",
    "expo-file-system": "~58.0.10",
    "expo-haptics": "~58.0.7",
    "expo-notifications": "~58.1.6",
    "expo-router": "~58.0.25",
    "expo-sqlite": "~58.0.13",
    "react-native-reanimated": "4.7.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:^",
    "@repo/typescript-config": "workspace:*",
    "@types/react": "^19.3.0",
    "eslint": "^10.13.0",
    "react-i18next": "^17.1.0",
    "typescript": "7.1.0-beta",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "5.0.5"
  },
  "peerDependencies": {
    "@repo/ui": "1.5.0",
    "react": "19.3.1",
    "react-i18next": "^17.1.0",
    "react-native": "0.88.0",
    "react-native-skia": "^3.7.0"
  },
  "_originalScripts": {
    "lint": "pnpm run lint:biome && pnpm run lint:eslint",
    "typecheck": "pnpm exec tsc --build --noEmit",
    "check-types": "pnpm exec tsc --build --noEmit",
    "clean": "rm -rf .turbo node_modules dist",
    "lint:biome": "node ../../scripts/scoped-biome.mjs",
    "lint:eslint": "eslint .",
    "format": "node ../../scripts/scoped-biome.mjs --write",
    "check-cycles": "node ../../scripts/refactor/sovereign-cycle-checker.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui"
  }
}
