{
  "name": "@intuitui-labs/lk-edu-geo",
  "version": "1.0.0",
  "description": "Sri Lanka educational and administrative geo data",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "data"
  ],
  "keywords": [
    "sri-lanka",
    "lk",
    "education",
    "geo",
    "schools",
    "districts",
    "provinces",
    "gn-divisions",
    "educational-zones"
  ],
  "packageManager": "pnpm@10.30.2",
  "scripts": {
    "build": "pnpm exec tsup src/index.ts --format esm,cjs --dts --clean",
    "test": "vitest run",
    "validate": "pnpm exec tsx scripts/validate.ts",
    "lint": "pnpm run lint:biome && pnpm run lint:eslint",
    "check-types": "pnpm exec tsc --noEmit",
    "import:xlsx": "pnpm exec tsx scripts/import-xlsx.ts",
    "import:pdf": "pnpm exec tsx scripts/import-pdf.ts",
    "lint:biome": "biome check .",
    "lint:eslint": "eslint .",
    "format": "biome format --write .",
    "check-cycles": "node ../../scripts/refactor/sovereign-cycle-checker.mjs",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "clean": "rm -rf .turbo node_modules dist"
  },
  "devDependencies": {
    "@nishansanjuka/srilanka_geographics": "^0.0.1",
    "@repo/core": "workspace:*",
    "@types/node": "^25.5.0",
    "@types/glob": "^9.0.0",
    "glob": "^11.0.1",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9",
    "xlsx": "^0.18.5",
    "@repo/eslint-config": "workspace:^",
    "@repo/typescript-config": "workspace:*",
    "vite-tsconfig-paths": "^6.1.1",
    "eslint": "^9.38.0"
  }
}
