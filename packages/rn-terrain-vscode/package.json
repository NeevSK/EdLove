{
  "name": "@rn-terrain/vscode",
  "displayName": "RN Terrain",
  "description": "Visual React Native package intelligence, compatibility, and version checks directly inside package.json.",
  "version": "0.0.1",
  "publisher": "polymath",
  "engines": {
    "vscode": "^1.120.0"
  },
  "categories": [
    "Linters",
    "Other"
  ],
  "main": "./dist/extension.js",
  "scripts": {
    "vscode:prepublish": "node ../../scripts/run-and-report.mjs --cmd \"pnpm run compile\" --name \"packages_rn-terrain-vscode-vscode_prepublish\"",
    "compile": "node ../../scripts/run-and-report.mjs --cmd \"tsc -p ./\" --name \"packages_rn-terrain-vscode-compile\"",
    "watch": "node ../../scripts/run-and-report.mjs --cmd \"tsc -watch -p ./\" --name \"packages_rn-terrain-vscode-watch\""
  },
  "dependencies": {
    "@rn-terrain/core": "workspace:*"
  },
  "devDependencies": {
    "@types/vscode": "^1.120.0",
    "typescript": "rc"
  },
  "_originalScripts": {
    "vscode:prepublish": "pnpm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  }
}
