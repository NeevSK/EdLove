{
  "name": "@rn-terrain/cli",
  "version": "0.0.1",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "private": true,
  "type": "module",
  "bin": {
    "rn-eval": "./src/index.ts"
  },
  "scripts": {
    "check-types": "node ../../scripts/run-and-report.mjs --cmd \"pnpm exec tsc --noEmit\" --name \"packages_rn-terrain-cli-check-types\"",
    "clean": "node ../../scripts/run-and-report.mjs --cmd \"rm -rf .turbo node_modules dist\" --name \"packages_rn-terrain-cli-clean\""
  },
  "dependencies": {
    "@rn-terrain/core": "workspace:*",
    "cac": "^7.0.0",
    "chalk": "^5.6.2",
    "consola": "^3.4.2"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:^",
    "@repo/typescript-config": "workspace:*",
    "typescript": "^6.0.3"
  },
  "_originalScripts": {
    "check-types": "pnpm exec tsc --noEmit",
    "clean": "rm -rf .turbo node_modules dist"
  }
}
