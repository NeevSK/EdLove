{
  "extends": "../../packages/typescript-config/base.json",
  "compilerOptions": {
    "paths": {
      "@rn-terrain/cli/*": [
        "./src/*"
      ],
      "@rn-terrain/core/*": [
        "../rn-terrain-core/src/*"
      ],
      "@repo/core": [
        "../core/dist/index.d.ts"
      ],
      "@repo/core/*": [
        "../core/dist/*"
      ],
      "@repo/ui": [
        "../ui/dist/index.d.ts"
      ],
      "@repo/ui/*": [
        "../ui/dist/*"
      ]
    },
    "outDir": "./dist",
    "rootDir": "./src"
  },
  "include": [
    "src/**/*"
  ]
}
