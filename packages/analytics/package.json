{
  "name": "@repo/analytics",
  "version": "1.0.0",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./hooks": {
      "types": "./src/hooks/index.ts",
      "import": "./src/hooks/index.ts",
      "default": "./src/hooks/index.ts"
    },
    "./*": {
      "types": "./src/*.ts",
      "import": "./src/*.js",
      "default": "./src/*.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "lint": "pnpm run lint:biome && pnpm run lint:eslint",
    "check-types": "pnpm exec tsc --noEmit",
    "clean": "rm -rf .turbo node_modules dist",
    "lint:biome": "biome check .",
    "lint:eslint": "eslint .",
    "format": "biome format --write .",
    "check-cycles": "node ../../scripts/refactor/sovereign-cycle-checker.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui"
  },
  "dependencies": {
    "@repo/core": "workspace:*",
    "@repo/graphics": "workspace:*",
    "@repo/ui": "workspace:*",
    "@tanstack/react-query": "^5.101.0",
    "lucide-react-native": "^1.17.0",
    "posthog-js": "^1.383.1",
    "posthog-node": "^5.36.6",
    "posthog-react-native": "^4.46.21",
    "react-i18next": "^17.0.8"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:^",
    "@repo/typescript-config": "workspace:*",
    "@types/react": "^19.2.17",
    "eslint": "^10.4.1",
    "typescript": "^6.0.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.8"
  },
  "peerDependencies": {
    "@repo/ui": "*",
    "lucide-react-native": "*",
    "react": "*",
    "react-i18next": "*",
    "react-native": "*"
  }
}
