{
  "extends": "../../packages/typescript-config/base.json",
  "compilerOptions": {
    "composite": true,
    "emitDeclarationOnly": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@repo/core": [
        "../core/dist/index.d.ts"
      ],
      "@repo/core/*": [
        "../core/dist/*"
      ],
      "@repo/ui": [
        "../ui/dist/index.d.ts"
      ],
      "@repo/ui/*": [
        "../ui/dist/*"
      ],
      "@repo/graphics": [
        "../graphics/dist/index.d.ts"
      ],
      "@repo/graphics/*": [
        "../graphics/dist/*"
      ],
      "@repo/schema": [
        "../schema/dist/index.d.ts"
      ],
      "@repo/schema/*": [
        "../schema/dist/*"
      ],
      "@repo/analytics/*": [
        "./src/*"
      ]
    },
    "jsx": "react-jsx"
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    ".turbo"
  ],
  "references": [
    {
      "path": "../core"
    },
    {
      "path": "../ui"
    },
    {
      "path": "../graphics"
    },
    {
      "path": "../schema"
    }
  ]
}
