echo ">>> 🛂 SOVEREIGN GATE: Validating Global Push Integrity..."

# Default PUSH_SCOPE to "changed" if not set
SCOPE=${PUSH_SCOPE:-changed}

if [ "$SCOPE" = "all" ]; then
    echo ">>> 🌎 PUSH SCOPE: ALL PACKAGES"
    if [ "$PUSH_MODE" = "min" ]; then
        echo ">>> ⚠️  PUSH MODE: MINIMUM (LINT + REACT DOCTOR + TSC ONLY)"
        AuditCmd="pnpm exec commitlint --from=HEAD~1 --to=HEAD && pnpm run lint && pnpm run audit:react-doctor && pnpm run check-types"
    else
        echo ">>> 🔍 PUSH MODE: COMPREHENSIVE (ALL CHECKS)"
        AuditCmd="pnpm exec commitlint --from=HEAD~1 --to=HEAD && pnpm run lint && pnpm run audit:react-doctor && pnpm run check-types && pnpm run check:hygiene && pnpm run identity:check && pnpm run i18n:check"
    fi
else
    echo ">>> 🔬 PUSH SCOPE: SURGICAL (CHANGED PACKAGES ONLY)"
    AuditCmd="pnpm exec commitlint --from=HEAD~1 --to=HEAD && pnpm run lint && pnpm run audit:react-doctor && node scripts/surgical-push-check.mjs"
fi

node scripts/sovereign-audit.mjs --cmd "$AuditCmd" --log "reports/push_audit.md"

if [ $? -ne 0 ]; then
    echo ""
    echo "❌ PUSH REJECTED: Architectural or Quality Violations Detected."
    echo "📍 ACCESSIBLE REPORT: reports/push_audit.md"
    echo "💡 TIP: Review the report to see exact errors or run 'pnpm run check-all' to debug locally."
    exit 1
fi

echo ""
echo "✅ PUSH APPROVED: Integrity Verified."
exit 0
