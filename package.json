    "audit:duplication": "node ./scripts/run-and-report.mjs --cmd \"jscpd apps/gurudevi-mobile/src apps/gurudevi-mobile/app packages/core/src --min-lines 8 --min-tokens 50 --reporters console\" --name \"package_json-audit_duplication\"",
    "audit:aislop": "pnpm exec aislop scan --changes",
    "check:aislop": "pnpm exec aislop ci --changes",
    "heal:aislop": "pnpm exec aislop fix --safe",
    "audit:fallow": "pnpm exec fallow review --brief",
    "check:fallow": "pnpm exec fallow audit",
    "check:anti-slop": "pnpm run check:aislop && pnpm run check:fallow",
    "check:sanctuary-experience": "node scripts/check-sanctuary-experience-contract.mjs",
    "check:ota-safety": "node scripts/ota-safety-check.mjs",
    "ota-safety:init": "node scripts/ota-safety-check.mjs --init",
    "preflight:build": "node scripts/preflight-build.mjs",
    "preinstall": "node -e \"if(process.env.npm_config_user_agent && !/pnpm/.test(process.env.npm_config_user_agent)) { console.error('\\u001b[31mFATAL: This project requires pnpm. Use \\'pnpm install\\' to continue.\\u001b[0m'); process.exit(1); }\""
  },
