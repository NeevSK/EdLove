{
  "name": "polymath-platform",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm exec turbo run build",
    "dev": "pnpm exec turbo run dev",
    "start": "pnpm exec turbo run start",
    "lint": "pnpm run lint:oxlint && pnpm turbo run lint --concurrency=1",
    "lint:oxlint": "oxlint .",
    "lint:oxlint:fix": "oxlint . --fix",
    "lint:biome": "pnpm turbo run lint:biome",
    "lint:eslint": "pnpm turbo run lint:eslint",
    "format": "pnpm turbo run format",
    "format:fix": "biome check --write .",
    "biome:audit": "powershell -ExecutionPolicy Bypass -File scripts/biome-audit.ps1",
    "audit:size": "powershell -ExecutionPolicy Bypass -File scripts/audit-wrapper.ps1 -Cmd \"pnpm exec size-limit\" -Log \"reports/size_audit.txt\"",
    "audit:mobile:doctor": "powershell -ExecutionPolicy Bypass -File scripts/audit-wrapper.ps1 -Cmd \"pnpm --filter gurudevi-mobile exec pnpm dlx expo-doctor\" -Log \"reports/mobile_doctor_audit.txt\"",
    "format:legacy": "pnpm exec prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "node scripts/sovereign-audit.mjs --cmd \"pnpm turbo run check-types --concurrency=1\" --log \"reports/check-types.txt\"",
    "check-all": "pnpm run lint && pnpm run check-types && pnpm run audit:cycles && pnpm run audit:deprecations && pnpm run check:unused && pnpm run audit:security",
    "audit:security": "pnpm dlx snyk test --all-projects && pnpm dlx semgrep scan --config auto",
    "audit:cycles": "node scripts/refactor/sovereign-cycle-checker.mjs",
    "android": "pnpm exec expo run:android",
    "ios": "pnpm exec expo run:ios",
    "i18n:audit": "node scripts/i18n/audit-keys.mjs",
    "i18n:no-inline-fallbacks": "node scripts/i18n/check-inline-fallbacks.js",
    "i18n:check": "pnpm run i18n:audit && pnpm run i18n:no-inline-fallbacks",
    "identity:check": "node scripts/sovereign-audit.mjs --cmd \"node scripts/check-identity-alignment.mjs\" --log \"reports/identity_check.txt\"",
    "migration:web:inventory": "node scripts/refactor/generate-web-migration-manifest.mjs",
    "migration:web:imports": "node scripts/refactor/find-app-domain-imports.mjs",
    "migration:web:codemod": "node scripts/refactor/apply-web-migration-codemod.mjs",
    "migration:web:check": "node scripts/refactor/check-web-boundaries.mjs",
    "migration:web:barrels": "node scripts/refactor/generate-barrels.mjs",
    "ai:fix": "node scripts/ts-fix.mjs",
    "prepare": "pnpm exec husky",
    "check:circular": "node scripts/sovereign-audit.mjs --cmd \"pnpm exec depcruise packages apps --config .dependency-cruiser.cjs --output-type err\" --filter \"no-circular\" --log \"reports/circular_deps.txt\"",
    "check:unused": "node scripts/sovereign-audit.mjs --cmd \"pnpm exec depcruise packages apps --config .dependency-cruiser.cjs --output-type err\" --filter \"no-orphans\" --log \"reports/unused_code.txt\"",
    "check:architecture": "node scripts/sovereign-audit.mjs --cmd \"pnpm exec depcruise packages apps --config .dependency-cruiser.cjs --output-type err\" --log \"reports/architecture.txt\"",
    "check:hygiene": "node ./scripts/check-hygiene.mjs",
    "check:schema-drift": "node scripts/check-schema-drift.mjs",
    "check:self-boundaries": "node scripts/check-self-boundaries.mjs",
    "check:classroom-boundaries": "node scripts/check-classroom-boundaries.mjs",
    "maintenance:outdated": "powershell -File scripts/audit-dependency-health.ps1",
    "maintenance:align": "pnpm exec syncpack list-mismatches",
    "maintenance:fix": "pnpm exec syncpack fix-mismatches",
    "maintenance:doctor": "pnpm run audit:mobile:doctor",
    "change": "pnpm exec changeset",
    "change:smart": "node scripts/smart-changeset.mjs",
    "version:all": "pnpm exec changeset version && pnpm install",
    "mcp:supabase:debug": "node --no-warnings scripts/mcp-proxy.mjs node node_modules/@supabase/mcp-server-supabase/dist/index.js --project-ref ${env.SUPABASE_PROJECT_REF}",
    "audit:deprecations": "powershell -ExecutionPolicy Bypass -File scripts/audit-deprecations.ps1",
    "preinstall": "node -e \"if(process.env.npm_config_user_agent && !/pnpm/.test(process.env.npm_config_user_agent)) { console.error('\\u001b[31mFATAL: This project requires pnpm. Use \\'pnpm install\\' to continue.\\u001b[0m'); process.exit(1); }\"",
    "sync-skills": "node scripts/sync-skills.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.10",
    "@changesets/cli": "^2.28.1",
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@dagger.io/dagger": "^0.20.6",
    "@eslint/eslintrc": "^3.3.5",
    "@expo/config": "~56.0.9",
    "@expo/config-plugins": "~56.0.8",
    "@expo/metro": "~56.0.0",
    "@react-navigation/core": "^7.17.2",
    "@react-navigation/routers": "^7.5.3",
    "@repo/types-shim": "workspace:*",
    "@size-limit/preset-small-lib": "^12.0.1",
    "@tanstack/query-core": "^5.96.2",
    "@testing-library/react-native": "14.0.0-beta.0",
    "@types/node": "^25.5.0",
    "@typescript-eslint/parser": "^8.59.4",
    "@zenstackhq/cli": "3.6.4",
    "@zenstackhq/language": "3.6.4",
    "@zenstackhq/orm": "3.6.4",
    "@zenstackhq/schema": "3.6.4",
    "@zenstackhq/sdk": "3.6.4",
    "@zenstackhq/zod": "3.6.4",
    "chalk": "^5.6.2",
    "dependency-cruiser": "^17.3.9",
    "eslint": "^10.4.1",
    "eslint-config-expo": "^56.0.4",
    "eslint-plugin-oxlint": "^1.69.0",
    "expo-modules-core": "~56.0.0",
    "gitleaks": "^1.0.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-expo": "~56.0.0",
    "knip": "^6.0.6",
    "lint-staged": "^16.3.2",
    "madge": "^8.0.0",
    "oxlint": "^1.69.0",
    "oxlint-config-universe": "^0.0.3",
    "prettier": "^3.6.2",
    "promptfoo": "^0.121.9",
    "size-limit": "^12.0.1",
    "supabase": "^2.98.2",
    "syncpack": "^13.0.0",
    "taze": "^19.13.0",
    "turbo": "^2.9.14",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": "24.x"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "version": "1.0.0",
  "dependencies": {
    "@shopify/react-native-skia": "2.6.2",
    "@supabase/mcp-server-supabase": "^0.7.0",
    "@ts-rest/core": "3.53.0-rc.1",
    "expo": "~56.0.4",
    "react": "19.2.3",
    "react-native": "~0.85.3",
    "react-native-gesture-handler": "2.31.1",
    "semver": "^7.6.3"
  }
}
