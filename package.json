{
  "name": "polymath-platform",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node ./scripts/run-and-report.mjs --cmd \"pnpm exec turbo run build\" --name \"package_json-build\"",
    "dev": "node ./scripts/run-and-report.mjs --cmd \"pnpm exec turbo run dev\" --name \"package_json-dev\"",
    "start": "node ./scripts/run-and-report.mjs --cmd \"pnpm exec turbo run start\" --name \"package_json-start\"",
    "lint": "node ./scripts/run-and-report.mjs --cmd \"pnpm turbo run lint\" --name \"package_json-lint\"",
    "lint:biome": "node ./scripts/run-and-report.mjs --cmd \"pnpm turbo run lint:biome\" --name \"package_json-lint_biome\"",
    "lint:eslint": "node ./scripts/run-and-report.mjs --cmd \"pnpm turbo run lint:eslint\" --name \"package_json-lint_eslint\"",
    "format": "node ./scripts/run-and-report.mjs --cmd \"pnpm turbo run format\" --name \"package_json-format\"",
    "format:fix": "node ./scripts/run-and-report.mjs --cmd \"biome check --write .\" --name \"package_json-format_fix\"",
    "biome:audit": "powershell -ExecutionPolicy Bypass -File scripts/biome-audit.ps1",
    "run:report": "node scripts/run-and-report.mjs",
    "wrap:reports": "node scripts/toggle-reports.mjs",
    "unwrap:reports": "node scripts/toggle-reports.mjs --unwrap",
    "audit:size": "powershell -ExecutionPolicy Bypass -File scripts/audit-wrapper.ps1 -Cmd \"pnpm exec size-limit\" -Log \"reports/size_audit.txt\"",
    "audit:mobile:doctor": "powershell -ExecutionPolicy Bypass -File scripts/audit-wrapper.ps1 -Cmd \"pnpm --filter gurudevi-mobile exec pnpm dlx expo-doctor\" -Log \"reports/mobile_doctor_audit.txt\"",
    "audit:react-doctor": "node ./scripts/run-and-report.mjs --cmd \"npx react-doctor\" --name \"package_json-audit_react-doctor\"",
    "check-types": "node scripts/sovereign-audit.mjs --cmd \"pnpm turbo run check-types\" --log \"reports/check-types.txt\"",
    "check-all": "node ./scripts/run-and-report.mjs --cmd \"pnpm run lint && pnpm run audit:react-doctor && pnpm run check-types && pnpm run audit:cycles && pnpm run audit:deprecations && pnpm run check:unused && pnpm run audit:security\" --name \"package_json-check-all\"",
    "audit:security": "node ./scripts/run-and-report.mjs --cmd \"pnpm dlx snyk test --all-projects && pnpm dlx semgrep scan --config auto\" --name \"package_json-audit_security\"",
    "audit:cycles": "node ./scripts/run-and-report.mjs --cmd \"node scripts/refactor/sovereign-cycle-checker.mjs\" --name \"package_json-audit_cycles\"",
    "android": "node ./scripts/run-and-report.mjs --cmd \"pnpm exec expo run:android\" --name \"package_json-android\"",
    "ios": "node ./scripts/run-and-report.mjs --cmd \"pnpm exec expo run:ios\" --name \"package_json-ios\"",
    "i18n:audit": "node ./scripts/run-and-report.mjs --cmd \"node scripts/i18n/audit-keys.mjs\" --name \"package_json-i18n_audit\"",
    "i18n:no-inline-fallbacks": "node ./scripts/run-and-report.mjs --cmd \"node scripts/i18n/check-inline-fallbacks.js\" --name \"package_json-i18n_no-inline-fallbacks\"",
    "i18n:check": "node ./scripts/run-and-report.mjs --cmd \"pnpm run i18n:audit && pnpm run i18n:no-inline-fallbacks\" --name \"package_json-i18n_check\"",
    "identity:check": "node scripts/sovereign-audit.mjs --cmd \"node scripts/check-identity-alignment.mjs\" --log \"reports/identity_check.txt\"",
    "migration:web:inventory": "node ./scripts/run-and-report.mjs --cmd \"node scripts/refactor/generate-web-migration-manifest.mjs\" --name \"package_json-migration_web_inventory\"",
    "migration:web:imports": "node ./scripts/run-and-report.mjs --cmd \"node scripts/refactor/find-app-domain-imports.mjs\" --name \"package_json-migration_web_imports\"",
    "migration:web:codemod": "node ./scripts/run-and-report.mjs --cmd \"node scripts/refactor/apply-web-migration-codemod.mjs\" --name \"package_json-migration_web_codemod\"",
    "migration:web:check": "node ./scripts/run-and-report.mjs --cmd \"node scripts/refactor/check-web-boundaries.mjs\" --name \"package_json-migration_web_check\"",
    "migration:web:barrels": "node ./scripts/run-and-report.mjs --cmd \"node scripts/refactor/generate-barrels.mjs\" --name \"package_json-migration_web_barrels\"",
    "ai:fix": "node ./scripts/run-and-report.mjs --cmd \"node scripts/ts-fix.mjs\" --name \"package_json-ai_fix\"",
    "prepare": "pnpm exec husky",
    "check:circular": "node scripts/sovereign-audit.mjs --cmd \"pnpm exec depcruise packages apps --config .dependency-cruiser.cjs --output-type err\" --filter \"no-circular\" --log \"reports/circular_deps.txt\"",
    "check:unused": "node scripts/sovereign-audit.mjs --cmd \"pnpm exec depcruise packages apps --config .dependency-cruiser.cjs --output-type err\" --filter \"no-orphans\" --log \"reports/unused_code.txt\"",
    "check:architecture": "node scripts/sovereign-audit.mjs --cmd \"pnpm exec depcruise packages apps --config .dependency-cruiser.cjs --output-type err\" --log \"reports/architecture.txt\"",
    "check:hygiene": "node ./scripts/run-and-report.mjs --cmd \"node ./scripts/check-hygiene.mjs\" --name \"package_json-check_hygiene\"",
    "check:self-boundaries": "node ./scripts/run-and-report.mjs --cmd \"node scripts/check-self-boundaries.mjs\" --name \"package_json-check_self-boundaries\"",
    "check:classroom-boundaries": "node ./scripts/run-and-report.mjs --cmd \"node scripts/check-classroom-boundaries.mjs\" --name \"package_json-check_classroom-boundaries\"",
    "maintenance:outdated": "node ./scripts/run-and-report.mjs --cmd \"powershell -File scripts/audit-dependency-health.ps1\" --name \"package_json-maintenance_outdated\"",
    "maintenance:align": "node ./scripts/run-and-report.mjs --cmd \"pnpm exec syncpack list-mismatches\" --name \"package_json-maintenance_align\"",
    "maintenance:fix": "node ./scripts/run-and-report.mjs --cmd \"pnpm exec syncpack fix-mismatches\" --name \"package_json-maintenance_fix\"",
    "maintenance:doctor": "node ./scripts/run-and-report.mjs --cmd \"pnpm run audit:mobile:doctor\" --name \"package_json-maintenance_doctor\"",
    "change": "node ./scripts/run-and-report.mjs --cmd \"pnpm exec changeset\" --name \"package_json-change\"",
    "change:smart": "node ./scripts/run-and-report.mjs --cmd \"node scripts/smart-changeset.mjs\" --name \"package_json-change_smart\"",
    "version:all": "node ./scripts/run-and-report.mjs --cmd \"pnpm exec changeset version && pnpm install\" --name \"package_json-version_all\"",
    "mcp:supabase:debug": "node ./scripts/run-and-report.mjs --cmd \"node --no-warnings scripts/mcp-proxy.mjs node node_modules/@supabase/mcp-server-supabase/dist/index.js --project-ref ${env.SUPABASE_PROJECT_REF}\" --name \"package_json-mcp_supabase_debug\"",
    "audit:deprecations": "node ./scripts/run-and-report.mjs --cmd \"powershell -ExecutionPolicy Bypass -File scripts/audit-deprecations.ps1\" --name \"package_json-audit_deprecations\"",
    "preinstall": "node -e \"if(process.env.npm_config_user_agent && !/pnpm/.test(process.env.npm_config_user_agent)) { console.error('\\u001b[31mFATAL: This project requires pnpm. Use \\'pnpm install\\' to continue.\\u001b[0m'); process.exit(1); }\""
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.10",
    "@changesets/cli": "^2.28.1",
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@dagger.io/dagger": "^0.20.6",
    "@eslint/eslintrc": "^3.3.5",
    "@expo/config": "~55.0.0",
    "@expo/config-plugins": "~55.0.0",
    "@expo/metro": "~55.0.0",
    "@react-navigation/core": "^7.17.2",
    "@react-navigation/routers": "^7.5.3",
    "@repo/types-shim": "workspace:*",
    "@size-limit/preset-small-lib": "^12.0.1",
    "@tanstack/query-core": "^5.96.2",
    "@tanstack/react-query-devtools": "^5.101.0",
    "@testing-library/react-native": "14.0.0-beta.0",
    "@types/node": "^25.5.0",
    "@zenstackhq/cli": "3.6.4",
    "@zenstackhq/language": "3.6.4",
    "@zenstackhq/orm": "3.6.4",
    "@zenstackhq/schema": "3.6.4",
    "@zenstackhq/sdk": "3.6.4",
    "@zenstackhq/zod": "3.6.4",
    "chalk": "^5.6.2",
    "dependency-cruiser": "^17.3.9",
    "eslint": "^10.4.1",
    "expo-modules-core": "~55.0.17",
    "gitleaks": "^1.0.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-expo": "~55.0.16",
    "knip": "^6.0.6",
    "lint-staged": "^16.3.2",
    "madge": "^8.0.0",
    "oxfmt": "^0.55.0",
    "oxlint": "^1.70.0",
    "promptfoo": "^0.121.9",
    "react-native-devtools": "^0.0.1",
    "size-limit": "^12.0.1",
    "supabase": "^2.98.2",
    "syncpack": "^13.0.0",
    "turbo": "^2.6.0",
    "typescript": "^5.9.3",
    "typescript-eslint-parser": "^22.0.0"
  },
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": "24.x"
  },
  "volta": {
    "node": "24.11.0",
    "pnpm": "11.8.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "version": "1.0.0",
  "dependencies": {
    "@shopify/react-native-skia": "2.4.18",
    "@supabase/mcp-server-supabase": "^0.7.0",
    "@ts-rest/core": "3.53.0-rc.1",
    "expo": "~55.0.17",
    "react": "19.1.0",
    "react-native": "~0.83.6",
    "react-native-gesture-handler": "2.30.0",
    "semver": "^7.6.3"
  },
  "_originalScripts": {
    "build": "pnpm exec turbo run build",
    "dev": "pnpm exec turbo run dev",
    "start": "pnpm exec turbo run start",
    "lint": "pnpm turbo run lint",
    "lint:biome": "pnpm turbo run lint:biome",
    "lint:eslint": "pnpm turbo run lint:eslint",
    "format": "pnpm turbo run format",
    "format:fix": "biome check --write .",
    "biome:audit": "powershell -ExecutionPolicy Bypass -File scripts/biome-audit.ps1",
    "run:report": "node scripts/run-and-report.mjs",
    "wrap:reports": "node scripts/toggle-reports.mjs",
    "unwrap:reports": "node scripts/toggle-reports.mjs --unwrap",
    "audit:size": "powershell -ExecutionPolicy Bypass -File scripts/audit-wrapper.ps1 -Cmd \"pnpm exec size-limit\" -Log \"reports/size_audit.txt\"",
    "audit:mobile:doctor": "powershell -ExecutionPolicy Bypass -File scripts/audit-wrapper.ps1 -Cmd \"pnpm --filter gurudevi-mobile exec pnpm dlx expo-doctor\" -Log \"reports/mobile_doctor_audit.txt\"",
    "audit:react-doctor": "npx react-doctor",
    "check-types": "node scripts/sovereign-audit.mjs --cmd \"pnpm turbo run check-types\" --log \"reports/check-types.txt\"",
    "check-all": "pnpm run lint && pnpm run audit:react-doctor && pnpm run check-types && pnpm run audit:cycles && pnpm run audit:deprecations && pnpm run check:unused && pnpm run audit:security",
    "audit:security": "pnpm dlx snyk test --all-projects && pnpm dlx semgrep scan --config auto",
    "audit:cycles": "node scripts/refactor/sovereign-cycle-checker.mjs",
    "android": "pnpm exec expo run:android",
    "ios": "pnpm exec expo run:ios",
    "i18n:audit": "node scripts/i18n/audit-keys.mjs",
    "i18n:no-inline-fallbacks": "node scripts/i18n/check-inline-fallbacks.js",
    "i18n:check": "pnpm run i18n:audit && pnpm run i18n:no-inline-fallbacks",
    "identity:check": "node scripts/sovereign-audit.mjs --cmd \"node scripts/check-identity-alignment.mjs\" --log \"reports/identity_check.txt\"",
    "migration:web:inventory": "node scripts/refactor/generate-web-migration-manifest.mjs",
    "migration:web:imports": "node scripts/refactor/find-app-domain-imports.mjs",
    "migration:web:codemod": "node scripts/refactor/apply-web-migration-codemod.mjs",
    "migration:web:check": "node scripts/refactor/check-web-boundaries.mjs",
    "migration:web:barrels": "node scripts/refactor/generate-barrels.mjs",
    "ai:fix": "node scripts/ts-fix.mjs",
    "prepare": "pnpm exec husky",
    "check:circular": "node scripts/sovereign-audit.mjs --cmd \"pnpm exec depcruise packages apps --config .dependency-cruiser.cjs --output-type err\" --filter \"no-circular\" --log \"reports/circular_deps.txt\"",
    "check:unused": "node scripts/sovereign-audit.mjs --cmd \"pnpm exec depcruise packages apps --config .dependency-cruiser.cjs --output-type err\" --filter \"no-orphans\" --log \"reports/unused_code.txt\"",
    "check:architecture": "node scripts/sovereign-audit.mjs --cmd \"pnpm exec depcruise packages apps --config .dependency-cruiser.cjs --output-type err\" --log \"reports/architecture.txt\"",
    "check:hygiene": "node ./scripts/check-hygiene.mjs",
    "check:self-boundaries": "node scripts/check-self-boundaries.mjs",
    "check:classroom-boundaries": "node scripts/check-classroom-boundaries.mjs",
    "maintenance:outdated": "powershell -File scripts/audit-dependency-health.ps1",
    "maintenance:align": "pnpm exec syncpack list-mismatches",
    "maintenance:fix": "pnpm exec syncpack fix-mismatches",
    "maintenance:doctor": "pnpm run audit:mobile:doctor",
    "change": "pnpm exec changeset",
    "change:smart": "node scripts/smart-changeset.mjs",
    "version:all": "pnpm exec changeset version && pnpm install",
    "mcp:supabase:debug": "node --no-warnings scripts/mcp-proxy.mjs node node_modules/@supabase/mcp-server-supabase/dist/index.js --project-ref ${env.SUPABASE_PROJECT_REF}",
    "audit:deprecations": "powershell -ExecutionPolicy Bypass -File scripts/audit-deprecations.ps1",
    "preinstall": "node -e \"if(process.env.npm_config_user_agent && !/pnpm/.test(process.env.npm_config_user_agent)) { console.error('\\u001b[31mFATAL: This project requires pnpm. Use \\'pnpm install\\' to continue.\\u001b[0m'); process.exit(1); }\""
  }
}
