    "stack-map:deps": "node ./scripts/run-and-report.mjs --cmd \"node scripts/stack-map.mjs deps\" --name \"package_json-stack_map_deps\"",
    "maintenance:align": "node ./scripts/run-and-report.mjs --cmd \"pnpm exec syncpack lint\" --name \"package_json-maintenance_align\"",
    "maintenance:fix": "node ./scripts/run-and-report.mjs --cmd \"pnpm exec syncpack fix-mismatches\" --name \"package_json-maintenance_fix\"",
    "maintenance:doctor": "node ./scripts/run-and-report.mjs --cmd \"pnpm run audit:mobile:doctor\" --name \"package_json-maintenance_doctor\"",
