    "audit:react-doctor": "node ./scripts/run-and-report.mjs --cmd \"npx react-doctor\" --name \"package_json-audit_react-doctor\"",
    "check-types": "node scripts/sovereign-audit.mjs --cmd \"pnpm turbo run check-types\" --log \"reports/check-types.txt\"",
    "check-all": "node ./scripts/run-and-report.mjs --cmd \"pnpm run audit:secrets && pnpm run lint && pnpm run check:observability-boundaries && pnpm run audit:react-doctor && pnpm run check-types && pnpm run check:icons && pnpm run audit:cycles && pnpm run audit:deprecations && pnpm run check:unused && pnpm run audit:security\" --name \"package_json-check-all\"",
    "audit:security": "node ./scripts/run-and-report.mjs --cmd \"pnpm dlx snyk test --all-projects && pnpm dlx semgrep scan --config auto\" --name \"package_json-audit_security\"",
    "audit:secrets": "node scripts/verify-doppler-config.mjs --scope workspace",
    "toolchain:check": "node scripts/check-toolchain.mjs && node scripts/verify-doppler-config.mjs --scope workspace",
    "check:platform-readiness": "node scripts/check-platform-readiness.mjs",
    "env:check": "node scripts/verify-doppler-config.mjs",
    "env:check:ci": "node scripts/verify-doppler-config.mjs --scope ci --all-ci",
    "audit:cycles": "node ./scripts/run-and-report.mjs --cmd \"node scripts/refactor/sovereign-cycle-checker.mjs\" --name \"package_json-audit_cycles\"",
    "android": "node ./scripts/run-and-report.mjs --cmd \"pnpm exec expo run:android\" --name \"package_json-android\"",
    "ios": "node ./scripts/run-and-report.mjs --cmd \"pnpm exec expo run:ios\" --name \"package_json-ios\"",
    "i18n:audit": "node ./scripts/run-and-report.mjs --cmd \"node scripts/i18n/audit-keys.mjs\" --name \"package_json-i18n_audit\"",
    "i18n:no-inline-fallbacks": "node ./scripts/run-and-report.mjs --cmd \"node scripts/i18n/check-inline-fallbacks.js\" --name \"package_json-i18n_no-inline-fallbacks\"",
    "i18n:check": "node scripts/i18n/check.mjs",
    "identity:check": "node scripts/sovereign-audit.mjs --cmd \"node scripts/check-identity-alignment.mjs\" --log \"reports/identity_check.txt\"",
    "migration:web:inventory": "node ./scripts/run-and-report.mjs --cmd \"node scripts/refactor/generate-web-migration-manifest.mjs\" --name \"package_json-migration_web_inventory\"",
    "migration:web:imports": "node ./scripts/run-and-report.mjs --cmd \"node scripts/refactor/find-app-domain-imports.mjs\" --name \"package_json-migration_web_imports\"",
    "migration:web:codemod": "node ./scripts/run-and-report.mjs --cmd \"node scripts/refactor/apply-web-migration-codemod.mjs\" --name \"package_json-migration_web_codemod\"",
    "migration:web:check": "node ./scripts/run-and-report.mjs --cmd \"node scripts/refactor/check-web-boundaries.mjs\" --name \"package_json-migration_web_check\"",
    "migration:web:barrels": "node ./scripts/run-and-report.mjs --cmd \"node scripts/refactor/generate-barrels.mjs\" --name \"package_json-migration_web_barrels\"",
    "ai:fix": "node ./scripts/run-and-report.mjs --cmd \"node scripts/ts-fix.mjs\" --name \"package_json-ai_fix\"",
    "prepare": "pnpm exec husky",
    "check:circular": "node scripts/sovereign-audit.mjs --cmd \"pnpm exec depcruise packages apps --config .dependency-cruiser.cjs --output-type err\" --filter \"no-circular\" --log \"reports/circular_deps.txt\"",
    "check:unused": "node scripts/sovereign-audit.mjs --cmd \"pnpm exec depcruise packages apps --config .dependency-cruiser.cjs --output-type err\" --filter \"no-orphans\" --log \"reports/unused_code.txt\"",
    "check:architecture": "node scripts/sovereign-audit.mjs --cmd \"pnpm exec depcruise packages apps --config .dependency-cruiser.cjs --output-type err\" --log \"reports/architecture.txt\"",
