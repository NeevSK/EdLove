    "format": "node ./scripts/run-and-report.mjs --cmd \"pnpm turbo run format\" --name \"package_json-format\"",
    "format:fix": "node ./scripts/run-and-report.mjs --cmd \"node ./scripts/scoped-biome.mjs --write\" --name \"package_json-format_fix\"",
