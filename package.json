    "audit:a11y": "pnpm --filter gurudevi-mobile exec vitest run --tagsFilter \"a11y\"",
    "test:feature-lifecycle": "pnpm --filter @repo/core exec vitest run src/adapters/__tests__/growthbook.test.ts src/logic/permissions/__tests__/sanctuaryFeature.test.ts src/logic/registry/__tests__ src/store/__tests__/featureSlice.test.ts",
