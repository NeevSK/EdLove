    "audit:authorization-parity": "node scripts/check-authorization-parity.mjs",
    "audit:api-contracts": "pnpm --filter @repo/sanctuary-api exec tsx --tsconfig ../../tsconfig.json ../../scripts/audit-api-contracts.ts",
    "audit:api-errors": "node scripts/audit-api-errors.mjs",
    "audit:data-boundaries": "node scripts/audit-data-boundaries.mjs",
    "audit:api-composition": "node scripts/audit-api-composition.mjs",
