{
  "name": "polymath-platform",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "check-all": "pnpm run lint && pnpm run check-types && pnpm run test",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "devDependencies": {
    "@repo/types-shim": "workspace:*",
    "@testing-library/react-native": "14.0.0-beta.0",
    "jest": "^30.2.0",
    "jest-expo": "55.0.9",
    "prettier": "^3.6.2",
    "turbo": "^2.6.0",
    "typescript": "5.9.2"
  },
  "pnpm": {
    "packageExtensions": {},
    "overrides": {
      "react": "19.2.0",
      "react-dom": "19.2.0",
      "react-native": "0.83.2",
      "react-native-worklets": "0.7.2",
      "react-test-renderer": "19.2.0",
      "@types/react": "19.2.14",
      "@types/react-dom": "19.2.1",
      "@types/react-native": "workspace:@repo/types-shim",
      "glob": "^11.0.0",
      "rimraf": "^6.0.0",
      "inflight": "*",
      "abab": "*",
      "domexception": "*",
      "whatwg-encoding": "*",
      "nitro-modules": "0.33.9",
      "@sentry/react-native": "~7.11.0"
    },
    "onlyBuiltDependencies": [
      "@sentry/cli",
      "@parcel/watcher",
      "esbuild",
      "@img/sharp-win32-x64",
      "sharp",
      "turbo",
      "supabase",
      "@shopify/react-native-skia"
    ]
  },
  "packageManager": "pnpm@10.30.2",
  "engines": {
    "node": ">=18"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "version": "1.0.0",
  "dependencies": {
    "@shopify/react-native-skia": "2.4.18",
    "expo": "~55.0.0",
    "react": "19.2.0",
    "react-native": "0.83.2",
    "semver": "^7.6.3"
  }
}