{
  "name": "polymath-platform",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "devDependencies": {
    "@testing-library/react-native": "14.0.0-beta.0",
    "jest": "^30.2.0",
    "jest-expo": "^54.0.17",
    "prettier": "^3.6.2",
    "turbo": "^2.6.0",
    "typescript": "5.9.2"
  },
  "pnpm": {
    "overrides": {
      "react": "19.1.0",
      "react-dom": "19.1.0",
      "react-native": "0.81.5",
      "react-native-worklets": "0.5.1",
      "react-test-renderer": "19.1.0",
      "@types/react": "19.1.10",
      "@types/react-dom": "19.1.1",
      "nitro-modules": "0.33.9"
    }
  },
  "packageManager": "pnpm@9.0.0",
