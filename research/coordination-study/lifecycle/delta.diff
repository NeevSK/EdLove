+function runtimeRevision() {
+  const extension = path.extname(fileURLToPath(import.meta.url));
+  const files = [
+    './model',
+    './evaluate',
+    './store',
+    './runtime',
+    '../coordination',
+    '../coordinationStore',
+    '../coordinationTools',
+    '../utils/execution',
