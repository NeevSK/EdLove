+              run.state !== 'finished' ||
+              !run.result?.ok ||
+              run.result.exitCode !== 0 ||
+              !!run.result.error ||
+              run.inputRefs.some((ref) => staleSet(next, []).has(key(ref)))
+            );
+          }) ||
+            manual.some(
