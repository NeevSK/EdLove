+            title: previous.title,
+            expected: [...new Set([...previous.expected, ...task.expected])],
+            toolNeeds: [...new Set([...previous.toolNeeds, ...task.toolNeeds])],
+            requires: [...new Set([...previous.requires, ...task.requires])],
+          };
