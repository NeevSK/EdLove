@@ -0,0 +1,207 @@
+import { DatabaseSync } from 'node:sqlite';
+import { z } from 'zod';
+import { withStore } from '../coordinationStore.js';
+
+const lifecycleRowSchema = z.strictObject({
+  id: z.string(),
+  revision: z.number().int().nonnegative(),
+  state: z.string(),
+});
+const operationRowSchema = z.strictObject({
+  operation_id: z.string(),
+  payload: z.string(),
+  result: z.string(),
+  revision: z.number().int().nonnegative(),
+  created_at: z.string(),
+});
+const maximumHistoryRows = 1000;
+
+export type LifecycleHistoryRecord = {
+  operationId: string;
+  payload: unknown;
+  result: unknown;
+  revision: number;
+  createdAt: string;
+};
+
+export type LifecycleOperation = {
+  payload: string;
+  result: unknown;
+};
+
+export function withLifecycleStore<T>(databasePath: string, operation: (db: DatabaseSync) => T): T {
+  return withStore(databasePath, (db) => {
+    db.exec(`
+      CREATE TABLE IF NOT EXISTS lifecycle_records (
+        id TEXT PRIMARY KEY,
+        revision INTEGER NOT NULL CHECK (revision >= 0),
+        state TEXT NOT NULL
+      );
+      CREATE TABLE IF NOT EXISTS lifecycle_operations (
+        lifecycle_id TEXT NOT NULL,
+        operation_id TEXT NOT NULL,
+        payload TEXT NOT NULL,
+        result TEXT NOT NULL,
+        revision INTEGER NOT NULL CHECK (revision >= 0),
+        created_at TEXT NOT NULL,
+        UNIQUE (lifecycle_id, operation_id)
+      );
+      CREATE INDEX IF NOT EXISTS lifecycle_operations_revision
+        ON lifecycle_operations (lifecycle_id, revision);
+    `);
+    return operation(db);
+  });
+}
+
+export function readLifecycle(db: DatabaseSync, id: string): unknown {
+  const row = db.prepare('SELECT id, revision, state FROM lifecycle_records WHERE id = ?').get(id);
+  if (!row) throw new Error('lifecycle_not_found');
+  const parsedRow = lifecycleRowSchema.parse(row);
+  const state: unknown = JSON.parse(parsedRow.state);
+  return state;
+}
+
+export function readLifecycleIndex(db: DatabaseSync): { states: unknown[]; truncated: boolean } {
+  const rows = db.prepare('SELECT state FROM lifecycle_records ORDER BY id LIMIT 1001').all();
+  return {
+    states: rows
+      .slice(0, 1000)
+      .map((row) => JSON.parse(z.object({ state: z.string() }).parse(row).state)),
+    truncated: rows.length > 1000,
+  };
+}
+
+export function readLifecycleOperation(
+  db: DatabaseSync,
+  id: string,
+  operationId: string,
+): LifecycleOperation | null {
+  const row = db
+    .prepare(
+      'SELECT payload, result FROM lifecycle_operations WHERE lifecycle_id = ? AND operation_id = ?',
+    )
+    .get(id, operationId);
+  if (!row) return null;
+  const parsedRow = z.strictObject({ payload: z.string(), result: z.string() }).parse(row);
+  const result: unknown = JSON.parse(parsedRow.result);
+  return { payload: parsedRow.payload, result };
+}
+
+export function writeLifecycle(
+  db: DatabaseSync,
+  input: { id: string; state: unknown; revision: number; expectedRevision: number | null },
+): void {
+  const revision = z.number().int().min(0).safe().parse(input.revision);
+  const serializedState = JSON.stringify(input.state);
+  if (serializedState === undefined) throw new Error('invalid_lifecycle_state');
+
+  if (input.expectedRevision === null) {
+    if (revision !== 0) throw new Error('revision_conflict');
+    const result = db
+      .prepare(
+        'INSERT INTO lifecycle_records (id, revision, state) VALUES (?, ?, ?) ON CONFLICT(id) DO NOTHING',
+      )
+      .run(input.id, revision, serializedState);
+    if (Number(result.changes) !== 1) throw new Error('revision_conflict');
+    return;
+  }
+
+  const expectedRevision = z.number().int().min(0).safe().parse(input.expectedRevision);
+  if (revision !== expectedRevision + 1) throw new Error('revision_conflict');
+  const result = db
+    .prepare('UPDATE lifecycle_records SET revision = ?, state = ? WHERE id = ? AND revision = ?')
+    .run(revision, serializedState, input.id, expectedRevision);
+  if (Number(result.changes) !== 1) throw new Error('revision_conflict');
+}
+
+export function writeLifecycleOperation(
+  db: DatabaseSync,
+  input: {
+    id: string;
+    operationId: string;
+    payload: string;
+    result: unknown;
+    revision: number;
+    createdAt: string;
+  },
+): void {
+  const revision = z.number().int().min(0).safe().parse(input.revision);
+  try {
+    JSON.parse(input.payload);
+  } catch {
+    throw new Error('invalid_operation_payload');
+  }
+  const serializedResult = JSON.stringify(input.result);
+  if (serializedResult === undefined) throw new Error('invalid_operation_result');
+  const result = db
+    .prepare(`
+    INSERT INTO lifecycle_operations (lifecycle_id, operation_id, payload, result, revision, created_at)
+    SELECT ?, ?, ?, ?, ?, ?
+    WHERE EXISTS (SELECT 1 FROM lifecycle_records WHERE id = ? AND revision = ?)
+    ON CONFLICT (lifecycle_id, operation_id) DO NOTHING
+  `)
+    .run(
+      input.id,
+      input.operationId,
+      input.payload,
+      serializedResult,
+      revision,
+      input.createdAt,
+      input.id,
+      revision,
+    );
+  if (Number(result.changes) === 1) return;
+  const record = db.prepare('SELECT revision FROM lifecycle_records WHERE id = ?').get(input.id);
+  if (!record) throw new Error('lifecycle_not_found');
+  const parsedRecord = z.strictObject({ revision: z.number().int().nonnegative() }).parse(record);
+  if (parsedRecord.revision !== revision) throw new Error('revision_conflict');
+  throw new Error('operation_conflict');
+}
+
+export function finishLifecycleOperation(
+  db: DatabaseSync,
+  id: string,
+  operationId: string,
+  result: unknown,
+): void {
+  const serializedResult = JSON.stringify(result);
+  if (serializedResult === undefined) throw new Error('invalid_operation_result');
+  const row = db
+    .prepare('SELECT result FROM lifecycle_operations WHERE lifecycle_id = ? AND operation_id = ?')
+    .get(id, operationId);
+  if (!row) throw new Error('lifecycle_operation_not_found');
+  const current = z.strictObject({ result: z.string() }).parse(row);
+  const update = db
+    .prepare(`
+    UPDATE lifecycle_operations SET result = ?
+    WHERE lifecycle_id = ? AND operation_id = ? AND result = ?
+  `)
+    .run(serializedResult, id, operationId, current.result);
+  if (Number(update.changes) !== 1) throw new Error('lifecycle_operation_changed');
+}
+
+export function readLifecycleHistory(db: DatabaseSync, id: string): LifecycleHistoryRecord[] {
+  const rows = db
+    .prepare(`
+    SELECT operation_id, payload, result, revision, created_at
+    FROM lifecycle_operations
+    WHERE lifecycle_id = ?
+    ORDER BY revision DESC, operation_id DESC
+    LIMIT ?
+  `)
+    .all(id, maximumHistoryRows);
+  return rows
+    .map((row) => {
+      const parsedRow = operationRowSchema.parse(row);
+      const payload: unknown = JSON.parse(parsedRow.payload);
+      const result: unknown = JSON.parse(parsedRow.result);
+      return {
+        operationId: parsedRow.operation_id,
+        payload,
+        result,
+        revision: parsedRow.revision,
+        createdAt: parsedRow.created_at,
+      };
+    })
+    .reverse();
+}
diff --git a/packages/platform-mcp/src/services/CoordinationService.ts b/packages/platform-mcp/src/services/CoordinationService.ts
new file mode 100644
index 000000000..9c87c7d23
--- /dev/null
+++ b/packages/platform-mcp/src/services/CoordinationService.ts
@@ -0,0 +1,179 @@
+import { createHash } from 'node:crypto';
+import { readdirSync, readFileSync, realpathSync } from 'node:fs';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+import { z } from 'zod';
+import { coordinationRequestSchema, handleCoordination } from '../coordination.js';
+import {
+  coordinationChecks,
+  filterContextProjection,
+  listCoordinationTools,
+  runCoordinationCheck,
+  runPjcJourney,
+} from '../coordinationTools.js';
+import { lifecycleRequestSchema, lifecycleStateSchema } from '../lifecycle/model.js';
+import { executeLifecycleRequest } from '../lifecycle/runtime.js';
+import { readLifecycleIndex, withLifecycleStore } from '../lifecycle/store.js';
+import { ROOT_DIR } from '../utils/constants.js';
+
+const legacyCoordinationSchema = z.union([
+  coordinationRequestSchema,
+  z.strictObject({ action: z.literal('inventory') }),
+  z.strictObject({
+    action: z.literal('context'),
+    journeyId: z
+      .string()
+      .max(160)
+      .regex(/^[a-zA-Z0-9:_.-]+$/),
+    scope: z.enum(['local', 'interface', 'full']).optional(),
+    targetDomain: z.string().max(160).optional(),
+  }),
+]);
+
+export const developerCoordinationSchema = z.union([
+  legacyCoordinationSchema,
+  z.strictObject({ action: z.literal('lifecycle'), request: lifecycleRequestSchema }),
+]);
+
+export async function dispatchCoordinationRequest(
+  input: unknown,
+  options: { root?: string; databasePath?: string } = {},
+) {
+  const request = developerCoordinationSchema.parse(input);
+  return request.action === 'lifecycle'
+    ? executeLifecycleRequest(request.request, options)
+    : executeCoordinationRequest(request, options);
+}
+
+function catalogSources(root: string) {
+  const directory = path.join(root, 'packages/core/src/flows/pjc');
+  const files = readdirSync(directory)
+    .filter((name) => name.endsWith('.json'))
+    .map((name) => path.join(directory, name));
+  files.push(
+    path.join(root, 'scripts/pjc.ts'),
+    path.join(root, 'docs/architecture/model/gurudevi.c4'),
+    path.join(root, 'apps/sanctuary-api/src/modules/catalog.ts'),
+  );
+  return files.map((file) => {
+    const resolved = realpathSync(file);
+    const relative = path.relative(realpathSync(root), resolved);
+    if (relative.startsWith('..') || path.isAbsolute(relative))
+      throw new Error('Context source escapes workspace');
+    return {
+      path: relative.replaceAll('\\', '/'),
+      sha256: createHash('sha256').update(readFileSync(resolved)).digest('hex'),
+    };
+  });
+}
+
+export function executeCoordinationRequest(
+  input: unknown,
+  options: { root?: string; databasePath?: string } = {},
+) {
+  const request = legacyCoordinationSchema.parse(input);
+  const root = options.root ?? ROOT_DIR;
+  if (request.action === 'inventory')
+    return {
+      observedAt: new Date().toISOString(),
+      tools: listCoordinationTools(root),
+      checks: coordinationChecks,
+      lifecycles: withLifecycleStore(
+        options.databasePath ??
+          process.env.COORDINATION_STORE ??
+          path.join(root, '.agents/state/coordination.sqlite'),
+        (db) => {
+          const index = readLifecycleIndex(db);
+          return {
+            records: index.states.map((input) => {
+              const state = lifecycleStateSchema.parse(input);
+              return {
+                id: state.id,
+                goal: state.goal,
+                scope: state.scope,
+                recordedRevision: state.revision,
+                recordedTasks: state.tasks.map((task) => ({
+                  id: task.id,
+                  role: task.role,
+                  status: task.status,
+                })),
+              };
+            }),
+            truncated: index.truncated,
+            freshness: 'Not evaluated by inventory; retrieve lifecycle status before resuming.',
+          };
+        },
+      ),
+    };
+  if (request.action === 'context') {
+    const before = catalogSources(root);
+    const result = runPjcJourney(root, request.journeyId);
+    if (!result.ok)
+      return { status: 'unavailable', journeyId: request.journeyId, result, sources: before };
+    const rawProjection: unknown = JSON.parse(result.stdout);
+    const projection = filterContextProjection(rawProjection, {
+      scope: request.scope,
+      targetDomain: request.targetDomain,
+    });
+    const after = catalogSources(root);
+    return {
+      status: JSON.stringify(before) === JSON.stringify(after) ? 'observed' : 'stale',
+      journeyId: request.journeyId,
+      scope: request.scope ?? 'full',
+      ...(request.targetDomain ? { targetDomain: request.targetDomain } : {}),
+      projection,
+      sources: before,
+      coverageGaps: [
+        'PJC links are declarations; this reader does not establish execution or semantic correctness.',
+        'C4 and capability catalog hashes identify adjacent sources; their relationships are not automatically joined to this journey.',
+        'Chat history, external decisions, inaccessible sources and unregistered relationships are not searched by this projection.',
+      ],
+    };
+  }
+  return handleCoordination(request, {
+    root,
+    databasePath:
+      options.databasePath ??
+      process.env.COORDINATION_STORE ??
+      path.join(root, '.agents/state/coordination.sqlite'),
+    checks: coordinationChecks,
+    procedureRevision: createHash('sha256')
+      .update(readFileSync(new URL(import.meta.url)))
+      .update(
+        readFileSync(
+          new URL(
+            `../coordinationTools${path.extname(fileURLToPath(import.meta.url))}`,
+            import.meta.url,
+          ),
+        ),
+      )
+      .update(
+        readFileSync(
+          new URL(
+            `../utils/execution${path.extname(fileURLToPath(import.meta.url))}`,
+            import.meta.url,
+          ),
+        ),
+      )
+      .update(readFileSync(path.join(root, 'pnpm-lock.yaml')))
+      .update(
+        JSON.stringify(
+          [
+            'scripts/pjc.ts',
+            'scripts/audit-api-composition.mjs',
+            'scripts/check-ui-boundaries.mjs',
+            'scripts/lint-new-migrations.mjs',
+            'scripts/harmonize-dependencies.mjs',
+            'apps/sanctuary-api/scripts/capability-conformance.ts',
+          ].map((file) => ({
+            path: file,
+            sha256: createHash('sha256')
+              .update(readFileSync(path.join(root, file)))
+              .digest('hex'),
+          })),
+        ),
+      )
+      .digest('hex'),
+    runCheck: (id) => runCoordinationCheck(root, id),
+  });
+}
diff --git a/packages/platform-mcp/src/coordination.ts b/packages/platform-mcp/src/coordination.ts
new file mode 100644
index 000000000..12cb56187
--- /dev/null
+++ b/packages/platform-mcp/src/coordination.ts
@@ -0,0 +1,523 @@
+import { createHash } from 'node:crypto';
+import { readFileSync, realpathSync, statSync } from 'node:fs';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+import { z } from 'zod';
+import {
+  readAllChanges,
+  readChange,
+  readEvents,
+  transaction,
+  withStore,
+} from './coordinationStore.js';
+
+const text = z.string().trim().min(1).max(4000);
+const identifier = z.string().regex(/^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$/);
+export type CoordinationImpact =
+  | 'product'
+  | 'architecture'
+  | 'database'
+  | 'api'
+  | 'web'
+  | 'native'
+  | 'dependencies'
+  | 'integration'
+  | 'security';
+
+export interface DomainCapacity {
+  readonly maxWip: number;
+  readonly targetVerificationMs: number;
+}
+
+export const DOMAIN_CAPACITIES: Record<CoordinationImpact, DomainCapacity> = {
+  api: { maxWip: 4, targetVerificationMs: 15_000 },
+  native: { maxWip: 3, targetVerificationMs: 30_000 },
+  web: { maxWip: 4, targetVerificationMs: 15_000 },
+  database: { maxWip: 2, targetVerificationMs: 45_000 },
+  security: { maxWip: 2, targetVerificationMs: 30_000 },
+  dependencies: { maxWip: 3, targetVerificationMs: 20_000 },
+  architecture: { maxWip: 3, targetVerificationMs: 25_000 },
+  product: { maxWip: 5, targetVerificationMs: 10_000 },
+  integration: { maxWip: 3, targetVerificationMs: 30_000 },
+};
+
+export interface CoordinationWip {
+  readonly globalActiveCount: number;
+  readonly domainCounts: Record<CoordinationImpact, number>;
+  readonly saturatedDomains: readonly CoordinationImpact[];
+  readonly activeCount: number;
+  readonly maxWip: number;
+  readonly saturated: boolean;
+  readonly warning?: string;
+}
+
+const impacts = z.enum([
+  'product',
+  'architecture',
+  'database',
+  'api',
+  'web',
+  'native',
+  'dependencies',
+  'integration',
+  'security',
+]);
+const source = z.strictObject({ path: text, scope: text });
+const link = z.strictObject({
+  subject: text,
+  predicate: text,
+  object: text,
+  sourcePath: text,
+  classification: z.enum(['declared', 'mechanically-extracted', 'inferred', 'unresolved']),
+});
+export const coordinationRequestSchema = z.discriminatedUnion('action', [
+  z.strictObject({
+    action: z.literal('create'),
+    id: identifier,
+    goal: text,
+    impacts: z.array(impacts).min(1).max(9),
+    sources: z.array(source).min(1).max(100),
+    links: z.array(link).max(500).optional(),
+    force: z.boolean().optional(),
+    bypassWipCheck: z.boolean().optional(),
+  }),
+  z.strictObject({ action: z.literal('status'), id: identifier }),
+  z.strictObject({
+    action: z.literal('record'),
+    id: identifier,
+    actionId: identifier,
+    stage: z.enum(['analysis', 'reconciliation']),
+    notes: text,
+    evidencePaths: z.array(text).min(1).max(100),
+    unresolved: z.array(text).max(100),
+  }),
+  z.strictObject({
+    action: z.literal('check'),
+    id: identifier,
+    actionId: identifier,
+    checkId: identifier,
+  }),
+]);
+const changeSchema = z.strictObject({
+  id: identifier,
+  goal: text,
+  impacts: z.array(impacts),
+  sources: z.array(source.extend({ sha256: z.string() })),
+  links: z.array(link),
+  requiredChecks: z.array(identifier),
+  procedureVersion: z.literal('1'),
+  procedureRevision: text,
+});
+const checkResultSchema = z.strictObject({
+  ok: z.boolean(),
+  stdout: z.string(),
+  stderr: z.string(),
+  exitCode: z.number().nullable(),
+  error: z.string().optional(),
+});
+const eventSchema = z.strictObject({
+  actionId: identifier,
+  payload: z.string(),
+  observedAt: z.iso.datetime(),
+  finishedAt: z.iso.datetime().optional(),
+  stage: z.enum(['analysis', 'reconciliation', 'check']),
+  evidencePaths: z.array(z.string()),
+  unresolved: z.array(z.string()),
+  checkId: identifier.optional(),
+  result: checkResultSchema.optional(),
+  state: z.enum(['recorded', 'pending', 'finished', 'stale']),
+});
+type Change = z.infer<typeof changeSchema>;
+type Event = z.infer<typeof eventSchema>;
+type Options = {
+  root: string;
+  databasePath: string;
+  procedureRevision?: string;
+  maxWip?: number;
+  checks: readonly { id: string; impacts: readonly string[] }[];
+  runCheck: (id: string) => {
+    ok: boolean;
+    stdout: string;
+    stderr: string;
+    exitCode: number | null;
+    error?: string;
+  };
+};
+const hash = (data: string | Buffer) => createHash('sha256').update(data).digest('hex');
+export function fingerprint(root: string, file: string): string {
+  if (
+    path.isAbsolute(file) ||
+    file
+      .split(/[\\/]/)
+      .some(
+        (part) =>
+          part === '..' ||
+          /^\.env(?:\.|$)/i.test(part) ||
+          /^(?:secrets?|credentials?)$/i.test(part),
+      ) ||
+    /\.(?:pem|key|p12|pfx)$/i.test(file)
+  )
+    throw new Error('invalid_source_path');
+  const base = realpathSync(root);
+  const resolved = realpathSync(path.resolve(base, file));
+  const relative = path.relative(base, resolved);
+  if (
+    !relative ||
+    relative.startsWith('..') ||
+    path.isAbsolute(relative) ||
+    relative
+      .split(/[\\/]/)
+      .some(
+        (part) =>
+          /^\.env(?:\.|$)/i.test(part) ||
+          /^(?:\.git|node_modules|secrets?|credentials?|\.doppler)$/i.test(part),
+      ) ||
+    /\.(?:pem|key|p12|pfx)$/i.test(relative) ||
+    !statSync(resolved).isFile()
+  )
+    throw new Error('invalid_source_path');
+  return hash(readFileSync(resolved));
+}
+function staleSources(change: Change, root: string): string[] {
+  return change.sources
+    .filter((item) => {
+      try {
+        return fingerprint(root, item.path) !== item.sha256;
+      } catch {
+        return true;
+      }
+    })
+    .map((item) => item.path);
+}
+function revision(options: Options): string {
+  const modulePath = fileURLToPath(import.meta.url);
+  const storePath = path.join(
+    path.dirname(modulePath),
+    `coordinationStore${path.extname(modulePath)}`,
+  );
+  const checks = [...options.checks]
+    .map((item) => ({ id: item.id, impacts: [...item.impacts].sort() }))
+    .sort((a, b) => a.id.localeCompare(b.id));
+  return hash(
+    JSON.stringify({
+      core: hash(readFileSync(modulePath)),
+      store: hash(readFileSync(storePath)),
+      checks,
+      external: options.procedureRevision ?? null,
+    }),
+  );
+}
+function computeDomainCounts(changes: readonly Change[]): Record<CoordinationImpact, number> {
+  const counts: Record<CoordinationImpact, number> = {
+    api: 0,
+    native: 0,
+    web: 0,
+    database: 0,
+    security: 0,
+    dependencies: 0,
+    architecture: 0,
+    product: 0,
+    integration: 0,
+  };
+  for (const c of changes) {
+    for (const impact of c.impacts) {
+      counts[impact] = (counts[impact] ?? 0) + 1;
+    }
+  }
+  return counts;
+}
+
+function getSaturatedDomains(
+  domainCounts: Record<CoordinationImpact, number>,
+  customMaxWip?: number,
+): CoordinationImpact[] {
+  const domains = Object.keys(DOMAIN_CAPACITIES) as CoordinationImpact[];
+  return domains.filter((domain) => {
+    const cap = customMaxWip ?? DOMAIN_CAPACITIES[domain].maxWip;
+    return domainCounts[domain] >= cap;
+  });
+}
+
+function state(
+  change: Change,
+  events: Event[],
+  root: string,
+  currentRevision: string,
+  wip?: CoordinationWip,
+) {
+  const stale = staleSources(change, root);
+  const unresolved = [...new Set(events.flatMap((event) => event.unresolved))];
+  const analysis = events.some((event) => event.stage === 'analysis');
+  const passed = change.requiredChecks.filter((id) => {
+    const event = [...events]
+      .reverse()
+      .find((item) => item.stage === 'check' && item.checkId === id);
+    return (
+      event?.state === 'finished' &&
+      event.result?.ok === true &&
+      event.result.exitCode === 0 &&
+      !event.result.error
+    );
+  });
+  const missingChecks = change.requiredChecks.filter((id) => !passed.includes(id));
+  const lastReconciliation = events.map((event) => event.stage).lastIndexOf('reconciliation');
+  const lastWork = events.reduce(
+    (index, event, current) =>
+      event.stage === 'analysis' || event.stage === 'check' ? current : index,
+    -1,
+  );
+  const reconciled = lastReconciliation > lastWork;
+  const readiness =
+    currentRevision !== change.procedureRevision ||
+    stale.length ||
+    unresolved.length ||
+    !analysis ||
+    missingChecks.length ||
+    !reconciled
+      ? 'blocked'
+      : 'ready-for-review';
+  return {
+    change,
+    events,
+    staleSources: stale,
+    procedureChanged: currentRevision !== change.procedureRevision,
+    unresolved,
+    missingChecks,
+    readiness,
+    feedback: readiness === 'ready-for-review' ? 'verified' : 'pending_verification',
+    wip,
+    limitation:
+      'Local records are not authenticated, tamper-proof, or proof of product completion. Source changes require a new change ID and reconsideration; no automatic rebase.',
+  };
+}
+export function handleCoordination(input: unknown, options: Options) {
+  const request = coordinationRequestSchema.parse(input);
+  return withStore(options.databasePath, (db) => {
+    if (request.action === 'create')
+      return transaction(db, () => {
+        if (
+          new Set(request.sources.map((item) => item.path)).size !== request.sources.length ||
+          new Set(request.impacts).size !== request.impacts.length
+        )
+          throw new Error('duplicate_input');
+        const sources = request.sources.map((item) => ({
+          ...item,
+          sha256: fingerprint(options.root, item.path),
+        }));
+        if (
+          (request.links ?? []).some(
+            (item) => !sources.some((entry) => entry.path === item.sourcePath),
+          )
+        )
+          throw new Error('unknown_link_source');
+        if (
+          request.impacts.some(
+            (impact) => !options.checks.some((check) => check.impacts.includes(impact)),
+          )
+        )
+          throw new Error('uncovered_impact');
+        const requiredChecks = options.checks
+          .filter((check) =>
+            check.impacts.some((impact) => request.impacts.includes(impacts.parse(impact))),
+          )
+          .map((check) => identifier.parse(check.id));
+        if (new Set(requiredChecks).size !== requiredChecks.length)
+          throw new Error('duplicate_check');
+        const bypassWip = Boolean(request.force || request.bypassWipCheck);
+        const existingChanges = readAllChanges(db).map((c) => changeSchema.parse(c));
+        const activeUnverified = existingChanges.filter((c) => {
+          const ev = readEvents(db, c.id).map((e) => eventSchema.parse(e));
+          return state(c, ev, options.root, revision(options)).readiness !== 'ready-for-review';
+        });
+
+        if (!bypassWip) {
+          for (const domain of request.impacts) {
+            const domainMaxWip = options.maxWip ?? DOMAIN_CAPACITIES[domain].maxWip;
+            const activeInDomain = activeUnverified.filter((c) => c.impacts.includes(domain));
+            const domainChanges = existingChanges.filter((c) => c.impacts.includes(domain));
+            const latestChangeInDomain = domainChanges.at(-1);
+            let latestHasUnresolvedChecks = false;
+            if (latestChangeInDomain) {
+              const prevEvents = readEvents(db, latestChangeInDomain.id).map((e) =>
+                eventSchema.parse(e),
+              );
+              const prevState = state(
+                latestChangeInDomain,
+                prevEvents,
+                options.root,
+                revision(options),
+              );
+              latestHasUnresolvedChecks = prevState.missingChecks.length > 0;
+            }
+
+            if (activeInDomain.length >= domainMaxWip || latestHasUnresolvedChecks) {
+              throw new Error(
+                `WIP_SATURATION: Domain '${domain}' verification capacity saturated (R_gen > R_ver); resolve or reconcile pending changes in '${domain}' before initiating new changes`,
+              );
+            }
+          }
+        }
+        const change = changeSchema.parse({
+          id: request.id,
+          goal: request.goal,
+          impacts: request.impacts,
+          sources,
+          links: request.links ?? [],
+          requiredChecks,
+          procedureVersion: '1',
+          procedureRevision: revision(options),
+        });
+        db.prepare('INSERT INTO changes(id, data) VALUES (?, ?)').run(
+          request.id,
+          JSON.stringify(change),
+        );
+        const allActive = [...activeUnverified, change];
+        const globalActiveCount = allActive.length;
+        const domainCounts = computeDomainCounts(allActive);
+        const saturatedDomains = getSaturatedDomains(domainCounts, options.maxWip);
+        const saturated = saturatedDomains.length > 0;
+        const warning = saturated
+          ? `WIP_SATURATION: Domain '${saturatedDomains.join(', ')}' verification capacity saturated (R_gen > R_ver); resolve or reconcile pending changes in '${saturatedDomains.join(', ')}' before initiating new changes`
+          : undefined;
+
+        return state(change, [], options.root, revision(options), {
+          globalActiveCount,
+          domainCounts,
+          saturatedDomains,
+          activeCount: globalActiveCount,
+          maxWip: options.maxWip ?? 5,
+          saturated,
+          ...(warning ? { warning } : {}),
+        });
+      });
+    const get = () => ({
+      change: changeSchema.parse(readChange(db, request.id)),
+      events: readEvents(db, request.id).map((event) => eventSchema.parse(event)),
+    });
+    if (request.action === 'status') {
+      const { change, events } = get();
+      const existingChanges = readAllChanges(db).map((c) => changeSchema.parse(c));
+      const activeUnverified = existingChanges.filter((c) => {
+        const ev = readEvents(db, c.id).map((e) => eventSchema.parse(e));
+        return state(c, ev, options.root, revision(options)).readiness !== 'ready-for-review';
+      });
+      const globalActiveCount = activeUnverified.length;
+      const domainCounts = computeDomainCounts(activeUnverified);
+      const saturatedDomains = getSaturatedDomains(domainCounts, options.maxWip);
+      const saturated = saturatedDomains.length > 0;
+      const warning = saturated
+        ? `WIP_SATURATION: Domain '${saturatedDomains.join(', ')}' verification capacity saturated (R_gen > R_ver); resolve or reconcile pending changes in '${saturatedDomains.join(', ')}' before initiating new changes`
+        : undefined;
+
+      return state(change, events, options.root, revision(options), {
+        globalActiveCount,
+        domainCounts,
+        saturatedDomains,
+        activeCount: globalActiveCount,
+        maxWip: options.maxWip ?? 5,
+        saturated,
+        ...(warning ? { warning } : {}),
+      });
+    }
+    const payload = JSON.stringify(request);
+    const prepared = transaction(db, () => {
+      const { change, events } = get();
+      const existing = events.find((event) => event.actionId === request.actionId);
+      if (existing) {
+        if (existing.payload !== payload) throw new Error('action_id_conflict');
+        return { change, events, duplicate: true };
+      }
+      const current = state(change, events, options.root, revision(options));
+      if (current.staleSources.length) throw new Error('stale_sources');
+      if (current.procedureChanged) throw new Error('procedure_changed');
+      if (request.action === 'record') {
+        if (
+          request.evidencePaths.some((file) => !change.sources.some((entry) => entry.path === file))
+        )
+          throw new Error('unknown_evidence');
+        if (
+          request.stage === 'reconciliation' &&
+          (!events.some((event) => event.stage === 'analysis') ||
+            current.missingChecks.length ||
+            current.unresolved.length ||
+            request.unresolved.length)
+        )
+          throw new Error('missing_prerequisite');
+        const event: Event = {
+          actionId: request.actionId,
+          payload,
+          observedAt: new Date().toISOString(),
+          finishedAt: new Date().toISOString(),
+          stage: request.stage,
+          evidencePaths: request.evidencePaths,
+          unresolved: request.unresolved,
+          state: 'recorded',
+        };
+        db.prepare('INSERT INTO events(change_id, action_id, data) VALUES (?, ?, ?)').run(
+          request.id,
+          event.actionId,
+          JSON.stringify(event),
+        );
+        return { change, events: [...events, event], duplicate: false };
+      }
+      if (
+        !events.some((event) => event.stage === 'analysis') ||
+        !change.requiredChecks.includes(request.checkId)
+      )
+        throw new Error('missing_prerequisite');
+      if (!options.checks.some((check) => check.id === request.checkId))
+        throw new Error('check_unavailable');
+      const event: Event = {
+        actionId: request.actionId,
+        payload,
+        observedAt: new Date().toISOString(),
+        stage: 'check',
+        checkId: request.checkId,
+        evidencePaths: [],
+        unresolved: [],
+        state: 'pending',
+      };
+      db.prepare('INSERT INTO events(change_id, action_id, data) VALUES (?, ?, ?)').run(
+        request.id,
+        event.actionId,
+        JSON.stringify(event),
+      );
+      return { change, events: [...events, event], duplicate: false };
+    });
+    if (request.action !== 'check' || prepared.duplicate)
+      return {
+        ...state(prepared.change, prepared.events, options.root, revision(options)),
+        duplicate: prepared.duplicate,
+      };
+    const result = checkResultSchema.parse(options.runCheck(request.checkId));
+    return transaction(db, () => {
+      const { change, events } = get();
+      const pending = events.find((event) => event.actionId === request.actionId);
+      if (!pending || pending.state !== 'pending') throw new Error('check_state_conflict');
+      const event: Event = {
+        ...pending,
+        result,
+        finishedAt: new Date().toISOString(),
+        state:
+          staleSources(change, options.root).length ||
+          revision(options) !== change.procedureRevision
+            ? 'stale'
+            : 'finished',
+      };
+      db.prepare('UPDATE events SET data = ? WHERE change_id = ? AND action_id = ?').run(
+        JSON.stringify(event),
+        request.id,
+        request.actionId,
+      );
+      return {
+        ...state(
+          change,
+          events.map((item) => (item.actionId === event.actionId ? event : item)),
+          options.root,
+          revision(options),
+        ),
+        duplicate: false,
+      };
+    });
+  });
+}
