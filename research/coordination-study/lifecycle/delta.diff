+    reducer: (_prior, next) => next,
+    default: () => null,
+  }),
+  duplicate: Annotation<boolean>({ reducer: (_prior, next) => next, default: () => false }),
+  result: Annotation<ReturnType<typeof runCoordinationCheck> | null>({
