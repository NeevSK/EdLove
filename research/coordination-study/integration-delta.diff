@@ -0,0 +1,119 @@
+import { execFileSync } from 'node:child_process';
+import { mkdtempSync } from 'node:fs';
+import os from 'node:os';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+import { Client } from '@modelcontextprotocol/client';
+import { getDefaultEnvironment, StdioClientTransport } from '@modelcontextprotocol/client/stdio';
+import { expect, it } from 'vitest';
+import { z } from 'zod';
+
+const workspace = fileURLToPath(new URL('../../../', import.meta.url));
+const compiled = process.env.COORDINATION_TEST_COMPILED === '1';
+const runtimeArgs = compiled ? [] : ['--import', 'tsx'];
+const entrypoint = (name: string) =>
+  path.join(workspace, 'packages/platform-mcp', compiled ? `dist/${name}.js` : `src/${name}.ts`);
+const responseSchema = z.object({
+  content: z.array(z.object({ type: z.literal('text'), text: z.string() })),
+  isError: z.boolean().optional(),
+});
+
+it('shares a persistent change between the real CLI and MCP gateway without activating downstreams or skill sync', {
+  timeout: 60000,
+}, async () => {
+  const store = path.join(
+    mkdtempSync(path.join(os.tmpdir(), 'coordination-gateway-')),
+    'state.sqlite',
+  );
+  const cli = (request: unknown): unknown =>
+    JSON.parse(
+      execFileSync(
+        process.execPath,
+        [...runtimeArgs, entrypoint('cli/coordination'), '-', '--store', store],
+        { cwd: workspace, input: JSON.stringify(request), encoding: 'utf8', timeout: 20000 },
+      ),
+    );
+  const source = 'docs/architecture/model/gurudevi.c4';
+  expect(
+    cli({
+      action: 'create',
+      id: 'gateway-check',
+      goal: 'Validate declared architecture',
+      impacts: ['architecture'],
+      sources: [{ path: source, scope: 'C4 model only' }],
+    }),
+  ).toMatchObject({ readiness: 'blocked' });
+  const client = new Client({ name: 'coordination-integration-test', version: '1.0.0' });
+  const transport = new StdioClientTransport({
+    command: process.execPath,
+    args: [...runtimeArgs, entrypoint('index')],
+    cwd: workspace,
+    env: {
+      ...getDefaultEnvironment(),
+      MCP_MODE: 'GATEWAY',
+      PLATFORM_MCP_SKIP_DOWNSTREAM: '1',
+      PLATFORM_MCP_SKIP_SKILL_SYNC: '1',
+      COORDINATION_STORE: store,
+    },
+    stderr: 'pipe',
+  });
+  try {
+    await client.connect(transport);
+    expect((await client.listTools()).tools.map((tool) => tool.name)).toContain(
+      'sovereign_coordination',
+    );
+    const call = async (request: unknown): Promise<unknown> => {
+      const result = responseSchema.parse(
+        await client.callTool({ name: 'sovereign_coordination', arguments: { request } }),
+      );
+      expect(result.isError, JSON.stringify(result.content)).not.toBe(true);
+      const text = result.content[0]?.text;
+      if (!text) throw new Error('Missing coordination response');
+      return JSON.parse(text);
+    };
+    expect(await call({ action: 'status', id: 'gateway-check' })).toMatchObject({
+      change: { id: 'gateway-check' },
+      readiness: 'blocked',
+    });
+    const analysis = {
+      action: 'record',
+      id: 'gateway-check',
+      actionId: 'analysis',
+      stage: 'analysis',
+      notes: 'Declared C4 model only; runtime alignment unverified.',
+      evidencePaths: [source],
+      unresolved: [],
+    };
+    await call(analysis);
+    expect(
+      cli({ action: 'check', id: 'gateway-check', actionId: 'c4', checkId: 'c4-validate' }),
+    ).toMatchObject({ missingChecks: [] });
+    expect(await call({ ...analysis, actionId: 'review', stage: 'reconciliation' })).toMatchObject({
+      readiness: 'ready-for-review',
+    });
+    expect(cli({ action: 'status', id: 'gateway-check' })).toMatchObject({
+      readiness: 'ready-for-review',
+    });
+    expect(
+      await call({ action: 'context', journeyId: 'journey:api.secure_operations' }),
+    ).toMatchObject({ status: 'observed', journeyId: 'journey:api.secure_operations' });
+    const rejected = await client.callTool({
+      name: 'sovereign_coordination',
+      arguments: {
+        request: {
+          action: 'record',
+          id: 'gateway-check',
+          actionId: 'forged',
+          stage: 'analysis',
+          notes: 'Forged',
+          evidencePaths: [source],
+          unresolved: [],
+          result: { ok: true },
+        },
+      },
+    });
+    expect(rejected.isError).toBe(true);
+  } finally {
+    await client.close();
+  }
+});
diff --git a/packages/platform-mcp/src/services/CoordinationService.ts b/packages/platform-mcp/src/services/CoordinationService.ts
new file mode 100644
index 000000000..2a18211c3
--- /dev/null
+++ b/packages/platform-mcp/src/services/CoordinationService.ts
@@ -0,0 +1,126 @@
+import { createHash } from 'node:crypto';
+import { readdirSync, readFileSync, realpathSync } from 'node:fs';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+import { z } from 'zod';
+import { coordinationRequestSchema, handleCoordination } from '../coordination.js';
+import {
+  coordinationChecks,
+  listCoordinationTools,
+  runCoordinationCheck,
+  runPjcJourney,
+} from '../coordinationTools.js';
+import { ROOT_DIR } from '../utils/constants.js';
+
+export const developerCoordinationSchema = z.union([
+  coordinationRequestSchema,
+  z.strictObject({ action: z.literal('inventory') }),
+  z.strictObject({
+    action: z.literal('context'),
+    journeyId: z
+      .string()
+      .max(160)
+      .regex(/^[a-zA-Z0-9:_.-]+$/),
+  }),
+]);
+
+function catalogSources(root: string) {
+  const directory = path.join(root, 'packages/core/src/flows/pjc');
+  const files = readdirSync(directory)
+    .filter((name) => name.endsWith('.json'))
+    .map((name) => path.join(directory, name));
+  files.push(
+    path.join(root, 'scripts/pjc.ts'),
+    path.join(root, 'docs/architecture/model/gurudevi.c4'),
+    path.join(root, 'apps/sanctuary-api/src/modules/catalog.ts'),
+  );
+  return files.map((file) => {
+    const resolved = realpathSync(file);
+    const relative = path.relative(realpathSync(root), resolved);
+    if (relative.startsWith('..') || path.isAbsolute(relative))
+      throw new Error('Context source escapes workspace');
+    return {
+      path: relative.replaceAll('\\', '/'),
+      sha256: createHash('sha256').update(readFileSync(resolved)).digest('hex'),
+    };
+  });
+}
+
+export function executeCoordinationRequest(
+  input: unknown,
+  options: { root?: string; databasePath?: string } = {},
+) {
+  const request = developerCoordinationSchema.parse(input);
+  const root = options.root ?? ROOT_DIR;
+  if (request.action === 'inventory')
+    return {
+      observedAt: new Date().toISOString(),
+      tools: listCoordinationTools(root),
+      checks: coordinationChecks,
+    };
+  if (request.action === 'context') {
+    const before = catalogSources(root);
+    const result = runPjcJourney(root, request.journeyId);
+    if (!result.ok)
+      return { status: 'unavailable', journeyId: request.journeyId, result, sources: before };
+    const projection: unknown = JSON.parse(result.stdout);
+    const after = catalogSources(root);
+    return {
+      status: JSON.stringify(before) === JSON.stringify(after) ? 'observed' : 'stale',
+      journeyId: request.journeyId,
+      projection,
+      sources: before,
+      coverageGaps: [
+        'PJC links are declarations; this reader does not establish execution or semantic correctness.',
+        'C4 and capability catalog hashes identify adjacent sources; their relationships are not automatically joined to this journey.',
+        'Chat history, external decisions, inaccessible sources and unregistered relationships are not searched by this projection.',
+      ],
+    };
+  }
+  return handleCoordination(request, {
+    root,
+    databasePath:
+      options.databasePath ??
+      process.env.COORDINATION_STORE ??
+      path.join(root, '.agents/state/coordination.sqlite'),
+    checks: coordinationChecks,
+    procedureRevision: createHash('sha256')
+      .update(readFileSync(new URL(import.meta.url)))
+      .update(
+        readFileSync(
+          new URL(
+            `../coordinationTools${path.extname(fileURLToPath(import.meta.url))}`,
+            import.meta.url,
+          ),
+        ),
+      )
+      .update(
+        readFileSync(
+          new URL(
+            `../utils/execution${path.extname(fileURLToPath(import.meta.url))}`,
+            import.meta.url,
+          ),
+        ),
+      )
+      .update(readFileSync(path.join(root, 'pnpm-lock.yaml')))
+      .update(
+        JSON.stringify(
+          [
+            'scripts/pjc.ts',
+            'scripts/audit-api-composition.mjs',
+            'scripts/check-ui-boundaries.mjs',
+            'scripts/lint-new-migrations.mjs',
+            'scripts/harmonize-dependencies.mjs',
+            'apps/sanctuary-api/scripts/capability-conformance.ts',
+          ].map((file) => ({
+            path: file,
+            sha256: createHash('sha256')
+              .update(readFileSync(path.join(root, file)))
+              .digest('hex'),
+          })),
+        ),
+      )
+      .digest('hex'),
+    runCheck: (id) => runCoordinationCheck(root, id),
+  });
+}
diff --git a/packages/platform-mcp/src/cli/coordination.ts b/packages/platform-mcp/src/cli/coordination.ts
