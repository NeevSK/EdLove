---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="Studio | Intuitui Labs">
	<div class="space-y-12">
		<div class="space-y-4">
			<p class="mono-label">Professional Practice</p>
			<h1 class="text-5xl font-bold tracking-tighter">The Studio Model</h1>
		</div>

		<div class="grid grid-cols-1 md:grid-cols-2 gap-24">
			<div class="space-y-8">
				<p class="text-xl text-brand-secondary">
					Intuitui Labs operates as a service gateway for systems intelligence. We partner with organizations to audit workflows, map complexities, and design humane transitions.
				</p>
				<div class="space-y-4">
					<h2 class="mono-label !opacity-100">Core Services</h2>
					<ul class="space-y-2 text-sm text-brand-secondary">
						<li>• Systems Audit & Workflow Mapping</li>
						<li>• Humane AI Integration</li>
						<li>• Digital Transformation Frameworks</li>
						<li>• Knowledge Infrastructure Design</li>
					</ul>
				</div>
			</div>
			<div class="bg-black text-white p-12 space-y-6">
				<h2 class="text-2xl font-bold">Inquiries</h2>
				<p class="text-sm opacity-70">
					We seek partnerships with founders, educators, and policy makers who value clarity and dignity over sheer speed.
				</p>
				<div class="pt-4">
					<p class="mono-label text-white opacity-40">Direct Contact</p>
					<p class="font-mono text-sm underline decoration-white/20 underline-offset-4">hello@intuituilabs.lk</p>
				</div>
			</div>
		</div>
	</div>
</MainLayout>
