---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="Projects | Intuitui Labs" theme="projects">
	<div class="space-y-12">
		<div class="space-y-4">
			<p class="mono-label">Innovation Lab</p>
			<h1 class="text-5xl font-bold tracking-tighter">Intervention Design & Prototypes</h1>
		</div>
		
		<div class="aspect-[21/9] bg-black/[0.02] border border-dashed border-black/10 flex flex-col items-center justify-center space-y-4">
			<div class="w-12 h-12 border border-black/10 rounded-full animate-spin border-t-black/40"></div>
			<p class="mono-label opacity-30 italic">Project index arriving in Phase 1.2</p>
		</div>

		<div class="grid grid-cols-1 md:grid-cols-2 gap-12">
			<div class="p-8 border border-black/5 space-y-4">
				<h2 class="text-xl font-bold">Micro-Prototypes</h2>
				<p class="text-sm text-brand-secondary">Lightweight AI tools and workflow helpers developed for specific sectoral bottlenecks.</p>
			</div>
			<div class="p-8 border border-black/5 space-y-4">
				<h2 class="text-xl font-bold">Flagship Interventions</h2>
				<p class="text-sm text-brand-secondary">Long-term systems design projects aimed at national-level impact.</p>
			</div>
		</div>
	</div>
</MainLayout>
