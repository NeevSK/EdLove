---
import '../styles/global.css';
import {
  defaultOgImage,
  ORGANIZATION,
  SITE_DESCRIPTION,
  SITE_NAME,
  SITE_TITLE,
  SITE_URL,
  SITE_KEYWORDS,
} from '../lib/site';
import StructuredData from '../components/StructuredData.astro';

interface Props {
  title?: string;
  description?: string;
  theme?: 'home' | 'about' | 'projects' | 'studio' | 'default';
  image?: string;
  noindex?: boolean;
  structuredData?: Record<string, any> | Array<Record<string, any>>;
}

const {
  title = SITE_TITLE,
  description = SITE_DESCRIPTION,
  theme = 'default',
  image,
  noindex = false,
  structuredData = [],
} = Astro.props;

const canonical = Astro.url.href;
const _ogImage = image ?? defaultOgImage(Astro.url.pathname);
const _robotsContent = noindex ? 'noindex, nofollow' : 'index, follow';
const _baseStructuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    ...ORGANIZATION,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE_NAME,
    url: SITE_URL,
    description: SITE_DESCRIPTION,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: title,
    description,
    url: canonical,
    isPartOf: {
      '@type': 'WebSite',
      name: SITE_NAME,
      url: SITE_URL,
    },
  },
]
  .concat(Array.isArray(structuredData) ? structuredData : [structuredData])
  .filter(Boolean);

// Theme-specific background configurations with parallax weights
const themes = {
  home: [
    {
      color: 'bg-brand-sky/5',
      shape: 'w-[70%] h-[80%] -top-[20%] -left-[10%] -rotate-12',
      parallax: 0.1,
    },
    {
      color: 'bg-brand-leaf/5',
      shape: 'w-[60%] h-[70%] -bottom-[20%] -right-[10%] rotate-6',
      parallax: -0.15,
    },
    {
      color: 'bg-brand-sky/3',
      shape: 'w-[40%] h-[50%] top-1/4 left-1/2 -rotate-45',
      parallax: 0.05,
    },
  ],
  about: [
    {
      color: 'bg-brand-leaf/3',
      shape: 'w-[100%] h-[40%] -top-[10%] left-0 rotate-2',
      parallax: 0.2,
    },
    {
      color: 'bg-brand-primary/2',
      shape: 'w-[50%] h-[100%] top-0 -left-[10%] -rotate-6',
      parallax: -0.1,
    },
    {
      color: 'bg-brand-leaf/5',
      shape: 'w-[30%] h-[30%] bottom-20 right-20 rotate-45',
      parallax: 0.3,
    },
  ],
  projects: [
    {
      color: 'bg-brand-sky/10',
      shape: 'w-[120%] h-[30%] top-[40%] -left-[10%] rotate-12',
      parallax: 0.15,
    },
    {
      color: 'bg-brand-primary/5',
      shape: 'w-[40%] h-[80%] -top-[10%] right-[10%] -rotate-12',
      parallax: -0.05,
    },
  ],
  studio: [
    {
      color: 'bg-brand-primary/5',
      shape: 'w-[100%] h-[1px] top-1/4 left-0 rotate-1',
      parallax: 0.4,
    },
    {
      color: 'bg-brand-primary/5',
      shape: 'w-[100%] h-[1px] top-2/3 left-0 -rotate-1',
      parallax: 0.6,
    },
    { color: 'bg-brand-sky/5', shape: 'w-[30%] h-[60%] top-0 right-0 -rotate-12', parallax: 0.2 },
  ],
  default: [],
};

const _currentBackground = themes[theme] || themes.default;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="robots" content={_robotsContent} />
		<meta name="keywords" content={SITE_KEYWORDS.join(', ')} />
		<link rel="canonical" href={canonical} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={SITE_NAME} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={_ogImage} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={_ogImage} />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@100..900&family=JetBrains+Mono:ital,wght@0,100..800;1,100..800&display=swap" rel="stylesheet">
		<StructuredData data={_baseStructuredData} />
	</head>
	<body class="min-h-screen relative overflow-x-hidden selection:bg-brand-primary selection:text-white">
		<!-- Dynamic Background Zones -->
		<div class="fixed inset-0 -z-20 pointer-events-none" id="bg-container">
			{_currentBackground.map((zone: any) => (
				<div 
					class={`absolute transform-gpu transition-transform duration-700 ease-out ${zone.color} ${zone.shape}`}
					style={`--parallax: ${zone.parallax}; transform: translateY(calc(var(--scroll-y, 0) * var(--parallax) * 1px)) rotate(var(--tw-rotate, 0deg));`}
				></div>
			))}
		</div>

		<!-- Systems Grid Overlay -->
		<div class="fixed inset-0 -z-10 systems-grid pointer-events-none opacity-40"></div>

		<nav class="fixed top-0 left-0 right-0 z-50 border-b border-black/5 bg-white/70 backdrop-blur-md">
			<div class="max-w-7xl mx-auto px-6 h-16 flex items-center justify-between">
				<a href="/" class="group flex items-center gap-3">
					<div class="w-2 h-2 bg-linear-to-br from-brand-sky to-brand-leaf rounded-full group-hover:scale-125 transition-transform"></div>
					<span class="font-mono font-bold tracking-tighter text-lg">intuitui.labs</span>
				</a>
				<div class="flex items-center gap-8 text-sm font-medium">
					<a href="/about" class="hover:text-brand-accent transition-colors">About</a>
					<a href="/projects" class="hover:text-brand-accent transition-colors">Projects</a>
					<a href="/studio" class="hover:text-brand-accent transition-colors">Studio</a>
				</div>
			</div>
		</nav>

		<main class="pt-32 pb-24 px-6 max-w-7xl mx-auto">
			<slot />
		</main>

		<footer class="border-t border-black/5 py-12 px-6">
			<div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-12">
				<div class="space-y-4">
					<div class="flex items-center gap-3">
						<div class="w-1.5 h-1.5 bg-brand-accent rounded-full"></div>
						<span class="font-mono font-bold tracking-tighter uppercase text-xs opacity-50">Studio Context</span>
					</div>
					<p class="text-sm text-brand-secondary max-w-xs">
						Transforming Sri Lankan workflows through systems intelligence and humane technology.
					</p>
				</div>
				<div></div>
				<div class="text-right flex flex-col justify-end">
					<p class="mono-label">Intuitui Labs © 2026</p>
					<p class="text-[10px] opacity-30 mt-1">Neev Foundation Subsidiary</p>
				</div>
			</div>
		</footer>

		<script>
			// Track scroll position and update CSS variable
			const updateScroll = () => {
				const scrollY = window.scrollY;
				document.body.style.setProperty('--scroll-y', scrollY.toString());
			};

			window.addEventListener('scroll', updateScroll, { passive: true });
			updateScroll(); // Initial call
		</script>
	</body>
</html>
