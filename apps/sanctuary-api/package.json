{
  "name": "@repo/sanctuary-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "doppler run --no-fallback -- node ../../scripts/run-and-report.mjs --cmd \"node --import tsx --watch-path=src src/entry-node.ts\" --name \"apps_sanctuary-api-dev\"",
    "dev:bun": "doppler run --no-fallback -- node ../../scripts/run-and-report.mjs --cmd \"bun --watch src/index.ts\" --name \"apps_sanctuary-api-dev_bun\"",
    "dev:rust": "cargo run --manifest-path ../../native-capabilities/Cargo.toml -p gurudevi-authorization-evaluator",
    "dev:no-doppler": "node ../../scripts/with-dotenv-fallback.mjs node ../../scripts/run-and-report.mjs --cmd \"node --import tsx --watch-path=src src/entry-node.ts\" --name \"apps_sanctuary-api-dev\"",
    "build": "doppler run --no-fallback -- node ../../scripts/run-and-report.mjs --cmd \"tsup src/index.ts src/entry-node.ts --format esm --clean\" --name \"apps_sanctuary-api-build\"",
    "start": "doppler run --no-fallback -- node ../../scripts/run-and-report.mjs --cmd \"node dist/entry-node.js\" --name \"apps_sanctuary-api-start\"",
    "start:bun": "doppler run --no-fallback -- node ../../scripts/run-and-report.mjs --cmd \"bun src/index.ts\" --name \"apps_sanctuary-api-start_bun\"",
    "start:no-doppler": "node ../../scripts/with-dotenv-fallback.mjs node ../../scripts/run-and-report.mjs --cmd \"node dist/entry-node.js\" --name \"apps_sanctuary-api-start\"",
    "lint": "node ../../scripts/run-and-report.mjs --cmd \"biome check src\" --name \"apps_sanctuary-api-lint\"",
    "format": "node ../../scripts/run-and-report.mjs --cmd \"node ../../scripts/scoped-biome.mjs --write\" --name \"apps_sanctuary-api-format\"",
    "test": "node ../../scripts/run-and-report.mjs --cmd \"vitest run\" --name \"apps_sanctuary-api-test\"",
    "test:coverage": "vitest run --coverage",
    "test:bun": "node ../../scripts/run-and-report.mjs --cmd \"bun x vitest run\" --name \"apps_sanctuary-api-test_bun\""
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.18",
    "@ai-sdk/google": "^4.0.21",
    "@ai-sdk/openai": "^4.0.17",
    "@hono/node-server": "^2.0.6",
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-openapi": "^1.4.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/context-async-hooks": "2.10.0",
    "@opentelemetry/core": "2.10.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.221.0",
    "@opentelemetry/resources": "2.10.0",
    "@opentelemetry/sdk-trace-base": "2.10.0",
    "@opentelemetry/semantic-conventions": "1.43.0",
    "@orpc/client": "*",
    "@orpc/contract": "*",
    "@orpc/openapi": "1.14.12",
    "@orpc/server": "*",
    "@repo/core": "workspace:*",
    "@repo/database": "workspace:*",
    "@repo/policies": "workspace:*",
    "@scalar/hono-api-reference": "^0.11.5",
    "@tanstack/ai": "^0.43.0",
    "@tanstack/ai-anthropic": "^0.16.4",
    "@tanstack/ai-gemini": "^0.21.0",
    "@tanstack/ai-openai": "^0.18.0",
    "ai": "^7.0.34",
    "dotenv": "^17.4.2",
    "foglamp": "^0.7.1",
    "hono": "^4.12.33",
    "inngest": "^4.18.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@vitest/coverage-v8": "4.1.8",
    "tsdown": "^0.22.3",
    "tsup": "^8.5.1",
    "tsx": "^4.22.4",
    "typescript": "7.0.2",
    "vitest": "^4.1.8"
  },
  "_originalScripts": {
    "dev": "tsx watch src/entry-node.ts",
    "dev:bun": "bun --watch src/index.ts",
    "build": "tsup src/index.ts src/entry-node.ts --format esm --clean",
    "start": "node dist/entry-node.js",
    "start:bun": "bun src/index.ts",
    "lint": "biome check src",
    "format": "node ../../scripts/scoped-biome.mjs --write",
    "test": "vitest run",
    "test:bun": "bun x vitest run"
  }
}
