{
  "name": "@repo/sanctuary-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "doppler run --no-fallback -- node --import tsx --watch src/entry-node.ts",
    "dev:bun": "doppler run --no-fallback -- bun --watch src/index.ts",
    "build": "node ../../scripts/run-and-report.mjs --cmd \"tsup src/index.ts src/entry-node.ts --format esm --clean\" --name \"apps_sanctuary-api-build\"",
    "start": "node dist/entry-node.js",
    "start:bun:local": "bun src/index.ts",
    "check-types": "tsc --noEmit -p tsconfig.json",
    "lint": "biome check src",
    "format": "biome check --write src",
    "test": "node ../../scripts/run-and-report.mjs --cmd \"vitest run --exclude src/__tests__/node-server.test.ts\" --name apps_sanctuary-api-foundation --evidence-level G1",
    "test:database": "doppler run --no-fallback -- node ../../scripts/run-and-report.mjs --cmd \"node node_modules/tsx/dist/cli.mjs --tsconfig tsconfig.json scripts/test-foundation-database.ts\" --name apps_sanctuary-api-foundation_database --evidence-level G2",
    "test:socket": "node ../../scripts/run-and-report.mjs --cmd \"vitest run src/__tests__/node-server.test.ts\" --name apps_sanctuary-api-sockets --evidence-level G2"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "@orpc/client": "2.0.0-beta.46",
    "@orpc/contract": "2.0.0-beta.46",
    "@orpc/server": "2.0.0-beta.46",
    "@repo/core": "workspace:*",
    "@repo/policies": "workspace:*",
    "effect": "^4.1.4",
    "hono": "5.0.0-rc.1",
    "jose": "6.2.15",
    "pg": "^8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.5",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^5.1.0",
    "cross-env": "^10.1.0",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "7.1.0-beta",
    "vitest": "5.1.0"
  }
}
