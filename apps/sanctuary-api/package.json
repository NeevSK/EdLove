{
  "name": "@repo/sanctuary-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "doppler run --no-fallback -- node ../../scripts/run-and-report.mjs --cmd \"cross-env NODE_ENV=development node --import tsx --watch --watch-preserve-output src/entry-node.ts\" --name \"apps_sanctuary-api-dev\"",
    "dev:bun": "doppler run --no-fallback -- node ../../scripts/run-and-report.mjs --cmd \"bun --watch src/index.ts\" --name \"apps_sanctuary-api-dev_bun\"",
    "dev:rust": "cargo run --manifest-path ../../native-capabilities/Cargo.toml -p gurudevi-authorization-evaluator",
    "dev:no-doppler": "node ../../scripts/with-dotenv-fallback.mjs node ../../scripts/run-and-report.mjs --cmd \"cross-env NODE_ENV=development node --import tsx --watch --watch-preserve-output src/entry-node.ts\" --name \"apps_sanctuary-api-dev\"",
    "build": "doppler run --no-fallback -- node ../../scripts/run-and-report.mjs --cmd \"tsup src/index.ts src/entry-node.ts --format esm --clean\" --name \"apps_sanctuary-api-build\"",
    "start": "doppler run --no-fallback -- node ../../scripts/run-and-report.mjs --cmd \"node dist/entry-node.js\" --name \"apps_sanctuary-api-start\"",
    "start:bun": "doppler run --no-fallback -- node ../../scripts/run-and-report.mjs --cmd \"bun src/index.ts\" --name \"apps_sanctuary-api-start_bun\"",
    "start:no-doppler": "node ../../scripts/with-dotenv-fallback.mjs node ../../scripts/run-and-report.mjs --cmd \"node dist/entry-node.js\" --name \"apps_sanctuary-api-start\"",
    "lint": "node ../../scripts/run-and-report.mjs --cmd \"biome check src\" --name \"apps_sanctuary-api-lint\"",
    "format": "node ../../scripts/run-and-report.mjs --cmd \"node ../../scripts/scoped-biome.mjs --write\" --name \"apps_sanctuary-api-format\"",
    "test": "node ../../scripts/run-and-report.mjs --cmd \"vitest run\" --name \"apps_sanctuary-api-test\" --evidence-level G1",
    "test:coverage": "node ../../scripts/run-and-report.mjs --cmd \"vitest run --coverage --exclude=src/__tests__/integration/**\" --name \"apps_sanctuary-api-test_coverage\" --evidence-level G1",
    "test:bun": "node ../../scripts/run-and-report.mjs --cmd \"bun x vitest run\" --name \"apps_sanctuary-api-test_bun\" --evidence-level G1",
    "test:integration": "node ../../scripts/run-and-report.mjs --cmd \"vitest run --config vitest.integration.config.ts\" --name \"apps_sanctuary-api-test_integration\" --evidence-level G3",
    "test:policy-pg": "node ../../scripts/run-and-report.mjs --cmd \"vitest run --config vitest.pg.config.ts\" --name \"apps_sanctuary-api-test_policy_pg\" --evidence-level G3",
    "test:integration:watch": "node ../../scripts/run-and-report.mjs --cmd \"vitest --config vitest.integration.config.ts\" --name \"apps_sanctuary-api-test_integration_watch\" --evidence-level G3"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.53",
    "@ai-sdk/google": "^4.0.69",
    "@ai-sdk/openai": "^4.0.96",
    "@growthbook/growthbook": "^1.8.0",
    "@hono/node-server": "^2.1.5",
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-openapi": "^1.6.3",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/context-async-hooks": "2.12.0",
    "@opentelemetry/core": "2.12.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.221.0",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "@opentelemetry/semantic-conventions": "1.43.0",
    "@orpc/client": "2.0.0-beta.44",
    "@orpc/contract": "2.0.0-beta.44",
    "@orpc/openapi": "2.0.0-beta.44",
    "@orpc/server": "2.0.0-beta.44",
    "@repo/core": "workspace:*",
    "@repo/database": "workspace:*",
    "@repo/policies": "workspace:*",
    "@scalar/hono-api-reference": "^0.12.12",
    "@sentry/node": "^8.55.2",
    "@supabase/server": "^1.9.2",
    "@tanstack/ai": "^0.69.0",
    "@tanstack/ai-anthropic": "0.22.0",
    "@tanstack/ai-gemini": "0.38.0",
    "@tanstack/ai-openai": "0.30.0",
    "ai": "^7.0.143",
    "dotenv": "^17.4.2",
    "foglamp": "^0.7.1",
    "hono": "^4.13.13",
    "inngest": "^4.24.0",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "posthog-node": "^5.56.1",
    "zod": "4.6.5"
  },
  "pnpm": {
    "overrides": {
      "@orpc/client": "1.15.7"
    },
    "resolutions": {
      "@orpc/client": "1.15.7"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@vitest/coverage-v8": "^5.0.5",
    "cross-env": "^10.1.0",
    "tsdown": "^0.23.1",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "_originalScripts": {
    "dev": "tsx watch src/entry-node.ts",
    "dev:bun": "bun --watch src/index.ts",
    "build": "tsup src/index.ts src/entry-node.ts --format esm --clean",
    "start": "node dist/entry-node.js",
    "start:bun": "bun src/index.ts",
    "lint": "biome check src",
    "format": "node ../../scripts/scoped-biome.mjs --write",
    "test": "vitest run",
    "test:bun": "bun x vitest run"
  }
}
