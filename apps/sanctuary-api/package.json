{
  "name": "@repo/sanctuary-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup src/index.ts --format esm --clean",
    "start": "node dist/index.js",
    "lint": "biome check src",
    "format": "biome format src --write",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.2",
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-openapi": "^0.18.4",
    "@repo/core": "workspace:*",
    "@repo/database": "workspace:*",
    "@repo/policies": "workspace:*",
    "dotenv": "^16.6.1",
    "hono": "^4.7.4",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "tsup": "^8.4.0",
    "tsx": "^4.19.3",
    "typescript": "^6.0.3",
    "vitest": "^2.1.9"
  }
}
