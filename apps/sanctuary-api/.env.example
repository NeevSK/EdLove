# Database Configuration
# Get your connection string from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/database
DATABASE_URL=postgresql://postgres.qzoawolfkuwiuyaoiybz:[YOUR_PASSWORD]@aws-1-ap-south-1.pooler.supabase.com:5432/postgres

# Supabase project (same project as the mobile app's EXPO_PUBLIC_SUPABASE_URL)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Service role key for server-side admin operations (never expose to clients)
SUPABASE_SERVICE_ROLE_KEY=
# Public JWT secret for verifying Supabase-issued tokens (from dashboard → Auth → JWT settings)
SUPABASE_JWT_PUBLIC_KEY=

# Push dispatch (the private VAPID keys stay in the Supabase Edge Function)
PUSH_DISPATCH_SECRET=replace-with-a-long-random-secret

# Ed25519 private key used only by the server-side permission snapshot writer.
# Store the PEM value in protected CI/operator secrets. Never expose it to
# Expo/mobile/web clients.
SNAPSHOT_SIGNING_PRIVATE_KEY=

# GrowthBook lifecycle operator (server/CI only; never add these to Expo env)
GROWTHBOOK_API_KEY=
# GrowthBook v2 management endpoint, with {key} replaced by the feature identifier.
# Cloud deployments commonly use https://api.growthbook.io/api/v2/features/{key};
# self-hosted deployments should use their own API origin and feature identifier.
GROWTHBOOK_ARCHIVE_ENDPOINT_TEMPLATE=
GROWTHBOOK_ARCHIVE_METHOD=POST

# OpenTelemetry tracing (optional; leave endpoint empty to disable safely)
OTEL_SERVICE_NAME=sanctuary-api
OTEL_SERVICE_VERSION=
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_TRACES_SAMPLER_ARG=0.10
OTEL_SDK_DISABLED=false

# HTTP server
PORT=3000
NODE_ENV=development

# AI providers (server-side only; the mobile app never sees these)
# AI_SDK: 'tanstack' (default) or 'vercel'
AI_SDK=tanstack
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
# OpenRouter (OpenAI-compatible aggregation). Baseline tier auto-routes here
# when no OPENAI_API_KEY is set. BYOK keys starting with sk-or-v1- also map here.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto
# Optional OpenRouter attribution headers (appears in provider rankings)
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=Gurudevi Sanctuary

# BYOK (Bring Your Own Key) encryption secret for AI payloads.
# Leave empty to use the in-code development fallback (dev only).
BYOK_ENCRYPTION_SECRET=

# Authorization evaluator: 'ts' (in-process, default) or 'rust' (external service)
SANCTUARY_AUTHZ_EVALUATOR=ts
SANCTUARY_RUST_EVALUATOR_URL=http://127.0.0.1:8788

# PayHere (payment gateway) credentials
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
