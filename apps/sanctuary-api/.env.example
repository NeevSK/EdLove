# Database Configuration
# Get your connection string from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/database
DATABASE_URL=postgresql://postgres.qzoawolfkuwiuyaoiybz:[YOUR_PASSWORD]@aws-1-ap-south-1.pooler.supabase.com:5432/postgres

# Push dispatch (the private VAPID keys stay in the Supabase Edge Function)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
PUSH_DISPATCH_SECRET=replace-with-a-long-random-secret

# Ed25519 private key used only by the server-side permission snapshot writer.
# Store the PEM value in protected CI/operator secrets. Never expose it to
# Expo/mobile/web clients.
SNAPSHOT_SIGNING_PRIVATE_KEY=

# GrowthBook lifecycle operator (server/CI only; never add these to Expo env)
GROWTHBOOK_API_KEY=
# GrowthBook v2 management endpoint, with {key} replaced by the feature identifier.
# Cloud deployments commonly use https://api.growthbook.io/api/v2/features/{key};
# self-hosted deployments should use their own API origin and feature identifier.
GROWTHBOOK_ARCHIVE_ENDPOINT_TEMPLATE=
GROWTHBOOK_ARCHIVE_METHOD=POST

# OpenTelemetry tracing (optional; leave endpoint empty to disable safely)
OTEL_SERVICE_NAME=sanctuary-api
OTEL_SERVICE_VERSION=
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_TRACES_SAMPLER_ARG=0.10
OTEL_SDK_DISABLED=false
