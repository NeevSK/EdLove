-BEGIN
-  RETURN QUERY
-  SELECT
-    lr.id,
-    lr.title,
-    lr.description,
-    lr.url,
-    lr.type,
-    lr.subject,
-    CASE 
-      WHEN query_embedding IS NOT NULL THEN (1 - (lr.embedding <=> query_embedding))
