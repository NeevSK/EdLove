---
import { Picture } from 'astro:assets';
import { LAUNCH } from '@repo/core/site';
// Transitional path: the photo still lives in the Next app's public folder.
import heroPhoto from '../../../../gurudevi-web/public/hero-teacher-editorial.png';
import PublicLayout from '../../layouts/PublicLayout.astro';
import Roadmap from '../../components/Roadmap.astro';
import { surfaceUrl, translator, type SupportedLocale } from '../../site';

// One file per language, built at deploy time: `/`, `/si`, `/ta`.
export function getStaticPaths() {
  return [{ params: { locale: undefined } }, { params: { locale: 'si' } }, { params: { locale: 'ta' } }];
}
const locale = (Astro.params.locale ?? 'en') as SupportedLocale;
const t = translator(locale);
const platform = surfaceUrl('explore', '/self');

const workspaces = [
  ['w1', '01', 'Teachers & Students', 'Classroom Sanctuary', 'Lesson preparation, reflection, and teaching—grounded in pedagogical care.'],
  ['w2', '02', 'School Leaders', 'School Coordination', 'Institutional patterns and resource stewardship without surveillance.'],
  ['w3', '03', 'Families & Guardians', 'Family Space', 'A transparent bridge between school and home with mutual respect.'],
  ['w4', '04', 'Young Learners', 'Learning Studio', 'A quiet space for self-directed practice, learning commons, and agency.'],
].map(([id, number, roleLabel, name, body]) => ({
  number: t(`workspaces.${id}.number`, number),
  roleLabel: t(`workspaces.${id}.roleLabel`, roleLabel),
  name: t(`workspaces.${id}.name`, name),
  body: t(`workspaces.${id}.body`, body),
}));
---
<PublicLayout
  locale={locale}
  path="/"
  title="Gurudevi | Education Ecology Support System and Sanctuary for Education"
  description="Gurudevi is an education ecology support system and sanctuary for education in Sri Lanka, connecting teachers, students, schools, families, and communities."
>
  <main id="main-content">
    <section class="hero-editorial">
      <!-- The 1.6 MB PNG becomes AVIF/WebP at build time, sized to the screen that asks for it. -->
      <Picture
        class="hero-editorial__image"
        src={heroPhoto}
        alt="A teacher prepares learning materials in a sunlit Sri Lankan classroom."
        formats={['avif', 'webp']}
        widths={[480, 828, 1280, 1920]}
        sizes="100vw"
        fetchpriority="high"
        loading="eager"
      />
      <div class="hero-editorial__wash"></div>
      <div class="hero-editorial__content">
        <p class="eyebrow hero-editorial__eyebrow">{t('hero.eyebrow')}</p>
        <h1>{t('hero.title')}</h1>
        <p class="hero-editorial__lede">{t('hero.lede')}</p>
        <div class="hero-editorial__actions">
          <a class="button button--primary" href="#roadmap">{t('hero.primaryCta')} <span aria-hidden="true">↘</span></a>
          <a class="text-link" href="#workspaces">{t('hero.secondaryCta')} <span aria-hidden="true">↓</span></a>
        </div>
      </div>
      <div class="hero-editorial__caption">
        <span>{t('hero.caption')}</span>
        <span aria-hidden="true">↓</span>
      </div>
    </section>

    <section class="section section--intro" id="ecology">
      <div class="section__label eyebrow">The Reality</div>
      <div class="intro-copy">
        <h2>Education is held together by people carrying too much alone.</h2>
        <p>
          {t('brand.name')} exists to make the relationships around learning easier to see, easier to
          support, and worthy of care—replacing administrative exhaustion with calm, sovereign spaces.
        </p>
      </div>
    </section>

    <section class="section section--workspaces" id="workspaces" aria-labelledby="workspaces-title">
      <div class="section__heading">
        <div>
          <p class="eyebrow">The Living Ecology</p>
          <h2 id="workspaces-title">{t('workspaces.title')}</h2>
        </div>
        <p>{t('workspaces.subtitle')}</p>
      </div>
      <div class="workspace-list">
        {
          workspaces.map((w) => (
            <div class="workspace-row">
              <span>{w.number}</span>
              <div class="workspace-row__title-wrap">
                <p class="eyebrow">{w.roleLabel}</p>
                <h3>{w.name}</h3>
              </div>
              <p>{w.body}</p>
            </div>
          ))
        }
      </div>
    </section>

    <section class="section section--trust" id="trust" aria-labelledby="trust-title">
      <div class="trust-mark">
        <img src="/gurudevi-mark.svg" alt="" width="44" height="44" loading="lazy" />
      </div>
      <div>
        <p class="eyebrow">The Promise</p>
        <h2 id="trust-title">Support should never become surveillance.</h2>
        <p class="trust-copy">
          {t('brand.name')} is engineered with local-first privacy: enough shared coordination to support
          an entire school, with absolute cryptographic privacy for educators and learners.
        </p>
        <a class="text-link" href="/about">Read our epistemic foundation &amp; research grounding <span aria-hidden="true">↗</span></a>
      </div>
    </section>

    <Roadmap locale={locale} />

    <section class="launch-panel" id="launch" aria-labelledby="launch-title" data-launch-status={LAUNCH.status}>
      <div>
        <p class="eyebrow">The first opening · Alpha Genesis</p>
        <h2 id="launch-title">{t('brand.name')} Alpha is in active development.</h2>
        <p>
          We are preparing a public home for a more humane education ecology, moving at a sustainable
          cadence grounded in research care. Speak with us about bringing pilot cohorts to your school as
          spaces open.
        </p>
      </div>
      <div class="launch-panel__side">
        <div class="launch-clock" aria-live="polite">
          <span>Preparing the sanctuary…</span>
          <small>In active stewardship · Alpha Genesis</small>
        </div>
        <div class="launch-panel__actions">
          <a class="button button--dark" href={platform}>{t('nav.openPlatform')} <span aria-hidden="true">↗</span></a>
          <a class="text-link" href="/support">{t('nav.support')}</a>
        </div>
      </div>
    </section>
  </main>
</PublicLayout>
