{
  "name": "apps-neevsk-web",
  "type": "module",
  "version": "0.0.2",
  "scripts": {
    "dev": "pnpm exec astro dev",
    "build": "pnpm exec astro build",
    "preview": "pnpm exec astro preview",
    "astro": "pnpm exec astro",
    "lint": "pnpm run lint:biome && pnpm run lint:eslint",
    "check-types": "pnpm exec tsc --noEmit",
    "lint:biome": "biome check .",
    "lint:eslint": "eslint .",
    "format": "node ../../scripts/scoped-biome.mjs --write",
    "check-cycles": "node ../../scripts/refactor/sovereign-cycle-checker.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:e2e": "pnpm exec playwright test",
    "clean": "rm -rf .turbo node_modules dist"
  },
  "dependencies": {
    "@astrojs/react": "^5.0.7",
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/svelte": "^8.1.2",
    "@tailwindcss/vite": "^4.3.0",
    "astro": "^6.4.4",
    "gsap": "^3.15.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "svelte": "^5.56.3",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@repo/eslint-config": "workspace:^",
    "@repo/typescript-config": "workspace:*",
    "eslint": "^10.4.1",
    "sass": "^1.100.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.8"
  }
}
