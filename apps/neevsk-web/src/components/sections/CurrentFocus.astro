---
---

<section class="current-focus-section scroll-fade-in">
  <div class="content-wrapper">
    <div class="header">
      <div class="header-content">
        <h2>Where I Am Now</h2>
        <p class="header-subtitle">2026 — Active, Building, Thinking</p>
      </div>
      <div class="status-indicator">
        <span class="dot pulse"></span>
        <span>Actively Building</span>
      </div>
    </div>

    <div class="focus-grid">
      <Card variant="feature" class="focus-card primary-focus">
        <div class="focus-year">2026</div>
        <h3>🎓 University & Academics</h3>
        <p>
          3rd year at University of Moratuwa, Business Analytics with ERP minor.
          CGPA 3.3 — the real education is learning how to build systems that serve humans.
        </p>
        <div class="tags">
          <span>Business Analytics</span>
          <span>Systems Thinking</span>
          <span>ERP</span>
        </div>
      </Card>

      <Card variant="feature" class="focus-card primary-focus">
        <div class="focus-icon">🔨</div>
        <h3>What I'm Building</h3>
        <div class="building-list">
          <div class="item">
            <strong>Gurudevi</strong> — Teacher wellbeing, sanctuary for educators
          </div>
          <div class="item">
            <strong>EdLove Ecosystem</strong> — Education reimagined with care at its center
          </div>
          <div class="item">
            <strong>Intuitui Labs</strong> — Exploring consciousness, systems, and human flourishing
          </div>
        </div>
      </Card>

      <Card variant="feature" class="focus-card secondary-focus">
        <div class="focus-icon">🧠</div>
        <h3>What I'm Thinking About</h3>
        <div class="thinking-list">
          <div class="item">
            How do we design systems that breathe?
          </div>
          <div class="item">
            Physics of life and entropy
          </div>
          <div class="item">
            Material conditions of systems
          </div>
          <div class="item">
            Consciousness in living structures
          </div>
        </div>
      </Card>
    </div>
  </div>
</section>

<style lang="scss">
  .current-focus-section {
    padding: 8rem 2rem;
    background: linear-gradient(
      135deg,
      var(--color-background) 0%,
      rgba(var(--accent-teal-rgb), 0.02) 100%
    );
    border-top: 1px solid rgba(var(--accent-teal-rgb), 0.1);
    position: relative;
    overflow: hidden;

    // Subtle animated background elements
    &::before {
      content: '';
      position: absolute;
      top: -50%;
      right: -20%;
      width: 500px;
      height: 500px;
      background: radial-gradient(circle, rgba(var(--accent-emerald-rgb), 0.08), transparent);
      border-radius: 50%;
      animation: float 15s ease-in-out infinite;
      z-index: 0;
    }

    &::after {
      content: '';
      position: absolute;
      bottom: -20%;
      left: -10%;
      width: 400px;
      height: 400px;
      background: radial-gradient(circle, rgba(var(--accent-purple-rgb), 0.08), transparent);
      border-radius: 50%;
      animation: float 20s ease-in-out infinite 2s;
      z-index: 0;
    }

    .content-wrapper {
      max-width: 1200px;
      margin: 0 auto;
      position: relative;
      z-index: 1;
    }

    .header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 4rem;
      flex-wrap: wrap;
      gap: 2rem;

      .header-content {
        flex: 1;

        h2 {
          font-size: clamp(2.5rem, 6vw, 4rem);
          margin-bottom: 0.5rem;
          background: linear-gradient(
            135deg,
            var(--color-text) 0%,
            var(--accent-teal) 50%,
            var(--accent-emerald) 100%
          );
          background-size: 200% auto;
          -webkit-background-clip: text;
          -webkit-text-fill-color: transparent;
          background-clip: text;
          animation: shimmer 8s ease-in-out infinite;
          font-weight: 700;
        }

        .header-subtitle {
          font-size: 1.1rem;
          color: var(--color-secondary);
          opacity: 0.8;
          font-family: var(--font-mono);
          letter-spacing: 0.05em;
        }
      }
    }

    .status-indicator {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      font-family: var(--font-mono);
      font-size: 0.9rem;
      padding: 0.75rem 1.5rem;
      background: linear-gradient(
        135deg,
        rgba(var(--accent-teal-rgb), 0.15),
        rgba(var(--accent-emerald-rgb), 0.1)
      );
      border: 1px solid rgba(var(--accent-teal-rgb), 0.3);
      border-radius: 20px;
      color: var(--accent-emerald);
      font-weight: 600;
      white-space: nowrap;

      .dot {
        width: 10px;
        height: 10px;
        background-color: var(--accent-emerald);
        border-radius: 50%;

        &.pulse {
          box-shadow: 0 0 0 0 rgba(var(--accent-emerald-rgb), 0.7);
          animation: pulse-emerald 2s infinite;
        }
      }
    }

    .focus-grid {
      display: grid;
      gap: 2rem;
      grid-template-columns: 1fr;

      @media (min-width: 1024px) {
        grid-template-columns: 1fr 1fr;
      }

      @media (min-width: 1400px) {
        grid-template-columns: 1.2fr 1fr 1fr;
      }

      .focus-card {
        position: relative;
        overflow: hidden;
        transition: all 0.5s var(--ease-smooth);

        &::before {
          content: '';
          position: absolute;
          top: -50%;
          right: -50%;
          width: 300px;
          height: 300px;
          background: radial-gradient(
            circle,
            rgba(var(--accent-teal-rgb), 0.2),
            transparent
          );
          border-radius: 50%;
          opacity: 0;
          transition: opacity 0.5s ease;
          z-index: 0;
        }

        &:hover {
          transform: translateY(-8px);
          box-shadow: 0 20px 40px rgba(var(--accent-teal-rgb), 0.15);

          &::before {
            opacity: 1;
          }

          h3 {
            color: var(--accent-teal);
            text-shadow: 0 0 20px rgba(var(--accent-teal-rgb), 0.4);
          }
        }

        &.primary-focus {
          border: 1px solid rgba(var(--accent-teal-rgb), 0.2);
          background: linear-gradient(
            135deg,
            rgba(var(--accent-teal-rgb), 0.05),
            rgba(var(--accent-emerald-rgb), 0.03)
          );

          .focus-year, .focus-icon {
            color: var(--accent-teal);
            text-shadow: 0 0 15px rgba(var(--accent-teal-rgb), 0.3);
          }
        }

        &.secondary-focus {
          border: 1px solid rgba(var(--accent-purple-rgb), 0.2);
          background: linear-gradient(
            135deg,
            rgba(var(--accent-purple-rgb), 0.05),
            rgba(var(--accent-coral-rgb), 0.03)
          );

          .focus-icon {
            color: var(--accent-purple);
            text-shadow: 0 0 15px rgba(var(--accent-purple-rgb), 0.3);
          }

          &:hover {
            h3 {
              color: var(--accent-purple);
              text-shadow: 0 0 20px rgba(var(--accent-purple-rgb), 0.4);
            }
          }
        }

        h3 {
          font-size: 1.3rem;
          margin-bottom: 1rem;
          color: var(--color-text);
          transition: all 0.4s ease;
          font-weight: 600;
        }

        p {
          color: var(--color-secondary);
          line-height: 1.8;
          opacity: 0.95;
        }
      }
    }

    .focus-year {
      font-size: 3rem;
      font-weight: 700;
      font-family: var(--font-mono);
      margin-bottom: 1rem;
      opacity: 0.6;
      transition: all 0.3s ease;
    }

    .focus-icon {
      font-size: 2.5rem;
      margin-bottom: 1rem;
      transition: all 0.3s ease;
    }

    .building-list,
    .thinking-list {
      display: flex;
      flex-direction: column;
      gap: 1rem;

      .item {
        padding: 0.75rem 0;
        border-left: 3px solid var(--accent-teal);
        padding-left: 1rem;
        color: var(--color-text);
        opacity: 0.95;
        transition: all 0.3s ease;

        strong {
          color: var(--accent-teal);
          font-weight: 600;
        }

        &:hover {
          border-left-color: var(--accent-emerald);
          transform: translateX(4px);
        }
      }
    }

    .thinking-list .item {
      border-left-color: var(--accent-purple);

      strong {
        color: var(--accent-purple);
      }

      &:hover {
        border-left-color: var(--accent-coral);
      }
    }

    .tags {
      display: flex;
      gap: 0.75rem;
      margin-top: 1.5rem;
      flex-wrap: wrap;

      span {
        font-size: 0.8rem;
        background: linear-gradient(
          135deg,
          rgba(var(--accent-teal-rgb), 0.15),
          rgba(var(--accent-emerald-rgb), 0.1)
        );
        border: 1px solid rgba(var(--accent-teal-rgb), 0.2);
        color: var(--accent-teal);
        padding: 6px 12px;
        border-radius: 6px;
        font-weight: 500;
        transition: all 0.3s ease;

        &:hover {
          background: linear-gradient(
            135deg,
            rgba(var(--accent-teal-rgb), 0.25),
            rgba(var(--accent-emerald-rgb), 0.2)
          );
          box-shadow: 0 0 12px rgba(var(--accent-teal-rgb), 0.3);
          transform: translateY(-2px);
        }
      }
    }

    @keyframes pulse-emerald {
      0% {
        transform: scale(0.95);
        box-shadow: 0 0 0 0 rgba(var(--accent-emerald-rgb), 0.7);
      }

      70% {
        transform: scale(1);
        box-shadow: 0 0 0 8px rgba(var(--accent-emerald-rgb), 0);
      }

      100% {
        transform: scale(0.95);
        box-shadow: 0 0 0 0 rgba(var(--accent-emerald-rgb), 0);
      }
    }

    @keyframes float {
      0%, 100% {
        transform: translateY(0px);
      }
      50% {
        transform: translateY(30px);
      }
    }
  }
</style>
