---
const doors = [
  {
    id: 'personal',
    label: 'Personal',
    title: 'Warmth',
    desc: 'Soul, Lineage, Flame',
    theme: 'nature',
    color: '#4A9B9B',
    href: '/personal'
  },
  {
    id: 'intellectual',
    label: 'Intellectual',
    title: 'Systems',
    desc: 'Philosophy, Frameworks, Mind',
    theme: 'twilight',
    color: '#8B9BB4',
    href: '/intellectual'
  },
  {
    id: 'professional',
    label: 'Professional',
    title: 'Build',
    desc: 'Projects, CV, Craft',
    theme: 'light-tech',
    color: '#007AFF',
    href: '/professional'
  },
  {
    id: 'library',
    label: 'Library',
    title: 'Archive',
    desc: 'Books, Films, Wisdom',
    theme: 'warm-archive',
    color: '#8C5E58',
    href: '/library'
  },
  {
    id: 'connect',
    label: 'Connect',
    title: 'Signal',
    desc: 'Collaboration, Contact',
    theme: 'digital-neon',
    color: '#00FF94',
    href: '/connect'
  }
];
---

<section id="five-doors" class="five-doors-section">
  <div class="section-header">
    <h2>Choose Your Path</h2>
    <p>Five doors to different dimensions of the same soul.</p>
  </div>
  
  <div class="doors-grid">
    {doors.map(door => (
      <a href={door.href} class="door-card" data-theme-preview={door.theme}>
        <div class="door-content">
          <span class="door-label">{door.label}</span>
          <h3 class="door-title">{door.title}</h3>
          <p class="door-desc">{door.desc}</p>
        </div>
        <div class="door-glow" style={`background-color: ${door.color}`}></div>
      </a>
    ))}
  </div>
</section>

<style lang="scss">
  .five-doors-section {
    padding: 6rem 2rem;
    max-width: 1400px;
    margin: 0 auto;
    
    .section-header {
      text-align: center;
      margin-bottom: 4rem;
      
      h2 {
        font-size: 2.5rem;
        margin-bottom: 1rem;
      }
      
      p {
        font-size: 1.1rem;
        opacity: 0.7;
      }
    }
    
    .doors-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 1.5rem;
      
      @media (min-width: 1024px) {
        grid-template-columns: repeat(5, 1fr);
      }
    }
    
    .door-card {
      position: relative;
      height: 400px;
      background: var(--color-background);
      border: 1px solid rgba(0, 0, 0, 0.1);
      border-radius: var(--border-radius-lg);
      padding: 2rem;
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      overflow: hidden;
      transition: all 0.4s ease;
      
      &:hover {
        transform: translateY(-8px);
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
        
        .door-glow {
          opacity: 0.2;
          transform: scale(2);
        }
        
        .door-title {
          transform: translateY(0);
        }
      }
    }
    
    .door-content {
      z-index: 2;
    }
    
    .door-label {
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      opacity: 0.6;
      margin-bottom: 0.5rem;
      display: block;
    }
    
    .door-title {
      font-size: 2rem;
      font-weight: 700;
      margin-bottom: 0.5rem;
      font-family: var(--font-heading);
    }
    
    .door-desc {
      font-size: 0.9rem;
      opacity: 0.8;
      line-height: 1.4;
    }
    
    .door-glow {
      position: absolute;
      top: -50px;
      right: -50px;
      width: 200px;
      height: 200px;
      border-radius: 50%;
      filter: blur(40px);
      opacity: 0.1;
      transition: all 0.6s ease;
      z-index: 1;
    }
  }
</style>
