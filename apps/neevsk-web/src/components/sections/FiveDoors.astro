---
const doors = [
  {
    id: 'personal',
    label: 'Personal',
    title: 'Warmth',
    desc: 'Soul, Lineage, Flame',
    theme: 'nature',
    color: '#00D9D9',
    gradient: 'linear-gradient(135deg, #00D9D9 0%, #00FF88 100%)',
    href: '/personal',
    icon: '🔥'
  },
  {
    id: 'intellectual',
    label: 'Intellectual',
    title: 'Systems',
    desc: 'Philosophy, Frameworks, Mind',
    theme: 'twilight',
    color: '#D946EF',
    gradient: 'linear-gradient(135deg, #D946EF 0%, #9D4EDD 100%)',
    href: '/intellectual',
    icon: '🧠'
  },
  {
    id: 'professional',
    label: 'Professional',
    title: 'Build',
    desc: 'Projects, CV, Craft',
    theme: 'light-tech',
    color: '#00CCFF',
    gradient: 'linear-gradient(135deg, #00CCFF 0%, #0099FF 100%)',
    href: '/professional',
    icon: '⚡'
  },
  {
    id: 'library',
    label: 'Library',
    title: 'Archive',
    desc: 'Books, Films, Wisdom',
    theme: 'warm-archive',
    color: '#FFB800',
    gradient: 'linear-gradient(135deg, #FFB800 0%, #FF8A00 100%)',
    href: '/library',
    icon: '📚'
  },
  {
    id: 'connect',
    label: 'Connect',
    title: 'Signal',
    desc: 'Collaboration, Contact',
    theme: 'digital-neon',
    color: '#FF3366',
    gradient: 'linear-gradient(135deg, #FF3366 0%, #FF1744 100%)',
    href: '/connect',
    icon: '✨'
  }
];
---

<section id="five-doors" class="five-doors-section scroll-fade-in">
  <div class="section-header">
    <h2 class="section-title">Choose Your Path</h2>
    <p class="section-subtitle">Five doors to different dimensions of the same soul.</p>
  </div>

  <div class="doors-grid">
    {doors.map((door, index) => (
      <a
        href={door.href}
        class="door-card scroll-scale"
        data-theme-preview={door.theme}
        style={`--door-color: ${door.color}; --door-gradient: ${door.gradient}; --index: ${index}`}
      >
        <div class="door-background">
          <div class="door-glow"></div>
          <div class="door-pattern"></div>
        </div>

        <div class="door-icon">{door.icon}</div>

        <div class="door-content">
          <span class="door-label">{door.label}</span>
          <h3 class="door-title">{door.title}</h3>
          <p class="door-desc">{door.desc}</p>
        </div>

        <div class="door-shine"></div>
        <div class="door-hover-glow"></div>
      </a>
    ))}
  </div>
</section>

<style lang="scss">
  .five-doors-section {
    padding: 8rem 2rem;
    max-width: 1600px;
    margin: 0 auto;
    position: relative;

    .section-header {
      text-align: center;
      margin-bottom: 5rem;

      .section-title {
        font-size: clamp(2.5rem, 6vw, 4rem);
        margin-bottom: 1.5rem;
        font-weight: 700;
        background: linear-gradient(
          135deg,
          var(--color-text) 0%,
          var(--accent-teal) 50%,
          var(--color-text) 100%
        );
        background-size: 200% auto;
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        animation: shimmer 6s ease-in-out infinite;
      }

      .section-subtitle {
        font-size: 1.25rem;
        opacity: 0.8;
        color: var(--color-secondary);
        max-width: 600px;
        margin: 0 auto;
      }
    }

    .doors-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 2rem;

      @media (min-width: 1200px) {
        grid-template-columns: repeat(5, 1fr);
        gap: 1.5rem;
      }

      @media (max-width: 768px) {
        grid-template-columns: 1fr;
        gap: 2rem;
      }
    }

    .door-card {
      position: relative;
      height: 480px;
      background: var(--color-background-elevated);
      border: 1px solid rgba(0, 0, 0, 0.05);
      border-radius: var(--border-radius-xl);
      padding: 2.5rem;
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      overflow: hidden;
      transition: all 0.6s var(--ease-smooth);
      cursor: pointer;
      transform-style: preserve-3d;
      perspective: 1000px;

      &::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: var(--door-gradient);
        opacity: 0;
        transition: opacity 0.6s ease;
        z-index: 1;
      }

      &:hover {
        transform: translateY(-16px) scale(1.03) rotateX(2deg);
        box-shadow:
          0 32px 64px rgba(0, 0, 0, 0.15),
          0 0 0 1px rgba(255, 255, 255, 0.1);
        border-color: var(--door-color);

        &::before {
          opacity: 0.03;
        }

        .door-background {
          .door-glow {
            opacity: 0.4;
            transform: scale(1.8);
          }

          .door-pattern {
            opacity: 0.15;
            transform: scale(1.1) rotate(5deg);
          }
        }

        .door-icon {
          transform: scale(1.2) translateY(-10px) rotate(5deg);
          filter: drop-shadow(0 8px 16px var(--door-color));
        }

        .door-content {
          transform: translateY(-8px);

          .door-title {
            color: var(--door-color);
            text-shadow: 0 0 20px rgba(var(--color-primary-rgb), 0.3);
          }
        }

        .door-shine {
          opacity: 1;
          transform: translateX(200%);
        }

        .door-hover-glow {
          opacity: 0.6;
        }
      }

      // Background elements
      .door-background {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: 0;
        pointer-events: none;

        .door-glow {
          position: absolute;
          top: -20%;
          right: -20%;
          width: 60%;
          height: 60%;
          background: radial-gradient(
            circle,
            var(--door-color) 0%,
            transparent 70%
          );
          filter: blur(60px);
          opacity: 0.15;
          transition: all 0.8s var(--ease-smooth);
          z-index: 1;
        }

        .door-pattern {
          position: absolute;
          top: 0;
          left: 0;
          width: 100%;
          height: 100%;
          background-image: radial-gradient(
            circle at 20% 50%,
            var(--door-color) 1px,
            transparent 1px
          );
          background-size: 40px 40px;
          opacity: 0.05;
          transition: all 0.6s ease;
        }
      }

      // Icon
      .door-icon {
        position: absolute;
        top: 2.5rem;
        left: 2.5rem;
        font-size: 3rem;
        z-index: 3;
        transition: all 0.5s var(--ease-bounce);
        filter: drop-shadow(0 4px 8px rgba(0, 0, 0, 0.1));
      }

      // Content
      .door-content {
        z-index: 2;
        position: relative;
        transition: transform 0.5s var(--ease-smooth);
      }

      .door-label {
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.15em;
        opacity: 0.6;
        margin-bottom: 0.75rem;
        display: block;
        font-weight: 600;
        color: var(--door-color);
      }

      .door-title {
        font-size: 2.5rem;
        font-weight: 700;
        margin-bottom: 0.75rem;
        font-family: var(--font-heading);
        color: var(--color-text);
        transition: all 0.4s ease;
        letter-spacing: -0.02em;
      }

      .door-desc {
        font-size: 1rem;
        opacity: 0.8;
        line-height: 1.6;
        color: var(--color-secondary);
      }

      // Shine effect
      .door-shine {
        position: absolute;
        top: 0;
        left: -100%;
        width: 50%;
        height: 100%;
        background: linear-gradient(
          90deg,
          transparent 0%,
          rgba(255, 255, 255, 0.3) 50%,
          transparent 100%
        );
        opacity: 0;
        transition: all 0.8s ease;
        z-index: 5;
        pointer-events: none;
      }

      // Hover glow overlay
      .door-hover-glow {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: radial-gradient(
          circle at 50% 0%,
          var(--door-color),
          transparent 60%
        );
        opacity: 0;
        transition: opacity 0.6s ease;
        z-index: 0;
        filter: blur(40px);
      }
    }
  }
</style>
