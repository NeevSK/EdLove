---
import Button from '../common/Button.astro';
---

<section class="hero-home">
  <div class="hero-content">
    <h1 class="fade-in-up">Neev SK</h1>
    <h2 class="fade-in-up delay-1">Existential Cyberneticist</h2>
    <p class="subtitle fade-in-up delay-2">Building the soul behind the machines</p>
    
    <div class="hero-intro fade-in-up delay-3">
      <p>
        Currently bridging the gap between ancient wisdom and future systems.
        Welcoming you to my digital home—a place to explore, connect, and resonate.
      </p>
    </div>
    
    <div class="cta-group fade-in-up delay-4">
      <Button href="#five-doors" variant="primary">Explore the Doors</Button>
      <Button href="/connect" variant="secondary">Get in Touch</Button>
    </div>
  </div>
  
  <div class="scroll-indicator fade-in delay-5">
    <span>Scroll to enter</span>
    <div class="line"></div>
  </div>
</section>

<style lang="scss">
  .hero-home {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    padding: 2rem;
    position: relative;
    
    .hero-content {
      max-width: 800px;
      z-index: 10;
    }
    
    h1 {
      font-size: clamp(3rem, 10vw, 6rem);
      font-weight: 700;
      letter-spacing: -0.02em;
      margin-bottom: 0.5rem;
      background: linear-gradient(135deg, var(--color-text) 0%, rgba(var(--color-text-rgb), 0.7) 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
    
    h2 {
      font-size: clamp(1.5rem, 5vw, 2.5rem);
      font-weight: 400;
      margin-bottom: 1.5rem;
      color: var(--color-secondary);
      font-family: var(--font-body);
    }
    
    .subtitle {
      font-size: 1.25rem;
      font-style: italic;
      margin-bottom: 2.5rem;
      opacity: 0.8;
      font-family: var(--font-mono);
    }
    
    .hero-intro {
      font-size: 1.1rem;
      line-height: 1.8;
      margin-bottom: 3rem;
      max-width: 600px;
      margin-left: auto;
      margin-right: auto;
      opacity: 0.9;
    }
    
    .cta-group {
      display: flex;
      gap: 1rem;
      justify-content: center;
      flex-wrap: wrap;
    }
    
    .scroll-indicator {
      position: absolute;
      bottom: 2rem;
      left: 50%;
      transform: translateX(-50%);
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 1rem;
      font-size: 0.875rem;
      opacity: 0.6;
      
      .line {
        width: 1px;
        height: 60px;
        background: linear-gradient(to bottom, var(--color-text), transparent);
      }
    }
    
    // Simple fade animations (GSAP will handle complex ones later)
    .fade-in-up {
      opacity: 0;
      transform: translateY(20px);
      animation: fadeInUp 0.8s ease forwards;
    }
    
    .fade-in {
      opacity: 0;
      animation: fadeIn 0.8s ease forwards;
    }
    
    .delay-1 { animation-delay: 0.1s; }
    .delay-2 { animation-delay: 0.2s; }
    .delay-3 { animation-delay: 0.3s; }
    .delay-4 { animation-delay: 0.4s; }
    .delay-5 { animation-delay: 1.0s; }
    
    @keyframes fadeInUp {
      to { opacity: 1; transform: translateY(0); }
    }
    
    @keyframes fadeIn {
      to { opacity: 1; }
    }
  }
</style>
