---
const links = [
	{ href: '/', label: 'Home' },
	{ href: '/cv', label: 'CV' },
	{ href: '/projects', label: 'Projects' },
	{ href: '/hall-of-flame', label: 'Hall of Flame' },
	{ href: '/archive', label: 'Archive' },
	{ href: '/contact', label: 'Contact' },
];
---

<nav class="py-12 border-b border-ink/10 dark:border-tungsten/10">
	<ul class="flex flex-wrap gap-x-8 gap-y-4 justify-center">
		{links.map((link) => (
			<li>
				<a 
					href={link.href}
					class="text-sm uppercase tracking-[0.2em] font-mono hover:text-flame dark:hover:text-glow-blue transition-colors relative group"
				>
					{link.label}
					<span class="absolute -bottom-1 left-0 w-0 h-px bg-flame dark:bg-glow-blue transition-all duration-300 group-hover:w-full"></span>
				</a>
			</li>
		))}
	</ul>
</nav>
