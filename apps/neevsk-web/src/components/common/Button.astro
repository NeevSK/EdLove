---
export interface Props {
  variant?: 'primary' | 'secondary' | 'ghost';
  href?: string;
  class?: string;
  [key: string]: any;
}

const { variant = 'primary', href, class: className, ...rest } = Astro.props;
const Tag = href ? 'a' : 'button';
---

<Tag
  class:list={['btn', `btn-${variant}`, className]}
  href={href}
  {...rest}
>
  <span class="btn-content">
    <slot />
  </span>
  <span class="btn-shine"></span>
  <span class="btn-glow"></span>
</Tag>

<style lang="scss">
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 14px 32px;
    border-radius: var(--border-radius);
    font-weight: 600;
    font-size: 1rem;
    cursor: pointer;
    transition: all var(--transition-speed) var(--ease-smooth);
    text-decoration: none;
    border: none;
    font-family: inherit;
    position: relative;
    overflow: hidden;
    letter-spacing: 0.02em;

    &::before {
      content: '';
      position: absolute;
      top: 50%;
      left: 50%;
      width: 0;
      height: 0;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.3);
      transform: translate(-50%, -50%);
      transition: width 0.6s ease, height 0.6s ease;
    }

    &:active::before {
      width: 300px;
      height: 300px;
    }

    .btn-content {
      position: relative;
      z-index: 2;
    }

    .btn-shine {
      position: absolute;
      top: 0;
      left: -100%;
      width: 50%;
      height: 100%;
      background: linear-gradient(
        90deg,
        transparent 0%,
        rgba(255, 255, 255, 0.4) 50%,
        transparent 100%
      );
      transform: skewX(-25deg);
      transition: left 0.6s ease;
      z-index: 1;
    }

    .btn-glow {
      position: absolute;
      top: -50%;
      left: -50%;
      width: 200%;
      height: 200%;
      background: radial-gradient(
        circle,
        rgba(255, 255, 255, 0.2) 0%,
        transparent 70%
      );
      opacity: 0;
      transition: opacity 0.4s ease;
      z-index: 0;
    }

    &:hover {
      transform: translateY(-3px) scale(1.02);

      .btn-shine {
        left: 150%;
      }

      .btn-glow {
        opacity: 1;
      }
    }
  }

  .btn-primary {
    background: linear-gradient(
      135deg,
      var(--accent-teal) 0%,
      var(--accent-emerald) 100%
    );
    color: white;
    box-shadow: 0 4px 16px rgba(var(--accent-teal-rgb), 0.3);

    &:hover {
      box-shadow: 0 8px 24px rgba(var(--accent-teal-rgb), 0.5);
      background: linear-gradient(
        135deg,
        var(--accent-emerald) 0%,
        var(--accent-teal) 100%
      );
    }

    &:active {
      transform: translateY(-1px) scale(0.98);
    }
  }

  .btn-secondary {
    background: transparent;
    color: var(--accent-teal);
    border: 2px solid var(--accent-teal);
    box-shadow: 0 0 0 rgba(var(--accent-teal-rgb), 0);
    transition: all 0.4s var(--ease-smooth);

    .btn-glow {
      background: radial-gradient(
        circle,
        rgba(var(--accent-teal-rgb), 0.1) 0%,
        transparent 70%
      );
    }

    &:hover {
      background: var(--accent-teal);
      color: white;
      box-shadow: 0 8px 24px rgba(var(--accent-teal-rgb), 0.4);
      border-color: var(--accent-teal);
    }

    &:active {
      transform: translateY(-1px) scale(0.98);
    }
  }

  .btn-ghost {
    background: rgba(var(--accent-teal-rgb), 0.05);
    color: var(--accent-teal);
    border: 1px solid rgba(var(--accent-teal-rgb), 0.2);
    backdrop-filter: blur(10px);

    &:hover {
      background: rgba(var(--accent-teal-rgb), 0.1);
      border-color: rgba(var(--accent-teal-rgb), 0.4);
      box-shadow: 0 4px 16px rgba(var(--accent-teal-rgb), 0.2);
    }

    &:active {
      transform: translateY(-1px) scale(0.98);
    }
  }
</style>
