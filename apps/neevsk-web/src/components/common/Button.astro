---
export interface Props {
  variant?: 'primary' | 'secondary' | 'ghost';
  href?: string;
  class?: string;
  [key: string]: any;
}

const { variant = 'primary', href, class: className, ...rest } = Astro.props;
const Tag = href ? 'a' : 'button';
---

<Tag
  class:list={['btn', `btn-${variant}`, className]}
  href={href}
  {...rest}
>
  <span class="btn-content">
    <slot />
  </span>
</Tag>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 12px 24px;
    border-radius: var(--border-radius);
    font-weight: 500;
    font-size: 1rem;
    cursor: pointer;
    transition: all var(--transition-speed) var(--ease);
    text-decoration: none;
    border: none;
    background: none;
    font-family: inherit;
  }
  
  .btn-primary {
    background: var(--color-primary);
    color: var(--color-background);
    box-shadow: var(--shadow-sm);
  }
  
  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
    opacity: 0.9;
  }
  
  .btn-secondary {
    background: transparent;
    color: var(--color-primary);
    border: 2px solid var(--color-primary);
  }
  
  .btn-secondary:hover {
    background: var(--color-primary);
    color: var(--color-background);
  }
  
  .btn-ghost {
    background: transparent;
    color: var(--color-primary);
  }
  
  .btn-ghost:hover {
    background: rgba(0, 0, 0, 0.05); /* Generic hover, can be improved per theme */
  }
</style>
