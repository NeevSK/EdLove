    <div class="footer-links">
      <div class="footer-column">
        <h4>Explore</h4>
        <a href="/personal" class="footer-link">Personal</a>
        <a href="/intellectual" class="footer-link">Intellectual</a>
        <a href="/professional" class="footer-link">Professional</a>
        <a href="/library" class="footer-link">Library</a>
        <a href="/connect" class="footer-link">Connect</a>
      </div>

      <div class="footer-column">
        <h4>Quick Links</h4>
        <a href="https://gurudevi.edlove.org" class="footer-link" target="_blank" rel="noopener noreferrer">Gurudevi</a>
        <a href="https://edlove.org" class="footer-link" target="_blank" rel="noopener noreferrer">EdLove</a>
        <a href="https://intuituilabs.edlove.org" class="footer-link" target="_blank" rel="noopener noreferrer">Intuitui Labs</a>
