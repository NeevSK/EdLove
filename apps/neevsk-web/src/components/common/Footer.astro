---
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-content">
    <div class="footer-primary">
      <h3>Neev SK</h3>
      <p>Existential Cyberneticist</p>
      <p class="subtitle">Building the soul behind the machines</p>
    </div>
    
    <div class="footer-links">
      <div class="footer-column">
        <h4>Explore</h4>
        <a href="/personal">Personal</a>
        <a href="/intellectual">Intellectual</a>
        <a href="/professional">Professional</a>
        <a href="/library">Library</a>
      </div>
      
      <div class="footer-column">
        <h4>Connect</h4>
        <a href="mailto:neev@edlove.org">Email</a>
        <a href="#" target="_blank" rel="noopener noreferrer">LinkedIn</a>
        <a href="#" target="_blank" rel="noopener noreferrer">GitHub</a>
        <a href="#" target="_blank" rel="noopener noreferrer">Twitter/X</a>
      </div>
    </div>
  </div>
  
  <div class="footer-bottom">
    <p>&copy; {currentYear} Neev SK. Built with love and systems thinking.</p>
  </div>
</footer>

<style lang="scss">
  .site-footer {
    padding: 4rem 2rem 2rem;
    background-color: rgba(0, 0, 0, 0.03);
    border-top: 1px solid rgba(0, 0, 0, 0.05);
    margin-top: auto;
    
    .footer-content {
      max-width: 1400px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: 1fr;
      gap: 3rem;
      
      @media (min-width: 768px) {
        grid-template-columns: 1fr 2fr;
      }
    }
    
    .footer-primary {
      h3 {
        font-size: 1.5rem;
        margin-bottom: 0.5rem;
      }
      
      p {
        font-size: 0.95rem;
        opacity: 0.8;
      }
      
      .subtitle {
        margin-top: 0.5rem;
        font-style: italic;
        opacity: 0.6;
      }
    }
    
    .footer-links {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
      
      h4 {
        font-size: 0.9rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin-bottom: 1rem;
        opacity: 0.5;
      }
      
      a {
        display: block;
        margin-bottom: 0.75rem;
        font-size: 0.95rem;
        transition: opacity 0.2s ease;
        
        &:hover {
          opacity: 0.7;
        }
      }
    }
    
    .footer-bottom {
      max-width: 1400px;
      margin: 4rem auto 0;
      padding-top: 2rem;
      border-top: 1px solid rgba(0, 0, 0, 0.05);
      font-size: 0.85rem;
      opacity: 0.5;
      text-align: center;
      
      @media (min-width: 768px) {
        text-align: left;
      }
    }
  }
</style>
