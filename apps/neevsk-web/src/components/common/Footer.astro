  <div class="footer-bottom">
    <p>&copy; {currentYear} NeevSK. Built with love and systems thinking.</p>
  </div>

  <!-- Scroll to Top Button -->
  <button class="scroll-to-top" id="scrollToTop" aria-label="Scroll to top">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <polyline points="18 15 12 9 6 15"></polyline>
    </svg>
  </button>
</footer>

<style lang="scss">
  .site-footer {
    padding: 6rem 2rem 3rem;
    background: linear-gradient(
      180deg,
      rgba(var(--accent-teal-rgb), 0.02) 0%,
      rgba(var(--accent-purple-rgb), 0.01) 100%
    );
    border-top: 1px solid rgba(var(--accent-teal-rgb), 0.1);
    margin-top: auto;
    position: relative;

    .footer-content {
      max-width: 1400px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: 1fr;
      gap: 4rem;

      @media (min-width: 768px) {
        grid-template-columns: 1fr 2fr;
      }
    }

    .footer-primary {
      h3 {
        font-size: 1.8rem;
        margin-bottom: 0.5rem;
        background: linear-gradient(
          135deg,
          var(--color-text) 0%,
          var(--accent-teal) 100%
        );
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        font-weight: 700;
      }

      p {
        font-size: 0.95rem;
        opacity: 0.85;
        color: var(--color-secondary);
      }

      .subtitle {
        margin-top: 0.5rem;
        font-style: italic;
        opacity: 0.7;
      }

      .social-links {
        display: flex;
        gap: 1.2rem;
        margin-top: 1.5rem;
        flex-wrap: wrap;

        .social-link {
          display: inline-flex;
          align-items: center;
          justify-content: center;
          width: 44px;
          height: 44px;
          border-radius: 50%;
          background: rgba(var(--accent-teal-rgb), 0.1);
          border: 1px solid rgba(var(--accent-teal-rgb), 0.2);
          color: var(--accent-teal);
          transition: all 0.3s var(--ease-smooth);
          position: relative;

          svg {
            width: 20px;
            height: 20px;
          }

          &:hover {
            transform: translateY(-4px) scale(1.1);
            background: linear-gradient(
              135deg,
              rgba(var(--accent-teal-rgb), 0.2),
              rgba(var(--accent-emerald-rgb), 0.15)
            );
            border-color: var(--accent-teal);
            box-shadow: 0 8px 20px rgba(var(--accent-teal-rgb), 0.3);
          }

          &.github {
            &:hover {
              background: #1a1a1a;
              color: white;
            }
          }

          &.twitter {
            &:hover {
              background: rgba(0, 0, 0, 0.8);
              color: white;
              border-color: black;
            }
          }

          &.discord {
            &:hover {
              background: #5865f2;
              color: white;
              border-color: #5865f2;
            }
          }

          &.bluesky {
            &:hover {
              background: linear-gradient(135deg, #1185fe, #00b0fd);
              color: white;
              border-color: #1185fe;
            }
          }

          &.linkedin {
            &:hover {
              background: #0a66c2;
              color: white;
              border-color: #0a66c2;
            }
          }
        }
      }
    }

    .footer-links {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 3rem;

      @media (max-width: 768px) {
        grid-template-columns: 1fr;
      }

      h4 {
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        margin-bottom: 1.5rem;
        color: var(--accent-teal);
        font-weight: 600;
        opacity: 0.9;
      }

      .footer-link {
        display: block;
        margin-bottom: 1rem;
        font-size: 0.95rem;
        color: var(--color-secondary);
        transition: all 0.3s var(--ease-smooth);
        position: relative;
        padding-bottom: 0.25rem;

        &::after {
          content: '';
          position: absolute;
          bottom: 0;
          left: 0;
          width: 0;
          height: 2px;
          background: linear-gradient(90deg, var(--accent-teal), var(--accent-emerald));
          transition: width 0.4s var(--ease-smooth);
        }

        &:hover {
          color: var(--accent-teal);
          transform: translateX(4px);

          &::after {
            width: 100%;
          }
        }
      }
    }

    .footer-bottom {
      max-width: 1400px;
      margin: 4rem auto 0;
      padding-top: 2rem;
      border-top: 1px solid rgba(var(--accent-teal-rgb), 0.1);
      font-size: 0.85rem;
      opacity: 0.7;
      text-align: center;
      color: var(--color-secondary);

      @media (min-width: 768px) {
        text-align: left;
      }
    }

    .scroll-to-top {
      position: fixed;
      bottom: 2rem;
      right: 2rem;
      width: 48px;
      height: 48px;
      border-radius: 50%;
      background: linear-gradient(135deg, var(--accent-teal), var(--accent-emerald));
      border: 1px solid rgba(var(--accent-teal-rgb), 0.3);
      color: white;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      opacity: 0;
      pointer-events: none;
      transition: all 0.3s var(--ease-smooth);
      z-index: 999;
      box-shadow: 0 8px 24px rgba(var(--accent-teal-rgb), 0.3);

      &.visible {
        opacity: 1;
        pointer-events: all;

        &:hover {
          transform: translateY(-4px) scale(1.1);
          box-shadow: 0 12px 32px rgba(var(--accent-teal-rgb), 0.5);
        }

        &:active {
          transform: translateY(-2px) scale(1.05);
        }
      }

      svg {
        width: 24px;
        height: 24px;
        stroke: white;
      }
    }
  }
</style>
