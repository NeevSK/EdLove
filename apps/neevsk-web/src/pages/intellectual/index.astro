---
import TwilightLayout from '../../layouts/TwilightLayout.astro';
---

<TwilightLayout title="Intellectual" description="Existential Cyberneticist - Philosophy, Systems, Mind">
  <div class="intellectual-container">
    <!-- HERO SECTION -->
    <header class="intellectual-hero scroll-fade-in">
      <div class="hero-content">
        <h1 class="hero-title">Existential Cyberneticist</h1>
        <p class="hero-subtitle">Examining human condition within structures, physics, and living systems</p>
        <div class="hero-description">
          <p>
            I think at the intersection of:
          </p>
          <div class="domains-grid">
            <span class="domain">Psychology</span>
            <span class="domain">Psychoanalysis</span>
            <span class="domain">Political Economy</span>
            <span class="domain">Sociology</span>
            <span class="domain">Systems Thinking</span>
            <span class="domain">Cybernetics</span>
            <span class="domain">Enactivism</span>
            <span class="domain">Thermodynamics</span>
            <span class="domain">Philosophy</span>
            <span class="domain">Arrow of Time</span>
          </div>
        </div>
      </div>

      <!-- Decorative eccentric elements -->
      <div class="hero-decoration">
        <div class="spiral-1"></div>
        <div class="spiral-2"></div>
        <div class="nodes-network"></div>
      </div>
    </header>

    <!-- OWN THOUGHTS SECTION -->
    <section class="own-thoughts scroll-fade-in">
      <h2>Core Thoughts</h2>
      <div class="thoughts-grid">
        <div class="thought-card">
          <div class="thought-quote">
            "Life is a dissipative structure trying to survive against entropy"
          </div>
          <div class="thought-source">— Thermodynamic truth</div>
        </div>

        <div class="thought-card">
          <div class="thought-quote">
            "I - Thou is the divine human encounter, mediated through impedance matching"
          </div>
          <div class="thought-source">— Martin Buber (reinterpreted)</div>
        </div>

        <div class="thought-card">
          <div class="thought-quote">
            "Life ratchet is ticking forward"
          </div>
          <div class="thought-source">— Against entropy's arrow</div>
        </div>

        <div class="thought-card">
          <div class="thought-quote">
            "Topological nature of human existence and siloed epistemic domains?"
          </div>
          <div class="thought-source">— Unsolved inquiry</div>
        </div>

        <div class="thought-card">
          <div class="thought-quote">
            "Power is relational, generative, non-zero sum game"
          </div>
          <div class="thought-source">— Against scarcity thinking</div>
        </div>
      </div>
    </section>

    <!-- FRAMEWORKS SECTION -->
    <section class="frameworks scroll-fade-in">
      <h2>Frameworks & Theories</h2>
      <div class="frameworks-grid">
        <div class="framework-card primary">
          <div class="framework-title">Devneevma Pressure Theory</div>
          <div class="framework-description">
            Understanding how systemic pressure creates psychological effects and vice versa
          </div>
          <div class="framework-status">In development</div>
        </div>

        <div class="framework-card secondary">
          <div class="framework-title">Devneevma Capital Theory</div>
          <div class="framework-description">
            Examining how different forms of capital (symbolic, cultural, material) interact
          </div>
          <div class="framework-status">In development</div>
        </div>

        <div class="framework-card tertiary">
          <div class="framework-title">Thermodynamic-Semiotic Theory</div>
          <div class="framework-description">
            Bridging physical laws of entropy with meaning-making and symbolic systems
          </div>
          <div class="framework-status">In development</div>
        </div>

        <div class="framework-card accent">
          <div class="framework-title">Amla Model of Human Existence</div>
          <div class="framework-description">
            Integrated understanding of human being across scales and systems
          </div>
          <div class="framework-status">In development</div>
        </div>
      </div>
    </section>

    <!-- PHILOSOPHICAL LINEAGE SECTION -->
    <section class="lineage-section scroll-fade-in">
      <h2>Philosophical Lineage</h2>
      <p class="lineage-intro">
        The thinkers and traditions that shaped this worldview, from Buddha to contemporary thought
      </p>

      <div class="lineage-container">
        <!-- Root -->
        <div class="lineage-branch root">
          <div class="branch-header">🌺 The Buddhist Root</div>
          <p>
            Dukkha (suffering as structure), Anatta (non-self), Pratītyasamutpāda (dependent origination).
            Liberation through insight, not escape.
          </p>
        </div>

        <!-- Inner World Lineages -->
        <div class="lineage-branch inner-world">
          <div class="branch-header">🧠 Inner World Lineages</div>
          <div class="lineage-items">
            <div class="item">
              <strong>Psychoanalytic:</strong> Freud → Lacan → Žižek → Deepthi. Unconscious has meaning. Language structures desire. Ideology critique.
            </div>
            <div class="item">
              <strong>Relational/Kleinian:</strong> Klein → Bowlby → Winnicott. Attachment patterns. Hope through connection. Then recognized limitations.
            </div>
            <div class="item">
              <strong>Typological:</strong> Jung → MBTI. INFJ cognitive structure. Difference without pathology.
            </div>
            <div class="item">
              <strong>Semiotic/Post-structural:</strong> Saussure, Peirce, Foucault, Bourdieu. How meaning is made. Power through discourse. Habitus.
            </div>
          </div>
        </div>

        <!-- Outer World Lineages -->
        <div class="lineage-branch outer-world">
          <div class="branch-header">🌍 Outer World Lineages</div>
          <div class="lineage-items">
            <div class="item">
              <strong>World-Systems:</strong> Wallerstein. Core-periphery. Global asymmetry is structural.
            </div>
            <div class="item">
              <strong>Postcolonial:</strong> Fanon, Said, Spivak, Chakrabarty. Epistemic violence. Decolonization. Sri Lankan positioning.
            </div>
            <div class="item">
              <strong>Institutional Critique:</strong> Ivan Illich (birthday twin!), Goffman, Szasz. Dignity over diagnosis.
            </div>
            <div class="item">
              <strong>Thermodynamics:</strong> Prigogine, Kauffman. Physical foundation. Dissipative structures. Self-organization.
            </div>
          </div>
        </div>

        <!-- Bridging Lineages -->
        <div class="lineage-branch bridging">
          <div class="branch-header">🧩 Bridging Lineages</div>
          <div class="lineage-items">
            <div class="item">
              <strong>Systems Thinking:</strong> Meadows, Bateson, Forrester. Ecology of mind. Feedback loops.
            </div>
            <div class="item">
              <strong>Cybernetics:</strong> Von Foerster, Bateson. Observer included. Ethics explicit.
            </div>
            <div class="item">
              <strong>Process Philosophy:</strong> Whitehead, Bergson, Deleuze. Reality as becoming. Relational ontology.
            </div>
            <div class="item">
              <strong>Enactivism:</strong> Varela, Thompson, Maturana. Cognition brings forth world. Embodied action.
            </div>
          </div>
        </div>

        <!-- Ethics Branch -->
        <div class="lineage-branch ethics">
          <div class="branch-header">💫 Positioning & Ethics</div>
          <div class="lineage-items">
            <div class="item">
              <strong>Buber:</strong> I-Thou vs. I-It. Genuine relation. The Between is real.
            </div>
            <div class="item">
              <strong>Levinas:</strong> Infinite responsibility. The Face of the Other. Responsibility before freedom.
            </div>
            <div class="item">
              <strong>Butler:</strong> Precarity. Interdependence is primary. Shared vulnerability.
            </div>
            <div class="item">
              <strong>Haraway:</strong> Situated knowledges. Staying with trouble. Response-ability.
            </div>
          </div>
        </div>
      </div>

      <div class="lineage-note">
        <p>
          <strong>The Synthesis:</strong> These lineages aren't separate. They're woven together through centuries of dialogue.
          Buddhist anatta resonates with process philosophy becoming. Psychoanalytic unconscious connects to Foucauldian discourse.
          World-systems asymmetry maps onto family trauma maps onto thermodynamic necessity.
        </p>
        <p>
          For complete detailed lineage map with all thinkers, their contexts, contributions, and how they integrate,
          see the <em>Philosophical Lineage Document</em>.
        </p>
      </div>
    </section>

    <!-- FUTURE WORK -->
    <section class="future-work scroll-fade-in">
      <h2>Ongoing Inquiry</h2>
      <div class="inquiry-list">
        <div class="inquiry-item">
          How do thermodynamic principles of dissipative structures apply to psychological and social systems?
        </div>
        <div class="inquiry-item">
          What is the relationship between symbolic violence and material extraction at global scale?
        </div>
        <div class="inquiry-item">
          Can we design systems that maintain I-Thou relating at scale without collapsing into I-It?
        </div>
        <div class="inquiry-item">
          How does enactivism help us understand the collapse from observation to action?
        </div>
        <div class="inquiry-item">
          What does it mean to be human in a world of competing systems?
        </div>
      </div>
    </section>
  </div>
</TwilightLayout>

<style lang="scss">
  .intellectual-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 4rem 2rem;
    position: relative;
  }

  // HERO SECTION
  .intellectual-hero {
    position: relative;
    margin-bottom: 6rem;
    overflow: hidden;

    .hero-content {
      position: relative;
      z-index: 2;
    }

    .hero-title {
      font-size: clamp(2.5rem, 8vw, 5rem);
      font-weight: 700;
      margin-bottom: 1rem;
      background: linear-gradient(
        135deg,
        var(--accent-purple) 0%,
        var(--accent-coral) 50%,
        var(--accent-purple) 100%
      );
      background-size: 200% auto;
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      animation: shimmer 8s ease-in-out infinite;
      letter-spacing: -0.02em;
    }

    .hero-subtitle {
      font-size: 1.5rem;
      color: var(--color-secondary);
      margin-bottom: 2rem;
      font-style: italic;
    }

    .hero-description {
      p {
        font-size: 1.1rem;
        margin-bottom: 1.5rem;
        color: var(--color-text);
      }
    }

    .domains-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
      gap: 1rem;
      margin-top: 2rem;

      .domain {
        padding: 0.75rem 1.25rem;
        background: linear-gradient(
          135deg,
          rgba(var(--accent-purple-rgb), 0.15),
          rgba(var(--accent-coral-rgb), 0.1)
        );
        border: 1px solid rgba(var(--accent-purple-rgb), 0.3);
        border-radius: 8px;
        color: var(--accent-purple);
        font-weight: 500;
        text-align: center;
        transition: all 0.3s ease;

        &:hover {
          background: linear-gradient(
            135deg,
            rgba(var(--accent-purple-rgb), 0.25),
            rgba(var(--accent-coral-rgb), 0.2)
          );
          border-color: var(--accent-purple);
          transform: translateY(-2px);
          box-shadow: 0 8px 20px rgba(var(--accent-purple-rgb), 0.2);
        }
      }
    }

    .hero-decoration {
      position: absolute;
      top: 0;
      right: 0;
      width: 100%;
      height: 100%;
      z-index: 1;
      opacity: 0.15;
      pointer-events: none;

      .spiral-1, .spiral-2 {
        position: absolute;
        border: 2px solid var(--accent-purple);
        border-radius: 50%;
        animation: spin 20s linear infinite;

        &.spiral-1 {
          width: 300px;
          height: 300px;
          top: -100px;
          right: -50px;
        }

        &.spiral-2 {
          width: 200px;
          height: 200px;
          bottom: -50px;
          right: 100px;
          animation-direction: reverse;
        }
      }

      .nodes-network {
        position: absolute;
        top: 50%;
        right: 20%;
        width: 400px;
        height: 400px;
        background-image:
          radial-gradient(circle at 20% 50%, rgba(var(--accent-purple-rgb), 0.3) 1px, transparent 1px),
          radial-gradient(circle at 60% 70%, rgba(var(--accent-coral-rgb), 0.3) 1px, transparent 1px),
          radial-gradient(circle at 80% 30%, rgba(var(--accent-purple-rgb), 0.3) 1px, transparent 1px);
        background-size: 100px 100px;
        opacity: 0.6;
        animation: drift 30s ease-in-out infinite;
      }
    }
  }

  // OWN THOUGHTS SECTION
  .own-thoughts {
    margin-bottom: 6rem;

    h2 {
      font-size: 2.5rem;
      margin-bottom: 3rem;
      color: var(--color-text);
      font-weight: 700;
    }

    .thoughts-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 2rem;

      .thought-card {
        padding: 2rem;
        background: linear-gradient(
          135deg,
          rgba(var(--accent-purple-rgb), 0.08),
          rgba(var(--accent-coral-rgb), 0.05)
        );
        border: 1px solid rgba(var(--accent-purple-rgb), 0.2);
        border-radius: 12px;
        transition: all 0.4s ease;
        position: relative;
        overflow: hidden;

        &::before {
          content: '';
          position: absolute;
          top: 0;
          left: 0;
          width: 100%;
          height: 100%;
          background: radial-gradient(
            circle at 50% 0%,
            rgba(var(--accent-purple-rgb), 0.1),
            transparent 60%
          );
          opacity: 0;
          transition: opacity 0.4s ease;
        }

        &:hover {
          transform: translateY(-8px);
          box-shadow: 0 20px 40px rgba(var(--accent-purple-rgb), 0.15);
          border-color: var(--accent-purple);

          &::before {
            opacity: 1;
          }

          .thought-quote {
            color: var(--accent-purple);
          }
        }

        .thought-quote {
          font-size: 1.1rem;
          font-style: italic;
          color: var(--color-text);
          margin-bottom: 1rem;
          transition: color 0.3s ease;
          position: relative;
          z-index: 1;
          line-height: 1.8;
        }

        .thought-source {
          font-size: 0.9rem;
          color: var(--accent-coral);
          opacity: 0.8;
          font-family: var(--font-mono);
        }
      }
    }
  }

  // FRAMEWORKS SECTION
  .frameworks {
    margin-bottom: 6rem;

    h2 {
      font-size: 2.5rem;
      margin-bottom: 3rem;
      color: var(--color-text);
      font-weight: 700;
    }

    .frameworks-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 2rem;

      .framework-card {
        padding: 2rem;
        border-radius: 12px;
        transition: all 0.4s ease;
        position: relative;
        border: 2px solid;
        overflow: hidden;

        &::before {
          content: '';
          position: absolute;
          top: -50%;
          right: -50%;
          width: 200px;
          height: 200px;
          border-radius: 50%;
          opacity: 0;
          transition: opacity 0.4s ease;
          z-index: 0;
        }

        .framework-title {
          font-size: 1.3rem;
          font-weight: 700;
          margin-bottom: 0.75rem;
          position: relative;
          z-index: 1;
        }

        .framework-description {
          font-size: 0.95rem;
          line-height: 1.6;
          margin-bottom: 1rem;
          opacity: 0.9;
          position: relative;
          z-index: 1;
        }

        .framework-status {
          font-size: 0.8rem;
          text-transform: uppercase;
          letter-spacing: 0.05em;
          font-weight: 600;
          opacity: 0.7;
          position: relative;
          z-index: 1;
        }

        &:hover {
          transform: translateY(-8px);

          &::before {
            opacity: 0.8;
          }
        }

        &.primary {
          background: linear-gradient(135deg, rgba(var(--accent-purple-rgb), 0.1), rgba(var(--accent-purple-rgb), 0.05));
          border-color: var(--accent-purple);
          color: var(--color-text);

          &::before {
            background: radial-gradient(circle, rgba(var(--accent-purple-rgb), 0.2), transparent);
          }

          &:hover {
            box-shadow: 0 20px 40px rgba(var(--accent-purple-rgb), 0.2);
          }
        }

        &.secondary {
          background: linear-gradient(135deg, rgba(var(--accent-coral-rgb), 0.1), rgba(var(--accent-coral-rgb), 0.05));
          border-color: var(--accent-coral);
          color: var(--color-text);

          &::before {
            background: radial-gradient(circle, rgba(var(--accent-coral-rgb), 0.2), transparent);
          }

          &:hover {
            box-shadow: 0 20px 40px rgba(var(--accent-coral-rgb), 0.2);
          }
        }

        &.tertiary {
          background: linear-gradient(135deg, rgba(var(--accent-gold-rgb), 0.1), rgba(var(--accent-gold-rgb), 0.05));
          border-color: var(--accent-gold);
          color: var(--color-text);

          &::before {
            background: radial-gradient(circle, rgba(var(--accent-gold-rgb), 0.2), transparent);
          }

          &:hover {
            box-shadow: 0 20px 40px rgba(var(--accent-gold-rgb), 0.2);
          }
        }

        &.accent {
          background: linear-gradient(135deg, rgba(var(--accent-emerald-rgb), 0.1), rgba(var(--accent-emerald-rgb), 0.05));
          border-color: var(--accent-emerald);
          color: var(--color-text);

          &::before {
            background: radial-gradient(circle, rgba(var(--accent-emerald-rgb), 0.2), transparent);
          }

          &:hover {
            box-shadow: 0 20px 40px rgba(var(--accent-emerald-rgb), 0.2);
          }
        }
      }
    }
  }

  // PHILOSOPHICAL LINEAGE SECTION
  .lineage-section {
    margin-bottom: 6rem;

    h2 {
      font-size: 2.5rem;
      margin-bottom: 1rem;
      color: var(--color-text);
      font-weight: 700;
    }

    .lineage-intro {
      font-size: 1.1rem;
      color: var(--color-secondary);
      margin-bottom: 3rem;
      max-width: 800px;
    }

    .lineage-container {
      display: flex;
      flex-direction: column;
      gap: 2rem;

      .lineage-branch {
        padding: 2rem;
        border-radius: 12px;
        background: linear-gradient(135deg, rgba(var(--accent-purple-rgb), 0.05), rgba(var(--accent-coral-rgb), 0.03));
        border: 1px solid rgba(var(--accent-purple-rgb), 0.15);
        transition: all 0.3s ease;

        &:hover {
          border-color: rgba(var(--accent-purple-rgb), 0.3);
          box-shadow: 0 10px 30px rgba(var(--accent-purple-rgb), 0.1);
        }

        .branch-header {
          font-size: 1.3rem;
          font-weight: 700;
          margin-bottom: 1.5rem;
          color: var(--accent-purple);
        }

        p {
          color: var(--color-text);
          line-height: 1.8;
          margin-bottom: 1rem;
          opacity: 0.95;
        }

        .lineage-items {
          display: grid;
          gap: 1rem;

          .item {
            padding: 1rem;
            background: rgba(var(--accent-purple-rgb), 0.05);
            border-left: 3px solid var(--accent-purple);
            border-radius: 4px;
            color: var(--color-text);
            font-size: 0.95rem;
            line-height: 1.6;

            strong {
              color: var(--accent-purple);
              font-weight: 600;
            }
          }
        }

        &.root {
          background: linear-gradient(135deg, rgba(var(--accent-teal-rgb), 0.1), rgba(var(--accent-emerald-rgb), 0.05));
          border-color: rgba(var(--accent-teal-rgb), 0.2);

          .branch-header {
            color: var(--accent-teal);
          }

          .lineage-items .item {
            border-left-color: var(--accent-teal);

            strong {
              color: var(--accent-teal);
            }
          }
        }

        &.inner-world {
          background: linear-gradient(135deg, rgba(var(--accent-purple-rgb), 0.08), rgba(var(--accent-purple-rgb), 0.04));
        }

        &.outer-world {
          background: linear-gradient(135deg, rgba(var(--accent-coral-rgb), 0.08), rgba(var(--accent-coral-rgb), 0.04));

          .branch-header {
            color: var(--accent-coral);
          }

          .lineage-items .item {
            border-left-color: var(--accent-coral);

            strong {
              color: var(--accent-coral);
            }
          }
        }

        &.bridging {
          background: linear-gradient(135deg, rgba(var(--accent-gold-rgb), 0.08), rgba(var(--accent-gold-rgb), 0.04));

          .branch-header {
            color: var(--accent-gold);
          }

          .lineage-items .item {
            border-left-color: var(--accent-gold);

            strong {
              color: var(--accent-gold);
            }
          }
        }

        &.ethics {
          background: linear-gradient(135deg, rgba(var(--accent-emerald-rgb), 0.08), rgba(var(--accent-emerald-rgb), 0.04));

          .branch-header {
            color: var(--accent-emerald);
          }

          .lineage-items .item {
            border-left-color: var(--accent-emerald);

            strong {
              color: var(--accent-emerald);
            }
          }
        }
      }
    }

    .lineage-note {
      margin-top: 3rem;
      padding: 2rem;
      background: linear-gradient(135deg, rgba(var(--accent-purple-rgb), 0.08), rgba(var(--accent-coral-rgb), 0.05));
      border: 1px solid rgba(var(--accent-purple-rgb), 0.2);
      border-radius: 12px;
      border-left: 4px solid var(--accent-purple);

      p {
        color: var(--color-text);
        line-height: 1.8;
        margin-bottom: 1rem;

        &:last-child {
          margin-bottom: 0;
        }

        strong {
          color: var(--accent-purple);
        }

        em {
          color: var(--accent-coral);
          font-style: italic;
        }
      }
    }
  }

  // FUTURE WORK SECTION
  .future-work {
    margin-bottom: 4rem;

    h2 {
      font-size: 2.5rem;
      margin-bottom: 3rem;
      color: var(--color-text);
      font-weight: 700;
    }

    .inquiry-list {
      display: flex;
      flex-direction: column;
      gap: 1.5rem;

      .inquiry-item {
        padding: 1.5rem;
        background: linear-gradient(135deg, rgba(var(--accent-purple-rgb), 0.08), rgba(var(--accent-coral-rgb), 0.05));
        border: 1px solid rgba(var(--accent-purple-rgb), 0.2);
        border-left: 4px solid var(--accent-purple);
        border-radius: 8px;
        color: var(--color-text);
        line-height: 1.8;
        font-size: 1.05rem;
        transition: all 0.3s ease;

        &:hover {
          border-left-color: var(--accent-coral);
          background: linear-gradient(135deg, rgba(var(--accent-purple-rgb), 0.12), rgba(var(--accent-coral-rgb), 0.08));
          transform: translateX(4px);
        }
      }
    }
  }

  // ANIMATIONS
  @keyframes spin {
    0% {
      transform: rotate(0deg);
    }
    100% {
      transform: rotate(360deg);
    }
  }

  @keyframes drift {
    0%, 100% {
      transform: translateY(0px) translateX(0px);
    }
    50% {
      transform: translateY(20px) translateX(10px);
    }
  }

  @keyframes shimmer {
    0%, 100% {
      background-position: 200% center;
    }
    50% {
      background-position: -200% center;
    }
  }
</style>
