---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import RealitySwitch from '../components/RealitySwitch.astro';

const milestones = [
	{
		year: "199X",
		title: "Initial Observation",
		description: "Arrival into the feedback loop. Curiosity initialized."
	},
	{
		year: "201X",
		title: "The Great Fracture",
		description: "Discovery of the gap between system performance and human soul. Transition toward radical education."
	},
	{
		year: "2024",
		title: "Polymath Initialization",
		description: "Building the infrastructure for collective intelligence."
	},
	{
		year: "2026",
		title: "Coherence",
		description: "The uncollapsed wave function begins to stabilize at EdLove."
	}
];
---

<BaseLayout title="Journey">
	<RealitySwitch />
	
	<main class="max-w-4xl mx-auto px-6 pb-24">
		<Navigation />
		
		<header class="mt-24 mb-32">
			<h1 class="text-xs uppercase tracking-[0.8em] font-mono text-[var(--text-main)]/40 mb-6">Process // Narrative</h1>
			<p class="text-5xl font-serif dark:font-mono leading-tight tracking-tight max-w-2xl">
				A timeline of uncollapsed potential and system transitions.
			</p>
		</header>

		<div class="relative">
			<div class="absolute left-[3px] top-0 bottom-0 w-px bg-[var(--text-main)]/5"></div>
			
			<div class="space-y-32">
				{milestones.map(m => (
					<div class="relative pl-12 group">
						<div class="absolute left-0 top-2 w-2 h-2 rounded-full bg-[var(--text-main)]/10 group-hover:bg-[var(--accent-secondary)] transition-colors duration-500"></div>
						
						<div class="flex flex-col md:flex-row gap-8 items-start">
							<span class="text-xl font-mono text-[var(--accent-secondary)] opacity-40 group-hover:opacity-100 transition-opacity">
								{m.year}
							</span>
							<div class="flex-1">
								<h2 class="text-3xl font-serif dark:font-mono mb-4 group-hover:text-[var(--accent-secondary)] transition-colors">
									{m.title}
								</h2>
								<p class="text-lg font-serif dark:font-mono italic dark:not-italic text-[var(--text-main)]/60 leading-relaxed max-w-xl">
									{m.description}
								</p>
							</div>
						</div>
					</div>
				))}
			</div>
		</div>

		<section class="mt-48 p-16 border border-[var(--text-main)]/10 text-center opacity-40 italic font-serif">
			"The journey is the feedback loop."
		</section>
	</main>
</BaseLayout>
