---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import RealitySwitch from '../components/RealitySwitch.astro';
---

<BaseLayout title="Contact">
	<RealitySwitch />
	
	<main class="max-w-4xl mx-auto px-6 pb-24 h-[80vh] flex flex-col justify-center">
		<Navigation />
		
		<div class="mt-auto mb-auto text-center">
			<h1 class="text-6xl md:text-8xl font-serif dark:font-mono tracking-tighter mb-12 overflow-hidden">
				<span class="inline-block hover:italic transition-all duration-700 cursor-default">Connect.</span>
			</h1>

			<div class="flex flex-col md:flex-row gap-12 justify-center items-center">
				<a href="mailto:hello@neevsk.org" class="group">
					<span class="text-xs font-mono uppercase tracking-widest block opacity-40 mb-2">Email</span>
					<span class="text-2xl font-serif dark:font-mono group-hover:text-flame dark:group-hover:text-glow-blue transition-colors">hello@neevsk.org</span>
				</a>
				
				<div class="w-px h-12 bg-ink/10 dark:bg-tungsten/10 hidden md:block"></div>

				<a href="#" class="group">
					<span class="text-xs font-mono uppercase tracking-widest block opacity-40 mb-2">Digital Signal</span>
					<span class="text-2xl font-serif dark:font-mono group-hover:text-flame dark:group-hover:text-glow-blue transition-colors">@neevsk_waves</span>
				</a>
			</div>
		</div>
		
		<div class="mt-auto pt-12 border-t border-ink/5 dark:border-tungsten/5">
			<p class="text-[10px] font-mono uppercase tracking-[0.5em] text-center opacity-30">
				Waiting for resonance...
			</p>
		</div>
	</main>
</BaseLayout>
