---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import RealitySwitch from '../components/RealitySwitch.astro';
import { getCollection } from 'astro:content';

const archiveEntries = await getCollection('archive', ({ data }) => !data.draft);
archiveEntries.sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime());

const formatDate = (date: Date) => {
    return date.toLocaleDateString('en-CA', {
        year: 'numeric',
        month: '2-digit',
        day: '2-digit'
    }).replace(/-/g, '.');
};
---

<BaseLayout title="Archive">
	<RealitySwitch />
	
	<main class="max-w-4xl mx-auto px-6 pb-24">
		<Navigation />
		
		<header class="mt-24 mb-24">
			<h1 class="text-xs uppercase tracking-[0.8em] font-mono text-[var(--text-main)]/40 mb-6">Digital Archive</h1>
			<p class="text-5xl font-serif dark:font-mono leading-tight tracking-tight">
				A collection of uncollapsed thoughts and epistemic artifacts.
			</p>
		</header>

		<div class="space-y-4">
			{archiveEntries.map(entry => (
				<a href={`/archive/${entry.slug}`} class="group flex gap-8 py-8 border-b border-[var(--text-main)]/5 hover:bg-[var(--text-main)]/[0.01] transition-all duration-300">
					<span class="text-[10px] font-mono opacity-30 mt-2">{formatDate(entry.data.publishDate)}</span>
					<div class="flex-1">
						<h2 class="text-2xl font-serif dark:font-mono group-hover:text-[var(--accent-secondary)] transition-colors">
							{entry.data.title}
						</h2>
						<div class="flex gap-4 items-center mt-2">
							<span class="text-[10px] uppercase tracking-widest font-mono opacity-40">//{entry.data.subtitle || 'Fragment'}</span>
							{entry.data.tags.map(tag => (
								<span class="text-[8px] uppercase tracking-widest font-mono bg-[var(--text-main)]/5 px-2 py-0.5 rounded-full opacity-30 group-hover:opacity-60 transition-opacity">
									{tag}
								</span>
							))}
						</div>
					</div>
					<div class="hidden md:flex items-center opacity-0 group-hover:opacity-40 transition-opacity translate-x-4 group-hover:translate-x-0 duration-500">
						<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="0.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
					</div>
				</a>
			))}
		</div>
	</main>
</BaseLayout>
