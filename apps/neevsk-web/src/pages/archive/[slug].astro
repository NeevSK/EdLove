---
import { getCollection, render } from 'astro:content';
import Navigation from '../../components/Navigation.astro';
import RealitySwitch from '../../components/RealitySwitch.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { absoluteUrl } from '../../lib/site';

export async function getStaticPaths() {
  const archiveEntries = await getCollection('archive');
  return archiveEntries.map((entry) => ({
    params: { slug: entry.id.replace(/\.(md|mdx)$/, '') },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const formatDate = (date: Date) => {
  return date
    .toLocaleDateString('en-CA', {
      year: 'numeric',
      month: '2-digit',
      day: '2-digit',
    })
    .replace(/-/g, '.');
};

const articleSlug = entry.id.replace(/\.(md|mdx)$/i, '');
const articleUrl = absoluteUrl(`/archive/${articleSlug}`);
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: entry.data.title,
  description: entry.data.subtitle ?? entry.data.title,
  url: articleUrl,
  datePublished: entry.data.publishDate.toISOString(),
  keywords: entry.data.tags ?? [],
  author: {
    '@type': 'Person',
    name: 'NeevSK',
  },
};
---

<BaseLayout title={`${entry.data.title} | NeevSK`} description={entry.data.subtitle ?? entry.data.title} structuredData={structuredData}>
	<RealitySwitch />
	
	<main class="max-w-3xl mx-auto px-6 pb-24">
		<Navigation />
		
		<article class="mt-24">
			<header class="mb-16">
				<div class="flex items-center gap-4 mb-8">
					<span class="text-[10px] font-mono opacity-40">{formatDate(entry.data.publishDate)}</span>
					<div class="h-px flex-1 bg-[var(--text-main)]/5"></div>
				</div>
				
				<h1 class="text-5xl md:text-7xl font-serif dark:font-mono leading-tight mb-6">
					{entry.data.title}
				</h1>
				
				{entry.data.subtitle && (
					<p class="text-2xl font-serif dark:font-mono italic dark:not-italic text-[var(--text-main)]/50">
						{entry.data.subtitle}
					</p>
				)}
			</header>

			<div class="prose prose-stone dark:prose-invert max-w-none font-serif dark:font-mono text-xl leading-relaxed text-[var(--text-main)]/80">
				<Content />
			</div>

			<footer class="mt-32 pt-12 border-t border-[var(--text-main)]/10">
				<div class="flex flex-wrap gap-4">
					{entry.data.tags.map(tag => (
						<span class="text-[10px] uppercase tracking-widest font-mono bg-[var(--text-main)]/5 px-3 py-1 rounded-full opacity-40">
							#{tag}
						</span>
					))}
				</div>
                <div class="mt-12">
                    <a href="/archive" class="text-xs uppercase tracking-[0.4em] font-mono hover:text-[var(--accent-secondary)] transition-colors">
                        ← Return to Archive
                    </a>
                </div>
			</footer>
		</article>
	</main>
</BaseLayout>

<style is:global>
	.prose h3 {
		font-family: var(--font-primary);
		font-size: 1.875rem;
		line-height: 2.25rem;
		margin-top: 3rem;
		margin-bottom: 1.5rem;
		color: var(--text-main);
	}
	.prose p {
		margin-bottom: 2rem;
	}
    .prose em, .prose i {
        font-style: italic;
    }
    :root.dark .prose em, :root.dark .prose i {
        font-style: normal;
    }
</style>
