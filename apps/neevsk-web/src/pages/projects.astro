---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import RealitySwitch from '../components/RealitySwitch.astro';

const projects = [
	{
		title: "Polymath Platform",
		description: "A monorepo for intelligent systems and personal tools. The parent ecosystem for all child apps.",
		year: "2024-Present",
		tags: ["Turbo", "Astro", "TypeScript"]
	},
	{
		title: "EdLove AI",
		description: "Human-centric educational agents designed to nurture the 'Soul' of learning.",
		year: "2025",
		tags: ["AI", "Svelte", "Ecology"]
	},
	{
		title: "Radical Life",
		description: "A philosophy-driven movement for divergent thinkers and epistemic architects.",
		year: "2023",
		tags: ["Philosophy", "Social Design"]
	}
];
---

<BaseLayout title="Projects">
	<RealitySwitch />
	
	<main class="max-w-4xl mx-auto px-6 pb-24">
		<Navigation />
		
		<header class="mt-24 mb-16">
			<h1 class="text-4xl font-serif dark:font-mono mb-4 italic dark:not-italic">Selected Works</h1>
			<p class="text-ink/60 dark:text-tungsten/60 font-serif dark:font-mono">
				A collection of digital artifacts, philosophical experiments, and cybernetic systems.
			</p>
		</header>

		<div class="space-y-12">
			{projects.map(project => (
				<article class="group border-l border-ink/10 dark:border-tungsten/10 pl-8 hover:border-flame dark:hover:border-glow-blue transition-colors">
					<div class="flex justify-between items-baseline mb-2">
						<h2 class="text-2xl font-serif dark:font-mono group-hover:text-flame dark:group-hover:text-glow-blue transition-colors">
							{project.title}
						</h2>
						<span class="text-[10px] font-mono opacity-40">{project.year}</span>
					</div>
					<p class="text-ink/70 dark:text-tungsten/70 font-serif dark:font-mono mb-6 leading-relaxed italic dark:not-italic">
						{project.description}
					</p>
					<div class="flex gap-4">
						{project.tags.map(tag => (
							<span class="text-[10px] uppercase tracking-widest font-mono opacity-50">//{tag}</span>
						))}
					</div>
				</article>
			))}
		</div>
	</main>
</BaseLayout>
