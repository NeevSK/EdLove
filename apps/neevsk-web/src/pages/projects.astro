---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import RealitySwitch from '../components/RealitySwitch.astro';
import { getCollection } from 'astro:content';

const projectEntries = await getCollection('projects', ({ data }) => !data.draft);
projectEntries.sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));
---

<BaseLayout title="Projects">
	<RealitySwitch />
	
	<main class="max-w-4xl mx-auto px-6 pb-24">
		<Navigation />
		
		<header class="mt-24 mb-16">
			<h1 class="text-5xl font-serif dark:font-mono mb-4 italic dark:not-italic">Selected Works</h1>
			<p class="text-[var(--text-main)]/60 font-serif dark:font-mono text-lg italic dark:not-italic">
				A collection of digital artifacts, philosophical experiments, and cybernetic systems.
			</p>
		</header>

		<div class="space-y-24">
			{projectEntries.map(project => (
				<article class="group border-l border-[var(--text-main)]/10 dark:border-[var(--text-main)]/10 pl-12 hover:border-[var(--accent-secondary)] transition-all duration-500">
					<div class="flex flex-col md:flex-row justify-between items-baseline mb-4 gap-2">
						<h2 class="text-3xl md:text-4xl font-serif dark:font-mono group-hover:text-[var(--accent-secondary)] transition-colors">
							{project.data.title}
						</h2>
						<span class="text-[10px] font-mono opacity-40">{project.data.role}</span>
					</div>
					<p class="text-[var(--text-main)]/70 font-serif dark:font-mono mb-8 leading-relaxed text-lg">
						{project.data.description}
					</p>
					<div class="flex flex-wrap gap-6">
						{project.data.tech.map(tag => (
							<span class="text-[10px] uppercase tracking-widest font-mono opacity-40 group-hover:opacity-100 transition-opacity">//{tag}</span>
						))}
					</div>
				</article>
			))}
		</div>
	</main>
</BaseLayout>
