---
import LightTechLayout from '../../layouts/LightTechLayout.astro';
---

<LightTechLayout title="Professional" description="Projects, Experience, Education">
  <div class="professional-container">
    <!-- HERO -->
    <header class="professional-hero scroll-fade-in">
      <h1>Building Systems That Serve</h1>
      <p>Projects, experience, and work that matters</p>
    </header>

    <!-- PROJECTS SECTION -->
    <section class="projects-section scroll-fade-in">
      <h2>Projects</h2>
      <div class="projects-grid">
        <a href="https://gurudevi.edlove.org" target="_blank" rel="noopener noreferrer" class="project-card primary">
          <div class="project-header">
            <div class="project-year">2026</div>
            <span class="project-status">Active</span>
          </div>
          <h3>🎓 Gurudevi</h3>
          <p>
            A digital sanctuary for teacher wellbeing. Designing ecosystems where educators can breathe, grow, and thrive.
            Building community, tools, and support for Sri Lankan educators.
          </p>
          <div class="tech-tags">
            <span>React Native</span>
            <span>Systems Design</span>
            <span>Teacher Wellbeing</span>
          </div>
          <span class="view-link">View Project →</span>
        </a>

        <a href="https://edlove.org" target="_blank" rel="noopener noreferrer" class="project-card secondary">
          <div class="project-header">
            <div class="project-year">2023</div>
            <span class="project-status">Active</span>
          </div>
          <h3>💚 EdLove</h3>
          <p>
            A movement for education reimagined. Building an ecosystem where education transforms through care,
            systems thinking, and technology that serves humanity.
          </p>
          <div class="tech-tags">
            <span>Foundation</span>
            <span>Education</span>
            <span>Community</span>
          </div>
          <span class="view-link">Learn More →</span>
        </a>

        <a href="https://intuituilabs.edlove.org" target="_blank" rel="noopener noreferrer" class="project-card tertiary">
          <div class="project-header">
            <div class="project-year">2026</div>
            <span class="project-status">Launching</span>
          </div>
          <h3>🧠 Intuitui Labs</h3>
          <p>
            Exploring consciousness, systems, and human flourishing. A studio for investigating how technology
            and philosophy can create transformative experiences.
          </p>
          <div class="tech-tags">
            <span>Research</span>
            <span>Systems</span>
            <span>Innovation</span>
          </div>
          <span class="view-link">Explore →</span>
        </a>
      </div>
    </section>

    <!-- EXPERIENCE SECTION -->
    <section class="experience-section scroll-fade-in">
      <h2>Experience</h2>
      <div class="experience-timeline">
        <div class="experience-item primary">
          <div class="item-header">
            <h3>Founder</h3>
            <div class="date-badge">2023 - 2026</div>
          </div>
          <p class="org">EdLove.org & Intuitui Labs</p>
          <p class="description">
            Founded and built the EdLove ecosystem and Intuitui Labs. Leading teacher wellbeing initiatives,
            designing systems that serve educators, and exploring consciousness through technology.
          </p>
        </div>

        <div class="experience-item secondary">
          <div class="item-header">
            <h3>Vice President</h3>
            <div class="date-badge">2025 - 2026</div>
          </div>
          <p class="org">Students Union, Faculty of Business @ University of Moratuwa</p>
          <p class="description">
            Leading student initiatives and advocating for positive change. Learning what it means to serve
            a community and build movements for transformation.
          </p>
        </div>

        <div class="experience-item tertiary">
          <div class="item-header">
            <h3>Management Trainee & Scrum Master</h3>
            <div class="date-badge">2022 - 2023</div>
          </div>
          <p class="org">Axcer Innovations (Pvt) Ltd</p>
          <p class="description">
            Played multiple roles: scrum master, finance, HR, QA, business analysis. Learned how systems
            work in practice and the challenges of scaling startups.
          </p>
        </div>
      </div>
    </section>

    <!-- EDUCATION SECTION -->
    <section class="education-section scroll-fade-in">
      <h2>Education</h2>
      <div class="education-grid">
        <div class="education-card primary">
          <div class="education-level">Undergraduate</div>
          <h3>BBsc in Business Analytics</h3>
          <p class="institution">University of Moratuwa</p>
          <p class="details">2023 - 2027</p>
          <p class="description">
            CGPA: 3.3. Minor in ERP. Learning to build systems that serve humans, not the other way around.
          </p>
        </div>

        <div class="education-card secondary">
          <div class="education-level">Secondary</div>
          <h3>Advanced Level Education</h3>
          <p class="institution">Nalanda College, Colombo 10</p>
          <p class="details">2013 - 2021</p>
          <p class="description">
            Scholarship recipient. Lived in hostel since age 11. Foundation for systems thinking and
            philosophical inquiry.
          </p>
        </div>

        <div class="education-card tertiary">
          <div class="education-level">Primary</div>
          <h3>Primary Education</h3>
          <p class="institution">Pannala National School</p>
          <p class="details">2008 - 2012</p>
          <p class="description">
            Where it began. Small town Sri Lanka. Education as pathway to possibility.
          </p>
        </div>
      </div>
    </section>

    <!-- SKILLS & INTERESTS -->
    <section class="skills-section scroll-fade-in">
      <h2>What I Do</h2>
      <div class="skills-grid">
        <div class="skill-category">
          <h3>💻 Technical</h3>
          <div class="skill-list">
            <span>React Native</span>
            <span>Full-Stack Development</span>
            <span>Systems Architecture</span>
            <span>Data Analysis</span>
            <span>Business Intelligence</span>
          </div>
        </div>

        <div class="skill-category">
          <h3>🧠 Conceptual</h3>
          <div class="skill-list">
            <span>Systems Thinking</span>
            <span>Philosophy</span>
            <span>Psychology</span>
            <span>Education Design</span>
            <span>Cybernetics</span>
          </div>
        </div>

        <div class="skill-category">
          <h3>🤝 Professional</h3>
          <div class="skill-list">
            <span>Product Management</span>
            <span>Scrum Mastery</span>
            <span>Team Leadership</span>
            <span>Strategic Planning</span>
            <span>Community Building</span>
          </div>
        </div>

        <div class="skill-category">
          <h3>✨ Unique</h3>
          <div class="skill-list">
            <span>INFJ Perspective</span>
            <span>Systems Intuition</span>
            <span>Philosophical Synthesis</span>
            <span>Empathetic Design</span>
            <span>Ethical Frameworks</span>
          </div>
        </div>
      </div>
    </section>
  </div>
</LightTechLayout>

<style lang="scss">
  .professional-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 4rem 2rem;
  }

  // HERO
  .professional-hero {
    text-align: center;
    margin-bottom: 6rem;

    h1 {
      font-size: clamp(2.5rem, 6vw, 4rem);
      font-weight: 700;
      margin-bottom: 1rem;
      background: linear-gradient(
        135deg,
        var(--accent-teal) 0%,
        var(--accent-sky) 100%
      );
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    p {
      font-size: 1.2rem;
      color: var(--color-secondary);
    }
  }

  // PROJECTS
  .projects-section {
    margin-bottom: 6rem;

    h2 {
      font-size: 2.5rem;
      margin-bottom: 3rem;
      color: var(--color-text);
    }

    .projects-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
      gap: 2rem;

      .project-card {
        padding: 2rem;
        border-radius: 12px;
        border: 2px solid;
        text-decoration: none;
        color: inherit;
        transition: all 0.4s ease;
        position: relative;
        overflow: hidden;

        &::before {
          content: '';
          position: absolute;
          top: -50%;
          right: -50%;
          width: 200px;
          height: 200px;
          border-radius: 50%;
          opacity: 0;
          transition: opacity 0.4s ease;
          z-index: 0;
        }

        &:hover {
          transform: translateY(-8px);

          &::before {
            opacity: 0.8;
          }

          h3 {
            transform: translateY(-2px);
          }

          .view-link {
            transform: translateX(4px);
          }
        }

        .project-header {
          display: flex;
          justify-content: space-between;
          align-items: center;
          margin-bottom: 1rem;
          position: relative;
          z-index: 1;

          .project-year {
            font-weight: 700;
            font-family: var(--font-mono);
            font-size: 1.3rem;
          }

          .project-status {
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            font-weight: 600;
            padding: 0.25rem 0.75rem;
            border-radius: 4px;
          }
        }

        h3 {
          font-size: 1.5rem;
          margin-bottom: 0.75rem;
          transition: transform 0.3s ease;
          position: relative;
          z-index: 1;
        }

        p {
          font-size: 0.95rem;
          line-height: 1.7;
          color: var(--color-secondary);
          margin-bottom: 1rem;
          position: relative;
          z-index: 1;
        }

        .tech-tags {
          display: flex;
          gap: 0.5rem;
          margin-bottom: 1.5rem;
          flex-wrap: wrap;
          position: relative;
          z-index: 1;

          span {
            font-size: 0.8rem;
            padding: 0.4rem 0.8rem;
            border-radius: 4px;
            font-weight: 500;
          }
        }

        .view-link {
          display: inline-block;
          font-weight: 600;
          transition: transform 0.3s ease;
          position: relative;
          z-index: 1;

          &::after {
            content: '';
            position: absolute;
            bottom: -2px;
            left: 0;
            width: 0;
            height: 2px;
            transition: width 0.3s ease;
          }

          &:hover::after {
            width: 100%;
          }
        }

        &.primary {
          background: linear-gradient(135deg, rgba(var(--accent-teal-rgb), 0.1), rgba(var(--accent-teal-rgb), 0.05));
          border-color: var(--accent-teal);
          color: var(--accent-teal);

          &::before {
            background: radial-gradient(circle, rgba(var(--accent-teal-rgb), 0.2), transparent);
          }

          .project-status {
            background: rgba(var(--accent-teal-rgb), 0.2);
          }

          .tech-tags span {
            background: rgba(var(--accent-teal-rgb), 0.15);
          }

          .view-link::after {
            background: var(--accent-teal);
          }

          &:hover {
            box-shadow: 0 20px 40px rgba(var(--accent-teal-rgb), 0.15);
          }
        }

        &.secondary {
          background: linear-gradient(135deg, rgba(var(--accent-sky-rgb), 0.1), rgba(var(--accent-sky-rgb), 0.05));
          border-color: var(--accent-sky);
          color: var(--accent-sky);

          &::before {
            background: radial-gradient(circle, rgba(var(--accent-sky-rgb), 0.2), transparent);
          }

          .project-status {
            background: rgba(var(--accent-sky-rgb), 0.2);
          }

          .tech-tags span {
            background: rgba(var(--accent-sky-rgb), 0.15);
          }

          .view-link::after {
            background: var(--accent-sky);
          }

          &:hover {
            box-shadow: 0 20px 40px rgba(var(--accent-sky-rgb), 0.15);
          }
        }

        &.tertiary {
          background: linear-gradient(135deg, rgba(var(--accent-emerald-rgb), 0.1), rgba(var(--accent-emerald-rgb), 0.05));
          border-color: var(--accent-emerald);
          color: var(--accent-emerald);

          &::before {
            background: radial-gradient(circle, rgba(var(--accent-emerald-rgb), 0.2), transparent);
          }

          .project-status {
            background: rgba(var(--accent-emerald-rgb), 0.2);
          }

          .tech-tags span {
            background: rgba(var(--accent-emerald-rgb), 0.15);
          }

          .view-link::after {
            background: var(--accent-emerald);
          }

          &:hover {
            box-shadow: 0 20px 40px rgba(var(--accent-emerald-rgb), 0.15);
          }
        }
      }
    }
  }

  // EXPERIENCE
  .experience-section {
    margin-bottom: 6rem;

    h2 {
      font-size: 2.5rem;
      margin-bottom: 3rem;
      color: var(--color-text);
    }

    .experience-timeline {
      display: flex;
      flex-direction: column;
      gap: 2rem;

      .experience-item {
        padding: 2rem;
        border-left: 4px solid;
        border-radius: 8px;
        background: linear-gradient(135deg, rgba(var(--accent-teal-rgb), 0.05), transparent);
        transition: all 0.3s ease;

        &:hover {
          box-shadow: 0 10px 30px rgba(var(--accent-teal-rgb), 0.1);
          transform: translateX(4px);
        }

        .item-header {
          display: flex;
          justify-content: space-between;
          align-items: baseline;
          margin-bottom: 0.5rem;
          gap: 1rem;

          h3 {
            font-size: 1.3rem;
            color: var(--color-text);
          }

          .date-badge {
            font-size: 0.85rem;
            font-family: var(--font-mono);
            opacity: 0.7;
            flex-shrink: 0;
          }
        }

        .org {
          font-weight: 600;
          margin-bottom: 0.75rem;
          font-size: 1rem;
        }

        .description {
          color: var(--color-secondary);
          line-height: 1.7;
        }

        &.primary {
          border-left-color: var(--accent-teal);

          .org {
            color: var(--accent-teal);
          }
        }

        &.secondary {
          border-left-color: var(--accent-sky);

          .org {
            color: var(--accent-sky);
          }
        }

        &.tertiary {
          border-left-color: var(--accent-emerald);

          .org {
            color: var(--accent-emerald);
          }
        }
      }
    }
  }

  // EDUCATION
  .education-section {
    margin-bottom: 6rem;

    h2 {
      font-size: 2.5rem;
      margin-bottom: 3rem;
      color: var(--color-text);
    }

    .education-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 2rem;

      .education-card {
        padding: 2rem;
        border-radius: 12px;
        border: 2px solid;
        transition: all 0.3s ease;

        &:hover {
          transform: translateY(-4px);
          box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
        }

        .education-level {
          font-size: 0.8rem;
          text-transform: uppercase;
          letter-spacing: 0.05em;
          font-weight: 600;
          margin-bottom: 0.75rem;
          opacity: 0.7;
        }

        h3 {
          font-size: 1.3rem;
          margin-bottom: 0.5rem;
          color: var(--color-text);
        }

        .institution {
          font-weight: 600;
          margin-bottom: 0.25rem;
        }

        .details {
          font-family: var(--font-mono);
          font-size: 0.9rem;
          opacity: 0.7;
          margin-bottom: 1rem;
        }

        .description {
          color: var(--color-secondary);
          line-height: 1.6;
          font-size: 0.95rem;
        }

        &.primary {
          background: linear-gradient(135deg, rgba(var(--accent-teal-rgb), 0.08), rgba(var(--accent-teal-rgb), 0.03));
          border-color: var(--accent-teal);
          color: var(--accent-teal);

          .education-level {
            color: var(--accent-teal);
          }
        }

        &.secondary {
          background: linear-gradient(135deg, rgba(var(--accent-sky-rgb), 0.08), rgba(var(--accent-sky-rgb), 0.03));
          border-color: var(--accent-sky);
          color: var(--accent-sky);

          .education-level {
            color: var(--accent-sky);
          }
        }

        &.tertiary {
          background: linear-gradient(135deg, rgba(var(--accent-emerald-rgb), 0.08), rgba(var(--accent-emerald-rgb), 0.03));
          border-color: var(--accent-emerald);
          color: var(--accent-emerald);

          .education-level {
            color: var(--accent-emerald);
          }
        }
      }
    }
  }

  // SKILLS
  .skills-section {
    h2 {
      font-size: 2.5rem;
      margin-bottom: 3rem;
      color: var(--color-text);
    }

    .skills-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 2rem;

      .skill-category {
        padding: 2rem;
        background: linear-gradient(135deg, rgba(var(--accent-teal-rgb), 0.05), rgba(var(--accent-emerald-rgb), 0.03));
        border: 1px solid rgba(var(--accent-teal-rgb), 0.2);
        border-radius: 12px;
        transition: all 0.3s ease;

        &:hover {
          border-color: rgba(var(--accent-teal-rgb), 0.4);
          box-shadow: 0 10px 30px rgba(var(--accent-teal-rgb), 0.1);
        }

        h3 {
          font-size: 1.2rem;
          margin-bottom: 1.5rem;
          color: var(--accent-teal);
        }

        .skill-list {
          display: flex;
          flex-direction: column;
          gap: 0.75rem;

          span {
            padding: 0.5rem 0;
            color: var(--color-text);
            font-size: 0.95rem;
            position: relative;
            padding-left: 1.25rem;

            &::before {
              content: '▪';
              position: absolute;
              left: 0;
              color: var(--accent-teal);
              font-weight: 600;
            }
          }
        }
      }
    }
  }
</style>
