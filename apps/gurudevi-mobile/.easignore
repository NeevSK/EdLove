# EAS Build ignores
# These files won't be uploaded to EAS servers

# Dependencies (will be installed fresh)
node_modules/
.pnpm-store/

# Build outputs
dist/
build/
.expo/
.expo-shared/

# Cache
.cache/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Environment (use EAS Secrets instead)
.env.local
.env.*.local

# Test coverage
coverage/

# Temporary files
*.tmp
.tmp/
