    "@types/jest": "^29.5.14",
    "@types/react": "19.2.14",
    "@types/react-test-renderer": "19.2.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.38.0",
    "eslint-plugin-react-compiler": "19.1.0-rc.2",
    "eslint-plugin-react-native-a11y": "^3.5.1",
    "globals": "^16.5.0",
    "jest-cucumber": "^4.5.0",
    "jest-expo": "~55.0.16",
    "react-native-web": "^0.21.2",
    "react-test-renderer": "19.1.0",
    "supabase": "^2.95.3",
