{
  "name": "gurudevi-mobile",
  "version": "1.0.2",
  "main": "index.ts",
  "scripts": {
    "start": "pnpm exec expo start",
    "dev": "pnpm exec expo start",
    "android": "pnpm exec expo run:android",
    "ios": "pnpm exec expo run:ios",
    "web": "pnpm exec expo start --web",
    "web:prod": "pnpm exec cross-env NODE_OPTIONS=--max-old-space-size=8192 expo start --web --no-dev",
    "build:web": "pnpm exec expo export -p web --output-dir dist",
    "test": "pnpm exec jest",
    "lint": "powershell -File ../../scripts/audit-wrapper.ps1 -Cmd \"pnpm exec eslint 'src/**/*.{ts,tsx}'\" -Log \"reports/lint.txt\"",
    "check-types": "powershell -File ../../scripts/audit-wrapper.ps1 -Cmd \"pnpm exec tsc --noEmit\" -Log \"reports/check-types.txt\"",
    "test:watch": "pnpm exec jest --watch",
    "build:dev": "pnpm exec eas build --profile development --platform android",
    "build:dev:ios": "pnpm exec eas build --profile development --platform ios",
    "build:preview": "pnpm exec eas build --profile preview --platform android",
    "build:preview:ios": "pnpm exec eas build --profile preview --platform ios",
    "build:prod": "pnpm exec eas build --profile production --platform all",
    "submit:android": "pnpm exec eas submit --platform android",
    "submit:ios": "pnpm exec eas submit --platform ios",
    "version:inc": "pnpm exec node scripts/increment-version.js",
    "audit:web": "node scripts/audit-web-deps.mjs",
    "fix:web-shim": "node scripts/add-web-shim.mjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~55.0.10",
    "@react-native-async-storage/async-storage": "2.2.0",
