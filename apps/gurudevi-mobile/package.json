{
  "name": "gurudevi-mobile",
  "version": "1.1.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "pnpm exec cross-env NODE_OPTIONS=--max-old-space-size=8192 expo start",
    "dev": "pnpm exec cross-env NODE_OPTIONS=--max-old-space-size=8192 expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "pnpm exec cross-env NODE_OPTIONS=--max-old-space-size=8192 expo start --web",
    "web:prod": "pnpm exec cross-env NODE_OPTIONS=--max-old-space-size=8192 expo start --web --no-dev",
    "build:web": "pnpm exec cross-env NODE_OPTIONS=--max-old-space-size=8192 expo export -p web --output-dir dist",
    "test": "vitest run",
    "lint": "pnpm run lint:biome && pnpm run lint:eslint",
    "check-types": "pnpm exec tsc --noEmit",
    "test:watch": "vitest",
    "build:dev": "pnpm exec cross-env NODE_OPTIONS=--max-old-space-size=8192 eas build --profile development --platform android",
    "build:dev:ios": "pnpm exec cross-env NODE_OPTIONS=--max-old-space-size=8192 eas build --profile development --platform ios",
    "build:preview": "pnpm exec cross-env NODE_OPTIONS=--max-old-space-size=8192 eas build --profile preview --platform android",
    "build:preview:ios": "pnpm exec cross-env NODE_OPTIONS=--max-old-space-size=8192 eas build --profile preview --platform ios",
    "build:prod": "pnpm exec cross-env NODE_OPTIONS=--max-old-space-size=8192 eas build --profile production --platform all",
    "submit:android": "pnpm exec eas submit --platform android",
    "submit:ios": "pnpm exec eas submit --platform ios",
    "version:inc": "pnpm exec node scripts/increment-version.js",
    "audit:web": "node scripts/audit-web-deps.mjs",
    "audit:bundle": "react-native-bundle-visualizer --expo",
    "fix:web-shim": "node scripts/add-web-shim.mjs",
    "lint:biome": "biome check .",
    "lint:eslint": "eslint .",
    "format": "node ../../scripts/scoped-biome.mjs --write",
    "check-cycles": "node ../../scripts/refactor/sovereign-cycle-checker.mjs",
    "test:ui": "vitest --ui",
    "test:e2e": "pnpm exec playwright test",
    "doctor": "npx react-doctor",
    "clean": "pnpm exec rimraf .turbo node_modules dist .expo"
  },
