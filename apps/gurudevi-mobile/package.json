{
  "name": "gurudevi-mobile",
  "version": "1.5.0",
  "main": "index.ts",
  "scripts": {
    "setup:env": "node scripts/load-doppler-env.js",
    "tools:check-schools": "doppler run --no-fallback -- node check_schools.js",
    "start": "doppler run --no-fallback -- node ../../scripts/run-and-report.mjs --cmd \"pnpm exec cross-env NODE_OPTIONS=--max-old-space-size=8192 expo start\" --name \"apps_gurudevi-mobile-start\"",
    "dev": "doppler run --no-fallback -- node ../../scripts/run-and-report.mjs --cmd \"pnpm exec cross-env NODE_OPTIONS=--max-old-space-size=8192 expo start\" --name \"apps_gurudevi-mobile-dev\"",
    "dev:no-doppler": "node ../../scripts/run-and-report.mjs --cmd \"pnpm exec cross-env NODE_OPTIONS=--max-old-space-size=8192 expo start\" --name \"apps_gurudevi-mobile-dev\"",
    "dev:setup-env": "node scripts/load-doppler-env.js && node ../../scripts/run-and-report.mjs --cmd \"pnpm exec cross-env NODE_OPTIONS=--max-old-space-size=8192 expo start\" --name \"apps_gurudevi-mobile-dev\"",
    "android": "doppler run --no-fallback -- node ../../scripts/run-and-report.mjs --cmd \"expo run:android\" --name \"apps_gurudevi-mobile-android\"",
    "ios": "doppler run --no-fallback -- node ../../scripts/run-and-report.mjs --cmd \"expo run:ios\" --name \"apps_gurudevi-mobile-ios\"",
    "web": "doppler run --no-fallback -- node ../../scripts/run-and-report.mjs --cmd \"pnpm exec cross-env NODE_OPTIONS=--max-old-space-size=8192 expo start --web\" --name \"apps_gurudevi-mobile-web\"",
    "web:prod": "doppler run --no-fallback -- node ../../scripts/run-and-report.mjs --cmd \"pnpm exec cross-env NODE_OPTIONS=--max-old-space-size=8192 expo start --web --no-dev\" --name \"apps_gurudevi-mobile-web_prod\"",
    "build:web": "doppler run --no-fallback -- node ../../scripts/run-and-report.mjs --cmd \"pnpm exec cross-env NODE_OPTIONS=--max-old-space-size=8192 expo export -p web --output-dir dist\" --name \"apps_gurudevi-mobile-build_web\"",
    "test": "node ../../scripts/run-and-report.mjs --cmd \"vitest run\" --name \"apps_gurudevi-mobile-test\" --evidence-level G1",
    "test:g1:route-gate": "node ../../scripts/run-and-report.mjs --cmd \"vitest run src/__tests__/entry/SessionRouteGate.test.tsx\" --name \"apps_gurudevi-mobile-test_g1_route_gate\" --evidence-level G1",
    "test:g1:capability": "node ../../scripts/run-and-report.mjs --cmd \"vitest run src/__tests__/entry/SessionRouteGate.test.tsx src/__tests__/entry/GuestPersistenceNotice.test.tsx src/__tests__/providers/CapabilityHydrationProvider.test.tsx src/__tests__/providers/FeatureProvider.test.tsx src/__tests__/permissions/capabilityRenderingMatrix.test.tsx\" --name \"apps_gurudevi-mobile-test_g1_capability\" --evidence-level G1",
    "lint": "node ../../scripts/run-and-report.mjs --cmd \"pnpm run lint:fast && pnpm run lint:slow\" --name \"apps_gurudevi-mobile-lint\"",
    "check-types": "node ../../scripts/run-and-report.mjs --cmd \"pnpm exec tsc --build --noEmit\" --name \"apps_gurudevi-mobile-check-types\"",
    "test:watch": "node ../../scripts/run-and-report.mjs --cmd \"vitest\" --name \"apps_gurudevi-mobile-test_watch\" --evidence-level G1",
    "build:dev": "doppler run --no-fallback -- node ../../scripts/run-and-report.mjs --cmd \"pnpm exec cross-env NODE_OPTIONS=--max-old-space-size=8192 eas build --profile development --platform android\" --name \"apps_gurudevi-mobile-build_dev\"",
    "build:dev:ios": "doppler run --no-fallback -- node ../../scripts/run-and-report.mjs --cmd \"pnpm exec cross-env NODE_OPTIONS=--max-old-space-size=8192 eas build --profile development --platform ios\" --name \"apps_gurudevi-mobile-build_dev_ios\"",
    "build:preview": "doppler run --no-fallback -- node ../../scripts/run-and-report.mjs --cmd \"pnpm exec cross-env NODE_OPTIONS=--max-old-space-size=8192 eas build --profile preview --platform android\" --name \"apps_gurudevi-mobile-build_preview\"",
    "build:preview:ios": "doppler run --no-fallback -- node ../../scripts/run-and-report.mjs --cmd \"pnpm exec cross-env NODE_OPTIONS=--max-old-space-size=8192 eas build --profile preview --platform ios\" --name \"apps_gurudevi-mobile-build_preview_ios\"",
    "build:prod": "doppler run --no-fallback -- node ../../scripts/run-and-report.mjs --cmd \"pnpm exec cross-env NODE_OPTIONS=--max-old-space-size=8192 eas build --profile production --platform all\" --name \"apps_gurudevi-mobile-build_prod\"",
    "submit:android": "doppler run --no-fallback -- node ../../scripts/run-and-report.mjs --cmd \"pnpm exec eas submit --platform android\" --name \"apps_gurudevi-mobile-submit_android\"",
    "submit:ios": "doppler run --no-fallback -- node ../../scripts/run-and-report.mjs --cmd \"pnpm exec eas submit --platform ios\" --name \"apps_gurudevi-mobile-submit_ios\"",
    "version:inc": "node ../../scripts/run-and-report.mjs --cmd \"pnpm exec node scripts/increment-version.js\" --name \"apps_gurudevi-mobile-version_inc\"",
    "audit:web": "node ../../scripts/run-and-report.mjs --cmd \"node scripts/audit-web-deps.mjs\" --name \"apps_gurudevi-mobile-audit_web\"",
    "audit:style-stack": "node ../../scripts/run-and-report.mjs --cmd \"node scripts/audit-style-stack.mjs\" --name \"apps_gurudevi-mobile-audit_style_stack\"",
    "audit:css-interop": "node scripts/audit-css-interop-inventory.mjs --check",
    "audit:native-pipeline": "node scripts/audit-native-pipeline.mjs",
    "audit:expo-native-graph": "node scripts/audit-expo-native-graph.mjs",
    "audit:boundaries": "node ../../scripts/audit-mobile-boundaries.mjs",
    "audit:tree-shaking": "node ../../scripts/audit-tree-shaking.mjs",
    "verify:style-stack": "pnpm run audit:expo-native-graph && pnpm run audit:style-stack && pnpm run audit:css-interop && pnpm run check-types && pnpm run test",
    "inspect:web-runtime": "node scripts/inspect-web-runtime.mjs",
    "inspect:style-engine-fixture": "node scripts/inspect-style-engine-fixture.mjs",
    "audit:bundle": "node ../../scripts/run-and-report.mjs --cmd \"react-native-bundle-visualizer --expo\" --name \"apps_gurudevi-mobile-audit_bundle\"",
    "audit:route-bundles": "node ../../scripts/report-mobile-route-bundles.mjs",
    "audit:contrast": "node ../../scripts/run-and-report.mjs --cmd \"node scripts/audit-contrast.mjs\" --name \"apps_gurudevi-mobile-audit_contrast\"",
    "audit:font-scaling": "node ../../scripts/run-and-report.mjs --cmd \"node scripts/audit-font-scaling.mjs\" --name \"apps_gurudevi-mobile-audit_font_scaling\"",
    "fix:web-shim": "node ../../scripts/run-and-report.mjs --cmd \"node scripts/add-web-shim.mjs\" --name \"apps_gurudevi-mobile-fix_web-shim\"",
    "lint:fast": "node ../../scripts/run-and-report.mjs --cmd \"pnpm dlx oxlint@latest src -c oxlint.config.mjs\" --name \"apps_gurudevi-mobile-lint_fast\"",
    "lint:slow": "node ../../scripts/run-and-report.mjs --cmd \"eslint src -c eslint.config.mjs\" --name \"apps_gurudevi-mobile-lint_slow\"",
    "lint:biome": "node ../../scripts/run-and-report.mjs --cmd \"node ../../scripts/scoped-biome.mjs\" --name \"apps_gurudevi-mobile-lint_biome\"",
    "lint:eslint": "node ../../scripts/run-and-report.mjs --cmd \"eslint .\" --name \"apps_gurudevi-mobile-lint_eslint\"",
    "format": "node ../../scripts/run-and-report.mjs --cmd \"node ../../scripts/scoped-biome.mjs --write\" --name \"apps_gurudevi-mobile-format\"",
    "check-cycles": "node ../../scripts/run-and-report.mjs --cmd \"node ../../scripts/refactor/sovereign-cycle-checker.mjs\" --name \"apps_gurudevi-mobile-check-cycles\"",
    "test:ui": "node ../../scripts/run-and-report.mjs --cmd \"vitest --ui\" --name \"apps_gurudevi-mobile-test_ui\" --evidence-level G1",
    "test:e2e": "node ../../scripts/run-and-report.mjs --cmd \"pnpm exec playwright test\" --name \"apps_gurudevi-mobile-test_e2e\" --evidence-level G4",
    "test:e2e:dev": "node ../../scripts/run-and-report.mjs --cmd \"cross-env PLAYWRIGHT_BASE_URL=http://localhost:8081 pnpm exec playwright test\" --name \"apps_gurudevi-mobile-test_e2e_dev\" --evidence-level G4",
    "test:e2e:headed": "node ../../scripts/run-and-report.mjs --cmd \"cross-env PLAYWRIGHT_BASE_URL=http://localhost:8081 pnpm exec playwright test --headed\" --name \"apps_gurudevi-mobile-test_e2e_headed\" --evidence-level G4",
    "test:e2e:ui": "node ../../scripts/run-and-report.mjs --cmd \"pnpm exec playwright test --ui\" --name \"apps_gurudevi-mobile-test_e2e_ui\" --evidence-level G4",
    "inspect:localhost": "node scripts/inspect-brave.mjs",
    "doctor": "node ../../scripts/run-and-report.mjs --cmd \"npx react-doctor\" --name \"apps_gurudevi-mobile-doctor\"",
    "doctor:terrain": "node ../../scripts/run-rn-terrain.mjs doctor:all .",
    "audit:imports": "node ../../scripts/run-rn-terrain.mjs audit-imports --dir .",
    "audit:grants": "node ../../scripts/run-rn-terrain.mjs audit-grants --dir supabase/migrations",
    "verify:hermes": "node ../../scripts/run-rn-terrain.mjs verify:hermes app/index.tsx",
    "verify:yoga": "node ../../scripts/run-rn-terrain.mjs verify:yoga app/index.tsx",
    "clean": "node ../../scripts/run-and-report.mjs --cmd \"pnpm exec rimraf .turbo node_modules dist .expo\" --name \"apps_gurudevi-mobile-clean\"",
    "postinstall": "node scripts/copy-powersync-assets.mjs",
    "test:native": "vitest run --config vitest.native.config.mts"
  },
