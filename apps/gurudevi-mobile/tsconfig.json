      "@rn-terrain/core/*": [
        "../../packages/rn-terrain-core/src/*"
      ],
      "@rn-terrain/mcp/*": [
        "../../packages/rn-terrain-mcp/src/*"
      ],
      "@rn-terrain/vscode/*": [
        "../../packages/rn-terrain-vscode/src/*"
