      "@repo/community/*": [
        "../../packages/community/src/*"
      ],
      "@repo/core/*": [
        "../../packages/core/src/*"
      ],
      "@repo/form-builder/*": [
        "../../packages/form-builder/src/*"
      ],
      "@repo/library/*": [
        "../../packages/library/src/*"
      ],
      "@repo/people/*": [
        "../../packages/people/src/*"
      ],
      "@repo/profile/*": [
        "../../packages/profile/src/*"
      ],
      "@repo/scanner-kit/*": [
        "../../packages/scanner-kit/src/*"
      ],
      "@repo/self/*": [
        "../../packages/self/src/*"
      ],
      "@repo/ui/*": [
        "../../packages/ui/src/*"
      ],
      "@repo/workforce/*": [
        "../../packages/workforce/src/*"
      ],
      "@library/*": [
        "../../packages/library/src/*"
      ],
      "@community/*": [
        "../../packages/community/src/*"
      ],
      "@people/*": [
        "../../packages/people/src/*"
      ],
      "@profile/*": [
        "../../packages/profile/src/*"
      ],
      "@scanner-kit/*": [
        "../../packages/scanner-kit/src/*"
      ],
      "@self/*": [
        "../../packages/self/src/*"
      ],
      "@repo/accounting/*": [
        "../../packages/accounting/src/*"
