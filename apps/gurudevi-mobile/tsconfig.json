{
  "compilerOptions": {
    "strict": true,
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "noEmit": true,
    "lib": ["es2020", "dom"],
    "target": "es2020",
    "jsx": "react-jsx",
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "paths": {
      "@/*": ["./src/*"],
      "@repo/admin/*": ["../../packages/admin/src/*"],
      "@repo/ai/*": ["../../packages/ai/src/*"],
      "@repo/analytics/*": ["../../packages/analytics/src/*"],
      "@repo/classroom/*": ["../../packages/classroom/src/*"],
      "@repo/community/*": ["../../packages/community/src/*"],
      "@repo/core/*": ["../../packages/core/src/*"],
      "@repo/form-builder/*": ["../../packages/form-builder/src/*"],
      "@repo/library/*": ["../../packages/library/src/*"],
      "@repo/people/*": ["../../packages/people/src/*"],
      "@repo/profile/*": ["../../packages/profile/src/*"],
      "@repo/scanner-kit/*": ["../../packages/scanner-kit/src/*"],
      "@repo/self/*": ["../../packages/self/src/*"],
      "@repo/ui/*": ["../../packages/ui/src/*"],
      "@repo/workforce/*": ["../../packages/workforce/src/*"]
    },
    "types": [
      "react",
      "react-native",
      "jest",
      "vitest/globals",
      "@tanstack/react-query",
      "@repo/types-shim"
    ]
  },
  "include": ["src/**/*", "app/**/*", "gluestack-ui.config.ts", "nativewind-env.d.ts"],
  "exclude": ["node_modules", ".expo", "dist", "src/navigation", "App.tsx"],
  "extends": "../../packages/typescript-config/base.json"
}
