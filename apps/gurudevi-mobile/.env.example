# NOTE: This project uses Doppler for secrets management
# - Real secrets are stored in Doppler: https://dashboard.doppler.com → gurudevi-mobile project
# - For local dev: Use `doppler run -- <your-command>` to inject secrets
# - Or download: `doppler secrets download --format env > .env` (do not commit .env)
# - Get started: https://docs.doppler.com/docs/cli
#
# The values below are placeholders for reference only

EXPO_PUBLIC_SUPABASE_URL=your-project-url-here
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here

# Browser Web Push (public key only; generate a VAPID key pair for production)
EXPO_PUBLIC_WEB_PUSH_VAPID_PUBLIC_KEY=

# Inngest Configuration
EXPO_PUBLIC_INNGEST_EVENT_KEY=your-inngest-event-key-here

# PowerSync Configuration (optional — Path 1 / Resonant Sync)
# Get from: https://app.powersync.com → your project → connection details
# Leave empty to use Message Bus only (default, free)
# Example (Dev instance): https://69f985158d064eb85ee933e0.powersync.journeyapps.com
EXPO_PUBLIC_POWERSYNC_URL=

# GrowthBook rollout (client key only; management credentials stay server/CI-only)
EXPO_PUBLIC_GROWTHBOOK_API_HOST=https://cdn.growthbook.io
EXPO_PUBLIC_GROWTHBOOK_CLIENT_KEY=

# PostHog Configuration (optional)
# Set to 'false' to disable sending analytics/log events during local development
EXPO_PUBLIC_POSTHOG_ENABLED=true
EXPO_PUBLIC_POSTHOG_API_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Sentry Configuration (optional)
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_ENVIRONMENT=development
EXPO_PUBLIC_SENTRY_RELEASE=

# API base URL used by packages/core + packages/ai (Expo inlines this var)
EXPO_PUBLIC_API_URL=http://localhost:3000

# Feature flags / dev toggles
EXPO_PUBLIC_ENABLE_DEV_SANDBOX=false
EXPO_PUBLIC_LOCAL_DYNAMIC_CEDAR=false

# Cloudinary upload (matches in-code defaults in packages/core)
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=neevsk
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=gurudevi_unsigned

# Ed25519 public key paired with the API's SNAPSHOT_SIGNING_PRIVATE_KEY
EXPO_PUBLIC_SNAPSHOT_SIGNING_PUBLIC_KEY=

# Google One-Tap / native Google Sign-In (Credential Manager on Android,
# Google Sign-In SDK on iOS). Register these OAuth client IDs in the Google
# Cloud Console (APIs & Services → Credentials) and wire the Web client into
# the Supabase dashboard (Authentication → External → Google).
# iOS client ID: create an iOS OAuth client (bundle id org.edlove.gurudevi).
# Web client ID: create a Web application OAuth client; add the app's web
# origin and gurudevi://auth/callback as authorized JavaScript origins/redirects.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
