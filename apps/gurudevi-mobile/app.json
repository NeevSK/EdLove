{
  "expo": {
    "name": "gurudevi-mobile",
    "slug": "gurudevi-mobile",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "gurudevi",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.edlove.gurudevi",
      "buildNumber": "1"
    },
    "android": {
      "package": "org.edlove.gurudevi",
      "versionCode": 23,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "gurudevi",
              "host": "auth",
              "pathPrefix": "/callback"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        },
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "gurudevi",
              "host": "qr"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        },
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "platform.gurudevi.edlove.org",
              "pathPrefix": "/qr"
            },
            {
              "scheme": "https",
              "host": "platform.gurudevi.edlove.org",
              "pathPrefix": "/p"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "baseUrl": "/",
      "name": "Gurudevi",
      "shortName": "Gurudevi",
      "lang": "en",
      "display": "standalone",
      "themeColor": "#D4843A",
      "backgroundColor": "#F5EDD6"
    },
    "experiments": {
      "baseUrl": "/"
    },
    "extra": {
      "eas": {
        "projectId": "1701dfb9-c59e-45c6-a391-58c061a0b8ce"
      },
      "googleIosUrlScheme": "com.googleusercontent.apps.YOUR_IOS_CLIENT_ID"
    },
    "plugins": [
      "expo-font",
      "./plugins/withNdkVersion",
      // "./plugins/withAndroidCruncherDisabled",
      "./plugins/withGradleProperties",
      "expo-localization",
      "expo-asset",
      "expo-audio",
      "expo-secure-store",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "gurudevi-mobile",
          "organization": "intuitui-labs",
          "uploadNativeSymbols": false,
          "autoUploadNativeSymbols": false,
          "autoUpload": true,
          "uploadSourceMaps": true,
          "disableAutoUpload": false
        }
      ],
      "expo-web-browser",
      "expo-image",
      "expo-sharing",
      "expo-sqlite",
      "expo-video",
      "expo-notifications",
      "@react-native-community/datetimepicker",
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.org.edlove.gurudevi",
          "enableGooglePay": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "extraMavenRepos": []
          }
        }
      ],
      "expo-mail-composer",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-poster-line-draw-transparent.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#20140E",
          "dark": {
            "image": "./assets/splash-poster-line-draw-transparent.png",
            "backgroundColor": "#20140E"
          }
        }
      ],
      "expo-widgets",
      "expo-router",
      "react-native-enriched-markdown",
      "react-native-nano-icons",
      "@sentry/react-native",
      "expo-background-task",
      "expo-status-bar",
      "@react-native-vector-icons/lucide",
      [
        "react-native-nitro-google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.YOUR_IOS_CLIENT_ID"
        }
      ]
    ],
    "owner": "neevsk",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/1701dfb9-c59e-45c6-a391-58c061a0b8ce"
    }
  }
}
