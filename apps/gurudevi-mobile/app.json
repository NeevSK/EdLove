{
  "expo": {
    "name": "Gurudevi Sanctuary",
    "slug": "gurudevi-sanctuary",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "gurudevi",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.gurudevi.sanctuary",
      "buildNumber": "1",
      "associatedDomains": ["applinks:sanctuary.gurudevi.app", "applinks:gurudevi.app"]
    },
    "android": {
      "package": "app.gurudevi.sanctuary",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "gurudevi",
              "host": "auth",
              "pathPrefix": "/callback"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        },
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "gurudevi",
              "host": "qr"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        },
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "gurudevi",
              "host": "invite"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        },
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "gurudevi",
              "host": "c"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        },
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "sanctuary.gurudevi.app",
              "pathPrefix": "/qr"
            },
            {
              "scheme": "https",
              "host": "sanctuary.gurudevi.app",
              "pathPrefix": "/invite"
            },
            {
              "scheme": "https",
              "host": "sanctuary.gurudevi.app",
              "pathPrefix": "/c"
            },
            {
              "scheme": "https",
              "host": "sanctuary.gurudevi.app",
              "pathPrefix": "/auth/callback"
            },
            {
              "scheme": "https",
              "host": "gurudevi.app",
              "pathPrefix": "/qr"
            },
            {
              "scheme": "https",
              "host": "gurudevi.app",
              "pathPrefix": "/invite"
            },
            {
              "scheme": "https",
              "host": "gurudevi.app",
              "pathPrefix": "/c"
            },
            {
              "scheme": "https",
              "host": "gurudevi.app",
              "pathPrefix": "/auth/callback"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "baseUrl": "/",
      "name": "Gurudevi",
      "shortName": "Gurudevi",
      "lang": "en",
      "display": "standalone",
      "themeColor": "#D4843A",
      "backgroundColor": "#F5EDD6"
    },
    "experiments": {
      "baseUrl": "/"
    },
    "extra": {
      "googleIosUrlScheme": "com.googleusercontent.apps.YOUR_IOS_CLIENT_ID",
      "publicRuntime": {},
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "ExpoWidgetsTarget",
                  "bundleIdentifier": "app.gurudevi.sanctuary.ExpoWidgetsTarget",
                  "entitlements": {
                    "com.apple.security.application-groups": ["group.app.gurudevi.sanctuary"]
                  }
                }
              ]
            }
          }
        },
        "projectId": "7f9c7064-14ee-49d2-9caf-32ebdc904ce9"
      },
      "router": {}
    },
    "plugins": [
      [
        "expo-font",
        {
          "fonts": [
            "./src/assets/fonts/world/AbhayaLibre-Regular.ttf",
            "./src/assets/fonts/world/AbhayaLibre-SemiBold.ttf",
            "./src/assets/fonts/world/Alegreya-Italic-VF.ttf",
            "./src/assets/fonts/world/Alegreya-VF.ttf",
            "./src/assets/fonts/world/AlegreyaSans-Bold.ttf",
            "./src/assets/fonts/world/AlegreyaSans-Regular.ttf",
            "./src/assets/fonts/world/Anybody-Italic-VF.ttf",
            "./src/assets/fonts/world/Arima-VF.ttf",
            "./src/assets/fonts/world/Catamaran-VF.ttf",
            "./src/assets/fonts/world/CormorantGaramond-Italic-VF.ttf",
            "./src/assets/fonts/world/CormorantGaramond-VF.ttf",
            "./src/assets/fonts/world/Fraunces-Italic-VF.ttf",
            "./src/assets/fonts/world/Fraunces-VF.ttf",
            "./src/assets/fonts/world/GemunuLibre-VF.ttf",
            "./src/assets/fonts/world/HindMadurai-Medium.ttf",
            "./src/assets/fonts/world/HindMadurai-Regular.ttf",
            "./src/assets/fonts/world/IBMPlexSans-Regular.ttf",
            "./src/assets/fonts/world/Inter-VF.ttf",
            "./src/assets/fonts/world/Jost-VF.ttf",
            "./src/assets/fonts/world/Lora-Italic.ttf",
            "./src/assets/fonts/world/Lora-Regular.ttf",
            "./src/assets/fonts/world/MuktaMalar-Regular.ttf",
            "./src/assets/fonts/world/MuktaMalar-SemiBold.ttf",
            "./src/assets/fonts/world/Newsreader-Italic-VF.ttf",
            "./src/assets/fonts/world/Newsreader-VF.ttf",
            "./src/assets/fonts/world/NotoSansSinhala-VF.ttf",
            "./src/assets/fonts/world/NotoSansSinhala-Width-VF.ttf",
            "./src/assets/fonts/world/NotoSansTamil-VF.ttf",
            "./src/assets/fonts/world/NotoSansTamil-Width-VF.ttf",
            "./src/assets/fonts/world/NotoSerifSinhala-VF.ttf",
            "./src/assets/fonts/world/NotoSerifTamil-VF.ttf",
            "./src/assets/fonts/world/Nunito-VF.ttf",
            "./src/assets/fonts/world/SpaceGrotesk-VF.ttf",
            "./src/assets/fonts/world/Spectral-Italic.ttf",
            "./src/assets/fonts/world/Spectral-Regular.ttf",
            "./src/assets/fonts/world/Yaldevi-VF.ttf"
          ]
        }
      ],
      "./plugins/withNdkVersion",
      "./plugins/withProfileableBuild",
      "./plugins/withGradleProperties",
      "./plugins/withGradleWrapperVersion",
      "./plugins/withSubprojectsBuildConfig",
      "expo-localization",
      "expo-asset",
      "expo-audio",
      "expo-secure-store",
      "expo-web-browser",
      "expo-image",
      "expo-sharing",
      "expo-sqlite",
      "expo-video",
      "expo-notifications",
      "@react-native-community/datetimepicker",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 28,
            "compileSdkVersion": 37,
            "targetSdkVersion": 37,
            "extraMavenRepos": []
          }
        }
      ],
      "expo-mail-composer",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-poster-line-draw-transparent.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#20140E",
          "dark": {
            "image": "./assets/splash-poster-line-draw-transparent.png",
            "backgroundColor": "#20140E"
          }
        }
      ],
      "expo-widgets",
      "expo-router",
      "@sentry/react-native/expo",
      "react-native-nano-icons",
      "expo-background-task",
      "expo-status-bar",
      "@react-native-vector-icons/lucide",
      [
        "react-native-nitro-google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.YOUR_IOS_CLIENT_ID"
        }
      ]
    ],
    "owner": "neevsk",
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
