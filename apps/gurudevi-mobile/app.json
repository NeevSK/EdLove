{
  "expo": {
    "name": "gurudevi-mobile",
    "slug": "gurudevi-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "gurudevi",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.edlove.gurudevi",
      "newArchEnabled": true
    },
    "android": {
      "package": "org.edlove.gurudevi",
      "newArchEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "gurudevi",
              "host": "auth",
              "pathPrefix": "/callback"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "gurudevi",
              "host": "qr"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "baseUrl": "/",
      "name": "Gurudevi",
      "shortName": "Gurudevi",
      "lang": "en",
      "display": "standalone",
      "themeColor": "#D4843A",
      "backgroundColor": "#F5EDD6",
      "description": "A sacred space for teachers — wellbeing, classroom, and community."
    },
    "extra": {
      "eas": {
        "projectId": "1701dfb9-c59e-45c6-a391-58c061a0b8ce"
      }
    },
    "plugins": [
      "expo-font",
      "./plugins/withAndroidCruncherDisabled",
      "./plugins/withGradleProperties",
      "./plugins/withSentryProperties",
      "expo-localization",
      "expo-asset",
      "expo-audio",
      "expo-secure-store",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "gurudevi-mobile",
          "organization": "intuitui-labs",
          "uploadNativeSymbols": true,
          "autoUploadNativeSymbols": true,
          "autoUpload": true
        }
      ]
    ],
    "owner": "neevsk",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/1701dfb9-c59e-45c6-a391-58c061a0b8ce"
    }
  }
}