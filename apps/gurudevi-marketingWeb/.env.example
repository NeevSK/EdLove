# Gurudevi Marketing Site (Astro) - Public env vars
# These are safe to expose (PUBLIC_*) and will be bundled client-side for islands.

# Supabase (read-only anon key; table is RLS-restricted to SELECT for anon)
PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
PUBLIC_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# Embedded support form endpoint (optional)
# If unset, the Support page falls back to mailto.
PUBLIC_SUPPORT_FORM_ACTION="https://YOUR_FORM_ENDPOINT"

