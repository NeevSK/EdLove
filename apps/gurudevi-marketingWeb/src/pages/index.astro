---
import { LAUNCH, MARKETING_COPY, WEB_LINKS } from '../lib/site';

const machineReadableData = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Gurudevi',
  applicationCategory: 'EducationalApplication',
  operatingSystem: 'Web',
  url: WEB_LINKS.app,
  description: 'A respectful education ecology for the people who make learning possible.',
};

const copy = MARKETING_COPY.en;
---

<Layout title="Home" structuredData={machineReadableData}>
  <Header />
  <main>
    <section class="hero-editorial">
      <img class="hero-editorial__image" src="/hero-teacher-editorial.png" alt="A teacher prepares learning materials in a sunlit Sri Lankan classroom." />
      <div class="hero-editorial__wash"></div>
      <div class="hero-editorial__content">
        <p class="eyebrow hero-editorial__eyebrow">{copy.hero.eyebrow}</p>
        <h1>{copy.hero.title}</h1>
        <p class="hero-editorial__lede">{copy.hero.lede}</p>
        <div class="hero-editorial__actions">
          <a class="button button--light" href={LAUNCH.ctaTarget}>{copy.hero.primaryCta} <span aria-hidden="true">↘</span></a>
          <a class="text-link text-link--light" href="#ecology">{copy.hero.secondaryCta}</a>
        </div>
      </div>
      <div class="hero-editorial__caption"><span>Built around the people who make learning possible.</span><span aria-hidden="true">↓</span></div>
    </section>

    <section class="section section--intro" id="ecology">
      <div class="section__label eyebrow">The starting point</div>
      <div class="intro-copy"><h2>Education is held together by people carrying too much alone.</h2><p>Gurudevi exists to make the relationships around learning easier to see, easier to support, and more worthy of care.</p></div>
    </section>

    <section class="section section--roles" aria-labelledby="roles-title">
      <div class="section__heading"><div><p class="eyebrow">One ecology, many centers</p><h2 id="roles-title">A different kind of school technology.</h2></div><p>Each person gets a place to work, contribute, and belong—without being flattened into one role.</p></div>
      <div class="role-list">
        {copy.roles.map((role, index) => <article class="role-row" style={`--delay: ${index * 70}ms`}><span class="role-row__index">0{index + 1}</span><div><p class="eyebrow">{role.label}</p><h3>{role.title}</h3></div><p>{role.body}</p><span class="role-row__arrow" aria-hidden="true">↗</span></article>)}
      </div>
    </section>

    <section class="section section--dark" aria-labelledby="workspaces-title">
      <div class="section__heading section__heading--dark"><div><p class="eyebrow">Inside Gurudevi</p><h2 id="workspaces-title">Four spaces, one living system.</h2></div><p>The product follows the shape of education itself: connected, local, and always in relationship.</p></div>
      <div class="workspace-list">{copy.workspaces.map((workspace) => <div class="workspace-row"><span>{workspace.number}</span><h3>{workspace.name}</h3><p>{workspace.body}</p></div>)}</div>
    </section>

    <section class="section section--trust" aria-labelledby="trust-title">
      <div class="trust-mark"><img src="/gurudevi-mark.svg" alt="" width="96" height="96" /></div>
      <div><p class="eyebrow">The promise</p><h2 id="trust-title">Support should never become surveillance.</h2><p class="trust-copy">Gurudevi is designed around different views: enough shared understanding to support a school, enough privacy for people to remain whole.</p><a class="text-link" href="/about">Read the thinking behind Gurudevi <span aria-hidden="true">↗</span></a></div>
    </section>

    <section class="launch-panel" id="launch" aria-labelledby="launch-title" data-launch-countdown data-launch-at={LAUNCH.iso} data-launch-status={LAUNCH.status}>
      <div><p class="eyebrow">The first opening</p><h2 id="launch-title">Gurudevi opens on October 6.</h2><p>We are preparing a public home for a more humane education ecology. Follow the opening, or speak with us about your school.</p></div>
      <div class="launch-panel__side"><div class="launch-clock" aria-live="polite"><span data-countdown-value>Preparing the sanctuary…</span><small>{LAUNCH.timezoneLabel} · {LAUNCH.label}</small></div><div class="launch-panel__actions"><a class="button button--dark" href={WEB_LINKS.app} target="_blank" rel="noopener noreferrer">Open the platform <span aria-hidden="true">↗</span></a><a class="text-link" href="/support">Talk to the team</a></div></div>
    </section>
  </main>
  <Footer />
</Layout>

<script is:inline>
  const countdown = document.querySelector('[data-launch-countdown]');
  const value = countdown?.querySelector('[data-countdown-value]');
  const launchAt = countdown?.getAttribute('data-launch-at');
  if (countdown && value && launchAt) {
    const update = () => {
      const remaining = new Date(launchAt).getTime() - Date.now();
      if (remaining <= 0) { value.textContent = 'The sanctuary is open.'; return; }
      const days = Math.floor(remaining / 86400000);
      const hours = Math.floor((remaining % 86400000) / 3600000);
      const minutes = Math.floor((remaining % 3600000) / 60000);
      const seconds = Math.floor((remaining % 60000) / 1000);
      value.textContent = `${days}d ${hours}h ${minutes}m ${seconds}s to launch`;
    };
    update(); window.setInterval(update, 1000);
  }
</script>
