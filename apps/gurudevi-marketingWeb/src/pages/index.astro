---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StoryCard from '../components/StoryCard.astro';
import StatsSection from '../components/StatsSection.svelte';
---

<Layout title="Home">
	<Header />
	
	<main class="flex-grow">
		<!-- Hero Section -->
		<section class="relative overflow-hidden pt-24 pb-32 px-8 bg-gradient-to-b from-cream-silence to-temple-stone">
			<div class="max-w-7xl mx-auto flex flex-col md:flex-row items-center justify-between relative z-10">
				<div class="md:w-1/2 space-y-8">
					<div class="inline-block px-4 py-1.5 bg-sanctuary-saffron/10 border border-sanctuary-saffron/20 rounded-full text-sanctuary-saffron text-sm font-semibold tracking-wide uppercase">
						Education Ecology Support System
					</div>
					<h1 class="text-5xl md:text-7xl font-bold leading-tight text-charcoal-truth">
						A Sanctuary for <span class="text-peacock-blue">Teachers</span>
					</h1>
					<p class="text-xl text-mud-brown leading-relaxed max-w-xl">
						Gurudevi is a polycentric support system designed to mend the teaching-learning impedance match. We believe education is a living ecology that thrives on care, not surveillance.
					</p>
					<div class="flex flex-col sm:flex-row space-y-4 sm:space-y-0 sm:space-x-4">
						<a href="#join" class="px-8 py-4 bg-void-indigo text-sacred-white rounded-full font-bold shadow-xl hover:bg-peacock-blue transition-all text-center">
							Download the App
						</a>
						<a href="/thuthimal" class="px-8 py-4 border-2 border-sanctuary-saffron text-sanctuary-saffron rounded-full font-bold hover:bg-sanctuary-saffron/5 transition-all text-center">
							Gift Gratitude (තුතිමල්)
						</a>
					</div>
				</div>
				
				<div class="md:w-1/2 mt-16 md:mt-0 flex justify-center relative">
					<div class="w-80 h-80 bg-teal-water/20 rounded-full animate-pulse blur-3xl absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2"></div>
					<div class="relative z-20 w-full max-w-md bg-white rounded-3xl shadow-2xl overflow-hidden border border-mud-brown/10 transform rotate-2 hover:rotate-0 transition-transform duration-500">
						<div class="p-8 space-y-6">
							<div class="flex items-center space-x-3">
								<div class="w-12 h-12 bg-sage-green rounded-full flex items-center justify-center text-white">
									<svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
									</svg>
								</div>
								<div>
									<h3 class="font-bold">Sanctuary Self</h3>
									<p class="text-sm opacity-60">Daily Breathing & Reflection</p>
								</div>
							</div>
							<div class="space-y-2">
								<div class="h-3 bg-temple-stone rounded-full w-full"></div>
								<div class="h-3 bg-temple-stone rounded-full w-4/5"></div>
								<div class="h-3 bg-temple-stone rounded-full w-3/4"></div>
							</div>
							<div class="pt-4 flex justify-between items-center text-xs font-semibold text-sanctuary-saffron uppercase tracking-widest">
								<span>Pillar I: SELF</span>
								<span class="px-3 py-1 bg-sanctuary-saffron/10 rounded-full line-through opacity-50">LMS</span>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Stats Section -->
		<section class="py-20 px-8 bg-temple-stone/20">
			<StatsSection client:visible />
		</section>

		<!-- Pillars Section -->
		<section class="py-24 px-8 bg-white">
			<div class="max-w-7xl mx-auto space-y-16">
				<div class="text-center space-y-4">
					<h2 class="text-4xl font-bold">The Five Pillars</h2>
					<p class="text-mud-brown max-w-2xl mx-auto">
						Gurudevi is structured around five ecological zones that support every aspect of the educational experience.
					</p>
				</div>
				
				<div class="grid grid-cols-1 md:grid-cols-5 gap-6">
					{[
						{ name: 'Self', desc: 'The Inner Ecology', color: 'bg-teal-water' },
						{ name: 'Classroom', desc: 'Operational Ecology', color: 'bg-peacock-blue' },
						{ name: 'Library', desc: 'Knowledge Ecology', color: 'bg-sage-green' },
						{ name: 'Community', desc: 'Relational Ecology', color: 'bg-sanctuary-saffron' },
						{ name: 'Profile', desc: 'Identity & Boundaries', color: 'bg-mud-brown' }
					].map((pillar) => (
						<div class="p-8 rounded-3xl border border-mud-brown/10 hover:shadow-xl transition-all hover:-translate-y-2 text-center space-y-4">
							<div class={`w-16 h-16 ${pillar.color} rounded-2xl mx-auto flex items-center justify-center text-sacred-white shadow-lg`}>
								{pillar.name[0]}
							</div>
							<h3 class="text-xl font-bold">{pillar.name}</h3>
							<p class="text-sm text-mud-brown opacity-80">{pillar.desc}</p>
						</div>
					))}
				</div>
			</div>
		</section>

		<!-- Stories Section -->
		<section class="py-24 px-8 bg-temple-stone/20 overflow-hidden">
			<div class="max-w-7xl mx-auto space-y-16">
				<div class="text-center space-y-4">
					<h2 class="text-4xl font-bold">Stories of the Sanctuary</h2>
					<p class="text-mud-brown max-w-2xl mx-auto">Voices from the ecology—hear how teachers are mending the impedance match.</p>
				</div>
				
				<div class="grid grid-cols-1 md:grid-cols-2 gap-8">
					<StoryCard 
						quote="Every line of code in Gurudevi must honor the people who give everything to children while their own lives quietly collapse."
						author="Visionary Builder"
						role="Ecology Architect"
					/>
					<StoryCard 
						quote="Teachers are the heavy lifters of both school and app. If the system serves us well, it serves the entire future of the school."
						author="Lead Teacher"
						role="Grade Head Observer"
					/>
				</div>
			</div>
		</section>

		<!-- Join Section -->
		<section id="join" class="py-32 px-8 bg-gradient-to-br from-teal-water to-peacock-blue text-sacred-white relative overflow-hidden text-center border-b border-white/10">
			<div class="max-w-3xl mx-auto space-y-10 relative z-10">
				<h2 class="text-5xl font-bold">Join the Education Ecology</h2>
				<p class="text-xl opacity-80 leading-relaxed">
					Whether you are a teacher looking for sanctuary or an administrator aiming to support your staff, Gurudevi is ready to welcome you.
				</p>
				
				<div class="flex flex-col sm:flex-row justify-center items-center space-y-6 sm:space-y-0 sm:space-x-8">
					<div class="space-y-4">
						<p class="text-sm uppercase tracking-widest text-temple-gold font-bold">For Individuals</p>
						<div class="flex space-x-4">
							<div class="w-40 h-14 bg-white/10 rounded-xl border border-white/20 flex items-center justify-center grayscale opacity-50 cursor-not-allowed">
								App Store
							</div>
							<div class="w-40 h-14 bg-white/10 rounded-xl border border-white/20 flex items-center justify-center grayscale opacity-50 cursor-not-allowed">
								Google Play
							</div>
						</div>
					</div>
					
					<div class="w-px h-20 bg-white/10 hidden sm:block"></div>
					
					<div class="space-y-4">
						<p class="text-sm uppercase tracking-widest text-peacock-blue font-bold">For Institutions</p>
						<a href="/faq" class="px-10 py-4 bg-sanctuary-saffron text-white rounded-full font-bold hover:bg-peacock-blue transition-all block">
							Institutional Inquiries
						</a>
					</div>
				</div>
			</div>
			
			<div class="absolute -top-20 -left-20 w-80 h-80 bg-sanctuary-saffron/10 rounded-full blur-3xl"></div>
			<div class="absolute -bottom-20 -right-20 w-80 h-80 bg-peacock-blue/10 rounded-full blur-3xl"></div>
		</section>
	</main>
	
	<Footer />
</Layout>
