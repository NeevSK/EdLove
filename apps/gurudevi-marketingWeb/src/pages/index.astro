---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import RoadmapSection from '../components/RoadmapSection.astro';
import { LAUNCH, MARKETING_COPY, WEB_LINKS } from '../lib/site';

const machineReadableData = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Gurudevi',
  applicationCategory: 'EducationalApplication',
  operatingSystem: 'Web',
  url: WEB_LINKS.app,
  description: 'A respectful education ecology for the people who make learning possible.',
};

const copy = MARKETING_COPY.en;
---

<Layout title="Home" structuredData={machineReadableData}>
  <Header />
  <main>
    <section class="hero-editorial">
      <img class="hero-editorial__image" src="/hero-teacher-editorial.png" alt="A teacher prepares learning materials in a sunlit Sri Lankan classroom." />
      <div class="hero-editorial__wash"></div>
      <div class="hero-editorial__content">
        <p class="eyebrow hero-editorial__eyebrow">{copy.hero.eyebrow}</p>
        <h1>{copy.hero.title}</h1>
        <p class="hero-editorial__lede">{copy.hero.lede}</p>
        <div class="hero-editorial__actions">
          <a class="button button--primary" href={LAUNCH.ctaTarget}>Follow the Multi-Year Horizon <span aria-hidden="true">↘</span></a>
          <a class="text-link" href="#workspaces">Explore the 4 Workspaces <span aria-hidden="true">↓</span></a>
        </div>
      </div>
      <div class="hero-editorial__caption"><span>Built around the people who make learning possible in Sri Lanka.</span><span aria-hidden="true">↓</span></div>
    </section>

    <section class="section section--intro" id="ecology">
      <div class="section__label eyebrow">The Reality</div>
      <div class="intro-copy">
        <h2>Education is held together by people carrying too much alone.</h2>
        <p>Gurudevi exists to make the relationships around learning easier to see, easier to support, and worthy of care—replacing administrative exhaustion with calm, sovereign spaces.</p>
      </div>
    </section>

    <section class="section section--workspaces" id="workspaces" aria-labelledby="workspaces-title">
      <div class="section__heading">
        <div>
          <p class="eyebrow">The Living Ecology</p>
          <h2 id="workspaces-title">Four spaces, one connected system.</h2>
        </div>
        <p>Each space gives teachers, students, leaders, and families a dignified home—without surveillance or role flattening.</p>
      </div>
      <div class="workspace-list">
        {copy.workspaces.map((workspace, index) => (
          <div class="workspace-row" style={`--delay: ${index * 80}ms`}>
            <span>{workspace.number}</span>
            <div class="workspace-row__title-wrap">
              <p class="eyebrow">{workspace.roleLabel}</p>
              <h3>{workspace.name}</h3>
            </div>
            <p>{workspace.body}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="section section--trust" id="trust" aria-labelledby="trust-title">
      <div class="trust-mark"><img src="/gurudevi-mark.svg" alt="" width="96" height="96" /></div>
      <div>
        <p class="eyebrow">The Promise</p>
        <h2 id="trust-title">Support should never become surveillance.</h2>
        <p class="trust-copy">Gurudevi is engineered with local-first privacy: enough shared coordination to support an entire school, with absolute cryptographic privacy for educators and learners.</p>
        <a class="text-link" href="/about">Read our epistemic foundation & research grounding <span aria-hidden="true">↗</span></a>
      </div>
    </section>

    <RoadmapSection />

    <section class="launch-panel" id="launch" aria-labelledby="launch-title" data-launch-countdown data-launch-at={LAUNCH.iso} data-launch-status={LAUNCH.status}>
      <div><p class="eyebrow">The first opening · Alpha Genesis</p><h2 id="launch-title">Gurudevi Alpha opens on October 6, 2026.</h2><p>We are preparing a public home for a more humane education ecology. Follow the opening, or speak with us about bringing pilot cohorts to your school.</p></div>
      <div class="launch-panel__side"><div class="launch-clock" aria-live="polite"><span data-countdown-value>Preparing the sanctuary…</span><small>{LAUNCH.timezoneLabel} · {LAUNCH.label} (Alpha)</small></div><div class="launch-panel__actions"><a class="button button--dark" href={WEB_LINKS.app} target="_blank" rel="noopener noreferrer">Open the platform <span aria-hidden="true">↗</span></a><a class="text-link" href="/support">Talk to the team</a></div></div>
    </section>
  </main>
  <Footer />
</Layout>

<script is:inline>
  const countdown = document.querySelector('[data-launch-countdown]');
  const value = countdown?.querySelector('[data-countdown-value]');
  const launchAt = countdown?.getAttribute('data-launch-at');
  if (countdown && value && launchAt) {
    const update = () => {
      const remaining = new Date(launchAt).getTime() - Date.now();
      if (remaining <= 0) { value.textContent = 'The sanctuary is open.'; return; }
      const days = Math.floor(remaining / 86400000);
      const hours = Math.floor((remaining % 86400000) / 3600000);
      const minutes = Math.floor((remaining % 3600000) / 60000);
      const seconds = Math.floor((remaining % 60000) / 1000);
      value.textContent = `${days}d ${hours}h ${minutes}m ${seconds}s to launch`;
    };
    update(); window.setInterval(update, 1000);
  }
</script>
