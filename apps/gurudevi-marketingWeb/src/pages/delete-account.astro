---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="Delete Account">
  <Header />

  <main class="flex-grow py-24 px-8">
    <article class="max-w-4xl mx-auto space-y-12">
      <header class="space-y-4">
        <h1 class="text-5xl font-bold text-charcoal-truth">Delete your Gurudevi account</h1>
        <p class="text-xl text-mud-brown">
          We keep the process explicit and human. Request deletion by email, and we’ll confirm once it’s complete.
        </p>
      </header>

      <section class="bg-white rounded-3xl border border-mud-brown/10 shadow-sm p-10 space-y-6">
        <h2 class="text-2xl font-bold text-peacock-blue">How to request deletion</h2>
        <ol class="list-decimal pl-6 space-y-3 text-mud-brown">
          <li>
            Email us at <a class="text-sanctuary-saffron font-bold hover:text-peacock-blue transition-colors" href="mailto:support@gurudevi.lk">support@gurudevi.lk</a>.
          </li>
          <li>Use the subject: <span class="font-semibold">“Delete my Gurudevi account”</span>.</li>
          <li>
            Include:
            <ul class="list-disc pl-6 mt-2 space-y-1">
              <li>The email/phone number you used to sign in</li>
              <li>Your role (Teacher / Student / Principal)</li>
              <li>Your school name (if applicable)</li>
              <li>Any context you want us to know (optional)</li>
            </ul>
          </li>
        </ol>

        <div class="pt-2">
          <a
            class="inline-block px-10 py-4 bg-void-indigo text-sacred-white rounded-full font-bold shadow-xl hover:bg-peacock-blue transition-all"
            href="mailto:support@gurudevi.lk?subject=Delete%20my%20Gurudevi%20account&body=Please%20delete%20my%20Gurudevi%20account.%0A%0AEmail%20or%20phone%20used%20to%20sign%20in%3A%20%0ARole%20(Teacher%2FStudent%2FPrincipal)%3A%20%0ASchool%20(if%20applicable)%3A%20%0A%0AAdditional%20context%20(optional)%3A%20"
          >
            Email deletion request
          </a>
        </div>
      </section>

      <section class="bg-temple-stone/50 p-10 rounded-3xl border border-mud-brown/10 space-y-4 text-mud-brown">
        <h2 class="text-2xl font-bold text-charcoal-truth">Timeline</h2>
        <p>
          We aim to process deletion requests within <span class="font-semibold">7–14 days</span>. If your request is urgent,
          mention it in the email.
        </p>
        <p class="text-sm opacity-80">
          Note: some records may be retained where required for security, fraud prevention, or legal compliance — but we do not
          sell your data and we do not build surveillance profiles.
        </p>
      </section>
    </article>
  </main>

  <Footer />
</Layout>

