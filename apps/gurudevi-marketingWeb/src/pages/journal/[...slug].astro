---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ProvenanceColophon from '../../components/ProvenanceColophon.astro';
import ArticleCurationBridge from '../../components/ArticleCurationBridge.astro';
import AuthorSyndicateAction from '../../components/AuthorSyndicateAction.astro';
import OutboundDistributionPanel from '../../components/OutboundDistributionPanel.astro';
import ReadingProgressBar from '../../components/ReadingProgressBar.astro';
import { absoluteUrl } from '../../lib/site';

export const prerender = true;

export async function getStaticPaths() {
  const entries = await getCollection('journal', ({ data }) => !data.draft && (data.contentKind !== 'translation' || data.translationStatus === 'approved'));
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const versions = await getCollection('journal', ({ data }) => !data.draft && (data.contentKind !== 'translation' || data.translationStatus === 'approved') && data.workId === entry.data.workId);
const alternateLanguages = versions.map((version) => ({
  lang: version.data.language,
  href: absoluteUrl(`/journal/${version.id}`),
}));
const { Content } = await render(entry);
const canonical = entry.data.canonicalUrl ?? absoluteUrl(`/journal/${entry.id}`);
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: entry.data.title,
  description: entry.data.subtitle,
  author: { '@type': 'Person', name: entry.data.author },
  datePublished: entry.data.publishDate.toISOString(),
  dateModified: entry.data.updatedDate?.toISOString() ?? entry.data.publishDate.toISOString(),
  url: canonical,
  inLanguage: entry.data.language,
};
---

<Layout title={`${entry.data.title} | Gurudevi Journal`} description={entry.data.subtitle} image={entry.data.heroImage} ogType="article" canonicalUrl={canonical} alternateLanguages={alternateLanguages} structuredData={structuredData}>
  <ReadingProgressBar />
  <Header />
  <main class="mx-auto max-w-5xl px-6 pb-24 pt-32 md:px-10">
    <article class="mx-auto max-w-[68ch]">
      <header class="space-y-5">
        <div class="flex items-center gap-2 text-[11px] font-mono uppercase tracking-[0.25em] font-bold text-sanctuary-saffron">
          <span>Gurudevi Journal</span>
          <span>•</span>
          <span class="text-charcoal-truth/60">{entry.data.language.toUpperCase()}</span>
        </div>

        <h1 class="font-display text-3xl sm:text-4xl md:text-5xl leading-[1.12] text-charcoal-truth tracking-tight">
          {entry.data.title}
        </h1>

        <p class="text-lg sm:text-xl leading-relaxed text-charcoal-truth/80 font-serif italic">
          {entry.data.subtitle}
        </p>

        <!-- Sovereign Unified Provenance Colophon (Compact Byline + Expandable Rigor Drawer) -->
        <div class="pt-2">
          <ProvenanceColophon
            author={entry.data.author}
            scribe={entry.data.scribe}
            scribeNote={entry.data.scribeNote}
            publishDate={entry.data.publishDate}
            updatedDate={entry.data.updatedDate}
            cadence="living-document"
            version={entry.data.language.toUpperCase()}
            license={entry.data.license}
            canonicalUrl={canonical}
            readingTime={entry.data.readingTime}
            translationStatus={entry.data.translationStatus}
            language={entry.data.language}
            customNote={`Published in Gurudevi Journal (${entry.data.contentKind} piece). License: ${entry.data.license}.`}
          />
        </div>

        {(entry.data.contentKind === 'curated' || entry.data.contentKind === 'licensed' || Boolean(entry.data.canonicalUrl && entry.data.canonicalUrl !== canonical)) && (
          <ArticleCurationBridge
            sourcePublication="EdLove Journal"
            sourceUrl={entry.data.canonicalUrl ?? entry.data.source}
            contentKind={entry.data.contentKind}
            pedagogicalNote={entry.data.scribeNote}
            author={entry.data.author}
          />
        )}

        <!-- Author On-Demand Syndication Action (Visible in Dev/Editor Mode Only) -->
        {import.meta.env.DEV && entry.data.contentKind === 'original' && (
          <AuthorSyndicateAction
            title={entry.data.title}
            url={canonical}
            targetPublication="edlove"
            summary={entry.data.subtitle}
            pedagogicalTakeaway={entry.data.scribeNote}
          />
        )}

        <!-- Outbound Social Distribution Pipeline (Visible in Dev/Reviewer Mode Only) -->
        {import.meta.env.DEV && (
          <OutboundDistributionPanel
            title={entry.data.title}
            url={canonical}
            author={entry.data.author}
            topics={entry.data.topics}
            summary={entry.data.subtitle}
          />
        )}

        {entry.data.heroImage && (
          <div class="my-8 overflow-hidden rounded-3xl border border-charcoal-truth/10 shadow-md max-h-[440px]">
            <img
              src={entry.data.heroImage}
              alt={entry.data.title}
              class="w-full object-cover aspect-[16/9]"
              loading="eager"
            />
          </div>
        )}
      </header>

      <!-- Editorial Body with Drop Cap Initial and Harmonic Prose Rhythm -->
      <div class="prose prose-base sm:prose-lg mt-12 max-w-none text-charcoal-truth/90 font-content leading-relaxed prose-headings:font-display prose-headings:text-charcoal-truth prose-h2:text-2xl prose-h2:mt-10 prose-h2:mb-4 prose-h3:text-xl prose-p:my-5 prose-drop-cap prose-blockquote:border-sanctuary-saffron prose-img:rounded-3xl prose-figcaption:text-center prose-figcaption:italic prose-figcaption:opacity-75">
        <Content />
      </div>
    </article>
  </main>
  <Footer />
</Layout>
