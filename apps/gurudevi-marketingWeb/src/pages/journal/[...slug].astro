---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { absoluteUrl } from '../../lib/site';

export const prerender = true;

export async function getStaticPaths() {
  const entries = await getCollection('journal', ({ data }) => !data.draft && (data.contentKind !== 'translation' || data.translationStatus === 'approved'));
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const versions = await getCollection('journal', ({ data }) => !data.draft && (data.contentKind !== 'translation' || data.translationStatus === 'approved') && data.workId === entry.data.workId);
const alternateLanguages = versions.map((version) => ({
  lang: version.data.language,
  href: absoluteUrl(`/journal/${version.id}`),
}));
const { Content } = await render(entry);
const canonical = entry.data.canonicalUrl ?? absoluteUrl(`/journal/${entry.id}`);
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: entry.data.title,
  description: entry.data.subtitle,
  author: { '@type': 'Person', name: entry.data.author },
  datePublished: entry.data.publishDate.toISOString(),
  dateModified: entry.data.updatedDate?.toISOString() ?? entry.data.publishDate.toISOString(),
  url: canonical,
  inLanguage: entry.data.language,
};
---

<Layout title={`${entry.data.title} | Gurudevi Journal`} description={entry.data.subtitle} image={entry.data.heroImage} ogType="article" alternateLanguages={alternateLanguages} structuredData={structuredData}>
  <Header />
  <main class="mx-auto max-w-5xl px-6 pb-24 pt-32 md:px-10">
    <article class="mx-auto max-w-3xl">
      <header class="space-y-6">
        <p class="eyebrow">Gurudevi Journal · {entry.data.language}</p>
        <h1 class="font-display text-5xl leading-tight text-charcoal-truth md:text-7xl">{entry.data.title}</h1>
        <p class="text-xl leading-relaxed text-charcoal-truth/70 md:text-2xl">{entry.data.subtitle}</p>
        <div class="flex flex-wrap gap-4 text-sm text-charcoal-truth/60">{entry.data.authorId ? <a href={`/authors/${entry.data.authorId}`} class="underline">By {entry.data.author}</a> : <span>By {entry.data.author}</span>}<time datetime={entry.data.publishDate.toISOString()}>{entry.data.publishDate.toLocaleDateString('en-GB')}</time>{entry.data.readingTime && <span>{entry.data.readingTime} min read</span>}</div>
      </header>
      <div class="prose prose-lg mt-16 max-w-none text-charcoal-truth/80"><Content /></div>
      <footer class="mt-16 border-t border-charcoal-truth/10 pt-6 text-sm text-charcoal-truth/60"><p>Canonical source: <a href={canonical} class="underline">{canonical}</a></p><p>Published under {entry.data.license}.</p></footer>
    </article>
  </main>
  <Footer />
</Layout>
