---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SupportForm from '../components/SupportForm.svelte';
import { CONTACT_EMAILS } from '../lib/site';
---

<Layout title="Support & Feedback"><Header /><main><section class="page-intro"><p class="eyebrow">Support</p><h1>Tell us what would make the work lighter.</h1><p>Report a problem, share feedback, request a feature, or ask about bringing Gurudevi to your school.</p></section><section class="section support-layout"><div><p class="eyebrow">A direct line</p><h2>We are still listening closely.</h2><p>Gurudevi is being shaped with the people who will use it. Your report does not disappear into a queue—it helps us understand where the system needs to become more useful, more careful, or more clear.</p><div class="support-links"><a href={`mailto:${CONTACT_EMAILS.support}?subject=Gurudevi%20Support`}>Support & bugs ↗</a><a href={`mailto:${CONTACT_EMAILS.institutional}?subject=Gurudevi%20School%20conversation`}>School conversation ↗</a><a href={`mailto:${CONTACT_EMAILS.gratitude}?subject=Gurudevi%20Thuthimal`}>Thuthimal ↗</a></div></div><div class="support-form-wrap"><SupportForm client:load /></div></section></main><Footer /></Layout>
