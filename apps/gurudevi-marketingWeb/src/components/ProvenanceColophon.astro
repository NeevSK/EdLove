---
export type ContentCadence = 'perennial' | 'living-document' | 'diagnostic' | 'field-report' | 'archival';
export type TranslationStatus = 'not_applicable' | 'draft' | 'machine_generated' | 'in_review' | 'approved';

export interface Props {
  author?: string;
  scribe?: string;
  scribeNote?: string;
  publishDate?: Date | string;
  updatedDate?: Date | string;
  cadence?: ContentCadence;
  version?: string;
  license?: string;
  canonicalUrl?: string;
  readingTime?: number;
  wordCount?: number;
  customNote?: string;
  translationStatus?: TranslationStatus;
  translator?: string;
  language?: string;
  class?: string;
}

const {
  author = 'Gurudevi Sanctuary Circle',
  scribe = 'Antigravity',
  scribeNote,
  publishDate,
  updatedDate,
  cadence = 'living-document',
  version = 'v1.0',
  license = 'CC BY-SA 4.0',
  canonicalUrl,
  readingTime,
  customNote,
  translationStatus = 'not_applicable',
  translator,
  language = 'en',
  class: className = '',
} = Astro.props;

const parsedPublished = publishDate ? (publishDate instanceof Date ? publishDate : new Date(publishDate)) : null;
const parsedUpdated = updatedDate ? (updatedDate instanceof Date ? updatedDate : new Date(updatedDate)) : null;

const formattedPublished = parsedPublished
  ? new Intl.DateTimeFormat('en-US', {
      month: 'short',
      day: 'numeric',
      year: 'numeric',
    }).format(parsedPublished)
  : null;

const formattedUpdated = parsedUpdated
  ? new Intl.DateTimeFormat('en-US', {
      month: 'short',
      day: 'numeric',
      year: 'numeric',
    }).format(parsedUpdated)
  : null;

const cadenceMap: Record<
  ContentCadence,
  { label: string; explanation: string }
> = {
  perennial: {
    label: 'Foundational Canon',
    explanation: 'Perennial philosophy & ecological manifesto. Maintained as stable, enduring canon.',
  },
  'living-document': {
    label: 'Living Framework',
    explanation: 'Active sanctuary framework & operational guidance. Reviewed and refined as practice matures.',
  },
  diagnostic: {
    label: 'Empirical Diagnostic',
    explanation: 'Time-sensitive field diagnostic assessing ground realities across classrooms.',
  },
  'field-report': {
    label: 'Field Dispatch',
    explanation: 'Classroom reflections and pedagogical field experiments.',
  },
  archival: {
    label: 'Archival Record',
    explanation: 'Preserved documentation of previous milestones and versions.',
  },
};

const cadenceMeta = cadenceMap[cadence] || cadenceMap['living-document'];
---

<div class:list={["w-full", className]}>
  <details class="colophon-card group">
    <!-- Compact Summary Byline (Always Visible, Single Line) -->
    <summary class="colophon-summary">
      <div class="colophon-summary__left">
        <span class="colophon-summary__author">{author}</span>
        {formattedPublished && (
          <span class="colophon-summary__date">
            <span class="colophon-dot" aria-hidden="true">·</span>
            <time datetime={parsedPublished?.toISOString()}>{formattedPublished}</time>
          </span>
        )}
        {formattedUpdated && (
          <span class="colophon-summary__updated">
            <span class="colophon-dot" aria-hidden="true">·</span>
            <span>Rev. {formattedUpdated}</span>
          </span>
        )}
        {readingTime && (
          <span class="colophon-summary__time">
            <span class="colophon-dot" aria-hidden="true">·</span>
            <span>{readingTime} min read</span>
          </span>
        )}
      </div>

      <div class="colophon-summary__right">
        {translationStatus === 'approved' && (
          <span class="colophon-tag colophon-tag--verified">
            <span>✦ Verified</span>
          </span>
        )}
        {translationStatus === 'machine_generated' && (
          <span class="colophon-tag colophon-tag--draft">
            <span>Machine Translated</span>
          </span>
        )}

        <!-- Cadence Badge -->
        <span class="colophon-tag colophon-tag--cadence">
          <span>{cadenceMeta.label}</span>
          <span class="colophon-tag__sub">· {version}</span>
        </span>

        <!-- Chevron Indicator -->
        <span class="colophon-chevron" aria-hidden="true">▾</span>
      </div>
    </summary>

    <!-- Expanded Epistemic Provenance Drawer -->
    <div class="colophon-drawer">
      <div class="colophon-grid">
        <!-- Col 1: Stewardship & Authorship -->
        <div class="colophon-col">
          <p class="eyebrow colophon-eyebrow">Stewardship & Authorship</p>
          <h4 class="colophon-col__title">{author}</h4>
          <p class="colophon-col__desc">
            <strong>Intent & Custody:</strong> Grounded in pedagogical care and authorial stewardship.
          </p>
          {scribe && (
            <div class="colophon-scribe">
              <span class="colophon-scribe__tag">Scribe: {scribe}</span>
              <p class="colophon-scribe__note">
                {scribeNote ?? `Transcribed under authorial stewardship by ${scribe}.`}
              </p>
            </div>
          )}
          {translator && (
            <p class="colophon-col__desc mt-2">
              <strong>Translator:</strong> {translator} ({translationStatus})
            </p>
          )}
        </div>

        <!-- Col 2: Epistemic Rigor & Dates -->
        <div class="colophon-col">
          <p class="eyebrow colophon-eyebrow">Verification & Cadence</p>
          <div class="colophon-meta-list">
            {formattedPublished && (
              <div class="colophon-meta-item">
                <span>Inscribed</span>
                <strong>{formattedPublished}</strong>
              </div>
            )}
            <div class="colophon-meta-item">
              <span>Cadence</span>
              <strong>{formattedUpdated ?? formattedPublished ?? 'Continuous'}</strong>
            </div>
            {readingTime && (
              <div class="colophon-meta-item">
                <span>Reading Pace</span>
                <strong>{readingTime} min contemplative</strong>
              </div>
            )}
          </div>
          <p class="colophon-col__note">
            {customNote ?? cadenceMeta.explanation}
          </p>
        </div>

        <!-- Col 3: Rights & Canonical Ledger -->
        <div class="colophon-col">
          <p class="eyebrow colophon-eyebrow">Open Knowledge Rights</p>
          <h4 class="colophon-col__title">{license}</h4>
          <p class="colophon-col__desc">
            Open Knowledge Commons. Free for attribution and non-commercial learning reproduction.
          </p>
          {canonicalUrl && (
            <div class="colophon-col__link-wrap">
              <a
                href={canonicalUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="colophon-link"
              >
                <span>Canonical Ledger</span>
                <span aria-hidden="true">↗</span>
              </a>
            </div>
          )}
        </div>
      </div>
    </div>
  </details>
</div>

<style>
  .colophon-card {
    background: #ede5d7;
    border: 1px solid rgb(104 94 85 / 0.18);
    border-radius: 4px;
    overflow: hidden;
    transition: border-color 200ms ease, box-shadow 200ms ease, background-color 200ms ease;
  }

  .colophon-card:hover {
    border-color: rgb(168 80 34 / 0.4);
    box-shadow: 0 4px 16px -4px rgba(29, 41, 51, 0.06);
  }

  .colophon-summary {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 18px 24px;
    cursor: pointer;
    list-style: none;
    user-select: none;
    background: transparent;
    font-size: 1.05rem;
    color: var(--color-charcoal-truth);
  }

  .colophon-summary::-webkit-details-marker {
    display: none;
  }

  .colophon-summary__left {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    color: var(--color-mud-brown);
  }

  .colophon-summary__author {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.12rem;
    color: var(--color-charcoal-truth);
    letter-spacing: 0.01em;
  }

  .colophon-dot {
    color: var(--color-mud-brown);
    opacity: 0.5;
    margin-right: 8px;
  }

  .colophon-summary__date,
  .colophon-summary__updated,
  .colophon-summary__time {
    font-size: 0.98rem;
    color: var(--color-mud-brown);
    letter-spacing: 0.02em;
  }

  .colophon-summary__right {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-left: auto;
  }

  .colophon-tag {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 14px;
    border-radius: 999px;
    font-family: var(--font-ui-grotesque);
    font-size: 0.88rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .colophon-tag--cadence {
    background: #fbe6cb;
    color: #824112;
    border: 1px solid rgba(168, 80, 34, 0.28);
  }

  .colophon-tag__sub {
    opacity: 0.8;
    font-weight: 600;
  }

  .colophon-tag--verified {
    background: rgba(45, 90, 55, 0.12);
    color: #2d5a37;
    border: 1px solid rgba(45, 90, 55, 0.28);
  }

  .colophon-tag--draft {
    background: rgba(168, 80, 34, 0.12);
    color: #a85022;
    border: 1px solid rgba(168, 80, 34, 0.28);
  }

  .colophon-chevron {
    color: var(--color-sanctuary-saffron);
    font-size: 1.25rem;
    line-height: 1;
    transition: transform 220ms ease;
  }

  details[open] .colophon-chevron {
    transform: rotate(180deg);
  }

  /* Expanded Drawer */
  .colophon-drawer {
    border-top: 1px solid rgb(104 94 85 / 0.16);
    background: var(--color-sacred-white);
    padding: 36px 32px;
    animation: drawer-fade-in 220ms ease-out both;
  }

  .colophon-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 36px;
  }

  .colophon-col {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding-right: 20px;
    border-right: 1px solid rgb(104 94 85 / 0.14);
  }

  .colophon-col:last-child {
    border-right: none;
    padding-right: 0;
  }

  .colophon-eyebrow {
    color: var(--color-sanctuary-saffron);
    font-size: 0.88rem;
    letter-spacing: 0.12em;
    margin: 0;
  }

  .colophon-col__title {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 600;
    color: var(--color-charcoal-truth);
    margin: 0;
    letter-spacing: 0.005em;
  }

  .colophon-col__desc {
    margin: 0;
    font-size: 1.05rem;
    line-height: 1.72;
    color: var(--color-mud-brown);
    letter-spacing: 0.02em;
  }

  .colophon-scribe {
    margin-top: 8px;
    padding-top: 14px;
    border-top: 1px solid rgb(104 94 85 / 0.14);
  }

  .colophon-scribe__tag {
    display: inline-block;
    padding: 3px 12px;
    border-radius: 999px;
    background: #ede5d7;
    border: 1px solid rgb(104 94 85 / 0.2);
    font-family: var(--font-mono-sanctuary);
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--color-charcoal-truth);
    letter-spacing: 0.04em;
  }

  .colophon-scribe__note {
    margin: 10px 0 0;
    font-size: 1rem;
    line-height: 1.65;
    color: var(--color-mud-brown);
    font-style: italic;
    letter-spacing: 0.02em;
  }

  .colophon-meta-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .colophon-meta-item {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    font-size: 1.02rem;
    color: var(--color-mud-brown);
    letter-spacing: 0.02em;
  }

  .colophon-meta-item strong {
    color: var(--color-charcoal-truth);
    font-weight: 600;
  }

  .colophon-col__note {
    margin-top: 10px;
    padding-top: 14px;
    border-top: 1px solid rgb(104 94 85 / 0.14);
    font-size: 1rem;
    line-height: 1.68;
    color: var(--color-mud-brown);
    font-style: italic;
    letter-spacing: 0.02em;
  }

  .colophon-col__link-wrap {
    margin-top: 6px;
    padding-top: 12px;
  }

  .colophon-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-ui-grotesque);
    font-size: 0.98rem;
    font-weight: 700;
    color: var(--color-sanctuary-saffron);
    text-decoration: underline;
    text-underline-offset: 0.25em;
    letter-spacing: 0.04em;
  }

  .colophon-link:hover {
    color: var(--color-charcoal-truth);
  }

  @keyframes drawer-fade-in {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 860px) {
    .colophon-grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .colophon-col {
      padding-right: 0;
      padding-bottom: 20px;
      border-right: none;
      border-bottom: 1px solid rgb(104 94 85 / 0.14);
    }

    .colophon-col:last-child {
      padding-bottom: 0;
      border-bottom: none;
    }

    .colophon-summary {
      padding: 14px 18px;
    }

    .colophon-drawer {
      padding: 24px 18px;
    }
  }
</style>

