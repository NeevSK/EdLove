---
import { SOCIAL_LINKS, WEB_LINKS } from '../lib/site';
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="site-footer__grid">
    <div class="site-footer__brand"><div class="brand brand--footer"><img src="/gurudevi-mark.svg" alt="" width="28" height="28" /><span>Gurudevi</span></div><p>Technology that gives energy back to education.</p></div>
    <div><p class="eyebrow footer-label">Explore</p><div class="footer-links"><a href="/about">The ecology</a><a href="/faq">Questions</a><a href="/support">Support</a><a href="/thuthimal">Thuthimal</a></div></div>
    <div><p class="eyebrow footer-label">Elsewhere</p><div class="footer-links"><a href={WEB_LINKS.app} target="_blank" rel="noopener noreferrer">Open platform ↗</a><a href={WEB_LINKS.edlove} target="_blank" rel="noopener noreferrer">EdLove ↗</a><a href={SOCIAL_LINKS.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a></div></div>
  </div>
  <div class="site-footer__bottom"><span>© {currentYear} Gurudevi · Part of EdLove</span><span><a href="/privacy">Privacy</a> · <a href="/terms">Terms</a> · <a href="/delete-account">Delete account</a></span></div>
</footer>
