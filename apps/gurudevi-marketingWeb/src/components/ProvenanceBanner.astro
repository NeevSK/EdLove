---
export type ContentCadence = 'perennial' | 'living-document' | 'diagnostic' | 'field-report' | 'archival';

export interface ProvenanceProps {
  cadence: ContentCadence;
  author?: string;
  createdDate?: string | Date;
  updatedDate?: string | Date;
  version?: string;
  customNote?: string;
  class?: string;
}

const {
  cadence = 'living-document',
  author = 'Gurudevi Sanctuary Circle',
  createdDate,
  updatedDate,
  version,
  customNote,
  class: className = '',
} = Astro.props as ProvenanceProps;

const cadenceConfig: Record<
  ContentCadence,
  { label: string; badgeClass: string; icon: string; defaultNote: string }
> = {
  perennial: {
    label: 'Foundational Canon',
    badgeClass: 'bg-sage-green/15 text-sage-green border-sage-green/30',
    icon: '🏛️',
    defaultNote: 'Perennial philosophy & ecological sanctuary manifesto. Maintained as stable foundational canon.',
  },
  'living-document': {
    label: 'Living Framework',
    badgeClass: 'bg-sanctuary-saffron/15 text-sanctuary-saffron border-sanctuary-saffron/30',
    icon: '🌱',
    defaultNote: 'Active sanctuary framework & operational guidance. Reviewed as community practice matures.',
  },
  diagnostic: {
    label: 'Empirical Diagnostic',
    badgeClass: 'bg-peacock-blue/15 text-peacock-blue border-peacock-blue/30',
    icon: '📊',
    defaultNote: 'Time-sensitive field diagnostic assessing real conditions across schools and teaching spaces.',
  },
  'field-report': {
    label: 'Field Dispatch',
    badgeClass: 'bg-teal-water/15 text-teal-water border-teal-water/30',
    icon: '🧭',
    defaultNote: 'Classroom reflections and pedagogical field experiments.',
  },
  archival: {
    label: 'Archival Record',
    badgeClass: 'bg-mud-brown/15 text-mud-brown border-mud-brown/30',
    icon: '📜',
    defaultNote: 'Preserved documentation of previous releases and architectural milestones.',
  },
};

const current = cadenceConfig[cadence] || cadenceConfig['living-document'];
const note = customNote || current.defaultNote;

function formatDate(d?: string | Date): string | null {
  if (!d) return null;
  const dateObj = typeof d === 'string' ? new Date(d) : d;
  if (isNaN(dateObj.getTime())) return null;
  return dateObj.toLocaleDateString('en-GB', {
    month: 'short',
    year: 'numeric',
  });
}

const formattedCreated = formatDate(createdDate);
const formattedUpdated = formatDate(updatedDate);
---

<div
  class:list={[
    "w-full max-w-3xl mx-auto rounded-2xl border border-charcoal-truth/10 bg-temple-stone/40 backdrop-blur-md p-4 sm:p-5 shadow-xs text-charcoal-truth transition-all duration-300",
    className
  ]}
  role="region"
  aria-label="Document Provenance and Update Cadence"
>
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs font-mono">
    <!-- Cadence badge and author -->
    <div class="flex flex-wrap items-center gap-2">
      <span class:list={["inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full border text-[11px] font-semibold tracking-wide", current.badgeClass]}>
        <span>{current.icon}</span>
        <span>{current.label}</span>
      </span>
      <span class="text-charcoal-truth/70 font-sans font-medium">
        by <strong class="font-semibold text-charcoal-truth">{author}</strong>
      </span>
    </div>

    <!-- Dates & Version -->
    <div class="flex flex-wrap items-center gap-3 text-charcoal-truth/60 text-[11px]">
      {formattedCreated && (
        <span>
          Est: <time datetime={typeof createdDate === 'string' ? createdDate : createdDate?.toISOString()}>{formattedCreated}</time>
        </span>
      )}
      {formattedUpdated && (
        <span class="flex items-center gap-1">
          <span class="text-sanctuary-saffron">●</span>
          Rev: <time datetime={typeof updatedDate === 'string' ? updatedDate : updatedDate?.toISOString()}>{formattedUpdated}</time>
        </span>
      )}
      {version && (
        <span class="px-2 py-0.5 rounded-sm bg-charcoal-truth/5 text-charcoal-truth/80 font-bold">
          {version}
        </span>
      )}
    </div>
  </div>

  <!-- Cadence note (time sensitivity explanation) -->
  <div class="mt-2.5 pt-2.5 border-t border-charcoal-truth/10 flex items-start gap-2 text-[12px] font-serif text-charcoal-truth/70 italic leading-relaxed">
    <span class="text-xs shrink-0 text-sanctuary-saffron not-italic">ℹ</span>
    <span>{note}</span>
  </div>
</div>
