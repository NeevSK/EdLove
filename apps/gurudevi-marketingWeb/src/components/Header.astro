---
const navItems = [
  { name: 'About', href: '/about' },
  { name: 'Thuthimal', href: '/thuthimal' },
  { name: 'FAQ', href: '/faq' },
  { name: 'Support', href: '/support' },
];
---

<header class="w-full py-4 md:py-6 px-6 md:px-8 flex justify-between items-center bg-white/70 backdrop-blur-xl sticky top-0 z-[100] border-b border-mud-brown/10">
  <!-- Logo/Home Link -->
  <a href="/" class="group flex items-center space-x-3 hover:scale-105 transition-transform duration-300">
    <div class="w-10 h-10 md:w-12 md:h-12 bg-sanctuary-saffron rounded-full flex items-center justify-center text-white font-bold text-xl md:text-2xl shadow-lg group-hover:bg-peacock-blue transition-colors">
      G
    </div>
    <span class="text-xl md:text-2xl font-bold tracking-tight text-charcoal-truth">Gurudevi</span>
  </a>
  
  <!-- Desktop Navigation -->
  <nav class="hidden md:block">
    <ul class="flex space-x-8">
      {navItems.map((item) => (
        <li>
          <a 
            href={item.href} 
            class="text-mud-brown hover:text-sanctuary-saffron transition-colors font-semibold py-2"
          >
            {item.name}
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <div class="hidden md:flex items-center space-x-4">
    <a 
      href="https://platform.gurudevi.edlove.org" 
      class="bg-sanctuary-saffron text-sacred-white px-6 py-2.5 rounded-full font-bold shadow-md hover:bg-peacock-blue transition-all transform hover:scale-105"
    >
      Open Platform
    </a>
  </div>

  <!-- Mobile Toggle -->
  <button id="menu-toggle" class="md:hidden p-2 text-mud-brown hover:text-sanctuary-saffron transition-colors" aria-label="Toggle Menu">
    <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7" />
    </svg>
  </button>

  <!-- Mobile Navigation Overlay -->
  <div id="mobile-menu" class="fixed inset-0 bg-cream-silence z-[200] transform translate-x-full transition-transform duration-500 ease-in-out md:hidden flex flex-col items-center justify-center space-y-8 p-8">
    <button id="menu-close" class="absolute top-6 right-6 p-2 text-mud-brown" aria-label="Close Menu">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
    
    <div class="w-20 h-20 bg-sanctuary-saffron rounded-full flex items-center justify-center text-white font-bold text-4xl mb-4">G</div>
    
    <nav class="w-full text-center">
      <ul class="space-y-6">
        {navItems.map((item) => (
          <li>
            <a href={item.href} class="text-3xl font-bold text-charcoal-truth hover:text-sanctuary-saffron block py-2">{item.name}</a>
          </li>
        ))}
        <li>
          <a href="https://platform.gurudevi.edlove.org" class="inline-block mt-4 px-10 py-4 bg-sanctuary-saffron text-white rounded-full font-bold text-xl">Open Platform</a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const close = document.getElementById('menu-close');
  const menu = document.getElementById('mobile-menu');
  const links = document.querySelectorAll('#mobile-menu a');

  const toggleMenu = () => {
    menu?.classList.toggle('translate-x-full');
    document.body.classList.toggle('overflow-hidden');
  };

  toggle?.addEventListener('click', toggleMenu);
  close?.addEventListener('click', toggleMenu);
  links.forEach(link => link.addEventListener('click', toggleMenu));
</script>
