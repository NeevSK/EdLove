---
export interface Props {
  src: string;
  alt: string;
  caption?: string;
  credit?: string;
  aspectRatio?: '16/9' | '4/3' | '1/1' | 'auto';
  class?: string;
}

const {
  src,
  alt,
  caption,
  credit,
  aspectRatio = '16/9',
  class: className = '',
} = Astro.props;

const aspectClass = {
  '16/9': 'aspect-[16/9]',
  '4/3': 'aspect-[4/3]',
  '1/1': 'aspect-square',
  'auto': 'aspect-auto max-h-[550px]',
}[aspectRatio];
---

<figure class:list={["my-10 w-full", className]}>
  <div class="overflow-hidden rounded-3xl border border-charcoal-truth/10 bg-temple-stone/20 shadow-md">
    <img
      src={src}
      alt={alt}
      loading="lazy"
      decoding="async"
      class:list={["w-full object-cover transition-transform duration-700 hover:scale-102", aspectClass]}
    />
  </div>
  {(caption || credit) && (
    <figcaption class="mt-3 text-center text-xs font-serif text-charcoal-truth/70 italic leading-relaxed px-4">
      {caption && <span>{caption}</span>}
      {credit && <span class="block mt-0.5 text-[10px] font-mono not-italic uppercase tracking-widest text-charcoal-truth/50">Photo / Illustration: {credit}</span>}
    </figcaption>
  )}
</figure>
