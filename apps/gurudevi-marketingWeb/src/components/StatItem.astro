---
interface Props {
  value: string;
  label: string;
  icon: string;
}

const { value, label, icon } = Astro.props;
---

<div class="text-center space-y-2 p-6 group">
  <div class="w-16 h-16 mx-auto bg-sage-green/10 rounded-2xl flex items-center justify-center text-sage-green group-hover:bg-sage-green group-hover:text-white transition-all duration-300 transform group-hover:rotate-6">
    <Fragment set:html={icon} />
  </div>
  <div class="text-4xl font-bold text-charcoal-truth">{value}</div>
  <div class="text-sm text-mud-brown/60 uppercase tracking-widest font-semibold">{label}</div>
</div>
