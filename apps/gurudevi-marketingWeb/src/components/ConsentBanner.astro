<aside id="consent-banner" hidden class="fixed inset-x-4 bottom-4 z-[300] mx-auto max-w-2xl rounded-2xl border border-mud-brown/20 bg-white p-5 shadow-2xl" aria-label="Privacy choices">
  <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <h2 class="font-bold text-charcoal-truth">A quiet note about privacy</h2>
      <p class="mt-1 text-sm leading-relaxed text-mud-brown">
        We use essential cookies to keep the site working. Optional analytics helps us understand visits and improve the experience. You can choose whether to allow it.
        <a href="/privacy" class="font-semibold text-sanctuary-saffron underline">Read the draft Privacy Policy</a>.
      </p>
    </div>
    <div class="flex shrink-0 gap-2">
      <button id="consent-decline" type="button" class="min-h-11 rounded-full border border-mud-brown/30 px-4 py-2 text-sm font-semibold text-charcoal-truth">Decline</button>
      <button id="consent-accept" type="button" class="min-h-11 rounded-full bg-void-indigo px-4 py-2 text-sm font-semibold text-white">Allow analytics</button>
    </div>
  </div>
</aside>

<script is:inline>
  const banner = document.getElementById('consent-banner');
  const consentKey = 'gurudevi-analytics-consent';
  const storedConsent = window.localStorage.getItem(consentKey);
  if (banner && !storedConsent) banner.hidden = false;
  document.getElementById('consent-accept')?.addEventListener('click', () => {
    window.localStorage.setItem(consentKey, 'granted');
    banner.hidden = true;
    window.dispatchEvent(new CustomEvent('gurudevi:analytics-consent', { detail: 'granted' }));
  });
  document.getElementById('consent-decline')?.addEventListener('click', () => {
    window.localStorage.setItem(consentKey, 'denied');
    banner.hidden = true;
    window.dispatchEvent(new CustomEvent('gurudevi:analytics-consent', { detail: 'denied' }));
  });
</script>
