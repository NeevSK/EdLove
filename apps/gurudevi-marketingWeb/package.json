{
  "name": "apps-gurudevi-marketing-web",
  "type": "module",
  "version": "0.0.2",
  "scripts": {
    "dev": "pnpm exec astro dev",
    "build": "pnpm exec astro build",
    "preview": "pnpm exec astro preview",
    "astro": "pnpm exec astro",
    "lint": "pnpm run lint:biome && pnpm run lint:eslint",
    "check-types": "pnpm exec tsc --noEmit",
    "lint:biome": "biome check .",
    "lint:eslint": "eslint .",
    "format": "biome format --write .",
    "check-cycles": "node ../../scripts/refactor/sovereign-cycle-checker.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "clean": "rm -rf .turbo node_modules dist"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/svelte": "^8.1.2",
    "@astrojs/vercel": "^10.0.8",
    "@repo/analytics": "workspace:*",
    "@repo/core": "workspace:*",
    "@repo/form-builder": "workspace:*",
    "@repo/ui": "workspace:*",
    "@supabase/supabase-js": "2.102.1",
    "@tailwindcss/vite": "^4.3.0",
    "astro": "^6.4.4",
    "inngest": "^4.5.0",
    "svelte": "^5.56.3",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:^",
    "@repo/typescript-config": "workspace:*",
    "@types/react": "^19.2.17",
    "eslint": "^10.4.1",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.8"
  }
}
