{
  "name": "apps-gurudevi-marketing-web",
  "type": "module",
  "version": "0.0.2",
  "scripts": {
    "dev": "node ../../scripts/run-and-report.mjs --cmd \"pnpm exec astro dev\" --name \"apps_gurudevi-marketingWeb-dev\"",
    "build": "node ../../scripts/run-and-report.mjs --cmd \"pnpm exec astro build\" --name \"apps_gurudevi-marketingWeb-build\"",
    "preview": "node ../../scripts/run-and-report.mjs --cmd \"pnpm exec astro preview\" --name \"apps_gurudevi-marketingWeb-preview\"",
    "astro": "node ../../scripts/run-and-report.mjs --cmd \"pnpm exec astro\" --name \"apps_gurudevi-marketingWeb-astro\"",
    "lint": "node ../../scripts/run-and-report.mjs --cmd \"pnpm run lint:biome && pnpm run lint:eslint\" --name \"apps_gurudevi-marketingWeb-lint\"",
    "check-types": "node ../../scripts/run-and-report.mjs --cmd \"pnpm exec tsc --build --noEmit\" --name \"apps_gurudevi-marketingWeb-check-types\"",
    "lint:biome": "node ../../scripts/run-and-report.mjs --cmd \"node ../../scripts/scoped-biome.mjs\" --name \"apps_gurudevi-marketingWeb-lint_biome\"",
    "lint:eslint": "node ../../scripts/run-and-report.mjs --cmd \"eslint .\" --name \"apps_gurudevi-marketingWeb-lint_eslint\"",
    "format": "node ../../scripts/run-and-report.mjs --cmd \"node ../../scripts/scoped-biome.mjs --write\" --name \"apps_gurudevi-marketingWeb-format\"",
    "check-cycles": "node ../../scripts/run-and-report.mjs --cmd \"node ../../scripts/refactor/sovereign-cycle-checker.mjs\" --name \"apps_gurudevi-marketingWeb-check-cycles\"",
    "test": "node ../../scripts/run-and-report.mjs --cmd \"vitest run\" --name \"apps_gurudevi-marketingWeb-test\"",
    "test:watch": "node ../../scripts/run-and-report.mjs --cmd \"vitest\" --name \"apps_gurudevi-marketingWeb-test_watch\"",
    "test:ui": "node ../../scripts/run-and-report.mjs --cmd \"vitest --ui\" --name \"apps_gurudevi-marketingWeb-test_ui\"",
    "doctor": "node ../../scripts/run-and-report.mjs --cmd \"npx -y react-doctor --yes --no-telemetry --blocking none\" --name \"apps_gurudevi-marketingWeb-doctor\"",
    "doctor:design": "node ../../scripts/run-and-report.mjs --cmd \"npx -y react-doctor design --no-telemetry\" --name \"apps_gurudevi-marketingWeb-doctor-design\"",
    "clean": "node ../../scripts/run-and-report.mjs --cmd \"rm -rf .turbo node_modules dist\" --name \"apps_gurudevi-marketingWeb-clean\""
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/svelte": "^9.0.1",
    "@astrojs/vercel": "^11.0.10",
    "@intuitui-labs/a11y-gate": "link:C:/projects/packages/a11y-gate",
    "@repo/editorial": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.2",
    "svelte": "^5.57.0",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@repo/eslint-config": "workspace:^",
    "@repo/typescript-config": "workspace:*",
    "@types/react": "^19.3.0",
    "eslint": "^10.10.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.0"
  },
  "_originalScripts": {
    "dev": "pnpm exec astro dev",
    "build": "pnpm exec astro build",
    "preview": "pnpm exec astro preview",
    "astro": "pnpm exec astro",
    "lint": "pnpm run lint:biome && pnpm run lint:eslint",
    "check-types": "pnpm exec tsc --build --noEmit",
    "lint:biome": "node ../../scripts/scoped-biome.mjs",
    "lint:eslint": "eslint .",
    "format": "node ../../scripts/scoped-biome.mjs --write",
    "check-cycles": "node ../../scripts/refactor/sovereign-cycle-checker.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "clean": "rm -rf .turbo node_modules dist"
  }
}
