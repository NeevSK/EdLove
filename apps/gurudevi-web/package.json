{
  "name": "gurudevi-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/sync-h5p-assets.mjs",
    "dev": "doppler run --no-fallback -- vite --port 3000",
    "dev:explore": "doppler run --no-fallback -- vite --mode explore --port 3001",
    "dev:no-doppler": "vite --port 3000",
    "prebuild": "node scripts/sync-h5p-assets.mjs",
    "build": "doppler run --no-fallback -- vite build && doppler run --no-fallback -- vite build --mode explore",
    "build:sanctuary": "doppler run --no-fallback -- vite build",
    "build:explore": "doppler run --no-fallback -- vite build --mode explore",
    "preview": "vite preview --port 3000",
    "lint": "pnpm run lint:biome && pnpm run lint:eslint",
    "lint:biome": "node ../../scripts/scoped-biome.mjs",
    "lint:eslint": "eslint .",
    "check-types": "tsc --noEmit",
    "test:routes": "node scripts/state-graph-crawler.mjs --mode=smoke --evidence-level G4",
    "test:tree": "node scripts/state-graph-crawler.mjs --evidence-level G4",
    "test:g1:self-floor": "node ../../scripts/run-and-report.mjs --cmd \"vitest run tests/integration/selfFloor.test.tsx\" --name \"apps_gurudevi-web-test_g1_self_floor\" --evidence-level G1",
    "test:g1:self-journal": "node ../../scripts/run-and-report.mjs --cmd \"vitest run tests/integration/selfFloor.test.tsx\" --name \"apps_gurudevi-web-test_g1_self_floor\" --evidence-level G1",
    "test:g1:workspace-practice": "node ../../scripts/run-and-report.mjs --cmd \"vitest run lib/workspace/attendance.test.ts tests/integration/workspacePractice.test.tsx\" --name \"apps_gurudevi-web-test_g1_workspace_practice\" --evidence-level G1",
    "test:e2e": "node ../../scripts/run-and-report.mjs --cmd \"playwright test\" --name \"apps_gurudevi-web-test_e2e\" --evidence-level G4",
    "test:g4:owned-auth": "node ../../scripts/run-and-report.mjs --cmd \"playwright test --config playwright.auth.config.ts\" --name \"apps_gurudevi-web-test_g4_owned_auth\" --evidence-level G4",
    "test:e2e:ui": "node ../../scripts/run-and-report.mjs --cmd \"playwright test --ui\" --name \"apps_gurudevi-web-test_e2e_ui\" --evidence-level G4",
    "test:e2e:headed": "node ../../scripts/run-and-report.mjs --cmd \"playwright test --headed\" --name \"apps_gurudevi-web-test_e2e_headed\" --evidence-level G4",
    "test:e2e:mobile": "node ../../scripts/run-and-report.mjs --cmd \"playwright test --project=mobile-chrome --project=mobile-safari\" --name \"apps_gurudevi-web-test_e2e_mobile\" --evidence-level G4",
    "test:e2e:desktop": "node ../../scripts/run-and-report.mjs --cmd \"playwright test --project=desktop-chrome\" --name \"apps_gurudevi-web-test_e2e_desktop\" --evidence-level G4",
    "test:flows": "node scripts/agentic-flow-runner.mjs --all",
    "audit:pjc-coverage": "node ../../scripts/audit-pjc-bidirectional-coverage.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@intuitui-labs/a11y-gate": "link:C:/projects/packages/a11y-gate",
    "@marp-team/marp-core": "^4.4.0",
    "@milkdown/kit": "^7.23.0",
    "@orpc/client": "2.0.0-beta.53",
    "@repo/core": "workspace:*",
    "@repo/library": "workspace:*",
    "@repo/self": "workspace:*",
    "@repo/ui": "workspace:*",
    "@repo/verger-core": "workspace:*",
    "@repo/verger-react": "workspace:*",
    "@repo/verger-web": "workspace:*",
    "@repo/workforce": "workspace:*",
    "@supabase/ssr": "0.12.7",
    "@tanstack/react-pacer": "^0.24.1",
    "@tanstack/react-query": "^5.108.4",
    "@tanstack/react-router": "1.170.46",
    "docx-preview": "^0.4.1",
    "h5p-standalone": "^3.8.2",
    "lucide-react": "^1.79.0",
    "pdfjs-dist": "6.5.438",
    "pptx-preview": "^1.0.7",
    "qrcode": "^1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-directive": "4.0.0",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "remark-rehype": "^11.1.2",
    "tesseract.js": "^7.0.0",
    "unified": "11.0.5",
    "xstate": "6.0.0-beta.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@browserbasehq/stagehand": "^4.4.0",
    "@midscene/web": "^1.18.2",
    "@playwright/test": "^1.65.1",
    "@repo/eslint-config": "workspace:^",
    "@repo/typescript-config": "workspace:*",
    "@tailwindcss/postcss": "4.3.5",
    "@tanstack/router-plugin": "1.169.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.2",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "dotenv": "^18.0.10",
    "eslint": "^10.15.0",
    "postcss": "^8.5.33",
    "puppeteer-core": "^25.18.1",
    "tailwindcss": "4.3.5",
    "typescript": "7.1.0-beta",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
