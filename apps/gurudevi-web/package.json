{
  "name": "gurudevi-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "pnpm run lint:biome && pnpm run lint:eslint",
    "lint:biome": "node ../../scripts/scoped-biome.mjs",
    "lint:eslint": "eslint .",
    "check-types": "tsc --noEmit",
    "test:g1:auth-callback": "node ../../scripts/run-and-report.mjs --cmd \"vitest run app/auth/complete/route.test.ts app/auth/signout/route.test.ts app/auth/deletion/route.test.ts\" --name \"apps_gurudevi-web-test_g1_auth_callback\" --evidence-level G1",
    "test:g1:self-floor": "node ../../scripts/run-and-report.mjs --cmd \"vitest run tests/integration/selfFloor.test.tsx\" --name \"apps_gurudevi-web-test_g1_self_floor\" --evidence-level G1",
    "test:g1:self-journal": "node ../../scripts/run-and-report.mjs --cmd \"vitest run tests/integration/selfFloor.test.tsx\" --name \"apps_gurudevi-web-test_g1_self_floor\" --evidence-level G1",
    "test:g1:workspace-practice": "node ../../scripts/run-and-report.mjs --cmd \"vitest run lib/workspace/attendance.test.ts tests/integration/workspacePractice.test.tsx\" --name \"apps_gurudevi-web-test_g1_workspace_practice\" --evidence-level G1",
    "test:e2e": "node ../../scripts/run-and-report.mjs --cmd \"playwright test\" --name \"apps_gurudevi-web-test_e2e\" --evidence-level G4",
    "test:g4:owned-auth": "node ../../scripts/run-and-report.mjs --cmd \"playwright test --config playwright.auth.config.ts\" --name \"apps_gurudevi-web-test_g4_owned_auth\" --evidence-level G4",
    "test:e2e:ui": "node ../../scripts/run-and-report.mjs --cmd \"playwright test --ui\" --name \"apps_gurudevi-web-test_e2e_ui\" --evidence-level G4",
    "test:e2e:headed": "node ../../scripts/run-and-report.mjs --cmd \"playwright test --headed\" --name \"apps_gurudevi-web-test_e2e_headed\" --evidence-level G4",
    "test:e2e:mobile": "node ../../scripts/run-and-report.mjs --cmd \"playwright test --project=mobile-chrome --project=mobile-safari\" --name \"apps_gurudevi-web-test_e2e_mobile\" --evidence-level G4",
    "test:e2e:desktop": "node ../../scripts/run-and-report.mjs --cmd \"playwright test --project=desktop-chrome\" --name \"apps_gurudevi-web-test_e2e_desktop\" --evidence-level G4"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@orpc/client": "2.0.0-beta.50",
    "@repo/core": "workspace:*",
    "@repo/self": "workspace:*",
    "@repo/ui": "workspace:*",
    "@repo/verger-core": "workspace:*",
    "@repo/verger-react": "workspace:*",
    "@repo/verger-web": "workspace:*",
    "@repo/workforce": "workspace:*",
    "@supabase/ssr": "0.12.7",
    "@tanstack/react-pacer": "^0.24.1",
    "@tanstack/react-query": "^5.107.1",
    "lucide-react": "^1.69.0",
    "next": "16.4.5",
    "qrcode": "^1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "xstate": "6.0.0-alpha.70",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@repo/eslint-config": "workspace:^",
    "@repo/typescript-config": "workspace:*",
    "@tailwindcss/postcss": "4.3.4",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "19.3.0",
    "dotenv": "^18.0.9",
    "eslint": "^10.14.0",
    "postcss": "^8.5.32",
    "tailwindcss": "4.3.4",
    "typescript": "7.1.0-beta",
    "vitest": "5.1.0"
  }
}
