---
import SEO from '../components/SEO.astro';
import '../styles/global.css';

interface Props {
	title: string;
	description?: string;
}

const { title, description = "Education Ecology Support System" } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<SEO title={title} description={description} />
	</head>
	<body class="bg-cream-silence text-charcoal-truth min-h-screen flex flex-col">
		<slot />
	</body>
</html>
