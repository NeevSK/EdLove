---
export type ContentCadence = 'perennial' | 'living-document' | 'diagnostic' | 'field-report' | 'archival';
export type TranslationStatus = 'not_applicable' | 'draft' | 'machine_generated' | 'in_review' | 'approved';

export interface Props {
  author?: string;
  scribe?: string;
  scribeNote?: string;
  publishDate?: Date | string;
  updatedDate?: Date | string;
  cadence?: ContentCadence;
  version?: string;
  license?: string;
  canonicalUrl?: string;
  readingTime?: number;
  wordCount?: number;
  customNote?: string;
  translationStatus?: TranslationStatus;
  translator?: string;
  language?: string;
  class?: string;
}

const {
  author = 'EdLove Working Group',
  scribe = 'Antigravity',
  scribeNote,
  publishDate,
  updatedDate,
  cadence = 'living-document',
  version = 'v1.0',
  license = 'CC BY-SA 4.0',
  canonicalUrl,
  readingTime,
  customNote,
  translationStatus = 'not_applicable',
  translator,
  language = 'en',
  class: className = '',
} = Astro.props;

const parsedPublished = publishDate ? (publishDate instanceof Date ? publishDate : new Date(publishDate)) : null;
const parsedUpdated = updatedDate ? (updatedDate instanceof Date ? updatedDate : new Date(updatedDate)) : null;

const formattedPublished = parsedPublished
  ? new Intl.DateTimeFormat('en-US', {
      month: 'short',
      day: 'numeric',
      year: 'numeric',
    }).format(parsedPublished)
  : null;

const formattedUpdated = parsedUpdated
  ? new Intl.DateTimeFormat('en-US', {
      month: 'short',
      day: 'numeric',
      year: 'numeric',
    }).format(parsedUpdated)
  : null;

const cadenceMap: Record<
  ContentCadence,
  { label: string; badge: string; icon: string; explanation: string }
> = {
  perennial: {
    label: 'Foundational Canon',
    badge: 'bg-emerald-500/10 text-emerald-800 border-emerald-500/20',
    icon: '🏛️',
    explanation: 'Perennial Philosophy. Maintained as stable, enduring canon that rarely changes.',
  },
  'living-document': {
    label: 'Living Document',
    badge: 'bg-amber-500/10 text-amber-800 border-amber-500/20',
    icon: '🌱',
    explanation: 'Active Working Framework. Reviewed and updated periodically as educational practices evolve.',
  },
  diagnostic: {
    label: 'Empirical Diagnostic',
    badge: 'bg-sky-500/10 text-sky-800 border-sky-500/20',
    icon: '📊',
    explanation: 'Time-sensitive empirical field data reflecting surveyed ground conditions.',
  },
  'field-report': {
    label: 'Field Dispatch',
    badge: 'bg-purple-500/10 text-purple-800 border-purple-500/20',
    icon: '🧭',
    explanation: 'On-the-ground observations and intervention records from specific moments in time.',
  },
  archival: {
    label: 'Archival Record',
    badge: 'bg-slate-500/10 text-slate-700 border-slate-500/20',
    icon: '📜',
    explanation: 'Historical record preserved for institutional context.',
  },
};

const cadenceMeta = cadenceMap[cadence] || cadenceMap['living-document'];
---

<div class:list={["w-full", className]}>
  <details class="group rounded-2xl bg-white/60 backdrop-blur-md border border-black/5 shadow-xs transition-all duration-300 hover:border-[var(--color-gold)]/40 hover:shadow-sm overflow-hidden">
    <!-- Compact Summary Byline (Always Visible, Single Line) -->
    <summary class="flex flex-wrap items-center justify-between gap-3 px-4 py-3 cursor-pointer list-none select-none text-xs font-heading text-[var(--color-midnightInk)]/80">
      <div class="flex flex-wrap items-center gap-2 sm:gap-3">
        <span class="font-bold text-[var(--color-midnightInk)]">{author}</span>
        {formattedPublished && (
          <>
            <span class="opacity-40">•</span>
            <time datetime={parsedPublished?.toISOString()}>{formattedPublished}</time>
          </>
        )}
        {formattedUpdated && (
          <>
            <span class="opacity-40">•</span>
            <span class="text-[11px] text-[var(--color-midnightInk)]/70">Updated {formattedUpdated}</span>
          </>
        )}
        {readingTime && (
          <>
            <span class="opacity-40 hidden sm:inline">•</span>
            <span class="hidden sm:inline opacity-70">{readingTime} min read</span>
          </>
        )}
      </div>

      <div class="flex items-center gap-2 ml-auto">
        <!-- Translation Trust Chip (if applicable) -->
        {translationStatus === 'approved' && (
          <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-emerald-500/10 text-emerald-800 text-[10px] font-bold border border-emerald-500/20">
            <span>✦</span>
            <span>Reviewed</span>
          </span>
        )}
        {translationStatus === 'machine_generated' && (
          <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-amber-500/10 text-amber-800 text-[10px] font-bold border border-amber-500/20">
            <span>🤖</span>
            <span>Machine Translated</span>
          </span>
        )}

        <!-- Cadence Badge -->
        <span class:list={["inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[10px] font-bold border", cadenceMeta.badge]}>
          <span>{cadenceMeta.icon}</span>
          <span>{cadenceMeta.label}</span>
          <span class="opacity-50">({version})</span>
        </span>

        <!-- Expand Indicator Icon -->
        <span class="text-[var(--color-gold)] font-mono text-xs transition-transform duration-300 group-open:rotate-180">
          ▾
        </span>
      </div>
    </summary>

    <!-- Expanded Deep Rigor & Epistemic Provenance Drawer -->
    <div class="border-t border-black/5 bg-white/40 p-6 sm:p-8 text-xs leading-relaxed font-body text-[var(--color-midnightInk)] animate-fade-in-up">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Col 1: Stewardship & Authorship -->
        <div class="space-y-1.5 border-b md:border-b-0 md:border-r border-black/5 pb-4 md:pb-0 md:pr-6">
          <span class="block font-heading uppercase text-[10px] tracking-widest font-bold text-[var(--color-midnightInk)]/50">
            Stewardship & Authorship
          </span>
          <p class="font-bold text-sm text-[var(--color-midnightInk)]">{author}</p>
          <p class="text-[11px] text-[var(--color-midnightInk)]/70">
            <strong>Intent & Architecture:</strong> Authored by {author}.
          </p>
          {scribe && (
            <div class="mt-2 pt-2 border-t border-black/5">
              <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-slate-900/5 text-[var(--color-midnightInk)] text-[10px] font-mono border border-black/10">
                <span>✍️ Scribe:</span>
                <span class="font-bold">{scribe}</span>
              </span>
              <p class="text-[10px] text-[var(--color-midnightInk)]/60 italic mt-1">
                {scribeNote ?? `Synthesized and transcribed under authorial stewardship by ${scribe}.`}
              </p>
            </div>
          )}
          {translator && (
            <p class="text-[11px] text-[var(--color-midnightInk)]/70 mt-2">
              <strong>Translator:</strong> {translator} ({translationStatus})
            </p>
          )}
        </div>

        <!-- Col 2: Epistemic Rigor & Dates -->
        <div class="space-y-1.5 border-b md:border-b-0 md:border-r border-black/5 pb-4 md:pb-0 md:pr-6">
          <span class="block font-heading uppercase text-[10px] tracking-widest font-bold text-[var(--color-midnightInk)]/50">
            Verification & Cadence
          </span>
          <div class="space-y-1 text-[11px]">
            {formattedPublished && (
              <div class="flex justify-between">
                <span class="text-[var(--color-midnightInk)]/60">First Inscribed:</span>
                <span class="font-medium">{formattedPublished}</span>
              </div>
            )}
            <div class="flex justify-between">
              <span class="text-[var(--color-midnightInk)]/60">Last Verified / Revised:</span>
              <span class="font-medium">{formattedUpdated ?? formattedPublished ?? 'Continuous'}</span>
            </div>
            {readingTime && (
              <div class="flex justify-between">
                <span class="text-[var(--color-midnightInk)]/60">Reading Pace:</span>
                <span class="font-medium">{readingTime} min contemplative reading</span>
              </div>
            )}
          </div>
          <p class="text-[10px] text-[var(--color-midnightInk)]/60 italic mt-2 border-t border-black/5 pt-1.5">
            {customNote ?? cadenceMeta.explanation}
          </p>
        </div>

        <!-- Col 3: Rights & Canonical Ledger -->
        <div class="space-y-1.5">
          <span class="block font-heading uppercase text-[10px] tracking-widest font-bold text-[var(--color-midnightInk)]/50">
            Open Knowledge Rights
          </span>
          <p class="font-bold text-[var(--color-midnightInk)]">{license}</p>
          <p class="text-[11px] text-[var(--color-midnightInk)]/70">
            Free for educational attribution and non-commercial reproduction.
          </p>
          {canonicalUrl && (
            <div class="pt-2">
              <a
                href={canonicalUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1 text-[11px] text-[var(--color-midnightInk)] font-semibold hover:text-[var(--color-gold)] underline underline-offset-2"
              >
                <span>Canonical Ledger & Source</span>
                <span class="text-[10px]">↗</span>
              </a>
            </div>
          )}
        </div>
      </div>
    </div>
  </details>
</div>
