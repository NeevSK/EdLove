---
const currentYear = new Date().getFullYear();
---

<footer class="py-16 mt-20 bg-[var(--color-primaryInk)] text-[var(--color-warmPaper)] border-t border-white/10">
    <div class="sanctuary-container">
        <div class="grid grid-cols-1 md:grid-cols-12 gap-12 lg:gap-16">
            <!-- Brand Part -->
            <div class="md:col-span-4 space-y-6">
                <div class="flex items-center gap-3">
                    <span class="text-3xl">&#128330;&#65039;</span>
                    <span class="font-heading text-2xl font-bold tracking-tight text-[var(--color-warmPaper)]">EdLove</span>
                </div>
                <p class="font-serif text-lg text-[var(--color-warmPaper)] leading-relaxed italic">
                    "Giving love to the next generation, for flourishing in their environment and developing themselves."
                </p>
                <div class="pt-1 text-sm font-medium text-[var(--color-warmPaper)]/80">
                    Not-for-profit &middot; Non-governmental
                </div>
            </div>

            <!-- Constellation Links Grid -->
            <div class="md:col-span-8 grid grid-cols-2 md:grid-cols-4 gap-8">
                <!-- Foundation -->
                <div>
                    <span class="font-heading text-sm font-bold text-[#E5B54F] mb-6 block">Foundation</span>
                    <ul class="space-y-3">
                        <li><a href="/foundation" class="font-serif text-[15px] text-[var(--color-warmPaper)]/90 hover:text-white transition-colors">Epistemic Core</a></li>
                        <li><a href="/about" class="font-serif text-[15px] text-[var(--color-warmPaper)]/90 hover:text-white transition-colors">About Us</a></li>
                        <li><a href="/team" class="font-serif text-[15px] text-[var(--color-warmPaper)]/90 hover:text-white transition-colors">Our Team</a></li>
                        <li><a href="/contact" class="font-serif text-[15px] text-[var(--color-warmPaper)]/90 hover:text-white transition-colors">Contact</a></li>
                    </ul>
                </div>

                <!-- EdResearch -->
                <div>
                    <span class="font-heading text-sm font-bold text-[#E5B54F] mb-6 block">EdResearch</span>
                    <ul class="space-y-3">
                        <li><a href="/research" class="font-serif text-[15px] text-[var(--color-warmPaper)]/90 hover:text-white transition-colors">Two Orders</a></li>
                        <li><a href="/research/cosmos" class="font-serif text-[15px] text-[var(--color-warmPaper)]/90 hover:text-white transition-colors">Cosmos</a></li>
                        <li><a href="/research/sri-lanka" class="font-serif text-[15px] text-[var(--color-warmPaper)]/90 hover:text-white transition-colors">Sri Lanka</a></li>
                        <li><a href="/research/library" class="font-serif text-[15px] text-[var(--color-warmPaper)]/90 hover:text-white transition-colors">Library</a></li>
                        <li><a href="/resources" class="font-serif text-[15px] text-[var(--color-warmPaper)]/90 hover:text-white transition-colors">Resources</a></li>
                    </ul>
                </div>

                <!-- EdCare -->
                <div>
                    <span class="font-heading text-sm font-bold text-[#E5B54F] mb-6 block">EdCare</span>
                    <ul class="space-y-3">
                        <li><a href="/care" class="font-serif text-[15px] text-[var(--color-warmPaper)]/90 hover:text-white transition-colors">Outward Giving</a></li>
                        <li><a href="/care#edkind" class="font-serif text-[15px] text-[var(--color-warmPaper)]/90 hover:text-white transition-colors">EdKind</a></li>
                        <li><a href="/care#edlife" class="font-serif text-[15px] text-[var(--color-warmPaper)]/90 hover:text-white transition-colors">EdLife</a></li>
                        <li><a href="/care/sangha" class="font-serif text-[15px] text-[var(--color-warmPaper)]/90 hover:text-white transition-colors">The Sangha</a></li>
                    </ul>
                </div>

                <!-- EdTech & Presence -->
                <div>
                    <span class="font-heading text-sm font-bold text-[#E5B54F] mb-6 block">EdTech & Writing</span>
                    <ul class="space-y-3">
                        <li><a href="/tech" class="font-serif text-[15px] text-[var(--color-warmPaper)]/90 hover:text-white transition-colors">Convivial Tools</a></li>
                        <li><a href="/tech/innovations" class="font-serif text-[15px] text-[var(--color-warmPaper)]/90 hover:text-white transition-colors">200 Innovations</a></li>
                        <li><a href="/tech/gurudevi" class="font-serif text-[15px] text-[var(--color-warmPaper)]/90 hover:text-white transition-colors">Gurudevi Sanctuary</a></li>
                        <li><a href="/journal" class="font-serif text-[15px] text-[var(--color-warmPaper)]/90 hover:text-white transition-colors">Journal</a></li>
                        <li><a href="/feed.xml" class="font-serif text-[15px] text-[var(--color-warmPaper)]/90 hover:text-white transition-colors">RSS</a></li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="mt-14 pt-8 border-t border-white/10 flex flex-col md:flex-row justify-between items-center gap-6 text-center md:text-left">
            <p class="font-heading text-sm font-medium text-[var(--color-warmPaper)]/90">
                &copy; {currentYear} EdLove Foundation
            </p>
            <div class="flex flex-wrap gap-6 pb-1">
                 <a href="/about" class="font-heading text-sm font-medium text-[var(--color-warmPaper)]/90 hover:text-white transition-colors">About</a>
                 <a href="/team" class="font-heading text-sm font-medium text-[var(--color-warmPaper)]/90 hover:text-white transition-colors">Team</a>
                 <a href="/contact" class="font-heading text-sm font-medium text-[var(--color-warmPaper)]/90 hover:text-white transition-colors">Contact</a>
                 <a href="/privacy" class="font-heading text-sm font-medium text-[var(--color-warmPaper)]/90 hover:text-white transition-colors">Privacy</a>
                 <a href="/terms" class="font-heading text-sm font-medium text-[var(--color-warmPaper)]/90 hover:text-white transition-colors">Terms</a>
            </div>
        </div>
    </div>
</footer>
