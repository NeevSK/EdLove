---
const _currentYear = new Date().getFullYear();
---

<footer class="py-8 mt-12 bg-[var(--color-midnightInk)] text-[var(--color-warmPaper)]/90 border-t border-white/5">
    <div class="sanctuary-container">
        <div class="grid grid-cols-1 md:grid-cols-12 gap-20">
            <!-- Brand Part: Icon Only -->
            <div class="md:col-span-4 space-y-10">
                <span class="text-4xl">🕊️</span>
                <p class="font-serif text-2xl text-[var(--color-warmPaper)]/60 leading-relaxed italic">
                    "Nurturing the soul of learning."
                </p>
            </div>

            <!-- Links Grid -->
            <div class="md:col-span-8 grid grid-cols-2 md:grid-cols-3 gap-8">
                <div>
                    <span class="font-sans text-sm uppercase tracking-[0.2em] font-bold text-[var(--color-gold)] mb-8 block">Exploration</span>
                    <ul class="space-y-4">
                        <li><a href="/cosmos" class="font-serif text-lg text-[var(--color-warmPaper)]/70 hover:text-[var(--color-gold)] transition-colors">Cosmos</a></li>
                        <li><a href="/vision" class="font-serif text-lg text-[var(--color-warmPaper)]/70 hover:text-[var(--color-gold)] transition-colors">Vision</a></li>
                        <li><a href="/library" class="font-serif text-lg text-[var(--color-warmPaper)]/70 hover:text-[var(--color-gold)] transition-colors">Library</a></li>
                    </ul>
                </div>

                <div>
                     <span class="font-sans text-sm uppercase tracking-[0.2em] font-bold text-[var(--color-gold)] mb-8 block">Sanctuary</span>
                     <ul class="space-y-4">
                         <li><a href="/community" class="font-serif text-lg text-[var(--color-warmPaper)]/70 hover:text-[var(--color-gold)] transition-colors">Sangha</a></li>
                         <li><a href="/resources" class="font-serif text-lg text-[var(--color-warmPaper)]/70 hover:text-[var(--color-gold)] transition-colors">Resources</a></li>
                         <li><a href="https://gurudevi.edlove.org" target="_blank" rel="noopener noreferrer" class="font-serif text-lg text-[var(--color-warmPaper)]/70 hover:text-[var(--color-gold)] transition-colors">Gurudevi</a></li>
                     </ul>
                </div>

                <div class="col-span-2 md:col-span-1">
                     <span class="font-sans text-sm uppercase tracking-[0.2em] font-bold text-[var(--color-gold)] mb-8 block">Presence</span>
                     <div class="flex gap-6">
                        <a href="#" class="text-[var(--color-warmPaper)]/40 hover:text-[var(--color-gold)] transition-colors">Instagram</a>
                        <a href="#" class="text-[var(--color-warmPaper)]/40 hover:text-[var(--color-gold)] transition-colors">Substack</a>
                     </div>
                </div>
            </div>
        </div>

        <div class="mt-12 pt-8 border-t border-white/5 flex flex-col md:flex-row justify-between items-end gap-8">
            <div class="flex flex-col gap-3 scale-90 md:scale-100 origin-left">
                <a href="https://intuituilabs.edlove.org" target="_blank" rel="noopener noreferrer" class="font-sans text-xs uppercase tracking-[0.3em] font-bold text-[var(--color-gold)] drop-shadow-[0_0_8px_rgba(231,203,22,0.4)] hover:opacity-80 transition-opacity">
                    built with 💖 Intuitui Labs
                </a>
                <p class="font-sans text-xs uppercase tracking-[0.2em] font-medium text-[var(--color-warmPaper)]/40">
                    © {currentYear} EdLove Platform • Colombo, Sri Lanka
                </p>
            </div>
            <div class="flex gap-8 pb-1">
                 <a href="/privacy" class="font-sans text-xs uppercase tracking-[0.2em] font-medium text-[var(--color-warmPaper)]/40 hover:text-[var(--color-warmPaper)]">Privacy</a>
                 <a href="/terms" class="font-sans text-xs uppercase tracking-[0.2em] font-medium text-[var(--color-warmPaper)]/40 hover:text-[var(--color-warmPaper)]">Terms</a>
            </div>
        </div>
    </div>

</footer>
