---
const currentYear = new Date().getFullYear();
---

<footer class="relative z-10 py-48 mt-48 bg-[var(--color-warmGrey)] border-t border-[var(--color-midnightInk)]/5">
    <div class="sanctuary-container">
        <div class="grid grid-cols-1 md:grid-cols-12 gap-20">
            <!-- Brand Part: Icon Only -->
            <div class="md:col-span-4 space-y-10">
                <span class="text-4xl">🕊️</span>
                <p class="font-serif text-2xl text-[var(--color-midnightInk)]/60 leading-relaxed italic">
                    "For the hands that hold the future."
                </p>
            </div>

            <!-- Links Grid -->
            <div class="md:col-span-8 grid grid-cols-2 md:grid-cols-3 gap-12">
                <div>
                    <span class="font-sans text-sm uppercase tracking-[0.2em] font-bold text-[var(--color-agedGold)] mb-8 block">Exploration</span>
                    <ul class="space-y-4">
                        <li><a href="/cosmos" class="font-serif text-lg text-[var(--color-midnightInk)]/80 hover:text-[var(--color-agedGold)] transition-colors">Cosmos</a></li>
                        <li><a href="/about" class="font-serif text-lg text-[var(--color-midnightInk)]/80 hover:text-[var(--color-agedGold)] transition-colors">Vision</a></li>
                        <li><a href="/library" class="font-serif text-lg text-[var(--color-midnightInk)]/80 hover:text-[var(--color-agedGold)] transition-colors">Library</a></li>
                    </ul>
                </div>

                <div>
                     <span class="font-sans text-sm uppercase tracking-[0.2em] font-bold text-[var(--color-agedGold)] mb-8 block">Sanctuary</span>
                     <ul class="space-y-4">
                         <li><a href="/community" class="font-serif text-lg text-[var(--color-midnightInk)]/80 hover:text-[var(--color-agedGold)] transition-colors">Sangha</a></li>
                         <li><a href="/resources" class="font-serif text-lg text-[var(--color-midnightInk)]/80 hover:text-[var(--color-agedGold)] transition-colors">Resources</a></li>
                         <li><a href="/gurudevi" class="font-serif text-lg text-[var(--color-midnightInk)]/80 hover:text-[var(--color-agedGold)] transition-colors">Gurudevi</a></li>
                     </ul>
                </div>

                <div class="col-span-2 md:col-span-1">
                     <span class="font-sans text-sm uppercase tracking-[0.2em] font-bold text-[var(--color-agedGold)] mb-8 block">Presence</span>
                     <div class="flex gap-6">
                        <a href="#" class="text-[var(--color-midnightInk)]/40 hover:text-[var(--color-agedGold)] transition-colors">Instagram</a>
                        <a href="#" class="text-[var(--color-midnightInk)]/40 hover:text-[var(--color-agedGold)] transition-colors">Substack</a>
                     </div>
                </div>
            </div>
        </div>

        <div class="mt-32 pt-12 border-t border-[var(--color-midnightInk)]/5 flex flex-col md:flex-row justify-between items-center gap-8">
            <p class="font-sans text-sm uppercase tracking-[0.2em] font-medium text-[var(--color-midnightInk)]/50">
                © {currentYear} EdLove Platform • Colombo, Sri Lanka
            </p>
            <div class="flex gap-8">
                 <a href="/privacy" class="font-sans text-sm uppercase tracking-[0.2em] font-medium text-[var(--color-midnightInk)]/50 hover:text-[var(--color-midnightInk)]">Privacy</a>
                 <a href="/terms" class="font-sans text-sm uppercase tracking-[0.2em] font-medium text-[var(--color-midnightInk)]/50 hover:text-[var(--color-midnightInk)]">Terms</a>
            </div>
        </div>
    </div>
</footer>
