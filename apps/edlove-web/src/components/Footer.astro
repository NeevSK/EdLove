---
const currentYear = new Date().getFullYear();
---

<footer class="relative z-10 bg-[#FAF7F2] border-t border-[#2D3561]/10 py-16 px-6">
    <div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-4 gap-12">
        <!-- Brand -->
        <div class="space-y-4">
            <div class="flex items-center gap-2">
                <span class="text-3xl">🕊️</span>
                <span class="font-serif text-2xl font-bold text-[#2D3561]">EdLove</span>
            </div>
            <p class="font-sans text-sm text-[#2D3561]/60 leading-relaxed">
                Transforming the educational landscape of Sri Lanka through philosophy, technology, and community.
            </p>
        </div>

        <!-- Links -->
        <div>
            <h4 class="font-serif text-[#2D3561] font-bold mb-6">Explorations</h4>
            <ul class="space-y-3">
                <li><a href="/cosmos" class="text-sm text-[#2D3561]/60 hover:text-[#D4A574] transition-colors">The Paradigm Cosmos</a></li>
                <li><a href="/gurudevi" class="text-sm text-[#2D3561]/60 hover:text-[#D4A574] transition-colors">Gurudevi</a></li>
                <li><a href="/library" class="text-sm text-[#2D3561]/60 hover:text-[#D4A574] transition-colors">The Library</a></li>
            </ul>
        </div>

        <div>
            <h4 class="font-serif text-[#2D3561] font-bold mb-6">Sangha</h4>
            <ul class="space-y-3">
                <li><a href="/community" class="text-sm text-[#2D3561]/60 hover:text-[#D4A574] transition-colors">Join Community</a></li>
                <li><a href="/resources" class="text-sm text-[#2D3561]/60 hover:text-[#D4A574] transition-colors">Our Ecosystem</a></li>
                <li><a href="/about" class="text-sm text-[#2D3561]/60 hover:text-[#D4A574] transition-colors">Our Vision</a></li>
            </ul>
        </div>

        <div>
            <h4 class="font-serif text-[#2D3561] font-bold mb-6">Connect</h4>
            <p class="text-sm text-[#2D3561]/60 mb-4">Stay updated on our progress.</p>
            <div class="flex gap-4">
                <a href="#" class="w-10 h-10 rounded-full bg-[#2D3561]/5 border border-[#2D3561]/10 flex items-center justify-center hover:bg-[#D4A574]/20 transition-all">
                    <span class="text-sm">𝕏</span>
                </a>
                <a href="#" class="w-10 h-10 rounded-full bg-[#2D3561]/5 border border-[#2D3561]/10 flex items-center justify-center hover:bg-[#D4A574]/20 transition-all">
                    <span class="text-sm">📸</span>
                </a>
            </div>
        </div>
    </div>

    <div class="max-w-7xl mx-auto mt-16 pt-8 border-t border-[#2D3561]/5 text-center">
        <p class="text-xs text-[#2D3561]/40 uppercase tracking-widest">
            © {new Date().getFullYear()} EdLove Platform. For the dignity of the Sri Lankan teacher.
        </p>
    </div>
</footer>
