---
---
<aside 
  id="global-side-panel" 
  class="fixed inset-y-0 left-0 w-full md:w-[600px] bg-[#FAF7F2]/95 backdrop-blur-xl border-r border-[#2D3561]/10 shadow-2xl z-[100] transform -translate-x-full transition-transform duration-500 ease-out"
>
  <!-- Header -->
  <div class="flex items-center justify-between px-8 py-6 border-b border-[#2D3561]/10 bg-white/20 sticky top-0 z-10">
    <div class="flex items-center gap-3">
        <span id="panel-icon" class="text-2xl"></span>
        <h2 id="panel-title" class="font-serif text-2xl text-[#2D3561]"></h2>
    </div>
    <button 
      id="close-panel-btn"
      class="p-2 rounded-full hover:bg-[#2D3561]/5 text-[#2D3561]/60 hover:text-[#D4A574] transition-colors"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- Content Scroll Area -->
  <div class="h-full overflow-y-auto p-8 pb-32">
     <div id="panel-subtitle" class="font-sans text-xs text-[#D4A574] uppercase tracking-widest font-bold mb-6"></div>
     <div id="panel-content" class="prose prose-slate prose-lg max-w-none font-sans text-[#2D3561]/90 leading-relaxed">
        <!-- Dynamic Content Injected Here -->
     </div>
  </div>
</aside>

<!-- Backdrop -->
<div 
  id="panel-backdrop" 
  class="fixed inset-0 bg-[#0f111a]/60 backdrop-blur-sm z-[90] opacity-0 pointer-events-none transition-opacity duration-500"
></div>

<script>
  // Global Event Listener for opening the panel
  // Dispatch 'open-side-panel' with detail: { title, subtitle, icon, content }
  
  const panel = document.getElementById('global-side-panel');
  const backdrop = document.getElementById('panel-backdrop');
  const closeBtn = document.getElementById('close-panel-btn');
  
  const els = {
    title: document.getElementById('panel-title'),
    subtitle: document.getElementById('panel-subtitle'),
    icon: document.getElementById('panel-icon'),
    content: document.getElementById('panel-content')
  };

  function openPanel(data: any) {
    if(!panel || !backdrop) return;
    
    // Populate
    if(els.title) els.title.textContent = data.title || '';
    if(els.subtitle) els.subtitle.textContent = data.subtitle || '';
    if(els.icon) els.icon.textContent = data.icon || '';
    if(els.content) els.content.innerHTML = data.content || '';

    // Animate In (Remove negative translation)
    panel.classList.remove('-translate-x-full');
    backdrop.classList.remove('opacity-0', 'pointer-events-none');
    document.body.style.overflow = 'hidden'; // Lock body scroll
  }

  function closePanel() {
    if(!panel || !backdrop) return;
    
    // Animate Out (Add negative translation)
    panel.classList.add('-translate-x-full');
    backdrop.classList.add('opacity-0', 'pointer-events-none');
    document.body.style.overflow = ''; // Unlock body scroll
  }

  // Listeners
  window.addEventListener('open-side-panel', (e: any) => openPanel(e.detail));
  closeBtn?.addEventListener('click', closePanel);
  backdrop?.addEventListener('click', closePanel);
  
  // Close on Escape
  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closePanel();
  });
</script>
