---
interface Props {
  showVideo?: boolean;
}

// Keep prop signature for backwards compatibility across inner pages,
// without eagerly downloading a 2.8MB video behind an opaque wash.
const { showVideo: _showVideo = false } = Astro.props;
---

<div
  class="cinematic-bg fixed inset-0 w-full h-full -z-10 bg-[#FCFBF9] overflow-hidden pointer-events-none select-none"
  aria-hidden="true"
>
  <div
    class="absolute inset-0"
    style="background: radial-gradient(ellipse 80% 50% at 50% 0%, rgba(229, 181, 79, 0.08) 0%, rgba(252, 251, 249, 0) 70%), radial-gradient(ellipse 60% 40% at 85% 90%, rgba(74, 99, 87, 0.06) 0%, rgba(252, 251, 249, 0) 70%);"
  ></div>
</div>
