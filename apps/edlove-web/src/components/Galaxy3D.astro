<div id="galaxy-container" class="absolute inset-0 w-full h-full -z-10 bg-deepIndigo"></div>

<script>
  import * as THREE from 'three';

  // Configuration
  const STAR_COUNT = 15000;
  const GALAXY_RADIUS = 300;
  const ARMS = 5;
  const SPIN = 10;
  const RANDOMNESS = 0.5;
  const RANDOMNESS_POWER = 3;
  const SIZE = 0.6; // Base Star Size

  let scene: THREE.Scene;
  let camera: THREE.PerspectiveCamera;
  let renderer: THREE.WebGLRenderer;
  let points: THREE.Points;
  let geometry: THREE.BufferGeometry;
  let material: THREE.PointsMaterial;
  
  // Interactive State
  let mouseX = 0;
  let mouseY = 0;
  let targetRotationX = 0;
  let targetRotationY = 0;

  function init() {
    const container = document.getElementById('galaxy-container');
    if (!container) return;

    // 1. Scene Setup
    scene = new THREE.Scene();
    // Fog for depth (Deep Indigo fading to black)
    scene.fog = new THREE.FogExp2(0x2D3561, 0.001);

    // 2. Camera
    camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.1, 2000);
    camera.position.z = 40;
    camera.position.y = 30;
    camera.lookAt(new THREE.Vector3(0, 0, 0));

    // 3. Renderer
    renderer = new THREE.WebGLRenderer({ alpha: true, antialias: true });
    renderer.setSize(window.innerWidth, window.innerHeight);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    container.appendChild(renderer.domElement);

    // 4. Galaxy Generation (Spiral Logic)
    generateGalaxy();

    // 5. Cosmic Ocean (Water Effect)
    generateOcean();

    // 6. Listeners
    window.addEventListener('resize', onWindowResize);
    document.addEventListener('mousemove', onMouseMove);
    
    // 7. Start Loop
    animate();
  }

  // Helper: Create a soft glow texture programmatically (No images needed)
  function createStarTexture() {
    const canvas = document.createElement('canvas');
    canvas.width = 32;
    canvas.height = 32;
    const context = canvas.getContext('2d');
    if (!context) return null;

    // Radial Gradient (White center -> Transparent edge)
    const gradient = context.createRadialGradient(16, 16, 0, 16, 16, 16);
    gradient.addColorStop(0, 'rgba(255, 255, 255, 1)');
    gradient.addColorStop(0.2, 'rgba(255, 255, 255, 0.8)');
    gradient.addColorStop(0.5, 'rgba(255, 255, 255, 0.2)');
    gradient.addColorStop(1, 'rgba(0, 0, 0, 0)');

    context.fillStyle = gradient;
    context.fillRect(0, 0, 32, 32);

    const texture = new THREE.CanvasTexture(canvas);
    return texture;
  }

  function generateGalaxy() {
    if (points) {
      geometry.dispose();
      material.dispose();
      scene.remove(points);
    }

    geometry = new THREE.BufferGeometry();
    const positions = new Float32Array(STAR_COUNT * 3);
    const colors = new Float32Array(STAR_COUNT * 3);
    const scales = new Float32Array(STAR_COUNT * 1);

    const colorInside = new THREE.Color('#D4A574'); // Warm Gold
    const colorOutside = new THREE.Color('#9B7EBD'); // Cosmic Purple

    for (let i = 0; i < STAR_COUNT; i++) {
        const i3 = i * 3;
        const radius = Math.random() * GALAXY_RADIUS;
        const spinAngle = radius * SPIN;
        const branchAngle = (i % ARMS) / ARMS * Math.PI * 2;
        
        const randomX = Math.pow(Math.random(), RANDOMNESS_POWER) * (Math.random() < 0.5 ? 1 : -1) * RANDOMNESS * radius;
        const randomY = Math.pow(Math.random(), RANDOMNESS_POWER) * (Math.random() < 0.5 ? 1 : -1) * RANDOMNESS * radius;
        const randomZ = Math.pow(Math.random(), RANDOMNESS_POWER) * (Math.random() < 0.5 ? 1 : -1) * RANDOMNESS * radius;

        positions[i3] = Math.cos(branchAngle + spinAngle) * radius + randomX;
        positions[i3 + 1] = randomY;
        positions[i3 + 2] = Math.sin(branchAngle + spinAngle) * radius + randomZ;

        const mixedColor = colorInside.clone();
        mixedColor.lerp(colorOutside, radius / GALAXY_RADIUS);

        colors[i3] = mixedColor.r;
        colors[i3 + 1] = mixedColor.g;
        colors[i3 + 2] = mixedColor.b;
        
        scales[i] = Math.random();
    }

    geometry.setAttribute('position', new THREE.BufferAttribute(positions, 3));
    geometry.setAttribute('color', new THREE.BufferAttribute(colors, 3));
    
    // USE TEXTURE HERE
    material = new THREE.PointsMaterial({
        size: SIZE,
        sizeAttenuation: true,
        depthWrite: false,
        blending: THREE.AdditiveBlending,
        vertexColors: true,
        transparent: true,
        opacity: 0.9,
        map: createStarTexture(), // Soft Circle!
        alphaMap: createStarTexture()
    });

    points = new THREE.Points(geometry, material);
    scene.add(points);
  }

  // --- OCEAN SYSTEM ---
  let oceanPoints: THREE.Points;
  let oceanGeo: THREE.BufferGeometry;
  
  function generateOcean() {
    oceanGeo = new THREE.BufferGeometry();
    const count = 2000;
    const positions = new Float32Array(count * 3);
    // Base Plane properties
    const width = 1000;
    const depth = 1000;

    for(let i=0; i<count; i++) {
        const i3 = i*3;
        positions[i3] = (Math.random() - 0.5) * width; // x
        positions[i3+1] = -20; // y (Raised from -50 to -20 to be visible)
        positions[i3+2] = (Math.random() - 0.5) * depth; // z
    }
    
    oceanGeo.setAttribute('position', new THREE.BufferAttribute(positions, 3));
    
    const oceanMat = new THREE.PointsMaterial({
        size: 6, // Tripled size (was 2)
        color: 0x4A6357, // Deep Ocean Green
        transparent: true,
        opacity: 0.8, // Doubled opacity (was 0.4)
        map: createStarTexture(),
        blending: THREE.AdditiveBlending,
        depthWrite: false
    });

    oceanPoints = new THREE.Points(oceanGeo, oceanMat);
    scene.add(oceanPoints);
  }

  function onMouseMove(event: MouseEvent) {
    // Normalize -1 to 1
    mouseX = (event.clientX / window.innerWidth) * 2 - 1;
    mouseY = -(event.clientY / window.innerHeight) * 2 + 1;
  }

  function onWindowResize() {
    camera.aspect = window.innerWidth / window.innerHeight;
    camera.updateProjectionMatrix();
    renderer.setSize(window.innerWidth, window.innerHeight);
  }

  function animate() {
    requestAnimationFrame(animate);

    // 1. Galaxy Rotation
    if (points) {
        points.rotation.y += 0.0005; 
        targetRotationX = mouseY * 0.2;
        targetRotationY = mouseX * 0.2;
        points.rotation.x += 0.05 * (targetRotationX - points.rotation.x);
        points.rotation.z += 0.05 * (targetRotationY - points.rotation.z);
    }

    // 2. Ocean Wave Motion
    if (oceanPoints) {
        const time = Date.now() * 0.001;
        const positions = (oceanGeo.attributes.position as THREE.BufferAttribute).array as Float32Array;
        
        for(let i=0; i < 2000; i++) {
            const i3 = i*3;
            const x = positions[i3];
            // Sine wave logic based on X position and Time
            positions[i3+1] = -50 + Math.sin(x * 0.05 + time) * 5 + Math.cos(positions[i3+2] * 0.05 + time) * 5;
        }
        oceanGeo.attributes.position.needsUpdate = true;
    }

    renderer.render(scene, camera);
  }

  // Initialize
  init();
</script>
