---
---
<div class="fixed inset-0 pointer-events-none z-0 overflow-hidden" id="cosmic-particles">
    <div class="particles-container absolute inset-0"></div>
</div>

<style>
    .particles-container {
        background: radial-gradient(circle at center, rgba(30, 58, 95, 0.2) 0%, transparent 70%);
    }
</style>

<script>
    function initParticles() {
        const container = document.querySelector('.particles-container');
        if (!container) return;

        const particleCount = 40;
        for (let i = 0; i < particleCount; i++) {
            const particle = document.createElement('div');
            particle.className = 'absolute bg-white rounded-full opacity-0';
            
            const size = Math.random() * 3 + 1;
            const x = Math.random() * 100;
            const y = Math.random() * 100;
            const duration = Math.random() * 20 + 10;
            const delay = Math.random() * 10;

            particle.style.width = `${size}px`;
            particle.style.height = `${size}px`;
            particle.style.left = `${x}%`;
            particle.style.top = `${y}%`;
            
            // Random horizontal drift direction
            const xOffset = Math.random() * 100 - 50;
            particle.style.setProperty('--x-offset', `${xOffset}px`);
            
            particle.style.animation = `drift ${duration}s linear ${delay}s infinite`;
            
            container.appendChild(particle);
        }
    }

    // Run on page load and view transitions
    initParticles();
    document.addEventListener('astro:page-load', initParticles);
</script>

<style is:global>
    @keyframes drift {
        0% {
            transform: translate(0, 0);
            opacity: 0;
        }
        20% {
            opacity: 0.4;
        }
        80% {
            opacity: 0.2;
        }
        100% {
            transform: translate(var(--x-offset, 20px), -200px);
            opacity: 0;
        }
    }
</style>
