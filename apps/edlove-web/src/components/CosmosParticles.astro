<canvas id="cosmos-canvas" class="absolute top-0 left-0 w-full h-full -z-10"></canvas>

<script>
  const canvas = document.getElementById('cosmos-canvas') as HTMLCanvasElement;
  const ctx = canvas.getContext('2d');

  // Pixar's "Soul" (The Great Before) Palette - Vivid, Ethereal, Soft
  const colors = [
    { r: 100, g: 220, b: 255, a: 0.30 }, // Soul Blue (Vivid Cyan)
    { r: 255, g: 180, b: 220, a: 0.25 }, // Soft Pink (Spark)
    { r: 180, g: 255, b: 200, a: 0.20 }, // Mint Green (Life)
    { r: 160, g: 140, b: 255, a: 0.25 }, // Ethereal Purple
  ];

  let particles: Particle[] = []; // The "Background Field"
  let souls: SoulOrb[] = [];      // The "Foreground Souls"
  let w: number, h: number;

  class Particle {
    x: number;
    y: number;
    baseX: number;
    baseY: number;
    angle: number;
    size: number;
    color: { r: number, g: number, b: number, a: number };

    constructor() {
      this.x = Math.random() * w;
      this.y = Math.random() * h;
      this.baseX = this.x;
      this.baseY = this.y;
      this.angle = Math.random() * Math.PI * 2;
      this.size = Math.random() * 80 + 80; // Large soft blobs
      this.color = colors[Math.floor(Math.random() * colors.length)];
    }

    update() {
      this.angle += 0.005;
      this.x = this.baseX + Math.sin(this.angle) * 30; 
      this.y = this.baseY + Math.cos(this.angle) * 30;
    }

    draw() {
      if (!ctx) return;
      ctx.beginPath();
      const gradient = ctx.createRadialGradient(this.x, this.y, 0, this.x, this.y, this.size);
      gradient.addColorStop(0, `rgba(${this.color.r}, ${this.color.g}, ${this.color.b}, ${this.color.a})`);
      gradient.addColorStop(1, `rgba(${this.color.r}, ${this.color.g}, ${this.color.b}, 0)`);
      ctx.fillStyle = gradient;
      ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);
      ctx.fill();
    }
  }

  // "Soul Orbs": Soft, fuzzy, glowing foreground elements
  class SoulOrb {
    x: number;
    y: number;
    vx: number;
    vy: number;
    size: number;
    color: string;
    glow: number;

    constructor() {
      this.x = Math.random() * w;
      this.y = Math.random() * h;
      this.vx = (Math.random() - 0.5) * 0.8;
      this.vy = (Math.random() - 0.5) * 0.8;
      this.size = Math.random() * 10 + 5;
      const c = colors[Math.floor(Math.random() * colors.length)];
      // Brighter for foreground
      this.color = `rgba(${c.r}, ${c.g}, ${c.b}, 0.8)`;
      this.glow = 20; // Soft bloom radius
    }

    update() {
      this.x += this.vx;
      this.y += this.vy;
      
      // Gentle bounce off edges
      if (this.x < 0 || this.x > w) this.vx *= -1;
      if (this.y < 0 || this.y > h) this.vy *= -1;
    }

    draw() {
      if (!ctx) return;
      ctx.beginPath();
      ctx.shadowBlur = this.glow; // The "Soul" Glow
      ctx.shadowColor = this.color;
      ctx.fillStyle = this.color;
      ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);
      ctx.fill();
      ctx.shadowBlur = 0; // Reset
    }
  }

  function init() {
    resize();
    for (let i = 0; i < 30; i++) particles.push(new Particle());
    for (let i = 0; i < 50; i++) souls.push(new SoulOrb());
    animate();
  }

  function resize() {
    w = canvas.width = window.innerWidth;
    h = canvas.height = window.innerHeight;
  }

  function animate() {
    if (!ctx) return;
    ctx.clearRect(0, 0, w, h);
    
    // Water Layer (Screen Blend for light)
    ctx.globalCompositeOperation = 'screen'; 
    particles.forEach(p => {
      p.update();
      p.draw();
    });

    // Draw Background (Screen Blend)
    ctx.globalCompositeOperation = 'screen'; 
    particles.forEach(p => {
      p.update();
      p.draw();
    });

    // Draw Souls (Source Over + Glow)
    ctx.globalCompositeOperation = 'source-over';
    souls.forEach(s => {
      s.update();
      s.draw();
    });

    requestAnimationFrame(animate);
  }

  window.addEventListener('resize', resize);
  init();

</script>
