---
import type { ImageMetadata } from 'astro';
import ResponsivePicture from './media/ResponsivePicture.astro';

export interface Props {
  src: ImageMetadata | string;
  alt: string;
  caption?: string;
  credit?: string;
  aspectRatio?: '16/9' | '4/3' | '1/1' | 'auto';
  class?: string;
}

const {
  src,
  alt,
  caption,
  credit,
  aspectRatio = '16/9',
  class: className = '',
} = Astro.props;

const aspectClass = {
  '16/9': 'aspect-[16/9]',
  '4/3': 'aspect-[4/3]',
  '1/1': 'aspect-square',
  auto: 'aspect-auto max-h-[550px]',
}[aspectRatio];
---

{typeof src === 'string' ? (
  <figure class:list={['my-10 w-full', className]}>
    <div class="overflow-hidden rounded-3xl border border-black/5 bg-black/5 shadow-md">
      <img
        src={src}
        alt={alt}
        loading="lazy"
        decoding="async"
        class:list={['w-full object-cover transition-transform duration-700 hover:scale-102', aspectClass]}
      />
    </div>
    {(caption || credit) && (
      <figcaption class="mt-3 text-center text-xs font-ui text-[var(--color-midnightInk)]/60 italic leading-relaxed px-4">
        {caption && <span>{caption}</span>}
        {caption && credit && <span> &middot; </span>}
        {credit && <span>{credit}</span>}
      </figcaption>
    )}
  </figure>
) : (
  <ResponsivePicture
    src={src}
    alt={alt}
    aspectClass={aspectClass}
    class:list={['my-10', className]}
    caption={caption}
    credit={credit}
  />
)}
