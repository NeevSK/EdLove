---
export type ContentCadence = 'perennial' | 'living-document' | 'diagnostic' | 'field-report' | 'archival';

export interface Props {
  author: string;
  publishDate: Date | string;
  updatedDate?: Date | string;
  cadence?: ContentCadence;
  version?: string;
  license?: string;
  canonicalUrl: string;
  readingTime?: number;
  wordCount?: number;
  customNote?: string;
  class?: string;
}

const {
  author,
  publishDate,
  updatedDate,
  cadence = 'living-document',
  version = 'v1.0',
  license = 'CC BY-SA 4.0',
  canonicalUrl,
  readingTime = 3,
  customNote,
  class: className = '',
} = Astro.props;

const parsedPublished = publishDate instanceof Date ? publishDate : new Date(publishDate);
const parsedUpdated = updatedDate ? (updatedDate instanceof Date ? updatedDate : new Date(updatedDate)) : null;

const formattedPublished = new Intl.DateTimeFormat('en-US', {
  month: 'short',
  day: 'numeric',
  year: 'numeric',
}).format(parsedPublished);

const formattedUpdated = parsedUpdated
  ? new Intl.DateTimeFormat('en-US', {
      month: 'short',
      day: 'numeric',
      year: 'numeric',
    }).format(parsedUpdated)
  : null;

const cadenceMap: Record<
  ContentCadence,
  { label: string; badge: string; icon: string; explanation: string }
> = {
  perennial: {
    label: 'Foundational Canon',
    badge: 'bg-emerald-500/10 text-emerald-800 border-emerald-500/20',
    icon: '🏛️',
    explanation: 'Perennial Philosophy. Maintained as stable, enduring canon that rarely changes.',
  },
  'living-document': {
    label: 'Living Document',
    badge: 'bg-amber-500/10 text-amber-800 border-amber-500/20',
    icon: '🌱',
    explanation: 'Active Working Framework. Reviewed and updated periodically as educational practices evolve.',
  },
  diagnostic: {
    label: 'Empirical Diagnostic',
    badge: 'bg-sky-500/10 text-sky-800 border-sky-500/20',
    icon: '📊',
    explanation: 'Time-sensitive empirical field data reflecting surveyed conditions.',
  },
  'field-report': {
    label: 'Field Dispatch',
    badge: 'bg-purple-500/10 text-purple-800 border-purple-500/20',
    icon: '🧭',
    explanation: 'On-the-ground observations and intervention records from specific moments in time.',
  },
  archival: {
    label: 'Archival Record',
    badge: 'bg-slate-500/10 text-slate-700 border-slate-500/20',
    icon: '📜',
    explanation: 'Historical record preserved for institutional context.',
  },
};

const cadenceMeta = cadenceMap[cadence] || cadenceMap['living-document'];
---

<section class:list={["mt-20 rounded-3xl bg-white/70 backdrop-blur-md border border-black/10 p-6 sm:p-10 text-[var(--color-midnightInk)] shadow-xs relative overflow-hidden", className]}>
  <!-- Header Bar -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-black/10 pb-5 mb-8">
    <div class="flex items-center gap-2.5">
      <span class="text-lg text-[var(--color-gold)]">✦</span>
      <h3 class="font-heading text-xs uppercase tracking-[0.25em] font-bold text-[var(--color-midnightInk)]">
        Colophon & Epistemic Provenance
      </h3>
    </div>
    <div class="flex items-center gap-2">
      <span class:list={["inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold border", cadenceMeta.badge]}>
        <span>{cadenceMeta.icon}</span>
        <span>{cadenceMeta.label}</span>
      </span>
      <span class="text-xs font-mono font-bold px-2.5 py-1 rounded-full bg-black/5 text-[var(--color-midnightInk)]/70">
        {version}
      </span>
    </div>
  </div>

  <!-- Detailed Rigor Grid -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-8 text-xs leading-relaxed font-body">
    <!-- Col 1: Custody & Authorship -->
    <div class="space-y-2 border-b md:border-b-0 md:border-r border-black/5 pb-6 md:pb-0 md:pr-6">
      <span class="block font-heading uppercase text-[10px] tracking-widest font-bold text-[var(--color-midnightInk)]/50">
        Authorship & Stewardship
      </span>
      <p class="font-bold text-sm text-[var(--color-midnightInk)]">
        {author}
      </p>
      <p class="text-[11px] text-[var(--color-midnightInk)]/70 leading-normal">
        EdLove Educational Sanctuary Working Group. Maintained under transparent editorial review.
      </p>
    </div>

    <!-- Col 2: Epistemic Chronology & Cadence -->
    <div class="space-y-2 border-b md:border-b-0 md:border-r border-black/5 pb-6 md:pb-0 md:pr-6">
      <span class="block font-heading uppercase text-[10px] tracking-widest font-bold text-[var(--color-midnightInk)]/50">
        Rigor & Cadence
      </span>
      <div class="space-y-1 text-[11px]">
        <div class="flex justify-between">
          <span class="text-[var(--color-midnightInk)]/60">First Inscribed:</span>
          <time datetime={parsedPublished.toISOString()} class="font-medium text-[var(--color-midnightInk)]">{formattedPublished}</time>
        </div>
        <div class="flex justify-between">
          <span class="text-[var(--color-midnightInk)]/60">Last Verified / Updated:</span>
          <span class="font-medium text-[var(--color-midnightInk)]">{formattedUpdated ?? formattedPublished}</span>
        </div>
        <div class="flex justify-between">
          <span class="text-[var(--color-midnightInk)]/60">Reading Pace:</span>
          <span class="font-medium text-[var(--color-midnightInk)]">{readingTime} min contemplative pace</span>
        </div>
      </div>
      <p class="text-[10px] text-[var(--color-midnightInk)]/60 italic mt-2 border-t border-black/5 pt-2">
        {customNote ?? cadenceMeta.explanation}
      </p>
    </div>

    <!-- Col 3: Archival & License -->
    <div class="space-y-2">
      <span class="block font-heading uppercase text-[10px] tracking-widest font-bold text-[var(--color-midnightInk)]/50">
        Open Access & Rights
      </span>
      <p class="font-bold text-[var(--color-midnightInk)]">
        {license}
      </p>
      <p class="text-[11px] text-[var(--color-midnightInk)]/70">
        Free for educational attribution and non-commercial reproduction.
      </p>
      <div class="pt-2">
        <a 
          href={canonicalUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1 text-[11px] text-[var(--color-midnightInk)] font-semibold hover:text-[var(--color-gold)] underline underline-offset-2"
        >
          <span>Canonical Ledger & Source</span>
          <span class="text-[10px]">↗</span>
        </a>
      </div>
    </div>
  </div>
</section>
