---
---
<div 
  id="global-center-modal" 
  class="fixed inset-0 z-[100] flex items-center justify-center pointer-events-none opacity-0 transition-opacity duration-300"
>
  <!-- Backdrop -->
  <div 
    id="modal-backdrop" 
    class="absolute inset-0 bg-[#0f111a]/80 backdrop-blur-md"
  ></div>

  <!-- Modal Card -->
  <div 
    id="modal-card"
    class="relative z-10 w-full max-w-3xl bg-[var(--color-warmPaper)] border border-[var(--color-midnightInk)]/10 rounded-2xl shadow-2xl transform scale-95 transition-all duration-300 md:mx-6 flex flex-col max-h-[85vh] overflow-hidden"
  >
    <!-- Header -->
    <div class="flex items-center justify-between px-8 py-6 border-b border-[var(--color-midnightInk)]/10 bg-white/40">
      <div class="flex items-center gap-3">
          <span id="modal-icon" class="text-3xl"></span>
          <div>
            <h2 id="modal-title" class="font-serif text-2xl text-[var(--color-midnightInk)]"></h2>
            <div id="modal-subtitle" class="font-sans text-xs text-[var(--color-agedGold)] uppercase tracking-widest font-bold mt-1"></div>
          </div>
      </div>
      <button 
        id="close-modal-btn"
        class="p-2 rounded-full hover:bg-[var(--color-midnightInk)]/5 text-[var(--color-midnightInk)]/60 hover:text-[var(--color-agedGold)] transition-colors"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Content -->
    <div id="modal-content" class="p-8 overflow-y-auto prose prose-slate prose-lg max-w-none text-[var(--color-midnightInk)]/90">
      <!-- Dynamic -->
    </div>
  </div>
</div>

<script>
  function initCenterModal() {
    const modalWrapper = document.getElementById('global-center-modal');
    const backdrop = document.getElementById('modal-backdrop');
    const card = document.getElementById('modal-card');
    const closeBtn = document.getElementById('close-modal-btn');
    
    // Safety check: if elements are missing, abort
    if(!modalWrapper || !card) return;

    const els = {
      title: document.getElementById('modal-title'),
      subtitle: document.getElementById('modal-subtitle'),
      icon: document.getElementById('modal-icon'),
      content: document.getElementById('modal-content')
    };

    function openModal(data: any) {
      // Populate
      if(els.title) els.title.textContent = data.title || '';
      if(els.subtitle) els.subtitle.textContent = data.subtitle || '';
      if(els.icon) els.icon.textContent = data.icon || '';
      if(els.content) els.content.innerHTML = data.content || '';

      // Show
      modalWrapper?.classList.remove('pointer-events-none', 'opacity-0');
      card?.classList.remove('scale-95');
      card?.classList.add('scale-100');
      
      document.body.style.overflow = 'hidden';
    }

    function closeModal() {
      // Hide
      modalWrapper?.classList.add('pointer-events-none', 'opacity-0');
      card?.classList.remove('scale-100');
      card?.classList.add('scale-95');
      
      document.body.style.overflow = '';
    }

    // Universal Listener Management (Prevents Stacking)
    const windowAny = window as any;
    
    // Cleanup previous if exists
    if(windowAny._centerModalHandler) {
        window.removeEventListener('open-center-modal', windowAny._centerModalHandler);
    }
    
    // Define new handler with current closure
    windowAny._centerModalHandler = (e: any) => openModal(e.detail);
    
    // Attach
    window.addEventListener('open-center-modal', windowAny._centerModalHandler);

    closeBtn?.addEventListener('click', closeModal);
    backdrop?.addEventListener('click', closeModal);
    
    const escHandler = (e: KeyboardEvent) => {
      if (e.key === 'Escape') closeModal();
    };
    window.addEventListener('keydown', escHandler);
  }

  document.addEventListener('astro:page-load', initCenterModal);
</script>
