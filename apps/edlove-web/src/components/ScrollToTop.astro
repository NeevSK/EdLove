---
---

<button
    id="scroll-to-top"
    aria-label="Scroll to top"
    class="fixed bottom-8 right-8 z-50 p-4 rounded-full bg-[var(--color-midnightInk)] text-[var(--color-warmPaper)] shadow-2xl translate-y-24 opacity-0 transition-all duration-500 hover:scale-110 hover:bg-[var(--color-gold)] hover:text-[var(--color-midnightInk)] focus:outline-none focus:ring-2 focus:ring-[var(--color-gold)]"
>
    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18" />
    </svg>
</button>

<script>
    function initScrollToTop() {
        const scrollButton = document.getElementById('scroll-to-top');
        if (!scrollButton) return;

        function toggleScrollButton() {
            if (window.scrollY > 300) {
                scrollButton?.classList.remove('translate-y-24', 'opacity-0', 'pointer-events-none');
                scrollButton?.classList.add('translate-y-0', 'opacity-100', 'pointer-events-auto');
            } else {
                scrollButton?.classList.add('translate-y-24', 'opacity-0', 'pointer-events-none');
                scrollButton?.classList.remove('translate-y-0', 'opacity-100', 'pointer-events-auto');
            }
        }

        function scrollToTop() {
            window.scrollTo({
                top: 0,
                behavior: 'smooth'
            });
        }

        scrollButton.addEventListener('click', scrollToTop);
        window.addEventListener('scroll', toggleScrollButton);
        toggleScrollButton(); // Initial check
    }

    // Run on swap
    initScrollToTop();
    document.addEventListener('astro:page-load', initScrollToTop);
</script>
