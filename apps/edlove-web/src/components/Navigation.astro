---
const links = [
  { name: "Cosmos", href: "/cosmos" },
  { name: "Gurudevi", href: "/gurudevi" },
  { name: "The Sangha", href: "/community" },
  { name: "Library", href: "/library" },
  { name: "Resources", href: "/resources" },
];

const languages = [
    { code: 'EN', label: 'English', href: '/' },
    { code: 'SI', label: 'Sinhala', href: '/si' },
    { code: 'TA', label: 'Tamil', href: '/ta' },
];
---

<nav class="absolute top-8 left-1/2 -translate-x-1/2 z-[100] w-[95%] max-w-4xl px-2">
  <div class="floating-pill flex items-center justify-between px-8 py-3" style="background: rgba(255, 255, 255, 0.2); backdrop-filter: blur(8px);">
      <!-- Icon Only Logo -> Branded Anchor -->
      <a href="/" class="flex items-center gap-3 group">
          <span class="text-2xl filter drop-shadow-sm group-hover:scale-110 transition-transform duration-500 ease-out">🕊️</span>
          <span class="font-serif text-lg tracking-tight text-[var(--color-midnightInk)] opacity-0 group-hover:opacity-100 md:opacity-100 transition-all duration-500">EdLove</span>
      </a>

      <!-- Desktop Links: Minimal & Sophisticated -->
      <div class="hidden md:flex items-center gap-10">
          {links.map(link => (
              <a 
                href={link.href} 
                class="font-sans text-[11px] uppercase tracking-[0.2em] text-[var(--color-midnightInk)]/50 hover:text-[var(--color-agedGold)] hover:tracking-[0.25em] transition-all duration-300 font-bold"
              >
                {link.name}
              </a>
          ))}
              
              <!-- Language Switcher: Micro-Pill -->
              <div class="hidden md:flex items-center gap-2 pl-6 border-l border-[var(--color-midnightInk)]/10 ml-2">
                  {languages.map((lang) => (
                      <a href={lang.href} class="font-sans text-[10px] font-bold tracking-widest text-[var(--color-midnightInk)]/40 hover:text-[var(--color-agedGold)] transition-colors">
                          {lang.code}
                      </a>
                  ))}
              </div>
          </div>

      <!-- Mobile Trigger: Clean -->
      <button 
        id="mobile-menu-button"
        class="md:hidden text-[var(--color-midnightInk)]/60 hover:text-[var(--color-agedGold)] transition-colors p-2"
        aria-label="Toggle mobile menu"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 8h16M8 16h12" />
        </svg>
      </button>
  </div>

  <!-- Mobile Menu (The Minimal Overlay) -->
  <div 
    id="mobile-menu" 
    class="md:hidden fixed inset-0 z-50 hidden"
  >
    <div class="fixed inset-0 bg-[var(--color-warmPaper)]/95 backdrop-blur-xl" id="mobile-menu-backdrop"></div>
    
    <div class="fixed inset-0 flex flex-col items-center justify-center space-y-8 p-12 text-center" id="mobile-menu-panel">
        <button id="mobile-menu-close" class="absolute top-10 right-10 text-2xl font-light text-[var(--color-midnightInk)]">×</button>
        
        {links.map((link) => (
          <a 
            href={link.href} 
            class="font-serif text-4xl text-[var(--color-midnightInk)]/80 hover:text-[var(--color-agedGold)] transition-all"
          >
            {link.name}
          </a>
        ))}
    </div>
  </div>
</nav>

<script>
  const menuButton = document.getElementById('mobile-menu-button');
  const mobileMenu = document.getElementById('mobile-menu');
  const menuBackdrop = document.getElementById('mobile-menu-backdrop');
  const closeButton = document.getElementById('mobile-menu-close');

  function openMenu() {
    mobileMenu?.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  }

  function closeMenu() {
    mobileMenu?.classList.add('hidden');
    document.body.style.overflow = '';
  }

  menuButton?.addEventListener('click', openMenu);
  closeButton?.addEventListener('click', closeMenu);
  menuBackdrop?.addEventListener('click', closeMenu);
</script>
