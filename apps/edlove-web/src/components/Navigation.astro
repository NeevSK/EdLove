---
interface NavLink {
	name: string;
	href: string;
}

interface Language {
	code: string;
	label: string;
	href: string;
}

const links: NavLink[] = [
	{ name: "Cosmos", href: "/cosmos" },
	{ name: "Sri Lanka", href: "/sri-lanka" },
	{ name: "Gurudevi", href: "/gurudevi" },
	{ name: "Resources", href: "/resources" },
	{ name: "The Sangha", href: "/community" },
	{ name: "Library", href: "/library" },
];

const languages: Language[] = [
	{ code: "EN", label: "English", href: "/" },
	{ code: "SI", label: "Sinhala", href: "/si" },
	{ code: "TA", label: "Tamil", href: "/ta" },
];
---

<header class="fixed top-6 left-1/2 -translate-x-1/2 z-[100] w-[95%] max-w-5xl transition-all duration-300" id="main-header">
  <nav class="bg-white/40 backdrop-blur-md border border-black/5 rounded-full px-8 h-16 flex items-center justify-between shadow-sm">
      <a href="/" class="flex items-center gap-2 group shrink-0">
          <span class="text-2xl group-hover:scale-110 transition-transform duration-500 ease-out">🕊️</span>
          <span class="font-heading text-lg font-bold tracking-tight text-[var(--color-midnightInk)]">EdLove</span>
      </a>

      <!-- Desktop Links -->
      <div class="hidden lg:flex items-center gap-6">
          {links.map((link: NavLink) => (
              <a 
                href={link.href} 
                class="font-heading text-[13px] font-medium text-[var(--color-midnightInk)]/70 hover:text-[var(--color-gold)] transition-all duration-300 relative group truncate"
              >
                {link.name}
                <span class="absolute -bottom-1 left-0 w-0 h-px bg-[var(--color-gold)] transition-all duration-300 group-hover:w-full"></span>
              </a>
          ))}
              
          <!-- Language Switcher -->
          <div class="flex items-center gap-3 pl-6 border-l border-[var(--color-midnightInk)]/10 ml-2 shrink-0">
              {languages.map((lang: Language) => (
                  <a href={lang.href} class="font-heading text-[10px] font-bold text-[var(--color-midnightInk)]/40 hover:text-[var(--color-gold)] transition-colors">
                      {lang.code}
                  </a>
              ))}
          </div>
      </div>

      <!-- Mobile Trigger -->
      <button 
        id="mobile-menu-button"
        class="lg:hidden text-[var(--color-midnightInk)] p-2 focus-ring hover:bg-black/5 rounded-full transition-colors"
        aria-label="Toggle mobile menu"
        aria-expanded="false"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" id="menu-icon">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7" />
        </svg>
      </button>
  </nav>

</header>

<!-- Mobile Menu Overlay -->
<div 
  id="mobile-menu" 
  class="lg:hidden fixed inset-0 z-[110] opacity-0 pointer-events-none transition-all duration-500"
>
  <!-- Blurred Backdrop -->
  <div class="absolute inset-0 bg-white/95 backdrop-blur-xl" id="mobile-menu-backdrop"></div>
  
  <!-- Menu Content -->
  <div class="relative h-full flex flex-col items-center justify-center p-8">
      <!-- Close Button (Bottom for Thumb-Friendly) -->
      <button id="mobile-menu-close" class="absolute bottom-16 p-5 bg-[var(--color-midnightInk)] text-white rounded-full shadow-2xl focus-ring active:scale-95 transition-transform">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
      
      <div class="flex flex-col items-center gap-6 w-full max-w-xs" id="mobile-links">
          {links.map((link: NavLink) => (
            <a 
              href={link.href} 
              class="font-heading text-3xl font-bold text-[var(--color-midnightInk)] hover:text-[var(--color-gold)] transition-all active:scale-95"
            >
              {link.name}
            </a>
          ))}
          
          <div class="h-px w-12 bg-[var(--color-midnightInk)]/10 my-4"></div>
          
          <div class="flex flex-wrap justify-center gap-4">
            {languages.map((lang: Language) => (
                <a href={lang.href} class="px-4 py-2 rounded-full border border-black/5 font-heading text-sm font-bold text-[var(--color-midnightInk)]/40 hover:text-[var(--color-gold)] hover:bg-white transition-all">
                    {lang.label}
                </a>
            ))}
          </div>
      </div>
  </div>
</div>

<script>
  function setupNavigation() {
    const menuButton = document.getElementById('mobile-menu-button');
    const mobileMenu = document.getElementById('mobile-menu');
    const menuBackdrop = document.getElementById('mobile-menu-backdrop');
    const closeButton = document.getElementById('mobile-menu-close');
    // const header = document.getElementById('main-header');
    
    if (!menuButton || !mobileMenu) return;

    let isOpen = false;

    function toggleMenu() {
      isOpen = !isOpen;
      menuButton?.setAttribute('aria-expanded', isOpen.toString());
      
      if (isOpen) {
        mobileMenu?.classList.remove('opacity-0', 'pointer-events-none');
        document.body.style.overflow = 'hidden';
      } else {
        mobileMenu?.classList.add('opacity-0', 'pointer-events-none');
        document.body.style.overflow = '';
      }
    }

    menuButton.addEventListener('click', (e) => {
        e.stopPropagation();
        toggleMenu();
    });

    closeButton?.addEventListener('click', toggleMenu);
    menuBackdrop?.addEventListener('click', toggleMenu);

    // Scroll effect for header
    window.addEventListener('scroll', () => {
      const headerEl = document.getElementById('main-header');
      if (window.scrollY > 50) {
        headerEl?.classList.add('bg-[var(--color-warmPaper)]/80', 'backdrop-blur-md', 'shadow-sm');
      } else {
        headerEl?.classList.remove('bg-[var(--color-warmPaper)]/80', 'backdrop-blur-md', 'shadow-sm');
      }
    });

    // Close menu on link click
    const links = mobileMenu.querySelectorAll('a');
    links.forEach(link => {
        link.addEventListener('click', () => {
            if (isOpen) toggleMenu();
        });
    });
  }

  // Initialize on page load and on every transition
  document.addEventListener('astro:page-load', setupNavigation);
</script>
