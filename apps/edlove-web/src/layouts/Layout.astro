---
import Footer from '../components/Footer.astro';
import Navigation from '../components/Navigation.astro';
import SidePanel from '../components/SidePanel.astro';
import CenterModal from '../components/CenterModal.astro';
import '../styles/global.css';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		
		<!-- Google Fonts: Libre Baskerville, Inter, Cinzel -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;700&family=Inter:wght@300;400;500;600&family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet">
		
		<title>EdLove | The Educational Transformation Ecosystem</title>
	</head>
	<!-- UPDATED BACKGROUND: Warm, Living Canvas (Sand/Paper tone) to remove darkness -->
	<body class="antialiased min-h-screen flex flex-col bg-transparent text-[#2D3561]">
		<Navigation />
        <SidePanel />
        <CenterModal />
		<main class="flex-grow">
			<slot />
		</main>
		<Footer />
	</body>
</html>
