---
import '@fontsource-variable/fraunces/full.css';
import '@fontsource-variable/fraunces/full-italic.css';
import '@fontsource-variable/newsreader/opsz.css';
import '@fontsource-variable/newsreader/opsz-italic.css';
import '@fontsource-variable/geist';
import '@fontsource-variable/noto-serif-sinhala';
import '@fontsource-variable/noto-serif-tamil';
import '@fontsource-variable/noto-sans-sinhala';
import '@fontsource-variable/noto-sans-tamil';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import CenterModal from '../components/CenterModal.astro';
import Footer from '../components/Footer.astro';
import Navigation from '../components/Navigation.astro';
import ScrollToTop from '../components/ScrollToTop.astro';
import SidePanel from '../components/SidePanel.astro';
import StructuredData from '../components/StructuredData.astro';
import {
  computeProportionalLeading,
  computeProportionalTracking,
  generateFluidClamp,
  PSYCHOPHYSICAL_RATIOS,
} from '../tokens';
import {
  defaultOgImage,
  canonicalUrl,
  ORGANIZATION,
  SITE_DESCRIPTION,
  SITE_NAME,
  SITE_TITLE,
  SITE_URL,
  SITE_KEYWORDS,
} from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  ogType?: 'website' | 'article';
  theme?: 'cosmic' | 'diagnostic' | 'library' | 'community' | 'gurudevi';
  noindex?: boolean;
  canonicalUrl?: string;
  structuredData?: Record<string, any> | Array<Record<string, any>>;
  alternateLanguages?: Array<{ lang: string; href: string }>;
}

const {
  title = SITE_TITLE,
  description = SITE_DESCRIPTION,
  image,
  ogType = 'website',
  theme,
  noindex = false,
  canonicalUrl: customCanonicalUrl,
  structuredData = [],
  alternateLanguages = [],
} = Astro.props;

const canonical = customCanonicalUrl ?? canonicalUrl(Astro.url.pathname);
const ogImage = image ?? defaultOgImage(Astro.url.pathname);
const locale = Astro.currentLocale ?? 'en';
const robotsContent = noindex ? 'noindex, nofollow' : 'index, follow';

const baseStructuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    ...ORGANIZATION,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE_NAME,
    url: SITE_URL,
    description: SITE_DESCRIPTION,
    inLanguage: ['en', 'si', 'ta'],
    publisher: {
      '@type': 'Organization',
      name: ORGANIZATION.name,
      url: ORGANIZATION.url,
    },
    potentialAction: {
      '@type': 'SearchAction',
      target: `${SITE_URL}/knowledge.json?q={search_term_string}`,
      'query-input': 'required name=search_term_string',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: title,
    description,
    url: canonical,
    inLanguage: locale,
    isPartOf: {
      '@type': 'WebSite',
      name: SITE_NAME,
      url: SITE_URL,
    },
  },
]
  .concat(Array.isArray(structuredData) ? structuredData : [structuredData])
  .filter(Boolean);
---

<!doctype html>
<html lang={locale}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="robots" content={robotsContent} />
		<meta name="keywords" content={SITE_KEYWORDS.join(', ')} />
		<link rel="canonical" href={canonical} />
		{alternateLanguages.map((alternate) => <link rel="alternate" hreflang={alternate.lang} href={alternate.href} />)}
		<link rel="alternate" type="application/rss+xml" title="EdLove Library RSS" href="/feed.xml" />
		<link rel="alternate" type="application/rss+xml" title="EdLove Journal RSS" href="/journal/feed.xml" />
		<meta property="og:type" content={ogType} />
		<meta property="og:site_name" content={SITE_NAME} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:alt" content={title} />
		<meta property="og:locale" content={locale} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />
		
		<title>{title}</title>
		<StructuredData data={baseStructuredData} />
		<ClientRouter />

		<!-- Living mathematical tokens from @intuitui-labs/a11y-gate -->
		<style is:global define:vars={{
			touchFloor: `${PSYCHOPHYSICAL_RATIOS.TOUCH_TARGET_FLOOR_PX}px`,
			focusRingStroke: `${PSYCHOPHYSICAL_RATIOS.FOCUS_RING_STROKE_MIN_PX}px`,
			focusRingOffset: `${PSYCHOPHYSICAL_RATIOS.FOCUS_RING_OFFSET_MIN_PX}px`,
			proportionalLeadingBody: computeProportionalLeading(16, 'body').idealRatio,
			proportionalTrackingBody: `${computeProportionalTracking(16).idealEm}em`,
			proportionalTrackingHeadline: `${computeProportionalTracking(32).idealEm}em`,
			fluidBodySize: generateFluidClamp({ minSizePx: 16, maxSizePx: 18, minViewportPx: 375, maxViewportPx: 1200 }),
		}}>
			:root {
				--min-touch-target: var(--touchFloor);
				--focus-ring-width: var(--focusRingStroke);
				--focus-ring-offset: var(--focusRingOffset);
			}
			.focus-ring:focus-visible {
				outline: var(--focusRingStroke) solid var(--color-secondaryInk);
				outline-offset: var(--focusRingOffset);
			}
		</style>
	</head>
	<body class:list={[
		"antialiased min-h-screen flex flex-col selection:bg-[var(--color-gold)] selection:text-[var(--color-midnightInk)]",
		theme ? `context-${theme}` : "bg-[var(--color-warmPaper)] text-[var(--color-midnightInk)]"
	]}>
		<Navigation />
        <SidePanel />
        <CenterModal />
		<main class="flex-grow pt-[var(--spacing-nav-height)]">
			<slot />
		</main>
		<ScrollToTop />
		<Footer />
	</body>
</html>
