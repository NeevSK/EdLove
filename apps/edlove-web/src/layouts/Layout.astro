---
import Footer from '../components/Footer.astro';
import Navigation from '../components/Navigation.astro';
import SidePanel from '../components/SidePanel.astro';
import CenterModal from '../components/CenterModal.astro';
import ScrollToTop from '../components/ScrollToTop.astro';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';

interface Props {
	title?: string;
	theme?: 'cosmic' | 'diagnostic' | 'library' | 'community' | 'gurudevi';
}

const { title = "EdLove | The Educational Transformation Ecosystem", theme } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		
		<!-- Google Fonts: Inter (headings/sans) & Lora (body/serif) -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Lora:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600;1,700&display=swap" rel="stylesheet">
		
		<title>{title}</title>
		<ClientRouter />
	</head>
	<body class:list={[
		"antialiased min-h-screen flex flex-col selection:bg-[var(--color-gold)] selection:text-[var(--color-midnightInk)]",
		theme ? `context-${theme}` : "bg-[var(--color-warmPaper)] text-[var(--color-midnightInk)]"
	]}>
		<Navigation />
        <SidePanel />
        <CenterModal />
		<main class="flex-grow pt-[var(--spacing-nav-height)]">
			<slot />
		</main>
        <ScrollToTop />
		<Footer />
	</body>
</html>
