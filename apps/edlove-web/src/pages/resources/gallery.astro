---
import Layout from '../../layouts/Layout.astro';
import CinematicBackground from '../../components/CinematicBackground.astro';

// Data from 13_GLOBAL_INNOVATION_GALLERY.md
const globalOpenSource = {
    name: "Global Open Source",
    subtitle: "The Foundation of Free Knowledge",
    focus: "Universal Access, collaborative Development, Zero Cost",
    innovations: [
        { title: "Moodle", country: "Global", description: "The world's most popular open-source LMS, used by millions to create private learning spaces.", link: "https://moodle.org" },
        { title: "Kolibri", country: "Global (Offline)", description: "An offline ecosystem for universal education, running on anything from Raspberry Pis to old laptops.", link: "https://learningequality.org/kolibri" },
        { title: "Khan Academy", country: "Global", description: "Free, world-class education for anyone, anywhere. The gold standard for self-paced learning.", link: "https://khanacademy.org" },
        { title: "Wikipedia", country: "Global", description: "The sum of all human knowledge, available for free. The ultimate educational resource.", link: "https://wikipedia.org" },
        { title: "OpenStreetMap", country: "Global", description: "A free, editable map of the whole world that is being built by volunteers largely from scratch.", link: "https://openstreetmap.org" }
    ]
};

const regions = [
    {
        name: "Africa",
        subtitle: "The Mobile Renaissance",
        focus: "Accessibility, Community, Resourcefulness",
        innovations: [
            { title: "Bewize", country: "Morocco", description: "Gamified primary school revision across Curricula (Math/French/Arabic).", link: "https://bewize.ma" },
            { title: "Sprints", country: "Egypt", description: "A 'Talent Journey' AI that upskills and hires tech talent across the region.", link: "https://sprints.ai" },
            { title: "AltSchool Africa", country: "Nigeria", description: "Mobile-first tech diplomas for the 'unskilled' – bypassing traditional barriers.", link: "https://altschoolafrica.com" },
            { title: "Foondamate", country: "South Africa", description: "A WhatsApp bot that acts as a study assistant in the app teachers already use.", link: "https://foondamate.com" },
            { title: "Eneza Education", country: "Kenya", description: "'Low-tech' learning via SMS/USSD for students with zero internet.", link: "https://enezaeducation.com" },
            { title: "eCampus", country: "Ghana", description: "Combining academic and vocational training with localized Ghanaian content.", link: "https://ecampus.com.gh" },
            { title: "Simba Education", country: "Zimbabwe", description: "Comprehensive school management system with high offline capability.", link: "https://simba.education" }
        ]
    },
    {
        name: "Asia",
        subtitle: "The AI Frontier",
        focus: "Scale, Personalization, High-Tech Integration",
        innovations: [
            { title: "Gurudevi", country: "Sri Lanka", description: "A digital sanctuary built for the dignity and sovereignty of Sri Lankan teachers.", link: "https://gurudevi.edlove.org" },
            { title: "AI Textbooks", country: "South Korea", description: "National textbooks that adapt to reading levels in real-time (Launching 2025).", link: "#" },
            { title: "Vernacular AI", country: "India", description: "AI mentors speaking in regional languages (Hindi, Tamil, etc.) for rural areas.", link: "https://interactive.ai" },
            { title: "STEAM4INNOVATOR", country: "Thailand", description: "National framework integrating business-thinking with STEM for high schoolers.", link: "https://nia.or.th" },
            { title: "National AI Policy", country: "Kazakhstan", description: "One of the world's first national frameworks for AI use/ethics in K-12.", link: "#" },
            { title: "Amira Learning", country: "Jordan", description: "National AI-supported literacy initiative focused on primary school reading.", link: "https://amira.ai" },
            { title: "ZEP QUIZ", country: "Indonesia", description: "Gamified Korean-designed quiz platforms adapted for the Indonesian curriculum.", link: "#" }
        ]
    },
    {
        name: "Europe",
        subtitle: "The Human-Centric Leap",
        focus: "Ethics, Digital Maturity, Teacher Empowerment",
        innovations: [
            { title: "AI Leap", country: "Estonia", description: "Providing AI chatbots to every high schooler as a fundamental digital right.", link: "https://e-estonia.com" },
            { title: "Alice.tech", country: "Denmark", description: "High-end AI for personalized learning, moving from pilot to national scale.", link: "https://alice.tech" },
            { title: "Skriware", country: "Poland", description: "STEAM education combining 3D printing and robotics for K-12.", link: "https://skriware.com" },
            { title: "High Tech Campus", country: "Netherlands", description: "Eindhoven's sustainable 'Campus of the Future' architecture and tech.", link: "https://hightechcampus.com" }
        ]
    },
    {
        name: "Americas",
        subtitle: "Immersive & Social",
        focus: "VR/AR, Gamification, Personalization",
        innovations: [
            { title: "Ceibal", country: "Uruguay", description: "700k students on a national LMS with AI 'PowerBuds' for teachers.", link: "https://ceibal.edu.uy" },
            { title: "Yuna Stories", country: "Brazil", description: "AI-powered children's stories where the child is the hero.", link: "https://yunastory.com" },
            { title: "Xertify", country: "Colombia", description: "Blockchain-based academic credentials to stop student bureaucracy.", link: "https://xertify.co" },
            { title: "Lirmi", country: "Chile", description: "All-in-one school software for humane classroom management across LatAm.", link: "https://lirmi.com" }
        ]
    },
    {
        name: "Oceania",
        subtitle: "Earth-Connected Wisdom",
        focus: "Nature, Indigenous Sovereignty, Cultural Inclusion",
        innovations: [
            { title: "Indigenous Tech", country: "Australia", description: "100% Indigenous-owned tech solutions integrating native worldviews into AI.", link: "https://indigenoustech.com.au" },
            { title: "Its Time Foundation", country: "Fiji", description: "Solar-powered 24/7 electricity and Starlink high-speed internet for remote schools.", link: "https://itstimefoundation.org" },
            { title: "Pacific Lens EdTech", country: "New Zealand", description: "Curriculum tools optimized for Pasifika values and multi-generational learning.", link: "https://education.govt.nz" },
            { title: "SMS Daily Lessons", country: "PNG", description: "Proven 10% increase in literacy scores via simple daily text message interventions.", link: "#" }
        ]
    }
];

const specializedInnovations = [
    { title: "QTRobot", category: "Autism (ASD)", description: "Social robots that help kids practice communication in a non-judgmental way." },
    { title: "GraphoGame", category: "Dyslexia", description: "Science-backed literacy game used across Jamaica/Guyana for early reading." },
    { title: "Solar Classroom", category: "Off-Grid", description: "Solar panels + low-power computers + preloaded Wikipedia for off-grid setup." },
    { title: "Socrat.ai", category: "Student Agency", description: "AI that never gives the answer, only asks the next Socratic question." },
    { title: "Schoolhouse.world", category: "Peer Learning", description: "Students becoming certified tutors for other students globally (Khan Academy)." }
];

// Color palettes per region
const regionColors = {
    "Africa": { border: "#D97757", accent: "#8B4513", bg: "#FFF5F0" },
    "Asia": { border: "#FFB84D", accent: "#D4A574", bg: "#FFFBF0" },
    "Europe": { border: "#4A90E2", accent: "#5D6D7E", bg: "#F0F7FF" },
    "Americas": { border: "#E74C3C", accent: "#27AE60", bg: "#FFF0F0" },
    "Oceania": { border: "#16A085", accent: "#3498DB", bg: "#F0FFFF" }
};

// Card style variants
const getCardStyle = (index) => {
    const styles = ['exhibition', 'artifact', 'catalog'];
    return styles[index % 3];
};
---

<Layout title="Global Innovation Gallery | EdLove" theme="library">
    <CinematicBackground />

    <main class="relative z-10 pb-24 sanctuary-container pt-24 max-w-7xl mx-auto px-6">
        <!-- Navigation -->
        <a href="/resources" class="inline-flex items-center gap-2 text-[var(--color-midnightInk)] opacity-60 hover:opacity-100 transition-all mb-12 group">
            <span class="text-xl group-hover:-translate-x-2 transition-transform">&larr;</span>
            <span class="text-xs uppercase tracking-widest">Back to Resources</span>
        </a>

        <!-- Header -->
        <header class="text-center space-y-6 mb-20 animate-fade-in-up max-w-4xl mx-auto">
            <span class="text-xs uppercase tracking-[0.3em] text-[var(--color-agedGold)] font-bold">Domain IV: Action & Flow</span>
            <h1 class="text-5xl md:text-6xl font-heading font-bold text-[var(--color-midnightInk)] leading-tight">The Global Innovation Gallery</h1>
            <p class="font-body text-xl text-[var(--color-midnightInk)]/60 max-w-2xl mx-auto italic leading-relaxed">
                "To build a passage, we must first know all the lands we are connecting."
            </p>
        </header>

        <!-- World Map Visual -->
        <section class="mb-32 animate-fade-in-up">
            <div class="bg-white border border-[var(--color-agedGold)]/20 rounded-[50px] p-12 md:p-16 relative overflow-hidden group shadow-2xl">
                <h2 class="relative z-10 text-2xl font-heading font-bold text-slate-800 mb-12 text-center uppercase tracking-widest">Innovation Topography</h2>
                
                <div class="relative z-10 aspect-[2/1] bg-slate-900 rounded-none border-4 border-slate-900 overflow-hidden mb-12 shadow-2xl">
                    <img 
                        src="https://images.unsplash.com/photo-1451187580459-43490279c0fa?q=80&w=2072&auto=format&fit=crop" 
                        alt="Global Innovation Map" 
                        class="absolute inset-0 w-full h-full object-cover opacity-60 grayscale hover:grayscale-0 transition-all duration-1000"
                    />
                    <div class="absolute inset-0 bg-gradient-to-t from-slate-900 via-transparent to-transparent opacity-80"></div>
                    
                    <!-- Animated Pulse Markers -->
                    <div class="absolute top-[30%] left-[20%] w-3 h-3 bg-red-500 rounded-full animate-ping"></div>
                    <div class="absolute top-[40%] left-[50%] w-3 h-3 bg-gold-500 rounded-full animate-ping" style="animation-delay: 1s;"></div>
                    <div class="absolute top-[25%] left-[75%] w-3 h-3 bg-blue-500 rounded-full animate-ping" style="animation-delay: 2s;"></div>
                    <div class="absolute top-[60%] left-[30%] w-3 h-3 bg-emerald-500 rounded-full animate-ping" style="animation-delay: 1.5s;"></div>
                    <div class="absolute top-[70%] left-[85%] w-3 h-3 bg-teal-500 rounded-full animate-ping" style="animation-delay: 0.5s;"></div>
                </div>
                
                <div class="relative z-10 grid grid-cols-2 md:grid-cols-5 gap-6">
                    {regions.map((region, i) => (
                        <button 
                            class="region-selector p-6 bg-slate-50 border border-slate-200 hover:border-slate-800 transition-all text-left w-full group/btn" 
                            data-region={region.name}
                        >
                            <h3 class="font-bold text-sm mb-1 uppercase tracking-tighter" style={`color: ${regionColors[region.name].accent}`}>{region.name}</h3>
                            <p class="text-[9px] uppercase tracking-widest text-slate-400 font-bold mb-3">{region.subtitle}</p>
                            <div class="text-xs font-mono text-slate-600 font-semibold">{region.innovations.length} Exhibits</div>
                        </button>
                    ))}
                </div>
            </div>
        </section>

        <!-- Global Open Source Section -->
        <section class="mb-40 animate-fade-in-up">
            <div class="relative bg-slate-950 p-16 overflow-hidden border-t-8 border-emerald-500 shadow-2xl">
                <div class="relative z-10 mb-16 max-w-3xl">
                    <h2 class="text-4xl font-heading font-bold text-white mb-4 tracking-tight uppercase underline decoration-emerald-500 decoration-4 underline-offset-8">{globalOpenSource.name}</h2>
                    <p class="text-xs font-mono uppercase tracking-[0.4em] font-bold text-emerald-400 mb-6">Access Layer: {globalOpenSource.focus}</p>
                    <p class="text-slate-400 text-lg italic leading-relaxed">"{globalOpenSource.subtitle}"</p>
                </div>

                <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
                    {globalOpenSource.innovations.map((item) => (
                        <div class="bg-white/5 backdrop-blur-md p-8 border border-white/10 hover:border-emerald-500/50 transition-all group/item hover:bg-white/10">
                            <div class="flex items-center justify-between mb-6 border-b border-white/10 pb-4">
                                <span class="text-[10px] lowercase font-mono text-emerald-400">#oss_infrastructure</span>
                                <span class="text-[10px] font-mono text-white/40">{item.country}</span>
                            </div>
                            <h3 class="text-2xl font-heading font-bold text-white mb-4 group-hover/item:text-emerald-300 transition-colors">{item.title}</h3>
                            <p class="text-sm text-slate-400 leading-relaxed mb-8">{item.description}</p>
                            
                            <a href={item.link} target="_blank" class="inline-flex items-center gap-2 text-xs font-bold text-emerald-500 hover:text-emerald-400 transition-colors uppercase tracking-[0.2em] border-b border-emerald-500/20 pb-1">
                                <span>Visit Solution</span>
                                <span>&rarr;</span>
                            </a>
                        </div>
                    ))}
                </div>
            </div>
        </section>

        <!-- Regional Breakdown -->
        <div class="space-y-60">
            {regions.map((region) => {
                const colors = regionColors[region.name];
                return (
                    <section id={region.name} class="scroll-mt-32 animate-fade-in-up relative">
                        <!-- Region Backdrop -->
                        <div class="absolute -inset-x-12 -inset-y-16 opacity-5 bg-current -z-10" style={`color: ${colors.border}`}></div>
                        
                        <div class="mb-16 border-l-8 pl-10" style={`border-color: ${colors.border}`}>
                            <h2 class="text-5xl font-heading font-bold text-slate-900 mb-4 tracking-tight uppercase">{region.name}</h2>
                            <div class="flex flex-wrap gap-4 items-center">
                                <span class="bg-slate-900 text-white px-4 py-1 text-[10px] font-mono uppercase tracking-widest">{region.subtitle}</span>
                                <span class="text-xs font-mono font-bold uppercase tracking-widest text-slate-400">Primary Core: {region.focus}</span>
                            </div>
                        </div>

                        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-12">
                            {region.innovations.map((item, i) => {
                                const cardStyle = getCardStyle(i);
                                return (
                                    <div 
                                        class={`
                                            transition-all duration-500 group/item flex flex-col justify-between
                                            ${cardStyle === 'exhibition' ? 'bg-white p-10 border-t-4 border-slate-900 shadow-xl' : ''}
                                            ${cardStyle === 'artifact' ? 'bg-[#FCFAF2] p-10 border border-slate-200 shadow-lg relative clip-artifact transform hover:-rotate-1' : ''}
                                            ${cardStyle === 'catalog' ? 'bg-white p-10 border border-slate-100 hover:border-slate-800 border-b-8 shadow-sm flex flex-col' : ''}
                                        `}
                                        style={cardStyle === 'catalog' ? `border-bottom-color: ${colors.border}` : (cardStyle === 'exhibition' ? `border-top-color: ${colors.border}` : '')}
                                    >
                                        {cardStyle === 'artifact' && (
                                            <div class="absolute top-0 right-0 w-12 h-12 bg-slate-200/20 rotate-45 translate-x-1/2 -translate-y-1/2"></div>
                                        )}
                                        
                                        <div>
                                            <div class="flex items-center justify-between mb-8">
                                                <span class="text-[10px] uppercase tracking-[0.3em] font-bold opacity-40">{item.country}</span>
                                                <span class="text-[10px] font-mono opacity-20">00{i + 1}</span>
                                            </div>
                                            <h3 class="text-3xl font-heading font-bold text-slate-800 mb-6 leading-[0.9] tracking-tighter group-hover/item:text-slate-950 transition-colors uppercase">{item.title}</h3>
                                            <p class="text-sm text-slate-600 leading-relaxed font-body italic mb-10 pb-6 border-b border-slate-100">"{item.description}"</p>
                                        </div>
                                        
                                        {item.link !== '#' && (
                                            <div>
                                                <a href={item.link} target="_blank" class="inline-flex items-center gap-3 text-[10px] font-bold text-slate-400 hover:text-slate-900 transition-all uppercase tracking-[0.3em] group/link">
                                                    <span class="border-b-2 border-transparent group-hover/link:border-current py-1 transition-all">Examine Solution</span>
                                                    <span class="text-lg">&rarr;</span>
                                                </a>
                                            </div>
                                        )}
                                    </div>
                                );
                            })}
                        </div>
                    </section>
                );
            })}
        </div>

        <!-- Niche Frontiers -->
        <section class="mb-32 mt-60">
            <div class="bg-slate-900 text-white p-20 shadow-[-20px_20px_0px_0px_#D4A574]">
                <div class="mb-20">
                    <span class="text-[10px] uppercase tracking-[0.5em] text-gold-500 font-bold mb-4 block text-amber-500">Curated Specializations</span>
                    <h2 class="text-5xl font-heading font-bold uppercase tracking-tighter italic">Niche Frontiers</h2>
                </div>
                
                <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-12">
                    {specializedInnovations.map(item => (
                        <div class="border border-white/10 p-10 hover:bg-white/5 transition-all">
                            <span class="text-[9px] uppercase tracking-[0.3em] text-amber-500 font-bold block mb-4 border-l border-amber-500 pl-3">{item.category}</span>
                            <h3 class="text-2xl font-heading font-bold text-white mb-6 uppercase leading-tight">{item.title}</h3>
                            <p class="text-sm text-white/50 leading-relaxed font-mono italic">"{item.description}"</p>
                        </div>
                    ))}
                </div>
            </div>
        </section>
    </main>
</Layout>

<style>
    .clip-artifact {
        clip-path: polygon(2% 0%, 100% 0%, 98% 98%, 0% 100%);
    }
    
    @keyframes ping-slow {
        0% { transform: scale(1); opacity: 0.8; }
        100% { transform: scale(3); opacity: 0; }
    }
</style>

<script>
    function initGalleryInteractions() {
        const selectors = document.querySelectorAll('.region-selector');
        
        selectors.forEach(el => {
            el.addEventListener('click', () => {
                const regionId = el.getAttribute('data-region');
                const target = document.getElementById(regionId);
                
                if (target) {
                    target.scrollIntoView({ 
                        behavior: 'smooth',
                        block: 'start'
                    });
                }
            });
        });
    }

    initGalleryInteractions();
    document.addEventListener('astro:page-load', initGalleryInteractions);
</script>
