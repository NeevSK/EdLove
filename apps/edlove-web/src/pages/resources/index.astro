---
import Layout from '../../layouts/Layout.astro';
import CinematicBackground from '../../components/CinematicBackground.astro';
import ExpandableContent from '../../components/ExpandableContent.astro';
import { getCollection, render } from 'astro:content';

const resourceEntries = await getCollection('resources', ({ data }) => !data.draft);
resourceEntries.sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));
---

<Layout title="Resources | EdLove">
    <CinematicBackground />

    <div class="relative z-10 pb-24 sanctuary-container" style="padding-top: var(--spacing-nav-height);">
        <!-- Header: The Ecosystem -->
        <section class="text-center space-y-12 mb-32 animate-fade-in-up">
            <div class="space-y-4">
                <span class="font-heading text-[10px] uppercase tracking-[0.4em] font-bold text-[var(--color-gold)] opacity-60">Domain IV</span>
                <h1 class="text-7xl md:text-9xl font-heading font-bold text-[var(--color-midnightInk)] leading-none">Resource Ecosystem</h1>
            </div>

            <div class="h-px w-24 bg-[var(--color-gold)]/30 mx-auto"></div>

            <p class="font-body text-2xl text-[var(--color-midnightInk)]/50 max-w-2xl mx-auto leading-relaxed italic">
                "Resource flow determines reality. <br/> We propose a direct inversion."
            </p>
        </section>

        <!-- Dynamic Content -->
        <section class="max-w-4xl mx-auto space-y-16">
            {resourceEntries.map(async (entry) => {
                const { Content } = await render(entry);
                return (
                    <ExpandableContent 
                        title={entry.data.title} 
                        subtitle={entry.data.subtitle} 
                        icon={entry.data.icon}
                    >
                        <div class="py-6 space-y-6 text-[var(--color-midnightInk)]/80 prose prose-slate max-w-none">
                             <Content />
                             
                             {entry.data.title === "How It Works" && (
                                <div class="flex flex-col md:flex-row gap-6 pt-10">
                                    <button class="flex-grow px-10 py-4 bg-[var(--color-midnightInk)] text-[var(--color-warmPaper)] font-bold rounded-full shadow-lg hover:scale-105 transition-all font-heading text-xs uppercase tracking-widest">
                                        I Have a Need
                                    </button>
                                    <button class="flex-grow px-10 py-4 bg-white/20 border border-[var(--color-midnightInk)]/10 text-[var(--color-midnightInk)] font-bold rounded-full hover:bg-white/40 transition-all font-heading text-xs uppercase tracking-widest">
                                        I Can Help
                                    </button>
                                </div>
                             )}
                        </div>
                    </ExpandableContent>
                );
            })}
        </section>
    </div>
</Layout>
