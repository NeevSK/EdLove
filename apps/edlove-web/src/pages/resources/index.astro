---
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';
import {Theme } from '@/constants/Theme';
---

<Layout>
  <Navigation />
  
  <main class="min-h-screen pt-24 pb-16">
    <div class="max-w-6xl mx-auto px-6">
      
      <div class="text-center mb-16">
        <h1 class="font-heading text-5xl md:text-7xl mb-6" style={`color: ${Theme.colors.warmGold}`}>
          Resource Ecosystem
        </h1>
        <p class="font-body text-xl md:text-2xl max-w-3xl mx-auto leading-relaxed" style={`color: ${Theme.colors.deepIndigo}; opacity: 0.8`}>
          Tools, curricula, lesson plans. The infrastructure of alternative education.
        </p>
      </div>

      <div class="prose prose-lg max-w-4xl mx-auto mb-16">
        <p class="font-body text-lg leading-relaxed" style={`color: ${Theme.colors.deepIndigo}`}>
          A curated collection of actual resources—not just links, but tested, annotated, contextualized materials that teachers, parents, and learners can use.
        </p>
      </div>

      <div class="text-center p-12 rounded-lg" style={`background: ${Theme.colors.starlightSilver}`}>
        <h2 class="font-heading text-3xl mb-4" style={`color: ${Theme.colors.deepIndigo}`}>
          Under Construction 🔨
        </h2>
        <p class="font-body mb-6" style={`color: ${Theme.colors.deepIndigo}; opacity: 0.7`}>
          We're building a comprehensive resource library. Have something to share?
        </p>
        <a href="/community" class="inline-block px-8 py-3 rounded-sm font-body font-medium hover:opacity-80 transition-opacity" style={`background: ${Theme.colors.warmGold}; color: ${Theme.colors.softWhite}`}>
          Contribute Resources →
        </a>
      </div>

    </div>
  </main>
</Layout>
