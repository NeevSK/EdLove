---
import Layout from '../../layouts/Layout.astro';
import CinematicBackground from '../../components/CinematicBackground.astro';
import ExpandableContent from '../../components/ExpandableContent.astro';
---

<Layout title="Resources | EdLove">
    <CinematicBackground />

    <section class="relative z-10 min-h-screen flex flex-col justify-center items-center text-center px-6 pt-24">
        <h1 class="font-cinzel text-warmGold text-xl md:text-2xl tracking-[0.2em] uppercase mb-4">Domain IV</h1>
        <h2 class="font-serif text-5xl md:text-7xl text-[#2D3561] mb-8">Resource Ecosystem</h2>
        
        <div class="w-full max-w-4xl mx-auto space-y-4 text-left">
            <ExpandableContent title="The Vision" subtitle="Algorithmic Redistribution" icon="👁️" mode="modal">
                 <p class="font-serif italic text-2xl text-[#D4A574] mb-6 text-center">
                "Resource flow determines reality."
                </p>
                <p class="font-sans text-lg text-[#2D3561]/80 leading-relaxed mb-4">
                    The current system hoards resources at the top and trickles them down to the classroom. We propose an inversion: a peer-to-peer network where demand signals (teacher needs) are met directly by supply (philanthropic capital, material goods, expert time).
                </p>
                <p class="font-sans text-lg text-[#2D3561]/80 leading-relaxed">
                    No middleman. No administrative skimming. Just pure redistribution.
                </p>
            </ExpandableContent>

             <ExpandableContent title="How It Works (v0.1)" subtitle="Manual Matchmaking" icon="⚙️" mode="modal">
                <div class="grid md:grid-cols-2 gap-8 items-center">
                    <div>
                        <ul class="font-sans text-base text-[#2D3561]/80 space-y-4">
                            <li class="flex items-center gap-3"><span class="bg-[#D4A574] text-black w-6 h-6 rounded-full flex items-center justify-center font-bold text-xs">1</span> Educators share specific needs (books, tech, repairs).</li>
                            <li class="flex items-center gap-3"><span class="bg-[#D4A574] text-black w-6 h-6 rounded-full flex items-center justify-center font-bold text-xs">2</span> Supporters pledge resources directly to the request.</li>
                            <li class="flex items-center gap-3"><span class="bg-[#D4A574] text-black w-6 h-6 rounded-full flex items-center justify-center font-bold text-xs">3</span> We verify and facilitate the transfer.</li>
                        </ul>
                    </div>
                    <div class="flex flex-col gap-4">
                        <button class="w-full px-6 py-4 bg-[#D4A574] text-[#2D3561] font-bold rounded-xl hover:bg-[#E8B4B8] transition-colors shadow-lg">
                            I Have a Need
                        </button>
                        <button class="w-full px-6 py-4 bg-transparent border border-[#F5F1E8]/30 text-[#F5F1E8] font-bold rounded-xl hover:bg-white/10 transition-colors">
                            I Can Help
                        </button>
                    </div>
                </div>
            </ExpandableContent>
        </div>
    </section>
</Layout>
