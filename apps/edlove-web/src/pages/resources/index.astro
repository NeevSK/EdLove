---
import Layout from '../../layouts/Layout.astro';
import CinematicBackground from '../../components/CinematicBackground.astro';
import ExpandableContent from '../../components/ExpandableContent.astro';
---

<Layout title="Resources | EdLove">
    <CinematicBackground />

    <div class="relative z-10 pb-24 sanctuary-container">
        <!-- Header: The Ecosystem -->
        <section class="text-center space-y-12 mb-32 animate-fade-in-up">
            <div class="space-y-4">
                <span class="font-sans text-[10px] uppercase tracking-[0.4em] font-bold text-[var(--color-agedGold)] opacity-60">Domain IV</span>
                <h1 class="text-7xl md:text-9xl font-serif text-[var(--color-midnightInk)] leading-none">Resource Ecosystem</h1>
            </div>

            <div class="h-px w-24 bg-[var(--color-agedGold)]/30 mx-auto"></div>

            <p class="font-serif text-2xl text-[var(--color-midnightInk)]/50 max-w-2xl mx-auto leading-relaxed italic">
                "Resource flow determines reality. <br/> We propose a direct inversion."
            </p>
        </section>

        <!-- The Mechanics -->
        <section class="max-w-4xl mx-auto space-y-16">
            <ExpandableContent title="The Vision" subtitle="Algorithmic Redistribution" icon="👁️">
                 <div class="py-12 space-y-8 text-center">
                    <p class="text-3xl font-serif text-[var(--color-agedGold)] italic">"Direct Connection, Zero Skimming."</p>
                    <p class="max-w-2xl mx-auto text-[var(--color-midnightInk)]/70 leading-relaxed font-sans font-light">
                        A peer-to-peer network where demand signals (teacher needs) are met directly by supply (philanthropic capital, material goods, expert time).
                    </p>
                 </div>
            </ExpandableContent>

             <ExpandableContent title="How It Works (v0.1)" subtitle="Manual Matchmaking" icon="⚙️">
                <div class="py-12 px-6">
                    <div class="grid md:grid-cols-2 gap-20 items-center">
                         <div class="space-y-6">
                            <div class="flex items-center gap-6">
                                <span class="font-serif text-3xl text-[var(--color-agedGold)]/30">01</span>
                                <p class="text-sm font-sans tracking-wide text-[var(--color-midnightInk)]/70 uppercase">Identify Need</p>
                            </div>
                            <div class="flex items-center gap-6">
                                <span class="font-serif text-3xl text-[var(--color-agedGold)]/30">02</span>
                                <p class="text-sm font-sans tracking-wide text-[var(--color-midnightInk)]/70 uppercase">Pledge Resource</p>
                            </div>
                             <div class="flex items-center gap-6">
                                <span class="font-serif text-3xl text-[var(--color-agedGold)]/30">03</span>
                                <p class="text-sm font-sans tracking-wide text-[var(--color-midnightInk)]/70 uppercase">Facilitate Transfer</p>
                            </div>
                        </div>
                        <div class="flex flex-col gap-6">
                            <button class="w-full px-10 py-5 bg-[var(--color-agedGold)] text-[var(--color-midnightInk)] font-bold rounded-full shadow-lg hover:shadow-[0_10px_30px_rgba(212,165,116,0.3)] transition-all font-sans text-xs tracking-[0.2em] uppercase">
                                I Have a Need
                            </button>
                            <button class="w-full px-10 py-5 bg-white/20 border border-[var(--color-midnightInk)]/10 text-[var(--color-midnightInk)] font-bold rounded-full hover:bg-white/40 transition-all font-sans text-xs tracking-[0.2em] uppercase">
                                I Can Help
                            </button>
                        </div>
                    </div>
                </div>
            </ExpandableContent>
        </section>
    </div>
</Layout>
