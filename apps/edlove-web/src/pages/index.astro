---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import CinematicBackground from '../components/CinematicBackground.astro';
---

<Layout>
  <Navigation />
  
  <main class="min-h-screen relative overflow-hidden flex flex-col items-center">
    
    <!-- Level 3: The Cinematic Engine (Realism) -->
    <CinematicBackground />

    <!-- Hero Content -->
    <div class="z-10 pt-48 max-w-5xl mx-auto px-6 text-center space-y-12">
      
      <!-- Logo Mark -->
      

      <!-- Main Headline -->
      <h1 class="text-5xl md:text-8xl font-serif text-starlightSilver leading-tight md:leading-[1.1] animate-fade-in opacity-0 drop-shadow-2xl" style="animation-delay: 0.2s;">
        The Educational <br/>
        Paradigm <br/>
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-warmGold via-dawnRose to-cosmicPurple">Cosmos</span>
      </h1>
      
      <!-- Subheadline -->
      <p class="text-xl md:text-2xl font-sans text-skyBlue/80 max-w-3xl mx-auto leading-relaxed animate-fade-in opacity-0 font-light" style="animation-delay: 0.4s;">
        What if the school you know is just one star<br/>in an infinite sky of possibilities?
      </p>

      <!-- CTA -->
      <div class="pt-8 animate-fade-in opacity-0" style="animation-delay: 0.6s;">
        <a 
          href="/sri-lanka" 
          class="group relative inline-flex items-center gap-3 px-12 py-5 border border-warmGold/30 bg-white/5 backdrop-blur-md text-warmGold font-display tracking-widest hover:bg-warmGold/10 hover:text-white hover:border-warmGold transition-all duration-500 rounded-sm shadow-lg hover:shadow-warmGold/20"
        >
          <span>EXPLORE THE CURRENT SYSTEM</span>
          <span class="group-hover:translate-x-1 transition-transform duration-300">→</span>
        </a>
      </div>
    </div>

    <!-- Scroll Indicator -->
    <div class="absolute bottom-10 animate-float opacity-50">
      <svg class="w-6 h-6 text-deepIndigo" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path></svg>
    </div>

  </main>
</Layout>
