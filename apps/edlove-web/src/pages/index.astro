---
import Layout from '../layouts/Layout.astro';
import CinematicBackground from '../components/CinematicBackground.astro';
import FloatingParticles from '../components/FloatingParticles.astro';
---

<Layout>
  <div class="relative z-10 min-h-[calc(100vh-var(--spacing-nav-height))] flex flex-col justify-center items-center px-[var(--space-4)] overflow-hidden">
    <!-- Cinematic Background Video/Gradient -->
    <CinematicBackground showVideo={true} />
    <FloatingParticles />

    <div class="max-w-6xl w-full text-center space-y-[var(--space-6)] animate-fade-in-up">
      
      <div class="space-y-[var(--space-3)]">
        <h1 class="text-6xl md:text-8xl font-heading font-bold text-[var(--color-midnightInk)] leading-none tracking-tighter opacity-90">
          EdLove
        </h1>
        <p class="font-body italic text-xl md:text-3xl text-[var(--color-midnightInk)]/60 tracking-wide max-w-2xl mx-auto">
           Reimagining Education, <span class="text-[var(--color-gold)] font-bold not-italic">With Love.</span>
        </p>
      </div>

      <div class="flex flex-col md:flex-row gap-[var(--space-4)] justify-center items-center pt-[var(--space-4)]">
        <!-- Call to Action -->
        <a href="/cosmos" class="group relative px-10 py-4 bg-[var(--color-midnightInk)] text-[var(--color-warmPaper)] rounded-full overflow-hidden transition-all duration-500 hover:scale-105 hover:shadow-2xl w-full md:w-auto">
          <span class="relative z-10 font-heading text-xs font-bold uppercase tracking-[0.2em] group-hover:tracking-[0.3em] transition-all duration-500">Enter Cosmos</span>
          <div class="absolute inset-0 bg-[var(--color-gold)] translate-y-full group-hover:translate-y-0 transition-transform duration-500 ease-in-out"></div>
        </a>
        
        <!-- Secondary Link -->
        <a href="/about" class="group flex items-center gap-3 px-8 py-4 transition-all duration-300">
           <span class="w-8 h-px bg-[var(--color-midnightInk)]/30 group-hover:w-16 transition-all duration-500"></span>
           <span class="font-body text-lg italic text-[var(--color-midnightInk)]/70 group-hover:text-[var(--color-midnightInk)]">Our Vision</span>
        </a>
      </div>

    </div>

    <!-- Scroll Invitation -->
    <div class="mt-20 opacity-30 animate-bounce">
        <span class="font-heading text-[10px] font-bold uppercase tracking-[0.4em] text-[var(--color-midnightInk)]">Wisdom Below</span>
    </div>
  </div>
</Layout>
