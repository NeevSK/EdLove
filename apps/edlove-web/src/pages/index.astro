---
import Layout from '../layouts/Layout.astro';
import CinematicBackground from '../components/CinematicBackground.astro';
import FloatingParticles from '../components/FloatingParticles.astro';
---

<Layout>
  
  <main class="min-h-screen relative overflow-hidden flex flex-col items-center">
    
    <!-- Level 3: The Cinematic Engine (Realism) -->
    <CinematicBackground showVideo={true} />
    <FloatingParticles />

    <!-- Hero Content -->
    <div class="z-10 max-w-5xl mx-auto px-6 text-center space-y-8 flex flex-col items-center justify-center min-h-screen">
      
      <!-- Logo Mark -->
      

      <!-- Main Headline -->
      <h1 class="text-6xl md:text-9xl font-serif text-[#2D3561] leading-tight md:leading-[1.1] animate-fade-in opacity-0" style="animation-delay: 0.2s;">
        The Educational <br/>
        Paradigm <br/>
        <span class="text-[#D4A574] tracking-widest">Cosmos</span>
      </h1>
      
      <!-- Subheadline -->
      <p class="text-xl md:text-2xl font-sans text-[#2D3561]/80 max-w-3xl mx-auto leading-relaxed animate-fade-in opacity-0 font-light mt-8" style="animation-delay: 0.4s;">
        What if the school you know is just one star<br/>in an infinite sky of possibilities?
      </p>

      <!-- CTA -->
      <div class="animate-fade-in opacity-0" style="animation-delay: 0.6s;">
        <a 
          href="/sri-lanka" 
          class="group relative inline-flex items-center gap-3 px-12 py-5 border-2 border-[#D4A574]/40 bg-white/40 backdrop-blur-xl text-[#2D3561] font-display tracking-widest hover:border-[#D4A574] hover:shadow-[0_0_30px_rgba(212,165,116,0.2)] hover:scale-[1.02] active:scale-[0.98] transition-all duration-300 rounded-sm overflow-hidden"
        >
          <span class="relative z-10">EXPLORE THE CURRENT SYSTEM</span>
          <span class="relative z-10 group-hover:translate-x-2 transition-transform duration-300">→</span>
        </a>
      </div>
    </div>

    <!-- Scroll Indicator -->
    <div class="absolute bottom-10 animate-float opacity-50">
      <svg class="w-6 h-6 text-[#D4A574]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path></svg>
    </div>

  </main>
</Layout>
