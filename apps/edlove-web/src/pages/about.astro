---
import Layout from '../layouts/Layout.astro';
import CinematicBackground from '../components/CinematicBackground.astro';
---

<Layout title="About Us | EdLove">
    <CinematicBackground />
    <section class="relative z-10 min-h-screen flex flex-col justify-center items-center text-center px-6">
        <h1 class="font-serif text-4xl text-[#2D3561] mb-4">About Us</h1>
        <p class="font-sans text-[#2D3561]/70 max-w-2xl">
            EdLove is a collective dedicated to reimagining education through the lens of love, sovereignty, and aesthetic excellence.
        </p>
    </section>
</Layout>
