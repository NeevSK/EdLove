---
import Layout from '../layouts/Layout.astro';
import CinematicBackground from '../components/CinematicBackground.astro';
---

<Layout title="About Us | EdLove">
    <CinematicBackground />
    <div class="relative z-10 pb-24 sanctuary-container">
        <!-- Header: The Origin -->
        <section class="text-center space-y-12 mb-32 animate-fade-in-up">
            <div class="space-y-4">
                <span class="font-sans text-[10px] uppercase tracking-[0.4em] font-bold text-[var(--color-agedGold)] opacity-60">The Genesis</span>
                <h1 class="text-7xl md:text-9xl font-serif text-[var(--color-midnightInk)] leading-none">About EdLove</h1>
            </div>

            <div class="h-px w-24 bg-[var(--color-agedGold)]/30 mx-auto"></div>

            <p class="font-serif text-2xl text-[var(--color-midnightInk)]/50 max-w-2xl mx-auto leading-relaxed italic">
                "A collective dedicated to reimagining education through the lens of love, sovereignty, and aesthetic excellence."
            </p>
        </section>

        <!-- Narrative Flow -->
        <section class="max-w-4xl mx-auto space-y-24 mb-48">
            <div class="space-y-8">
                <h3 class="font-serif text-4xl text-[var(--color-midnightInk)]">Our Vision</h3>
                <p class="font-sans text-xl text-[var(--color-midnightInk)]/60 leading-relaxed font-light">
                    We believe that education is not a product to be consumed, but a relationship to be cultivated. In a world of increasing standardization and extraction, we stand for the dignity of the teacher and the sovereignty of the learner.
                </p>
            </div>

            <div class="h-px w-full bg-[var(--color-midnightInk)]/5"></div>

             <div class="space-y-8">
                <h3 class="font-serif text-4xl text-[var(--color-midnightInk)]">The Sanctuary</h3>
                <p class="font-sans text-xl text-[var(--color-midnightInk)]/60 leading-relaxed font-light">
                    EdLove is more than a platform; it is a digital sanctuary. We use high-end design and soulful technology to create spaces that feel like the forest, not the factory.
                </p>
            </div>
        </section>
    </div>
</Layout>
