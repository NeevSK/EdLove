---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import CinematicBackground from '../../components/CinematicBackground.astro';
import ProvenanceColophon from '../../components/ProvenanceColophon.astro';
import ReadingProgressBar from '../../components/ReadingProgressBar.astro';
import { absoluteUrl } from '../../lib/site';

export async function getStaticPaths() {
  const entries = await getCollection('innovations', ({ data }) => !data.draft);
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const canonical = absoluteUrl(`/innovations/${entry.id}`);
---

<Layout
  title={`${entry.data.title} | EdLove Innovation Dossier`}
  description={`Comprehensive research and architecture dossier on ${entry.data.title}.`}
  canonicalUrl={canonical}
>
  <ReadingProgressBar />
  <CinematicBackground />

  <main class="relative z-10 pb-24 sanctuary-container" style="padding-top: var(--spacing-nav-height);">
    <article class="max-w-[76ch] mx-auto pt-6 sm:pt-10">
      <!-- Breadcrumb Navigation -->
      <nav class="mb-6 flex items-center gap-2 text-xs font-mono text-[var(--color-midnightInk)]/60">
        <a href="/innovations" class="hover:text-[var(--color-gold)] transition-colors">← All Innovation Dossiers</a>
        <span>/</span>
        <span class="text-[var(--color-gold)] font-bold">#{entry.id}</span>
      </nav>

      <header class="mb-10 space-y-4">
        <div class="flex items-center gap-2 text-[11px] font-heading uppercase tracking-[0.25em] font-bold text-[var(--color-gold)]">
          <span>EdLove Innovation Archive</span>
          <span>•</span>
          <span class="font-mono">{entry.id.split('-')[0]}</span>
        </div>

        <h1 class="font-heading text-3xl sm:text-4xl md:text-5xl font-bold text-[var(--color-midnightInk)] leading-[1.14] tracking-tight">
          {entry.data.title}
        </h1>

        <!-- Provenance Drawer -->
        <div class="pt-2">
          <ProvenanceColophon
            author={entry.data.author}
            scribe={entry.data.scribe}
            publishDate={entry.data.created}
            updatedDate={entry.data.updated}
            cadence="living-document"
            version="Dossier v1.0"
            license="Open Knowledge Commons"
            canonicalUrl={canonical}
            customNote="Archived under EdLove Global Innovation Research Repository."
          />
        </div>

        <!-- Tag List -->
        {entry.data.tags && entry.data.tags.length > 0 && (
          <div class="flex flex-wrap gap-2 pt-2">
            {entry.data.tags.map((tag) => (
              <span class="rounded-lg bg-black/5 px-2.5 py-1 text-xs font-mono text-[var(--color-midnightInk)]/80">
                #{tag}
              </span>
            ))}
          </div>
        )}
      </header>

      <!-- Markdown Prose Body -->
      <div class="prose prose-base sm:prose-lg max-w-none text-[var(--color-midnightInk)]/90 font-body leading-relaxed prose-headings:font-heading prose-headings:text-[var(--color-midnightInk)] prose-h1:hidden prose-h2:text-2xl prose-h2:mt-10 prose-h2:mb-4 prose-h3:text-xl prose-p:my-5 prose-blockquote:border-[var(--color-gold)] prose-blockquote:bg-[var(--color-gold)]/5 prose-blockquote:p-4 prose-blockquote:rounded-xl prose-img:rounded-3xl prose-pre:rounded-2xl">
        <Content />
      </div>

      <!-- Footer Navigation -->
      <div class="mt-16 pt-8 border-t border-black/10 flex justify-between items-center text-sm">
        <a href="/innovations" class="font-medium text-[var(--color-gold)] hover:underline">
          ← Back to Dossier Archive
        </a>
        <a href="#top" class="font-mono text-xs text-[var(--color-midnightInk)]/60 hover:text-[var(--color-midnightInk)]">
          ↑ Back to Top
        </a>
      </div>
    </article>
  </main>
</Layout>
