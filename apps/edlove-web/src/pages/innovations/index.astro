---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import CinematicBackground from '../../components/CinematicBackground.astro';

const allInnovations = await getCollection('innovations', ({ data }) => !data.draft);
allInnovations.sort((a, b) => a.id.localeCompare(b.id));

// Extract all unique tags
const allTags = Array.from(
  new Set(allInnovations.flatMap((entry) => entry.data.tags || []))
).sort();
---

<Layout
  title="Global Innovation Dossiers (100+) | EdLove Ecosystem"
  description="A comprehensive living archive of 200 planetary educational technology innovations, non-formal learning paradigms, and gift-economy platforms."
  canonicalUrl="https://edlove.org/innovations"
>
  <CinematicBackground />

  <main class="relative z-10 pb-24 sanctuary-container" style="padding-top: var(--spacing-nav-height);">
    <!-- Hero Header -->
    <header class="py-12 sm:py-16 text-center max-w-4xl mx-auto space-y-4">
      <div class="inline-flex items-center gap-2 rounded-full border border-[var(--color-gold)]/30 bg-[var(--color-gold)]/10 px-3.5 py-1 text-xs font-mono font-bold uppercase tracking-widest text-[var(--color-gold)]">
        <span>✦</span>
        <span>Living Knowledge Archive</span>
      </div>
      <h1 class="font-heading text-4xl sm:text-5xl md:text-6xl font-bold text-[var(--color-midnightInk)] tracking-tight">
        Global Innovation Dossiers
      </h1>
      <p class="font-body text-lg sm:text-xl text-[var(--color-midnightInk)]/80 leading-relaxed max-w-2xl mx-auto font-light italic">
        An empirical survey of 200 planetary educational breakthroughs across gift economies, local-first software, contemplative technopedagogy, and indigenous knowledge networks.
      </p>

      <!-- Instant Live Filter Search Input -->
      <div class="pt-6 max-w-xl mx-auto">
        <div class="relative">
          <input
            type="search"
            id="innovation-search"
            placeholder="Search 200 dossiers (e.g. Plan Ceibal, Scratch, Gift Economy, Moodle)..."
            class="w-full rounded-2xl border border-[var(--color-gold)]/30 bg-white/80 px-5 py-3.5 pl-12 text-sm text-[var(--color-midnightInk)] backdrop-blur-md shadow-xs focus:border-[var(--color-gold)] focus:outline-none focus:ring-2 focus:ring-[var(--color-gold)]/20 transition-all font-body"
          />
          <svg class="absolute left-4 top-4 h-4 w-4 text-[var(--color-midnightInk)]/40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="8" />
            <line x1="21" y1="21" x2="16.65" y2="16.65" />
          </svg>
        </div>
      </div>
    </header>

    <!-- Filter Tag Cloud -->
    <div class="mb-10 flex flex-wrap items-center justify-center gap-2 max-w-4xl mx-auto">
      <button
        type="button"
        class="tag-filter-btn active-tag rounded-xl bg-[var(--color-midnightInk)] px-3 py-1.5 text-xs font-medium text-white transition-all cursor-pointer"
        data-tag="all"
      >
        All ({allInnovations.length})
      </button>
      {allTags.slice(0, 14).map((tag) => (
        <button
          type="button"
          class="tag-filter-btn rounded-xl bg-black/5 px-3 py-1.5 text-xs font-medium text-[var(--color-midnightInk)] hover:bg-[var(--color-gold)]/20 transition-all cursor-pointer"
          data-tag={tag}
        >
          #{tag}
        </button>
      ))}
    </div>

    <!-- Innovations Grid -->
    <div id="innovations-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {allInnovations.map((entry) => (
        <a
          href={`/innovations/${entry.id}`}
          class="innovation-card group relative flex flex-col justify-between rounded-3xl border border-black/5 bg-white/60 p-6 backdrop-blur-md transition-all duration-300 hover:border-[var(--color-gold)]/60 hover:shadow-lg hover:-translate-y-1 overflow-hidden"
          data-title={entry.data.title.toLowerCase()}
          data-tags={(entry.data.tags || []).join(',').toLowerCase()}
          data-id={entry.id}
        >
          <div class="space-y-3">
            <div class="flex items-center justify-between gap-2">
              <span class="font-mono text-xs font-bold text-[var(--color-gold)] tracking-wider">
                #{entry.id.split('-')[0]}
              </span>
              <span class="rounded-full bg-emerald-500/10 px-2 py-0.5 text-[10px] font-bold text-emerald-800 border border-emerald-500/20">
                Active Dossier
              </span>
            </div>

            <h2 class="font-heading text-xl font-bold text-[var(--color-midnightInk)] leading-snug group-hover:text-[var(--color-gold)] transition-colors">
              {entry.data.title.replace(/^Innovation Dossier:\s*/, '')}
            </h2>
          </div>

          <div class="mt-6 pt-4 border-t border-black/5 flex flex-wrap items-center justify-between gap-2 text-xs">
            <div class="flex flex-wrap gap-1.5">
              {(entry.data.tags || []).slice(0, 2).map((tag) => (
                <span class="rounded-md bg-black/5 px-2 py-0.5 text-[10px] font-mono text-[var(--color-midnightInk)]/70">
                  #{tag}
                </span>
              ))}
            </div>
            <span class="font-medium text-[var(--color-gold)] group-hover:translate-x-1 transition-transform">
              Read Dossier →
            </span>
          </div>
        </a>
      ))}
    </div>

    <div id="no-results" class="hidden py-16 text-center text-[var(--color-midnightInk)]/60">
      <p class="font-serif italic text-lg">No matching innovation dossiers found.</p>
    </div>
  </main>
</Layout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const searchInput = document.getElementById('innovation-search');
    const cards = document.querySelectorAll('.innovation-card');
    const noResults = document.getElementById('no-results');
    const tagBtns = document.querySelectorAll('.tag-filter-btn');

    let currentTag = 'all';
    let currentQuery = '';

    function filterCards() {
      let visibleCount = 0;
      cards.forEach((card) => {
        const title = card.getAttribute('data-title') || '';
        const tags = card.getAttribute('data-tags') || '';
        const id = card.getAttribute('data-id') || '';

        const matchesQuery = !currentQuery || title.includes(currentQuery) || tags.includes(currentQuery) || id.includes(currentQuery);
        const matchesTag = currentTag === 'all' || tags.includes(currentTag);

        if (matchesQuery && matchesTag) {
          card.classList.remove('hidden');
          visibleCount++;
        } else {
          card.classList.add('hidden');
        }
      });

      if (visibleCount === 0) {
        noResults?.classList.remove('hidden');
      } else {
        noResults?.classList.add('hidden');
      }
    }

    searchInput?.addEventListener('input', (e) => {
      currentQuery = e.target.value.trim().toLowerCase();
      filterCards();
    });

    tagBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        tagBtns.forEach((b) => {
          b.classList.remove('bg-[var(--color-midnightInk)]', 'text-white');
          b.classList.add('bg-black/5', 'text-[var(--color-midnightInk)]');
        });
        btn.classList.add('bg-[var(--color-midnightInk)]', 'text-white');
        btn.classList.remove('bg-black/5', 'text-[var(--color-midnightInk)]');
        currentTag = btn.getAttribute('data-tag') || 'all';
        filterCards();
      });
    });
  });
</script>
