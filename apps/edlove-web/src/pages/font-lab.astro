  <!-- Client-side Interactive Script for Sandbox -->
  <script is:inline>
    (function() {
      var quoteEl = document.getElementById('sandbox-quote');
      var cardEl = document.getElementById('sandbox-card');
      var labelTracking = document.getElementById('label-tracking');
      var labelLeading = document.getElementById('label-leading');
      var labelWord = document.getElementById('label-word');
      var labelGap = document.getElementById('label-gap');
      var cssReadout = document.getElementById('live-css-readout');

      var currentTracking = '0.022em';
      var currentLeading = '1.75';
      var currentWord = 'normal';
      var currentGap = '20px';

      function updateUI() {
        if (!quoteEl || !cardEl) return;
        quoteEl.style.letterSpacing = currentTracking;
        quoteEl.style.lineHeight = currentLeading;
        quoteEl.style.wordSpacing = currentWord;
        cardEl.style.gap = currentGap;

        if (labelTracking) labelTracking.textContent = currentTracking;
        if (labelLeading) labelLeading.textContent = currentLeading;
        if (labelWord) labelWord.textContent = currentWord;
        if (labelGap) labelGap.textContent = currentGap;

        if (cssReadout) {
          cssReadout.textContent = 'letter-spacing: ' + currentTracking + '; line-height: ' + currentLeading + '; gap: ' + currentGap + ';';
        }
      }

      function setActiveBtn(groupClass, activeBtn) {
        document.querySelectorAll('.' + groupClass).forEach(function(btn) {
          btn.classList.remove('bg-[var(--color-primaryInk)]', 'text-white', 'font-bold');
          btn.classList.add('border-gray-300', 'hover:bg-gray-100');
        });
        activeBtn.classList.add('bg-[var(--color-primaryInk)]', 'text-white', 'font-bold');
        activeBtn.classList.remove('border-gray-300', 'hover:bg-gray-100');
      }

      document.querySelectorAll('.ctrl-tracking').forEach(function(btn) {
        btn.addEventListener('click', function() {
          currentTracking = this.getAttribute('data-val');
          setActiveBtn('ctrl-tracking', this);
          updateUI();
        });
      });

      document.querySelectorAll('.ctrl-leading').forEach(function(btn) {
        btn.addEventListener('click', function() {
          currentLeading = this.getAttribute('data-val');
          setActiveBtn('ctrl-leading', this);
          updateUI();
        });
      });

      document.querySelectorAll('.ctrl-word').forEach(function(btn) {
        btn.addEventListener('click', function() {
          currentWord = this.getAttribute('data-val');
          setActiveBtn('ctrl-word', this);
          updateUI();
        });
      });

      document.querySelectorAll('.ctrl-gap').forEach(function(btn) {
        btn.addEventListener('click', function() {
          currentGap = this.getAttribute('data-val');
          setActiveBtn('ctrl-gap', this);
          updateUI();
        });
      });

      updateUI();
    })();
  </script>
