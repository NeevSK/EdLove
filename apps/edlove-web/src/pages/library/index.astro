---
import Layout from '../../layouts/Layout.astro';
import CinematicBackground from '../../components/CinematicBackground.astro';
import ExpandableContent from '../../components/ExpandableContent.astro';
---

<Layout title="The Library | EdLove">
    <CinematicBackground />

    <main class="relative z-10 pb-24 sanctuary-container" style="padding-top: var(--spacing-nav-height);">
        <!-- Header: The Core -->
        <section class="text-center space-y-12 mb-32 animate-fade-in-up">
            <div class="space-y-4">
                <span class="font-sans text-[10px] uppercase tracking-[0.4em] font-bold text-[var(--color-agedGold)] opacity-60">Domain VI</span>
                <h1 class="text-7xl md:text-9xl font-serif text-[var(--color-midnightInk)] leading-none">The Epistemic Core</h1>
            </div>

            <div class="h-px w-24 bg-[var(--color-agedGold)]/30 mx-auto"></div>

            <p class="font-serif text-2xl text-[var(--color-midnightInk)]/50 max-w-3xl mx-auto leading-relaxed italic">
                "Where we explore the temporal dimensions of wisdom. <br/> From ancient history to the future of cognition."
            </p>
        </section>

        <!-- Featured Reflection -->
        <section class="max-w-4xl mx-auto mb-32">
             <div class="floating-pill p-12 border border-[var(--color-agedGold)]/20 flex flex-col md:flex-row items-center gap-12 group">
                <div class="text-7xl group-hover:scale-110 transition-transform duration-700">⚡</div>
                <div class="space-y-4">
                    <span class="font-sans text-[10px] uppercase tracking-widest font-bold text-[var(--color-agedGold)]">Deep Thought</span>
                    <h3 class="font-serif text-4xl text-[var(--color-midnightInk)]">The Resonant Student</h3>
                    <p class="font-sans text-[var(--color-midnightInk)]/60 leading-relaxed font-light">
                        Exploring the physics of "Teaning"—matching impedance between teacher and student in a high-noise administrative environment.
                    </p>
                </div>
             </div>
        </section>

        <!-- The Collection -->
        <section class="max-w-4xl mx-auto space-y-16">
            <ExpandableContent title="Thinkers" subtitle="The Giants" icon="🧠">
                <div class="py-6 space-y-8 text-[var(--color-midnightInk)]/80">
                    <p class="text-2xl font-serif text-[var(--color-agedGold)] italic">"We climb on the shoulders of giants."</p>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
                        <div class="space-y-3">
                            <strong class="font-serif text-xl block">Maria Montessori</strong>
                            <p class="text-sm border-l border-[var(--color-agedGold)]/20 pl-4">Discovering that freedom within limits leads to profound inner discipline.</p>
                        </div>
                        <div class="space-y-3">
                            <strong class="font-serif text-xl block">Paulo Freire</strong>
                            <p class="text-sm border-l border-[var(--color-agedGold)]/20 pl-4">Education as the practice of freedom vs. education as domestication.</p>
                        </div>
                    </div>
                </div>
            </ExpandableContent>
            
            <ExpandableContent title="Frameworks" subtitle="Mental Models" icon="📐">
                <div class="py-6 space-y-6 text-[var(--color-midnightInk)]/80">
                    <p class="text-2xl font-serif text-[var(--color-agedGold)] italic">"The Maps of Meaning."</p>
                    <p>Using structural analysis to understand the complexity of schools, brains, and societies. From Integral Theory to Systems Thinking.</p>
                </div>
            </ExpandableContent>

            <ExpandableContent title="Stories" subtitle="Narratives of Change" icon="📖">
                <div class="py-6 space-y-6 text-[var(--color-midnightInk)]/80">
                    <p>Case studies of experiments that broke the mold. Documentation of schools where sovereignty was restored.</p>
                </div>
            </ExpandableContent>
        </section>
    </main>
</Layout>
