---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import CinematicBackground from '../../components/CinematicBackground.astro';
import ProvenanceColophon from '../../components/ProvenanceColophon.astro';
import { absoluteUrl } from '../../lib/site';

export async function getStaticPaths() {
  const entries = await getCollection('library', ({ data }) => !data.draft && (data.contentKind !== 'translation' || data.translationStatus === 'approved'));
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const versions = await getCollection('library', ({ data }) => !data.draft && (data.contentKind !== 'translation' || data.translationStatus === 'approved') && data.workId === entry.data.workId);
const alternateLanguages = versions.map((version) => ({
  lang: version.data.language,
  href: absoluteUrl(`/library/${version.id}`),
}));
const { Content } = await render(entry);
const canonical = entry.data.canonicalUrl ?? absoluteUrl(`/library/${entry.id}`);
const cadenceMap = {
  framework: 'perennial',
  thinker: 'perennial',
  manifesto: 'perennial',
  diagnostic: 'diagnostic',
  pattern: 'living-document',
} as const;
const cadence = cadenceMap[entry.data.category] ?? 'living-document';
---

<Layout title={`${entry.data.title} | EdLove Library`} description={entry.data.subtitle} ogType="article" alternateLanguages={alternateLanguages}>
  <CinematicBackground />
  <main class="relative z-10 pb-24 sanctuary-container" style="padding-top: var(--spacing-nav-height);">
    <article class="max-w-[68ch] mx-auto pt-6">
      <header class="mb-12 space-y-4">
        <p class="font-heading text-xs uppercase tracking-[0.3em] font-bold text-[var(--color-gold)]">{entry.data.category} · {entry.data.language}</p>
        <h1 class="font-heading text-4xl md:text-5xl font-bold text-[var(--color-midnightInk)] leading-tight">{entry.data.title}</h1>
        {entry.data.subtitle && <p class="font-body text-xl text-[var(--color-midnightInk)]/70 italic leading-relaxed">{entry.data.subtitle}</p>}
        <div class="pt-2">
          <ProvenanceColophon
            cadence={cadence}
            author={entry.data.author}
            createdDate={entry.data.publishDate}
            updatedDate={entry.data.updatedDate}
            version={entry.data.language.toUpperCase()}
            canonicalUrl={canonical}
            license={entry.data.license}
            translationStatus={entry.data.translationStatus}
            customNote={`Archived entry in EdLove Pedagogical Library (${entry.data.category}).`}
          />
        </div>
      </header>
      <div class="prose prose-base sm:prose-lg max-w-none text-[var(--color-midnightInk)]/90 font-body leading-relaxed prose-headings:font-heading prose-headings:text-[var(--color-midnightInk)] prose-h2:text-2xl prose-h2:mt-10 prose-h2:mb-4 prose-h3:text-xl prose-p:my-5 prose-blockquote:border-[var(--color-gold)] prose-img:rounded-3xl prose-figcaption:text-center prose-figcaption:italic prose-figcaption:opacity-75"><Content /></div>
    </article>
  </main>
</Layout>
