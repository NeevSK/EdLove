---
import Layout from '../layouts/Layout.astro';
import CinematicBackground from '../components/CinematicBackground.astro';
---

<Layout title="Privacy Policy | EdLove">
    <CinematicBackground />
    <section class="relative z-10 min-h-screen flex flex-col justify-center items-center text-center px-6">
        <h1 class="font-serif text-4xl text-[#F5F1E8] mb-4">Privacy Policy</h1>
        <p class="font-sans text-[#F5F1E8]/70 max-w-2xl">
            We believe in data sovereignty. We do not track you, sell your data, or compromise your digital dignity.
            Full policy coming soon.
        </p>
    </section>
</Layout>
