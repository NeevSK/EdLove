---

<Layout title="Privacy Policy | EdLove">
    <CinematicBackground />
    <div class="relative z-10 pb-24 sanctuary-container">
        <!-- Header: The Covenant -->
        <section class="text-center space-y-12 mb-32 animate-fade-in-up">
            <div class="space-y-4">
                <span class="font-sans text-[10px] uppercase tracking-[0.4em] font-bold text-[#D4A574] opacity-60">The Covenant</span>
                <h1 class="text-5xl md:text-7xl font-serif text-[#2D3561] leading-none">Privacy Policy</h1>
            </div>

            <div class="h-px w-24 bg-[#D4A574]/30 mx-auto"></div>

            <p class="font-serif text-2xl text-[#2D3561]/50 max-w-2xl mx-auto leading-relaxed italic">
                "We believe in data sovereignty. <br/> We do not track you, sell your data, or compromise your digital dignity."
            </p>
        </section>

        <!-- Content -->
        <section class="max-w-4xl mx-auto space-y-12 text-center text-[#2D3561]/60 font-sans text-xl leading-relaxed">
            <p>Full policy documentation is being drafted in accordance with our core principles of transparency and love.</p>
        </section>
    </div>
</Layout>
