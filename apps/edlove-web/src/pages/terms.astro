---
import Layout from '../layouts/Layout.astro';
import CinematicBackground from '../components/CinematicBackground.astro';
---

<Layout title="Terms of Use | EdLove">
    <CinematicBackground />
    <div class="relative z-10 pb-24 sanctuary-container">
        <!-- Header: The Accord -->
        <section class="text-center space-y-12 mb-32 animate-fade-in-up">
            <div class="space-y-4">
                <span class="font-sans text-[10px] uppercase tracking-[0.4em] font-bold text-[#D4A574] opacity-60">The Accord</span>
                <h1 class="text-7xl md:text-9xl font-serif text-[#2D3561] leading-none">Terms of Use</h1>
            </div>

            <div class="h-px w-24 bg-[#D4A574]/30 mx-auto"></div>

            <p class="font-serif text-2xl text-[#2D3561]/50 max-w-2xl mx-auto leading-relaxed italic">
                "By using this sanctuary, you agree to treat the community and content with respect and kindness."
            </p>
        </section>

        <!-- Content -->
        <section class="max-w-4xl mx-auto space-y-12 text-center text-[#2D3561]/60 font-sans text-xl leading-relaxed">
            <p>Our terms are simple: Honor the sanctity of the classroom and the sovereignty of the individual.</p>
        </section>
    </div>
</Layout>
