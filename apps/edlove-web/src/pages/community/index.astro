---
import Layout from '../../layouts/Layout.astro';
import CinematicBackground from '../../components/CinematicBackground.astro';
import ExpandableContent from '../../components/ExpandableContent.astro';
import { getCollection, render } from 'astro:content';

const communityEntries = await getCollection('community', ({ data }) => !data.draft);
communityEntries.sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));
---

<Layout title="The Sangha | EdLove">
    <CinematicBackground />

    <div class="relative z-10 pb-24 sanctuary-container" style="padding-top: var(--spacing-nav-height);">
        <!-- Header: The Sangha -->
        <section class="text-center space-y-12 mb-32 animate-fade-in-up">
            <div class="space-y-4">
                <span class="font-heading text-[10px] uppercase tracking-[0.4em] font-bold text-[var(--color-gold)] opacity-60">Domain V</span>
                <h1 class="text-6xl md:text-8xl font-heading font-bold text-[var(--color-midnightInk)] leading-none">The Sangha</h1>
            </div>

            <div class="h-px w-24 bg-[var(--color-gold)]/30 mx-auto"></div>

            <p class="font-body text-2xl text-[var(--color-midnightInk)]/50 max-w-2xl mx-auto leading-relaxed italic">
                "A horizontal network of trust. <br/> We heal and grow in community."
            </p>
        </section>

        <!-- Dynamic Content -->
        <section class="max-w-4xl mx-auto space-y-24">
            <div class="space-y-16">
                {communityEntries.map(async (entry) => {
                    const { Content } = await render(entry);
                    return (
                        <ExpandableContent 
                            title={entry.data.title} 
                            subtitle={entry.data.subtitle} 
                            icon={entry.data.icon}
                        >
                            <div class="py-6 space-y-6 text-[var(--color-midnightInk)]/80 prose prose-slate max-w-none">
                                 <Content />
                            </div>
                        </ExpandableContent>
                    );
                })}
            </div>

            <!-- Join the Founders (Stays as static CTA) -->
            <ExpandableContent title="Join the Founders" subtitle="The Private Circle" icon="💬">
                <div class="py-12 text-center space-y-10">
                    <p class="text-2xl font-heading font-bold text-[var(--color-midnightInk)]">Be part of the first cohort.</p>
                    <p class="max-w-sm mx-auto font-body text-[var(--color-midnightInk)]/50 leading-relaxed">We are currently in a sacred beta phase, building the foundations of a decolonized network.</p>
                    
                    <div class="flex flex-col md:flex-row items-center justify-center gap-6 pt-4">
                        <a href="#" class="inline-flex items-center gap-4 px-10 py-4 bg-[var(--color-midnightInk)] text-[var(--color-warmPaper)] rounded-full transition-all hover:scale-105 shadow-xl font-heading text-xs uppercase tracking-widest font-bold">
                             Join the Digital Sangha
                        </a>
                        <a href="/resources" class="inline-flex items-center gap-4 px-10 py-4 bg-white/20 hover:bg-white/40 border border-[var(--color-midnightInk)]/10 text-[var(--color-midnightInk)] rounded-full transition-all hover:scale-105 shadow-sm font-heading text-xs uppercase tracking-widest font-bold">
                            Looking for Tools?
                       </a>
                    </div>
                </div>
            </ExpandableContent>
        </section>
    </div>
</Layout>
