---
import Layout from '../../layouts/Layout.astro';
import CinematicBackground from '../../components/CinematicBackground.astro';
import ExpandableContent from '../../components/ExpandableContent.astro';
---

<Layout title="The Sangha | EdLove">
    <CinematicBackground />

    <section class="relative z-10 min-h-screen flex flex-col justify-center items-center text-center px-6 pt-24">
        <h1 class="font-cinzel text-warmGold text-xl md:text-2xl tracking-[0.2em] uppercase mb-4">Domain V</h1>
        <h2 class="font-serif text-5xl md:text-7xl text-[#2D3561] mb-8">The Sangha</h2>
        
        <div class="w-full max-w-4xl mx-auto space-y-4 text-left mb-16">
            <!-- Center Modal Trigger -->
            <ExpandableContent title="Core Principles" subtitle="Our Code" icon="🛡️" mode="modal">
                <div class="text-center">
                    <p class="text-2xl font-serif text-[#D4A574] mb-6">The Code of the Sangha</p>
                    <p class="mb-4">Community is not just a gathering of bodies; it is an alignment of hearts. To be here is to agree to a higher standard of interaction.</p>
                    
                    <ul class="text-left font-sans text-lg text-[#2D3561]/80 space-y-4 max-w-xl mx-auto bg-white/40 p-8 rounded-xl border border-[#2D3561]/10">
                        <li class="flex gap-4"><span class="text-[#D4A574] text-xl">01</span> <strong>Kindness is non-negotiable.</strong> We critique ideas, never people.</li>
                        <li class="flex gap-4"><span class="text-[#D4A574] text-xl">02</span> <strong>Wisdom, not performance.</strong> We are here to learn, not to show how smart we are.</li>
                        <li class="flex gap-4"><span class="text-[#D4A574] text-xl">03</span> <strong>Sovereignty.</strong> We respect each member's autonomy and journey.</li>
                    </ul>
                </div>
            </ExpandableContent>

             <ExpandableContent title="Join the Founders" subtitle="Discord Community" icon="💬" mode="modal">
                <div class="text-center">
                    <p class="mb-6 text-xl">Be part of the first cohort of educators and dreamers.</p>
                    <p class="mb-8 text-sm opacity-60">We are currently in a closed beta phase for the community discord.</p>
                    <a href="#" class="inline-flex items-center gap-2 px-8 py-4 bg-[#5865F2] hover:bg-[#4752C4] text-white rounded-xl transition-colors font-bold text-lg shadow-xl">
                         <span class="text-2xl">💬</span> Join Discord Server
                    </a>
                </div>
            </ExpandableContent>
        </div>
    </section>
</Layout>
