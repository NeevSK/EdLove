---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import CinematicBackground from '../../components/CinematicBackground.astro';
import ExpandableContent from '../../components/ExpandableContent.astro';

const gurudeviEntries = await getCollection('gurudevi', ({ data }) => !data.draft);
gurudeviEntries.sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));
---

<Layout title="Gurudevi | The Divine Teacher">
    <CinematicBackground />

    <main class="relative z-10 pb-24 sanctuary-container" style="padding-top: var(--spacing-nav-height);">
        <!-- Hero: The Divine Mark -->
        <section class="text-center space-y-6 mb-24 animate-fade-in-up">
            <div class="inline-flex items-center gap-4 px-6 py-2 rounded-full border border-[var(--color-gold)]/20 bg-white/40 shadow-sm backdrop-blur-md">
                <span class="text-xl animate-pulse">🪷</span>
                <span class="font-heading text-[9px] uppercase tracking-[0.4em] font-bold text-[var(--color-gold)]">The Divine Sanctuary</span>
            </div>

            <div class="space-y-3">
                <h1 class="text-5xl md:text-7xl font-heading font-bold text-[var(--color-midnightInk)] leading-none opacity-90">Gurudevi</h1>
                <p class="font-body italic text-xl md:text-2xl text-[var(--color-midnightInk)]/60">"For the hands that hold the future."</p>
            </div>

            <div class="h-px w-16 bg-[var(--color-gold)]/20 mx-auto"></div>

            <p class="font-body text-xl text-[var(--color-midnightInk)]/50 max-w-2xl mx-auto leading-relaxed">
                A digital sanctuary built solely for the dignity and sovereignty of Sri Lankan teachers.
            </p>

            <!-- Primary CTA -->
            <div class="pt-6 animate-fade-in-up delay-300">
                <a 
                    href="https://gurudevi.edlove.org" 
                    target="_blank" 
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-4 bg-[var(--color-midnightInk)] text-[var(--color-warmPaper)] px-10 py-4 rounded-full shadow-2xl hover:scale-105 hover:bg-[var(--color-gold)] hover:text-[var(--color-midnightInk)] transition-all duration-500 group"
                >
                    <span class="font-heading text-xs font-bold uppercase tracking-widest">Visit Gurudevi</span>
                    <span class="group-hover:translate-x-1 transition-transform">→</span>
                </a>
            </div>
        </section>

        <!-- Dynamic Pillars -->
        <section class="max-w-4xl mx-auto space-y-20 mb-48 pt-32">
            <h2 class="font-heading font-bold text-5xl text-center text-[var(--color-midnightInk)] mb-24 opacity-80">The Pillars of Sanctuary</h2>
            
            <div class="space-y-12">
                {gurudeviEntries.map(async (entry) => {
                    const { Content } = await render(entry);
                    return (
                        <ExpandableContent 
                            title={entry.data.title} 
                            subtitle={entry.data.subtitle} 
                            icon={entry.data.icon}
                        >
                            <div class="py-6 space-y-6 text-[var(--color-midnightInk)]/80 prose prose-slate max-w-none">
                                 <Content />
                            </div>
                        </ExpandableContent>
                    );
                })}
            </div>
        </section>

        <!-- Teaning: The Energy Section (Remains as a specialized high-fidelity section) -->
        <section class="max-w-6xl mx-auto mb-48">
             <div class="floating-pill p-12 md:p-24 border border-[var(--color-gold)]/10 overflow-hidden relative group">
                <div class="absolute top-0 right-0 w-[600px] h-[600px] bg-[var(--color-gold)]/5 rounded-full blur-[120px] -translate-y-1/2 translate-x-1/2 group-hover:bg-[var(--color-gold)]/10 transition-colors duration-1000"></div>
                
                <div class="relative z-10 grid md:grid-cols-2 gap-20 items-center">
                    <div class="space-y-8">
                        <span class="text-[10px] uppercase tracking-[0.4em] font-bold text-[var(--color-gold)] opacity-60">The Epistemology</span>
                        <h3 class="text-6xl font-heading font-bold text-[var(--color-midnightInk)]">The Art of Teaning</h3>
                        <p class="font-body text-xl text-[var(--color-midnightInk)]/60 leading-relaxed font-light">
                             Education is not a transaction; it is a resonance. "Teaning" captures the impedance-matched circuit where teaching and learning dissolve into a single flow of becoming.
                        </p>
                    </div>
                    <div class="flex flex-col items-center justify-center p-12 rounded-full border border-[var(--color-gold)]/20 aspect-square text-center space-y-4 bg-white/20">
                         <span class="text-7xl">⚡</span>
                         <span class="font-heading font-bold text-2xl text-[var(--color-gold)] tracking-widest">Energy Flow</span>
                    </div>
                </div>
             </div>
        </section>

        <!-- Waitlist: The Sealed Admission -->
        <section class="max-w-2xl mx-auto text-center space-y-24 mb-32">
            <div class="space-y-12">
                <div class="space-y-4">
                    <h3 class="font-heading font-bold text-4xl text-[var(--color-midnightInk)]">Available for Sanctuary</h3>
                    <p class="font-heading text-xs uppercase tracking-widest text-[var(--color-midnightInk)]/40">Download the portal directly</p>
                </div>
                
                <div class="flex flex-col sm:flex-row items-center justify-center gap-6">
                    <button class="flex items-center gap-4 bg-[#0a0a0a] text-white px-8 py-4 rounded-full shadow-2xl hover:scale-105 transition-all duration-500 group border border-white/5">
                        <svg viewBox="0 0 384 512" class="w-6 h-6 fill-white opacity-80 group-hover:opacity-100"><path d="M318.7 268.7c-.2-36.7 16.4-64.4 50-84.8-18.8-26.9-47.2-41.7-84.7-44.6-35.5-2.8-74.3 20.7-88.5 20.7-15 0-49.4-19.7-76.4-19.7C63.3 141.2 4 184.8 4 273.5q0 39.3 14.4 81.2c12.8 36.7 59 126.7 107.2 125.2 25.2-.6 43-17.9 75.8-17.9 31.8 0 48.3 17.9 76.4 17.9 48.6-.7 90.4-82.5 102.6-119.3-65.2-30.7-61.7-90-61.7-91.9zm-56.6-164.2c27.3-32.4 24.8-61.9 24-72.5-24.1 1.4-52 16.4-67.9 34.9-17.5 19.8-27.8 44.3-25.6 71.9 26.1 2 52.3-11.4 69.5-34.3z"/></svg>
                        <div class="text-left">
                            <div class="text-[8px] uppercase tracking-widest opacity-40">App Store</div>
                            <div class="text-sm font-bold tracking-wide">Download</div>
                        </div>
                    </button>

                    <button class="flex items-center gap-4 bg-[#0a0a0a] text-white px-8 py-4 rounded-full shadow-2xl hover:scale-105 transition-all duration-500 group border border-white/5">
                        <svg viewBox="0 0 512 512" class="w-6 h-6 fill-white opacity-80 group-hover:opacity-100"><path d="M325.3 234.3L104.6 13l280.8 161.2-60.1 60.1zM47 0C34 6.8 25.3 19.2 25.3 35.3v441.3c0 16.1 8.7 28.5 21.7 35.3l256.6-256L47 0zm425.2 225.6l-58.9-34.1-65.7 64.5 65.7 64.5 60.1-34.1c18-14.3 18-46.5-1.2-60.8zM104.6 499l280.8-161.2-60.1-60.1L104.6 499z"/></svg>
                        <div class="text-left">
                            <div class="text-[8px] uppercase tracking-widest opacity-40">Google Play</div>
                            <div class="text-sm font-bold tracking-wide">Download</div>
                        </div>
                    </button>
                </div>
            </div>

            <div class="flex items-center justify-center gap-10">
                <div class="h-px w-16 bg-[var(--color-midnightInk)]/5"></div>
                <span class="font-body italic text-[var(--color-midnightInk)]/30">or</span>
                <div class="h-px w-16 bg-[var(--color-midnightInk)]/5"></div>
            </div>

            <div class="space-y-12">
                <div class="space-y-4">
                    <h3 class="font-heading font-bold text-4xl text-[var(--color-midnightInk)]">The Founding Circle</h3>
                    <p class="font-body text-sm text-[var(--color-midnightInk)]/40 max-w-sm mx-auto">Join the private list for early access and sovereign benefits.</p>
                </div>

                <form class="flex flex-col sm:flex-row gap-4 max-w-md mx-auto" onsubmit="return false;">
                    <input 
                        type="email" 
                        placeholder="your@email.com" 
                        class="flex-grow px-8 py-4 rounded-full bg-white/40 border border-[var(--color-midnightInk)]/10 focus:outline-none focus:border-[var(--color-gold)] transition-colors font-heading text-sm"
                    />
                    <button class="px-10 py-4 bg-[var(--color-gold)] text-[var(--color-midnightInk)] font-bold rounded-full shadow-lg hover:shadow-[0_10px_30px_rgba(231,203,22,0.3)] transition-all font-heading text-sm uppercase tracking-wider">
                        Join
                    </button>
                </form>
            </div>
        </section>
    </main>
</Layout>
