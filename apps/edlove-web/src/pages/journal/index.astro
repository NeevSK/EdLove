---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import CinematicBackground from '../../components/CinematicBackground.astro';
import { absoluteUrl } from '../../lib/site';

const entries = (await getCollection('journal', ({ data }) => !data.draft && (data.contentKind !== 'translation' || data.translationStatus === 'approved')))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'EdLove Journal',
  description: 'Essays, field notes, and reflections from EdLove.',
  url: absoluteUrl('/journal'),
};
---

<Layout title="Journal | EdLove" description="Essays, field notes, and reflections from EdLove." structuredData={structuredData}>
  <div class="relative min-h-screen text-[var(--color-primaryInk)] pt-32 pb-32 overflow-hidden">
    <CinematicBackground />

    <main class="sanctuary-container relative z-10 max-w-4xl mx-auto px-6 sm:px-8 space-y-24">
      
      <!-- Minimalist Header in Pure Typographic Presence -->
      <header class="pt-8 sm:pt-14 space-y-6 text-center animate-fade-in-up">
        <h1 class="text-4xl sm:text-6xl md:text-7xl font-serif font-light text-[var(--color-primaryInk)] tracking-tight leading-[1.08]">
          Ideas for a living education.
        </h1>

        <p class="font-serif italic text-xl sm:text-2xl text-[var(--color-mutedInk)] leading-relaxed max-w-2xl mx-auto">
          Essays, field notes, and reflections on education as a form of love.
        </p>
      </header>

      <!-- Journal Articles List (Unboxed Editorial Stream) -->
      <section class="border-t border-b border-[var(--color-primaryInk)]/12 divide-y divide-[var(--color-primaryInk)]/12" aria-label="Journal articles">
        {entries.map((entry) => (
          <article class="py-12 first:pt-8 last:pb-8 group">
            <a href={`/journal/${entry.id}`} class="block space-y-4">
              <div class="flex flex-wrap items-center gap-3 text-sm font-heading font-semibold text-[var(--color-gold)]">
                <span class="uppercase tracking-wider">{entry.data.language}</span>
                <span class="opacity-40">&middot;</span>
                <time datetime={entry.data.publishDate.toISOString()} class="text-[var(--color-mutedInk)] font-normal">
                  {entry.data.publishDate.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}
                </time>
              </div>

              <h2 class="text-2xl sm:text-4xl font-heading font-bold text-[var(--color-primaryInk)] group-hover:text-[var(--color-secondaryInk)] transition-colors leading-snug">
                {entry.data.title}
              </h2>

              {entry.data.subtitle && (
                <p class="font-serif text-lg sm:text-xl text-[var(--color-secondaryInk)] leading-relaxed">
                  {entry.data.subtitle}
                </p>
              )}

              <div class="pt-2 flex items-center gap-2 text-sm font-heading font-bold text-[var(--color-primaryInk)] group-hover:text-[var(--color-secondaryInk)] transition-colors">
                <span>Read essay</span>
                <span class="group-hover:translate-x-1.5 transition-transform duration-300">&rarr;</span>
              </div>
            </a>
          </article>
        ))}
      </section>

    </main>
  </div>
</Layout>
