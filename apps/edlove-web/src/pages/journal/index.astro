---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import CinematicBackground from '../../components/CinematicBackground.astro';
import { absoluteUrl } from '../../lib/site';

const entries = (await getCollection('journal', ({ data }) => !data.draft && (data.contentKind !== 'translation' || data.translationStatus === 'approved')))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'EdLove Journal',
  description: 'Essays, field notes, and reflections from EdLove.',
  url: absoluteUrl('/journal'),
};
---

<Layout title="Journal | EdLove" description="Essays, field notes, and reflections from EdLove." structuredData={structuredData}>
  <CinematicBackground />
  <main class="relative z-10 pb-24 sanctuary-container" style="padding-top: var(--spacing-nav-height);">
    <section class="max-w-3xl mx-auto mb-16 space-y-5">
      <p class="font-heading text-[10px] uppercase tracking-[0.4em] font-bold text-[var(--color-gold)]">EdLove Journal</p>
      <h1 class="font-heading text-5xl md:text-7xl font-bold text-[var(--color-midnightInk)] leading-tight">Ideas for a living education.</h1>
      <p class="font-body text-xl text-[var(--color-midnightInk)]/60 leading-relaxed">Essays, field notes, and reflections on education as care work.</p>
    </section>
    <section class="max-w-3xl mx-auto space-y-5" aria-label="Journal articles">
      {entries.map((entry) => (
        <a href={`/journal/${entry.id}`} class="block rounded-2xl border border-[var(--color-gold)]/20 bg-white/30 p-6 transition hover:border-[var(--color-gold)]/50 hover:bg-white/50">
          <div class="flex flex-wrap gap-3 text-[10px] uppercase tracking-[0.2em] text-[var(--color-gold)]">
            <span>{entry.data.language}</span>
            <time datetime={entry.data.publishDate.toISOString()}>{entry.data.publishDate.toLocaleDateString('en-GB')}</time>
          </div>
          <h2 class="mt-3 font-heading text-3xl font-bold text-[var(--color-midnightInk)]">{entry.data.title}</h2>
          <p class="mt-2 text-lg text-[var(--color-midnightInk)]/60">{entry.data.subtitle}</p>
          <span class="mt-5 block text-sm text-[var(--color-gold)]">Read the journal entry →</span>
        </a>
      ))}
    </section>
  </main>
</Layout>
