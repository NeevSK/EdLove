---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import CinematicBackground from '../../components/CinematicBackground.astro';
import ProvenanceColophon from '../../components/ProvenanceColophon.astro';
import ArticleCurationBridge from '../../components/ArticleCurationBridge.astro';
import AuthorSyndicateAction from '../../components/AuthorSyndicateAction.astro';
import OutboundDistributionPanel from '../../components/OutboundDistributionPanel.astro';
import ReadingProgressBar from '../../components/ReadingProgressBar.astro';
import { absoluteUrl } from '../../lib/site';

export async function getStaticPaths() {
  const entries = await getCollection('journal', ({ data }) => !data.draft && (data.contentKind !== 'translation' || data.translationStatus === 'approved'));
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const versions = await getCollection('journal', ({ data }) => !data.draft && (data.contentKind !== 'translation' || data.translationStatus === 'approved') && data.workId === entry.data.workId);
const alternateLanguages = versions.map((version) => ({
  lang: version.data.language,
  href: absoluteUrl(`/journal/${version.id}`),
}));
const { Content } = await render(entry);
const canonical = entry.data.canonicalUrl ?? absoluteUrl(`/journal/${entry.id}`);
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: entry.data.title,
  description: entry.data.subtitle,
  author: { '@type': 'Person', name: entry.data.author },
  datePublished: entry.data.publishDate.toISOString(),
  dateModified: entry.data.updatedDate?.toISOString() ?? entry.data.publishDate.toISOString(),
  url: canonical,
  inLanguage: entry.data.language,
};
---

<Layout title={`${entry.data.title} | EdLove Journal`} description={entry.data.subtitle} image={entry.data.heroImage} ogType="article" canonicalUrl={canonical} alternateLanguages={alternateLanguages} structuredData={structuredData}>
  <ReadingProgressBar />
  <CinematicBackground />
  <main class="relative z-10 pb-24 sanctuary-container" style="padding-top: var(--spacing-nav-height);">
    <article class="max-w-[68ch] mx-auto pt-6 sm:pt-10">
      <header class="mb-10 space-y-5">
        <div class="flex items-center gap-2 text-[11px] font-heading uppercase tracking-[0.25em] font-bold text-[var(--color-gold)]">
          <span>EdLove Journal</span>
          <span>•</span>
          <span class="text-[var(--color-midnightInk)]/60 font-mono">{entry.data.language.toUpperCase()}</span>
        </div>
        
        <h1 class="font-heading text-3xl sm:text-4xl md:text-5xl font-bold text-[var(--color-midnightInk)] leading-[1.12] tracking-tight">
          {entry.data.title}
        </h1>
        
        <p class="font-body text-lg sm:text-xl text-[var(--color-midnightInk)]/80 leading-relaxed font-light italic">
          {entry.data.subtitle}
        </p>

        <!-- Sovereign Unified Provenance Colophon (Compact Byline + Expandable Rigor Drawer) -->
        <div class="pt-2">
          <ProvenanceColophon
            author={entry.data.author}
            scribe={entry.data.scribe}
            scribeNote={entry.data.scribeNote}
            publishDate={entry.data.publishDate}
            updatedDate={entry.data.updatedDate}
            cadence="living-document"
            version={entry.data.language.toUpperCase()}
            license={entry.data.license}
            canonicalUrl={canonical}
            readingTime={entry.data.readingTime}
            translationStatus={entry.data.translationStatus}
            language={entry.data.language}
            customNote={`Published in EdLove Journal (${entry.data.contentKind} piece). License: ${entry.data.license}.`}
          />
        </div>

        {(entry.data.contentKind === 'curated' || entry.data.contentKind === 'licensed' || Boolean(entry.data.canonicalUrl && entry.data.canonicalUrl !== canonical)) && (
          <ArticleCurationBridge
            sourcePublication="Gurudevi Journal"
            sourceUrl={entry.data.canonicalUrl ?? entry.data.source}
            contentKind={entry.data.contentKind}
            pedagogicalNote={entry.data.scribeNote}
            author={entry.data.author}
          />
        )}

        <!-- Author On-Demand Syndication Action (Visible in Dev/Editor Mode Only) -->
        {import.meta.env.DEV && entry.data.contentKind === 'original' && (
          <AuthorSyndicateAction
            title={entry.data.title}
            url={canonical}
            targetPublication="gurudevi"
            summary={entry.data.subtitle}
            pedagogicalTakeaway={entry.data.scribeNote}
          />
        )}

        <!-- Outbound Social Distribution Pipeline (Visible in Dev/Reviewer Mode Only) -->
        {import.meta.env.DEV && (
          <OutboundDistributionPanel
            title={entry.data.title}
            url={canonical}
            author={entry.data.author}
            topics={entry.data.topics}
            summary={entry.data.subtitle}
          />
        )}

        {entry.data.heroImage && (
          <div class="my-8 overflow-hidden rounded-3xl border border-black/5 shadow-md max-h-[440px]">
            <img
              src={entry.data.heroImage}
              alt={entry.data.title}
              class="w-full object-cover aspect-[16/9]"
              loading="eager"
            />
          </div>
        )}
      </header>

      <!-- Editorial Body with Drop Cap Initial and Harmonic Prose Rhythm -->
      <div class="prose prose-base sm:prose-lg max-w-none text-[var(--color-midnightInk)]/90 font-body leading-relaxed prose-headings:font-heading prose-headings:text-[var(--color-midnightInk)] prose-h2:text-2xl prose-h2:mt-10 prose-h2:mb-4 prose-h3:text-xl prose-p:my-5 prose-drop-cap prose-blockquote:border-[var(--color-gold)] prose-img:rounded-3xl prose-figcaption:text-center prose-figcaption:italic prose-figcaption:opacity-75">
        <Content />
      </div>
    </article>
  </main>
</Layout>
