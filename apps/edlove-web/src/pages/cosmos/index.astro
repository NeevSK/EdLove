---
import Layout from '../../layouts/Layout.astro';
import CinematicBackground from '../../components/CinematicBackground.astro';
import ExpandableContent from '../../components/ExpandableContent.astro';
import { getCollection, render } from 'astro:content';

const cosmosEntries = await getCollection('cosmos', ({ data }) => !data.draft);
cosmosEntries.sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));
---

<Layout title="The Paradigm Cosmos | EdLove">
    <CinematicBackground />

    <div class="relative z-10 pb-24 sanctuary-container">
        <!-- Header: The Mapping -->
        <section class="text-center space-y-12 mb-32 animate-fade-in-up">
            <div class="space-y-4">
                <span class="font-heading text-[10px] uppercase tracking-[0.4em] font-bold text-[var(--color-gold)] opacity-60">Domain I</span>
                <h1 class="text-6xl md:text-8xl font-heading font-bold text-[var(--color-midnightInk)] leading-none">The Paradigm Cosmos</h1>
            </div>

            <div class="h-px w-24 bg-[var(--color-gold)]/30 mx-auto"></div>

            <p class="font-body text-2xl text-[var(--color-midnightInk)]/50 max-w-2xl mx-auto leading-relaxed italic">
                "We map the constellations of how learning happens. <br/> From the factory floor to the forest floor."
            </p>
        </section>

        <!-- Narrative Flow: The Dynamic Content -->
        <section class="max-w-4xl mx-auto space-y-16">
            {cosmosEntries.map(async (entry) => {
                const { Content } = await render(entry);
                return (
                    <ExpandableContent 
                        title={entry.data.title} 
                        subtitle={entry.data.subtitle} 
                        icon={entry.data.icon}
                    >
                        <div class="py-6 space-y-6 text-[var(--color-midnightInk)]/80 prose prose-slate max-w-none">
                             <Content />
                        </div>
                    </ExpandableContent>
                );
            })}
        </section>
    </div>
</Layout>
