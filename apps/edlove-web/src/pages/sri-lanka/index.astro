---
import Layout from '../../layouts/Layout.astro';
import CinematicBackground from '../../components/CinematicBackground.astro';
import ExpandableContent from '../../components/ExpandableContent.astro';
---

<Layout title="System of Sri Lanka | EdLove">
    <CinematicBackground />

    <section class="relative z-10 min-h-screen flex flex-col justify-center items-center text-center px-6 pt-24 pb-12">
        <h1 class="font-cinzel text-warmGold text-xl md:text-2xl tracking-[0.2em] uppercase mb-4">Domain II</h1>
        <h2 class="font-serif text-5xl md:text-7xl text-[#2D3561] mb-8">System of Sri Lanka</h2>
        <p class="font-sans text-lg md:text-xl text-[#2D3561]/80 max-w-2xl mx-auto leading-relaxed mb-16">
            The ground truth. Diagnostic of the official and shadow structures.
        </p>

        <div class="w-full max-w-4xl mx-auto space-y-4 text-left">
            
            <ExpandableContent title="The Official Structure" subtitle="Ministry & Schools" icon="🏛️">
                <ul class="space-y-3 font-sans text-[#2D3561]/70">
                    <li class="flex items-center gap-3"><span class="text-[#D4A574]">➜</span> Ministry Policies & Frameworks</li>
                    <li class="flex items-center gap-3"><span class="text-[#D4A574]">➜</span> Provincial & Zonal Administration</li>
                    <li class="flex items-center gap-3"><span class="text-[#D4A574]">➜</span> School Heterogeneity (National vs. Provincial)</li>
                </ul>
            </ExpandableContent>

            <ExpandableContent title="The Shadow Structure" subtitle="Tuition & Inequality" icon="🌑">
                <p class="mb-4">The parallel system where the real competition happens.</p>
                <ul class="space-y-3 font-sans text-[#2D3561]/70">
                    <li class="flex items-center gap-3"><span class="text-[#E07A5F]">➜</span> The Tuition Industry (Mass classes)</li>
                    <li class="flex items-center gap-3"><span class="text-[#E07A5F]">➜</span> Socioeconomic Barriers & Access</li>
                    <li class="flex items-center gap-3"><span class="text-[#E07A5F]">➜</span> The Hidden Curriculum of Conformity</li>
                </ul>
            </ExpandableContent>

        </div>
    </section>
</Layout>
