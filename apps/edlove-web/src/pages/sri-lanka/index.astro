---
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';
import { Theme } from '@/constants/Theme';
---

<Layout>
  <Navigation />
  
  <main class="min-h-screen pt-24 pb-16">
    <div class="max-w-6xl mx-auto px-6">
      
      <!-- Hero Section -->
      <div class="text-center mb-16">
        <h1 class="font-heading text-5xl md:text-7xl mb-6" style={`color: ${Theme.colors.emberOrange}`}>
          Sri Lankan Education System
        </h1>
        <p class="font-body text-xl md:text-2xl max-w-3xl mx-auto leading-relaxed" style={`color: ${Theme.colors.deepIndigo}; opacity: 0.8`}>
          Honest truth about how we learn in Sri Lanka. No judgment. Just reality.
        </p>
      </div>

      <!-- Introduction -->
      <div class="prose prose-lg max-w-4xl mx-auto mb-16">
        <p class="font-body text-lg leading-relaxed" style={`color: ${Theme.colors.deepIndigo}`}>
          This is where we map the terrain we know. The Sri Lankan education system—with all its excellence, challenges, contradictions, and possibilities.
        </p>
        <p class="font-body text-lg leading-relaxed" style={`color: ${Theme.colors.deepIndigo}`}>
          <strong>Not to criticize.</strong> Not to celebrate. But to <em>see</em> it clearly. Because you can't transform what you don't understand.
        </p>
      </div>

      <!-- Section Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-16">
        
        <!-- Card 1: The Structure -->
        <div class="border rounded-lg p-8" style={`border-color: ${Theme.colors.emberOrange}; background: ${Theme.colors.softWhite}`}>
          <h3 class="font-heading text-2xl mb-4" style={`color: ${Theme.colors.deepIndigo}`}>
            📊 The Structure
          </h3>
          <p class="font-body mb-4" style={`color: ${Theme.colors.deepIndigo}; opacity: 0.7`}>
            How the system is designed. Schools, exams, curriculum, teacher training. The machinery.
          </p>
          <a href="#" class="font-body text-sm font-medium hover:opacity-70 transition-opacity" style={`color: ${Theme.colors.emberOrange}`}>
            Explore →
          </a>
        </div>

        <!-- Card 2: The Data -->
        <div class="border rounded-lg p-8" style={`border-color: ${Theme.colors.skyBlue}; background: ${Theme.colors.softWhite}`}>
          <h3 class="font-heading text-2xl mb-4" style={`color: ${Theme.colors.deepIndigo}`}>
            📈 The Data
          </h3>
          <p class="font-body mb-4" style={`color: ${Theme.colors.deepIndigo}; opacity: 0.7`}>
            Numbers that tell stories. Enrollment, dropout rates, exam results, resource distribution.
          </p>
          <a href="#" class="font-body text-sm font-medium hover:opacity-70 transition-opacity" style={`color: ${Theme.colors.skyBlue}`}>
            Explore →
          </a>
        </div>

        <!-- Card 3: The Challenges -->
        <div class="border rounded-lg p-8" style={`border-color: ${Theme.colors.dawnRose}; background: ${Theme.colors.softWhite}`}>
          <h3 class="font-heading text-2xl mb-4" style={`color: ${Theme.colors.deepIndigo}`}>
            🔍 The Challenges
          </h3>
          <p class="font-body mb-4" style={`color: ${Theme.colors.deepIndigo}; opacity: 0.7`}>
            Where it hurts. Resource gaps, teacher burnout, assessment pressure, equity issues.
          </p>
          <a href="#" class="font-body text-sm font-medium hover:opacity-70 transition-opacity" style={`color: ${Theme.colors.dawnRose}`}>
            Explore →
          </a>
        </div>

        <!-- Card 4: The Possibilities -->
        <div class="border rounded-lg p-8" style={`border-color: ${Theme.colors.forestGreen}; background: ${Theme.colors.softWhite}`}>
          <h3 class="font-heading text-2xl mb-4" style={`color: ${Theme.colors.deepIndigo}`}>
            ✨ The Possibilities
          </h3>
          <p class="font-body mb-4" style={`color: ${Theme.colors.deepIndigo}; opacity: 0.7`}>
            What could be. Innovations happening quietly. Teachers doing beautiful work. Hope.
          </p>
          <a href="#" class="font-body text-sm font-medium hover:opacity-70 transition-opacity" style={`color: ${Theme.colors.forestGreen}`}>
            Explore →
          </a>
        </div>

      </div>

      <!-- Call to Action -->
      <div class="text-center mt-16 p-8 rounded-lg" style={`background: ${Theme.colors.starlightSilver}`}>
        <p class="font-body text-lg mb-4" style={`color: ${Theme.colors.deepIndigo}`}>
          <strong>Know the data? Have a story?</strong>
        </p>
        <p class="font-body mb-6" style={`color: ${Theme.colors.deepIndigo}; opacity: 0.7`}>
          Help us make this map more accurate. We need teachers, students, parents, researchers—everyone who knows this system from the inside.
        </p>
        <a href="/community" class="inline-block px-8 py-3 rounded-sm font-body font-medium hover:opacity-80 transition-opacity" style={`background: ${Theme.colors.emberOrange}; color: ${Theme.colors.softWhite}`}>
          Contribute →
        </a>
      </div>

    </div>
  </main>
</Layout>
