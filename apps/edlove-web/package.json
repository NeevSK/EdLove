{
  "name": "apps-edlove-web",
  "type": "module",
  "version": "0.0.2",
  "scripts": {
    "dev": "pnpm exec astro dev",
    "build": "pnpm exec astro build",
    "preview": "pnpm exec astro preview",
    "astro": "pnpm exec astro",
    "lint": "pnpm run lint:biome && pnpm run lint:eslint",
    "check-types": "pnpm exec tsc --noEmit",
    "lint:biome": "biome check .",
    "lint:eslint": "eslint .",
    "format": "biome format --write .",
    "check-cycles": "node ../../scripts/refactor/sovereign-cycle-checker.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "clean": "rm -rf .turbo node_modules dist"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.8",
    "@astrojs/sitemap": "^3.6.0",
    "@astrojs/svelte": "^8.0.5",
    "@tailwindcss/vite": "^4.1.18",
    "@types/three": "^0.182.0",
    "astro": "^6.1.7",
    "svelte": "^5.55.4",
    "tailwindcss": "^4.1.18",
    "three": "^0.182.0",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:^",
    "@repo/typescript-config": "workspace:*",
    "vitest": "^2.1.9",
    "vite-tsconfig-paths": "^6.1.1",
    "eslint": "^9.38.0"
  }
}
