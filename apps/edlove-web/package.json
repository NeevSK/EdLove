{
  "name": "apps-edlove-web",
  "type": "module",
  "version": "0.0.2",
  "scripts": {
    "dev": "node ../../scripts/run-and-report.mjs --cmd \"pnpm exec astro dev\" --name \"apps_edlove-web-dev\"",
    "build": "node ../../scripts/run-and-report.mjs --cmd \"pnpm exec astro build\" --name \"apps_edlove-web-build\"",
    "preview": "node ../../scripts/run-and-report.mjs --cmd \"pnpm exec astro preview\" --name \"apps_edlove-web-preview\"",
    "astro": "node ../../scripts/run-and-report.mjs --cmd \"pnpm exec astro\" --name \"apps_edlove-web-astro\"",
    "lint": "node ../../scripts/run-and-report.mjs --cmd \"pnpm run lint:biome && pnpm run lint:eslint\" --name \"apps_edlove-web-lint\"",
    "check-types": "node ../../scripts/run-and-report.mjs --cmd \"pnpm run astro:sync && pnpm exec tsc --build --noEmit\" --name \"apps_edlove-web-check-types\"",
    "astro:sync": "node ../../scripts/run-and-report.mjs --cmd \"pnpm exec astro sync\" --name \"apps_edlove-web-astro_sync\"",
    "lint:biome": "node ../../scripts/run-and-report.mjs --cmd \"node ../../scripts/scoped-biome.mjs\" --name \"apps_edlove-web-lint_biome\"",
    "lint:eslint": "node ../../scripts/run-and-report.mjs --cmd \"eslint .\" --name \"apps_edlove-web-lint_eslint\"",
    "format": "node ../../scripts/run-and-report.mjs --cmd \"node ../../scripts/scoped-biome.mjs --write\" --name \"apps_edlove-web-format\"",
    "check-cycles": "node ../../scripts/run-and-report.mjs --cmd \"node ../../scripts/refactor/sovereign-cycle-checker.mjs\" --name \"apps_edlove-web-check-cycles\"",
    "test": "node ../../scripts/run-and-report.mjs --cmd \"vitest run\" --name \"apps_edlove-web-test\" --evidence-level G1",
    "test:watch": "node ../../scripts/run-and-report.mjs --cmd \"vitest\" --name \"apps_edlove-web-test_watch\" --evidence-level G1",
    "test:ui": "node ../../scripts/run-and-report.mjs --cmd \"vitest --ui\" --name \"apps_edlove-web-test_ui\" --evidence-level G1",
    "clean": "node ../../scripts/run-and-report.mjs --cmd \"rm -rf .turbo node_modules dist\" --name \"apps_edlove-web-clean\""
  },
  "dependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/starlight": "^0.42.9",
    "@astrojs/svelte": "^9.1.2",
    "@intuitui-labs/a11y-gate": "^0.2.0",
    "@repo/editorial": "workspace:*",
    "@tailwindcss/vite": "^4.3.4",
    "@types/three": "^0.187.0",
    "astro": "^7.4.5",
    "pagefind": "^1.6.0",
    "svelte": "^5.57.3",
    "tailwindcss": "4.3.4",
    "three": "^0.187.0",
    "typescript": "7.1.0-beta"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:^",
    "@repo/typescript-config": "workspace:*",
    "eslint": "^10.14.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "5.1.0"
  },
  "_originalScripts": {
    "dev": "pnpm exec astro dev",
    "build": "pnpm exec astro build",
    "preview": "pnpm exec astro preview",
    "astro": "pnpm exec astro",
    "lint": "pnpm run lint:biome && pnpm run lint:eslint",
    "check-types": "pnpm exec tsc --build --noEmit",
    "lint:biome": "node ../../scripts/scoped-biome.mjs",
    "lint:eslint": "eslint .",
    "format": "node ../../scripts/scoped-biome.mjs --write",
    "check-cycles": "node ../../scripts/refactor/sovereign-cycle-checker.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "clean": "rm -rf .turbo node_modules dist"
  }
}
