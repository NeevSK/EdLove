# Stray nested pnpm lockfiles (root lockfile is canonical)
**/pnpm-lock.yaml
!/pnpm-lock.yaml

# JS shadow files are NEVER the source of truth in this repo.
# All source is TypeScript (.ts / .tsx). Plain .js files next to .ts
# are either:
#   (a) AI-agent "I'll strip types so Node can run it" pollution, or
#   (b) Expo Router ephemeral build twins.
# Both must be invisible to git. Use .mjs for Node-runnable ESM scripts.
apps/**/*.js
packages/**/*.js
docs/**/*.js
tests/**/*.js
tooling/**/*.js
!tooling/**/src/**/*.js
# scripts/ uses .mjs for Node scripts — plain .js is always phantom
scripts/*.js

# Stray tool outputs
/tsc-*.txt
/style-stack-audit.txt

# pnpm local store (never commit - use global auto-managed store)
.pnpm-store/


# Local VSCode / Cursor multi-root workspace
*.code-workspace
