+  outgoingPrincipalId: string | null,
+): Promise<QueryAccountBoundaryDisposalResult> {
+  const scopedPredicate = (query: Query) =>
+    query.queryKey[0] === 'scope' &&
+    typeof query.queryKey[1] === 'string' &&
+    query.queryKey[1] === outgoingPrincipalId;
