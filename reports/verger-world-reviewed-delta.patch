@@ -0,0 +1,55 @@
+import { describe, expect, it } from 'vitest';
+import { dataBudgetState, foldDataSample, inDailyWindow, localDay } from './dataBudget';
+
+const LK = 330; // Sri Lanka, UTC+05:30
+const MB = 1024 * 1024;
+// 2026-10-24 10:00 in Colombo.
+const MORNING = Date.UTC(2026, 9, 24, 4, 30);
+
+describe('the data budget ledger', () => {
+  it('counts the difference between samples within a day', () => {
+    let ledger = foldDataSample(null, { atWallMs: MORNING, totalBytes: 500 * MB }, LK);
+    ledger = foldDataSample(ledger, { atWallMs: MORNING + 60_000, totalBytes: 530 * MB }, LK);
+    expect(ledger).toEqual({ day: '2026-10-24', usedBytes: 30 * MB, lastTotal: 530 * MB });
+  });
+
+  it('a reboot (the total goes down) counts the new total as new traffic, never negative', () => {
+    let ledger = foldDataSample(null, { atWallMs: MORNING, totalBytes: 500 * MB }, LK);
+    ledger = foldDataSample(ledger, { atWallMs: MORNING + 60_000, totalBytes: 4 * MB }, LK);
+    expect(ledger?.usedBytes).toBe(4 * MB);
+  });
+
+  it('starts each local day from zero, at local midnight, not UTC midnight', () => {
+    const beforeMidnight = Date.UTC(2026, 9, 24, 18, 29); // 23:59 in Colombo
+    const afterMidnight = Date.UTC(2026, 9, 24, 18, 31); // 00:01 next day in Colombo
+    expect(localDay(afterMidnight, LK)).toBe('2026-10-25');
+    let ledger = foldDataSample(null, { atWallMs: beforeMidnight, totalBytes: 100 * MB }, LK);
+    ledger = foldDataSample(ledger, { atWallMs: beforeMidnight + 30_000, totalBytes: 150 * MB }, LK);
+    ledger = foldDataSample(ledger, { atWallMs: afterMidnight, totalBytes: 160 * MB }, LK);
+    expect(ledger).toEqual({ day: '2026-10-25', usedBytes: 10 * MB, lastTotal: 160 * MB });
+  });
+
+  it('an unsupported counter changes nothing; no reading is unknown, never spent', () => {
+    expect(foldDataSample(null, { atWallMs: MORNING, totalBytes: -1 }, LK)).toBeNull();
+    expect(dataBudgetState(null, 50 * MB, MORNING, LK)).toBe('unknown');
+  });
+
+  it('is spent at the allowance, and fresh again the next day', () => {
+    const ledger = { day: '2026-10-24', usedBytes: 50 * MB, lastTotal: 0 };
+    expect(dataBudgetState(ledger, 50 * MB, MORNING, LK)).toBe('spent');
+    expect(dataBudgetState(ledger, 60 * MB, MORNING, LK)).toBe('within');
+    expect(dataBudgetState(ledger, 50 * MB, MORNING + 24 * 3_600_000, LK)).toBe('within');
+  });
+});
+
+describe('daily windows (a cheap night window)', () => {
+  it('handles a window that wraps midnight, in local time', () => {
+    const at = (h: number, m: number) => Date.UTC(2026, 9, 24, h, m) - LK * 60_000;
+    expect(inDailyWindow(at(23, 30), LK, 23 * 60, 6 * 60)).toBe(true);
+    expect(inDailyWindow(at(5, 59), LK, 23 * 60, 6 * 60)).toBe(true);
+    expect(inDailyWindow(at(6, 0), LK, 23 * 60, 6 * 60)).toBe(false);
+    expect(inDailyWindow(at(12, 0), LK, 23 * 60, 6 * 60)).toBe(false);
+    expect(inDailyWindow(at(12, 0), LK, 9 * 60, 17 * 60)).toBe(true);
+    expect(inDailyWindow(at(12, 0), LK, 300, 300)).toBe(false);
+  });
+});
diff --git a/packages/verger-core/src/dataBudget.ts b/packages/verger-core/src/dataBudget.ts
new file mode 100644
index 000000000..9dcb18332
--- /dev/null
+++ b/packages/verger-core/src/dataBudget.ts
@@ -0,0 +1,101 @@
+/**
+ * The data budget's accounting (playbook B3): this app's bytes against a daily allowance.
+ * Pure: the host samples the platform's counters (Android `TrafficStats` per-UID bytes since
+ * boot) and keeps the ledger in verger's store. Counters reset at reboot, so a total that goes
+ * down is a new boot: what it shows is new traffic, never a negative. The day is the user's
+ * local calendar day (the offset is passed in: Sri Lanka is +330 minutes).
+ */
+
+export interface DataLedger {
+  /** Local calendar day the bytes belong to, `YYYY-MM-DD`. */
+  readonly day: string;
+  /** Bytes this app moved today. */
+  readonly usedBytes: number;
+  /** The counter's last total since boot, to take the next difference from. */
+  readonly lastTotal: number;
+}
+
+export interface DataSample {
+  readonly atWallMs: number;
+  /** Bytes received and sent since boot; negative means the platform does not count them. */
+  readonly totalBytes: number;
+}
+
+export type DataBudgetState = 'within' | 'spent' | 'unknown';
+
+const MINUTE_MS = 60_000;
+
+/** The local calendar day of a wall time, for a fixed offset from UTC in minutes. */
+export function localDay(atWallMs: number, utcOffsetMinutes: number): string {
+  return new Date(atWallMs + utcOffsetMinutes * MINUTE_MS).toISOString().slice(0, 10);
+}
+
+/**
+ * Folds one sample into the ledger. A new day starts from zero; a total below the last one is a
+ * reboot, so the whole new total is today's new traffic. An unsupported counter changes nothing.
+ */
+export function foldDataSample(
+  ledger: DataLedger | null,
+  sample: DataSample,
+  utcOffsetMinutes: number,
+): DataLedger | null {
+  if (!Number.isFinite(sample.totalBytes) || sample.totalBytes < 0) return ledger;
+  const day = localDay(sample.atWallMs, utcOffsetMinutes);
+  if (ledger === null) return { day, usedBytes: 0, lastTotal: sample.totalBytes };
+  const moved =
+    sample.totalBytes >= ledger.lastTotal ? sample.totalBytes - ledger.lastTotal : sample.totalBytes;
+  return {
+    day,
+    usedBytes: (day === ledger.day ? ledger.usedBytes : 0) + moved,
+    lastTotal: sample.totalBytes,
+  };
+}
+
+/** Whether today's allowance is spent. No ledger, or one from another day, is unknown or fresh. */
+export function dataBudgetState(
+  ledger: DataLedger | null,
+  allowanceBytes: number,
+  atWallMs: number,
+  utcOffsetMinutes: number,
+): DataBudgetState {
+  if (ledger === null) return 'unknown';
+  if (ledger.day !== localDay(atWallMs, utcOffsetMinutes)) return 'within';
+  return ledger.usedBytes >= allowanceBytes ? 'spent' : 'within';
+}
+
+/**
+ * Whether a local time falls in a daily window given in minutes after midnight, `[start, end)`.
+ * A window may wrap midnight (a night window from 23:00 to 06:00 is `start 1380, end 360`);
+ * equal ends mean no window.
+ */
+export function inDailyWindow(
+  atWallMs: number,
+  utcOffsetMinutes: number,
+  startMinute: number,
+  endMinute: number,
+): boolean {
+  const local = new Date(atWallMs + utcOffsetMinutes * MINUTE_MS);
+  const minute = local.getUTCHours() * 60 + local.getUTCMinutes();
+  if (startMinute === endMinute) return false;
+  return startMinute < endMinute
+    ? minute >= startMinute && minute < endMinute
+    : minute >= startMinute || minute < endMinute;
+}
+
+const DAY = /^\d{4}-\d{2}-\d{2}$/;
+
+/** A stored ledger, checked strictly: anything malformed is no ledger (unknown, never spent). */
+export function parseDataLedger(text: string | null): DataLedger | null {
+  if (text === null) return null;
+  let value: unknown;
+  try {
+    value = JSON.parse(text);
+  } catch {
+    return null;
+  }
+  if (typeof value !== 'object' || value === null) return null;
+  const { day, usedBytes, lastTotal } = value as Record<string, unknown>;
+  const count = (n: unknown): n is number => typeof n === 'number' && Number.isFinite(n) && n >= 0;
+  if (typeof day !== 'string' || !DAY.test(day) || !count(usedBytes) || !count(lastTotal)) return null;
+  return { day, usedBytes, lastTotal };
+}
diff --git a/packages/verger-core/src/dataBudgetLimit.test.ts b/packages/verger-core/src/dataBudgetLimit.test.ts
new file mode 100644
index 000000000..f07acce07
--- /dev/null
+++ b/packages/verger-core/src/dataBudgetLimit.test.ts
@@ -0,0 +1,69 @@
+import { describe, expect, it } from 'vitest';
+import { SAMPLE_LEVERS } from './__fixtures__/sampleHost';
+import { resolveActivation } from './activation';
+import { admitWork, estimateAccounts } from './demand';
+import { checkSnapshot } from './invariants';
+import { VERGER_POLICY, VERGER_POLICY_P5 } from './policy';
+import { UNKNOWN_CAPACITY } from './reducer';
+import type { LeverSpec, VergerEvent } from './types';
+import { FLOORS_ACTIVATION } from './verger';
+
+const PREFETCH: LeverSpec = {
+  id: 'prefetch',
+  maxLevel: 2,
+  visualImpact: 'low',
+  target: 'energy',
+  alsoRelieves: ['network'],
+  ambient: false,
+  motion: false,
+  levels: ['prefetch', 'on idle', 'none'],
+  whenDataBudgetSpent: 2,
+};
+const LEVERS = [...SAMPLE_LEVERS, PREFETCH];
+
+function after(events: readonly VergerEvent[], policy = VERGER_POLICY, activation = FLOORS_ACTIVATION) {
+  let state = policy.create({ at: 0, levers: LEVERS, activation });
+  for (const event of events) state = policy.reduce(state, event);
+  return policy.snapshot(state);
+}
+
+const budget = (at: number, state: 'within' | 'spent' | 'unknown'): VergerEvent => ({ type: 'data-budget', at, state });
+
+describe('the data budget as a limit (B3.2)', () => {
+  it('a spent budget holds the lever that declares it, with only the floors running, and is published', () => {
+    for (const policy of [VERGER_POLICY, VERGER_POLICY_P5]) {
+      const spent = after([budget(10, 'spent')], policy);
+      expect(spent.dataBudget).toBe('spent');
+      expect(spent.levels.prefetch).toBe(2);
+      expect(spent.envelope.prefetch?.limit).toBe(2);
+      expect(checkSnapshot(spent, LEVERS)).toEqual([]);
+    }
+  });
+
+  it('unknown is never a limit, and a new reading lifts the hold (a new day is the host reporting within)', () => {
+    expect(after([]).levels.prefetch).toBe(0);
+    expect(after([budget(10, 'unknown')]).levels.prefetch).toBe(0);
+    expect(after([budget(10, 'spent'), budget(20, 'within')]).levels.prefetch).toBe(0);
+  });
+
+  it('a deaf network sensor hears no budget, and switching it off forgets the last one', () => {
+    const deaf = resolveActivation(FLOORS_ACTIVATION, { sense: { network: false } });
+    const unheard = after([budget(10, 'spent')], VERGER_POLICY, deaf);
+    expect(unheard.dataBudget).toBe('unknown');
+    expect(unheard.levels.prefetch).toBe(0);
+    const forgotten = after([budget(10, 'spent'), { type: 'activation', at: 20, activation: deaf }]);
+    expect(forgotten.dataBudget).toBe('unknown');
+    expect(checkSnapshot(forgotten, LEVERS)).toEqual([]);
+  });
+
+  it('a spent budget holds deferrable network work from the snapshot alone, never critical work; the network account reads it', () => {
+    const spent = after([
+      { type: 'network', at: 5, transport: 'cellular', validated: true, metered: true, downKbps: 5000, dataSaver: 'disabled' },
+      budget(10, 'spent'),
+    ]);
+    expect(admitWork(spent, { class: 'deferrable', spends: ['network'] })).toEqual({ admit: false, reason: 'data-budget-spent' });
+    expect(admitWork(spent, { class: 'critical', spends: ['network'] }).admit).toBe(true);
+    expect(admitWork(spent, { class: 'deferrable', spends: ['cpu'] }).admit).toBe(true);
+    expect(estimateAccounts(spent, UNKNOWN_CAPACITY).network).toMatchObject({ state: 'overdrawn' });
+  });
+});
diff --git a/packages/verger-core/src/dataLedger.test.ts b/packages/verger-core/src/dataLedger.test.ts
new file mode 100644
index 000000000..bd8616f85
--- /dev/null
+++ b/packages/verger-core/src/dataLedger.test.ts
@@ -0,0 +1,112 @@
+import { describe, expect, it } from 'vitest';
+import { SAMPLE_LEVERS } from './__fixtures__/sampleHost';
+import { parseDataLedger } from './dataBudget';
+import { createVerger, defineHost, type RuntimePort, type VergerEvent, type VergerStore } from './index';
+import { UNKNOWN_CAPACITY } from './reducer';
+
+/** B3.1: the platform's byte counter, folded into the day's ledger and reported as the budget. */
+const HOST = defineHost({ name: 'sample', levers: SAMPLE_LEVERS });
+const MB = 1024 * 1024;
+// 2026-10-25 10:00 in Colombo (UTC+05:30).
+const MORNING = Date.UTC(2026, 9, 25, 4, 30);
+
+function harness(allowance?: number, stored?: string) {
+  const data = new Map<string, string>(stored ? [['verger:sample:data', stored]] : []);
+  const store: VergerStore = {
+    get: async (key) => data.get(key) ?? null,
+    set: async (key, value) => void data.set(key, value),
+    remove: async (key) => void data.delete(key),
+  };
+  let emit: ((event: VergerEvent) => void) | null = null;
+  let wall = MORNING;
+  const port: RuntimePort = {
+    start(_config, onEvent) {
+      emit = onEvent;
+      return () => {};
+    },
+    setRefreshCap: () => {},
+    setCpuBoost: () => {},
+  };
+  const verger = createVerger({
+    host: HOST,
+    platform: () => ({ readCapacity: () => UNKNOWN_CAPACITY, memorySensing: false, createPort: () => port }),
+    store,
+    requested: 'active',
+    release: '1.0.0',
+    now: () => 0,
+    wallNow: () => wall,
+    utcOffsetMinutes: () => 330,
+    scheduler: { setTimeout: () => 0, clearTimeout: () => {} },
+    random: () => 0.99,
+    ...(allowance === undefined ? {} : { dataAllowanceBytes: allowance }),
+  });
+  return {
+    verger,
+    data,
+    bytes: (totalBytes: number) => emit?.({ type: 'data-usage', at: 1, totalBytes }),
+    pass: (ms: number) => {
+      wall += ms;
+    },
+  };
+}
+
+describe('the data ledger (B3.1)', () => {
+  it('counts this app’s bytes into the day, spends the allowance, and persists the ledger', async () => {
+    const h = harness(50 * MB);
+    await h.verger.start();
+    expect(h.verger.getSnapshot()?.dataBudget).toBe('unknown');
+    h.bytes(400 * MB);
+    expect(h.verger.getSnapshot()?.dataBudget).toBe('within');
+    h.bytes(440 * MB);
+    expect(h.verger.getSnapshot()?.dataBudget).toBe('within');
+    h.bytes(460 * MB);
+    expect(h.verger.getSnapshot()?.dataBudget).toBe('spent');
+    await Promise.resolve();
+    expect(parseDataLedger(h.data.get('verger:sample:data') ?? null)).toEqual({
+      day: '2026-10-25',
+      usedBytes: 60 * MB,
+      lastTotal: 460 * MB,
+    });
+  });
+
+  it('a new local day is fresh again on the next sample, even without new traffic (the heartbeat)', async () => {
+    const h = harness(50 * MB);
+    await h.verger.start();
+    h.bytes(0);
+    h.bytes(60 * MB);
+    expect(h.verger.getSnapshot()?.dataBudget).toBe('spent');
+    h.pass(24 * 3_600_000);
+    h.bytes(60 * MB);
+    expect(h.verger.getSnapshot()?.dataBudget).toBe('within');
+  });
+
+  it('the ledger survives a relaunch; a stored ledger that is malformed is none', async () => {
+    const stored = JSON.stringify({ day: '2026-10-25', usedBytes: 49 * MB, lastTotal: 100 * MB });
+    const h = harness(50 * MB, stored);
+    await h.verger.start();
+    // A reboot since: the counter restarted, so its whole total is new traffic.
+    h.bytes(2 * MB);
+    expect(h.verger.getSnapshot()?.dataBudget).toBe('spent');
+    expect(parseDataLedger('{"day":"25-10-2026","usedBytes":1,"lastTotal":1}')).toBeNull();
+    expect(parseDataLedger('{"day":"2026-10-25","usedBytes":-1,"lastTotal":1}')).toBeNull();
+    expect(parseDataLedger('not json')).toBeNull();
+  });
+
+  it('without an allowance (a chair) the budget stays unknown, never a limit; the ledger is kept', async () => {
+    const h = harness();
+    await h.verger.start();
+    h.bytes(10 * MB);
+    h.bytes(900 * MB);
+    expect(h.verger.getSnapshot()?.dataBudget).toBe('unknown');
+    await Promise.resolve();
+    expect(parseDataLedger(h.data.get('verger:sample:data') ?? null)?.usedBytes).toBe(890 * MB);
+  });
+
+  it('an uncounted platform (negative total) changes nothing', async () => {
+    const h = harness(50 * MB);
+    await h.verger.start();
+    h.bytes(-1);
+    expect(h.verger.getSnapshot()?.dataBudget).toBe('unknown');
+    expect(h.data.has('verger:sample:data')).toBe(false);
+  });
+});
diff --git a/packages/verger-core/src/demand.test.ts b/packages/verger-core/src/demand.test.ts
new file mode 100644
