--- /dev/null
+++ b/packages/verger-core/src/demand.test.ts
@@ -0,0 +1,177 @@
+import { describe, expect, it } from 'vitest';
+import { SAMPLE_LEVERS } from './__fixtures__/sampleHost';
+import { ACTIVATION_PRESETS, resolveActivation } from './activation';
+import {
+  admitWork,
+  classesOfLever,
+  estimateAccounts,
+  type ResourceAccount,
+  validateWorkloads,
+  type WorkloadSpec,
+} from './demand';
+import { createVergerState, reduceVerger, snapshotOf, UNKNOWN_CAPACITY } from './reducer';
+import { defineHost } from './host';
+import type { CapacityFacts, NetworkLimit, VergerEvent } from './types';
+
+const WORKLOADS: readonly WorkloadSpec[] = [
+  { id: 'tap', class: 'critical', spends: ['cpu'], source: 'everywhere' },
+  { id: 'glitter', class: 'ornamental', spends: ['gpu'], levers: ['sparkle'], source: 'hero' },
+  {
+    id: 'gallery',
+    class: 'committed',
+    spends: ['memory'],
+    levers: ['photo-cache', 'sparkle'],
+    source: 'gallery',
+  },
+];
+
+const CAPACITY: CapacityFacts = {
+  ...UNKNOWN_CAPACITY,
+  sdkInt: 34,
+  totalMemoryBytes: 8 * 1024 ** 3,
+};
+
+describe('demand registry', () => {
+  it('a host carries its workloads, checked against its levers', () => {
+    const host = defineHost({ name: 'sample', levers: SAMPLE_LEVERS, workloads: WORKLOADS });
+    expect(host.workloads.map((w) => w.id)).toEqual(['tap', 'glitter', 'gallery']);
+    expect(defineHost({ name: 'sample', levers: SAMPLE_LEVERS }).workloads).toEqual([]);
+  });
+
+  it('rejects duplicates, unknown levers, unknown accounts and work that spends nothing', () => {
+    const tap = WORKLOADS[0] as WorkloadSpec;
+    expect(() => validateWorkloads([tap, tap], SAMPLE_LEVERS)).toThrow(/Duplicate/);
+    expect(() => validateWorkloads([{ ...tap, levers: ['nope'] }], SAMPLE_LEVERS)).toThrow(
+      /unknown lever/,
+    );
+    expect(() => validateWorkloads([{ ...tap, spends: [] }], SAMPLE_LEVERS)).toThrow(
+      /at least one/,
+    );
+    // A registry read from data can hold anything; the check must not trust the type.
+    const bad = JSON.parse(
+      '{"id":"x","class":"urgent","spends":["cpu"],"source":"s"}',
+    ) as WorkloadSpec;
+    expect(() => validateWorkloads([bad], SAMPLE_LEVERS)).toThrow(/unknown class/);
+    const badAccount = JSON.parse(
+      '{"id":"x","class":"critical","spends":["disk"],"source":"s"}',
+    ) as WorkloadSpec;
+    expect(() => validateWorkloads([badAccount], SAMPLE_LEVERS)).toThrow(/unknown account/);
+  });
+
+  it('a lever answers for the classes of work that read it, most important first', () => {
+    expect(classesOfLever(WORKLOADS, 'sparkle')).toEqual(['committed', 'ornamental']);
+    expect(classesOfLever(WORKLOADS, 'frosting')).toEqual([]);
+  });
+});
+
+describe('resource accounts', () => {
+  const run = (events: readonly VergerEvent[], patch = {}) => {
+    let state = createVergerState({
+      at: 0,
+      levers: SAMPLE_LEVERS,
+      capacity: CAPACITY,
+      memorySensing: true,
+      activation: resolveActivation(ACTIVATION_PRESETS.active, patch),
+    });
+    for (const event of events) state = reduceVerger(state, event);
+    return estimateAccounts(snapshotOf(state), CAPACITY);
+  };
+
+  it('no reading is unknown with no confidence, never ample', () => {
+    const accounts = run([]);
+    expect(accounts.thermal).toEqual({ state: 'unknown', confidence: 0, source: 'no signal' });
+    expect(accounts.gpu.state).toBe('unknown');
+    expect(accounts.network.state).toBe('unknown');
+    expect(accounts.storage.state).toBe('unknown');
+  });
+
+  it('heat, memory and frames map onto their accounts', () => {
+    const accounts = run([
+      { type: 'thermal', at: 1, status: 'severe', headroom: 0.97 },
+      { type: 'memory-state', at: 2, availableMb: 100, thresholdMb: 200, lowMemory: false },
+      {
+        type: 'frame-window',
+        at: 500,
+        window: {
+          startMs: 0,
+          endMs: 500,
+          frames: 30,
+          averageMs: 30,
+          targetMs: 16.7,
+          worstMs: 35,
+          droppedRatio: 0.3,
+        },
+      },
+    ]);
+    expect(accounts.thermal.state).toBe('overdrawn');
+    expect(accounts.thermal.confidence).toBeGreaterThan(0.8);
+    expect(accounts.memory.state).toBe('overdrawn');
+    expect(accounts.gpu.state).toBe('overdrawn');
+  });
+
+  it('a saturated thread overdraws cpu, whatever the frames say', () => {
+    const load: VergerEvent[] = [0, 2500].map((at) => ({
+      type: 'thread-load',
+      at,
+      cores: { js: 1 },
+      processCores: 1.2,
+    }));
+    expect(run(load).cpu).toMatchObject({ state: 'overdrawn', source: 'js thread saturated' });
+  });
+
+  it('a switched-off sensor reads as unknown, not as the last value', () => {
+    const hot: VergerEvent = { type: 'thermal', at: 1, status: 'severe', headroom: 0.97 };
+    expect(run([hot], { sense: { thermal: false } }).thermal.state).toBe('unknown');
+  });
+});
+
+describe('admitWork: background work against the limits of the moment', () => {
+  const base = {
+    networkLimit: 'none' as NetworkLimit,
+    powerSaver: false,
+    battery: { levelPercent: 80, pluggedIn: false, temperatureC: null },
+  };
+  const sync = { class: 'deferrable' as const, spends: ['network', 'energy'] as ResourceAccount[] };
+
+  it('metered and unknown are not limits: a teacher on mobile data still syncs', () => {
+    expect(admitWork(base, sync)).toEqual({ admit: true, reason: 'eligible' });
+    expect(admitWork({ ...base, battery: { levelPercent: null, pluggedIn: null, temperatureC: null } }, sync).admit).toBe(true);
+  });
+
+  it('waits offline, under Data Saver, and on a link just back from offline', () => {
+    for (const limit of ['offline', 'data-saver', 'unstable'] as const)
+      expect(admitWork({ ...base, networkLimit: limit }, sync)).toEqual({ admit: false, reason: limit });
+    expect(admitWork({ ...base, networkLimit: 'slow' }, sync).admit).toBe(true);
+  });
+
+  it('waits under battery saver or a low unplugged battery, at the configured threshold', () => {
+    expect(admitWork({ ...base, powerSaver: true }, sync).reason).toBe('battery-saver');
+    const low = { ...base, battery: { levelPercent: 15, pluggedIn: false, temperatureC: null } };
+    expect(admitWork(low, sync).reason).toBe('battery-low');
+    expect(admitWork(low, sync, { batteryLowPercent: 10 }).admit).toBe(true);
+    expect(admitWork({ ...low, battery: { ...low.battery, pluggedIn: true } }, sync).admit).toBe(true);
+  });
+
+  it('critical and committed work always runs; work that spends neither account is never held', () => {
+    const offline = { ...base, networkLimit: 'offline' as NetworkLimit, powerSaver: true };
+    expect(admitWork(offline, { class: 'critical', spends: ['network'] }).admit).toBe(true);
+    expect(admitWork(offline, { class: 'committed', spends: ['network'] }).admit).toBe(true);
+    expect(admitWork(offline, { class: 'deferrable', spends: ['cpu'] }).admit).toBe(true);
+  });
+});
+
+describe('admitWork and the daily data budget', () => {
+  const base = {
+    networkLimit: 'none' as NetworkLimit,
+    powerSaver: false,
+    battery: { levelPercent: 80, pluggedIn: false, temperatureC: null },
+  };
+  it('a spent budget holds optional network work, never critical work; unknown holds nothing', () => {
+    const sync = { class: 'deferrable' as const, spends: ['network'] as ResourceAccount[] };
+    expect(admitWork({ ...base, dataBudget: 'spent' }, sync)).toEqual({ admit: false, reason: 'data-budget-spent' });
+    expect(admitWork({ ...base, dataBudget: 'within' }, sync).admit).toBe(true);
+    expect(admitWork({ ...base, dataBudget: 'unknown' }, sync).admit).toBe(true);
+    expect(admitWork({ ...base, dataBudget: 'spent' }, { class: 'critical', spends: ['network'] }).admit).toBe(true);
+    expect(admitWork({ ...base, dataBudget: 'spent' }, { class: 'deferrable', spends: ['cpu'] }).admit).toBe(true);
+  });
+});
diff --git a/packages/verger-core/src/demand.ts b/packages/verger-core/src/demand.ts
new file mode 100644
index 000000000..09341f19d
--- /dev/null
+++ b/packages/verger-core/src/demand.ts
@@ -0,0 +1,308 @@
+import { DEFAULT_VERGER_CONFIG } from './config';
+import type { DataBudgetState } from './dataBudget';
+import { isBatteryLow, THERMAL_RANK } from './signals';
+import type { CapacityFacts, LeverSpec, StorageLevel, VergerConfig, VergerSnapshot } from './types';
+
+/**
+ * Demand and supply as data. The registry says what the host's work is, which class it is in and
+ * which resource accounts it spends; the accounts say how each resource stands now and how sure
+ * verger is. Both are read models: a policy may use them, the lab shows them, telemetry reports
+ * them. Policy verger-p4 decides without them.
+ */
+
+/** The seven resources the device holds and the app spends. */
+export type ResourceAccount =
+  | 'cpu'
+  | 'gpu'
+  | 'memory'
+  | 'energy'
+  | 'thermal'
+  | 'network'
+  | 'storage';
+
+export const RESOURCE_ACCOUNTS: readonly ResourceAccount[] = [
+  'cpu',
+  'gpu',
+  'memory',
+  'energy',
+  'thermal',
+  'network',
+  'storage',
+];
+
+/**
+ * `critical` fails the user if late (never shed, degrades only inside its ladder); `committed` is
+ * the screen in front of the user (lowered, never removed); `deferrable` is useful later
+ * (postponed); `ornamental` is pleasure, not function (removed first).
+ */
+export type WorkloadClass = 'critical' | 'committed' | 'deferrable' | 'ornamental';
+
+export const WORKLOAD_CLASSES: readonly WorkloadClass[] = [
+  'critical',
+  'committed',
+  'deferrable',
+  'ornamental',
+];
+
+/** A unit of work the host does. Its quality ladder is the levers it reads, if any. */
+export interface WorkloadSpec {
+  readonly id: string;
+  readonly class: WorkloadClass;
+  /** Accounts it is believed to spend; measured cost vectors replace belief later. */
+  readonly spends: readonly ResourceAccount[];
+  /** Levers that set its quality; none for work verger only admits or protects. */
+  readonly levers?: readonly string[];
+  /**
+   * `wait`: deferrable or ornamental work that should not run while free storage is low (it
+   * writes optional data). Undeclared, low storage never holds it: work that frees space, or
+   * that carries the user's records out, must keep running. A host decision per workload.
+   */
+  readonly whenStorageLow?: 'wait';
+  /** Where it lives in the host, for people reading the registry. */
+  readonly source: string;
+}
+
+export function validateWorkloads(
+  workloads: readonly WorkloadSpec[],
+  levers: readonly LeverSpec[],
+): void {
+  const leverIds = new Set(levers.map((lever) => lever.id));
+  const seen = new Set<string>();
+  for (const workload of workloads) {
+    if (seen.has(workload.id)) throw new Error(`Duplicate workload "${workload.id}"`);
+    seen.add(workload.id);
+    if (!WORKLOAD_CLASSES.includes(workload.class)) {
+      throw new Error(`Workload "${workload.id}" has unknown class "${workload.class}"`);
+    }
+    if (workload.spends.length === 0) {
+      throw new Error(`Workload "${workload.id}" must name at least one account it spends`);
+    }
+    for (const account of workload.spends) {
+      if (!RESOURCE_ACCOUNTS.includes(account)) {
+        throw new Error(`Workload "${workload.id}" spends unknown account "${account}"`);
+      }
+    }
+    for (const id of workload.levers ?? []) {
+      if (!leverIds.has(id))
+        throw new Error(`Workload "${workload.id}" reads unknown lever "${id}"`);
+    }
+  }
+}
+
+/** The classes a lever's workloads are in: what lowering it would cost the user. */
+export function classesOfLever(
+  workloads: readonly WorkloadSpec[],
+  leverId: string,
+): WorkloadClass[] {
+  const classes = new Set<WorkloadClass>();
+  for (const workload of workloads) {
+    if (workload.levers?.includes(leverId)) classes.add(workload.class);
+  }
+  return WORKLOAD_CLASSES.filter((c) => classes.has(c));
+}
+
+// ---------------------------------------------------------------------------------------------
+// Supply: how each account stands.
+// ---------------------------------------------------------------------------------------------
+
+/** `unknown` means no reading, which is not the same as `ample`. */
+export type AccountState = 'unknown' | 'ample' | 'tight' | 'overdrawn';
+
+export interface AccountReading {
+  readonly state: AccountState;
+  /** 0 (no evidence) to 1. Low confidence should widen a policy's safety margin. */
+  readonly confidence: number;
+  /** The signal behind the reading, for the lab and for reasons. */
+  readonly source: string;
+}
+
+const UNKNOWN: AccountReading = { state: 'unknown', confidence: 0, source: 'no signal' };
+
+/**
+ * Reads the accounts from a snapshot and the device's facts. Confidence reflects how direct the
+ * signal is on this device (thermal headroom from Android 11, GPU time from Android 12); its
+ * numbers are provisional until device captures calibrate them.
+ */
+export function estimateAccounts(
+  snapshot: VergerSnapshot,
+  capacity: CapacityFacts,
+  config: Pick<VergerConfig, 'batteryLowPercent'> = DEFAULT_VERGER_CONFIG,
+): Readonly<Record<ResourceAccount, AccountReading>> {
+  const lowPercent = config.batteryLowPercent;
+  const sense = snapshot.activation.sense;
+  const sdk = capacity.sdkInt ?? 0;
+
+  const fromBattery = snapshot.thermalSource === 'battery';
+  // The worse of the held level and the trend's projection (R1): the account a policy acts on.
+  const heat =
+    THERMAL_RANK[snapshot.thermalProjected] > THERMAL_RANK[snapshot.thermal]
+      ? snapshot.thermalProjected
+      : snapshot.thermal;
+  const thermal: AccountReading =
+    !sense.thermal || heat === 'unknown'
+      ? UNKNOWN
+      : {
+          state:
+            heat === 'nominal'
+              ? 'ample'
+              : heat === 'warm'
+                ? 'tight'
+                : 'overdrawn',
+          // Battery temperature lags the chip's: a weaker witness.
+          confidence: fromBattery ? 0.4 : sdk >= 30 ? 0.9 : 0.7,
+          source: fromBattery
+            ? 'battery temperature (fallback)'
+            : sdk >= 30
+              ? 'thermal status and headroom'
+              : 'thermal status',
+        };
+
+  const memory: AccountReading =
+    !sense.memory || snapshot.memory === 'unknown'
+      ? UNKNOWN
+      : {
+          state:
+            snapshot.memory === 'normal'
+              ? 'ample'
+              : snapshot.memory === 'trimmed'
+                ? 'tight'
+                : 'overdrawn',
+          confidence: 0.8,
+          source: sdk >= 34 ? 'polled free memory' : 'trim callbacks and polled free memory',
+        };
+
+  const framesHeard = sense.frames && snapshot.frameState !== 'quiet';
+  // Over budget is overdrawn; near budget (neutral) is tight.
+  const frameState = (): AccountState =>
+    snapshot.frameState === 'stressed'
+      ? 'overdrawn'
+      : snapshot.frameState === 'neutral'
+        ? 'tight'
+        : 'ample';
+
+  const cpu: AccountReading =
+    sense.threads && snapshot.contention !== 'none'
+      ? { state: 'overdrawn', confidence: 0.8, source: `${snapshot.contention} thread saturated` }
+      : framesHeard
+        ? { state: frameState(), confidence: sense.threads ? 0.7 : 0.5, source: 'frame cost' }
+        : sense.threads
+          ? { state: 'ample', confidence: 0.4, source: 'thread load, no frames drawn' }
+          : UNKNOWN;
+
+  const gpu: AccountReading = framesHeard
+    ? {
+        state: frameState(),
+        confidence: sdk >= 31 ? 0.7 : 0.4,
+        source: sdk >= 31 ? 'frame GPU time' : 'frame cost',
+      }
+    : UNKNOWN;
+
+  const b = snapshot.battery;
+  const energy: AccountReading = !sense.power
+    ? UNKNOWN
+    : b.pluggedIn === true
+      ? { state: 'ample', confidence: 0.8, source: 'plugged in' }
+      : b.levelPercent !== null && b.levelPercent <= lowPercent / 2
+        ? { state: 'overdrawn', confidence: 0.8, source: `battery at ${b.levelPercent}%` }
+        : (b.levelPercent !== null && b.levelPercent <= lowPercent) || snapshot.powerSaver
+          ? {
+              state: 'tight',
+              confidence: b.levelPercent !== null ? 0.8 : 0.5,
+              source: snapshot.powerSaver ? 'battery saver' : `battery at ${b.levelPercent}%`,
+            }
+          : snapshot.energyShort
+            ? {
+                state: 'tight',
+                confidence: 0.6,
+                source: `battery for about ${Math.round((snapshot.batteryHoursLeft ?? 0) * 10) / 10} h at this drain`,
+              }
+          : { state: 'ample', confidence: b.levelPercent !== null ? 0.7 : 0.4, source: 'battery' };
+
+  const n = snapshot.network;
+  const network: AccountReading =
+    !sense.network || n.transport === null
+      ? UNKNOWN
+      : n.transport === 'none' || n.validated === false
+        ? { state: 'overdrawn', confidence: 0.8, source: 'no validated network' }
+        : n.dataSaver === 'enabled'
+          ? { state: 'overdrawn', confidence: 0.9, source: 'Data Saver restricts this app' }
+          : snapshot.dataBudget === 'spent'
+            ? { state: 'overdrawn', confidence: 0.8, source: "today's data budget is spent" }
+            : // Slow or unstable as the policy reads it (config `slowNetworkKbps`, `networkSettleMs`).
+            n.metered === true ||
+              snapshot.networkLimit === 'slow' ||
+              snapshot.networkLimit === 'unstable'
+            ? {
+                state: 'tight',
+                confidence: 0.7,
+                source: n.metered === true ? 'metered network' : `${snapshot.networkLimit} link`,
+              }
+            : {
+                state: 'ample',
+                confidence: n.validated === true ? 0.8 : 0.5,
+                source: `${n.transport} network`,
+              };
+
+  const storage: AccountReading =
+    !sense.storage || snapshot.storage === 'unknown'
+      ? UNKNOWN
+      : snapshot.storage === 'low'
+        ? { state: 'overdrawn', confidence: 0.8, source: 'free storage low' }
+        : { state: 'ample', confidence: 0.6, source: 'free storage' };
+
+  return { cpu, gpu, memory, energy, thermal, network, storage };
+}
+
+export interface Admission {
+  readonly admit: boolean;
+  /** Why, for logs and telemetry: `eligible`, or the limit that held the work back. */
+  readonly reason: string;
+}
+
+/**
+ * Whether a workload may run now, by its class and the accounts it spends, on a snapshot's
+ * limits. Critical and committed work always runs. Deferrable and ornamental work waits while an
+ * account it spends is at a limit: network work for offline, Data Saver or a link back from
+ * offline under a minute; energy work for battery saver or a low, unplugged battery. Metered is
+ * home, never a limit; unknown is never a limit; a spent daily data budget holds network work. For work outside the app's rhythm (background
+ * tasks); in the app, `optionalConcurrency` also counts visibility and contention.
+ */
+export function admitWork(
+  snapshot: Pick<VergerSnapshot, 'networkLimit' | 'powerSaver' | 'battery'> & {
+    /** Today's data budget (the snapshot's, or `dataBudgetState`); spent holds optional network work. */
+    readonly dataBudget?: DataBudgetState;
+    /** Free storage (the snapshot's); low holds work that declares `whenStorageLow: 'wait'`. */
+    readonly storage?: StorageLevel;
+    /** The battery will not last the reserve at its drain (R5); holds optional energy work. */
+    readonly energyShort?: boolean;
+  },
+  workload: Pick<WorkloadSpec, 'class' | 'spends' | 'whenStorageLow'>,
+  config: Pick<VergerConfig, 'batteryLowPercent'> = DEFAULT_VERGER_CONFIG,
+): Admission {
+  if (workload.class === 'critical' || workload.class === 'committed')
+    return { admit: true, reason: 'eligible' };
+  if (workload.spends.includes('network')) {
+    const limit = snapshot.networkLimit;
+    if (limit === 'offline' || limit === 'data-saver' || limit === 'unstable')
+      return { admit: false, reason: limit };
+    if (snapshot.dataBudget === 'spent') return { admit: false, reason: 'data-budget-spent' };
+  }
+  if (workload.whenStorageLow === 'wait' && snapshot.storage === 'low')
+    return { admit: false, reason: 'storage-low' };
+  if (workload.spends.includes('energy')) {
+    if (snapshot.powerSaver) return { admit: false, reason: 'battery-saver' };
+    if (isBatteryLow(snapshot.battery, config.batteryLowPercent) || snapshot.energyShort === true)
+      return { admit: false, reason: 'battery-low' };
+  }
+  return { admit: true, reason: 'eligible' };
+}
+
+/**
+ * The accounts a lever relieves, as the lever declares them (animation levers declare CPU: the
+ * UI thread drives every frame). Easing any compute or energy load also eases heat.
+ */
+export function accountsRelievedBy(lever: LeverSpec): ResourceAccount[] {
+  const targets = new Set<ResourceAccount>([lever.target, ...(lever.alsoRelieves ?? [])]);
+  if (targets.has('gpu') || targets.has('cpu') || targets.has('energy')) targets.add('thermal');
+  return [...targets];
+}
diff --git a/packages/verger-core/src/energy.test.ts b/packages/verger-core/src/energy.test.ts
new file mode 100644
index 000000000..97fbabb13
--- /dev/null
+++ b/packages/verger-core/src/energy.test.ts
@@ -0,0 +1,85 @@
+import { describe, expect, it } from 'vitest';
+import { SAMPLE_LEVERS } from './__fixtures__/sampleHost';
+import { DEFAULT_VERGER_CONFIG } from './config';
+import { admitWork, estimateAccounts } from './demand';
+import { VERGER_POLICY, VERGER_POLICY_P5 } from './policy';
+import { UNKNOWN_CAPACITY } from './reducer';
+import type { LeverSpec, VergerEvent } from './types';
+
+/** R5: the energy setpoint, hours of battery left at the measured drain against a reserve. */
+const PREFETCH: LeverSpec = {
+  id: 'prefetch',
+  maxLevel: 2,
+  visualImpact: 'low',
+  target: 'energy',
+  ambient: false,
+  motion: false,
+  levels: ['prefetch', 'on idle', 'none'],
+  whenBatteryLow: 1,
+};
+const LEVERS = [...SAMPLE_LEVERS, PREFETCH];
+const min = 60_000;
+const level = (at: number, percent: number, pluggedIn: boolean | null = false): VergerEvent => ({
+  type: 'battery',
+  at,
+  levelPercent: percent,
+  pluggedIn,
+  temperatureC: 30,
+});
+/** A reading every 5 minutes for `minutes`, falling `perHour` points an hour from `from`. */
+const drain = (from: number, perHour: number, minutes: number): VergerEvent[] =>
+  Array.from({ length: minutes / 5 + 1 }, (_, i) => level(i * 5 * min, from - (perHour * i * 5) / 60));
+
+function run(events: readonly VergerEvent[], policy = VERGER_POLICY) {
+  let state = policy.create({ at: 0, levers: LEVERS });
+  for (const event of events) state = policy.reduce(state, event);
+  return policy.snapshot(state);
+}
+
+describe('energy setpoint (R5)', () => {
+  it('a fast drain that would not last the reserve is short, long before the battery is low', () => {
+    for (const policy of [VERGER_POLICY, VERGER_POLICY_P5]) {
+      // 60% left, 30 points an hour: 2 hours, under the 3-hour reserve.
+      const snapshot = run(drain(75, 30, 30), policy);
+      expect(snapshot.battery.levelPercent).toBeCloseTo(60);
+      expect(snapshot.batteryHoursLeft).toBeCloseTo(2, 1);
+      expect(snapshot.energyShort).toBe(true);
+      expect(snapshot.levels.prefetch).toBe(1);
+      expect(estimateAccounts(snapshot, UNKNOWN_CAPACITY).energy.state).toBe('tight');
+      expect(admitWork(snapshot, { class: 'deferrable', spends: ['energy'] })).toEqual({ admit: false, reason: 'battery-low' });
+    }
+  });
+
+  it('a slow drain is not short, and does nothing', () => {
+    // 60% left at 5 points an hour: 12 hours.
+    const snapshot = run(drain(62.5, 5, 30));
+    expect(snapshot.batteryHoursLeft).toBeCloseTo(12, 0);
+    expect(snapshot.energyShort).toBe(false);
+    expect(snapshot.levels.prefetch).toBe(0);
+  });
+
+  it('too short a record, or too small a drop, is no drain: never a limit on a guess', () => {
+    expect(run(drain(75, 30, 5)).batteryHoursLeft).toBeNull();
+    // 1 point in 30 minutes is under the 2-point minimum drop.
+    expect(run(drain(61, 2, 30)).batteryHoursLeft).toBeNull();
+  });
+
+  it('plugging in starts the record over', () => {
+    const events = [...drain(75, 30, 30), level(31 * min, 60, true)];
+    const snapshot = run(events);
+    expect(snapshot.batteryHoursLeft).toBeNull();
+    expect(snapshot.energyShort).toBe(false);
+  });
+
+  it('a deaf power sensor forgets the record', async () => {
+    const { resolveActivation, activationForMode } = await import('./activation');
+    const deaf = resolveActivation(activationForMode('active'), { sense: { power: false } });
+    const snapshot = run([...drain(75, 30, 30), { type: 'activation', at: 31 * min, activation: deaf }]);
+    expect(snapshot.energyShort).toBe(false);
+  });
+
+  it('config: the minimum drop is a percentage', async () => {
+    const { parseConfigPatch } = await import('./config');
+    expect(parseConfigPatch({ energyDrainMinDropPercent: 101 }, DEFAULT_VERGER_CONFIG)).toHaveProperty('error');
+  });
+});
