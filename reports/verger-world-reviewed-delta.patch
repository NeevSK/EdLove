+#!/usr/bin/env node
+import { spawnSync } from 'node:child_process';
+import { fileURLToPath } from 'node:url';
+
+const root = fileURLToPath(new URL('../', import.meta.url));
+const steps = [];
+for (const name of [
+  'verger-core',
+  'verger-react',
+  'verger-react-native',
+  'verger-android',
+  'verger-web',
+]) {
+  steps.push([`tsc ${name}`, `packages/${name}`, ['tsc', '--noEmit', '-p', '.']]);
+}
+for (const name of ['verger-core', 'verger-android', 'verger-web']) {
+  steps.push([`test ${name}`, `packages/${name}`, ['vitest', 'run']]);
+}
+steps.push(
+  ['test Gurudevi host', 'packages/core', ['vitest', 'run', 'src/verger']],
+  [
+    'test UI context',
+    'packages/ui',
+    [
+      'vitest',
+      'run',
+      '--config',
+      'vitest.config.mts',
+      'src/context/__tests__',
+      'src/components/__tests__/Skeleton.verger.test.tsx',
+      'src/components/__tests__/SovereignVirtualList.verger.test.tsx',
+    ],
+  ],
+  [
+    'test mobile runtime',
+    'apps/gurudevi-mobile',
+    [
+      'vitest',
+      'run',
+      'src/__tests__/runtime',
+      'src/__tests__/architecture/efficiency-policy-boundaries.test.ts',
+    ],
+  ],
+  [
+    'test web Verger',
+    'apps/gurudevi-web',
+    [
+      'vitest',
+      'run',
+      'tests/integration/gurudeviWebVerger.test.tsx',
+      'tests/integration/workspaceWallpaperLayer.test.tsx',
+      'tests/integration/vergerLab.test.tsx',
+    ],
+  ],
+);
+
+let failed = false;
+for (const [name, directory, args] of steps) {
+  // Simulator suites compete for CPU when each test file starts a worker.
+  const commandArgs = args[0] === 'vitest' ? [...args, '--maxWorkers=2'] : args;
+  const result = spawnSync(
+    process.env.npm_execpath ?? 'pnpm',
+    ['--dir', directory, 'exec', ...commandArgs],
+    {
+      cwd: root,
+      stdio: 'inherit',
+    },
+  );
+  const passed = result.status === 0;
+  console.log(`${passed ? 'PASS' : 'FAIL'}  ${name}`);
+  if (result.error) console.error(result.error);
+  if (!passed) failed = true;
+}
+console.log(`ALL_PASS=${failed ? 0 : 1}`);
+process.exitCode = failed ? 1 : 0;
diff --git a/scripts/verger-check.sh b/scripts/verger-check.sh
new file mode 100644
index 000000000..61a090fdf
--- /dev/null
+++ b/scripts/verger-check.sh
@@ -0,0 +1,31 @@
+#!/usr/bin/env bash
+# Verger's verification gate: every typecheck and test that guards verger, in one command.
+# Prints PASS/FAIL per step and exits non-zero if any step fails. Never commit on a FAIL.
+#   pnpm verger:check            # the gate (about 2-4 minutes)
+#   VERGER_RUNS=3000 pnpm verger:check   # deep property run (before a release or a policy change)
+set -u
+cd "$(dirname "$0")/.."
+failed=0
+step() {
+  local name="$1"; shift
+  if output=$("$@" 2>&1); then
+    echo "PASS  $name"
+  else
+    echo "FAIL  $name"
+    echo "$output" | tail -40 | sed 's/^/      /'
+    failed=1
+  fi
+}
+
+for pkg in verger-core verger-react verger-react-native verger-android verger-web; do
+  step "tsc $pkg" bash -c "cd packages/$pkg && npx tsc --noEmit -p ."
+done
+step "test verger-core" bash -c "cd packages/verger-core && npx vitest run"
+step "test verger-android" bash -c "cd packages/verger-android && npx vitest run"
+step "test verger-web" bash -c "cd packages/verger-web && npx vitest run"
+step "test gurudevi host (core/src/verger, property suites)" bash -c "cd packages/core && npx vitest run src/verger"
+step "test ui context" bash -c "cd packages/ui && pnpm exec vitest run --config vitest.config.mts src/context/__tests__ src/components/__tests__/Skeleton.verger.test.tsx src/components/__tests__/SovereignVirtualList.verger.test.tsx"
+step "test mobile runtime" bash -c "cd apps/gurudevi-mobile && npx vitest run src/__tests__/runtime src/__tests__/architecture/efficiency-policy-boundaries.test.ts"
+step "test web verger" bash -c "cd apps/gurudevi-web && npx vitest run tests/integration/gurudeviWebVerger.test.tsx tests/integration/workspaceWallpaperLayer.test.tsx tests/integration/vergerLab.test.tsx"
+
+if [ "$failed" = 0 ]; then echo "ALL_PASS=1"; else echo "ALL_PASS=0"; exit 1; fi
