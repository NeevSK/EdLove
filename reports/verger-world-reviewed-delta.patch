-  const longTasks = recentLongTasks(state, at);
-  const detail =
-    contention === 'js'
-      ? `JS thread saturated (${state.jsCores.toFixed(2)} cores, ${longTasks} long tasks)`
-      : `main thread saturated (${state.mainCores.toFixed(2)} cores)`;
