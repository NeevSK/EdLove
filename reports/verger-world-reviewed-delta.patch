diff --git a/apps/gurudevi-mobile/src/lib/navigation/fabTab.ts b/apps/gurudevi-mobile/src/lib/navigation/fabTab.ts
new file mode 100644
index 000000000..49387f462
--- /dev/null
+++ b/apps/gurudevi-mobile/src/lib/navigation/fabTab.ts
@@ -0,0 +1,26 @@
+import type { TabType } from '@repo/ui/types/fab';
+
+const FAB_TAB_BY_DOMAIN: Readonly<Record<string, TabType>> = {
+  self: 'self',
+  library: 'library',
+  workspace: 'classroom',
+  classroom: 'classroom',
+  community: 'community',
+  profile: 'profile',
+};
+
+/**
+ * The tab whose main action may show, from the route's segments. Expo Router paths leave out
+ * groups, so `/workspace` and `/(tabs)/workspace` are the same. Only a tab's home screen (and a
+ * classroom's dashboard) shows it: screens kept mounted beneath a pushed screen keep their
+ * registration, so deeper screens would show an action that is not theirs.
+ */
+export function getCurrentFabTab(pathname: string): TabType | null {
+  const segments = pathname.split('/').filter((segment) => segment && !segment.startsWith('('));
+  const tab = segments[0] ? FAB_TAB_BY_DOMAIN[segments[0]] : undefined;
+  if (!tab) return null;
+  if (segments.length === 1) return tab;
+  const classroomDashboard =
+    segments[0] === 'workspace' && segments[1] === 'classroom' && segments.length === 3;
+  return classroomDashboard ? tab : null;
+}
diff --git a/apps/gurudevi-mobile/src/lib/navigation/shellMetrics.ts b/apps/gurudevi-mobile/src/lib/navigation/shellMetrics.ts
new file mode 100644
index 000000000..f09eb6992
--- /dev/null
+++ b/apps/gurudevi-mobile/src/lib/navigation/shellMetrics.ts
@@ -0,0 +1,113 @@
+import { storage } from '@repo/core/native/storage';
+import type { ShellVariant } from './shellVariant';
+
+/**
+ * What each tab shell costs on this phone, kept per variant so A and B can be read side by side
+ * after switching. Time is attributed to the state verger reported for it: stressed frames and
+ * low memory are the two that a tab bar can cause.
+ */
+export interface ShellStats {
+  readonly launches: number;
+  /** Time observed with the shell on screen, in ms. */
+  readonly sampleMs: number;
+  /** Of that, time verger reported frames as stressed. */
+  readonly stressedMs: number;
+  /** Of that, time memory was trimmed or low. */
+  readonly memoryPressureMs: number;
+  /** Tab switches measured, from the press to the first frame of the new tab. */
+  readonly switches: number;
+  readonly switchMsTotal: number;
+  readonly switchMsMax: number;
+}
+
+export const EMPTY_STATS: ShellStats = {
+  launches: 0,
+  sampleMs: 0,
+  stressedMs: 0,
+  memoryPressureMs: 0,
+  switches: 0,
+  switchMsTotal: 0,
+  switchMsMax: 0,
+};
+
+/** Longer gaps mean the app slept; they would swamp the shares, so they are not counted. */
+const MAX_SAMPLE_MS = 10_000;
+
+export function addSample(
+  stats: ShellStats,
+  frameState: string,
+  memory: string,
+  ms: number,
+): ShellStats {
+  if (!(ms > 0)) return stats;
+  const t = Math.min(ms, MAX_SAMPLE_MS);
+  return {
+    ...stats,
+    sampleMs: stats.sampleMs + t,
+    stressedMs: stats.stressedMs + (frameState === 'stressed' ? t : 0),
+    memoryPressureMs: stats.memoryPressureMs + (memory === 'low' || memory === 'trimmed' ? t : 0),
+  };
+}
+
+export function addSwitch(stats: ShellStats, ms: number): ShellStats {
+  if (!(ms >= 0) || ms > MAX_SAMPLE_MS) return stats;
+  return {
+    ...stats,
+    switches: stats.switches + 1,
+    switchMsTotal: stats.switchMsTotal + ms,
+    switchMsMax: Math.max(stats.switchMsMax, ms),
+  };
+}
+
+export interface ShellSummary {
+  readonly minutes: number;
+  /** Share of observed time with stressed frames, 0–1. */
+  readonly stressedShare: number;
+  readonly memoryPressureShare: number;
+  readonly switches: number;
+  readonly meanSwitchMs: number | null;
+  readonly maxSwitchMs: number | null;
+}
+
+export function summarize(stats: ShellStats): ShellSummary {
+  const share = (part: number) => (stats.sampleMs > 0 ? part / stats.sampleMs : 0);
+  return {
+    minutes: Math.round(stats.sampleMs / 6000) / 10,
+    stressedShare: share(stats.stressedMs),
+    memoryPressureShare: share(stats.memoryPressureMs),
+    switches: stats.switches,
+    meanSwitchMs: stats.switches > 0 ? Math.round(stats.switchMsTotal / stats.switches) : null,
+    maxSwitchMs: stats.switches > 0 ? Math.round(stats.switchMsMax) : null,
+  };
+}
+
+const key = (variant: ShellVariant) => `gurudevi_shell_stats_v1_${variant}`;
+
+export function readStats(variant: ShellVariant): ShellStats {
+  try {
+    const raw = storage.getString(key(variant));
+    if (!raw) return EMPTY_STATS;
+    const parsed = JSON.parse(raw) as Partial<ShellStats>;
+    const out: Record<string, number> = { ...EMPTY_STATS };
+    for (const k of Object.keys(EMPTY_STATS)) {
+      const v = (parsed as Record<string, unknown>)[k];
+      if (typeof v === 'number' && Number.isFinite(v) && v >= 0) out[k] = v;
+    }
+    return out as unknown as ShellStats;
+  } catch {
+    return EMPTY_STATS;
+  }
+}
+
+export function writeStats(variant: ShellVariant, stats: ShellStats): void {
+  try {
+    storage.set(key(variant), JSON.stringify(stats));
+  } catch {
+    // Storage unavailable: numbers for this launch are lost, nothing else is affected.
+  }
+}
+
+export function resetStats(): void {
+  writeStats('custom', EMPTY_STATS);
+  writeStats('native', EMPTY_STATS);
+}
diff --git a/apps/gurudevi-mobile/src/lib/navigation/shellVariant.ts b/apps/gurudevi-mobile/src/lib/navigation/shellVariant.ts
new file mode 100644
index 000000000..bb0d61e9a
--- /dev/null
+++ b/apps/gurudevi-mobile/src/lib/navigation/shellVariant.ts
@@ -0,0 +1,118 @@
+import { storage } from '@repo/core/native/storage';
+import { fnv1a32 } from '@repo/verger-core';
+import { getAndroidId } from 'expo-application';
+import { useSyncExternalStore } from 'react';
+
+/**
+ * Which tab shell this launch draws, so the two can be compared on the same phone and across
+ * installs: `custom` is the JavaScript tab bar we have always had (A), `native` is Expo Router's
+ * `NativeTabs`, the system tab bar (B). Both serve the same routes, header and modals.
+ */
+export type ShellVariant = 'custom' | 'native';
+
+export type ShellVariantReason = 'override' | 'remote' | 'build' | 'split' | 'default';
+
+export interface ShellVariantChoice {
+  readonly variant: ShellVariant;
+  readonly reason: ShellVariantReason;
+  /** The install's bucket (0–99) when a split decided; null otherwise. */
+  readonly bucket: number | null;
+}
+
+declare global {
+  // Remote config may force a shell for everyone ('custom' is the kill switch).
+  var __GURUDEVI_SHELL_VARIANT__: unknown;
+}
+
+const OVERRIDE_KEY = 'gurudevi_shell_variant_override_v1';
+/** Part of the split key: bump it to reshuffle installs between A and B. */
+export const SHELL_EXPERIMENT_KEY = 'gurudevi-shell-tabs-v1';
+
+export function isShellVariant(value: unknown): value is ShellVariant {
+  return value === 'custom' || value === 'native';
+}
+
+/**
+ * The shell for this launch. A person's own choice in the shell lab wins, then remote config,
+ * then the build, then a stable split of installs (`EXPO_PUBLIC_GURUDEVI_NATIVE_TABS_PERCENT`),
+ * then the custom tabs. Unknown values are ignored, never guessed.
+ */
+export function resolveShellVariant(input: {
+  readonly override?: unknown;
+  readonly remote?: unknown;
+  readonly build?: unknown;
+  readonly nativePercent?: number;
+  readonly installId?: string | null;
+}): ShellVariantChoice {
+  if (isShellVariant(input.override))
+    return { variant: input.override, reason: 'override', bucket: null };
+  if (isShellVariant(input.remote))
+    return { variant: input.remote, reason: 'remote', bucket: null };
+  if (isShellVariant(input.build)) return { variant: input.build, reason: 'build', bucket: null };
+  const percent = Math.max(0, Math.min(100, input.nativePercent ?? 0));
+  if (percent > 0 && input.installId) {
+    const bucket = fnv1a32(`${SHELL_EXPERIMENT_KEY}:${input.installId}`) % 100;
+    return { variant: bucket < percent ? 'native' : 'custom', reason: 'split', bucket };
+  }
+  return { variant: 'custom', reason: 'default', bucket: null };
+}
+
+function readInstallId(): string | null {
+  try {
+    return getAndroidId();
+  } catch {
+    return null;
+  }
+}
+
+function readOverride(): ShellVariant | null {
+  try {
+    const value = storage.getString(OVERRIDE_KEY);
+    return isShellVariant(value) ? value : null;
+  } catch {
+    return null;
+  }
+}
+
+function readChoice(): ShellVariantChoice {
+  const nativePercent = Number(process.env.EXPO_PUBLIC_GURUDEVI_NATIVE_TABS_PERCENT ?? '0');
+  return resolveShellVariant({
+    override: readOverride(),
+    remote: globalThis.__GURUDEVI_SHELL_VARIANT__,
+    build: process.env.EXPO_PUBLIC_GURUDEVI_SHELL,
+    nativePercent: Number.isFinite(nativePercent) ? nativePercent : 0,
+    installId: nativePercent > 0 ? readInstallId() : null,
+  });
+}
+
+let current: ShellVariantChoice | null = null;
+const listeners = new Set<() => void>();
+
+export function getShellVariant(): ShellVariantChoice {
+  current ??= readChoice();
+  return current;
+}
+
+/**
+ * Choose a shell on this phone (the shell lab). `null` clears the choice and returns to the
+ * assignment. The tab navigator remounts, so open tabs start fresh.
+ */
+export function setShellVariantOverride(variant: ShellVariant | null): void {
+  try {
+    if (variant) storage.set(OVERRIDE_KEY, variant);
+    else storage.delete(OVERRIDE_KEY);
+  } catch {
+    // Storage unavailable: the choice holds for this launch only.
+  }
+  current = variant ? { variant, reason: 'override', bucket: null } : readChoice();
+  for (const listener of listeners) listener();
+}
+
+function subscribe(listener: () => void): () => void {
+  listeners.add(listener);
+  return () => listeners.delete(listener);
+}
+
+export function useShellVariant(): ShellVariantChoice {
+  return useSyncExternalStore(subscribe, getShellVariant, getShellVariant);
+}
