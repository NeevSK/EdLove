+import { describe, expect, it } from 'vitest';
+import { buildResponsiveWallpaperUrl, type WallpaperReading, wallpaperOf } from './wallpaper';
+
+const wallpaper = {
+  provider: 'cloudinary' as const,
+  url: 'https://res.cloudinary.com/example/image/upload/wallpaper.jpg',
+  publicId: 'gurudevi/user/wallpapers/example',
+  width: 1600,
+  height: 900,
+};
+
+const calm: WallpaperReading = { networkLimit: 'none', powerSaver: false, visibility: 'active' };
+const high = { deviceTier: 'high', effectiveFidelity: 'high', allowBlur: true } as const;
+const mid = { deviceTier: 'medium', effectiveFidelity: 'high', allowBlur: false } as const;
+const low = { deviceTier: 'low', effectiveFidelity: 'low', allowBlur: false } as const;
+const OFF = { enabled: false, allowBlur: false, opacity: 0, url: null };
+
+describe('the wallpaper, as verger allows it', () => {
+  it('derives a bounded Cloudinary transform without accepting another host', () => {
+    expect(buildResponsiveWallpaperUrl(wallpaper.url, 1280)).toContain(
+      '/image/upload/c_limit,w_1280,q_auto,f_auto/',
+    );
+    expect(buildResponsiveWallpaperUrl('https://example.com/wallpaper.jpg', 1280)).toBe(
+      'https://example.com/wallpaper.jpg',
+    );
+  });
+
+  it('removes wallpaper work where fidelity is low (a low phone)', () => {
+    expect(wallpaperOf(wallpaper, low, calm)).toEqual(OFF);
+  });
+
+  it('keeps a static low-opacity image for mid phones', () => {
+    expect(wallpaperOf(wallpaper, mid, calm)).toMatchObject({
+      enabled: true,
+      allowBlur: false,
+      opacity: 0.12,
+      url: expect.stringContaining('c_limit,w_1280,q_auto,f_auto'),
+    });
+  });
+
+  it('gives a high phone the sharp image, blurred only when the blur lever allows', () => {
+    expect(wallpaperOf(wallpaper, high, calm)).toMatchObject({
+      enabled: true,
+      allowBlur: true,
+      opacity: 0.2,
+    });
+    expect(wallpaperOf(wallpaper, { ...high, allowBlur: false }, calm).allowBlur).toBe(false);
+  });
+
+  it('waits whenever data, energy or attention is short', () => {
+    for (const networkLimit of ['offline', 'data-saver', 'slow', 'unstable'] as const)
+      expect(wallpaperOf(wallpaper, high, { ...calm, networkLimit })).toEqual(OFF);
+    expect(wallpaperOf(wallpaper, high, { ...calm, powerSaver: true })).toEqual(OFF);
+    expect(wallpaperOf(wallpaper, high, { ...calm, visibility: 'background' })).toEqual(OFF);
+  });
+
+  it('scales the requested asset width to the viewport and pixel-ratio budget', () => {
+    expect(wallpaperOf(wallpaper, mid, calm, 390).url).toContain('c_limit,w_390,q_auto,f_auto');
+    expect(wallpaperOf(wallpaper, high, calm, 390).url).toContain('c_limit,w_585,q_auto,f_auto');
+  });
+});
diff --git a/packages/core/src/verger/wallpaper.ts b/packages/core/src/verger/wallpaper.ts
new file mode 100644
index 000000000..901fd8fff
--- /dev/null
+++ b/packages/core/src/verger/wallpaper.ts
@@ -0,0 +1,79 @@
+import type { WorkspaceWallpaper } from '@repo/core/types';
+import type { VergerSnapshot } from '@repo/verger-core';
+import type { GurudeviExperience } from './experience';
+
+export interface WallpaperPresentation {
+  enabled: boolean;
+  allowBlur: boolean;
+  opacity: number;
+  url: string | null;
+}
+
+export function buildResponsiveWallpaperUrl(url: string, width: number): string {
+  if (!Number.isSafeInteger(width) || width <= 0) return url;
+  try {
+    const parsed = new URL(url);
+    if (
+      parsed.protocol !== 'https:' ||
+      (parsed.hostname !== 'res.cloudinary.com' && !parsed.hostname.endsWith('.res.cloudinary.com'))
+    ) {
+      return url;
+    }
+    const marker = '/image/upload/';
+    const markerIndex = parsed.pathname.indexOf(marker);
+    if (markerIndex < 0) return url;
+    const prefixEnd = markerIndex + marker.length;
+    parsed.pathname = `${parsed.pathname.slice(0, prefixEnd)}c_limit,w_${width},q_auto,f_auto/${parsed.pathname.slice(prefixEnd)}`;
+    return parsed.toString();
+  } catch {
+    return url;
+  }
+}
+
+/** What verger says now that a decorative image depends on. */
+export type WallpaperReading = Pick<VergerSnapshot, 'networkLimit' | 'powerSaver' | 'visibility'>;
+
+const OFF: WallpaperPresentation = { enabled: false, allowBlur: false, opacity: 0, url: null };
+
+/**
+ * Whether decorative wallpapers may show (and rotate) now: they wait whenever data, energy or
+ * attention is short (offline, Data Saver, a slow or unstable link, battery saver, a hidden app)
+ * and where fidelity is low.
+ */
+export function wallpaperAllowed(
+  view: Pick<GurudeviExperience, 'effectiveFidelity'>,
+  reading: WallpaperReading,
+): boolean {
+  return (
+    view.effectiveFidelity !== 'low' &&
+    reading.visibility === 'active' &&
+    !reading.powerSaver &&
+    reading.networkLimit === 'none'
+  );
+}
+
+/**
+ * The workspace wallpaper, as verger allows it (`wallpaperAllowed`). A high phone gets the sharp
+ * image; any other a smaller one. Blur follows the blur lever.
+ */
+export function wallpaperOf(
+  wallpaper: WorkspaceWallpaper | undefined,
+  view: Pick<GurudeviExperience, 'deviceTier' | 'effectiveFidelity' | 'allowBlur'>,
+  reading: WallpaperReading,
+  viewportWidth?: number,
+): WallpaperPresentation {
+  if (!wallpaper || !wallpaperAllowed(view, reading)) return OFF;
+  const rich = view.deviceTier === 'high';
+  const qualityWidth = rich ? 1920 : 1280;
+  const devicePixelRatio = rich ? 1.5 : 1;
+  const responsiveWidth =
+    typeof viewportWidth === 'number' && Number.isFinite(viewportWidth) && viewportWidth > 0
+      ? Math.min(qualityWidth, Math.ceil(viewportWidth * devicePixelRatio))
+      : qualityWidth;
+  return {
+    enabled: true,
+    allowBlur: view.allowBlur,
+    opacity: rich ? 0.2 : 0.12,
+    url: buildResponsiveWallpaperUrl(wallpaper.url, responsiveWidth),
+  };
+}
