diff --git a/packages/ui/src/scene/__tests__/sceneContrast.test.ts b/packages/ui/src/scene/__tests__/sceneContrast.test.ts
new file mode 100644
index 000000000..9ea89c405
--- /dev/null
+++ b/packages/ui/src/scene/__tests__/sceneContrast.test.ts
@@ -0,0 +1,75 @@
+import {
+  contrastRatio,
+  daylightAt,
+  landscapeColours,
+  mixHex,
+  resolveScene,
+  type SceneWeather,
+  WEATHER,
+} from '@repo/core/scene';
+import { experienceOf } from '@repo/core/verger';
+import { resolveWorld } from '../../world/resolve';
+import type { WorldPhase } from '../../world/types';
+import { WORLD_IDS } from '../../world/worlds';
+import { BAND_WASH_TEXT } from '../wash';
+
+const budget = experienceOf({ levels: {}, capacityClass: 'high' }, { fidelity: 'auto' });
+const WEATHERS = Object.keys(WEATHER) as SceneWeather[];
+const DARK: readonly WorldPhase[] = ['predawn', 'dusk', 'night'];
+
+describe('scene band contrast', { tags: ['a11y', 'unit'] }, () => {
+  it('header text keeps 4.5:1 over the band in every world, hour and weather', () => {
+    const failures: string[] = [];
+    for (const id of WORLD_IDS) {
+      for (const weather of WEATHERS) {
+        for (let minute = 0; minute < 1440; minute += 15) {
+          const probe = resolveScene({
+            now: new Date(2026, 9, 26),
+            minute,
+            weather,
+            world: { id, glow: '#FFFFFF' },
+            room: 'classroom',
+            presence: 'band',
+            budget,
+          });
+          const world = resolveWorld(
+            id,
+            probe.phase,
+            DARK.includes(probe.phase) ? 'dark' : 'light',
+          );
+          const scene = resolveScene({
+            now: new Date(2026, 9, 26),
+            minute,
+            weather,
+            world: { id, glow: world.tokens.glow },
+            room: 'classroom',
+            presence: 'band',
+            budget,
+          });
+          const p = scene.palette;
+          if (!p) continue;
+          const c = landscapeColours(p, daylightAt(minute), world.tokens.glow);
+          // A band draws the sun's halo and the moon's glow but never their discs (SceneStill).
+          const behind = [
+            p.top,
+            p.horizon,
+            p.hillFar,
+            p.hillNear,
+            c.shore,
+            ...c.waterStops,
+            mixHex(p.top, p.halo, 0.85),
+          ];
+          for (const colour of behind) {
+            const veiled = mixHex(colour, world.tokens.ground, BAND_WASH_TEXT);
+            for (const ink of [world.tokens.ink, world.tokens.inkSoft]) {
+              const ratio = contrastRatio(ink, veiled);
+              if (ratio < 4.5)
+                failures.push(`${id} ${weather} ${minute} ${colour} ${ratio.toFixed(2)}`);
+            }
+          }
+        }
+      }
+    }
+    expect(failures.length, failures.slice(0, 8).join('\n')).toBe(0);
+  });
+});
diff --git a/packages/ui/src/scene/native/SceneBackdrop.tsx b/packages/ui/src/scene/native/SceneBackdrop.tsx
new file mode 100644
index 000000000..6a21f36ba
--- /dev/null
+++ b/packages/ui/src/scene/native/SceneBackdrop.tsx
@@ -0,0 +1,118 @@
+/**
+ * The scene behind a screen or a header: the still layer on one canvas and the moving layer on
+ * another, so the still one never redraws for a raindrop. It fills its parent. At `full` the
+ * parent sees the whole landscape; at `band` (a header) it sees the sky, the hills and the shore
+ * under a veil of the world's ground; at `quiet`, or when verger allows no painting, it draws
+ * nothing and the world's own ground (already tinted by the hour) shows through.
+ */
+
+import {
+  daylightAt,
+  landscapeColours,
+  landscapeOf,
+  mixHex,
+  SCENE_LIGHT,
+  type Scene,
+} from '@repo/core/scene';
+import { useMemo, useState } from 'react';
+import { type LayoutChangeEvent, Platform, StyleSheet, View, type ViewStyle } from 'react-native';
+import { Canvas, LinearGradient, Rect, vec } from 'react-native-skia';
+import { useWorld } from '../../world/native/WorldContext';
+import { SceneStill } from './SceneStill';
+import { SceneWeather } from './SceneWeather';
+
+export interface SceneBackdropProps {
+  scene: Scene;
+  /**
+   * A veil of the world's ground over the scene, so text on it keeps its contrast: `edge` at
+   * the top, rising to `text` from `textFrom` (a share of the height) down. See `../wash`.
+   */
+  wash?: { colour: string; edge: number; text: number; textFrom: number };
+  style?: ViewStyle;
+}
+
+function alphaHex(hex: string, a: number): string {
+  return `${hex}${Math.round(Math.max(0, Math.min(1, a)) * 255)
+    .toString(16)
+    .padStart(2, '0')}`;
+}
+
+export function SceneBackdrop({ scene, wash, style }: SceneBackdropProps) {
+  const glow = useWorld().tokens.glow;
+  const [size, setSize] = useState<{ width: number; height: number } | null>(null);
+  const onLayout = (event: LayoutChangeEvent) => {
+    const { width, height } = event.nativeEvent.layout;
+    setSize((prev) =>
+      prev && prev.width === width && prev.height === height ? prev : { width, height },
+    );
+  };
+  const band = scene.presence === 'band';
+  const width = size?.width ?? 0;
+  const height = size?.height ?? 0;
+  // A band draws the landscape short enough that the horizon, hills and shore sit inside it.
+  const drawHeight = band ? height / 0.7 : height;
+  const landscape = useMemo(
+    () =>
+      width > 0 && height > 0
+        ? landscapeOf(scene.view, width, drawHeight, scene.tier === 'rich')
+        : null,
+    [scene.view, scene.tier, width, height, drawHeight],
+  );
+  const colours = useMemo(
+    () => (scene.palette ? landscapeColours(scene.palette, daylightAt(scene.minute), glow) : null),
+    [scene.palette, scene.minute, glow],
+  );
+
+  // The web paints its own floors; the scene comes there later, through the same resolver.
+  if (scene.paint === 'none' || Platform.OS === 'web') return null;
+  if (scene.paint === 'colour') {
+    return (
+      <View
+        pointerEvents="none"
+        style={[StyleSheet.absoluteFill, { backgroundColor: scene.colour ?? undefined }, style]}
+      />
+    );
+  }
+  return (
+    <View
+      pointerEvents="none"
+      style={[StyleSheet.absoluteFill, { overflow: 'hidden' }, style]}
+      onLayout={onLayout}
+    >
+      {landscape && colours && scene.palette ? (
+        <>
+          <Canvas style={{ width, height }}>
+            <SceneStill
+              scene={scene}
+              landscape={landscape}
+              colours={colours}
+              glow={glow}
+              clipHeight={band ? height : undefined}
+            />
+            {wash ? (
+              <Rect x={0} y={0} width={width} height={height}>
+                <LinearGradient
+                  start={vec(0, 0)}
+                  end={vec(0, height)}
+                  colors={[
+                    alphaHex(wash.colour, wash.edge),
+                    alphaHex(wash.colour, wash.edge),
+                    alphaHex(wash.colour, wash.text),
+                    alphaHex(wash.colour, wash.text),
+                  ]}
+                  positions={[0, Math.max(0, wash.textFrom - 0.12), wash.textFrom, 1]}
+                />
+              </Rect>
+            ) : null}
+          </Canvas>
+          <SceneWeather
+            scene={scene}
+            width={width}
+            height={height}
+            rainColour={`${mixHex(scene.palette.horizon, SCENE_LIGHT.white, 0.4)}${band ? '33' : '66'}`}
+          />
+        </>
+      ) : null}
+    </View>
+  );
+}
diff --git a/packages/ui/src/scene/native/SceneStill.tsx b/packages/ui/src/scene/native/SceneStill.tsx
new file mode 100644
index 000000000..5d6453d69
--- /dev/null
+++ b/packages/ui/src/scene/native/SceneStill.tsx
@@ -0,0 +1,333 @@
+/**
+ * The still layer of a scene, as a Skia element tree: sky, sun or moon, hills, the wewa, paddy
+ * and palms. It holds no animated values, so its canvas draws once and redraws only when the
+ * scene changes (about once a minute). Pure Skia elements, so it also renders headless for the
+ * screenshot grid (`scripts/scene-shots.mjs`).
+ */
+
+import {
+  daylightAt,
+  SCENE_LIGHT as L,
+  type Landscape,
+  type LandscapeColours,
+  mixHex,
+  type Scene,
+  WEATHER,
+} from '@repo/core/scene';
+import {
+  Circle,
+  Group,
+  LinearGradient,
+  Oval,
+  Path,
+  RadialGradient,
+  Rect,
+  vec,
+} from 'react-native-skia';
+
+export interface SceneStillProps {
+  scene: Scene;
+  landscape: Landscape;
+  colours: LandscapeColours;
+  /** The world's glow, which warms the low sun. */
+  glow: string;
+  /** Draw only the sky down to this height (the band presence); the whole scene when omitted. */
+  clipHeight?: number;
+}
+
+const alpha = (hex: string, a: number) => {
+  const v = Math.round(Math.max(0, Math.min(1, a)) * 255)
+    .toString(16)
+    .padStart(2, '0');
+  return `${hex}${v}`;
+};
+
+export function SceneStill({
+  scene,
+  landscape: ls,
+  colours: c,
+  glow,
+  clipHeight,
+}: SceneStillProps) {
+  const palette = scene.palette;
+  if (!palette) return null;
+  const W = ls.width;
+  const H = ls.height;
+  const hy = ls.horizonY;
+  const wx = WEATHER[scene.weather];
+  const veil = 1 - wx.cloud * 0.8;
+  const light = daylightAt(scene.minute);
+  const cel = scene.celestial;
+  const cx = W * cel.x;
+  const cy = hy - cel.lift * hy + 10;
+  const day = cel.body === 'sun';
+  const sunLow = day ? Math.max(0, 1 - cel.lift * 2.8) : 0;
+  const moonR = Math.max(11, W * 0.013);
+  const moonShift =
+    scene.moonPhase < 0.5
+      ? -moonR * 2 * (scene.moonPhase / 0.5)
+      : moonR * 2 * ((1 - scene.moonPhase) / 0.5);
+  const cloudColour = mixHex(palette.horizon, light > 0.3 ? L.white : L.cloudNight, 0.35);
+  const cloudAlpha = 0.14 + wx.cloud * 0.36;
+  const showStars = scene.particles.stars > 0;
+
+  return (
+    <Group clip={clipHeight ? { x: 0, y: 0, width: W, height: clipHeight } : undefined}>
+      <Rect x={0} y={0} width={W} height={hy + 2}>
+        <LinearGradient
+          start={vec(0, 0)}
+          end={vec(0, hy)}
+          colors={[palette.top, mixHex(palette.top, palette.horizon, 0.7), palette.horizon]}
+          positions={[0, 0.72, 1]}
+        />
+      </Rect>
+
+      {showStars
+        ? ls.stars
+            .slice(0, scene.particles.stars * 4)
+            .map((s, i) => (
+              <Circle
+                key={`s${i}`}
+                cx={s.x}
+                cy={s.y}
+                r={s.r * 0.8}
+                color={alpha(L.star, (0.45 + (i % 5) * 0.08) * (1 - wx.cloud))}
+              />
+            ))
+        : null}
+
+      {day ? (
+        <Group>
+          <Rect x={0} y={0} width={W} height={hy}>
+            <RadialGradient
+              c={vec(cx, cy)}
+              r={Math.max(W, H) * 0.42}
+              colors={[
+                alpha(palette.halo, 0.75 * veil + 0.1),
+                alpha(palette.halo, 0.32 * veil + 0.05),
+                alpha(palette.halo, 0),
+              ]}
+              positions={[0, 0.12, 1]}
+            />
+          </Rect>
+          {/* No sun or moon disc in a band: it would sit behind header text. */}
+          {veil > 0.25 && !clipHeight ? (
+            <Circle
+              cx={cx}
+              cy={cy}
+              r={Math.max(14, W * 0.018)}
+              color={alpha(L.sunDisc, Math.min(1, veil + 0.1))}
+            />
+          ) : null}
+        </Group>
+      ) : (
+        <Group>
+          <Circle cx={cx} cy={cy} r={moonR * 9}>
+            <RadialGradient
+              c={vec(cx, cy)}
+              r={moonR * 9}
+              colors={[alpha(L.moonGlow, 0.28 * veil + 0.04), alpha(L.moonGlow, 0)]}
+            />
+          </Circle>
+          {veil > 0.3 && !clipHeight ? (
+            <Group
+              clip={{
+                rect: { x: cx - moonR, y: cy - moonR, width: moonR * 2, height: moonR * 2 },
+                rx: moonR,
+                ry: moonR,
+              }}
+            >
+              <Circle cx={cx} cy={cy} r={moonR} color={alpha(L.moonDisc, veil)} />
+              {/* The shadow disc covers the moon at new moon and slides off by the poya full moon. */}
+              <Circle
+                cx={cx + moonShift}
+                cy={cy}
+                r={moonR * 1.04}
+                color={alpha(palette.top, 0.93)}
+              />
+            </Group>
+          ) : null}
+        </Group>
+      )}
+
+      {sunLow > 0 ? (
+        <Rect x={0} y={hy - H * 0.22} width={W} height={H * 0.22}>
+          <LinearGradient
+            start={vec(0, hy - H * 0.22)}
+            end={vec(0, hy)}
+            colors={[
+              alpha(glow, 0),
+              alpha(mixHex(L.sunLow, glow, 0.3), 0.35 * sunLow * veil + 0.05),
+            ]}
+          />
+        </Rect>
+      ) : null}
+
+      {ls.clouds.map((cl, i) => (
+        <Oval
+          key={`c${i}`}
+          x={cl.cx - cl.rx}
+          y={cl.cy - cl.ry}
+          width={cl.rx * 2}
+          height={cl.ry * 2}
+        >
+          <RadialGradient
+            c={vec(cl.cx, cl.cy)}
+            r={cl.rx}
+            colors={[
+              alpha(cloudColour, i < 6 + wx.cloud * 24 ? cloudAlpha : 0),
+              alpha(cloudColour, 0),
+            ]}
+          />
+        </Oval>
+      ))}
+
+      {ls.hills.map((hill, i) => (
+        <Path key={`h${i}`} path={hill.d}>
+          <LinearGradient
+            start={vec(0, hill.top)}
+            end={vec(0, hy)}
+            colors={c.hills[i] ?? [palette.hillFar, palette.horizon]}
+          />
+        </Path>
+      ))}
+      <Path path={ls.shore} color={c.shore} />
+
+      <Rect x={0} y={ls.waterTop} width={W} height={ls.waterBottom - ls.waterTop}>
+        <LinearGradient
+          start={vec(0, ls.waterTop)}
+          end={vec(0, ls.waterBottom)}
+          colors={[...c.waterStops]}
+          positions={[0, 0.55, 1]}
+        />
+      </Rect>
+      <Path path={ls.shoreReflection} color={alpha(c.shore, 0.35)} />
+      {(day ? veil > 0.2 : veil > 0.35)
+        ? Array.from({ length: 18 }, (_, i) => {
+            const y = ls.waterTop + (i / 18) * (ls.waterBottom - ls.waterTop);
+            const w = (14 + ((i * 37) % 23)) * (1 + i / 9);
+            return (
+              <Rect
+                key={`g${i}`}
+                x={cx - w / 2}
+                y={y}
+                width={w}
+                height={1.4}
+                color={alpha(c.glint, (0.5 - i / 44) * veil)}
+              />
+            );
+          })
+        : null}
+      {ls.glints.map((g, i) => (
+        <Rect
+          key={`w${i}`}
+          x={g.x}
+          y={g.y}
+          width={g.w}
+          height={1}
+          color={alpha(L.white, g.a * (0.3 + light))}
+        />
+      ))}
+      <Path path={ls.lotusPads} color={c.lotus} />
+      {light > 0.3
+        ? ls.lotusFlowers.map((f, i) => (
+            <Oval
+              key={`l${i}`}
+              x={f.cx - f.rx}
+              y={f.cy - f.ry}
+              width={f.rx * 2}
+              height={f.ry * 2}
+              color={alpha(c.lotusFlower, 0.9)}
+            />
+          ))
+        : null}
+
+      <Rect
+        x={0}
+        y={ls.waterBottom - 2}
+        width={W}
+        height={H - ls.waterBottom + 2}
+        color={c.paddyBase}
+      />
+      {ls.terraces.map((d, i) => (
+        <Path key={`t${i}`} path={d} color={c.terraces[i] ?? c.paddyBase} />
+      ))}
+      {ls.bunds.map((b, i) => (
+        <Path
+          key={`b${i}`}
+          path={b.d}
+          style="stroke"
+          strokeWidth={b.width}
+          color={alpha(c.bund, 0.55)}
+        />
+      ))}
+      {scene.tier === 'rich' && ls.stalks ? (
+        <Path
+          path={ls.stalks}
+          style="stroke"
+          strokeWidth={1}
+          color={alpha(c.stalk, 0.25 + light * 0.2)}
+        />
+      ) : null}
+
+      {ls.palms.map((p, i) => (
+        <Group key={`p${i}`}>
+          <Path
+            path={p.trunk}
+            style="stroke"
+            strokeWidth={p.trunkWidth}
+            strokeCap="round"
+            color={c.silhouette}
+          />
+          <Path
+            path={p.fronds}
+            style="stroke"
+            strokeWidth={p.frondWidth}
+            strokeCap="round"
+            color={c.silhouette}
+          />
+          <Path path={p.leaflets} style="stroke" strokeWidth={1} color={c.silhouette} />
+          <Circle cx={p.crown.cx} cy={p.crown.cy} r={p.crown.r} color={c.silhouette} />
+        </Group>
+      ))}
+      {ls.kumbuk ? (
+        <Group>
+          <Path path={ls.kumbuk.trunk} color={c.silhouette} />
+          {ls.kumbuk.crowns.map((e, i) => (
+            <Oval
+              key={`k${i}`}
+              x={e.cx - e.rx}
+              y={e.cy - e.ry}
+              width={e.rx * 2}
+              height={e.ry * 2}
+              color={c.silhouette}
+            />
+          ))}
+        </Group>
+      ) : null}
+
+      {wx.mist ? (
+        <Rect x={0} y={H * 0.5} width={W} height={H * 0.35}>
+          <LinearGradient
+            start={vec(0, H * 0.5)}
+            end={vec(0, H * 0.85)}
+            colors={[
+              alpha(L.mist, 0),
+              alpha(mixHex(L.mist, palette.horizon, 0.3), 0.22 + light * 0.12),
+              alpha(L.mist, 0),
+            ]}
+          />
+        </Rect>
+      ) : null}
+      {wx.rain > 0 ? (
+        <Rect
+          x={0}
+          y={0}
+          width={W}
+          height={H}
+          color={alpha(mixHex(palette.horizon, L.rainVeil, 0.5), 0.06 + wx.dim * 0.1)}
+        />
+      ) : null}
+    </Group>
+  );
+}
diff --git a/packages/ui/src/scene/native/SceneWeather.tsx b/packages/ui/src/scene/native/SceneWeather.tsx
new file mode 100644
index 000000000..3c422b3d9
--- /dev/null
+++ b/packages/ui/src/scene/native/SceneWeather.tsx
@@ -0,0 +1,91 @@
+/**
+ * The moving layer: rain and fireflies, on its own transparent canvas above the still layer, so
+ * only this layer redraws each frame. Runs on the UI thread, capped at the scene's fps (30, 15,
+ * or not at all), and stops whenever the scene says so: a hidden screen, verger's still motion,
+ * or no particles. Positions are a pure function of time, so nothing is allocated per drop.
+ */
+
+import { SCENE_LIGHT, type Scene } from '@repo/core/scene';
+import { useEffect } from 'react';
+import { StyleSheet } from 'react-native';
+import { useDerivedValue, useFrameCallback, useSharedValue } from 'react-native-reanimated';
+import { BlurMask, Canvas, Path, Skia } from 'react-native-skia';
+
+export interface SceneWeatherProps {
+  scene: Scene;
+  width: number;
+  height: number;
+  /** Rain colour, from the sky. */
+  rainColour: string;
+}
+
+const WIND = 0.18;
+
+export function SceneWeather({ scene, width, height, rainColour }: SceneWeatherProps) {
+  const fps = scene.fps;
+  const drops = scene.particles.rain;
+  const flies = scene.particles.fireflies;
+  const active = fps > 0 && (drops > 0 || flies > 0);
+  const time = useSharedValue(0);
+  const last = useSharedValue(0);
+  const frameMs = fps > 0 ? 1000 / fps : 1000;
+
+  const frames = useFrameCallback((info) => {
+    'worklet';
+    const now = info.timeSinceFirstFrame;
+    if (now - last.value >= frameMs) {
+      last.value = now;
+      time.value = now;
+    }
+  }, false);
+
+  useEffect(() => {
+    frames.setActive(active);
+    return () => frames.setActive(false);
+  }, [active, frames]);
+
+  const rain = useDerivedValue(() => {
+    const path = Skia.PathBuilder.Make();
+    const t = time.value / 1000;
+    for (let i = 0; i < drops; i++) {
+      // Two cheap hashes give each drop a lane and a speed.
+      const a = Math.sin(i * 12.9898) * 43758.5453;
+      const b = Math.sin(i * 78.233) * 12345.6789;
+      const lane = a - Math.floor(a);
+      const speed = 0.55 + (b - Math.floor(b)) * 0.45;
+      const fall = height * 1.1;
+      const y = ((lane * fall + t * speed * 620) % fall) - 20;
+      const x = (((lane * 7.31) % 1) * width * 1.2 - width * 0.1 + y * WIND) % (width * 1.1);
+      const len = 8 + speed * 10;
+      path.moveTo(x, y);
+      path.lineTo(x - len * WIND, y - len);
+    }
+    return path.detach();
+  });
+
+  const fireflies = useDerivedValue(() => {
+    const path = Skia.PathBuilder.Make();
+    const t = time.value / 1000;
+    for (let i = 0; i < flies; i++) {
+      const s = Math.sin(i * 91.7) * 9999.1;
+      const seed = s - Math.floor(s);
+      const x = width * ((seed + Math.sin(t * 0.07 + i) * 0.06 + 1) % 1);
+      const y = height * (0.72 + seed * 0.24) + Math.sin(t * 0.5 + i * 2.1) * 8;
+      const glow = Math.max(0, Math.sin(t * 2.2 + seed * 6.28));
+      if (glow > 0.15) path.addCircle(x, y, 1.6 + glow * 1.8);
+    }
+    return path.detach();
+  });
+
+  if (!active) return null;
+  return (
+    <Canvas style={StyleSheet.absoluteFill} pointerEvents="none">
+      {drops > 0 ? <Path path={rain} style="stroke" strokeWidth={1} color={rainColour} /> : null}
+      {flies > 0 ? (
+        <Path path={fireflies} color={`${SCENE_LIGHT.firefly}D9`}>
+          <BlurMask blur={3} style="solid" />
+        </Path>
+      ) : null}
+    </Canvas>
+  );
+}
