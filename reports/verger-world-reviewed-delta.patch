+  if (trace.length < minSamples) return null;
+  const n = trace.length;
+  const meanT = trace.reduce((sum, [t]) => sum + t, 0) / n;
+  const meanV = trace.reduce((sum, [, v]) => sum + v, 0) / n;
+  let num = 0;
+  let den = 0;
+  for (const [t, v] of trace) {
