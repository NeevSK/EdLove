+import { observeEventLoopLag, observeJsHeap } from '@repo/verger-react';
+import { afterEach, describe, expect, it, vi } from 'vitest';
+
+afterEach(() => {
+  vi.useRealTimers();
+  vi.unstubAllGlobals();
+});
+
+describe('event-loop lag sampler', () => {
+  it('reports each window’s worst lateness; a stall on the JS thread shows as lag', () => {
+    vi.useFakeTimers();
+    let clock = 0;
+    const now = () => clock;
+    const lags: number[] = [];
+    const stop = observeEventLoopLag((lag) => lags.push(lag), () => false, now, 500, 2000);
+    // Four on-time ticks: a window with no lag.
+    for (let i = 0; i < 4; i += 1) {
+      clock += 500;
+      vi.advanceTimersByTime(500);
+    }
+    expect(lags).toEqual([0]);
+    // The thread is busy for 300 ms past a tick's due time.
+    clock += 800;
+    vi.advanceTimersByTime(500);
+    for (let i = 0; i < 3; i += 1) {
+      clock += 500;
+      vi.advanceTimersByTime(500);
+    }
+    expect(lags.at(-1)).toBe(300);
+    stop();
+  });
+
+  it('measures nothing while hidden, nor on the first tick back', () => {
+    vi.useFakeTimers();
+    let clock = 0;
+    let hidden = true;
+    const lags: number[] = [];
+    const stop = observeEventLoopLag((lag) => lags.push(lag), () => hidden, () => clock, 500, 1000);
+    // A throttled background timer fires 60 s late.
+    clock += 60_000;
+    vi.advanceTimersByTime(500);
+    hidden = false;
+    clock += 5_000; // the first tick back is late too
+    vi.advanceTimersByTime(500);
+    for (let i = 0; i < 3; i += 1) {
+      clock += 500;
+      vi.advanceTimersByTime(500);
+    }
+    expect(lags).toEqual([0]);
+    stop();
+  });
+});
+
+describe('Hermes GC sampler', () => {
+  it('reports the share of wall time in GC pauses (js_gcTime is in seconds)', () => {
+    vi.useFakeTimers();
+    let clock = 0;
+    let gcSeconds = 1;
+    vi.stubGlobal('HermesInternal', {
+      getInstrumentedStats: () => ({ js_gcTime: gcSeconds, js_allocatedBytes: 4_000_000 }),
+    });
+    const samples: [number, number | null][] = [];
+    const stop = observeJsHeap((share, bytes) => samples.push([share, bytes]), () => false, () => clock, 10_000);
+    gcSeconds += 0.5; // 500 ms of pauses in 10 s
+    clock += 10_000;
+    vi.advanceTimersByTime(10_000);
+    expect(samples).toEqual([[0.05, 4_000_000]]);
+    stop();
+  });
+
+  it('is inert off Hermes', () => {
+    vi.useFakeTimers();
+    const samples: number[] = [];
+    const stop = observeJsHeap((share) => samples.push(share), () => false, () => 0, 10);
+    vi.advanceTimersByTime(100);
+    expect(samples).toEqual([]);
+    stop();
+  });
+});
diff --git a/packages/verger-web/src/mapping.ts b/packages/verger-web/src/mapping.ts
new file mode 100644
index 000000000..47fd0141d
--- /dev/null
+++ b/packages/verger-web/src/mapping.ts
@@ -0,0 +1,93 @@
+import {
+  type CapacityFacts,
+  type NetworkTransport,
+  UNKNOWN_CAPACITY,
+  type VergerEvent,
+} from '@repo/verger-core';
+import type { BrowserBattery, BrowserNavigator, BrowserStorageEstimate } from './browser';
+
+const GIB = 1024 ** 3;
+
+/**
+ * What a browser says about the device. Memory is coarse (a power of two, within the browser's
+ * own bounds) but it is what the page can know; everything else stays unknown, so no capability
+ * floor applies.
+ */
+export function capacityOfBrowser(
+  nav: Pick<BrowserNavigator, 'deviceMemory' | 'hardwareConcurrency'>,
+): CapacityFacts {
+  const memory = nav.deviceMemory;
+  const cores = nav.hardwareConcurrency;
+  return {
+    ...UNKNOWN_CAPACITY,
+    totalMemoryBytes: typeof memory === 'number' && memory > 0 ? memory * GIB : null,
+    cpuCores: typeof cores === 'number' && cores > 0 ? cores : null,
+  };
+}
+
+const TRANSPORT: Readonly<Record<string, NetworkTransport>> = {
+  wifi: 'wifi',
+  cellular: 'cellular',
+  ethernet: 'ethernet',
+  none: 'none',
+};
+
+/**
+ * The browser's network as verger's event. Offline is known (`navigator.onLine` false); online
+ * is not proof the internet is reachable, so `validated` stays unknown. Save-Data is the user's
+ * Data Saver. No metered flag exists on the web.
+ */
+export function networkEventOfBrowser(
+  nav: Pick<BrowserNavigator, 'onLine' | 'connection'>,
+  at: number,
+): VergerEvent {
+  const connection = nav.connection;
+  const type = connection?.type;
+  return {
+    type: 'network',
+    at,
+    transport: !nav.onLine
+      ? 'none'
+      : type === undefined || type === 'unknown'
+        ? null
+        : (TRANSPORT[type] ?? 'other'),
+    validated: nav.onLine ? null : false,
+    metered: null,
+    downKbps:
+      typeof connection?.downlink === 'number' && connection.downlink >= 0
+        ? Math.round(connection.downlink * 1000)
+        : null,
+    dataSaver:
+      connection?.saveData === undefined ? null : connection.saveData ? 'enabled' : 'disabled',
+  };
+}
+
+/**
+ * The Battery Status API as verger's event. `charging` false on a full battery may still be
+ * plugged in, so a full, not-charging battery reads as unknown plug state.
+ */
+export function batteryEventOfBrowser(
+  battery: Pick<BrowserBattery, 'level' | 'charging'>,
+  at: number,
+): VergerEvent {
+  const level = battery.level;
+  return {
+    type: 'battery',
+    at,
+    levelPercent: level >= 0 && level <= 1 ? Math.round(level * 100) : null,
+    pluggedIn: battery.charging ? true : level >= 1 ? null : false,
+    temperatureC: null,
+  };
+}
+
+/**
+ * The origin's storage estimate as verger's storage event: what this site may still write
+ * (quota minus usage), which is what limits a web app, not the disk. Unknown when either is
+ * missing.
+ */
+export function storageEventOfEstimate(estimate: BrowserStorageEstimate, at: number): VergerEvent {
+  const { quota, usage } = estimate;
+  const known =
+    typeof quota === 'number' && typeof usage === 'number' && Number.isFinite(quota - usage);
+  return { type: 'storage', at, freeBytes: known ? Math.max(0, quota - usage) : null };
+}
diff --git a/packages/verger-web/src/platform.ts b/packages/verger-web/src/platform.ts
