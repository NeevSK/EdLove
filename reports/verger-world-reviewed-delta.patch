diff --git a/packages/verger-web/src/VergerBrowser.tsx b/packages/verger-web/src/VergerBrowser.tsx
new file mode 100644
index 000000000..e777047d9
--- /dev/null
+++ b/packages/verger-web/src/VergerBrowser.tsx
@@ -0,0 +1,225 @@
+'use client';
+
+import {
+  createVerger,
+  type ExperimentAssignment,
+  type FidelityPreference,
+  type RunMode,
+  type Verger,
+  type VergerActivation,
+  type VergerHost,
+  type VergerTelemetrySink,
+} from '@repo/verger-core';
+import {
+  bindVerger,
+  bindVergerEarly,
+  observeEventLoopLag,
+  observeInputDelay,
+  observeJsHeap,
+  observeLongTasks,
+} from '@repo/verger-react';
+import { type ReactNode, useEffect, useRef, useState } from 'react';
+import type { BrowserNavigator, BrowserPressureObserverConstructor } from './browser';
+import { capacityOfBrowser } from './mapping';
+import { browserStore, createVergerBrowserPlatform } from './platform';
+import { browserSignals } from './signals';
+
+/** Touches closer together than this are one interaction; verger needs presence, not taps. */
+const INTERACTION_THROTTLE_MS = 250;
+const REDUCED_MOTION_QUERY = '(prefers-reduced-motion: reduce)';
+/** The attribute app-wide reduced motion sets on `<html>`, for CSS to honour. */
+export const REDUCED_MOTION_ATTRIBUTE = 'data-verger-reduced-motion';
+
+const now = () => performance.now();
+const navigatorOf = () => window.navigator as Navigator & BrowserNavigator;
+/** Compute Pressure (R10) is not in every DOM lib yet; absent where the browser lacks it. */
+const pressureObserverOf = () =>
+  (window as Window & { PressureObserver?: BrowserPressureObserverConstructor }).PressureObserver;
+
+export interface VergerBrowserProps {
+  readonly children: ReactNode;
+  readonly host: VergerHost;
+  /** `off` runs only the floors; otherwise verger's launch runs (and may still stay off). */
+  readonly mode: 'off' | RunMode;
+  /** What verger may do; the ladder caps it. Defaults to `mode`'s preset. */
+  readonly activation?: VergerActivation;
+  /** The user's fidelity choice; `auto` lets the device and verger decide. */
+  readonly fidelity?: FidelityPreference;
+  readonly assignment?: ExperimentAssignment;
+  readonly telemetrySink?: VergerTelemetrySink;
+  /** The site's release: a new one starts the recovery ladder over. */
+  readonly release: string;
+  /** Records each session for the dev lab's export (D1); development builds only. */
+  readonly recordEvents?: number;
+  /**
+   * The kill switch, read live (R8): checked each time the page becomes visible; once it reads
+   * true, a running verger stops and only the floors remain until the next load.
+   */
+  readonly killed?: () => boolean;
+}
+
+/**
+ * Verger in a browser: creates the page's verger on the client and binds it, so
+ * `useVergerSnapshot` reads it anywhere without a provider. It feeds verger page visibility,
+ * the motion preference, presence (pointer and key presses), long animation frames, and the
+ * device's network and battery; it applies app-wide reduced motion as an attribute on `<html>`.
+ * On the server it renders its children only: verger is per browser, never per request.
+ */
+export function VergerBrowser({
+  children,
+  host,
+  mode,
+  activation,
+  fidelity = 'auto',
+  assignment,
+  telemetrySink,
+  release,
+  recordEvents,
+  killed,
+}: VergerBrowserProps) {
+  const [runs] = useState(() => mode !== 'off' && assignment?.runtime !== 'off');
+  const [verger] = useState<Verger | null>(() =>
+    typeof window === 'undefined'
+      ? null
+      : createVerger({
+          host,
+          platform: () => createVergerBrowserPlatform(navigatorOf()),
+          store: browserStore(() => window.localStorage),
+          // Never started when `runs` is false; the floors need no mode.
+          requested: mode === 'off' ? 'shadow' : mode,
+          activation,
+          facts: () => capacityOfBrowser(navigatorOf()),
+          assignment,
+          telemetrySink,
+          release,
+          recordEvents,
+          now,
+        }),
+  );
+  if (verger) bindVergerEarly(verger);
+  useEffect(() => (verger ? bindVerger(verger) : undefined), [verger]);
+
+  const preferences = useRef({ reduceMotion: false, fidelity });
+  useEffect(() => {
+    if (!verger || preferences.current.fidelity === fidelity) return;
+    preferences.current = { ...preferences.current, fidelity };
+    verger.dispatch({ type: 'preferences', at: now(), ...preferences.current });
+  }, [verger, fidelity]);
+
+  useEffect(() => {
+    if (!verger) return;
+    const sendPreferences = () =>
+      verger.dispatch({ type: 'preferences', at: now(), ...preferences.current });
+    const motionQuery = window.matchMedia?.(REDUCED_MOTION_QUERY) ?? null;
+    const onMotion = () => {
+      preferences.current = { ...preferences.current, reduceMotion: motionQuery?.matches ?? false };
+      sendPreferences();
+    };
+    const onVisibility = () => {
+      const visible = document.visibilityState !== 'hidden';
+      verger.dispatch({ type: 'app-state', at: now(), state: visible ? 'active' : 'background' });
+      if (visible && verger.activation !== null && killed?.()) void verger.stop();
+    };
+    let lastInteraction = Number.NEGATIVE_INFINITY;
+    const onInteraction = () => {
+      const at = now();
+      if (at - lastInteraction < INTERACTION_THROTTLE_MS) return;
+      lastInteraction = at;
+      verger.dispatch({ type: 'interaction', at });
+    };
+    let lastScroll = Number.NEGATIVE_INFINITY;
+    const onScroll = () => {
+      const at = now();
+      if (at - lastScroll < INTERACTION_THROTTLE_MS) return;
+      lastScroll = at;
+      verger.dispatch({ type: 'scroll', at, active: true });
+    };
+    const onScrollEnd = () => {
+      lastScroll = Number.NEGATIVE_INFINITY;
+      verger.dispatch({ type: 'scroll', at: now(), active: false });
+    };
+    const settings = () => {
+      onVisibility();
+      onMotion();
+    };
+
+    settings();
+    if (runs)
+      void verger.start().then((plan) => {
+        if (plan.runtime !== 'off') settings();
+      });
+    document.addEventListener('visibilitychange', onVisibility);
+    motionQuery?.addEventListener('change', onMotion);
+    const PressureObserver = pressureObserverOf();
+    const stopSignals = browserSignals(
+      { window, navigator: navigatorOf(), ...(PressureObserver ? { PressureObserver } : {}) },
+      (event) => verger.signal(event),
+      now,
+    );
+    // Presence and long frames matter only to a running closed loop.
+    if (runs) {
+      window.addEventListener('pointerdown', onInteraction, { passive: true });
+      window.addEventListener('keydown', onInteraction, { passive: true });
+      // A scrolling page holds quality-lowering changes (invariant 7); `scrollend` (where the
+      // browser has it) ends that, otherwise it lapses after config `scrollQuietMs`.
+      window.addEventListener('scroll', onScroll, { passive: true });
+      window.addEventListener('scrollend', onScrollEnd, { passive: true });
+    }
+    const stopLongTasks = runs
+      ? observeLongTasks(
+          (durationMs) => verger.dispatch({ type: 'long-task', at: now(), durationMs }),
+          ['long-animation-frame', 'longtask'],
+        )
+      : () => {};
+    const stopInputDelay = runs
+      ? observeInputDelay((durationMs) =>
+          verger.dispatch({ type: 'input-delay', at: now(), durationMs }),
+        )
+      : () => {};
+    // JS stalls the scheduler's long tasks miss: late timers and Hermes GC pauses; paused while
+    // the app is not visible, as verger itself reads it.
+    const hidden = () => verger.getSnapshot()?.visibility !== 'active';
+    const stopLag = runs
+      ? observeEventLoopLag(
+          (lagMs) => verger.dispatch({ type: 'event-loop-lag', at: now(), lagMs }),
+          hidden,
+          now,
+        )
+      : () => {};
+    const stopHeap = runs
+      ? observeJsHeap(
+          (gcPauseShare, allocatedBytes) =>
+            verger.dispatch({ type: 'js-heap', at: now(), gcPauseShare, allocatedBytes }),
+          hidden,
+          now,
+        )
+      : () => {};
+    const applyMotion = () => {
+      const root = document.documentElement;
+      if (verger.getSnapshot()?.globalReducedMotion)
+        root.setAttribute(REDUCED_MOTION_ATTRIBUTE, '');
+      else root.removeAttribute(REDUCED_MOTION_ATTRIBUTE);
+    };
+    applyMotion();
+    const stopMotion = verger.subscribe(applyMotion);
+
+    return () => {
+      stopMotion();
+      document.documentElement.removeAttribute(REDUCED_MOTION_ATTRIBUTE);
+      stopHeap();
+      stopLag();
+      stopInputDelay();
+      stopLongTasks();
+      window.removeEventListener('pointerdown', onInteraction);
+      window.removeEventListener('keydown', onInteraction);
+      window.removeEventListener('scroll', onScroll);
+      window.removeEventListener('scrollend', onScrollEnd);
+      stopSignals();
+      motionQuery?.removeEventListener('change', onMotion);
+      document.removeEventListener('visibilitychange', onVisibility);
+      if (runs) void verger.stop();
+    };
+  }, [verger, runs]);
+
+  return <>{children}</>;
+}
diff --git a/packages/verger-web/src/browser.ts b/packages/verger-web/src/browser.ts
new file mode 100644
index 000000000..a94395509
--- /dev/null
+++ b/packages/verger-web/src/browser.ts
@@ -0,0 +1,56 @@
+/**
+ * The browser APIs verger reads that TypeScript's DOM library does not describe yet, each
+ * optional: most are Chromium-only, so every use is feature-detected.
+ * - Network Information: `navigator.connection` (`effectiveType`, `downlink` in Mbps rounded to
+ *   25 kbps, `saveData`, `type`), with a `change` event.
+ * - Device Memory: `navigator.deviceMemory`, GiB rounded to a power of two, clamped to
+ *   browser-specific bounds.
+ * - Battery Status: `navigator.getBattery()`, secure contexts only.
+ * - Storage: `navigator.storage.estimate()` (StorageManager, secure contexts): the origin's
+ *   quota and usage, not the disk; either may be missing.
+ */
+export interface BrowserConnection extends EventTarget {
+  readonly type?: string;
+  readonly effectiveType?: string;
+  readonly downlink?: number;
+  readonly saveData?: boolean;
+}
+
+export interface BrowserBattery extends EventTarget {
+  readonly level: number;
+  readonly charging: boolean;
+}
+
+export interface BrowserNavigator {
+  readonly onLine: boolean;
+  readonly hardwareConcurrency?: number;
+  readonly deviceMemory?: number;
+  readonly connection?: BrowserConnection;
+  getBattery?(): Promise<BrowserBattery>;
+  readonly storage?: { estimate(): Promise<BrowserStorageEstimate> };
+}
+
+/**
+ * Compute Pressure (W3C Compute Pressure Level 1, IDL read from the spec source on 2026-10-25):
+ * `new PressureObserver(callback)`, `observe(source, { sampleInterval })` returning a promise that
+ * rejects where the source or the permissions policy (`compute-pressure`) is unavailable,
+ * `disconnect()`. Records carry `source`, `state` and `time`. Chromium only, secure contexts.
+ */
+export type BrowserPressureState = 'nominal' | 'fair' | 'serious' | 'critical';
+export interface BrowserPressureRecord {
+  readonly source: string;
+  readonly state: BrowserPressureState;
+  readonly time: number;
+}
+export interface BrowserPressureObserver {
+  observe(source: 'cpu', options?: { readonly sampleInterval?: number }): Promise<void>;
+  disconnect(): void;
+}
+export type BrowserPressureObserverConstructor = new (
+  callback: (records: readonly BrowserPressureRecord[]) => void,
+) => BrowserPressureObserver;
+
+export interface BrowserStorageEstimate {
+  readonly quota?: number;
+  readonly usage?: number;
+}
