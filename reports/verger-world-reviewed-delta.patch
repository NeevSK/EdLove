@@ -0,0 +1,53 @@
+package expo.modules.verger
+
+/**
+ * Pure mappings for the network sensor: Android's capability flags and Data Saver status to
+ * verger's vocabulary, and the payload that crosses to JavaScript. Kept free of Android imports
+ * so it is tested on the desktop JVM, and held to the shared contract fixtures in
+ * `packages/verger-android/contract/native-events.json`.
+ */
+object NetworkSignals {
+  /** The transport the network uses, in order of what matters for cost: Wi-Fi, then cellular. */
+  @JvmStatic
+  fun transport(present: Boolean, wifi: Boolean, cellular: Boolean, ethernet: Boolean): String = when {
+    !present -> "none"
+    wifi -> "wifi"
+    cellular -> "cellular"
+    ethernet -> "ethernet"
+    else -> "other"
+  }
+
+  /**
+   * `ConnectivityManager.getRestrictBackgroundStatus` to verger's names. The platform's constants
+   * are passed in by the caller, so this file holds no copy of them.
+   */
+  @JvmStatic
+  fun dataSaver(status: Int, disabled: Int, allowlisted: Int, enabled: Int): String? = when (status) {
+    disabled -> "disabled"
+    allowlisted -> "allowlisted"
+    enabled -> "enabled"
+    else -> null
+  }
+
+  /**
+   * The downstream estimate rounded down to a power of two: the platform's estimate moves
+   * constantly, and only a change of bucket is worth waking JavaScript. Unknown (0 or less) is null.
+   */
+  @JvmStatic
+  fun bucketKbps(kbps: Int): Int? = if (kbps <= 0) null else Integer.highestOneBit(kbps)
+
+  @JvmStatic
+  fun payload(
+    transport: String,
+    validated: Boolean?,
+    metered: Boolean?,
+    downKbps: Int?,
+    dataSaver: String?,
+  ): Map<String, Any?> = mapOf(
+    "transport" to transport,
+    "validated" to validated,
+    "metered" to metered,
+    "downKbps" to downKbps,
+    "dataSaver" to dataSaver,
+  )
+}
diff --git a/packages/verger-android/android/src/main/java/expo/modules/verger/Presence.kt b/packages/verger-android/android/src/main/java/expo/modules/verger/Presence.kt
new file mode 100644
index 000000000..4fe1d31d7
--- /dev/null
+++ b/packages/verger-android/android/src/main/java/expo/modules/verger/Presence.kt
@@ -0,0 +1,32 @@
+package expo.modules.verger
+
+/**
+ * Whether the app is in front, from activity lifecycle callbacks, without Expo (so the module
+ * keeps no Expo-only lifecycle hook and ports to Expo Modules 2.0 mechanically). Pure: the
+ * adapter feeds it starts, resumes and stops; it answers what the sensors should do.
+ *
+ * Visible while any activity is started (the platform's own definition of a foreground app);
+ * every resume while visible rebinds the frame sensor to the resumed activity's window.
+ */
+class Presence(startedAlready: Boolean) {
+  enum class Action { FOREGROUND, BACKGROUND, REBIND, NONE }
+
+  private var started = if (startedAlready) 1 else 0
+
+  val visible: Boolean get() = started > 0
+
+  fun onStarted(): Action {
+    started += 1
+    return if (started == 1) Action.FOREGROUND else Action.NONE
+  }
+
+  /** A resume rebinds the window; it never changes visibility on its own. */
+  fun onResumed(): Action = if (visible) Action.REBIND else Action.NONE
+
+  fun onStopped(): Action {
+    // A stop without a start we saw (the tracker began mid-life) cannot go below zero.
+    if (started == 0) return Action.NONE
+    started -= 1
+    return if (started == 0) Action.BACKGROUND else Action.NONE
+  }
+}
