+    expect(admitWork(low, { class: 'deferrable', spends: ['storage', 'cpu'] }).admit).toBe(true);
+    expect(admitWork(low, { class: 'critical', spends: ['storage'], whenStorageLow: 'wait' }).admit).toBe(true);
