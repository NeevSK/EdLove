+import { describe, expect, it } from 'vitest';
+import { SAMPLE_LEVERS } from './__fixtures__/sampleHost';
+import { DEFAULT_VERGER_CONFIG } from './config';
+import { createRuntimeController, type RuntimePort } from './controller';
+import { UNKNOWN_CAPACITY } from './reducer';
+import { createSelfCostMeter } from './selfCost';
+
+describe('self-cost meter', () => {
+  it('reports counts, rates and a duty ratio over the span', () => {
+    const meter = createSelfCostMeter(1000);
+    for (const d of [0.05, 0.1, 0.2, 0.4]) meter.onReduce(d);
+    meter.onWakeup();
+    const cost = meter.read(61_000);
+    expect(cost).toMatchObject({ events: 4, wakeups: 1, spanMs: 60_000, eventsPerMinute: 4 });
+    expect(cost.reduceTotalMs).toBeCloseTo(0.75);
+    expect(cost.reduceMeanMs).toBeCloseTo(0.1875);
+    expect(cost.reduceMaxMs).toBe(0.4);
+    expect(cost.dutyRatio).toBeCloseTo(0.75 / 60_000);
+  });
+
+  it('bounds the 95th percentile within a factor of two, and never above the maximum', () => {
+    const meter = createSelfCostMeter(0);
+    for (let i = 0; i < 99; i += 1) meter.onReduce(0.1);
+    meter.onReduce(50);
+    const cost = meter.read(1000);
+    expect(cost.reduceP95Ms).toBeGreaterThanOrEqual(0.1);
+    expect(cost.reduceP95Ms).toBeLessThanOrEqual(0.2);
+    const slow = createSelfCostMeter(0);
+    slow.onReduce(1e9);
+    expect(slow.read(1).reduceP95Ms).toBe(1e9);
+  });
+
+  it('ignores clock faults: negative and non-finite durations cost nothing', () => {
+    const meter = createSelfCostMeter(0);
+    meter.onReduce(-5);
+    meter.onReduce(Number.NaN);
+    const cost = meter.read(0);
+    expect(cost).toMatchObject({ events: 2, reduceTotalMs: 0, reduceMaxMs: 0, eventsPerMinute: 0, dutyRatio: 0 });
+  });
+});
+
+describe('controller self-cost', () => {
+  it('measures each reduction with the measure clock and counts timer wake-ups', () => {
+    let at = 0;
+    let measured = 0;
+    const timers: (() => void)[] = [];
+    const port: RuntimePort = { start: () => () => {}, setRefreshCap: () => {}, setCpuBoost: () => {} };
+    const controller = createRuntimeController({
+      port,
+      capacity: UNKNOWN_CAPACITY,
+      levers: SAMPLE_LEVERS,
+      mode: 'active',
+      config: DEFAULT_VERGER_CONFIG,
+      now: () => at,
+      // Every reading advances 0.5 ms: one reduction measures exactly 0.5 ms.
+      measure: () => (measured += 0.5),
+      scheduler: {
+        setTimeout: (callback) => timers.push(callback),
+        clearTimeout: () => {},
+      },
+      memorySensing: false,
+    });
+    controller.start();
+    at = 10;
+    controller.dispatch({ type: 'interaction', at });
+    controller.dispatch({ type: 'memory-trim', at, severity: 'critical' });
+    at = 60_000;
+    const due = timers.at(-1);
+    if (!due) throw new Error('a trim should schedule its release');
+    due();
+    const cost = controller.selfCost();
+    expect(cost.events).toBe(3);
+    expect(cost.wakeups).toBe(1);
+    expect(cost.reduceTotalMs).toBeCloseTo(1.5);
+    expect(cost.spanMs).toBe(60_000);
+  });
+});
diff --git a/packages/verger-core/src/selfCost.ts b/packages/verger-core/src/selfCost.ts
new file mode 100644
index 000000000..33a9657f7
--- /dev/null
+++ b/packages/verger-core/src/selfCost.ts
@@ -0,0 +1,83 @@
+/**
+ * What verger itself costs, measured in the controller around the pure reducer (D3). The
+ * doctrine asks verger to reduce itself first, so it must know its own price: reducer time per
+ * event, events and wakeups per minute, and the share of the span spent reducing. Memory is
+ * bounded: counts and a fixed histogram, never a list of samples.
+ */
+export interface SelfCost {
+  readonly events: number;
+  /** Timer wake-ups for time-only changes (each costs the phone a CPU wake). */
+  readonly wakeups: number;
+  readonly spanMs: number;
+  readonly eventsPerMinute: number;
+  readonly reduceTotalMs: number;
+  readonly reduceMeanMs: number;
+  readonly reduceMaxMs: number;
+  /** Upper bound of the histogram bucket holding the 95th percentile (within a factor of 2). */
+  readonly reduceP95Ms: number;
+  /** Reducer time over the span: 0.001 means verger spent 0.1% of the time deciding. */
+  readonly dutyRatio: number;
+}
+
+export interface SelfCostMeter {
+  onReduce(durationMs: number): void;
+  onWakeup(): void;
+  read(at: number): SelfCost;
+}
+
+/** Bucket k holds durations up to SMALLEST_MS × 2^k; the last bucket holds everything longer. */
+const SMALLEST_MS = 0.01;
+const BUCKETS = 21;
+
+const bucketOf = (durationMs: number): number => {
+  if (durationMs <= SMALLEST_MS) return 0;
+  return Math.min(BUCKETS - 1, Math.ceil(Math.log2(durationMs / SMALLEST_MS)));
+};
+
+export function createSelfCostMeter(startAt: number): SelfCostMeter {
+  const histogram = new Array<number>(BUCKETS).fill(0);
+  let events = 0;
+  let wakeups = 0;
+  let total = 0;
+  let max = 0;
+  return {
+    onReduce(durationMs) {
+      // A clock that steps backwards, or a non-finite reading, is not verger's cost.
+      const d = Number.isFinite(durationMs) ? Math.max(0, durationMs) : 0;
+      events += 1;
+      total += d;
+      max = Math.max(max, d);
+      histogram[bucketOf(d)] = (histogram[bucketOf(d)] ?? 0) + 1;
+    },
+    onWakeup() {
+      wakeups += 1;
+    },
+    read(at) {
+      const spanMs = Math.max(0, at - startAt);
+      let p95 = 0;
+      if (events > 0) {
+        const rank = Math.ceil(events * 0.95);
+        let seen = 0;
+        for (let k = 0; k < BUCKETS; k += 1) {
+          seen += histogram[k] ?? 0;
+          if (seen >= rank) {
+            // The last bucket is open-ended: its honest bound is the largest duration seen.
+            p95 = k === BUCKETS - 1 ? max : Math.min(max, SMALLEST_MS * 2 ** k);
+            break;
+          }
+        }
+      }
+      return {
+        events,
+        wakeups,
+        spanMs,
+        eventsPerMinute: spanMs > 0 ? (events * 60_000) / spanMs : 0,
+        reduceTotalMs: total,
+        reduceMeanMs: events > 0 ? total / events : 0,
+        reduceMaxMs: max,
+        reduceP95Ms: p95,
+        dutyRatio: spanMs > 0 ? total / spanMs : 0,
+      };
+    },
+  };
+}
