+import type {
+  FaceSpec,
+  FontWeight,
+  WorldFaces,
+  WorldId,
+  WorldLanguage,
+  WorldMotion,
+} from './types';
+
+const STEPS: Record<FontWeight, number> = { '400': 400, '500': 500, '600': 600, '700': 700 };
+
+function variable(upright: string, extra: Partial<FaceSpec> = {}): FaceSpec {
+  return { upright, weights: STEPS, ...extra };
+}
