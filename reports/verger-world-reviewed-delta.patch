+
+/** The active world's perch, filling the scene box it is placed in. */
+export function Perch({ width, height }: { width: number; height: number }) {
+  const world = useWorld();
+  return (
+    <Svg
+      width={width}
+      height={height}
+      viewBox="0 0 220 164"
+      style={StyleSheet.absoluteFill}
