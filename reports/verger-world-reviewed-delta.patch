-  if (id === undefined) return state;
-  const current = state.pressure[id] ?? 0;
-  const pressure = { ...state.pressure };
-  if (current <= 1) delete pressure[id];
-  else pressure[id] = current - 1;
-  return {
-    ...state,
-    pressure,
-    stack: state.stack.slice(0, -1),
-    lastIncreaseAt: at,
-    lastAction: 'increase',
-    lastReason: reason,
-  };
