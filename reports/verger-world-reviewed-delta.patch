-
-// ---------------------------------------------------------------------------------------------
-// Indexer: Unity's StateAction, with asymmetric hysteresis and upgrade back-off.
-// ---------------------------------------------------------------------------------------------
-
-function lower(
-  state: GovernorState,
-  steps: number,
-  bottleneck: readonly LeverTarget[],
-  at: number,
