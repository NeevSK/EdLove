@@ -0,0 +1,33 @@
+package expo.modules.verger
+
+/**
+ * Pure mappings for the battery, from the `ACTION_BATTERY_CHANGED` broadcast's extras to the
+ * payload that crosses to JavaScript. Kept free of Android imports so it is tested on the desktop
+ * JVM, and held to the shared contract fixtures in `packages/verger-android/contract/native-events.json`.
+ */
+object BatterySignals {
+  /** Whole percent from the broadcast's level and scale; null when either is missing or invalid. */
+  @JvmStatic
+  fun levelPercent(level: Int, scale: Int): Int? =
+    if (level < 0 || scale <= 0 || level > scale) null else (level * 100) / scale
+
+  /** On external power: any non-zero `EXTRA_PLUGGED`. Null when the extra is missing (negative). */
+  @JvmStatic
+  fun pluggedIn(plugged: Int): Boolean? = if (plugged < 0) null else plugged > 0
+
+  /**
+   * Battery temperature in degrees Celsius. ASSUMPTION to verify on a phone: `EXTRA_TEMPERATURE`
+   * is in tenths of a degree (the common convention; not confirmed in this session). Rounded to
+   * half a degree so only a real change crosses to JavaScript. `Int.MIN_VALUE` means missing.
+   */
+  @JvmStatic
+  fun temperatureC(tenths: Int): Double? =
+    if (tenths == Int.MIN_VALUE) null else Math.floor(tenths / 10.0 * 2.0) / 2.0
+
+  @JvmStatic
+  fun payload(levelPercent: Int?, pluggedIn: Boolean?, temperatureC: Double?): Map<String, Any?> = mapOf(
+    "levelPercent" to levelPercent,
+    "pluggedIn" to pluggedIn,
+    "temperatureC" to temperatureC,
+  )
+}
diff --git a/packages/verger-android/android/src/main/java/expo/modules/verger/CpuHeadroom.kt b/packages/verger-android/android/src/main/java/expo/modules/verger/CpuHeadroom.kt
new file mode 100644
index 000000000..d412367e2
--- /dev/null
+++ b/packages/verger-android/android/src/main/java/expo/modules/verger/CpuHeadroom.kt
@@ -0,0 +1,61 @@
+package expo.modules.verger
+
+/**
+ * The device's CPU headroom (API 36, `SystemHealthManager.getCpuHeadroom`; R11) as contention
+ * evidence: how much CPU the system could still grant, 0 to 100. Pure: the adapter hands it a
+ * reader; this decides what to report.
+ *
+ * Per the platform source (android16-release): the call is a binder transaction of a millisecond
+ * or more, so it runs on the sense thread, never a critical one; it returns NaN while unavailable
+ * ("server error or not enough user CPU workload"), cached values when called faster than
+ * `getCpuHeadroomMinIntervalMillis`, and throws `UnsupportedOperationException` where the device
+ * has no headroom support.
+ *
+ * NaN and errors are reported as no reading (null), never as the last value: a stale "busy" must
+ * not outlive its evidence. Unsupported stops reading for the session.
+ */
+class CpuHeadroomPoller(private val busyPercent: Double, platformMinIntervalMs: Long) {
+  /** How often to read: never faster than the platform's own minimum, nor than [POLL_MS]. */
+  val intervalMs: Long = maxOf(platformMinIntervalMs, POLL_MS)
+
+  var supported = true
+    private set
+
+  /** The last reported headroom, null while there is no reading. */
+  var percent: Double? = null
+    private set
+  private var reported = false
+
+  /** Reads once; true when the reading should be reported (first, null-ness, a move, a crossing). */
+  fun read(reader: () -> Float): Boolean {
+    if (!supported) return false
+    val next: Double? = try {
+      usable(reader())
+    } catch (e: UnsupportedOperationException) {
+      supported = false
+      null
+    } catch (e: RuntimeException) {
+      null
+    }
+    val before = percent
+    val changed = when {
+      !reported -> next != null || !supported
+      (next == null) != (before == null) -> true
+      next == null || before == null -> false
+      else -> kotlin.math.abs(next - before) >= CHANGE_PERCENT || (next < busyPercent) != (before < busyPercent)
+    }
+    if (!changed) return false
+    percent = next
+    reported = true
+    return true
+  }
+
+  companion object {
+    const val POLL_MS = 5_000L
+    /** Moves smaller than this are not reported, unless they cross [busyPercent]. */
+    const val CHANGE_PERCENT = 5.0
+
+    fun usable(raw: Float): Double? =
+      if (raw.isNaN() || raw < 0f || raw > 100f) null else raw.toDouble()
+  }
+}
diff --git a/packages/verger-android/android/src/main/java/expo/modules/verger/DataUsage.kt b/packages/verger-android/android/src/main/java/expo/modules/verger/DataUsage.kt
new file mode 100644
index 000000000..29d2da87a
--- /dev/null
