  "components": {
    "schemas": {
      "Assignment": {
        "type": "object",
        "required": [
          "id",
          "classroomId",
          "title",
          "dueAt",
          "maxScore"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "classroomId": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "dueAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "description": "null = no due date (not the same as unknown)."
          },
          "maxScore": {
            "$ref": "#/components/schemas/DecimalString"
          }
        }
      },
      "DecimalString": {
        "type": "string",
        "pattern": "^-?[0-9]+(\\.[0-9]{1,4})?$",
        "description": "Decimal carried as a string so no precision is lost (e.g. \"1234.50\")."
      },
      "Grade": {
        "type": "object",
        "required": [
          "submissionId",
          "score",
          "feedback"
        ],
        "properties": {
          "submissionId": {
            "type": "string"
          },
          "score": {
            "$ref": "#/components/schemas/DecimalString"
          },
          "feedback": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "GradeInput": {
        "type": "object",
        "required": [
          "submissionId",
          "score"
        ],
        "properties": {
          "submissionId": {
            "type": "string"
          },
          "score": {
            "$ref": "#/components/schemas/DecimalString"
          },
          "feedback": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Omitted = keep existing feedback; null = clear it."
          }
        }
      },
      "GuardianLink": {
        "type": "object",
        "required": [
          "linkId",
          "studentId",
          "guardianId",
          "relationship",
          "verified"
        ],
        "properties": {
          "linkId": {
            "type": "string"
          },
          "studentId": {
            "type": "string"
          },
          "guardianId": {
            "type": "string"
          },
          "relationship": {
            "$ref": "#/components/schemas/GuardianRelationship"
          },
          "verified": {
            "type": "boolean",
            "enum": [
              false
            ],
            "description": "Always false until verification exists."
          }
        }
      },
      "GuardianLinkInput": {
        "type": "object",
        "required": [
          "studentId",
          "guardianId",
          "relationship"
        ],
        "properties": {
          "studentId": {
            "type": "string"
          },
          "guardianId": {
            "type": "string"
          },
          "relationship": {
            "$ref": "#/components/schemas/GuardianRelationship"
          }
        }
      },
      "GuardianRelationship": {
        "type": "object",
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "parent"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "legal_guardian"
                ]
              },
              "courtOrderRef": {
                "type": "string"
              }
            },
            "required": [
              "kind",
              "courtOrderRef"
            ]
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "other"
                ]
              },
              "description": {
                "type": "string"
              }
            },
            "required": [
              "kind",
              "description"
            ]
          }
        ],
        "discriminator": {
          "propertyName": "kind",
          "mapping": {}
        }
      },
      "Invoice": {
        "type": "object",
        "required": [
          "id",
          "total",
          "lines",
          "payment"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "total": {
            "$ref": "#/components/schemas/DecimalString"
          },
          "lines": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/InvoiceLine"
            }
          },
          "payment": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Payment"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "InvoiceInput": {
        "type": "object",
        "required": [
          "studentId",
          "currency",
          "lines"
        ],
        "properties": {
          "studentId": {
            "type": "string"
          },
          "currency": {
            "type": "string",
            "enum": [
              "LKR",
              "USD"
            ]
          },
          "lines": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/InvoiceLine"
            }
          },
          "payment": {
            "$ref": "#/components/schemas/Payment"
          }
        }
      },
      "InvoiceLine": {
        "type": "object",
        "required": [
          "description",
          "quantity",
          "unitPrice"
        ],
        "properties": {
          "description": {
            "type": "string"
          },
          "quantity": {
            "type": "integer",
            "format": "int32"
          },
          "unitPrice": {
            "$ref": "#/components/schemas/DecimalString"
          }
        }
      },
      "Payment": {
        "type": "object",
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "cash"
                ]
              },
              "receivedBy": {
                "type": "string"
              }
            },
            "required": [
              "kind",
              "receivedBy"
            ]
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "bank"
                ]
              },
              "reference": {
                "type": "string"
              },
              "bankCode": {
                "type": "string"
              }
            },
            "required": [
              "kind",
              "reference",
              "bankCode"
            ]
          }
        ],
        "discriminator": {
          "propertyName": "kind",
          "mapping": {}
        }
      },
      "Profile": {
        "type": "object",
        "required": [
          "personId",
          "legalName",
          "preferredName",
          "phone",
          "guardians"
        ],
        "properties": {
          "personId": {
            "type": "string"
          },
          "legalName": {
            "type": "string"
          },
          "preferredName": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "phone": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "guardians": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "ProfilePatch": {
        "type": "object",
        "required": [
          "personId"
        ],
        "properties": {
          "personId": {
            "type": "string"
          },
          "preferredName": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Omitted = unchanged; null = clear."
          },
          "phone": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "SignedSnapshot": {
        "type": "object",
        "required": [
          "payload",
          "signature",
          "keyId",
          "expiresAt"
        ],
        "properties": {
          "payload": {
            "type": "string",
            "description": "Canonical JSON (RFC 8785) of the claims, exactly as signed."
          },
          "signature": {
            "type": "string",
            "description": "Ed25519 signature over `payload`, base64url."
          },
          "keyId": {
            "type": "string"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  },
  "servers": [
    {
      "url": "https://api.example.invalid",
      "description": "eval",
      "variables": {}
    }
  ]
}
