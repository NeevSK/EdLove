<?xml version="1.0"?>
<rdf:RDF xmlns="https://gurudevi.lk/ontology.owl.ttl#"
     xml:base="https://gurudevi.lk/ontology.owl.ttl"
     xmlns:gd="https://gurudevi.lk/ontology/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:linkml="https://w3id.org/linkml/"
     xmlns:dcterms="http://purl.org/dc/terms/"
     xmlns:schema1="http://schema.org/">
    <owl:Ontology rdf:about="https://gurudevi.lk/ontology.owl.ttl">
        <dcterms:title>Shared case - Person, Bond, Authority, Institution, Enrollment</dcterms:title>
        <rdfs:label>gurudevi_case</rdfs:label>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://purl.org/dc/terms/title -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/title"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#definition -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#definition"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#exactMatch -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#exactMatch"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#inScheme -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#inScheme"/>
    


    <!-- https://gurudevi.lk/ontology/fixed_capacity -->

    <owl:AnnotationProperty rdf:about="https://gurudevi.lk/ontology/fixed_capacity"/>
    


    <!-- https://gurudevi.lk/ontology/lifecycle -->

    <owl:AnnotationProperty rdf:about="https://gurudevi.lk/ontology/lifecycle"/>
    


    <!-- https://gurudevi.lk/ontology/ufo -->

    <owl:AnnotationProperty rdf:about="https://gurudevi.lk/ontology/ufo"/>
    


    <!-- https://w3id.org/linkml/permissible_values -->

    <owl:AnnotationProperty rdf:about="https://w3id.org/linkml/permissible_values"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- https://gurudevi.lk/ontology/capacity -->

    <owl:ObjectProperty rdf:about="https://gurudevi.lk/ontology/capacity">
        <rdfs:range rdf:resource="https://gurudevi.lk/ontology/Capacity"/>
        <rdfs:label>capacity</rdfs:label>
        <skos:inScheme rdf:resource="https://gurudevi.lk/ontology"/>
    </owl:ObjectProperty>
    


    <!-- https://gurudevi.lk/ontology/granted_by -->

    <owl:ObjectProperty rdf:about="https://gurudevi.lk/ontology/granted_by">
        <rdfs:range rdf:resource="https://gurudevi.lk/ontology/Bond"/>
        <rdfs:label>granted_by</rdfs:label>
        <skos:inScheme rdf:resource="https://gurudevi.lk/ontology"/>
    </owl:ObjectProperty>
    


    <!-- https://gurudevi.lk/ontology/institution -->

    <owl:ObjectProperty rdf:about="https://gurudevi.lk/ontology/institution">
        <rdfs:range rdf:resource="https://gurudevi.lk/ontology/Institution"/>
        <rdfs:label>institution</rdfs:label>
        <skos:inScheme rdf:resource="https://gurudevi.lk/ontology"/>
        <gd:ufo>mediation</gd:ufo>
    </owl:ObjectProperty>
    


    <!-- https://gurudevi.lk/ontology/person -->

    <owl:ObjectProperty rdf:about="https://gurudevi.lk/ontology/person">
        <rdfs:range rdf:resource="https://gurudevi.lk/ontology/Person"/>
        <rdfs:label>person</rdfs:label>
        <skos:inScheme rdf:resource="https://gurudevi.lk/ontology"/>
        <gd:ufo>mediation</gd:ufo>
    </owl:ObjectProperty>
    


    <!-- https://gurudevi.lk/ontology/power -->

    <owl:ObjectProperty rdf:about="https://gurudevi.lk/ontology/power">
        <rdfs:range rdf:resource="https://gurudevi.lk/ontology/Power"/>
        <rdfs:label>power</rdfs:label>
        <skos:inScheme rdf:resource="https://gurudevi.lk/ontology"/>
    </owl:ObjectProperty>
    


    <!-- https://gurudevi.lk/ontology/state -->

    <owl:ObjectProperty rdf:about="https://gurudevi.lk/ontology/state">
        <rdfs:range rdf:resource="https://gurudevi.lk/ontology/BondState"/>
        <rdfs:label>state</rdfs:label>
        <skos:inScheme rdf:resource="https://gurudevi.lk/ontology"/>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- https://gurudevi.lk/ontology/academic_year -->

    <owl:DatatypeProperty rdf:about="https://gurudevi.lk/ontology/academic_year">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:label>academic_year</rdfs:label>
        <skos:inScheme rdf:resource="https://gurudevi.lk/ontology"/>
    </owl:DatatypeProperty>
    


    <!-- https://gurudevi.lk/ontology/display_name -->

    <owl:DatatypeProperty rdf:about="https://gurudevi.lk/ontology/display_name">
        <rdfs:label>display_name</rdfs:label>
        <skos:inScheme rdf:resource="https://gurudevi.lk/ontology"/>
    </owl:DatatypeProperty>
    


    <!-- https://gurudevi.lk/ontology/grade -->

    <owl:DatatypeProperty rdf:about="https://gurudevi.lk/ontology/grade">
        <rdfs:range>
            <rdfs:Datatype>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#integer"/>
                    <rdfs:Datatype>
                        <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
                        <owl:withRestrictions rdf:parseType="Collection">
                            <rdf:Description>
                                <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</xsd:minInclusive>
                            </rdf:Description>
                        </owl:withRestrictions>
                    </rdfs:Datatype>
                    <rdfs:Datatype>
                        <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
                        <owl:withRestrictions rdf:parseType="Collection">
                            <rdf:Description>
                                <xsd:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">13</xsd:maxInclusive>
                            </rdf:Description>
                        </owl:withRestrictions>
                    </rdfs:Datatype>
                </owl:intersectionOf>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:label>grade</rdfs:label>
        <skos:inScheme rdf:resource="https://gurudevi.lk/ontology"/>
    </owl:DatatypeProperty>
    


    <!-- https://gurudevi.lk/ontology/id -->

    <owl:DatatypeProperty rdf:about="https://gurudevi.lk/ontology/id">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
        <rdfs:label>id</rdfs:label>
        <skos:inScheme rdf:resource="https://gurudevi.lk/ontology"/>
    </owl:DatatypeProperty>
    


    <!-- https://gurudevi.lk/ontology/name -->

    <owl:DatatypeProperty rdf:about="https://gurudevi.lk/ontology/name">
        <rdfs:label>name</rdfs:label>
        <skos:inScheme rdf:resource="https://gurudevi.lk/ontology"/>
    </owl:DatatypeProperty>
    


    <!-- https://gurudevi.lk/ontology/recorded_at -->

    <owl:DatatypeProperty rdf:about="https://gurudevi.lk/ontology/recorded_at">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:label>recorded_at</rdfs:label>
        <skos:definition>When Gurudevi learned it (transaction time).</skos:definition>
        <skos:inScheme rdf:resource="https://gurudevi.lk/ontology"/>
    </owl:DatatypeProperty>
    


    <!-- https://gurudevi.lk/ontology/valid_from -->

    <owl:DatatypeProperty rdf:about="https://gurudevi.lk/ontology/valid_from">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:label>valid_from</rdfs:label>
        <skos:definition>When it became true in the world (valid time).</skos:definition>
        <skos:inScheme rdf:resource="https://gurudevi.lk/ontology"/>
    </owl:DatatypeProperty>
    


    <!-- https://gurudevi.lk/ontology/valid_to -->

    <owl:DatatypeProperty rdf:about="https://gurudevi.lk/ontology/valid_to">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:label>valid_to</rdfs:label>
        <skos:definition>When it stopped being true in the world. Empty means still true.</skos:definition>
        <skos:inScheme rdf:resource="https://gurudevi.lk/ontology"/>
    </owl:DatatypeProperty>
    


