        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://gurudevi.lk/ontology/id"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
