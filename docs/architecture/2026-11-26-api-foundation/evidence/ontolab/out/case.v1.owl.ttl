	rdfs:range gd:Power ;
	skos:inScheme <https://gurudevi.lk/ontology> .
gd:recorded_at a owl:DatatypeProperty ;
	rdfs:label "recorded_at" ;
	rdfs:range xsd:dateTime ;
	skos:definition "When Gurudevi learned it (transaction time)." ;
	skos:inScheme <https://gurudevi.lk/ontology> .
gd:state a owl:ObjectProperty ;
	rdfs:label "state" ;
	rdfs:range gd:BondState ;
	skos:inScheme <https://gurudevi.lk/ontology> .
gd:valid_from a owl:DatatypeProperty ;
	rdfs:label "valid_from" ;
	rdfs:range xsd:dateTime ;
	skos:definition "When it became true in the world (valid time)." ;
	skos:inScheme <https://gurudevi.lk/ontology> .
gd:valid_to a owl:DatatypeProperty ;
	rdfs:label "valid_to" ;
	rdfs:range xsd:dateTime ;
	skos:definition "When it stopped being true in the world. Empty means still true." ;
	skos:inScheme <https://gurudevi.lk/ontology> .
