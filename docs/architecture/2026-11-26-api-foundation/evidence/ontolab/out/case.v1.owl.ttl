<https://gurudevi.lk/ontology.owl.ttl> dcterms:title "Shared case - Person, Bond, Authority, Institution, Enrollment" ;
	a owl:Ontology ;
	rdfs:label "gurudevi_case" .
gd:Authority a owl:Class ;
	rdfs:label "Authority" ;
	rdfs:subClassOf _:c14n1 , _:c14n12 , _:c14n16 , _:c14n22 , _:c14n23 , _:c14n3 , _:c14n30 , _:c14n32 , _:c14n37 , _:c14n40 , _:c14n50 , _:c14n55 , _:c14n58 , _:c14n6 , _:c14n63 , _:c14n7 , _:c14n74 , _:c14n8 ;
	skos:definition "A power a bond grants (mark, enrol, invite...). Never outlives the bond that grants it." ;
	skos:inScheme <https://gurudevi.lk/ontology> ;
	gd:ufo "normative relator (UFO-C power)" .
gd:Bond a owl:Class ;
	rdfs:label "Bond" ;
	rdfs:subClassOf _:c14n10 , _:c14n11 , _:c14n20 , _:c14n26 , _:c14n27 , _:c14n28 , _:c14n31 , _:c14n35 , _:c14n43 , _:c14n46 , _:c14n48 , _:c14n49 , _:c14n51 , _:c14n53 , _:c14n54 , _:c14n56 , _:c14n60 , _:c14n66 , _:c14n67 , _:c14n69 , _:c14n75 , _:c14n76 , _:c14n78 , _:c14n9 ;
	skos:definition "How a person joins an institution in one capacity. A relator; it exists only while both sides do." ;
	skos:inScheme <https://gurudevi.lk/ontology> ;
	gd:lifecycle "state: state\nwithin: institution\nstart: invited\ntransitions:\n  - {from: invited, to: active, by: accept, who: [person]}\n  - {from: invited, to: ended, by: decline, who: [person]}\n  - {from: active, to: suspended, by: suspend, who: [principal]}\n  - {from: suspended, to: active, by: restore, who: [principal]}\n  - {from: active, to: ended, by: end, who: [person, principal]}\n  - {from: suspended, to: ended, by: end, who: [principal]}\n" ;
	gd:ufo "relator" .
gd:BondState\#active a owl:Class ;
	rdfs:label "active" ;
	rdfs:subClassOf gd:BondState .
gd:BondState\#ended a owl:Class ;
	rdfs:label "ended" ;
	rdfs:subClassOf gd:BondState .
gd:BondState\#invited a owl:Class ;
	rdfs:label "invited" ;
	rdfs:subClassOf gd:BondState .
gd:BondState\#suspended a owl:Class ;
	rdfs:label "suspended" ;
	rdfs:subClassOf gd:BondState .
gd:BondState a owl:Class ;
	rdfs:label "BondState" ;
	owl:unionOf _:c14n34 ;
	skos:inScheme <https://gurudevi.lk/ontology> ;
	linkml:permissible_values gd:BondState\#active , gd:BondState\#ended , gd:BondState\#invited , gd:BondState\#suspended .
gd:Capacity\#founder a owl:Class ;
	rdfs:label "founder" ;
	rdfs:subClassOf gd:Capacity .
gd:Capacity\#guardian a owl:Class ;
	rdfs:label "guardian" ;
	rdfs:subClassOf gd:Capacity .
gd:Capacity\#principal a owl:Class ;
	rdfs:label "principal" ;
	rdfs:subClassOf gd:Capacity .
gd:Capacity\#student a owl:Class ;
	rdfs:label "student" ;
	rdfs:subClassOf gd:Capacity .
gd:Capacity\#teacher a owl:Class ;
	rdfs:label "teacher" ;
	rdfs:subClassOf gd:Capacity .
gd:Capacity a owl:Class ;
	rdfs:label "Capacity" ;
	owl:unionOf _:c14n39 ;
	skos:inScheme <https://gurudevi.lk/ontology> ;
	linkml:permissible_values gd:Capacity\#founder , gd:Capacity\#guardian , gd:Capacity\#principal , gd:Capacity\#student , gd:Capacity\#teacher .
gd:Enrollment a owl:Class ;
	rdfs:label "Enrollment" ;
	rdfs:subClassOf gd:Bond , _:c14n0 , _:c14n17 , _:c14n18 , _:c14n24 , _:c14n29 , _:c14n4 , _:c14n5 , _:c14n68 , _:c14n72 ;
	skos:definition "A bond in the student capacity, with a grade and year." ;
	skos:inScheme <https://gurudevi.lk/ontology> ;
	gd:ufo "relator (subkind of Bond)" .
gd:Institution a owl:Class ;
	rdfs:label "Institution" ;
	rdfs:subClassOf _:c14n14 , _:c14n25 , _:c14n41 , _:c14n61 , _:c14n62 , _:c14n79 ;
	skos:definition "A school, tuition institute or other organisation people bond with." ;
	skos:exactMatch schema1:Organization ;
	skos:inScheme <https://gurudevi.lk/ontology> ;
	gd:ufo "kind" .
gd:Person a owl:Class ;
	rdfs:label "Person" ;
	rdfs:subClassOf _:c14n2 , _:c14n57 , _:c14n65 , _:c14n70 , _:c14n73 , _:c14n77 ;
	skos:definition "One human, one account for a whole life." ;
	skos:exactMatch schema1:Person ;
	skos:inScheme <https://gurudevi.lk/ontology> ;
	gd:ufo "kind" .
