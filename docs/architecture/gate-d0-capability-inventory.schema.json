{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gurudevi.local/schemas/gate-d0-capability-inventory-v1.3.json",
  "title": "Gate D0 Capability Inventory",
  "type": "object",
  "required": ["schemaVersion", "sourceSnapshot", "records"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "1.3.0" },
    "sourceSnapshot": {
      "type": "object",
      "required": ["algorithm", "semantics", "sourcePaths", "sha256"],
      "properties": {
        "algorithm": { "const": "sha256" },
        "semantics": { "type": "string", "minLength": 1 },
        "sourcePaths": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    },
    "records": {
      "type": "array",
      "items": { "$ref": "#/$defs/capability" },
      "minItems": 1
    }
  },
  "$defs": {
    "unknownable": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        {
          "type": "object",
          "required": ["status", "reason"],
          "properties": { "status": { "const": "unknown" }, "reason": { "type": "string", "minLength": 1 } },
          "additionalProperties": false
        }
      ]
    },
    "capability": {
      "type": "object",
      "required": ["id", "name", "owner", "reviewedAt", "claimType", "kind", "maturity", "actor", "scope", "sensitivity", "surfaces", "routes", "headless", "packages", "exports", "consumers", "contract", "authorization", "persistence", "sync", "fallback", "recovery", "effects", "evidence", "documentClaims", "driftDisposition"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9-]*)+$" },
        "name": { "type": "string", "minLength": 1 },
        "owner": { "type": "string", "minLength": 1 },
        "reviewedAt": { "type": "string", "format": "date" },
        "claimType": { "enum": ["source-observation", "document-intent", "candidate"] },
        "kind": { "type": "string", "minLength": 1 },
        "maturity": { "enum": ["end-to-end-evidenced", "implemented-wired", "partial", "scaffold", "document-intent", "historical-stale", "unknown"] },
        "actor": { "$ref": "#/$defs/unknownable" },
        "scope": { "$ref": "#/$defs/unknownable" },
        "sensitivity": { "$ref": "#/$defs/unknownable" },
        "surfaces": { "type": "array", "items": { "$ref": "#/$defs/unknownable" } },
        "routes": { "type": "array", "items": { "type": "object", "required": ["surface", "path", "status"], "properties": { "surface": { "type": "string" }, "path": { "$ref": "#/$defs/unknownable" }, "status": { "enum": ["resolved", "dynamic", "external", "headless", "unresolved", "unknown"] } }, "additionalProperties": false } },
        "headless": { "type": "object", "required": ["value", "reason"], "properties": { "value": { "oneOf": [{ "type": "boolean" }, { "type": "object", "required": ["status", "reason"], "properties": { "status": { "const": "unknown" }, "reason": { "type": "string", "minLength": 1 } }, "additionalProperties": false }] }, "reason": { "$ref": "#/$defs/unknownable" } }, "additionalProperties": false },
        "packages": { "type": "array", "items": { "$ref": "#/$defs/unknownable" } },
        "exports": { "type": "array", "items": { "$ref": "#/$defs/unknownable" } },
        "consumers": { "type": "array", "items": { "$ref": "#/$defs/unknownable" } },
        "contract": { "$ref": "#/$defs/unknownable" },
        "authorization": { "$ref": "#/$defs/unknownable" },
        "persistence": { "$ref": "#/$defs/unknownable" },
        "sync": { "$ref": "#/$defs/unknownable" },
        "fallback": { "$ref": "#/$defs/unknownable" },
        "recovery": { "$ref": "#/$defs/unknownable" },
        "effects": { "type": "array", "items": { "type": "object", "required": ["id", "kind", "name", "payloadFields", "evidenceClaimIds", "purpose", "consent", "audience", "retention", "downstreamStorage", "deliveryFailure"], "properties": { "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" }, "kind": { "enum": ["growth-signal", "analytics-event", "external-effect", "other"] }, "name": { "type": "string", "minLength": 1 }, "payloadFields": { "type": "array", "items": { "type": "string", "minLength": 1 } }, "evidenceClaimIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" } }, "purpose": { "$ref": "#/$defs/unknownable" }, "consent": { "$ref": "#/$defs/unknownable" }, "audience": { "$ref": "#/$defs/unknownable" }, "retention": { "$ref": "#/$defs/unknownable" }, "downstreamStorage": { "$ref": "#/$defs/unknownable" }, "deliveryFailure": { "$ref": "#/$defs/unknownable" } }, "additionalProperties": false } },
        "evidence": { "type": "array", "items": { "type": "object", "required": ["claimId", "claimType", "sourcePath", "claim", "observedAt", "method", "level", "engine", "substitutions", "limitations"], "properties": { "claimId": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" }, "claimType": { "enum": ["source-observation", "document-intent", "candidate", "test-evidence", "test-source"] }, "sourcePath": { "type": "string" }, "line": { "type": "integer", "minimum": 1 }, "symbol": { "type": "string" }, "claim": { "type": "string" }, "observedAt": { "type": "string", "format": "date" }, "method": { "type": "string" }, "level": { "enum": ["G0", "G1", "G2", "G3", "G4", "G5", "R1", "none"] }, "engine": { "type": "string" }, "substitutions": { "type": "array", "items": { "type": "string" } }, "limitations": { "type": "string", "minLength": 1 } }, "additionalProperties": false } },
        "documentClaims": { "type": "array", "items": { "type": "object", "required": ["path", "claim", "status"], "properties": { "path": { "type": "string" }, "claim": { "type": "string" }, "status": { "enum": ["corroborated", "contradicted", "unverified", "historical"] } }, "additionalProperties": false } },
        "driftDisposition": { "$ref": "#/$defs/unknownable" }
      }
    }
  }
}
