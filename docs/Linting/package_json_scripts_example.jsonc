// In root package.json, update scripts to:

{
  "scripts": {
    // ===== Linting Pipeline =====
    "lint": "npm run lint:oxlint && npm run lint:eslint && npm run format:check",
    "lint:fix": "npm run lint:oxlint:fix && npm run lint:eslint:fix && npm run format:fix",
    
    // Layer 1: Fast pre-pass (2–5 seconds for entire monorepo)
    "lint:oxlint": "oxlint . --deny-warnings",
    "lint:oxlint:fix": "oxlint . --fix",
    
    // Layer 2: Framework-specific + custom rules (10–30 seconds)
    // Runs in each app via turbo or pnpm
    "lint:eslint": "eslint . --max-warnings 0",
    "lint:eslint:fix": "eslint . --fix",
    
    // Layer 3: Format check (5–10 seconds)
    "format": "biome format --write .",
    "format:check": "biome format --check .",
    "format:fix": "biome format --write .",
    
    // Combined quality check (runs all three in sequence)
    "quality": "npm run lint && npm run format"
  },
  "devDependencies": {
    "oxlint": "^1.62.0",
    "eslint-plugin-oxlint": "^0.2.0",
    "biome": "^1.9.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "eslint-plugin-svelte": "^2.0.0",
    "svelte-eslint-parser": "^0.33.0",
    "astro-eslint-parser": "^1.0.0",
    "@astrojs/eslint-plugin": "^0.14.0"
  }
}
