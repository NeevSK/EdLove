# Root .gitignore hides app JavaScript broadly. Re-include only Metro/Babel/Expo
# config, native config, plugins named by app.json plus their helper, and the two
# JavaScript shims imported directly from index.ts. Keep other JS shadow files out.
!apps/gurudevi-mobile/app.config.js
!apps/gurudevi-mobile/babel.config.js
!apps/gurudevi-mobile/metro.config.js
!apps/gurudevi-mobile/react-native.config.js
!apps/gurudevi-mobile/plugins/withNdkVersion.js
!apps/gurudevi-mobile/plugins/withProfileableBuild.js
!apps/gurudevi-mobile/plugins/withGradleProperties.js
!apps/gurudevi-mobile/plugins/withGradleWrapperVersion.js
!apps/gurudevi-mobile/plugins/withSubprojectsBuildConfig.js
!apps/gurudevi-mobile/plugins/lib/buildGradleBlock.js
!apps/gurudevi-mobile/src/shims/early-bootstrap.js
!apps/gurudevi-mobile/src/shims/node-globals-shim.js
