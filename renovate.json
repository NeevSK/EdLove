{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:base",
    ":separateMajorReleases",
    ":combinePatchMinorReleases",
    ":separatePatchReleases"
  ],
  "packageRules": [
    {
      "matchPackagePatterns": ["^expo", "^@expo", "^react-native", "^@react-native"],
      "enabled": false,
      "description": "Disable automated updates for Expo and React Native core to maintain Expo SDK 58 and React Native 0.88 compliance."
    },
    {
      "matchPackageNames": [
        "typescript",
        "react-native-reanimated",
        "react-native-gesture-handler",
        "react-native-worklets",
        "react-native-mmkv",
        "react-native-nitro-modules",
        "react-native-skia",
        "@shopify/react-native-skia"
      ],
      "enabled": false,
      "description": "Tier 1 Critical Native Architecture (Sacred Pins per AGENTS.md). Manual upgrade only via Cautious Upgrade Protocol."
    },
    {
      "groupName": "Dev Tooling",
      "matchPackageNames": ["eslint", "prettier", "@biomejs/biome"],
      "automerge": true
    },
    {
      "groupName": "Logic Helpers (Safe Patches)",
      "matchUpdateTypes": ["patch"],
      "matchPackagePatterns": ["^date-fns", "^lodash", "^zod", "^zustand"],
      "automerge": true
    }
  ],
  "rangeStrategy": "bump"
}
