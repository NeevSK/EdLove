{
  "env": {
    "browser": true,
    "es2025": true,
    "node": true
  },
  "globals": {
    "document": "writable",
    "window": "writable",
    "globalThis": "writable"
  },
  "plugins": ["react", "import"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "pedantic": "off",
    "perf": "warn",
    "style": "off",
    "restriction": "warn",
    "nursery": "off"
  },
  "rules": {
    "no-debugger": "error",
    "no-console": "warn",
    "import/no-relative-parent-imports": "off",
    "no-constant-condition": "error",
    "no-empty": "warn",
    "prefer-const": "warn",
    "no-var": "error",
    "no-unused-vars": "warn",
    "@typescript-eslint/no-unused-vars": "warn",
    "react/react-in-jsx-scope": "off",
    "react/no-multi-comp": "off",
    "react/jsx-filename-extension": "off",
    "react/forbid-component-props": "off",
    "no-async-await": "off",
    "no-optional-chaining": "off",
    "no-await-in-loop": "off",
    "unicode-bom": "off",
    "unicorn/prefer-module": "error"
  },
  "settings": {
    "react": {
      "version": "19"
    },
    "import": {
      "ignore": ["node_modules"]
    }
  },
  "overrides": [
    {
      "files": ["scripts/**/*"],
      "rules": {
        "no-console": "off",
        "no-underscore-dangle": "off"
      }
    },
    {
      "files": [
        "*.cjs",
        "**/*.config.js",
        "**/*.config.cjs",
        "scripts/**/*.js",
        "scripts/**/*.cjs",
        "**/plugins/**/*.js"
      ],
      "rules": {
        "unicorn/prefer-module": "off",
        "import/no-commonjs": "off",
        "typescript/no-require-imports": "off",
        "import/unambiguous": "off"
      }
    }
  ],
  "ignorePatterns": [
    "**/*.web.ts",
    "**/*.web.tsx",
    "!apps/gurudevi-web/**",
    "!packages/admin/src/screens/SchoolProfileScreen.web.tsx",
    "!packages/analytics/src/engine/PostHogAnalytics.web.ts",
    "!packages/form-builder/src/screens/FormBuilderScreen.web.tsx",
    "!packages/form-builder/src/screens/PublicFormScreen.web.tsx",
    "!packages/library/src/screens/VideoPlayerScreen.web.tsx",
    "!packages/self/src/screens/SelfScreen.web.tsx",
    "!packages/ui/src/components/FeatureStateBoundary.web.tsx",
    "!packages/ui/src/components/GatewayFooter.web.tsx",
    "!packages/ui/src/components/GatewayHeader.web.tsx",
    "!packages/ui/src/components/GatewayScreenShell.web.tsx",
    "!packages/ui/src/components/WebScreenHeader.web.tsx",
    "!packages/ui/src/icons.web.ts",
    "!packages/ui/src/screens/AppSettingsScreen.web.tsx",
    "node_modules",
    "dist",
    "build",
    ".next",
    ".expo",
    ".turbo",
    "coverage",
    "*.config.ts",
    "*.config.js",
    "*.config.mjs",
    "*.config.cjs",
    "*.cjs",
    "**/*.cjs",
    "eslint.config.js",
    "**/archive/**",
    "**/plugins/**"
  ]
}
